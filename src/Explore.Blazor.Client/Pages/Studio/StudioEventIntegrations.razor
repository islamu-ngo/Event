    private async Task LoadChannelsAsync()
    {
        if (!await ValidateAsync(_channelScope.WorkflowId, _channelScope.RequirementId)) return;
        var generation = _loadGeneration;
        var cancellationToken = _loadCts?.Token ?? default;
        try
        {
            var channels = await Integrations.GetChannelsAsync(TenantId, EventId, _channelScope.WorkflowId!.Value, _channelScope.RequirementId!.Value, cancellationToken);
            if (generation != _loadGeneration || cancellationToken.IsCancellationRequested) return;
            _channelLinks = Links(channels._links);
            _channels = Items(channels._embedded?.Items).OrderBy(item => item.Int("ordinal") ?? int.MaxValue).ToList();
            _channelsLoaded = true;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

