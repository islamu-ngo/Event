    private Task OnLockTenantMcpLegacySseChangedAsync(bool value)
    {
        Mcp.LockTenantMcpLegacySse = value;
        return SaveSettingsAsync(() => SaveMcpAsync(new McpGovernanceSettingsDto { LockTenantMcpLegacySse = value }), "MCP settings");
    }

    private Task OnGlobalRenderModeChangedAsync(string value)
    {
        RenderPolicy.GlobalRenderMode = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { GlobalRenderMode = value }),
            "Render policy");
    }

    private Task OnGlobalPrerenderChangedAsync(bool value)
    {
        RenderPolicy.GlobalPrerenderEnabled = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { GlobalPrerenderEnabled = value }),
            "Render policy");
    }

    private Task OnAllowTenantRenderPolicyOverrideChangedAsync(bool value)
    {
        RenderPolicy.AllowTenantRenderPolicyOverride = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { AllowTenantRenderPolicyOverride = value }),
            "Render policy");
    }

    private Task OnLockTenantPublicSeoRenderPolicyChangedAsync(bool value)
    {
        RenderPolicy.LockTenantPublicSeoRenderPolicy = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { LockTenantPublicSeoRenderPolicy = value }),
            "Render policy");
    }

    private Task OnLockTenantOperationalRenderPolicyChangedAsync(bool value)
    {
        RenderPolicy.LockTenantOperationalRenderPolicy = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { LockTenantOperationalRenderPolicy = value }),
            "Render policy");
    }

    private Task OnLockTenantAdminRenderPolicyChangedAsync(bool value)
    {
        RenderPolicy.LockTenantAdminRenderPolicy = value;
        return SaveSettingsAsync(
            () => SaveRenderPolicyAsync(new RenderPolicySettingsDto { LockTenantAdminRenderPolicy = value }),
            "Render policy");
    }

    private async Task SaveSettingsAsync(Func<Task<BaseCommandResponseOfGuid>> save, string label)
    {
        _settingsSaving = true;
        _settingsSaveStatus = $"Saving {label.ToLowerInvariant()}...";
        _settingsSaveError = null;
        try
        {
            BaseCommandResponseOfGuid response = await save();
            if (response.Success == true)
            {
                _settingsSaveStatus = $"{label} saved.";
                return;
            }

            _settingsSaveStatus = null;
            _settingsSaveError = string.IsNullOrWhiteSpace(response.Message)
                ? $"{label} could not be saved."
                : response.Message;
        }
        catch (Exception)
        {
            _settingsSaveStatus = null;
            _settingsSaveError = $"{label} could not be saved.";
        }
        finally
        {
            _settingsSaving = false;
        }
    }

    private Task OnAdvancedOverridesChanged(bool enabled)
    {
        return SelectPresetAsync(enabled ? "CustomAdvanced" : RecommendedPreset);
    }

    private string GetRouteGroupMode(string group)
    {
        return group switch
        {
            "public-seo" => NormalizeRenderMode(RenderPolicy.PublicSeoRenderMode),
            "operational" => NormalizeRenderMode(RenderPolicy.OperationalRenderMode),
            "admin" => NormalizeRenderMode(RenderPolicy.AdminRenderMode),
            "onboarding" => NormalizeOnboardingRenderMode(RenderPolicy.OnboardingRenderMode),
            _ => "InteractiveAuto"
        };
    }

    private Task SetRouteGroupModeAsync(string group, string mode)
    {
        var normalizedMode = NormalizeRenderMode(mode);
        var patch = new RenderPolicySettingsDto();

        switch (group)
        {
            case "public-seo":
                RenderPolicy.PublicSeoRenderMode = normalizedMode;
                patch.PublicSeoRenderMode = normalizedMode;
                break;
            case "operational":
                RenderPolicy.OperationalRenderMode = normalizedMode;
                patch.OperationalRenderMode = normalizedMode;
                break;
            case "admin":
                RenderPolicy.AdminRenderMode = normalizedMode;
                patch.AdminRenderMode = normalizedMode;
                break;
            case "onboarding":
                RenderPolicy.OnboardingRenderMode = NormalizeOnboardingRenderMode(normalizedMode);
                patch.OnboardingRenderMode = RenderPolicy.OnboardingRenderMode;
                break;
        }

        EnsureOnboardingGuardrail();
        return SaveSettingsAsync(() => SaveRenderPolicyAsync(patch), "Render policy");
    }

    private bool GetRouteGroupPrerender(string group)
    {
        return group switch
        {
            "public-seo" => RenderPolicy.PublicSeoPrerenderEnabled == true,
            "operational" => RenderPolicy.OperationalPrerenderEnabled == true,
            "admin" => RenderPolicy.AdminPrerenderEnabled == true,
            "onboarding" => RenderPolicy.OnboardingPrerenderEnabled == true,
            _ => false
        };
    }

    private Task SetRouteGroupPrerenderAsync(string group, bool enabled)
    {
        var patch = new RenderPolicySettingsDto();
        switch (group)
        {
            case "public-seo":
                RenderPolicy.PublicSeoPrerenderEnabled = enabled;
                patch.PublicSeoPrerenderEnabled = enabled;
                break;
            case "operational":
                RenderPolicy.OperationalPrerenderEnabled = enabled;
                patch.OperationalPrerenderEnabled = enabled;
                break;
            case "admin":
                RenderPolicy.AdminPrerenderEnabled = enabled;
                patch.AdminPrerenderEnabled = enabled;
                break;
            case "onboarding":
                RenderPolicy.OnboardingPrerenderEnabled = enabled;
                patch.OnboardingPrerenderEnabled = enabled;
                break;
        }

        return SaveSettingsAsync(() => SaveRenderPolicyAsync(patch), "Render policy");
    }

    private static bool IsOnboardingInteractiveServerRestricted(string group)
    {
        // InteractiveServer is no longer restricted for onboarding — it's the forced default.
        return false;
    }

    private void ApplyGlobalFallbackToAllGroups()
    {
        var mode = NormalizeRenderMode(RenderPolicy.GlobalRenderMode);
        var prerender = RenderPolicy.GlobalPrerenderEnabled == true;

        RenderPolicy.PublicSeoRenderMode = mode;
        RenderPolicy.PublicSeoPrerenderEnabled = prerender;
        RenderPolicy.OperationalRenderMode = mode;
        RenderPolicy.OperationalPrerenderEnabled = prerender;
        RenderPolicy.AdminRenderMode = mode;
        RenderPolicy.AdminPrerenderEnabled = prerender;
        RenderPolicy.OnboardingRenderMode = NormalizeOnboardingRenderMode(mode);
        RenderPolicy.OnboardingPrerenderEnabled = prerender;
    }

    private void EnsureOnboardingGuardrail()
    {
        // Onboarding is always InteractiveServer for best first-impression UX.
        RenderPolicy.DisallowInteractiveServerOnOnboarding = false;
        RenderPolicy.OnboardingRenderMode = "InteractiveServer";
    }

    private static string NormalizeRenderMode(string? mode)
    {
        if (string.Equals(mode, "InteractiveWebAssembly", StringComparison.OrdinalIgnoreCase))
        {
            return "InteractiveWebAssembly";
        }

        if (string.Equals(mode, "InteractiveServer", StringComparison.OrdinalIgnoreCase))
        {
            return "InteractiveServer";
        }

        return "InteractiveAuto";
    }

    private static string NormalizeOnboardingRenderMode(string? mode)
    {
        // Onboarding always uses InteractiveServer regardless of input.
        return "InteractiveServer";
    }

    private sealed record PresetOption(string Value, string Label, string Description, string HelpText);
    private sealed record RenderModeOption(string Value, string Label);
    private sealed record RouteGroupOption(string Value, string Label, string HelpText);
}
