<button type="button"
        class="ai-rail__chip"
        @onclick="RemoveAsync"
        @onkeydown="HandleKeyDownAsync"
        aria-label="Remove @Reference.DisplayName"
        data-testid="ai-reference-chip">
    <MudIcon Icon="@GetReferenceIcon(Reference.Kind)" Size="Size.Small" />
    <span class="ai-rail__chip-text">@Reference.DisplayName</span>
    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
</button>

@code {
    [Parameter]
    public HalResourceOfAiReferenceSearchResultDto Reference { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private Task RemoveAsync() => OnRemove.InvokeAsync(Reference.ReferenceId);

    private static string GetReferenceIcon(string? kind) => kind switch
    {
        "Event" => Icons.Material.Filled.Event,
        "Organization" => Icons.Material.Filled.Business,
        "Actor" => Icons.Material.Filled.Person,
        "EventSession" => Icons.Material.Filled.Schedule,
        _ => Icons.Material.Filled.Tag
    };

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        return string.Equals(args.Key, "Delete", StringComparison.OrdinalIgnoreCase)
            || string.Equals(args.Key, "Backspace", StringComparison.OrdinalIgnoreCase)
            ? RemoveAsync()
            : Task.CompletedTask;
    }
}
