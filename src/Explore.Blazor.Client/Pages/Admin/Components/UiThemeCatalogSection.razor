@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services

<div class="settings-section ui-theme-catalog">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">
            @(IsPlatformCatalog ? "Platform Themes" : "Tenant Themes")
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @(IsPlatformCatalog
                ? "Platform-wide themes available to every tenant. Exactly one may be marked default."
                : "Themes owned by this tenant, available alongside the platform catalog. Exactly one tenant theme may be default.")
        </MudText>
    </div>

    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(_themes is null ? "Loading..." : $"{_themes.Count} theme(s)")
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudSwitch T="bool" @bind-Value="_activeOnly" Color="Color.Primary"
                           Label="Active only" LabelPosition="LabelPosition.End"
                           @bind-Value:after="ReloadAsync" />
                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="OpenCreateDialogAsync">
                    New theme
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_loading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Loading themes...</MudText>
            </MudStack>
        }
        else if (_themes is null || _themes.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No themes yet. Click "New theme" to create one.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var theme in _themes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="ui-theme-catalog__card" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                        @theme.DisplayName
                                    </MudText>
                                    <MudStack Row="true" Spacing="1">
                                        @if (theme.IsDefault == true)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                Default
                                            </MudChip>
                                        }
                                        @if (theme.IsActive != true)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                Inactive
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(theme.ThemeKey)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Sort: @(theme.SortOrder ?? 0)
                                </MudText>
                                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialogAsync(theme.Id ?? Guid.Empty))"
                                                   Disabled="@(theme.Id is null)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(theme))"
                                                   Disabled="@(theme.IsDefault == true || theme.Id is null)" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired] public bool IsPlatformCatalog { get; set; }

    [Inject] private IAppearanceThemeService AppearanceThemeService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private ILogger<UiThemeCatalogSection> Logger { get; set; } = null!;

    private List<UiThemeListItemDto>? _themes;
    private bool _loading = true;
    private bool _activeOnly;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var themes = await AppearanceThemeService.GetThemeCatalogAsync(IsPlatformCatalog, _activeOnly);
            _themes = themes?.ToList() ?? new List<UiThemeListItemDto>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load UI theme catalog");
            Snackbar.Add($"Could not load themes: {ex.Message}", Severity.Error);
            _themes = new List<UiThemeListItemDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["Existing"] = null,
            ["IsPlatformCatalog"] = IsPlatformCatalog,
            ["AllowPlatformToggle"] = false
        };

        var dialog = await DialogService.ShowAsync<UiThemeEditorDialog>(
            IsPlatformCatalog ? "Create Platform Theme" : "Create Tenant Theme",
            parameters,
            DialogOptionsFactory.Medium());

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(Guid id)
    {
        if (id == Guid.Empty) return;
        try
        {
            var details = await AppearanceThemeService.GetThemeDetailsAsync(id);
            if (details is null)
            {
                Snackbar.Add("Theme could not be loaded.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Existing"] = details,
                ["IsPlatformCatalog"] = IsPlatformCatalog,
                ["AllowPlatformToggle"] = false
            };

            var dialog = await DialogService.ShowAsync<UiThemeEditorDialog>(
                $"Edit theme: {details.DisplayName}",
                parameters,
                DialogOptionsFactory.Medium());

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open theme editor for {ThemeId}", id);
            Snackbar.Add($"Could not open editor: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(UiThemeListItemDto theme)
    {
        var id = theme.Id ?? Guid.Empty;
        if (id == Guid.Empty) return;

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete theme",
            $"Delete theme '{theme.DisplayName}'? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel",
            options: DialogOptionsFactory.Confirmation());

        if (confirm != true) return;

        try
        {
            await AppearanceThemeService.DeleteThemeAsync(id);
            Snackbar.Add("Theme deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogError(ex, "Failed to delete theme {ThemeId}", id);
            Snackbar.Add($"Delete failed ({ex.StatusCode}): {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete theme {ThemeId}", id);
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }
}
