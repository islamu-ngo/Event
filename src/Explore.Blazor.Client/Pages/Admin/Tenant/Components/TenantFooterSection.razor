    // ── Helpers ────────────────────────────────────────────────────────────

    private static string TruncateUrl(string? url) =>
        url?.Length > 60 ? string.Concat(url.AsSpan(0, 57), "...") : url ?? string.Empty;

    private static string CapitalizePlatform(string platform) =>
        platform switch
        {
            "bluesky" => "Bluesky",
            "github" => "GitHub",
            "linkedin" => "LinkedIn",
            "tiktok" => "TikTok",
            "whatsapp" => "WhatsApp",
            "youtube" => "YouTube",
            _ => char.ToUpperInvariant(platform[0]) + platform[1..]
        };

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        CancelDebounce(ref _descriptionDebounceCts);
        CancelDebounce(ref _socialLinksDebounceCts);
        CancelDebounce(ref _copyrightDebounceCts);
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
    }

