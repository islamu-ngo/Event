@using System.Text.Json
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@inject IRegistrationProviderIntegrationService Integrations
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService Focus
@inject ILogger<StudioEventIntegrations> Logger
@implements IDisposable

<div class="studio-event-integrations" data-testid="studio-event-integrations">
    @if (Event.TenantId is null || Event.Id is null)
    {
        <div class="studio-event-integrations__state" role="alert" data-testid="integrations-missing-lineage">
            Integration management needs a loaded event and tenant. Refresh and try again.
        </div>
    }
    else if (_isLoading)
    {
        <div class="studio-event-integrations__state" role="status" aria-live="polite" data-testid="integrations-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <span>Loading provider integrations…</span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="studio-event-integrations__state" role="alert" data-testid="integrations-error">
            <MudText Typo="Typo.body1">@_errorMessage</MudText>
            <AppButton Variant="Variant.Outlined" OnClick="ReloadAsync">Try again</AppButton>
        </div>
    }
    else
    {
        <section class="studio-event-integrations__summary" aria-labelledby="integrations-summary-title">
            <MudText Id="integrations-summary-title" Typo="Typo.h6" HtmlTag="h3">Provider overview</MudText>
            <div class="studio-event-integrations__stats" role="list">
                <div role="listitem"><strong>@_connections.Count</strong><span>Connections</span></div>
                <div role="listitem"><strong>@_bindings.Count</strong><span>Bindings</span></div>
                @if (CanViewHealth)
                {
                    <div role="listitem"><strong>@_health.Count</strong><span>Health rows</span></div>
                }
                <div role="listitem"><strong>@_queue.Count</strong><span>Parked items</span></div>
            </div>
            @if (IsHealthOnly)
            {
                <p class="studio-event-integrations__notice" data-testid="integrations-health-only">Health-only access: mutation controls are hidden because the event did not expose management HAL links.</p>
            }
        </section>

        @if (CanViewHealth)
        {
        <section class="studio-event-integrations__panel" aria-labelledby="provider-health-title">
            <MudText Id="provider-health-title" Typo="Typo.h6" HtmlTag="h3">Provider health</MudText>
            @if (_health.Count == 0)
            {
                <p class="studio-event-integrations__empty" data-testid="integrations-health-empty">No provider health has been reported.</p>
            }
            else
            {
                <div class="studio-event-integrations__cards" role="list">
                    @foreach (var row in _health)
                    {
                        <article class="studio-event-integrations__card" role="listitem" data-testid="integration-health-row">
                            <MudText Typo="Typo.subtitle1" HtmlTag="h4">@row.Title("Binding")</MudText>
                            <p>@row.Text("status", "statusCode", "Unknown")</p>
                            <p>@row.Text("message", "lastError", "No message reported")</p>
                            @if (CanPoll(row))
                            {
                                <AppButton Variant="Variant.Outlined" OnClick="@(() => PollAsync(row))" aria-label="Poll provider reconciliation">
                                    Poll reconciliation
                                </AppButton>
                            }
                        </article>
                    }
                </div>
            }
        </section>
        }

        <section class="studio-event-integrations__panel" aria-labelledby="connections-title">
            <div class="studio-event-integrations__section-header">
                <MudText Id="connections-title" Typo="Typo.h6" HtmlTag="h3">Connections and approved origins</MudText>
            </div>
            @if (CanCreateConnection)
            {
                <EditForm Model="_connectionDraft" OnValidSubmit="CreateConnectionAsync" class="studio-event-integrations__form" data-testid="connection-form">
                    <AppTextField T="string" Label="Connection name" Required="true" @bind-Value="_connectionDraft.Name" />
                    <AppTextField T="int?" Label="Provider kind ID" InputType="InputType.Number" Required="true" @bind-Value="_connectionDraft.ProviderKindId" />
                    <AppTextField T="int?" Label="Deployment kind ID" InputType="InputType.Number" Required="true" @bind-Value="_connectionDraft.DeploymentKindId" />
                    <AppTextField T="string" Label="Provider code" Required="true" @bind-Value="_connectionDraft.ProviderCode" />
                    <AppTextField T="string" Label="Provider deployment code" Required="true" @bind-Value="_connectionDraft.ProviderDeploymentCode" />
                    <AppTextField T="string" Label="API version" Required="true" @bind-Value="_connectionDraft.ApiVersion" />
                    <AppTextField T="string" Label="Adapter policy version" Required="true" @bind-Value="_connectionDraft.AdapterPolicyVersion" />
                    <AppTextField T="string" Label="Conformance evidence revision" Required="true" @bind-Value="_connectionDraft.ConformanceEvidenceRevision" />
                    <AppTextField T="string" Label="Management API base URL" Required="true" @bind-Value="_connectionDraft.ManagementApiBaseUrl" />
                    <AppTextField T="string" Label="Public base URL" Required="true" @bind-Value="_connectionDraft.PublicBaseUrl" />
                    <AppTextField T="string" Label="Provider workspace ID" Required="true" @bind-Value="_connectionDraft.ProviderWorkspaceId" />
<AppTextField T="string" Label="Granted OAuth scopes" Lines="2" @bind-Value="_connectionDraft.GrantedOAuthScopes" />
                    <AppTextField T="string" Label="Provider identity" @bind-Value="_connectionDraft.ProviderIdentity" />
                    <AppTextField T="string" Label="Pub/Sub configuration reference" @bind-Value="_connectionDraft.PubSubConfigurationReference" />
                    <AppTextField T="Guid?" Label="API token secret binding ID" Required="true" @bind-Value="_connectionDraft.ApiTokenSecretBindingId" />
                    <AppTextField T="Guid?" Label="Webhook secret binding ID" Required="true" @bind-Value="_connectionDraft.WebhookSecretBindingId" />
                    <AppTextField T="string" Label="Approved origins, one per line" Lines="3" @bind-Value="_connectionDraft.OriginsText" />
                    <AppButton ButtonType="ButtonType.Submit" Disabled="_isSaving">Add connection</AppButton>
                </EditForm>
            }
            @RenderCollection(_connections, "No provider connections yet.", "integration-connection-row", RenderConnection)
        </section>

        <section class="studio-event-integrations__panel" aria-labelledby="bindings-title">
            <MudText Id="bindings-title" Typo="Typo.h6" HtmlTag="h3">Draft binding, mapping, publish, and drift</MudText>
            @if (CanCreateBinding)
            {
                <EditForm Model="_bindingDraft" OnSubmit="@(_ => CreateBindingAsync())" class="studio-event-integrations__form" data-testid="binding-form">
                    <AppSelect T="Guid?" Label="Connection" Required="true" Value="_bindingDraft.ConnectionId" ValueChanged="@(value => _bindingDraft.ConnectionId = value)" data-testid="binding-connection-id">
                        @foreach (var connection in _connections.Where(connection => connection.Id is not null))
                        {
                            <MudSelectItem T="Guid?" Value="@connection.Id">@connection.Title("Connection")</MudSelectItem>
                        }
                    </AppSelect>
                    <AppTextField T="Guid?" Label="Form ID" Required="true" @bind-Value="_bindingDraft.FormId" />
                    <AppTextField T="Guid?" Label="Form version ID" Required="true" @bind-Value="_bindingDraft.FormVersionId" />
                    <AppTextField T="string" Label="Provider form ID" @bind-Value="_bindingDraft.ProviderSurveyId" />
                    <AppTextField T="string" Label="Provider form revision" @bind-Value="_bindingDraft.ProviderSurveyRevisionId" />
                    <AppTextField T="string" Label="Connector contract version" @bind-Value="_bindingDraft.ProviderWebhookId" />
                    <AppTextField T="Guid?" Label="Callback secret binding ID" @bind-Value="_bindingDraft.WebhookSecretBindingId" />
                    <AppTextField T="int?" Label="Presentation mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="_bindingDraft.PresentationModeId" />
                    <AppTextField T="int?" Label="Collection mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="_bindingDraft.CollectionModeId" />
                    <AppTextField T="int?" Label="Completion mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="_bindingDraft.CompletionModeId" />
                    <AppTextField T="int?" Label="Trust level ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="_bindingDraft.TrustLevelId" />
                    <AppButton ButtonType="ButtonType.Submit" Disabled="_isSaving">Save binding draft</AppButton>
                </EditForm>
            }
            @RenderCollection(_bindings, "No provider bindings yet.", "integration-binding-row", RenderBinding)
        </section>

        <section class="studio-event-integrations__panel" aria-labelledby="channels-title">
            <MudText Id="channels-title" Typo="Typo.h6" HtmlTag="h3">Requirement channel order and fallback</MudText>
            @if (CanManageChannels)
            {
                <EditForm Model="_channelScope" OnValidSubmit="LoadChannelsAsync" class="studio-event-integrations__form" data-testid="channel-scope-form">
                    <AppTextField T="Guid?" Label="Workflow ID" Required="true" @bind-Value="_channelScope.WorkflowId" />
                    <AppTextField T="Guid?" Label="Requirement ID" Required="true" @bind-Value="_channelScope.RequirementId" />
                    <AppButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined">Load channels</AppButton>
                </EditForm>
                @if (_channelsLoaded && CanCreateChannel)
                {
                    <EditForm Model="_channelDraft" OnValidSubmit="CreateChannelAsync" class="studio-event-integrations__form" data-testid="channel-form">
                        <AppTextField T="int?" Label="Order" InputType="InputType.Number" Required="true" @bind-Value="_channelDraft.Ordinal" />
                        <MudCheckBox T="bool" Label="Native fallback channel" @bind-Value="_channelDraft.IsNative" />
                        <AppTextField T="Guid?" Label="Provider binding ID" @bind-Value="_channelDraft.RegistrationProviderBindingId" />
                        <AppButton ButtonType="ButtonType.Submit" Disabled="_isSaving">Add channel</AppButton>
                    </EditForm>
                }
            }
            @RenderCollection(_channels, _channelsLoaded ? "No channels configured for this requirement." : "Load a workflow and requirement to inspect channel order.", "integration-channel-row", RenderChannel)
        </section>

        <section class="studio-event-integrations__panel" aria-labelledby="queue-title">
            <MudText Id="queue-title" Typo="Typo.h6" HtmlTag="h3">Reconciliation queue</MudText>
            @if (CanManualImport)
            {
                <EditForm Model="_manualImport" OnValidSubmit="ManualImportAsync" class="studio-event-integrations__form" data-testid="manual-import-form">
                    <AppTextField T="Guid?" Label="Binding ID" Required="true" @bind-Value="_manualImport.BindingId" />
                    <AppTextField T="string" Label="Storage reference" Required="true" @bind-Value="_manualImport.StorageReference" />
                    <AppTextField T="string" Label="Source reference" @bind-Value="_manualImport.SourceReference" />
                    <AppButton ButtonType="ButtonType.Submit" Disabled="_isSaving">Queue manual import</AppButton>
                </EditForm>
            }
            @RenderCollection(_queue, "No parked reconciliation items.", "integration-queue-row", RenderQueueItem)
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventDto Event { get; set; } = null!;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private List<IntegrationHalItem> _connections = [];
    private List<IntegrationHalItem> _bindings = [];
    private List<IntegrationHalItem> _channels = [];
    private List<IntegrationHalItem> _health = [];
    private List<IntegrationHalItem> _queue = [];
    private bool _channelsLoaded;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _validationMessage;
    private readonly ConnectionDraft _connectionDraft = new();
    private readonly BindingDraft _bindingDraft = new();
    private readonly ChannelScope _channelScope = new();
    private readonly ChannelDraft _channelDraft = new();
    private readonly ManualImportDraft _manualImport = new();
    private readonly Dictionary<Guid, ConnectionDraft> _connectionEdits = new();
    private readonly Dictionary<Guid, string?> _originEdits = new();
    private readonly Dictionary<Guid, BindingDraft> _bindingEdits = new();
    private readonly Dictionary<Guid, ChannelDraft> _channelEdits = new();
    private const string ProviderCreateRel = "provider-create";
    private const string ManualImportRel = "manual-import";
    private const string OriginsRel = "origins";
    private const string PollRel = "poll";
    private const string RetryRel = "retry";
    private const string ResolveRel = "resolve";
    private const string PublishRel = "publish";
    private const string DeleteRel = "delete";
    private const string EditRel = "edit";

    private Guid TenantId => Event.TenantId!.Value;
    private Guid EventId => Event.Id!.Value;
    private bool CanManageChannels => Event.HasHalLink("manage-registration-channels");
    private bool CanViewHealth => Event.HasHalLink("view-registration-provider-health");
    private bool IsHealthOnly => CanViewHealth && !CanManageChannels;
    private bool CanCreateConnection => CanManageChannels && HasCollectionLink(_connectionLinks, ProviderCreateRel);
    private bool CanCreateBinding => CanManageChannels && HasCollectionLink(_bindingLinks, ProviderCreateRel);
    private bool CanCreateChannel => CanManageChannels && HasCollectionLink(_channelLinks, ProviderCreateRel);
    private bool CanManualImport => CanManageChannels && HasCollectionLink(_queueLinks, ManualImportRel);
    private IReadOnlyDictionary<string, HalLink>? _connectionLinks;
    private IReadOnlyDictionary<string, HalLink>? _bindingLinks;
    private IReadOnlyDictionary<string, HalLink>? _channelLinks;
    private IReadOnlyDictionary<string, HalLink>? _queueLinks;
    private CancellationTokenSource? _loadCts;
    private int _loadGeneration;
    private Guid? _loadedTenantId;
    private Guid? _loadedEventId;

    protected override async Task OnParametersSetAsync()
    {
        if (Event.TenantId is null || Event.Id is null)
        {
            ClearEventScopedState();
            _isLoading = false;
            return;
        }

        if (_loadedTenantId != Event.TenantId || _loadedEventId != Event.Id)
        {
            _loadedTenantId = Event.TenantId;
            _loadedEventId = Event.Id;
            CancelLoad();
            ClearEventScopedState();
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        CancelLoad();
        _loadCts = new CancellationTokenSource();
        var generation = ++_loadGeneration;
        var cancellationToken = _loadCts.Token;
        _isLoading = true;
        _errorMessage = null;
        _validationMessage = null;
        try
        {
            if (CanManageChannels)
            {
                var connections = await Integrations.GetConnectionsAsync(TenantId, EventId, cancellationToken);
                if (generation != _loadGeneration) return;
                _connectionLinks = Links(connections._links);
                _connections = Items(connections._embedded?.Items).ToList();

                var bindings = await Integrations.GetBindingsAsync(TenantId, EventId, cancellationToken);
                if (generation != _loadGeneration) return;
                _bindingLinks = Links(bindings._links);
                _bindings = Items(bindings._embedded?.Items).ToList();
            }
            else
            {
                _connectionLinks = _bindingLinks = null;
                _connections = [];
                _bindings = [];
                _queueLinks = _channelLinks = null;
                _queue = [];
                _channels = [];
                _channelsLoaded = false;
                ClearRowEditDrafts();
            }

            if (CanViewHealth)
            {
                var health = await Integrations.GetHealthAsync(TenantId, EventId, cancellationToken);
                if (generation != _loadGeneration) return;
                _health = Items(health._embedded?.Items).ToList();
            }
            else
            {
                _health = [];
            }

            if (CanManageChannels)
            {
                var queue = await Integrations.GetQueueAsync(TenantId, EventId, 50, cancellationToken);
                if (generation != _loadGeneration) return;
                _queueLinks = Links(queue._links);
                _queue = Items(queue._embedded?.Items).ToList();
            }
            else
            {
                _queueLinks = null;
                _queue = [];
            }

            await Announcer.AnnouncePoliteAsync("Registration provider integrations loaded");
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load registration provider integrations for event {EventId}", EventId);
            _errorMessage = "Registration provider integrations could not be loaded. Try again.";
            await Announcer.AnnounceAssertiveAsync(_errorMessage);
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        CancelLoad();
    }

    private void CancelLoad()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _loadGeneration++;
    }

    private void ClearEventScopedState()
    {
        _connections = [];
        _bindings = [];
        _channels = [];
        _health = [];
        _queue = [];
        _connectionLinks = _bindingLinks = _channelLinks = _queueLinks = null;
        _channelsLoaded = false;
        ClearRowEditDrafts();
    }

    private void ClearRowEditDrafts()
    {
        _connectionEdits.Clear();
        _originEdits.Clear();
        _bindingEdits.Clear();
        _channelEdits.Clear();
    }

    private RenderFragment RenderCollection(List<IntegrationHalItem> items, string emptyText, string testId, Func<IntegrationHalItem, RenderFragment> row) => builder =>
    {
        if (_validationMessage is not null)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "studio-event-integrations__validation");
            builder.AddAttribute(2, "role", "alert");
            builder.AddAttribute(3, "data-testid", "integrations-validation");
            builder.AddContent(4, _validationMessage);
            builder.CloseElement();
        }

        if (items.Count == 0)
        {
            builder.OpenElement(5, "p");
            builder.AddAttribute(6, "class", "studio-event-integrations__empty");
            builder.AddContent(7, emptyText);
            builder.CloseElement();
            return;
        }

        builder.OpenElement(8, "div");
        builder.AddAttribute(9, "class", "studio-event-integrations__cards");
        builder.AddAttribute(10, "role", "list");
        foreach (var item in items)
        {
            builder.OpenElement(11, "article");
            builder.AddAttribute(12, "class", "studio-event-integrations__card");
            builder.AddAttribute(13, "role", "listitem");
            builder.AddAttribute(14, "data-testid", testId);
            builder.AddContent(15, row(item));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RenderConnection(IntegrationHalItem item) => @<>
        @{ var edit = item.Id is { } editId ? ConnectionEditFor(editId, item) : new ConnectionDraft(); }
        <MudText Typo="Typo.subtitle1" HtmlTag="h4">@item.Title("Connection")</MudText>
        <p>@item.Text("providerKindName", "providerKindCode", "Provider not reported") · @item.Text("deploymentKindName", "deploymentKindCode", "Deployment not reported")</p>
        <p>OAuth identity: @item.Text(["providerIdentity"], "Not recorded") · Last refresh: @item.Text(["lastCredentialRefreshAt"], "never") · Last access: @item.Text(["lastAccessValidatedAt"], "never")</p>
        <p>Approved origins: @string.Join(", ", item.StringArray("approvedOrigins"))</p>
        @if (item.HasLink(EditRel))
        {
            <EditForm Model="edit" OnValidSubmit="@(() => UpdateConnectionAsync(item))" class="studio-event-integrations__form" data-testid="connection-edit-form">
                <AppTextField T="string" Label="Connection name" @bind-Value="edit.Name" />
                <AppTextField T="int?" Label="Provider kind ID" InputType="InputType.Number" min="1" @bind-Value="edit.ProviderKindId" />
                <AppTextField T="int?" Label="Deployment kind ID" InputType="InputType.Number" min="1" @bind-Value="edit.DeploymentKindId" />
                <AppTextField T="string" Label="Provider code" Required="true" @bind-Value="edit.ProviderCode" />
                <AppTextField T="string" Label="Provider deployment code" Required="true" @bind-Value="edit.ProviderDeploymentCode" />
                <AppTextField T="string" Label="API version" Required="true" @bind-Value="edit.ApiVersion" />
                <AppTextField T="string" Label="Adapter policy version" Required="true" @bind-Value="edit.AdapterPolicyVersion" />
                <AppTextField T="string" Label="Conformance evidence revision" Required="true" @bind-Value="edit.ConformanceEvidenceRevision" />
                <AppTextField T="string" Label="Management API base URL" Required="true" @bind-Value="edit.ManagementApiBaseUrl" />
                <AppTextField T="string" Label="Public base URL" Required="true" @bind-Value="edit.PublicBaseUrl" />
                <AppTextField T="string" Label="Provider workspace ID" Required="true" @bind-Value="edit.ProviderWorkspaceId" />
                <AppTextField T="string" Label="Granted OAuth scopes" Lines="2" @bind-Value="edit.GrantedOAuthScopes" />
                <AppTextField T="string" Label="Provider identity" @bind-Value="edit.ProviderIdentity" />
                <AppTextField T="string" Label="Pub/Sub configuration reference" @bind-Value="edit.PubSubConfigurationReference" />
                <AppTextField T="Guid?" Label="API token secret binding ID" @bind-Value="edit.ApiTokenSecretBindingId" />
                <AppTextField T="Guid?" Label="Webhook secret binding ID" @bind-Value="edit.WebhookSecretBindingId" />
                <AppButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Disabled="_isSaving">Update connection</AppButton>
            </EditForm>
        }
        @if (item.HasLink(OriginsRel))
        {
            <AppTextField T="string" Label="Approved origins replacement" Lines="3" Value="@OriginEditFor(item)" ValueChanged="@(value => SetOriginEdit(item, value))" />
            <AppButton Variant="Variant.Outlined" OnClick="@(() => ReplaceOriginsAsync(item, OriginEditFor(item)))">Replace origins</AppButton>
        }
        <div class="studio-event-integrations__actions">
            @if (item.HasLink(DeleteRel))
            {
                <AppButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteConnectionAsync(item))">Delete connection</AppButton>
            }
        </div>
    </>;

    private RenderFragment RenderBinding(IntegrationHalItem item) => @<>
        @{ var edit = item.Id is { } editId ? BindingEditFor(editId, item) : new BindingDraft(); }
        <MudText Typo="Typo.subtitle1" HtmlTag="h4">@item.Title("Binding")</MudText>
        <p>Connection: @item.Text("connectionId", "providerConnectionId", "Unknown")</p>
        <p>Revision: @item.Text("revisionHash", "draftRevisionHash", "No revision hash") · Drift: @item.Text("driftStatus", "driftStatusCode", "Unknown")</p>
        @if (item.HasLink(EditRel))
        {
            <EditForm Model="edit" OnSubmit="@(_ => UpdateBindingAsync(item))" class="studio-event-integrations__form" data-testid="binding-edit-form">
                <AppSelect T="Guid?" Label="Connection" Required="true" Value="edit.ConnectionId" ValueChanged="@(value => edit.ConnectionId = value)" data-testid="binding-edit-connection-id">
                    @foreach (var connection in _connections.Where(connection => connection.Id is not null))
                    {
                        <MudSelectItem T="Guid?" Value="@connection.Id">@connection.Title("Connection")</MudSelectItem>
                    }
                </AppSelect>
                <AppTextField T="Guid?" Label="Form ID" Required="true" @bind-Value="edit.FormId" />
                <AppTextField T="Guid?" Label="Form version ID" Required="true" @bind-Value="edit.FormVersionId" />
                <AppTextField T="string" Label="Provider form ID" @bind-Value="edit.ProviderSurveyId" />
                <AppTextField T="string" Label="Provider form revision" @bind-Value="edit.ProviderSurveyRevisionId" />
                <AppTextField T="string" Label="Connector contract version" @bind-Value="edit.ProviderWebhookId" />
                <AppTextField T="Guid?" Label="Callback secret binding ID" @bind-Value="edit.WebhookSecretBindingId" />
                <AppTextField T="int?" Label="Presentation mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="edit.PresentationModeId" />
                <AppTextField T="int?" Label="Collection mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="edit.CollectionModeId" />
                <AppTextField T="int?" Label="Completion mode ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="edit.CompletionModeId" />
                <AppTextField T="int?" Label="Trust level ID" InputType="InputType.Number" Required="true" min="1" @bind-Value="edit.TrustLevelId" />
                <AppButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Disabled="_isSaving">Update binding</AppButton>
            </EditForm>
        }
        @if (item.HasLink(MappingsRel))
        {
            <div class="studio-event-integrations__form" data-testid="binding-mappings-editor">
                <MudText Typo="Typo.subtitle2" HtmlTag="h5">Field mappings</MudText>
                @foreach (var mapping in edit.FieldMappings)
                {
                    <AppTextField T="string" Label="Platform field key" @bind-Value="mapping.PlatformFieldKey" />
                    <AppTextField T="string" Label="Provider field key" @bind-Value="mapping.ProviderFieldKey" />
                    <MudCheckBox T="bool" Label="Required" @bind-Value="mapping.IsRequired" />
                }
                <AppButton Variant="Variant.Outlined" OnClick="@(() => edit.FieldMappings.Add(new FieldMappingDraft()))">Add field mapping</AppButton>
                <MudText Typo="Typo.subtitle2" HtmlTag="h5">Option mappings</MudText>
                @foreach (var mapping in edit.OptionMappings)
                {
                    <AppTextField T="string" Label="Platform field key" @bind-Value="mapping.PlatformFieldKey" />
                    <AppTextField T="string" Label="Platform option key" @bind-Value="mapping.PlatformOptionKey" />
                    <AppTextField T="string" Label="Provider option key" @bind-Value="mapping.ProviderOptionKey" />
                }
                <AppButton Variant="Variant.Outlined" OnClick="@(() => edit.OptionMappings.Add(new OptionMappingDraft()))">Add option mapping</AppButton>
                <AppButton Variant="Variant.Outlined" OnClick="@(() => ReplaceMappingsAsync(item))" Disabled="_isSaving">Save mappings</AppButton>
            </div>
        }
        <div class="studio-event-integrations__actions">
            @if (item.HasLink(PublishRel))
            {
                <AppButton OnClick="@(() => PublishBindingAsync(item))">Publish binding</AppButton>
            }
            @if (item.HasLink(DeleteRel))
            {
                <AppButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteBindingAsync(item))">Delete binding</AppButton>
            }
        </div>
    </>;

    private RenderFragment RenderChannel(IntegrationHalItem item) => @<>
