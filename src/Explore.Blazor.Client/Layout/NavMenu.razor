@using Explore.Blazor.Client.Routing.ControlPlane
@*
    NavMenu Component - BEM Methodology
    Block: navbar / navbar--search-active
    Elements: __content, __brand, __brand-icon, __brand-text, __brand-highlight,
              __brand-text--stackable, __brand-part-top, __brand-part-bottom,
              __search, __search-toggle, __search-overlay, __search-overlay-input,
              __search-back-btn, __actions, __theme-toggle,
              __create-event-btn, __login-btn,
              __user-dropdown, __user-btn, __user-avatar, __user-name, __user-arrow,
              __dropdown-menu, __dropdown-header, __dropdown-divider, __dropdown-section-label,
              __dropdown-item, __dropdown-item-label, __dropdown-item-arrow,
              __dropdown-submenu, __dropdown-submenu-item, __dropdown-submenu-name,
              __dropdown-submenu-action, __dropdown-submenu-empty, __dropdown-submenu-divider,
              __dropdown-submenu-create, __dropdown-overlay
    Modifiers: __dropdown-menu--open, __dropdown-item--danger,
               __dropdown-item--expandable, __dropdown-submenu-name--text,
               __brand-text--stackable, navbar--search-active
*@

<div class="navbar @(_isSearchOverlayOpen ? "navbar--search-active" : "")">
    @if (_isSearchOverlayOpen)
    {
        @* YouTube-style full-width search overlay — shown on tablet/mobile when search is opened *@
        <div class="navbar__search-overlay" role="search">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Inherit"
                           OnClick="CloseSearchOverlay"
                           Title="Close search"
                           Class="navbar__search-back-btn"
                           aria-label="Back to navigation" />
            <div class="navbar__search-overlay-input">
                <MudTextField @ref="_overlaySearchField"
                              T="string"
                              Placeholder="@SearchPlaceholder"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="navbar__search-input"
                              @bind-Value="SearchQuery"
                              @onkeyup="@HandleSearchKeyPress" />
            </div>
        </div>
    }
    <div class="navbar__content @(_isSearchOverlayOpen ? "navbar__content--hidden" : "")">

        <!-- Workspace navigation toggle (shown only when the active workspace has navigation) -->
        @if (HasWorkspaceNavigation)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           OnClick="ToggleSidebarPanel"
                            Title="Toggle sidebar"
                            Class="navbar__sidebar-toggle"
                            Edge="Edge.Start"
                            aria-expanded="@(IsSidebarDockOpen ? "true" : "false")"
                            aria-label="Toggle sidebar navigation" />
        }

        @* Brand — logo is ALWAYS visible; acts as quicklink to home *@
        <a href="/" class="navbar__brand" aria-label="Home">
            @if (!string.IsNullOrWhiteSpace(_brandLogoUrl))
            {
                <MudImage Src="@_brandLogoUrl" Alt="@_brandDisplayName" Class="navbar__brand-icon" Width="28" Height="28" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" Class="navbar__brand-icon" />
            }

            @if (!string.IsNullOrWhiteSpace(_brandDisplayName))
            {
                @if (CanStackBrandName(out var topPart, out var bottomPart))
                {
                    @* Two-part name: stacks vertically at intermediate widths, hidden on mobile *@
                    <div class="navbar__brand-text navbar__brand-text--stackable" title="@_brandDisplayName" aria-label="@_brandDisplayName">
                        <span class="navbar__brand-part-top">@topPart</span>
                        <span class="navbar__brand-part-bottom">@bottomPart</span>
                    </div>
                }
                else
                {
                    @* Single-word or multi-word (>2): hide on mobile, keep full text on desktop *@
                    <div class="navbar__brand-text" title="@_brandDisplayName">@_brandDisplayName</div>
                }
            }
        </a>

        @if (ShowGlobalSearch)
        {
            @* Desktop search bar — hidden on tablet/mobile via CSS (> 840px only) *@
            <div class="navbar__search">
                <MudTextField @ref="_searchField"
                              T="string"
                              Placeholder="@SearchPlaceholder"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="navbar__search-input"
                              @bind-Value="SearchQuery"
                              @onkeyup="@HandleSearchKeyPress" />
            </div>

            <MudHotkey Key="JsKey.KeyK"
                       KeyModifiers="@(new[] { JsKeyModifier.ControlLeft })"
                       OnHotkeyPressed="FocusSearchAsync" />
        }

        <!-- Right Actions -->
        <div class="navbar__actions">
            @* Search icon button — visible only on tablet/mobile (≤840px, CSS-gated).
               Placed first in actions so it sits left of language/theme pickers. *@
            @if (ShowGlobalSearch)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Search"
                               Color="Color.Inherit"
                               OnClick="OpenSearchOverlay"
                               Title="Search"
                               Class="navbar__search-toggle"
                               aria-label="Open search" />
            }
            <AuthorizeView>
                <Authorized>
                    <div class="navbar__desktop-preference-actions">
                        <LanguagePicker Enabled="@_languagePickerEnabled" />
                        <ThemeQuickSwitcher />
                    </div>

                    @if (ShowEventPrimaryAction)
                    {
                        <div class="navbar__primary-action">
                            @if (ActingActorName is not null)
                            {
                                <span class="navbar__acting-actor" data-testid="navbar-acting-actor">For <bdi dir="auto">@ActingActorName</bdi></span>
                            }
                            <a href="@PrimaryActionRoute" class="navbar__primary-action-link" data-testid="navbar-primary-action">
                                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Class="navbar__create-event-btn">
                                    @PrimaryActionLabel
                                </MudButton>
                            </a>
                        </div>
                    }

                    <!-- Notification Bell -->
                    <NotificationBell />

                    @* AI Assistant toggle follows tenant audience policy and the current user's preference. *@
                    @if (AiAssistantState.IsButtonVisible)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                                       Color="Color.Inherit"
                                       Size="Size.Medium"
                                       OnClick="ToggleAiAssistantPanel"
                                       Title="AI Assistant"
                                       Class="@($"navbar__ai-toggle {(AiAssistantState.IsOpen ? "navbar__ai-toggle--active" : "")}")"
                                       data-testid="shell-ai-toggle"
                                       aria-label="Toggle AI Assistant"
                                       aria-expanded="@(AiAssistantState.IsOpen ? "true" : "false")"
                                       aria-controls="ai-assistant-rail" />
                    }

                    <!-- User Dropdown -->
                    <div class="navbar__user-dropdown">
                        <button type="button" class="navbar__user-btn" @onclick="ToggleDropdown" @onclick:stopPropagation
                                aria-expanded="@_dropdownOpen" aria-haspopup="true" aria-label="User menu">
                            @if (!string.IsNullOrEmpty(_currentUser?.ProfileImageUri))
                            {
                                <MudAvatar Size="Size.Small" Class="navbar__user-avatar">
                                    <MudImage Src="@_currentUser.ProfileImageUri" Alt="@($"{context.User.Identity?.Name}'s profile picture")" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="navbar__user-avatar">
                                    @GetInitials(context.User.Identity?.Name)
                                </MudAvatar>
                            }

                        </button>

                        @if (_dropdownOpen)
                        {
                            <div class="navbar__dropdown-menu navbar__dropdown-menu--open" @onclick:stopPropagation>
                                <div class="navbar__dropdown-header">
                                    @if (!string.IsNullOrEmpty(_currentUser?.ProfileImageUri))
                                    {
                                        <MudAvatar Size="Size.Small" Class="navbar__dropdown-header-avatar">
                                            <MudImage Src="@_currentUser.ProfileImageUri" Alt="@($"{context.User.Identity?.Name}'s profile picture")" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Primary" Size="Size.Small" Class="navbar__dropdown-header-avatar">
                                            @GetInitials(context.User.Identity?.Name)
                                        </MudAvatar>
                                    }
                                    <div class="navbar__dropdown-header-info">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.User.Identity?.Name</MudText>
                                    </div>
                                </div>
                                <div class="navbar__dropdown-divider"></div>

                                <a href="/my/profile" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                    Show Profile
                                </a>

                                <div class="navbar__mobile-preferences">
                                    <div class="navbar__dropdown-divider"></div>
                                    <div class="navbar__dropdown-section-label">Preferences</div>
                                    <div class="navbar__dropdown-control-item">
                                        <div class="navbar__dropdown-control-label">
                                            <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" />
                                            <span>Language</span>
                                        </div>
                                        <LanguagePicker Enabled="@_languagePickerEnabled" />
                                    </div>
                                    <div class="navbar__dropdown-control-item">
                                        <div class="navbar__dropdown-control-label">
                                            <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" />
                                            <span>Theme</span>
                                        </div>
                                        <ThemeQuickSwitcher />
                                    </div>
                                </div>

                                @* Organizations expandable submenu *@
                                <div class="navbar__dropdown-item navbar__dropdown-item--expandable" @onclick="ToggleOrgSubmenu" @onclick:stopPropagation
                                     role="button" tabindex="0">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                    <span class="navbar__dropdown-item-label">Organizations</span>
                                    <MudIcon Icon="@(_orgSubmenuOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                             Size="Size.Small" Class="navbar__dropdown-item-arrow" />
                                </div>
                                @if (_orgSubmenuOpen)
                                {
                                    <div class="navbar__dropdown-submenu">
                                        @if (_organizationActors.Any())
                                        {
                                            @foreach (var org in _organizationActors)
                                            {
                                                var canManageSettings = org.ScopeId.HasValue
                                                    && _organizationScopes.Any(scope => scope.ScopeId == org.ScopeId);
                                                <div class="navbar__dropdown-submenu-item" @key="org.ScopeId">
                                                    <a href="@($"/organization/{org.ScopeId}")" class="navbar__dropdown-submenu-name" @onclick="CloseDropdown">
                                                        @(org.DisplayName ?? org.ScopeId.ToString())
                                                    </a>
                                                    @if (canManageSettings)
                                                    {
                                                        <a href="@($"/settings/organization/{org.ScopeId}")" class="navbar__dropdown-submenu-action" @onclick="CloseDropdown">
                                                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                                            Settings
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="navbar__dropdown-submenu-empty">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">No organizations yet</MudText>
                                            </div>
                                        }
                                        <div class="navbar__dropdown-submenu-divider"></div>
                                        <a href="/organizations/create" class="navbar__dropdown-submenu-create" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                            Create Organization
                                        </a>
                                    </div>
                                }

                                @* Groups expandable submenu *@
                                <div class="navbar__dropdown-item navbar__dropdown-item--expandable" @onclick="ToggleGroupSubmenu" @onclick:stopPropagation
                                     role="button" tabindex="0">
                                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                    <span class="navbar__dropdown-item-label">Groups</span>
                                    <MudIcon Icon="@(_groupSubmenuOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                             Size="Size.Small" Class="navbar__dropdown-item-arrow" />
                                </div>
                                @if (_groupSubmenuOpen)
                                {
                                    <div class="navbar__dropdown-submenu">
                                        @if (_groupActors.Any())
                                        {
                                            @foreach (var group in _groupActors)
                                            {
                                                var canManageSettings = group.ScopeId.HasValue
                                                    && _groupScopes.Any(scope => scope.ScopeId == group.ScopeId);
                                                <div class="navbar__dropdown-submenu-item" @key="group.ScopeId">
                                                    <span class="navbar__dropdown-submenu-name navbar__dropdown-submenu-name--text">
                                                        @(group.DisplayName ?? group.ScopeId.ToString())
                                                    </span>
                                                    @if (canManageSettings)
                                                    {
                                                        <a href="@($"/settings/group/{group.ScopeId}")" class="navbar__dropdown-submenu-action" @onclick="CloseDropdown">
                                                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                                            Settings
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="navbar__dropdown-submenu-empty">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">No groups yet</MudText>
                                            </div>
                                        }
                                        <div class="navbar__dropdown-submenu-divider"></div>
                                    </div>
                                }

                                 @if (HasAnyAdminAuthority(context.User))
                                 {
                                     <div class="navbar__dropdown-divider"></div>
                                     <div class="navbar__dropdown-section-label">Administration</div>

                                     @if (_isCurrentUserInstanceAdmin && !_isSingleTenantMode)
                                     {
                                        <a href="@ControlPlaneRoutes.Overview" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                                            Instance Console
                                        </a>
                                    }

                                     @if (_isSingleTenantMode && _isCurrentUserInstanceAdmin && _isCurrentUserTenantAdmin)
                                     {
                                         <div class="navbar__dropdown-section-label">Site administration</div>
                                         <a href="/settings/admin" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Small" />
                                             Tenant settings
                                         </a>
                                         <a href="/settings/instance" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Small" />
                                             Instance settings
                                         </a>
                                     }
                                     else if (_isCurrentUserInstanceAdmin)
                                     {
                                         <a href="/settings/instance" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Small" />
                                             @(_isSingleTenantMode ? "Site administration" : "Instance administration")
                                         </a>
                                     }
                                     else if (_isCurrentUserTenantAdmin)
                                     {
                                         <a href="/settings/admin" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Small" />
                                             @(_isSingleTenantMode ? "Site administration" : "Tenant administration")
                                         </a>
                                     }

                                    @if (_isCurrentUserTenantAdmin)
                                    {
                                        <a href="/admin/tenant/custom-properties" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                                            Custom Property Governance
                                        </a>
                                    }

                                     @foreach (var scope in _organizationScopes.Where(scope => scope.ScopeId.HasValue))
                                     {
                                         <a href="@($"/settings/organization/{scope.ScopeId}")" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.CorporateFare" Size="Size.Small" />
                                             @(scope.DisplayName ?? "Organization settings")
                                         </a>
                                     }

                                     @foreach (var scope in _groupScopes.Where(scope => scope.ScopeId.HasValue))
                                     {
                                         <a href="@($"/settings/group/{scope.ScopeId}")" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                             <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                             @(scope.DisplayName ?? "Group settings")
                                         </a>
                                     }
                                }

                                <div class="navbar__dropdown-divider"></div>

                                 <a href="/settings/personal" class="navbar__dropdown-item" @onclick="NavigateToPersonalSettings">
                                     <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                     Personal Settings
                                 </a>
                                 @if (ProfileAdminSettingsHref is not null)
                                 {
                                     <a href="@ProfileAdminSettingsHref" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                         <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                                         Admin Settings
                                     </a>
                                 }
                                 else
                                 {
                                     <a href="/settings" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                         <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                                         All Settings
                                     </a>
                                 }
                                <a href="/logout" data-enhance-nav="false" class="navbar__dropdown-item navbar__dropdown-item--danger" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                                    Logout
                                </a>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="navbar__desktop-preference-actions navbar__desktop-preference-actions--always-visible">
                        <LanguagePicker Enabled="@_languagePickerEnabled" />
                        <ThemeQuickSwitcher />
                    </div>

                    @if (ShowAnonymousEventAction)
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Class="navbar__create-event-btn"
                                   OnClick="@(() => OpenLoginPrompt("/events/create", "Sign in to add an event. After you sign in, we will bring you back to the event form."))">
                            Add Event
                        </MudButton>
                    }
                    @if (!IsLoginRoute)
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Class="navbar__login-btn"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Login"
                                   OnClick="StartLogin">
                            Sign in
                        </MudButton>
                    }

                    @* AI Assistant toggle follows tenant audience policy and the current user's preference. *@
                    @if (AiAssistantState.IsButtonVisible)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                                       Color="Color.Inherit"
                                       Size="Size.Medium"
                                       OnClick="ToggleAiAssistantPanel"
                                       Title="AI Assistant"
                                       Class="@($"navbar__ai-toggle {(AiAssistantState.IsOpen ? "navbar__ai-toggle--active" : "")}")"
                                       data-testid="shell-ai-toggle"
                                       aria-label="Toggle AI Assistant"
                                       aria-expanded="@(AiAssistantState.IsOpen ? "true" : "false")"
                                       aria-controls="ai-assistant-rail" />
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@* Overlay to close dropdown when clicking outside *@
@if (_dropdownOpen)
{
    <div class="navbar__dropdown-overlay" @onclick="CloseDropdown" aria-hidden="true"></div>
}
