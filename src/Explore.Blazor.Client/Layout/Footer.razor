@using Explore.Blazor.Client.Layout.FooterTemplates
@implements IDisposable
@inject FooterPresentationService Presentation
@inject CookieConsentStateService CookieConsentState
@inject ITranslationService Translation

    <div class="site-footer-root">
    <footer class="site-footer">
        <MudContainer MaxWidth="MaxWidth.Large" Class="site-footer__container">
            @if (_initialized && _footerEnabled)
            {
            @switch (_template)
            {
                case "standard-2-col":
                    <FooterTemplateStandard2Col BrandDisplayName="@_brandDisplayName"
                                                BrandLogoUrl="@_brandLogoUrl"
                                                ShowDescription="@_showDescription"
                                                DescriptionText="@_descriptionText"
                                                ShowSocialLinks="@_showSocialLinks"
                                                SocialLinks="@_socialLinks"
                                                CopyrightText="@_copyrightText"
                                                ShowCookieSettingsLink="@_showCookieSettingsLink"
                                                LinkGroups="@_linkGroups"
                                                ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                                OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                case "minimal":
                    <FooterTemplateMinimal BrandDisplayName="@_brandDisplayName"
                                           BrandLogoUrl="@_brandLogoUrl"
                                           ShowDescription="@_showDescription"
                                           DescriptionText="@_descriptionText"
                                           ShowSocialLinks="@_showSocialLinks"
                                           SocialLinks="@_socialLinks"
                                           CopyrightText="@_copyrightText"
                                           ShowCookieSettingsLink="@_showCookieSettingsLink"
                                           LinkGroups="@_linkGroups"
                                           ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                           OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                case "community":
                    <FooterTemplateCommunity BrandDisplayName="@_brandDisplayName"
                                             BrandLogoUrl="@_brandLogoUrl"
                                             ShowDescription="@_showDescription"
                                             DescriptionText="@_descriptionText"
                                             ShowSocialLinks="@_showSocialLinks"
                                             SocialLinks="@_socialLinks"
                                             CopyrightText="@_copyrightText"
                                             ShowCookieSettingsLink="@_showCookieSettingsLink"
                                             LinkGroups="@_linkGroups"
                                             ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                             OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                default:
                    <FooterTemplateStandard3Col BrandDisplayName="@_brandDisplayName"
                                                BrandLogoUrl="@_brandLogoUrl"
                                                ShowDescription="@_showDescription"
                                                DescriptionText="@_descriptionText"
                                                ShowSocialLinks="@_showSocialLinks"
                                                SocialLinks="@_socialLinks"
                                                CopyrightText="@_copyrightText"
                                                ShowCookieSettingsLink="@_showCookieSettingsLink"
                                                LinkGroups="@_linkGroups"
                                                ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                                OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
            }
            }
            @if (!_initialized || !_footerEnabled || !_showCookieSettingsLink)
            {
                <div class="site-footer__bottom">
                    <div class="site-footer__brand-text">
                        @(string.IsNullOrWhiteSpace(_brandDisplayName)
                            ? T("footer.siteInformation", "Site information") : _brandDisplayName)
                    </div>
                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text"
                               Size="Size.Small" Class="site-footer__link"
                               OnClick="HandleCookieSettingsClick">
                        @T("footer.cookieSettings", "Cookie Settings")
                    </MudButton>
                </div>
            }

            @if (_directoryOperator is not null || _instanceOperator is not null)
            {
                <section class="site-footer__operator-disclosures"
                         aria-label="@T("footer.operatorAccountability", "Operator accountability")">
                    @if (_directoryOperator is not null)
                    {
                        <article class="site-footer__operator-disclosure"
                                 data-testid="footer-directory-operator">
                            <MudText Typo="Typo.subtitle2" HtmlTag="h2">@T("footer.directoryOperator", "Directory operator")</MudText>
                            <MudText Typo="Typo.body2" HtmlTag="p">
                                <bdi dir="auto">@_directoryOperator.PublicName</bdi>
                                <span class="site-footer__operator-legal-name">
                                    (<bdi dir="auto">@_directoryOperator.LegalName</bdi>)
                                </span>
                            </MudText>
                            <MudText Typo="Typo.caption" HtmlTag="p">
                                <bdi dir="ltr" lang="en">@_directoryOperator.JurisdictionCountryCode</bdi>
                                @if (!string.IsNullOrWhiteSpace(_directoryOperator.RegistrationIdentifier))
                                {
                                    <span dir="ltr" lang="en" data-testid="footer-directory-registration-identifier"> · @_directoryOperator.RegistrationIdentifier</span>
                                }
                            </MudText>
                            <div class="site-footer__operator-links">
                                <a href="mailto:@_directoryOperator.PublicContactEmail" dir="ltr" aria-label="@($"{T("footer.contact", "Contact")} {_directoryOperator.PublicName}")">@T("footer.contact", "Contact")</a>
                                <a href="@_directoryOperator.LegalNoticeUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.legalNotice", "Legal notice")} {_directoryOperator.PublicName}")">@T("footer.legalNotice", "Legal notice")</a>
                                @if (!string.IsNullOrWhiteSpace(_directoryOperator.TermsUrl))
                                {
                                    <a href="@_directoryOperator.TermsUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.terms", "Terms")} {_directoryOperator.PublicName}")">@T("footer.terms", "Terms")</a>
                                }
                                <a href="@_directoryOperator.PrivacyUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.privacy", "Privacy")} {_directoryOperator.PublicName}")">@T("footer.privacy", "Privacy")</a>
                            </div>
                        </article>
                    }

                    @if (_instanceOperator is not null)
                    {
                        <article class="site-footer__operator-disclosure"
                                 data-testid="footer-instance-operator">
                            <MudText Typo="Typo.subtitle2" HtmlTag="h2">@T("footer.platformOperator", "Platform operator")</MudText>
                            <MudText Typo="Typo.body2" HtmlTag="p">
                                <bdi dir="auto">@_instanceOperator.PublicName</bdi>
                                <span class="site-footer__operator-legal-name">
                                    (<bdi dir="auto">@_instanceOperator.LegalName</bdi>)
                                </span>
                            </MudText>
                            <MudText Typo="Typo.caption" HtmlTag="p">
                                @(_instanceOperator.IsOfficialInstance ? T("footer.officialInstance", "Official ISLAMU instance") : T("footer.independentInstance", "Independent instance"))
                                · <bdi dir="ltr" lang="en">@_instanceOperator.JurisdictionCountryCode</bdi>
                                @if (!string.IsNullOrWhiteSpace(_instanceOperator.RegistrationIdentifier))
                                {
                                    <span dir="ltr" lang="en" data-testid="footer-instance-registration-identifier"> · @_instanceOperator.RegistrationIdentifier</span>
                                }
                            </MudText>
                            <div class="site-footer__operator-links">
                                <a href="mailto:@_instanceOperator.PublicContactEmail" dir="ltr" aria-label="@($"{T("footer.contact", "Contact")} {_instanceOperator.PublicName}")">@T("footer.contact", "Contact")</a>
                                <a href="@_instanceOperator.WebsiteUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.website", "Website")} {_instanceOperator.PublicName}")">@T("footer.website", "Website")</a>
                                <a href="@_instanceOperator.LegalNoticeUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.legalNotice", "Legal notice")} {_instanceOperator.PublicName}")">@T("footer.legalNotice", "Legal notice")</a>
                                <a href="@_instanceOperator.TermsUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.terms", "Terms")} {_instanceOperator.PublicName}")">@T("footer.terms", "Terms")</a>
                                <a href="@_instanceOperator.PrivacyUrl" dir="ltr" rel="noopener" aria-label="@($"{T("footer.privacy", "Privacy")} {_instanceOperator.PublicName}")">@T("footer.privacy", "Privacy")</a>
                            </div>
                        </article>
                    }
                </section>
            }
        </MudContainer>
    </footer>
    </div>

@code {
    private string _brandDisplayName = string.Empty;
    private string _brandLogoUrl = string.Empty;
    private string _template = "standard-3-col";
    private bool _footerEnabled = true;
    private bool _showDescription = true;
    private string _descriptionText = string.Empty;
    private bool _showSocialLinks = true;
    private List<FooterSocialLinkDto> _socialLinks = [];
    private string _copyrightText = string.Empty;
    private bool _showCookieSettingsLink = true;
    private List<FooterLinkGroupDto> _linkGroups = [];
    private bool _showCommunityGuidelinesLink;
    private TenantDirectoryOperatorPublicDto? _directoryOperator;
    private InstanceOperatorPublicDto? _instanceOperator;
    private bool _initialized;
    private long _loadGeneration;
    private bool _disposed;

    [CascadingParameter(Name = "TenantContext")]
    public Explore.Blazor.Client.Models.TenantContext? TenantContext { get; set; }

    protected override void OnInitialized() => Presentation.Changed += OnPresentationChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        long generation = ++_loadGeneration;
        Apply(null);
        _initialized = false;
        var footer = await Presentation.GetAsync(TenantContext?.TenantId);
        if (_disposed || generation != _loadGeneration) return;
        Apply(footer);
        _initialized = true;
    }

    private void Apply(FooterConfigDto? footer)
    {
        _brandDisplayName = footer?.BrandDisplayName ?? string.Empty;
        _brandLogoUrl = footer?.BrandLogoUrl ?? string.Empty;
        _directoryOperator = footer?.DirectoryOperator;
        _instanceOperator = footer?.InstanceOperator;
        var footerSettings = footer?.Settings;
        _template = footerSettings?.Template ?? "minimal";
        _footerEnabled = footerSettings?.Enabled ?? false;
        _showDescription = footerSettings?.ShowDescription ?? false;
        _descriptionText = footerSettings?.DescriptionText ?? string.Empty;
        _showSocialLinks = footerSettings?.ShowSocialLinks ?? false;
        _socialLinks = footerSettings?.SocialLinks?.ToList() ?? [];
        _showCookieSettingsLink = footerSettings?.ShowCookieSettingsLink ?? true;
        _linkGroups = footer?.LinkGroups?.ToList() ?? [];
        _showCommunityGuidelinesLink = footer?.ShowCommunityGuidelinesLink == true;

        _copyrightText = string.IsNullOrWhiteSpace(footerSettings?.CopyrightText)
            ? $"© {DateTime.Now.Year} {_brandDisplayName}. All rights reserved."
            : footerSettings.CopyrightText;
    }

    private async Task HandleCookieSettingsClick()
    {
        await CookieConsentState.RequestReopenAsync();
    }

    private string T(string key, string fallback) => Translation.T(key, fallback);

    private void OnPresentationChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        var load = LoadAsync();
        StateHasChanged();
        await load;
        if (!_disposed) StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        _loadGeneration++;
        Presentation.Changed -= OnPresentationChanged;
        GC.SuppressFinalize(this);
    }
}
