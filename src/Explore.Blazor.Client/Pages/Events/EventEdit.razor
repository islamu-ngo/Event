@using MudBlazor
@using Explore.Blazor.Client.Components.CustomProperties
@using Explore.Blazor.Client.Shared
@using Explore.Blazor.Client.Pages.Events.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Edit Event</PageTitle>

<MudText Typo="Typo.h1" HtmlTag="h1" Class="sr-only">Edit Event</MudText>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading event...</MudText>
        </div>
    }
    else if (currentEvent == null || updateDto == null)
    {
        <MudContainer Class="py-8">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Event not found.</MudAlert>
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/my/events" Class="mt-4">Back to My Events</MudButton>
        </MudContainer>
    }
    else
    {
        <div class="edit-event">
        <EditForm EditContext="_editContext" OnValidSubmit="@HandleSubmit">
            <FormSubmissionGuard State="@_submitState">
            <AppValidationSummary />

            <MudGrid Spacing="5">
                @* ===== LEFT COLUMN: Event Image ===== *@
                <MudItem xs="12" sm="5" Class="edit-event__col-left">
                    <div class="edit-event__image-area">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl" alt="Event image" class="edit-event__image" />
                        }
                        else
                        {
                            <div class="edit-event__image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Event Image</MudText>
                            </div>
                        }

                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="OnImageFileSelected"
                                       Accept="@ImageUploadClientPolicy.DefaultAcceptedImageFormats"
                                       MaximumFileCount="1"
                                       Class="edit-event__upload-trigger">
                            <CustomContent Context="fileUpload">
                                <MudFab StartIcon="@Icons.Material.Filled.PhotoCamera"
                                        Size="Size.Small"
                                        Color="Color.Primary"
                                        aria-label="Upload event image"
                                        OnClick="@fileUpload.OpenFilePickerAsync" />
                            </CustomContent>
                        </MudFileUpload>

                        @if (_isUploadingImage)
                        {
                            <div class="edit-event__upload-overlay">
                                <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
                            </div>
                        }
                    </div>

                    <ThemeQuickBar BackgroundColor="@_appearance.BackgroundColor"
                                   BackgroundColorChanged="SetBackgroundColorAsync"
                                   BackgroundEffect="@_appearance.BackgroundEffect"
                                   BackgroundEffectChanged="SetBackgroundEffectAsync"
                                   OnAdvancedRequested="OpenThemeStudioAsync" />

                    @if (_uploadError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true"
                                  ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                            @_uploadError
                        </MudAlert>
                    }
                </MudItem>

                @* ===== RIGHT COLUMN: Form ===== *@
                <MudItem xs="12" sm="7" Class="edit-event__col-right">

                    @* --- Event Title (large, Luma-style) --- *@
                    <MudTextField T="string" @bind-Value="updateDto.Title"
                                  Label="Event name"
                                  Placeholder="Event Name"
                                  Variant="Variant.Text"
                                  FullWidth="true"
                                  Immediate="true"
                                  Required="true"
                                  Class="edit-event__title-input mb-1" />

                    <MudTextField T="string" @bind-Value="updateDto.Subtitle"
                                  Label="Subtitle"
                                  Placeholder="Optional short line shown under the event name"
                                  Variant="Variant.Text"
                                  FullWidth="true"
                                  Immediate="true"
                                  Class="edit-event__subtitle-input mb-2" />

                    <div class="d-flex align-center gap-2 mb-2">
                        <MudButton Elevation="0" Variant="Variant.Text"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="@(() => { _showTimezoneSelector = !_showTimezoneSelector; })"
                                   Class="edit-event__timezone-btn">
                            <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Class="mr-1" />
                            @_selectedTimezoneDisplay
                            <MudIcon Icon="@(_showTimezoneSelector ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" Size="Size.Small" />
                        </MudButton>
                    </div>
                    @if (_showTimezoneSelector)
                    {
                        <MudAutocomplete T="TimeZoneInfo"
                                         Value="_selectedTimezone"
                                         ValueChanged="OnTimezoneChanged"
                                         SearchFunc="SearchTimezones"
                                         ToStringFunc="@(tz => tz?.DisplayName ?? "")"
                                         Label="Search timezone"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Dense="true"
                                         Immediate="true"
                                         Class="edit-event__timezone-autocomplete mb-3" />
                    }

                    <MudToggleGroup T="int?"
                                    @bind-Value="updateDto.EventFormatId"
                                    Color="Color.Primary"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    CheckMark="true"
                                    FixedContent="true"
                                    Class="mb-3">
                        <MudToggleItem T="int?" Value="@((int?)1)" Text="In-person" />
                        <MudToggleItem T="int?" Value="@((int?)2)" Text="Online" />
                        <MudToggleItem T="int?" Value="@((int?)3)" Text="Hybrid" />
                    </MudToggleGroup>

                    <MudTextField T="string" @bind-Value="updateDto.Description"
                                  Label="Card description"
                                  Placeholder="Short summary for event cards"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  Immediate="true"
                                  MaxLength="150"
                                  Class="mb-3" />

                    @* --- Add Content Button (Luma-style popup) --- *@
                    <MudButton Elevation="0" StartIcon="@Icons.Material.Filled.Notes"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               FullWidth="true"
                               Class="edit-event__action-button justify-start"
                               OnClick="OpenDescriptionDialog">
                        @if (!string.IsNullOrEmpty(updateDto.Content))
                        {
                            <span class="text-truncate" style="max-width: 400px; text-align: start;">@updateDto.Content</span>
                        }
                        else
                        {
                            <span>Add full content</span>
                        }
                    </MudButton>

                    @if (sessions.Count > 0)
                    {
                        var primarySession = sessions.First();
                        var primaryLocationName = locations?.FirstOrDefault(l => l.Id == primarySession.LocationId)?.FullName;
                        var primaryImageUrl = primarySession.UseEventImage ? imagePreviewUrl : primarySession.FeaturedImagePreviewUrl;

                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">Program items</MudText>
                        <SessionSummaryCard Session="primarySession"
                                            Index="0"
                                            LocationName="@primaryLocationName"
                                            RegistrationModeName="@GetRegistrationModeName(primarySession.RegistrationModeId)"
                                            ImageUrl="@primaryImageUrl"
                                            OnEdit="@(() => EditSession(0))"
                                            OnDuplicate="@(() => ShowDuplicateUnavailable())"
                                            OnDelete="@(() => RemoveSession(0))" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2 mb-3">
                            Session date, location, registration, capacity, and language details are edited in the dedicated session composer.
                        </MudText>
                    }

                    @* --- Program Summary: sessions stay as program items, sections stay in the program manager. --- *@
                    <EventOptionsSection Title="Program summary"
                                         TitleId="program-summary-title"
                                         Summary="@ProgramSummary"
                                         PolicyNote="Talks, workshops, panels, classes, and activities are saved as sessions. Tracks, devrooms, and sections organize those sessions.">
                        <EventOptionRow Title="Program items"
                                        Icon="@Icons.Material.Filled.EventNote"
                                        Summary="@ProgramItemsSummary"
                                        Description="@ProgramItemsDescription">
                            <MudButton Elevation="0" StartIcon="@Icons.Material.Filled.Add"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="AddSession"
                                       Disabled="@(!CanAddSession || isProcessing)">
                                Add session
                            </MudButton>
                        </EventOptionRow>

                        <EventOptionRow Title="Program sections"
                                        Icon="@Icons.Material.Filled.AccountTree"
                                        Summary="@ProgramSectionsSummary"
                                        Description="Use sections, tracks, devrooms, or stages to organize saved program items without changing the event hierarchy.">
                            <MudButton Elevation="0" StartIcon="@Icons.Material.Filled.AccountTree"
                                        Variant="Variant.Text"
                                        Color="Color.Default"
                                        OnClick="OpenProgramSectionsDialogAsync"
                                        Disabled="@(!CanManageProgramSections || isProcessing)">
                                Add section/track
                            </MudButton>
                        </EventOptionRow>
                    </EventOptionsSection>

                    @if (_programSummary is not null)
                    {
                        <EventProgramSummaryView Summary="_programSummary" />
                    }

                    @* --- Additional Sessions (2+) --- *@
                    @if (sessions.Count > 1)
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">Additional Sessions</MudText>
                        <div class="edit-event__sessions-list mb-3">
                            @for (int i = 1; i < sessions.Count; i++)
                            {
                                var idx = i;
                                var session = sessions[idx];
                                var locationName = locations?.FirstOrDefault(l => l.Id == session.LocationId)?.FullName;
                                var imageUrl = session.UseEventImage ? imagePreviewUrl : session.FeaturedImagePreviewUrl;

                                <SessionSummaryCard Session="session"
                                                    Index="idx"
                                                    LocationName="@locationName"
                                                    RegistrationModeName="@GetRegistrationModeName(session.RegistrationModeId)"
                                                    ImageUrl="@imageUrl"
                                                    OnEdit="@(() => EditSession(idx))"
                                                    OnDuplicate="@(() => ShowDuplicateUnavailable())"
                                                    OnDelete="@(() => RemoveSession(idx))" />
                            }
                        </div>
                    }

                    @* --- Event Settings (normal behavior controls stay visible) --- *@
                    <EventOptionsSection Title="Event settings"
                                         TitleId="event-edit-settings-title"
                                         Summary="@EventSettingsSummary">
                        <EventOptionRow Title="Visibility"
                                        Icon="@Icons.Material.Filled.Visibility"
                                        Summary="@VisibilitySummary"
                                        Description="Controls who can discover this event."
                                        Required="true">
                            <MudSelect T="int?" @bind-Value="updateDto.VisibilityTypeId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select"
                                       aria-label="Visibility">
                                @if (visibilityTypes != null)
                                {
                                    @foreach (var v in visibilityTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Audience"
                                        Icon="@Icons.Material.Filled.People"
                                        Summary="@AudienceSummary"
                                        Description="Audience filters make expectations visible before publishing.">
                            <div class="edit-event__option-editor-group">
                                <MudSelect T="int?" @bind-Value="updateDto.AudienceGenderId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="edit-event__option-select"
                                           Placeholder="Gender"
                                           aria-label="Audience gender">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Gender</MudSelectItem>
                                    @if (audienceGenders != null)
                                    {
                                        @foreach (var g in audienceGenders)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)g.Id)">@g.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                                <MudSelect T="int?" @bind-Value="updateDto.AudienceAgeId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="edit-event__option-select"
                                           Placeholder="Age"
                                           aria-label="Audience age group">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Age</MudSelectItem>
                                    @if (audienceAges != null)
                                    {
                                        @foreach (var a in audienceAges)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Registration and capacity"
                                        Icon="@Icons.Material.Filled.Policy"
                                        Summary="@RegistrationSummary"
                                        Description="Use this for RSVP flow. Capacity stays on each saved program item.">
                            <MudSelect T="int?" @bind-Value="updateDto.RegistrationPolicyId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select"
                                       Placeholder="Default (Open)"
                                       aria-label="Registration policy">
                                <MudSelectItem T="int?" Value="@((int?)null)">Default (Open)</MudSelectItem>
                                @if (registrationPolicies != null)
                                {
                                    @foreach (var policy in registrationPolicies)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)policy.Id)">@policy.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Event type"
                                        Icon="@Icons.Material.Filled.Category"
                                        Summary="@EventTypeSummary"
                                        Description="Determines relevant templates and classification defaults.">
                            <MudSelect T="int?" @bind-Value="updateDto.EventTypeId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select"
                                       aria-label="Event type">
                                <MudSelectItem T="int?" Value="@((int?)null)">Select event type</MudSelectItem>
                                @if (eventTypes != null)
                                {
                                    @foreach (var type in eventTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Islamic context"
                                        Icon="@Icons.Material.Filled.Mosque"
                                        Summary="@MadhabSummary"
                                        Description="Optional event-level madhab signal. More Islamic scheduling details are added from the detail page.">
                            <MudSelect T="int?" @bind-Value="updateDto.MadhabId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Clearable="true"
                                       Class="edit-event__option-select"
                                       aria-label="Madhab">
                                <MudSelectItem T="int?" Value="@((int?)null)">No madhab</MudSelectItem>
                                @if (madhabs != null)
                                {
                                    @foreach (var m in madhabs)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)m.Id)">@m.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Categories"
                                        Icon="@Icons.Material.Filled.Label"
                                        Summary="@CategoriesSummary"
                                        Description="Broad browsing groups for discovery.">
                            <div class="edit-event__option-chip-editor">
                                @foreach (var category in SelectedCategoryNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                        @category
                                    </MudChip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="OpenCategoryManager"
                                               aria-label="Manage categories" />
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Tags"
                                        Icon="@Icons.Material.Filled.Tag"
                                        Summary="@TagsSummary"
                                        Description="Specific keywords that help people find the event.">
                            <div class="edit-event__option-chip-editor">
                                @foreach (var tag in SelectedTagNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @tag
                                    </MudChip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="OpenTagManager"
                                               aria-label="Manage tags" />
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Languages"
                                        Icon="@Icons.Material.Filled.Translate"
                                        Summary="Set per session"
                                        Description="Language hints are configured on each dedicated session composer so program items can differ."
                                        Disabled="true" />
                    </EventOptionsSection>

                    @if (!string.IsNullOrWhiteSpace(_customPropertyDefinitionLoadError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-4 rounded-lg">
                            @_customPropertyDefinitionLoadError
                        </MudAlert>
                    }

                    @if (_eventCustomPropertyDefinitions.Count > 0)
                    {
                        <MudExpansionPanels Class="mt-4" Elevation="0">
                            <MudExpansionPanel Text="Custom Properties" MaxHeight="900"
                                               Class="rounded-lg border-solid border-1 mud-border-lines-default">
                                <EventCustomPropertyRuntimeEditor EventId="EventId"
                                                                  Definitions="_eventCustomPropertyDefinitions" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }

                </MudItem>
            </MudGrid>

            @* ===== Update Event Button (full width) ===== *@
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                       FullWidth="true"
                       Disabled="@(_submitState.IsSubmitting || _isUploadingImage)"
                       Class="mt-6 edit-event__submit-button"
                       Size="Size.Large">
                @if (_submitState.IsSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Updating...</span>
                }
                else if (_isUploadingImage)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Uploading image...</span>
                }
                else
                {
                    <span>Update Event</span>
                }
            </MudButton>
            </FormSubmissionGuard>
        </EditForm>
        </div>

        <ThemeStudioTray IsOpen="_isThemeStudioOpen"
                         BackgroundColor="@_appearance.BackgroundColor"
                         BackgroundColorChanged="SetBackgroundColorAsync"
                         BackgroundEffect="@_appearance.BackgroundEffect"
                         BackgroundEffectChanged="SetBackgroundEffectAsync"
                         OnClose="CloseThemeStudioAsync" />
    }

    <TagCategoryManagerPopup
        Visible="_showEditTagCatPopup"
        VisibleChanged="@(v => { _showEditTagCatPopup = v; StateHasChanged(); })"
        Mode="@_editTagCatMode"
        InitialAppliedIds="@_editTagCatInitialIds"
        OnSaved="HandleEditTagCatSaved" />

</MudContainer>
