<div class="notification-panel">
    <div class="notification-panel__header">
        <span class="notification-panel__title">Notifications</span>
    </div>

    <div class="notification-panel__toolbar">
        <MudToggleGroup T="int?"
                        Value="SelectedScope"
                        ValueChanged="OnScopeChanged"
                        Color="Color.Primary"
                        SelectionMode="SelectionMode.SingleSelection"
                        FixedContent="true"
                        Size="Size.Small"
                        Class="notification-panel__scope-tabs">
            <MudToggleItem T="int?" Value="@((int?)null)" Text="All" />
            <MudToggleItem T="int?" Value="@((int?)1)" Text="Personal" />
            <MudToggleItem T="int?" Value="@((int?)2)" Text="Org" />
            <MudToggleItem T="int?" Value="@((int?)4)" Text="Group" />
        </MudToggleGroup>
    </div>

    <div class="notification-panel__body">
        @if (IsLoading && !Notifications.Any())
        {
            <div class="notification-panel__loading">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="ml-2">Loading...</MudText>
            </div>
        }
        else if (!Notifications.Any())
        {
            <div class="notification-panel__empty">
                <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone"
                         Size="Size.Large"
                         Color="Color.Default" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No notifications yet
                </MudText>
            </div>
        }
        else
        {
            <div class="notification-panel__list">
                @foreach (var notification in Notifications)
                {
                    <NotificationItem Notification="notification"
                                      OnClick="OnNotificationClick"
                                      OnDelete="OnDeleteNotification"
                                      OnArchive="OnArchiveNotification"
                                      OnSnooze="OnSnoozeNotification" />
                }

                @if (HasMore)
                {
                    <div class="notification-panel__load-more">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text"
                                       Size="Size.Small"
                                       FullWidth="true"
                                       OnClick="OnLoadMore">
                                Load more
                            </MudButton>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="notification-panel__footer">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Size="Size.Small"
                   FullWidth="true"
                   OnClick="OnViewAll">
            View all notifications
        </MudButton>
    </div>
</div>
