@using MudBlazor
@using Explore.Blazor.Client.Services
@inject ITenantOnboardingService TenantOnboardingService

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Render Policy</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure how pages are rendered for this tenant. Locked settings are controlled by the instance administrator.
        </MudText>
    </div>

    @if (Model.CanOverrideRenderPolicy != true)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
            Render policy overrides are not enabled by the instance administrator. All tenants use the instance-level render policy.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @* ── Preset Selector ──────────────────────────────────────────── *@
            <MudSelect T="string"
                       Label="Render Policy Preset"
                       Value="Model.RenderPolicyPreset"
                       ValueChanged="SetPresetAsync"
                       Variant="Variant.Outlined"
                       Disabled="@IsSaving"
                       HelperText="Choose a preset to apply default render modes for all route groups.">
                @foreach (var preset in PresetOptions)
                {
                    <MudSelectItem Value="@preset.Value">@preset.Label</MudSelectItem>
                }
            </MudSelect>

            @* ── Public/SEO Route Group ──────────────────────────────────── *@
            <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Public / SEO Routes</MudText>
                    @if (Model.CanOverridePublicSeoRenderPolicy != true)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Public/SEO render policy is locked by instance administrator.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Render Mode"
                                           Value="Model.PublicSeoRenderMode"
                                           ValueChanged="SetPublicSeoRenderModeAsync"
                                           Disabled="@IsSaving"
                                           Variant="Variant.Outlined">
                                    @foreach (var mode in RenderModeOptions)
                                    {
                                        <MudSelectItem Value="@mode.Value">@mode.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool?"
                                           Value="Model.PublicSeoPrerenderEnabled"
                                           ValueChanged="SetPublicSeoPrerenderAsync"
                                           Disabled="@IsSaving"
                                           Color="Color.Primary">
                                    Prerender Enabled
                                </MudSwitch>
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </MudPaper>

            @* ── Operational Route Group ──────────────────────────────────── *@
            <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Operational Routes</MudText>
                    @if (Model.CanOverrideOperationalRenderPolicy != true)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Operational render policy is locked by instance administrator.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Render Mode"
                                           Value="Model.OperationalRenderMode"
                                           ValueChanged="SetOperationalRenderModeAsync"
                                           Disabled="@IsSaving"
                                           Variant="Variant.Outlined">
                                    @foreach (var mode in RenderModeOptions)
                                    {
                                        <MudSelectItem Value="@mode.Value">@mode.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool?"
                                           Value="Model.OperationalPrerenderEnabled"
                                           ValueChanged="SetOperationalPrerenderAsync"
                                           Disabled="@IsSaving"
                                           Color="Color.Primary">
                                    Prerender Enabled
                                </MudSwitch>
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </MudPaper>

            @* ── Admin Route Group ──────────────────────────────────────── *@
            <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Admin Routes</MudText>
                    @if (Model.CanOverrideAdminRenderPolicy != true)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Admin render policy is locked by instance administrator.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Render Mode"
                                           Value="Model.AdminRenderMode"
                                           ValueChanged="SetAdminRenderModeAsync"
                                           Disabled="@IsSaving"
                                           Variant="Variant.Outlined">
                                    @foreach (var mode in RenderModeOptions)
                                    {
                                        <MudSelectItem Value="@mode.Value">@mode.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool?"
                                           Value="Model.AdminPrerenderEnabled"
                                           ValueChanged="SetAdminPrerenderAsync"
                                           Disabled="@IsSaving"
                                           Color="Color.Primary">
                                    Prerender Enabled
                                </MudSwitch>
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </MudPaper>

            <MudAlert Severity="Severity.Info" Dense="true">
                Onboarding render policy is always controlled at the instance level and cannot be overridden.
            </MudAlert>
            @if (!string.IsNullOrWhiteSpace(_saveMessage))
            {
                <MudAlert Severity="@(_saveSucceeded ? Severity.Success : Severity.Error)"
                          Dense="true"
                          role="@(_saveSucceeded ? "status" : "alert")">
                    @_saveMessage
                </MudAlert>
            }
        </MudStack>
    }
</div>

@code {
    private static readonly (string Value, string Label)[] PresetOptions =
    [
        ("AllInteractiveServer", "All Interactive Server"),
        ("SeoBalanced", "SEO Balanced"),
        ("AllPrerendered", "All Prerendered"),
        ("AllInteractiveAutoNoPrerender", "All Interactive Auto"),
        ("CustomAdvanced", "Custom Advanced")
    ];

    private static readonly (string Value, string Label)[] RenderModeOptions =
    [
        ("InteractiveAuto", "Interactive Auto"),
        ("InteractiveWebAssembly", "Interactive WebAssembly"),
        ("InteractiveServer", "Interactive Server")
    ];

    [Parameter, EditorRequired]
    public TenantPolicySettingsDto Model { get; set; } = null!;

    private const string PresetKey = "routing.render_policy.preset";
    private const string PublicSeoRenderModeKey = "routing.render_policy.public_seo.render_mode";
    private const string PublicSeoPrerenderKey = "routing.render_policy.public_seo.prerender_enabled";
    private const string OperationalRenderModeKey = "routing.render_policy.operational.render_mode";
    private const string OperationalPrerenderKey = "routing.render_policy.operational.prerender_enabled";
    private const string AdminRenderModeKey = "routing.render_policy.admin.render_mode";
    private const string AdminPrerenderKey = "routing.render_policy.admin.prerender_enabled";

    private string? _pendingKey;
    private string? _saveMessage;
    private bool _saveSucceeded;

    private bool IsSaving => _pendingKey is not null;

    private Task SetPresetAsync(string value) => SaveAsync(
        PresetKey,
        value,
        "Render policy preset",
        () => Model.RenderPolicyPreset = value);

    private Task SetPublicSeoRenderModeAsync(string value) => SaveAsync(
        PublicSeoRenderModeKey,
        value,
        "Public render mode",
        () => Model.PublicSeoRenderMode = value);

    private Task SetPublicSeoPrerenderAsync(bool? value) => SaveAsync(
        PublicSeoPrerenderKey,
        value == true ? "true" : "false",
        "Public prerender setting",
        () => Model.PublicSeoPrerenderEnabled = value);

    private Task SetOperationalRenderModeAsync(string value) => SaveAsync(
        OperationalRenderModeKey,
        value,
        "Operational render mode",
        () => Model.OperationalRenderMode = value);

    private Task SetOperationalPrerenderAsync(bool? value) => SaveAsync(
        OperationalPrerenderKey,
        value == true ? "true" : "false",
        "Operational prerender setting",
        () => Model.OperationalPrerenderEnabled = value);

    private Task SetAdminRenderModeAsync(string value) => SaveAsync(
        AdminRenderModeKey,
        value,
        "Admin render mode",
        () => Model.AdminRenderMode = value);

    private Task SetAdminPrerenderAsync(bool? value) => SaveAsync(
        AdminPrerenderKey,
        value == true ? "true" : "false",
        "Admin prerender setting",
        () => Model.AdminPrerenderEnabled = value);

    private async Task SaveAsync(string key, string value, string label, Action apply)
    {
        if (IsSaving || string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        _pendingKey = key;
        _saveMessage = null;
        BaseCommandResponseOfGuid response = await TenantOnboardingService.UpdateTenantSettingAsync(key, value);

        if (response.Success == true)
        {
            apply();
            _saveSucceeded = true;
            _saveMessage = $"{label} saved.";
        }
        else
        {
            await RestoreAuthoritativeValuesAsync();
            _saveSucceeded = false;
            _saveMessage = $"{label} could not be saved. The latest values were restored.";
        }

        _pendingKey = null;
    }

    private async Task RestoreAuthoritativeValuesAsync()
    {
        TenantPolicySettingsDto? latest = await TenantOnboardingService.GetManagementSettingsAsync();
        if (latest is null)
        {
            return;
        }

        Model.RenderPolicyPreset = latest.RenderPolicyPreset;
        Model.PublicSeoRenderMode = latest.PublicSeoRenderMode;
        Model.PublicSeoPrerenderEnabled = latest.PublicSeoPrerenderEnabled;
        Model.OperationalRenderMode = latest.OperationalRenderMode;
        Model.OperationalPrerenderEnabled = latest.OperationalPrerenderEnabled;
        Model.AdminRenderMode = latest.AdminRenderMode;
        Model.AdminPrerenderEnabled = latest.AdminPrerenderEnabled;
        Model.CanOverrideRenderPolicy = latest.CanOverrideRenderPolicy;
        Model.CanOverridePublicSeoRenderPolicy = latest.CanOverridePublicSeoRenderPolicy;
        Model.CanOverrideOperationalRenderPolicy = latest.CanOverrideOperationalRenderPolicy;
        Model.CanOverrideAdminRenderPolicy = latest.CanOverrideAdminRenderPolicy;
    }
}
