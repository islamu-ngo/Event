# =============================================================================
# ISLAMU Event - Baseline Environment Configuration Template
# =============================================================================
# This file contains the essential baseline configuration keys required to run
# a standard self-hosted deployment (Docker Standalone or Docker Compose).
#
# 📖 CONVENTION OVER CONFIGURATION:
# The platform provides built-in sensible defaults for all advanced dials.
# Advanced settings (e.g. S3 cloud storage, external Cerbos PDP, Infisical vault,
# outbound Svix webhooks, auxiliary moderation profiles, and performance dials)
# are deliberately omitted here to keep setup simple and approachable.
#
# Complete reference for all advanced variables and options:
# AI credentials are selected secret references, not ordinary setting values.
# AI_CREDENTIAL_SCOPE is none or instance for deployment configuration.
# Environment authority uses AI_OPENAI_API_KEY, AI_ANTHROPIC_API_KEY or
# AI_AZURE_API_KEY; Infisical uses the matching provider reference under /ai.
# Authenticated compatible providers use AI_OPENAI_COMPATIBLE_API_KEY or
# AI_ANTHROPIC_COMPATIBLE_API_KEY, never official-provider credentials.
# Tenant credentials require exact scoped bindings without instance inheritance.
# 👉 https://islamu.gitbook.io/islamu-event/configuration-and-operations/environment-variables
# =============================================================================

# Optional Cerbos publication verification material (public, never the signing key).
# Required when deployment selects Cerbos. Revision/environment are independent
# deployment expectations; the receipt must match the bundled package and PDP.
# CERBOS_PUBLICATION_RECEIPT_BASE64=
# CERBOS_PUBLICATION_SIGNATURE_BASE64=
# CERBOS_PUBLICATION_PUBLIC_KEY_PEM=
# CERBOS_PUBLICATION_REVISION=
# CERBOS_PUBLICATION_ENVIRONMENT=

# -----------------------------------------------------------------------------
# External Data Protection: provision only the process's API, BFF or COMBINED partition.
# RING and ADMISSION come exclusively from SECRET_PROVIDER. Never commit real values.
# The SHA256 pin and monotonic floor MUST be injected from a separately protected
# operator control, never restored with the candidate ring/admission or primary DB.
# See docs/public/documentation/readme/configuration-and-operations/secrets.md.
# EVENT_DP_API_RING=
# EVENT_DP_API_ADMISSION=
# EVENT_DP_API_ADMISSION_SHA256=
# EVENT_DP_API_MINIMUM_GENERATION=
# EVENT_DP_BFF_RING=
# EVENT_DP_BFF_ADMISSION=
# EVENT_DP_BFF_ADMISSION_SHA256=
# EVENT_DP_BFF_MINIMUM_GENERATION=
# EVENT_DP_COMBINED_RING=
# EVENT_DP_COMBINED_ADMISSION=
# EVENT_DP_COMBINED_ADMISSION_SHA256=
# EVENT_DP_COMBINED_MINIMUM_GENERATION=

# Infisical bootstrap is per process, never a shared administrator identity.
# Compose/Aspire require a distinct identity for each enabled consumer; URL,
# project and environment can be shared. No local profile changes SECRET_PROVIDER.
# Provision exact read ACLs before launch; API may additionally have write-only
# access to the two BFF auth credentials through the bounded setup writer.
# Provider infrastructure and one-shot publication use external operator authority.
# INFISICAL_URL=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=
# INFISICAL_API_CLIENT_ID=
# INFISICAL_API_CLIENT_SECRET=
# INFISICAL_BFF_CLIENT_ID=
# INFISICAL_BFF_CLIENT_SECRET=
# INFISICAL_COMBINED_CLIENT_ID=
# INFISICAL_COMBINED_CLIENT_SECRET=
# INFISICAL_MIGRATION_CLIENT_ID=
# INFISICAL_MIGRATION_CLIENT_SECRET=
# Direct process launch: inject ONLY that process identity through
# SecretProvider__Infisical__ClientId / SecretProvider__Infisical__ClientSecret.
# INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET remain direct-process inputs,
# never Compose/Aspire cross-process projection inputs.

# API token policy (public configuration, not secrets).
# Audience identifies this API resource. A permitted client is an independent
# optional restriction; it never becomes an accepted audience.
KEYCLOAK__AUDIENCE=islamu-event-api
# Omit the variable entirely when no permitted-client restriction is required.
# KEYCLOAK__PERMITTEDCLIENTS__0=
# Additional clients use contiguous indices in direct/Aspire deployments;
# add explicit service environment entries for further Compose indices.

# Owned automated AppHost assurance only. The C# fixture generates these inputs
# through Environment authority; do not enable this profile in an interactive .env.
# Roots must be pre-created, absolute, marked for the exact run and otherwise empty.
# ISLAMU_TEST_RUN_ID=
# ISLAMU_TEST_ROOT=
# ISLAMU_TEST_REPLACEMENT_PASSWORD=
# 1. Core Networking & Ports
# -----------------------------------------------------------------------------
# Runtime environment: Production | Development
# ASPNETCORE_ENVIRONMENT=Production

# Set the canonical HTTPS public address before exposing a deployment.
# Sensitive onboarding links never derive their authority from an incoming Host.
# Without it, the hosting default is localhost only, not wildcard admission.
PUBLIC_BASE_URL=

# Additional exact instance/backend host; never "*". Compose defaults this slot to
# its private service name islamu-event-api. Further indices need explicit
# Compose service environment entries or native deployment-owned configuration.
# EFFECTIVEHOSTAUTHORITY__INSTANCEHOSTS__0=
# An optional operator-owned subdomain base must also be an approved instance host.
# EFFECTIVEHOSTAUTHORITY__SUBDOMAINBASEDOMAINS__0=
# Forwarding is disabled until an exact proxy or bounded network is selected.
# FORWARDEDHEADERSTRUST__FORWARDLIMIT=1
# FORWARDEDHEADERSTRUST__TRUSTLOOPBACKPROXY=false
# FORWARDEDHEADERSTRUST__KNOWNPROXIES__0=
# FORWARDEDHEADERSTRUST__KNOWNNETWORKS__0=
# Operational reports require a separately bound private listener. These fields
# authorize an existing binding; they do not create or expose one.
# OPERATIONALENDPOINTS__ADDRESS=127.0.0.1
# OPERATIONALENDPOINTS__PORT=9091
# Tenant custom domains additionally need an expiring deployment-owned ownership
# attestation; see the custom-domains-and-seo operator guide. Reservations are not proof.

# Optional dedicated administration origin; Compose defaults to admin.localhost.
# This selects the administration host, not the external fleet-management API.
# INSTANCE_ADMIN_PUBLIC_ORIGIN=http://admin.localhost:7002

# Internal HTTP port bindings for Docker Compose
API_HTTP_PORT=7039
UI_HTTP_PORT=7002
KEYCLOAK_HTTP_PORT=8080

# Multi-tenancy mode: SingleTenant | multi_tenant
# SingleTenant is recommended for single organizations or community centers.
DEPLOYMENT_MODE=SingleTenant

# -----------------------------------------------------------------------------
# 2. Secret Authority Bootstrap
# -----------------------------------------------------------------------------
# Provider authority: Environment (direct .env injection) | Infisical | UserSecrets (dev only)
# For standard self-hosting, we recommend keeping "Environment".
SECRET_PROVIDER=Environment

# -----------------------------------------------------------------------------
# 3. Primary Application Database (PostgreSQL default)
# -----------------------------------------------------------------------------
# Provider: PostgreSql | Sqlite | SqlServer | MariaDb | MySql
DATABASE_PROVIDER=PostgreSql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=islamu_event_db

# Schema namespace boundary (PostgreSQL/SQL Server clean tables)
DATABASE_SCHEMA=islamu_event

# Independent injected database credentials: omitted, empty and the retired
# "explore" password are rejected. Runtime, Global and Migrator must not share
# usernames or passwords; never grant runtime roles DDL/superuser/BYPASSRLS.
DATABASE_RUNTIME_USERNAME=islamu_event_runtime
# Each selected database role requires its own username/password fields or aliases.
# Generic Database credentials and sibling roles are not fallback authorities.
# An explicit empty structured credential masks its environment alias.
DATABASE_RUNTIME_PASSWORD=
# Server role passwords must not be explore (case/whitespace-insensitive) or
# match their login name ignoring case. Rotate affected passwords before restart.
# Global health reads require the native health executor, not private-table grants.
DATABASE_GLOBAL_USERNAME=islamu_event_global
DATABASE_GLOBAL_PASSWORD=
# Purpose selected before Local Identity C# workflows; never reuse Runtime/Global.
DATABASE_LOCAL_IDENTITY_WRITER_USERNAME=islamu_event_local_identity_writer
DATABASE_LOCAL_IDENTITY_WRITER_PASSWORD=
# Email mutation accounts are selected before the original setting transaction.
# Neither account may inherit the general Runtime/Global reader credentials.
DATABASE_EMAIL_POLICY_INSTANCE_MUTATION_USERNAME=islamu_email_policy_instance_mutation
DATABASE_EMAIL_POLICY_INSTANCE_MUTATION_PASSWORD=
DATABASE_EMAIL_POLICY_TENANT_MUTATION_USERNAME=islamu_email_policy_tenant_mutation
DATABASE_EMAIL_POLICY_TENANT_MUTATION_PASSWORD=
# Dedicated capability credentials; no Runtime/Global/Migrator credential fallback.
# Keep these logins and passwords distinct from each other and all existing roles.
DATABASE_INSTANCE_KEY_READ_USERNAME=islamu_event_instance_key_read
DATABASE_INSTANCE_KEY_READ_PASSWORD=
DATABASE_INSTANCE_KEY_WRITE_USERNAME=islamu_event_instance_key_write
DATABASE_INSTANCE_KEY_WRITE_PASSWORD=
DATABASE_INSTANCE_KEY_ISSUANCE_USERNAME=islamu_event_instance_key_issuance
DATABASE_INSTANCE_KEY_ISSUANCE_PASSWORD=
DATABASE_PLATFORM_KEY_REPORT_USERNAME=islamu_event_platform_key_report
DATABASE_PLATFORM_KEY_REPORT_PASSWORD=
DATABASE_MIGRATOR_USERNAME=islamu_event_migrator
DATABASE_MIGRATOR_PASSWORD=
# Global uses an independent login/pool for bounded cross-tenant capabilities.
# No Runtime/Migrator/root credential fallback; Global is not universal BYPASSRLS.
# DDL belongs only to the migrator; restart API processes after credential rotation.

# TLS Mode: Prefer | Required | Disabled (Prefer is default for local, Required for remote)
DATABASE_TLS_MODE=Prefer

# -----------------------------------------------------------------------------
# AI credential selection (optional)
# Select metadata only: none | instance | tenant. Official instance providers
# require instance; compatible endpoints may explicitly select none.
# AI_CREDENTIAL_SCOPE=instance
# Secret values are read only from the explicitly selected secret authority.
# Optional Environment authority aliases; leave unset when using Infisical:
# AI_OPENAI_API_KEY=
# AI_ANTHROPIC_API_KEY=
# AI_OPENAI_COMPATIBLE_API_KEY=
# AI_ANTHROPIC_COMPATIBLE_API_KEY=
# AI_AZURE_API_KEY=

# -----------------------------------------------------------------------------
# 4. Authentication Providers
# -----------------------------------------------------------------------------
# Primary provider: local | keycloak | atproto.
# Supported states:
#   local + ATPROTO_LOGIN_ENABLED=false  -> Local Identity only
#   local + ATPROTO_LOGIN_ENABLED=true   -> Local Identity plus AT Protocol
#   keycloak + ATPROTO_LOGIN_ENABLED=false -> Keycloak only
#   keycloak + ATPROTO_LOGIN_ENABLED=true  -> Keycloak plus AT Protocol
#   atproto + ATPROTO_LOGIN_ENABLED=true -> passwordless AT Protocol only
# When atproto is primary, false is rejected and Google SSO is disabled.
AUTHENTICATION_PROVIDER=local
# Optional nonsecret UUID identifying the approved Google/Keycloak credential profile.
# Required for credential maintenance; change it when provisioning/bindings change and
# restart all owning API/BFF processes. Forward explicitly in Compose service overrides.
AUTHENTICATION_CREDENTIAL_PROFILE_REVISION=
# Optional Google BFF runtime inputs when Environment is the selected authority.
# Inject only into owning processes; Compose requires explicit service overrides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATPROTO_LOGIN_ENABLED=false

# Optional exact OIDC issuer trust for automatic verified-email account matching.
# Default is empty. Inject into the API/Standalone process environment; for Compose,
# explicitly forward each nonempty indexed variable through your service override.
# IDENTITYCORRELATION__TRUSTEDISSUERS__0=https://identity.example.org/realms/community

# Optional configured-administrator bootstrap. Leave blank for interactive
# setup; values are copied as names only and never emitted in diagnostics.
# Provider: local | keycloak | atproto. Local uses a stable UUIDv7 subject
# as its username; credential email is optional and separate from legal contact.
INSTANCE_BOOTSTRAP_ADMIN_PROVIDER=
INSTANCE_BOOTSTRAP_ADMIN_SUBJECT=
INSTANCE_BOOTSTRAP_BINDING_GENERATION=
INSTANCE_BOOTSTRAP_ADMIN_EMAIL=
INSTANCE_BOOTSTRAP_ADMIN_FIRST_NAME=
INSTANCE_BOOTSTRAP_ADMIN_LAST_NAME=
# Required only for configured Local bootstrap. Supply through the selected
# secret authority; first-use replacement is required before ordinary sign-in.
INSTANCE_BOOTSTRAP_LOCAL_PASSWORD=

# Development-only opt-in. The isolated local-agent profile requires true;
# normal deployment must leave this false. Initialization secrets come only
# from the selected authority and are not reread after persona completion.
AGENT_BROWSER_SEED_ENABLED=false
AGENT_BROWSER_PERSONA_PASSWORD=
# Required only by the dedicated agent cache; supply through the selected authority.
AGENT_BROWSER_REDIS_PASSWORD=

# Embedded Local Identity JWT signing key. Required when the primary provider is local.
# Generate with: openssl rand -base64 64
AUTHENTICATION_LOCAL_JWT_KEY=
AUTHENTICATION_LOCAL_LOCKOUT_THRESHOLD=5
AUTHENTICATION_LOCAL_LOCKOUT_DURATION_MINUTES=15
# Local credential mutations require an operator-owned, read-only JSON snapshot.
# For containers, this path must identify the mounted file inside the container.
AUTHENTICATION_LOCAL_PASSWORD_BLOCKLIST_PATH=
AUTHENTICATION_LOCAL_PASSWORD_BLOCKLIST_SHA256=
# Native IdentityV3 work factor; calibrate on deployment hardware before release.
AUTHENTICATION_LOCAL_PASSWORD_HASH_ITERATIONS=210000

# Local Identity database topology: colocated (recommended) | external
# Keep 'colocated' for single-instance deployments so credentials share the primary DB.
# Set 'external' only when sharing a central identity database across multiple solutions (e.g. across ISLAMU solutions).
# WARNING: Do NOT blindly mirror with ERASURE_DATABASE_TOPOLOGY (which recommends EmbeddedSqlite for anti-resurrection isolation).
IDENTITY_DATABASE_TOPOLOGY=colocated
# External topology uses discrete endpoint and purpose credentials, never a shared connection string.
IDENTITY_DATABASE_PROVIDER=
IDENTITY_DATABASE_HOST=
IDENTITY_DATABASE_PORT=
IDENTITY_DATABASE_NAME=
IDENTITY_DATABASE_SCHEMA=islamu_identity
IDENTITY_DATABASE_TLS_MODE=Required
IDENTITY_DATABASE_TRUST_SERVER_CERTIFICATE=false
IDENTITY_DATABASE_SERVER_VERSION=
IDENTITY_DATABASE_RUNTIME_USERNAME=
IDENTITY_DATABASE_RUNTIME_PASSWORD=
IDENTITY_DATABASE_MIGRATOR_USERNAME=
IDENTITY_DATABASE_MIGRATOR_PASSWORD=
IDENTITY_DATABASE_LOCAL_IDENTITY_WRITER_USERNAME=
IDENTITY_DATABASE_LOCAL_IDENTITY_WRITER_PASSWORD=

# Keycloak configuration. Required only when AUTHENTICATION_PROVIDER=keycloak.
# Base URL of Keycloak
KEYCLOAK_ENDPOINT=http://localhost:8080
KEYCLOAK_REALM=islamu

# OIDC confidential client for the Blazor BFF. Event startup never imports or
# changes a realm. An explicitly approved absent-client create uses this value;
# rotate Keycloak and this deployment value together, then restart.
KEYCLOAK_BLAZOR_CLIENT_ID=event-blazor
# Generate with: openssl rand -hex 32
KEYCLOAK_BLAZOR_CLIENT_SECRET=

# Optional dedicated lifecycle-email identity; never use the BFF or a human administrator.
# Validate the exported realm grants before enabling. The supported profile matches
# the pinned Keycloak image. This client needs only realm-management/manage-users.
KEYCLOAKLIFECYCLEEMAIL__ENABLED=false
KEYCLOAKLIFECYCLEEMAIL__BASEURL=
KEYCLOAKLIFECYCLEEMAIL__REALM=ISLAMU
KEYCLOAKLIFECYCLEEMAIL__CLIENTID=event-lifecycle
KEYCLOAKLIFECYCLEEMAIL__DEFAULTCLIENTID=event-blazor
KEYCLOAKLIFECYCLEEMAIL__PROVIDERVERSION=26.1.2
KEYCLOAKLIFECYCLEEMAIL__ALLOWLOCALURLS=false
KEYCLOAK_LIFECYCLE_CLIENT_SECRET=

# Dedicated Keycloak database credentials (used by Compose keycloak-db service)
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=

# Initial Keycloak administrator account (consumed by Keycloak, never Event)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 5. Storage (Local Filesystem default)
# -----------------------------------------------------------------------------
# Select local or S3 storage through the application storage setting.
# For S3 cloud storage (MinIO, AWS S3, Cloudflare R2), see public documentation.
LOCAL_STORAGE_ROOT_PATH=/app/storage-data/local

# -----------------------------------------------------------------------------
# 6. Optional Email
# -----------------------------------------------------------------------------
# Zero-email baseline: persisted email.delivery_enabled defaults to false.
# Configure SMTP and explicitly enable delivery through instance admin settings;
# environment values and starting Mailpit do not enable or re-enable delivery.
# Supply SMTP credentials separately through the selected secret authority.
# Optional local capture: docker compose --profile mail up -d mailpit
# Inbox: http://127.0.0.1:8025; container-only SMTP: mailpit:1025, security None.
# Capture is limited to 500 messages in the mailpit_data volume, not real delivery.
# The base Compose topology has no RabbitMQ broker.
EMAIL_DISPATCH_RABBITMQ_ENABLED=false

# -----------------------------------------------------------------------------
# 7. Privacy Erasure Authority (GDPR & Anti-Resurrection)
# -----------------------------------------------------------------------------
# Storage topology: EmbeddedSqlite (recommended default) | CoLocated | ExternalDatabase
# Recommended: EmbeddedSqlite (dedicated local file outside the primary database).
# This prevents post-backup GDPR user erasures from being accidentally resurrected
# if the primary database is ever restored from a backup.
# WARNING: Do NOT blindly match with IDENTITY_DATABASE_TOPOLOGY (which recommends colocated).
ERASURE_DATABASE_TOPOLOGY=EmbeddedSqlite
ERASURE_EMBEDDED_PATH=/app/data/privacy_erasure_authority.db

# Reserved FUTURE moderation recognition anchors; optional for ordinary erasure
# and startup. If provisioned, supply base64-encoded 32 random bytes through the
# selected secret authority (Infisical /api, Environment, or explicitly selected
# shared UserSecrets in Development/Testing only). Preserve the same key and
# nonsecret ID across replicas, restart, restore, and supported backups.
# Never rotate while retained fingerprints or supported backups depend on it.
PRIVACY_ERASURE_IDENTITY_FENCE_KEY_ID=
PRIVACY_ERASURE_IDENTITY_FENCE_KEY=

# External authority database (PostgreSQL only). Used only when
# ERASURE_DATABASE_TOPOLOGY=ExternalDatabase; ignored by EmbeddedSqlite and CoLocated.
# Runtime and migrator logins must be distinct roles.
# ERASURE_DATABASE_HOST=privacy-erasure-db
# ERASURE_DATABASE_PORT=5432
# ERASURE_DATABASE_NAME=islamu_event_privacy_erasure
# ERASURE_DATABASE_TLS_MODE=Prefer
# ERASURE_DATABASE_TRUST_SERVER_CERTIFICATE=false
# ERASURE_DATABASE_RUNTIME_USERNAME=privacy_erasure_runtime
# ERASURE_DATABASE_RUNTIME_PASSWORD=
# ERASURE_DATABASE_MIGRATOR_USERNAME=privacy_erasure_migrator
# ERASURE_DATABASE_MIGRATOR_PASSWORD=

# -----------------------------------------------------------------------------
# 8. First-Run Setup & Administrator Bootstrap
# -----------------------------------------------------------------------------
# Leave SETUP_SECRET blank to generate a single-use secret in the volume on first boot,
# or set an explicit pre-shared key here to unlock /setup.
SETUP_SECRET=

# Bootstrap Mode: Interactive (default web wizard at /setup) | ConfiguredAdministrator (headless)
INSTANCE_BOOTSTRAP_MODE=

# -----------------------------------------------------------------------------
# 9. Operator Legal Identity (Optional Configured-Administrator Bootstrap Seed)
# -----------------------------------------------------------------------------
# Runtime operator identity is stored in the database and configured via the /setup
# onboarding wizard or /admin/instance. These environment variables are optional and
# only used during headless ConfiguredAdministrator bootstrap or to seed first-run
# identity. They do NOT override an already-completed instance.
#
# Unique UUIDv7 identifier for the operating legal entity
INSTANCE__OPERATORIDENTITY__OPERATORID=01912a7e-1234-7000-8000-000000000001
INSTANCE__OPERATORIDENTITY__PUBLICNAME=Community Events Foundation
INSTANCE__OPERATORIDENTITY__LEGALNAME=Community Events Foundation Non-Profit
INSTANCE__OPERATORIDENTITY__ISOFFICIALINSTANCE=false
# Required even for independent instances: replace with your public HTTPS origin,
# without a path or query. This does not declare official-instance status.
INSTANCE__OPERATORIDENTITY__OFFICIALORIGIN=https://example.org
# Use your actual legal form: registered_organization | sole_trader | individual |
# public_body | unincorporated_association.
INSTANCE__OPERATORIDENTITY__OPERATORKINDCODE=registered_organization
INSTANCE__OPERATORIDENTITY__JURISDICTIONCOUNTRYCODE=US
INSTANCE__OPERATORIDENTITY__PUBLICCONTACTEMAIL=contact@example.org
INSTANCE__OPERATORIDENTITY__WEBSITEURL=https://example.org
INSTANCE__OPERATORIDENTITY__LEGALNOTICEURL=https://example.org/legal
INSTANCE__OPERATORIDENTITY__TERMSURL=https://example.org/terms
INSTANCE__OPERATORIDENTITY__PRIVACYURL=https://example.org/privacy

# -----------------------------------------------------------------------------
# 10. Configuration Manifest Bootstrap
# -----------------------------------------------------------------------------
# Split: API reads the manifest after MigrationService completes. MigrationService
# has only migration authority and never receives the manifest or Global secrets.
CONFIGURATION_MANIFEST_MODE=Off
CONFIGURATION_MANIFEST_PATH=/etc/islamu-event/bootstrap/configuration-manifest.json
CONFIGURATION_MANIFEST_HOST_DIRECTORY=./deploy/bootstrap
