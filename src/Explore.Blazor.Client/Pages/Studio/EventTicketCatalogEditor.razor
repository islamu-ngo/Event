@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Clients
@implements IDisposable
@inject IEventTicketingService TicketingService
@inject IEventDayService EventDayService
@inject Explore.Blazor.Client.Contracts.Services.IEventSessionService EventSessionService
@inject IDialogService DialogService
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService FocusService
@inject NavigationManager Navigation

<div class="event-ticket-catalog" data-testid="event-ticket-catalog-editor">
    @if (_isLoading)
    {
        <div class="event-ticket-catalog__state" role="status">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2">Loading ticket catalog…</MudText>
        </div>
    }
    else if (_catalog is null)
    {
        <div class="event-ticket-catalog__state" role="alert">
            @(_errorMessage ?? "The ticket catalog could not be loaded.")
        </div>
    }
    else
    {
        <div class="event-ticket-catalog__header">
            <div class="event-ticket-catalog__summary">
                <MudText Typo="Typo.subtitle1">@(_catalog.StatusName ?? "Catalog")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_catalog.CurrencyCode · @_catalog.TicketTypes.Count ticket types · @_catalog.CapacityPools.Count capacity pools
                </MudText>
            </div>
            <div class="event-ticket-catalog__actions">
                @if (_catalog.HasLink("create-draft"))
                {
                    <MudTextField T="string" Label="Currency" @bind-Value="_currencyCode" Variant="Variant.Outlined" Disabled="_isMutating" data-testid="ticket-catalog-currency" />
                    <AppButton OnClick="CreateDraftAsync" Disabled="@(_isMutating || string.IsNullOrWhiteSpace(_currencyCode))" data-testid="create-ticket-catalog-draft">Create draft</AppButton>
                }
                @if (_catalog.HasLink("clone-draft"))
                {
                    <AppButton OnClick="CloneDraftAsync" Disabled="_isMutating" Variant="Variant.Outlined" data-testid="clone-ticket-catalog-draft">Edit as new draft</AppButton>
                }
                @if (_catalog.HasLink("publish"))
                {
                    <AppButton OnClick="PublishAsync" Disabled="_isMutating" StartIcon="@Icons.Material.Filled.Publish" data-testid="publish-ticket-catalog">Publish</AppButton>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="event-ticket-catalog__message" role="alert" data-testid="ticket-catalog-error">@_errorMessage</div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="event-ticket-catalog__message" role="status" data-testid="ticket-catalog-status">@_statusMessage</div>
        }

        @if (_catalog.PublicationPreflight?.IsPaidCatalog == true)
        {
            <section class="event-ticket-catalog__section event-ticket-catalog__commerce" aria-labelledby="paid-publication-title" data-testid="paid-publication-readiness">
                <div class="event-ticket-catalog__section-header">
                    <div>
                        <h3 id="paid-publication-title" class="mud-typography mud-typography-h6">Paid publication readiness</h3>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Catalog currency checked by the server: @_catalog.CurrencyCode</MudText>
                    </div>
                    @if (_catalog.HasLink("preflight"))
                    {
                        <AppButton OnClick="RefreshReadinessAsync" Disabled="_isMutating" Variant="Variant.Outlined" data-testid="refresh-paid-publication-readiness">Refresh readiness</AppButton>
                    }
                </div>

                @if (_catalog.PublicationPreflight.IsReady)
                {
                    <div class="event-ticket-catalog__readiness event-ticket-catalog__readiness--ready" role="status" data-testid="paid-publication-ready">
                        All server publication checks passed.
                    </div>
                }
                else
                {
                    <div class="event-ticket-catalog__readiness" role="alert" data-testid="paid-publication-blockers">
                        <MudText Typo="Typo.subtitle2">Resolve these blockers before publishing:</MudText>
                        <ul>
                            @foreach (var blocker in _catalog.PublicationPreflight.Blockers)
                            {
                                <li>@blocker.Explanation</li>
                            }
                        </ul>
                    </div>
                }

                <div class="event-ticket-catalog__commerce-grid">
                    <div class="event-ticket-catalog__commerce-panel">
                        <MudText Typo="Typo.subtitle1">Commercial disclosures</MudText>
                        @if (_catalog.HasLink("commercial-disclosures"))
                        {
                            <MudTextField T="string" Label="Merchant disclosure" @bind-Value="_merchantDisclosureText" Lines="3" Variant="Variant.Outlined" Required="true" Disabled="_isMutating" data-testid="merchant-disclosure" />
                            <MudTextField T="string" Label="Refund policy disclosure" @bind-Value="_refundPolicyDisclosureText" Lines="3" Variant="Variant.Outlined" Required="true" Disabled="_isMutating" data-testid="refund-policy-disclosure" />
                            <MudTextField T="string" Label="Support contact disclosure" @bind-Value="_supportContactDisclosureText" Lines="3" Variant="Variant.Outlined" Required="true" Disabled="_isMutating" data-testid="support-contact-disclosure" />
                            <AppButton OnClick="SaveDisclosuresAsync" Disabled="@(_isMutating || !DisclosuresAreComplete)" data-testid="save-commercial-disclosures">Save disclosures</AppButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@DisclosureSummary</MudText>
                        }
                    </div>

                    <div class="event-ticket-catalog__commerce-panel">
                        <MudText Typo="Typo.subtitle1">Payment connection</MudText>
                        @if (!_catalog.HasLink("payment-connection"))
                        {
                            <MudText Typo="Typo.body2" data-testid="payment-connection-not-advertised">Payment connection details are unavailable with the current affordances.</MudText>
                        }
                        else if (_isLoadingPaymentConnection)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (_paymentConnectionUnavailable)
                        {
                            <MudText Typo="Typo.body2" role="alert" data-testid="payment-connection-unavailable">Payment connection status could not be loaded.</MudText>
                        }
                        else if (_paymentConnection?.Connection is null)
                        {
                            <MudText Typo="Typo.body2" data-testid="payment-connection-missing">No payment connection is currently available.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" data-testid="payment-connection-present">A payment connection is available. The server readiness checks above determine whether it can be used.</MudText>
                        }
                        @if (_catalog.HasLink("start-onboarding"))
                        {
                            <AppButton OnClick="StartPaymentOnboardingAsync" Disabled="_isMutating" Variant="Variant.Outlined" data-testid="start-payment-onboarding">Open payment onboarding</AppButton>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="event-ticket-catalog__section" aria-labelledby="ticket-types-title">
            <div class="event-ticket-catalog__section-header">
                <h3 id="ticket-types-title" class="mud-typography mud-typography-h6">Ticket types</h3>
                @if (CanManageTicketTypes && _catalog.HasLink("create-type"))
                {
                    <AppButton OnClick="ShowNewTicketType" Disabled="_isMutating" StartIcon="@Icons.Material.Filled.Add" data-testid="add-ticket-type">Add ticket type</AppButton>
                }
            </div>
            @if (_editingTicketType is not null)
            {
                <EventTicketTypeEditor Model="_editingTicketType"
                                       CapacityPools="_catalog.CapacityPools"
                                       EventDays="_eventDays"
                                       EventSessions="_eventSessions"
                                       SupportDataUnavailable="_supportDataUnavailable"
                                       IsSaving="_isMutating"
                                       OnSave="SaveTicketTypeAsync"
                                       OnCancel="CancelTicketTypeEdit" />
            }
            @if (_catalog.TicketTypes.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No ticket types yet.</MudText>
            }
            else
            {
                <div class="event-ticket-catalog__cards">
                    @foreach (var ticketType in _catalog.TicketTypes)
                    {
                        <article class="event-ticket-catalog__card" data-testid="ticket-type-card">
                            <div>
                                <MudText Typo="Typo.subtitle1">@ticketType.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@(ticketType.TicketPricingModeName ?? ticketType.TicketPricingModeCode ?? "Pricing") · @ticketType.Entitlements.Count entitlement(s)</MudText>
                                @if (ticketType.CapacityPoolId is { } poolId)
                                {
                                    <MudText Typo="Typo.caption">Capacity: @(PoolName(poolId) ?? "Shared pool")</MudText>
                                }
                            </div>
                            <div class="event-ticket-catalog__item-actions">
                                @if (CanManageTicketTypes && ticketType.HasLink("edit"))
                                {
                                    <AppButton OnClick="@(() => EditTicketType(ticketType))" Disabled="_isMutating" Variant="Variant.Text" data-testid="edit-ticket-type">Edit</AppButton>
                                }
                                @if (CanManageTicketTypes && ticketType.HasLink("delete"))
                                {
                                    <AppButton OnClick="@(() => DeleteTicketTypeAsync(ticketType.Id))" Disabled="_isMutating" Variant="Variant.Text" Color="Color.Error" data-testid="delete-ticket-type">Delete</AppButton>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="event-ticket-catalog__section" aria-labelledby="capacity-pools-title">
            <div class="event-ticket-catalog__section-header">
                <h3 id="capacity-pools-title" class="mud-typography mud-typography-h6">Capacity pools</h3>
                @if (CanManageCapacityPools && _catalog.HasLink("create-pool"))
                {
                    <AppButton OnClick="ShowNewCapacityPool" Disabled="_isMutating" StartIcon="@Icons.Material.Filled.Add" data-testid="add-capacity-pool">Add capacity pool</AppButton>
                }
            </div>
            @if (_editingCapacityPool is not null)
            {
                <EventCapacityPoolEditor Model="_editingCapacityPool" IsSaving="_isMutating" OnSave="SaveCapacityPoolAsync" OnCancel="CancelCapacityPoolEdit" />
            }
            @if (_catalog.CapacityPools.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No shared capacity pools.</MudText>
            }
            else
            {
                <div class="event-ticket-catalog__cards">
                    @foreach (var pool in _catalog.CapacityPools)
                    {
                        <article class="event-ticket-catalog__card" data-testid="capacity-pool-card">
                            <div>
                                <MudText Typo="Typo.subtitle1">@pool.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@(pool.MaximumQuantity?.ToString() ?? "Unlimited") places · @(pool.CapacityHoldPolicyName ?? pool.CapacityHoldPolicyCode) · @(pool.CapacityOversellPolicyName ?? pool.CapacityOversellPolicyCode)</MudText>
                                <MudText Typo="Typo.caption">Used by @TicketTypeCount(pool.Id) ticket type(s)</MudText>
                            </div>
                            <div class="event-ticket-catalog__item-actions">
                                @if (CanManageCapacityPools && pool.HasLink("edit"))
                                {
                                    <AppButton OnClick="@(() => EditCapacityPool(pool))" Disabled="_isMutating" Variant="Variant.Text" data-testid="edit-capacity-pool">Edit</AppButton>
                                }
                                @if (CanManageCapacityPools && pool.HasLink("delete"))
                                {
                                    <AppButton OnClick="@(() => DeleteCapacityPoolAsync(pool.Id))" Disabled="_isMutating" Variant="Variant.Text" Color="Color.Error" data-testid="delete-capacity-pool">Delete</AppButton>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public bool CanManageTicketTypes { get; set; }
    [Parameter] public bool CanManageCapacityPools { get; set; }

    private EventTicketCatalogState? _catalog;
    private Guid _loadedEventId;
    private bool _isLoading;
    private bool _isMutating;
    private string? _errorMessage;
    private string? _statusMessage;
    private string _currencyCode = "USD";
    private string _merchantDisclosureText = string.Empty;
    private string _refundPolicyDisclosureText = string.Empty;
    private string _supportContactDisclosureText = string.Empty;
    private HalResourceOfEventOrganizerPaymentConnectionManagementDto? _paymentConnection;
    private bool _isLoadingPaymentConnection;
    private bool _paymentConnectionUnavailable;
    private TicketTypeEditModel? _editingTicketType;
    private CapacityPoolEditModel? _editingCapacityPool;
    private IReadOnlyList<EventDayListDto> _eventDays = [];
    private IReadOnlyList<EventSessionListDto> _eventSessions = [];
    private bool _supportDataUnavailable;
    private CancellationTokenSource? _requestCancellation;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed || EventId == _loadedEventId)
        {
            return;
        }

        CancelPendingRequests();
        _loadedEventId = EventId;
        _catalog = null;
        _errorMessage = null;
        _statusMessage = null;
        _editingTicketType = null;
        _editingCapacityPool = null;
        _eventDays = [];
        _eventSessions = [];
        _supportDataUnavailable = false;
        _isLoading = EventId != Guid.Empty;
        _isMutating = false;

        if (EventId == Guid.Empty)
        {
            return;
        }

        var requestCancellation = new CancellationTokenSource();
        _requestCancellation = requestCancellation;
        var eventId = EventId;
        await Task.WhenAll(
            LoadAsync(eventId, requestCancellation.Token),
            LoadSupportDataAsync(eventId, requestCancellation.Token));
    }

    private async Task LoadAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            EventTicketCatalogState? catalog = await TicketingService.GetCatalogAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            _catalog = catalog;
            if (catalog is not null)
            {
                ApplyCatalog(catalog);
                await LoadPaymentConnectionAsync(eventId, cancellationToken);
                await Announcer.AnnouncePoliteAsync($"Ticket catalog loaded: {catalog.TicketTypes.Count} ticket types and {catalog.CapacityPools.Count} capacity pools.");
            }
            else
            {
                _errorMessage = "The ticket catalog could not be loaded.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            _catalog = null;
            _errorMessage = "The ticket catalog could not be loaded.";
            await Announcer.AnnounceAssertiveAsync(_errorMessage);
        }
        finally
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _isLoading = false;
            }
        }
    }

    private async Task LoadSupportDataAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            var daysTask = EventDayService.GetDaysByEventAsync(eventId, includeManaged: true, cancellationToken);
            var sessionsTask = EventSessionService.GetSessionsByEventAsync(eventId, includeManagedSessions: true, cancellationToken);
            await Task.WhenAll(daysTask, sessionsTask);
            IReadOnlyList<EventDayListDto> eventDays = (await daysTask).Where(item => item.Id is not null).OrderBy(item => item.SortOrder).ToArray();
            IReadOnlyList<EventSessionListDto> eventSessions = (await sessionsTask).Where(item => item.Id is not null).OrderBy(item => item.StartTime).ToArray();
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            _eventDays = eventDays;
            _eventSessions = eventSessions;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            _supportDataUnavailable = true;
            _eventDays = [];
            _eventSessions = [];
        }
    }

    private string? PoolName(Guid poolId) => _catalog?.CapacityPools.FirstOrDefault(pool => pool.Id == poolId)?.Name;
    private int TicketTypeCount(Guid poolId) => _catalog?.TicketTypes.Count(ticket => ticket.CapacityPoolId == poolId) ?? 0;
    private bool DisclosuresAreComplete =>
        !string.IsNullOrWhiteSpace(_merchantDisclosureText)
        && !string.IsNullOrWhiteSpace(_refundPolicyDisclosureText)
        && !string.IsNullOrWhiteSpace(_supportContactDisclosureText);
    private string DisclosureSummary => DisclosuresAreComplete
        ? "Commercial disclosures are configured."
        : "Commercial disclosures are incomplete and cannot be edited with the current affordances.";

    private void ShowNewTicketType() => _editingTicketType = TicketTypeEditModel.Create();
    private void EditTicketType(EventTicketTypeState ticketType) => _editingTicketType = TicketTypeEditModel.From(ticketType);
    private void CancelTicketTypeEdit() => _editingTicketType = null;
    private void ShowNewCapacityPool() => _editingCapacityPool = CapacityPoolEditModel.Create();
    private void EditCapacityPool(EventCapacityPoolState pool) => _editingCapacityPool = CapacityPoolEditModel.From(pool);
    private void CancelCapacityPoolEdit() => _editingCapacityPool = null;

    private Task CreateDraftAsync() => MutateAsync(
        (eventId, cancellationToken) => TicketingService.CreateDraftAsync(eventId, new CreateEventTicketCatalogDraftCommand { EventId = eventId, CurrencyCode = _currencyCode.Trim().ToUpperInvariant() }, cancellationToken),
        "Draft created.");

    private async Task CloneDraftAsync()
    {
        if (await ConfirmAsync("Create ticket catalog draft", "Create a new draft from the published catalog?", "Create draft"))
        {
            await MutateAsync((eventId, cancellationToken) => TicketingService.CloneDraftAsync(eventId, cancellationToken), "Draft created from the published catalog.");
        }
    }
    private async Task PublishAsync()
    {
        if (await ConfirmAsync("Publish ticket catalog", "Publish this catalog for attendee use?", "Publish"))
        {
            await MutateAsync((eventId, cancellationToken) => TicketingService.PublishAsync(eventId, cancellationToken), "Ticket catalog published.");
        }
    }

    private Task SaveDisclosuresAsync() => MutateAsync(
        (eventId, cancellationToken) => TicketingService.UpdateCommercialDisclosuresAsync(
            eventId,
            new UpdateEventTicketCatalogCommercialDisclosuresCommand
            {
                EventId = eventId,
                MerchantDisclosureText = _merchantDisclosureText.Trim(),
                RefundPolicyDisclosureText = _refundPolicyDisclosureText.Trim(),
                SupportContactDisclosureText = _supportContactDisclosureText.Trim()
            },
            cancellationToken),
        "Commercial disclosures saved.");

    private async Task RefreshReadinessAsync()
    {
        CancellationToken cancellationToken = _requestCancellation?.Token ?? default;
        var eventId = EventId;
        if (!IsCurrentRequest(eventId, cancellationToken) || _catalog?.HasLink("preflight") != true)
        {
            return;
        }

        _isMutating = true;
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            HalResourceOfPaidEventPublicationPreflightDto resource = await TicketingService.GetPaidPublicationPreflightAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (resource.EventId != eventId || !IsCurrentRequest(eventId, cancellationToken))
            {
                _errorMessage = "Paid publication readiness could not be refreshed.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
                return;
            }

            ApplyPreflight(resource);
            _statusMessage = "Paid publication readiness refreshed.";
            await Announcer.AnnouncePoliteAsync(_statusMessage);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _errorMessage = "Paid publication readiness could not be refreshed.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
            }
        }
        finally
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _isMutating = false;
            }
        }
    }

    private async Task StartPaymentOnboardingAsync()
    {
        CancellationToken cancellationToken = _requestCancellation?.Token ?? default;
        var eventId = EventId;
        if (!IsCurrentRequest(eventId, cancellationToken) || _catalog?.HasLink("start-onboarding") != true)
        {
            return;
        }

        _isMutating = true;
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            BaseCommandResponseOfOrganizerPaymentOnboardingLinkResult response = await TicketingService.StartPaymentOnboardingAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            if (response.Success != true || response.Id?.OnboardingUrl is null)
            {
                _errorMessage = "Payment onboarding could not be started.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
                return;
            }

            Navigation.NavigateTo(response.Id.OnboardingUrl.ToString(), forceLoad: true);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _errorMessage = "Payment onboarding could not be started.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
            }
        }
        finally
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _isMutating = false;
            }
        }
    }

    private async Task SaveTicketTypeAsync(TicketTypeEditModel model)
    {
        await MutateAsync(
            (eventId, cancellationToken) => model.Id is { } id
                ? TicketingService.UpdateTicketTypeAsync(eventId, id, model.ToRequest(), cancellationToken)
                : TicketingService.CreateTicketTypeAsync(eventId, model.ToRequest(), cancellationToken),
            model.Id is null ? "Ticket type created." : "Ticket type updated.");
        if (_errorMessage is null)
        {
            _editingTicketType = null;
        }
    }

    private async Task DeleteTicketTypeAsync(Guid ticketTypeId)
    {
        if (await ConfirmAsync("Delete ticket type", "Delete this ticket type?", "Delete"))
        {
            await MutateAsync((eventId, cancellationToken) => TicketingService.DeleteTicketTypeAsync(eventId, ticketTypeId, cancellationToken), "Ticket type deleted.");
        }
    }

    private async Task SaveCapacityPoolAsync(CapacityPoolEditModel model)
    {
        await MutateAsync(
            (eventId, cancellationToken) => model.Id is { } id
                ? TicketingService.UpdateCapacityPoolAsync(eventId, id, model.ToRequest(), cancellationToken)
                : TicketingService.CreateCapacityPoolAsync(eventId, model.ToRequest(), cancellationToken),
            model.Id is null ? "Capacity pool created." : "Capacity pool updated.");
        if (_errorMessage is null)
        {
            _editingCapacityPool = null;
        }
    }

    private async Task DeleteCapacityPoolAsync(Guid capacityPoolId)
    {
        if (await ConfirmAsync("Delete capacity pool", "Delete this shared capacity pool?", "Delete"))
        {
            await MutateAsync((eventId, cancellationToken) => TicketingService.DeleteCapacityPoolAsync(eventId, capacityPoolId, cancellationToken), "Capacity pool deleted.");
        }
    }

    private async Task MutateAsync(Func<Guid, CancellationToken, Task<BaseCommandResponseOfGuid>> mutation, string successMessage)
    {
        CancellationToken cancellationToken = _requestCancellation?.Token ?? default;
        var eventId = EventId;
        if (!IsCurrentRequest(eventId, cancellationToken))
        {
            return;
        }

        _isMutating = true;
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            BaseCommandResponseOfGuid response = await mutation(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            if (response.Success != true)
            {
                _errorMessage = response.Message ?? "The ticket catalog change could not be saved.";
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
                return;
            }
            _statusMessage = successMessage;
            await Announcer.AnnouncePoliteAsync(successMessage);
            cancellationToken.ThrowIfCancellationRequested();
            EventTicketCatalogState? catalog = await TicketingService.GetCatalogAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                if (catalog is not null)
                {
                    ApplyCatalog(catalog);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (!IsCurrentRequest(eventId, cancellationToken))
            {
                return;
            }

            _errorMessage = "The ticket catalog change could not be saved.";
            await Announcer.AnnounceAssertiveAsync(_errorMessage);
        }
        finally
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _isMutating = false;
            }
        }
    }

    private void ApplyCatalog(EventTicketCatalogState catalog)
    {
        _catalog = catalog;
        _currencyCode = catalog.CurrencyCode;
        _merchantDisclosureText = catalog.MerchantDisclosureText ?? string.Empty;
        _refundPolicyDisclosureText = catalog.RefundPolicyDisclosureText ?? string.Empty;
        _supportContactDisclosureText = catalog.SupportContactDisclosureText ?? string.Empty;
    }

    private void ApplyPreflight(HalResourceOfPaidEventPublicationPreflightDto resource)
    {
        if (_catalog is null)
        {
            return;
        }

        var links = new Dictionary<string, HalLink>(_catalog.Links, StringComparer.Ordinal);
        links.Remove("publish");
        if (resource._links?.TryGetValue("publish", out HalLink? publish) == true
            && !string.IsNullOrWhiteSpace(publish.Href))
        {
            links["publish"] = publish;
        }

        _catalog = _catalog with
        {
            PublicationPreflight = new EventTicketCatalogPaidPreflightState(
                resource.IsPaidCatalog == true,
                resource.IsReady == true,
                resource.Blockers?
                    .Where(blocker => !string.IsNullOrWhiteSpace(blocker.Code) && !string.IsNullOrWhiteSpace(blocker.Explanation))
                    .Select(blocker => new EventTicketCatalogPaidPreflightBlockerState(blocker.Code!, blocker.Explanation!))
                    .ToArray() ?? []),
            Links = links
        };
    }

    private async Task LoadPaymentConnectionAsync(Guid eventId, CancellationToken cancellationToken)
    {
        _paymentConnection = null;
        _paymentConnectionUnavailable = false;
        if (_catalog?.PublicationPreflight?.IsPaidCatalog != true || !_catalog.HasLink("payment-connection"))
        {
            return;
        }

        _isLoadingPaymentConnection = true;
        try
        {
            HalResourceOfEventOrganizerPaymentConnectionManagementDto resource = await TicketingService.GetPaymentConnectionAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (IsCurrentRequest(eventId, cancellationToken) && resource.EventId == eventId)
            {
                _paymentConnection = resource;
            }
            else if (IsCurrentRequest(eventId, cancellationToken))
            {
                _paymentConnectionUnavailable = true;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _paymentConnectionUnavailable = true;
            }
        }
        finally
        {
            if (IsCurrentRequest(eventId, cancellationToken))
            {
                _isLoadingPaymentConnection = false;
            }
        }
    }

    private bool IsCurrentRequest(Guid eventId, CancellationToken cancellationToken) =>
        !_disposed && !cancellationToken.IsCancellationRequested && eventId == EventId;

    private void CancelPendingRequests()
    {
        CancellationTokenSource? requestCancellation = _requestCancellation;
        _requestCancellation = null;
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
    }

    private async Task<bool> ConfirmAsync(string title, string message, string yesText)
    {
        await FocusService.SaveFocusAsync();
        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                title,
                message,
                yesText: yesText,
                cancelText: "Cancel",
                options: DialogOptionsFactory.Confirmation());
            return confirmed == true;
        }
        finally
        {
            await FocusService.RestoreFocusAsync();
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        CancelPendingRequests();
    }
}
