    private readonly record struct IntegrationHalItem(JsonElement Element)
    {
        public Guid? Id => Guid("id", "connectionId", "bindingId", "channelId");
        public string Title(string fallback) => Text("name", "displayName", "title", fallback) ?? fallback;
        public bool HasLink(string rel) => Element.TryGetProperty("_links", out var links) && links.ValueKind == JsonValueKind.Object && links.TryGetProperty(rel, out _);
        public HalLink? Link(string rel) => Element.TryGetProperty("_links", out var links) && links.ValueKind == JsonValueKind.Object && links.TryGetProperty(rel, out var link)
