@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Locations
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Pages.Events.Components
@using Explore.Blazor.Client.Validators
@using FluentValidation
@using MudBlazor
@inject IDialogService DialogService

<MudDialog Style="max-block-size: calc(100dvh - (2 * var(--isl-space-4)))">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit"
                     Class="mb-n1"
                     Style="margin-inline-end: var(--isl-space-3)" />
            Edit Location
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (SearchLink is { } searchLink)
        {
            <AddressSuggestionCombobox Id="edit-location-address-suggestion"
                                       Label="Find a saved address"
                                       OrganizationId="OrganizationId"
                                       LocationId="ExistingLocation.Id"
                                       ExpectedConcurrencyStamp="ExistingLocation.ConcurrencyStamp"
                                       SearchLink="searchLink"
                                       SuggestionSelected="ApplySuggestionAsync" />
            <MudText Class="my-3" Typo="Typo.body2">
                Or update the address manually.
            </MudText>
        }
        @* Ownership is a consent decision, not a form field: it is never saved as part of the address edit. *@
        <div class="edit-location__ownership mb-3">
            <MudButton Elevation="0" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Home"
                       data-testid="edit-location-private-home"
                       OnClick="OpenPrivateHomeConsentAsync">
                @(IsPrivateHome
                    ? "Take ownership of this private home"
                    : "Mark as private home")
            </MudButton>
        </div>

        <div class="edit-location-dialog__manual-fields">
            <EditForm EditContext="_editContext">
                <MudTextField data-testid="edit-location-full-name" Variant="Variant.Outlined" T="string" @bind-Value="_form.FullName" Label="Name" Required="true" RequiredError="Name is required." />
                <MudTextField data-testid="edit-location-address" Variant="Variant.Outlined" T="string" @bind-Value="_form.Address" Label="Address" />
                <MudTextField data-testid="edit-location-city" Variant="Variant.Outlined" T="string" @bind-Value="_form.City" Label="City" />
                <MudTextField data-testid="edit-location-postcode" Variant="Variant.Outlined" T="string" @bind-Value="_form.Postcode" Label="Postcode" />
                <MudTextField data-testid="edit-location-country" Variant="Variant.Outlined" T="string" @bind-Value="_form.Country" Label="Country" />
                <MudTextField data-testid="edit-location-timezone" Variant="Variant.Outlined" T="string" @bind-Value="_form.Timezone" Label="Timezone" />
            </EditForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton data-testid="edit-location-submit" Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LocationDto ExistingLocation { get; set; }

    [Parameter]
    public HalLink? SearchLink { get; set; }

    [Parameter]
    public Guid? OrganizationId { get; set; }

    private EditContext _editContext = default!;
    private LocationEditForm _form = new();
    private HalResourceOfAddressSuggestionDto? _selectedSuggestion;

    protected override void OnInitialized()
    {
        _form = new LocationEditForm
        {
            FullName = ExistingLocation.FullName ?? string.Empty,
            Address = ExistingLocation.Address ?? string.Empty,
            City = ExistingLocation.City ?? string.Empty,
            Postcode = ExistingLocation.Postcode ?? string.Empty,
            Country = ExistingLocation.Country ?? string.Empty,
            Timezone = ExistingLocation.Timezone
        };

        _editContext = new EditContext(_form);
    }

    private void Submit()
    {
        if (_editContext.Validate())
        {
            if (string.IsNullOrWhiteSpace(_form.FullName))
            {
                return;
            }

            if (SelectionMatchesForm())
            {
                MudDialog.Close(DialogResult.Ok(new UpdateLocationDto
                {
                    AddressSelectionToken = _selectedSuggestion!.SelectionToken,
                    OrganizationId = OrganizationId
                }));
                return;
            }

            MudDialog.Close(DialogResult.Ok(new UpdateLocationDto
            {
                FullName = new UpdateLocationFullNameDto { Value = _form.FullName.Trim() },
                Address = new UpdateLocationAddressDto { Value = _form.Address.Trim() },
                City = new UpdateLocationCityDto { Value = _form.City.Trim() },
                Postcode = new UpdateLocationPostcodeDto { Value = _form.Postcode.Trim() },
                Country = new UpdateLocationCountryDto { Value = _form.Country.Trim() },
                Timezone = new UpdateLocationTimezoneDto
                {
                    Value = new OptionalUpdateOfstring
                    {
                        HasValue = true,
                        Value = string.IsNullOrWhiteSpace(_form.Timezone) ? null : _form.Timezone.Trim()
                    }
                },
                OrganizationId = OrganizationId
            }));
        }
    }

    private Task ApplySuggestionAsync(HalResourceOfAddressSuggestionDto suggestion)
    {
        _form.FullName = suggestion.DisplayName;
        _form.Address = suggestion.Address;
        _form.Postcode = suggestion.Postcode;
        _form.City = suggestion.City ?? string.Empty;
        _form.Country = suggestion.Country ?? string.Empty;
        _form.Timezone = suggestion.Timezone;
        _selectedSuggestion = suggestion;
        return Task.CompletedTask;
    }

    private bool SelectionMatchesForm() =>
        _selectedSuggestion is { SelectionToken: not null } selection
        && string.Equals(
            _form.FullName.Trim(),
            selection.DisplayName.Trim(),
            StringComparison.Ordinal)
        && string.Equals(
            _form.Address.Trim(),
            selection.Address.Trim(),
            StringComparison.Ordinal)
        && string.Equals(
            _form.Postcode.Trim(),
            selection.Postcode.Trim(),
            StringComparison.Ordinal)
        && string.Equals(
            _form.City.Trim(),
            selection.City?.Trim() ?? string.Empty,
            StringComparison.Ordinal)
        && string.Equals(
            _form.Country.Trim(),
            selection.Country?.Trim() ?? string.Empty,
            StringComparison.Ordinal)
        && string.Equals(
            _form.Timezone?.Trim() ?? string.Empty,
            selection.Timezone?.Trim() ?? string.Empty,
            StringComparison.Ordinal);

    void Cancel() => MudDialog.Cancel();

    /// <summary>Private Home lookup id; kept local because the client never persists lookup tables.</summary>
    private const int PrivateHomeLocationKindId = 5;

    private bool IsPrivateHome => ExistingLocation.LocationKindId == PrivateHomeLocationKindId;

    private async Task OpenPrivateHomeConsentAsync()
    {
        var parameters = new DialogParameters<HomeOwnerConsentDialog>
        {
            { component => component.LocationId, ExistingLocation.Id ?? Guid.Empty },
            { component => component.ExpectedConcurrencyStamp, ExistingLocation.ConcurrencyStamp ?? Guid.Empty },
            {
                component => component.Mode,
                IsPrivateHome ? HomeOwnerConsentMode.Transfer : HomeOwnerConsentMode.Classify
            }
        };

        await DialogService.ShowAsync<HomeOwnerConsentDialog>("Private home consent", parameters);
    }

    private sealed class LocationEditForm
    {
        public string FullName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Postcode { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public string? Timezone { get; set; }
    }
}
