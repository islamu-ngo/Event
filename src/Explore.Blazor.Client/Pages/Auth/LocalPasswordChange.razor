@* ABOUTME: Presents the first-use Local password replacement screen without ordinary authentication. *@
@* ABOUTME: Keeps restricted challenge authority outside component state and browser-readable data. *@

@page "/auth/local/change-password"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Explore.Blazor.Client.Components.Common
@using Explore.Blazor.Client.Models.Requests
@using MudBlazor
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Change your password</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Class="pa-6">
        <h1>Change your password</h1>
        <p>Choose a new password before signing in. This temporary step does not sign you in.</p>
        <p id="local-password-help">Use 12 to 128 characters and choose a password different from your temporary password.</p>
        <form id="local-password-change-form" data-local-password-change="true"
              @onsubmit="SubmitAsync" @onsubmit:preventDefault="true"
              aria-busy="@(_isSubmitting ? "true" : "false")">
            <MudStack Spacing="3">
                <label for="local-new-password">New password</label>
                <AppTextField T="string" Id="local-new-password"
                              @bind-Value="_newPassword" InputType="InputType.Password"
                              Required="true" MaxLength="128" minlength="12"
                              Disabled="_isSubmitting" FullWidth="true"
                              autocomplete="new-password" HelperId="@DescriptionIds"
                              ErrorId="local-new-password-validation" Error="@(_errorMessage is not null)" />
                <label for="local-confirm-password">Confirm new password</label>
                <AppTextField T="string" Id="local-confirm-password"
                              @bind-Value="_confirmPassword" InputType="InputType.Password"
                              Required="true" MaxLength="128" minlength="12"
                              Disabled="_isSubmitting" FullWidth="true"
                              autocomplete="new-password" HelperId="@DescriptionIds"
                              ErrorId="local-confirm-password-validation" Error="@(_errorMessage is not null)" />
                @if (_errorMessage is not null)
                {
                    <p id="local-password-error" role="alert">@_errorMessage</p>
                }
                <AppButton ButtonType="ButtonType.Submit" Disabled="_isSubmitting" FullWidth="true">
                    @(_isSubmitting ? "Changing password…" : "Change password")
                </AppButton>
            </MudStack>
        </form>
        <p class="mt-4"><a href="/login">Return to sign in</a></p>
    </MudPaper>
</MudContainer>

@code {
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;
    private IJSObjectReference? _module;
    private string DescriptionIds => _errorMessage is null
        ? "local-password-help"
        : "local-password-help local-password-error";

    private async Task SubmitAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _errorMessage = null;
        if (_newPassword.Length is < 12 or > 128)
        {
            _errorMessage = "Use a password containing 12 to 128 characters.";
            ClearPasswords();
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "The passwords do not match. Enter the same new password in both fields.";
            ClearPasswords();
            return;
        }

        _isSubmitting = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/bff.js");
            var response = await _module.InvokeAsync<LocalBffAuthenticationResponse?>(
                "replaceLocalCredential",
                new LocalBffCredentialReplacementRequest(NewPassword: _newPassword));
            ClearPasswords();
            if (response is { RedirectUrl: "/login", ErrorCode: null })
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            _errorMessage = response?.ErrorCode switch
            {
                "password_rejected" => "Choose a different password containing 12 to 128 characters that meets the password requirements.",
                "replacement_required" => "This temporary password-change step has expired or is unavailable. Return to sign in and try again.",
                "replacement_conflict" => "This password-change step is no longer valid. Return to sign in and try again.",
                "rate_limited" => "Too many attempts. Wait before trying again; if this step expires, return to sign in.",
                _ => "Your password could not be changed. Try again, or return to sign in."
            };
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or OperationCanceledException)
        {
            _errorMessage = "Your password could not be changed. Try again, or return to sign in.";
        }
        finally
        {
            ClearPasswords();
            _isSubmitting = false;
        }
    }

    private void ClearPasswords()
    {
        _newPassword = string.Empty;
        _confirmPassword = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        ClearPasswords();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
