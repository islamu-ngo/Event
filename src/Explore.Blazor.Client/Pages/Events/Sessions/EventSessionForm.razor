@using System.Linq.Expressions
@using MudBlazor

<div class="@FormGridClass">
    <MudTextField Variant="Variant.Outlined" T="string"
                  Value="@Title"
                  ValueChanged="TitleChanged"
                  For="@TitleFor"
                  Required="true"
                  FullWidth="true"
                  Placeholder="Program item title"
                  aria-label="Program item title" />

    <MudTextField Variant="Variant.Outlined" T="string"
                  Value="@Description"
                  ValueChanged="DescriptionChanged"
                  For="@DescriptionFor"
                  FullWidth="true"
                  Lines="4"
                  Placeholder="What will attendees learn or do?"
                  aria-label="Program item description" />

    <MudDatePicker Label="Program item date"
                   Date="@SessionDate"
                   DateChanged="SessionDateChanged"
                   Required="true"
                   Variant="Variant.Outlined" />

    <div class="@TimeGridClass">
        <MudTimePicker Label="Start time"
                       Time="@StartTime"
                       TimeChanged="StartTimeChanged"
                       Required="true"
                       Variant="Variant.Outlined" />
        <MudTimePicker Label="End time"
                       Time="@EndTime"
                       TimeChanged="EndTimeChanged"
                       Required="true"
                       Variant="Variant.Outlined" />
    </div>

    <MudSelect T="Guid?"
               Label="Location"
               Value="@LocationId"
               ValueChanged="LocationIdChanged"
               Variant="Variant.Outlined"
               AnchorOrigin="Origin.BottomCenter">
        @LocationOptions
    </MudSelect>

    <MudSelect T="Guid?"
               Label="Room"
               Value="@RoomId"
               ValueChanged="RoomIdChanged"
               Variant="Variant.Outlined"
               Disabled="@RoomDisabled"
               AnchorOrigin="Origin.BottomCenter">
        @RoomOptions
    </MudSelect>

    <MudSelect T="Guid?"
               Label="Program section"
               Value="@ProgramSectionId"
               ValueChanged="ProgramSectionIdChanged"
               Variant="Variant.Outlined"
               Disabled="@ProgramSectionDisabled"
               AnchorOrigin="Origin.BottomCenter">
        @ProgramSectionOptions
    </MudSelect>

    <MudNumericField T="int?"
                     Label="Capacity"
                     Value="@Capacity"
                     ValueChanged="CapacityChanged"
                     Variant="Variant.Outlined"
                     Min="1"
                     Placeholder="Optional" />

    <MudSelect T="int?"
               Label="Registration mode"
               Value="@RegistrationModeId"
               ValueChanged="RegistrationModeIdChanged"
               Variant="Variant.Outlined"
               Disabled="@RegistrationModeDisabled"
               AnchorOrigin="Origin.BottomCenter">
        @RegistrationModeOptions
    </MudSelect>
</div>

@code {
    [Parameter] public string FormGridClass { get; set; } = string.Empty;
    [Parameter] public string TimeGridClass { get; set; } = string.Empty;

    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback<string?> TitleChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? TitleFor { get; set; }

    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback<string?> DescriptionChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? DescriptionFor { get; set; }

    [Parameter] public DateTime? SessionDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SessionDateChanged { get; set; }

    [Parameter] public TimeSpan? StartTime { get; set; }
    [Parameter] public EventCallback<TimeSpan?> StartTimeChanged { get; set; }

    [Parameter] public TimeSpan? EndTime { get; set; }
    [Parameter] public EventCallback<TimeSpan?> EndTimeChanged { get; set; }

    [Parameter] public Guid? LocationId { get; set; }
    [Parameter] public EventCallback<Guid?> LocationIdChanged { get; set; }
    [Parameter] public RenderFragment? LocationOptions { get; set; }

    [Parameter] public Guid? RoomId { get; set; }
    [Parameter] public EventCallback<Guid?> RoomIdChanged { get; set; }
    [Parameter] public bool RoomDisabled { get; set; }
    [Parameter] public RenderFragment? RoomOptions { get; set; }

    [Parameter] public Guid? ProgramSectionId { get; set; }
    [Parameter] public EventCallback<Guid?> ProgramSectionIdChanged { get; set; }
    [Parameter] public bool ProgramSectionDisabled { get; set; }
    [Parameter] public RenderFragment? ProgramSectionOptions { get; set; }

    [Parameter] public int? Capacity { get; set; }
    [Parameter] public EventCallback<int?> CapacityChanged { get; set; }

    [Parameter] public int? RegistrationModeId { get; set; }
    [Parameter] public EventCallback<int?> RegistrationModeIdChanged { get; set; }
    [Parameter] public bool RegistrationModeDisabled { get; set; }
    [Parameter] public RenderFragment? RegistrationModeOptions { get; set; }
}
