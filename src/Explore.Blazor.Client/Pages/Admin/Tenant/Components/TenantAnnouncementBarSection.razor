@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Announcement Bar</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Add a dismissible message above the site navigation. Leave it disabled to show no announcement bar.
            @if (HasExistingAnnouncementBar)
            {
                <span>A text-only save keeps previous user dismissals. Use "Save and show to everyone" when the announcement should reappear for users who already closed it.</span>
            }
            else
            {
                <span>Create the announcement when it is ready; users will not see anything while it is disabled or the message is blank.</span>
            }
        </MudText>
    </div>

    <MudStack Spacing="3" Class="settings-form-section mt-4">
        <MudSwitch T="bool?" @bind-Value="Model.AnnouncementBarEnabled" Color="Color.Primary">
            Show announcement bar
        </MudSwitch>

        <MudTextField T="string"
                      @bind-Value="Model.AnnouncementBarMessage"
                      Label="Announcement message"
                      Variant="Variant.Outlined"
                      Lines="3"
                      FullWidth="true"
                      Disabled="Model.AnnouncementBarEnabled != true"
                      HelperText="Required when the announcement bar is enabled." />

        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <MudTextField T="string"
                              @bind-Value="Model.AnnouncementBarLinkText"
                              Label="Optional link text"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="Model.AnnouncementBarEnabled != true" />
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTextField T="string"
                              @bind-Value="Model.AnnouncementBarLinkUrl"
                              Label="Optional link URL"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="Model.AnnouncementBarEnabled != true"
                              HelperText="Use a relative path such as /events or a full https:// URL." />
            </MudItem>
        </MudGrid>

        @if (Model.AnnouncementBarEnabled == true && string.IsNullOrWhiteSpace(Model.AnnouncementBarMessage))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                The bar will stay hidden until a message is provided.
            </MudAlert>
        }

        @if (Model.AnnouncementBarEnabled == true && !string.IsNullOrWhiteSpace(Model.AnnouncementBarMessage))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" NoIcon="true">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@Model.AnnouncementBarMessage</MudText>
                    @if (!string.IsNullOrWhiteSpace(Model.AnnouncementBarLinkText) && !string.IsNullOrWhiteSpace(Model.AnnouncementBarLinkUrl))
                    {
                        <MudLink Href="@Model.AnnouncementBarLinkUrl" Color="Color.Primary">
                            @Model.AnnouncementBarLinkText
                        </MudLink>
                    }
                </MudStack>
            </MudAlert>
        }
    </MudStack>
</div>

@code {
    [Parameter]
    public TenantPolicySettingsDto Model { get; set; } = new();

    [Parameter]
    public bool HasExistingAnnouncementBar { get; set; }
}
