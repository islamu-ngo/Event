<Project Sdk="Microsoft.NET.Sdk">

  <!-- The privacy meter factory is declared once and linked into every suite that builds
       privacy-instrumented services, so no lane invents its own meter root. -->
  <ItemGroup>
    <Compile Include="..\Shared\Telemetry\EventLocationPrivacyMetricsFactory.cs" Link="Telemetry\EventLocationPrivacyMetricsFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
    <ProjectReference Include="..\..\src\ISLAMU.Moderation.Application\ISLAMU.Moderation.Application.csproj" />
    <ProjectReference Include="..\..\src\ISLAMU.Moderation.Domain\ISLAMU.Moderation.Domain.csproj" />
    <ProjectReference Include="..\..\src\Explore.ServiceDefaults\Explore.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
