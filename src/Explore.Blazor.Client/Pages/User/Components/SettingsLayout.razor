@using Explore.Blazor.Client.Contracts.Services.Webhooks
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Components.Webhooks
@using Explore.Blazor.Client.Pages.Admin.Components
@using MudBlazor
@using Microsoft.AspNetCore.Components
@inject IAccessibilityAnnouncerService Announcer

<div class="settings-layout">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <!-- Header -->
        <div class="settings-header mb-8">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 800;">Account Settings</MudText>
                <SettingsScopeSelector Compact="true" />
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Manage your account settings and preferences</MudText>
        </div>

        <div class="settings-layout__body">
            <nav class="settings-sections" aria-label="Personal settings sections">
                <a href="/settings/personal"
                   class="@GetNavItemClass(null)"
                   aria-current="@(CurrentSection is null ? "page" : null)">
                    View all
                </a>
                @foreach (var item in Sections)
                {
                    <a href="@GetSectionHref(item.Key)"
                       class="@GetNavItemClass(item.Key)"
                       aria-current="@(item == CurrentSection ? "page" : null)">
                         @item.Label
                    </a>
                }
            </nav>

            <MudPaper Elevation="0" Class="settings-content pa-6" Style="background-color: transparent;">
                @if (CurrentSection is null)
                {
                    <AppTextField T="string"
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchChangedAsync"
                                  Label="Search settings"
                                  Placeholder="Search personal settings"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="250"
                                  Clearable="true"
                                  FullWidth="true" />

                    @if (FilteredSections.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-6">
                            No settings sections match your search.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var item in FilteredSections)
                        {
                            @RenderSection(item)
                        }
                    }
                }
                else
                {
                    @RenderSection(CurrentSection)
                }
            </MudPaper>
        </div>
    </MudContainer>
</div>

@code {
    private static readonly SettingsSectionDefinition[] Sections =
    [
        new("personal-info", "Personal info", ["profile", "name", "email", "username", "picture"], typeof(SettingsPersonalInfo)),
        new("security", "Security", ["authentication", "sign-in", "providers", "password", "account deletion", "at protocol"], typeof(SettingsSecurity)),
        new("privacy", "Privacy", ["visibility", "data", "analytics", "consent", "marketing"], typeof(SettingsPrivacy)),
        new("notifications", "Notifications", ["email", "push", "mute", "preferences", "alerts"], typeof(SettingsNotifications)),
        new("connected-apps", "Connected apps", ["third-party", "contact sharing", "organizations", "consent", "access"], typeof(SettingsConnectedApps)),
        new("appearance", "Appearance", ["theme", "color", "dark mode", "light mode", "direction", "rtl"], typeof(SettingsAppearance)),
        new("ai-assistant", "AI Assistant", ["assistant", "navbar", "artificial intelligence"], typeof(SettingsAiAssistant)),
        new(
            "api-keys",
            "API keys",
            ["credentials", "tokens", "programmatic", "access keys"],
            typeof(ApiKeysSection),
            new Dictionary<string, object>
            {
                [nameof(ApiKeysSection.OwnerType)] = 1,
                [nameof(ApiKeysSection.Title)] = "API Keys",
                [nameof(ApiKeysSection.Description)] = "Create and manage personal API keys for programmatic access to your account."
            }),
        new(
            "webhooks",
            "Webhooks",
            ["outgoing", "endpoint", "consumer", "delivery", "integration"],
            typeof(WebhookManagementPanel),
            new Dictionary<string, object>
            {
                [nameof(WebhookManagementPanel.Owner)] = WebhookOwnerSelection.User
            })
    ];

    [Parameter]
    public string? Section { get; set; }

    private string _searchTerm = string.Empty;

    private SettingsSectionDefinition? CurrentSection => Sections.FirstOrDefault(item =>
        string.Equals(item.Key, Section, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<SettingsSectionDefinition> FilteredSections
    {
        get
        {
            var term = _searchTerm.Trim();
            if (term.Length == 0)
            {
                return Sections;
            }

            return Sections
                .Where(item => item.Label.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || item.Keywords.Any(keyword => keyword.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .ToArray();
        }
    }

    private static string GetSectionHref(string section) => $"/settings/personal/{section}";

    private string GetNavItemClass(string? section) => string.Equals(section, CurrentSection?.Key, StringComparison.Ordinal)
        ? "settings-sections__link settings-sections__link--active"
        : "settings-sections__link";

    private async Task OnSearchChangedAsync(string value)
    {
        _searchTerm = value ?? string.Empty;
        var count = FilteredSections.Count;
        var message = count switch
        {
            0 => "No settings sections match your search.",
            1 => "1 settings section found.",
            _ => $"{count} settings sections found."
        };

        await Announcer.AnnouncePoliteAsync(message);
    }

    private RenderFragment RenderSection(SettingsSectionDefinition item) => builder =>
    {
        var headingId = $"settings-section-{item.Key}-heading";
        var sequence = 0;
        builder.OpenElement(sequence++, "section");
        builder.AddAttribute(sequence++, "id", $"settings-section-{item.Key}");
        builder.AddAttribute(sequence++, "class", "settings-content__section");
        builder.AddAttribute(sequence++, "data-settings-section", item.Key);
        builder.AddAttribute(sequence++, "aria-labelledby", headingId);
        builder.OpenElement(sequence++, "h2");
        builder.AddAttribute(sequence++, "id", headingId);
        builder.AddAttribute(sequence++, "class", "isl-typo-h5");
        builder.AddContent(sequence++, item.Label);
        builder.CloseElement();
        builder.OpenComponent<DynamicComponent>(sequence++);
        builder.AddAttribute(sequence++, nameof(DynamicComponent.Type), item.ComponentType);
        if (item.Parameters is not null)
        {
            builder.AddAttribute(sequence++, nameof(DynamicComponent.Parameters), item.Parameters);
        }
        builder.CloseComponent();
        builder.CloseElement();
    };

    private sealed record SettingsSectionDefinition(
        string Key,
        string Label,
        string[] Keywords,
        Type ComponentType,
        IDictionary<string, object>? Parameters = null);
}
