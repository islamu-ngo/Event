## =============================================================================
## Event Repository .gitignore
## =============================================================================
## Streamlined, documented ignore rules covering:
##  1. .NET Build & Compiler Outputs
##  2. NuGet Packages & Dependency Management
##  3. Testing, Coverage & Profiling
##  4. IDEs, Editors & Developer Tools
##  5. Cloud, Web, Deployment & Frameworks
##  6. Environment, Secrets & Local Overrides
##  7. Agentic Workbench & AI Tooling Runtime State
##  8. Repository & Workflow Ephemeral Data
##  9. Operating System & Temporary Files
## =============================================================================


# =============================================================================
# 1. .NET Build & Compiler Outputs
# =============================================================================

# Build output directories by configuration
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

# Canonical release contracts and documentation (do NOT ignore these release directories)
!/.ci/release/
!/.ci/release/adapter-contract.md
!/.ci/release/provider-definition.schema.json
!/docs/releases/
!/docs/releases/**
!/docs/internal/releases/
!/docs/internal/releases/**
!/eng/release/
!/eng/release/**

# Architecture-specific output folders
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Intermediate, binary, and log directories
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.binlog
build_output.txt
[Bb]uild[Ll]og.*

# Artifact & publish staging directories
artifacts/
.artifacts/
publish/
Publish/
publish-output

# .NET Core project lock files & scaffolding
project.lock.json
project.fragment.lock.json
ScaffoldingReadMe.txt

# MSBuild and Visual Studio compiler-generated intermediate files
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# ATL project build outputs
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c


# =============================================================================
# 2. NuGet Packages & Dependency Management
# =============================================================================

# NuGet package & symbol packages
*.nupkg
*.snupkg
# Whitelist local test feed package dependencies
!eng/release/dependencies/terminal-gui/feed/*.nupkg
# Verified repository-owned SecretKit runtime bundle
!vendor/secretkit/feed/*.nupkg

# NuGet package restore folder
**/[Pp]ackages/*
# Preserve packages/build which may contain custom MSBuild targets
!**/[Pp]ackages/build/

# NuGet v3 generated props and targets
*.nuget.props
*.nuget.targets

# Paket dependency manager
.paket/paket.exe
paket-files/

# FAKE (F# Make)
.fake/


# =============================================================================
# 3. Testing, Coverage & Profiling
# =============================================================================

# Test execution results
[Tt]est[Rr]esult*/
TestResult.xml
*.VisualState.xml
nunit-*.xml
test-results/

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# Code coverage tools (Coverlet, VS Coverage, DotCover, OpenCover, Stryker)
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.dotCover
OpenCover/
StrykerOutput/

# AxoCover
.axoCover/*
!.axoCover/settings.json

# Continuous testing (NCrunch, Chutzpah, MightyMoose)
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
_Chutzpah*
*.mm.*
AutoTest.Net/

# Profiler & diagnostic trace outputs
*.psess
*.vsp
*.vspx
*.sap
*.e2e

# Microsoft Fakes isolation framework
FakesAssemblies/


# =============================================================================
# 4. IDEs, Editors & Developer Tools
# =============================================================================

# Visual Studio IDE cache, options & auto-generated files
.vs/
/.vs
/.vs/Explore
Generated\ Files/
Generated_Code/
*.[Cc]ache
!?*.[Cc]ache/

# Visual C++ cache & database files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# User-specific solution & project state
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.localhistory/
.vshistory/

# Legacy Visual Studio 6 files
*.plg
*.opt
*.vbw
*.vbp
*.dsw
*.dsp

# Visual Studio project upgrade and migration backups
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak
MigrationBackup/

# Visual Studio LightSwitch build output
**/*.HTMLClient/GeneratedArtifacts
**/*.DesktopClient/GeneratedArtifacts
**/*.DesktopClient/ModelManifest.xml
**/*.Server/GeneratedArtifacts
**/*.Server/ModelManifest.xml
_Pvt_Extensions

# Visual Studio Code (preserves team-shared config files)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains Rider & ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity build add-in
_TeamCity*

# MonoDevelop / Xamarin Studio
*.userprefs
*.usertasks
mono_crash.*

# C# Language Server & CLI tools
csharp-ls.exe
.store

# Productivity extensions, formatters & linters
.cr/personal
*.tss
*.jmconfig
*.nvuser
.mfractor/
.ionide/
FodyWeavers.xsd
*.GhostDoc.xml
StyleCopReport.xml
$tf/
*.gpState
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html


