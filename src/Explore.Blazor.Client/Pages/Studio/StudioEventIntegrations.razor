    private async Task SaveAsync(Func<CancellationToken, Task> action, string message)
    {
        _isSaving = true;
        _validationMessage = null;
        var cancellationToken = _loadCts?.Token ?? default;
        try
        {
            await action(cancellationToken);
            await Announcer.AnnouncePoliteAsync(message);
            await ReloadAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Registration provider mutation failed");
            _validationMessage = "The provider action failed. Refresh and try again.";
            await Announcer.AnnounceAssertiveAsync(_validationMessage);
        }
        finally
        {
            _isSaving = false;
            await Focus.RestoreFocusAsync("[data-testid='studio-event-integrations']");
        }
    }

    private async Task<bool> ValidateAsync(params object?[] values)
    {
        var valid = values.All(value => value switch
        {
            null => false,
            string text => !string.IsNullOrWhiteSpace(text),
            int number => number > 0,
            Guid guid => guid != Guid.Empty,
            _ => true
        });
        _validationMessage = valid ? null : "Complete the required fields before saving.";
        if (!valid)
        {
            await Announcer.AnnounceAssertiveAsync(_validationMessage);
            await Focus.RestoreFocusAsync("[data-testid='integrations-validation']");
        }
        return valid;
    }

    private async Task<bool> ValidateOriginsAsync(string? value)
    {
        var valid = RawLines(value).All(origin => Uri.IsWellFormedUriString(origin, UriKind.Absolute));
        _validationMessage = valid ? null : "Approved origins must be absolute URLs, one per line.";
        if (!valid)
        {
            await Announcer.AnnounceAssertiveAsync(_validationMessage);
            await Focus.RestoreFocusAsync("[data-testid='integrations-validation']");
        }
        return valid;
    }

