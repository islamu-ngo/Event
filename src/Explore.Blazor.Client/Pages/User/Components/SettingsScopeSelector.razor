@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Shell
@inject IUiShellContextService ShellContextService
@inject IShellPreferencesService ShellPreferencesService
@inject NavigationManager Navigation

@if (_scopeLinks.Count > 0 && Compact)
{
    <select class="settings-scope-selector__compact"
            aria-label="Settings scope"
            value="@CurrentScopeHref"
            @onchange="OnScopeChanged">
        <option value="/settings/personal">Personal Settings</option>
        @foreach (var item in _scopeLinks)
        {
            <option value="@item.Href">@item.Label</option>
        }
    </select>
}
else if (_scopeLinks.Count > 0)
{
    <nav class="settings-scope-selector" aria-label="Settings scopes">
        <a href="/settings/personal"
           class="@GetLinkClass("/settings/personal")"
           aria-current="@(IsCurrent("/settings/personal") ? "page" : null)">
            Personal
        </a>
        @foreach (var item in _scopeLinks)
        {
            <a href="@item.Href"
               class="@GetLinkClass(item.Href)"
               aria-current="@(IsCurrent(item.Href) ? "page" : null)">
                @item.Label
            </a>
        }
    </nav>
}

@code {
    private IReadOnlyList<ScopeLink> _scopeLinks = [];

    [Parameter]
    public bool Compact { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var context = await ShellContextService.GetCachedContextAsync();
        var scopes = context?.SettingsScopes ?? [];
        var isSingleTenant = string.IsNullOrWhiteSpace(context?.DeploymentMode)
            || string.Equals(context.DeploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase);
        var hasInstanceScope = scopes.Any(scope => IsScope(scope, "Instance"));
        var preferences = context is null
            ? null
            : await ShellPreferencesService.LoadAsync(context);
        _scopeLinks = scopes
            .Where(scope => !(isSingleTenant && hasInstanceScope && IsScope(scope, "Tenant")))
            .Select(scope => CreateLink(scope, isSingleTenant))
            .Where(link => link is not null)
            .Select(link => link!)
            .OrderBy(link => link.Href == preferences?.LastSettingsScopeHref ? 0 : 1)
            .ToList();
    }

    private static ScopeLink? CreateLink(SettingsScopeDto scope, bool isSingleTenant)
    {
        var kind = scope.Scope?.Trim();
        var href = kind?.ToUpperInvariant() switch
        {
            "ORGANIZATION" when scope.ScopeId.HasValue => $"/settings/organization/{scope.ScopeId}",
            "GROUP" when scope.ScopeId.HasValue => $"/settings/group/{scope.ScopeId}",
            "TENANT" => "/settings/admin",
            "INSTANCE" => "/settings/instance",
            _ => null
        };

        var label = kind?.ToUpperInvariant() switch
        {
            "TENANT" => isSingleTenant ? "Admin Settings" : "Tenant administration",
            "INSTANCE" => isSingleTenant ? "Admin Settings" : "Instance administration",
            _ => scope.DisplayName ?? kind!
        };

        return href is null ? null : new ScopeLink(href, label);
    }

    private bool IsCurrent(string href)
    {
        var path = $"/{Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/')}";
        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || (href == "/settings/personal"
                && path.StartsWith("/settings/personal/", StringComparison.OrdinalIgnoreCase));
    }

    private string GetLinkClass(string href) => IsCurrent(href)
        ? "settings-scope-selector__link settings-scope-selector__link--active"
        : "settings-scope-selector__link";

    private string CurrentScopeHref => _scopeLinks
        .Prepend(new ScopeLink("/settings/personal", "Personal Settings"))
        .FirstOrDefault(link => IsCurrent(link.Href))?.Href
        ?? "/settings/personal";

    private void OnScopeChanged(ChangeEventArgs args)
    {
        var href = args.Value?.ToString();
        if (href is not null
            && _scopeLinks.Prepend(new ScopeLink("/settings/personal", "Personal Settings"))
                .Any(link => string.Equals(link.Href, href, StringComparison.OrdinalIgnoreCase)))
        {
            Navigation.NavigateTo(href);
        }
    }

    private static bool IsScope(SettingsScopeDto scope, string kind) =>
        string.Equals(scope.Scope, kind, StringComparison.OrdinalIgnoreCase);

    private sealed record ScopeLink(string Href, string Label);
}
