#!/bin/sh
# Conventional Commit format and optional high-impact fragment preflight hook.
# Delegates directly to ISLAMU.ReleaseEngineering preflight-commit so policy stays
# single-sourced with ReleasePolicy, ReleaseInputPolicy, and CI preflight-range.
# Install: git config core.hooksPath .githooks
set -eu

# Allow auto-generated Git merge commits to pass through unchanged.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

COMMIT_MSG_FILE="${1:-}"
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  echo "ERROR: commit-msg hook: no commit message file provided." >&2
  exit 1
fi

if git rev-parse -q --verify develop >/dev/null 2>&1; then
  TARGET="develop"
elif git rev-parse -q --verify origin/develop >/dev/null 2>&1; then
  TARGET="origin/develop"
else
  TARGET="HEAD"
fi

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT="$HOOK_DIR/../eng/release/src/ISLAMU.ReleaseEngineering/ISLAMU.ReleaseEngineering.csproj"
exec dotnet run \
  --project "$PROJECT" \
  --configuration Release --no-restore --no-launch-profile -- \
  preflight-commit "$COMMIT_MSG_FILE" --target "$TARGET"
