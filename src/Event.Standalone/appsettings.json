{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "Database": "/app/data/islamu_event.db"
  },
  "Hosting": {
    "ReplicaCount": 1
  },
  "EmailDispatchProcessor": {
    "Mode": "HostedService"
  },
  "HttpsRedirection": {
    "HttpsPort": 7180
  },
  "ForwardedHeadersTrust": {
    "ForwardLimit": 1,
    "TrustLoopbackProxy": true,
    "KnownProxies": [
      "127.0.0.1"
    ],
    "KnownNetworks": [
      "::1/128"
    ]
  },
  "Payments": {
    "Stripe": {
      "Mode": "Test",
      "AllowedCheckoutHosts": [
        "checkout.stripe.com"
      ]
    },
    "OrganizerDirect": {
      "ProviderCode": "",
      "ConnectPlatformId": ""
    },
    "CheckoutGovernance": {
      "ComplaintOwner": "",
      "RefundOwner": "",
      "DisputeOwner": "",
      "ReconciliationOwner": "",
      "ActivationStatus": "suspended",
      "RefundPolicyLanguageTag": "",
      "StatementDescriptor": "",
      "ChargeType": "direct-charge"
    }
  },
  "RateLimiting": {
    "RegistrationPaymentCheckoutIssue": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
