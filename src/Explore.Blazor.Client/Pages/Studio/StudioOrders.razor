@page "/studio/orders"
@using Explore.Blazor.Client.Contracts.Services
@using Explore.Blazor.Client.Services.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject IStudioContextService StudioContextService
@inject IEventService EventService
@inject UiShellState ShellState

<PageTitle>Studio Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="studio-orders">
    <header class="studio-orders__header">
        <MudText Typo="Typo.h4" HtmlTag="h1">Registration orders</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Orders for events managed by the active Studio actor.</MudText>
    </header>

    @if (_isLoading)
    {
        <section class="studio-orders__state" role="status"><MudProgressCircular Indeterminate="true" /> Loading orders…</section>
    }
    else if (!_authorized)
    {
        <section class="studio-orders__state" role="alert" data-testid="studio-orders-unavailable">
            @_error ?? "Registration orders are not available for this actor."
        </section>
    }
    else if (_eventIds.Count == 0)
    {
        <section class="studio-orders__state" data-testid="studio-orders-no-events">No managed events are available.</section>
    }
    else
    {
        @foreach (var eventId in _eventIds)
        {
            <section class="studio-orders__event" aria-labelledby="@($"orders-{eventId:N}")">
                <MudText Id="@($"orders-{eventId:N}")" Typo="Typo.h5" HtmlTag="h2">Event orders</MudText>
                @if (_refundCampaignEventIds.Contains(eventId))
                {
                    <StudioRefundCampaigns EventId="eventId" />
                }
                <StudioOrderList EventId="eventId" />
            </section>
        }
    }
</MudContainer>

@code {
    private readonly List<Guid> _eventIds = [];
    private readonly HashSet<Guid> _refundCampaignEventIds = [];
    private bool _authorized;
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var actorId = ShellState.ActiveActorId;
            var context = await StudioContextService.GetContextAsync(actorId);
            _authorized = context?._links?.ContainsKey("view-registration-orders") == true;
            if (!_authorized)
            {
                return;
            }

            var events = actorId is Guid managedActorId
                ? await EventService.GetManagedEventsByActorAsync(managedActorId)
                : await EventService.GetMyEventsPagedAsync(1, 100);
            _eventIds.AddRange(events.Items
                .Where(item => item.Id.HasValue && item.HasHalLink("view-registration-orders"))
                .Select(item => item.Id!.Value));
            _refundCampaignEventIds.UnionWith(events.Items
                .Where(item => item.Id.HasValue && item.HasHalLink("refund-campaigns"))
                .Select(item => item.Id!.Value));
        }
        catch (Exception)
        {
            _authorized = false;
            _error = "Registration orders are currently unavailable.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
