@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Pages.Events.Components

<div class="event-series-rail mb-12 pa-6 rounded-xl" style="background: rgba(var(--mud-palette-primary-rgb), 0.03); border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.1);">
    <div class="d-flex align-end justify-space-between mb-6 px-2">
        <div>
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight: 900; letter-spacing: 2px;">FEATURED SERIES</MudText>
            </div>
            <MudText Typo="Typo.h4" Class="font-weight-black">@SeriesTitle</MudText>
            @if (!string.IsNullOrEmpty(SeriesDescription))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" Style="max-width: 600px;">@SeriesDescription</MudText>
            }
        </div>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Class="font-weight-bold">
            VIEW FULL SERIES
        </MudButton>
    </div>

    <div class="d-flex gap-4 overflow-x-auto pb-4 hide-scrollbar px-2">
        @foreach (var evt in Events)
        {
            <div class="event-rail__item">
                <EventCard Event="evt" Layout="LayoutMode.CompactGrid" />
            </div>
        }
    </div>
</div>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .event-rail__item { flex: 0 0 280px; max-width: 280px; }
    @@media (max-width: 600px) { .event-rail__item { flex: 0 0 240px; max-width: 240px; } }
</style>

@code {
    [Parameter] public string SeriesTitle { get; set; } = default!;
    [Parameter] public string? SeriesDescription { get; set; }
    [Parameter] public IEnumerable<EventListDto> Events { get; set; } = Enumerable.Empty<EventListDto>();
}
