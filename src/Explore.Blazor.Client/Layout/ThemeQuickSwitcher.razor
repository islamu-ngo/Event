@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Shell
@using MudBlazor
@inject IAppearanceThemeService AppearanceThemeService
@inject UiShellState UiShellState

<MudMenu @bind-Open="_isOpen"
         AnchorOrigin="Origin.BottomCenter"
         TransformOrigin="Origin.TopCenter"
         Dense="true"
         Class="theme-quick-switcher">
    <ActivatorContent>
        <MudIconButton Icon="@CurrentIcon"
                       Color="Color.Inherit"
                       Size="Size.Medium"
                       OnClick="ToggleMenu"
                       Title="@GetAriaLabel()"
                       Class="navbar__theme-toggle"
                       @attributes="AdditionalAttributes" />
    </ActivatorContent>
    <ChildContent>
        @if (_presets.Count > 0)
        {
            <div class="theme-quick-switcher__header">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Theme</MudText>
            </div>
            @foreach (var preset in _presets)
            {
                var p = preset;
                var isActive = _currentPresetKey == p.ThemeKey;
                var swatch = p.LightPalette?.Primary ?? "#3B82F6";
                <MudMenuItem OnClick="@(() => SelectPresetAsync(p))"
                             Class="@(isActive ? "theme-quick-switcher__item theme-quick-switcher__item--active" : "theme-quick-switcher__item")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <span class="theme-quick-switcher__swatch" style="background:@swatch;" />
                        <MudText Typo="Typo.body2">@p.DisplayName</MudText>
                        @if (isActive)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ml-auto" />
                        }
                    </MudStack>
                </MudMenuItem>
            }
            <MudDivider />
        }
        <div class="theme-quick-switcher__header">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Mode</MudText>
        </div>
        @foreach (var mode in _modes)
        {
            var m = mode;
            <MudMenuItem OnClick="@(() => SelectModeAsync(m.Value))"
                         Class="@(m.Value == _currentMode ? "theme-quick-switcher__item theme-quick-switcher__item--active" : "theme-quick-switcher__item")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@m.Icon" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@m.Label</MudText>
                    @if (m.Value == _currentMode)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ml-auto" />
                    }
                </MudStack>
            </MudMenuItem>
        }
        <MudDivider />
        <MudMenuItem Href="/settings/personal/appearance?custom=true"
                     OnClick="NavigateToAppearanceSettings"
                     Class="theme-quick-switcher__item">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
                <MudText Typo="Typo.body2">Custom Theme</MudText>
            </MudStack>
        </MudMenuItem>
        <MudMenuItem Href="/settings/personal/appearance"
                     OnClick="NavigateToSettings"
                     Class="theme-quick-switcher__item">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />
                <MudText Typo="Typo.body2">Full settings</MudText>
            </MudStack>
        </MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private string _currentMode = "system";
    private string? _currentPresetKey;
    private IReadOnlyList<AvailablePresetDto> _presets = Array.Empty<AvailablePresetDto>();

    private sealed record ModeOption(string Value, string Label, string Icon);

    private static readonly ModeOption[] _modes =
    [
        new("system", "System", Icons.Material.Rounded.AutoMode),
        new("light", "Light", Icons.Material.Rounded.LightMode),
        new("dark", "Dark", Icons.Material.Rounded.DarkMode),
        new("lighthighcontrast", "Light HC", Icons.Material.Rounded.Visibility),
        new("darkhighcontrast", "Dark HC", Icons.Material.Rounded.NightsStay)
    ];

    private string CurrentIcon => _currentMode switch
    {
        "dark" or "darkhighcontrast" => Icons.Material.Rounded.DarkMode,
        "light" or "lighthighcontrast" => Icons.Material.Rounded.LightMode,
        _ => Icons.Material.Rounded.AutoMode
    };

    protected override void OnInitialized()
    {
        _currentMode = AppearanceThemeService.Current.ThemeMode ?? "system";
        _currentPresetKey = AppearanceThemeService.Current.ResolvedAppearance?.SourcePresetKey;
        _presets = AppearanceThemeService.Current.AvailablePresets;
        AppearanceThemeService.Changed += OnAppearanceChanged;
    }

    private void OnAppearanceChanged(object? sender, AppearanceStateChangedEventArgs e)
    {
        _currentMode = e.State.ThemeMode ?? "system";
        _currentPresetKey = e.State.ResolvedAppearance?.SourcePresetKey;
        _presets = e.State.AvailablePresets;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _isOpen = !_isOpen;

    private async Task SelectPresetAsync(AvailablePresetDto preset)
    {
        _currentPresetKey = preset.ThemeKey;
        _isOpen = false;

        var existingProfile = AppearanceThemeService.Current.UserProfiles
            .FirstOrDefault(p => p.SourcePresetId == preset.Id && p.IsArchived != true);

        if (existingProfile is not null)
        {
            await AppearanceThemeService.SetActiveProfileAsync(existingProfile.Id ?? Guid.Empty);
        }
        else
        {
            await AppearanceThemeService.ClonePresetAndActivateAsync(preset.Id ?? Guid.Empty);
        }
    }

    private async Task SelectModeAsync(string mode)
    {
        if (mode == _currentMode) return;
        _currentMode = mode;
        _isOpen = false;
        await AppearanceThemeService.SetThemeModeAsync(mode);
    }

    private void NavigateToAppearanceSettings(MouseEventArgs args)
    {
        _isOpen = false;
        UiShellState.NavigateToPersonalSettings("/settings/personal/appearance?custom=true", args);
    }

    private void NavigateToSettings(MouseEventArgs args)
    {
        _isOpen = false;
        UiShellState.NavigateToPersonalSettings("/settings/personal/appearance", args);
    }

    private string GetAriaLabel() => _currentMode switch
    {
        "dark" => "Theme: Dark. Click to change.",
        "light" => "Theme: Light. Click to change.",
        "lighthighcontrast" => "Theme: Light High Contrast. Click to change.",
        "darkhighcontrast" => "Theme: Dark High Contrast. Click to change.",
        "custom" => "Theme: Custom. Click to change.",
        _ => "Theme: System. Click to change."
    };

    public void Dispose()
    {
        AppearanceThemeService.Changed -= OnAppearanceChanged;
        GC.SuppressFinalize(this);
    }
}
