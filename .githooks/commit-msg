#!/bin/sh
# Conventional Commit format enforcement hook.
# Validates commit messages against the project's release policy and scope registry.
# Install: git config core.hooksPath .githooks
#
# This hook runs locally on every `git commit`. It does NOT run for external
# contributors who fork the repo — CI PR lint and maintainer squash-merge
# handle those cases. See docs/internal/GOVERNANCE.md.

# Allow merge commits (auto-generated by git) to pass through unchanged.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

COMMIT_MSG_FILE="$1"
if [ ! -f "$COMMIT_MSG_FILE" ]; then
  echo "ERROR: commit-msg hook: no commit message file provided." >&2
  exit 1
fi

# Read the first non-comment, non-empty line as the subject.
SUBJECT=$(sed '/^#/d; /^$/d; q' "$COMMIT_MSG_FILE")

if [ -z "$SUBJECT" ]; then
  echo "ERROR: Empty commit message." >&2
  exit 1
fi

# ── Format validation ──────────────────────────────────────────────────────
# Required: type(scope): description
# Optional: type(scope)!: description  (breaking change)
if ! echo "$SUBJECT" | grep -qE '^(feat|fix|perf|revert|docs|test|refactor|style|build|ci|chore)(\([a-z][a-z0-9-]*\))!?: .+$'; then
  cat >&2 <<'EOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMMIT REJECTED — Invalid Conventional Commit format           ║
  ╠══════════════════════════════════════════════════════════════════╣
  ║                                                                 ║
  ║  Required format:                                               ║
  ║    type(scope): imperative benefit-led subject                  ║
  ║                                                                 ║
  ║  Types:  feat fix perf revert docs                              ║
  ║          test refactor style build ci chore                     ║
  ║                                                                 ║
  ║  Scopes (public):                                               ║
  ║    events registration ticketing discovery notifications        ║
  ║    privacy access storage onboarding federation webhooks        ║
  ║    localization accessibility self-hosting                      ║
  ║                                                                 ║
  ║  Scopes (engineering):                                          ║
  ║    ci dependencies architecture database observability          ║
  ║    documentation release testing build                          ║
  ║                                                                 ║
  ║  Layer scopes are FORBIDDEN:                                    ║
  ║    api domain persistence blazor client dto                     ║
  ║                                                                 ║
  ║  Examples:                                                      ║
  ║    feat(registration): present disclaimer on paid events        ║
  ║    fix(database): wrap projection in execution strategy         ║
  ║    refactor(architecture): rename actor merge target column     ║
  ║                                                                 ║
  ╚══════════════════════════════════════════════════════════════════╝

EOF
  exit 1
fi

# ── Scope validation ───────────────────────────────────────────────────────
# Extract scope from the subject line.
SCOPE=$(echo "$SUBJECT" | sed -n 's/^[a-z]*(\([a-z][a-z0-9-]*\))!*: .*$/\1/p')

ALLOWED_SCOPES="events registration ticketing discovery notifications privacy access storage onboarding federation webhooks localization accessibility self-hosting ci dependencies architecture database observability documentation release testing build"

SCOPE_VALID=0
for allowed in $ALLOWED_SCOPES; do
  if [ "$SCOPE" = "$allowed" ]; then
    SCOPE_VALID=1
    break
  fi
done

if [ "$SCOPE_VALID" -eq 0 ]; then
  cat >&2 <<EOF

  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMMIT REJECTED — Unknown scope: "$SCOPE"
  ╠══════════════════════════════════════════════════════════════════╣
  ║                                                                 ║
  ║  Allowed public scopes:                                         ║
  ║    events registration ticketing discovery notifications        ║
  ║    privacy access storage onboarding federation webhooks        ║
  ║    localization accessibility self-hosting                      ║
  ║                                                                 ║
  ║  Allowed engineering scopes:                                    ║
  ║    ci dependencies architecture database observability          ║
  ║    documentation release testing build                          ║
  ║                                                                 ║
  ║  Layer scopes (api, domain, persistence, blazor, client, dto)   ║
  ║  are FORBIDDEN. Use a capability or engineering scope instead.  ║
  ║                                                                 ║
  ╚══════════════════════════════════════════════════════════════════╝

EOF
  exit 1
fi

# ── Changelog trailer validation for internal types ────────────────────────
# Internal types (test, refactor, style, build, ci, chore) MUST include
# both "Changelog: skip" and "Changelog-Reason: <reason>" trailers.
TYPE=$(echo "$SUBJECT" | sed -n 's/^\([a-z]*\)(.*$/\1/p')

INTERNAL_TYPES="test refactor style build ci chore"
IS_INTERNAL=0
for internal in $INTERNAL_TYPES; do
  if [ "$TYPE" = "$internal" ]; then
    IS_INTERNAL=1
    break
  fi
done

if [ "$IS_INTERNAL" -eq 1 ]; then
  FULL_MSG=$(cat "$COMMIT_MSG_FILE")

  HAS_SKIP=$(echo "$FULL_MSG" | grep -c '^Changelog: skip$' || true)
  HAS_REASON=$(echo "$FULL_MSG" | grep -c '^Changelog-Reason: .\+$' || true)

  if [ "$HAS_SKIP" -eq 0 ] || [ "$HAS_REASON" -eq 0 ]; then
    cat >&2 <<'EOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMMIT REJECTED — Missing changelog skip trailers              ║
  ╠══════════════════════════════════════════════════════════════════╣
  ║                                                                 ║
  ║  Internal types (test, refactor, style, build, ci, chore)       ║
  ║  MUST include both terminal trailers:                           ║
  ║                                                                 ║
  ║    Changelog: skip                                              ║
  ║    Changelog-Reason: concise reason for exclusion               ║
  ║                                                                 ║
  ║  This prevents internal plumbing from leaking into the          ║
  ║  public release changelog.                                      ║
  ║                                                                 ║
  ╚══════════════════════════════════════════════════════════════════╝

EOF
    exit 1
  fi
fi

# ── Breaking change footer validation ──────────────────────────────────────
# If the subject contains `!` (breaking signal), the body MUST include a
# `BREAKING CHANGE: <description>` footer (Rule 6 from conventional-commit).
if echo "$SUBJECT" | grep -qE '^[a-z]+(\([a-z][a-z0-9-]*\))?!:'; then
  FULL_MSG=${FULL_MSG:-$(cat "$COMMIT_MSG_FILE")}

  if ! echo "$FULL_MSG" | grep -q '^BREAKING CHANGE: .\+$'; then
    cat >&2 <<'EOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║  COMMIT REJECTED — Missing BREAKING CHANGE footer               ║
  ╠══════════════════════════════════════════════════════════════════╣
  ║                                                                 ║
  ║  Commits with `!` in the subject (e.g. feat(events)!: ...)      ║
  ║  MUST include a BREAKING CHANGE footer in the body:             ║
  ║                                                                 ║
  ║    BREAKING CHANGE: describe what breaks and migration path     ║
  ║                                                                 ║
  ╚══════════════════════════════════════════════════════════════════╝

EOF
    exit 1
  fi
fi

exit 0
