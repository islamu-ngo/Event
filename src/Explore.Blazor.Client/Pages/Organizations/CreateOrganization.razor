@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Forms
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Create Organization</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudCard Elevation="0" Class="rounded-xl border-solid border-1 mud-border-lines-default overflow-hidden">
        <div class="pa-6 border-b-1 mud-border-lines-default bg-surface">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="4">
                <MudAvatar Rounded="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 800;">Create Organization</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        Fill in the details to register your organization.
                    </MudText>
                </div>
            </MudStack>
        </div>

        <div class="pa-6">
            @if (submitSuccess)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-6 rounded-lg">
                    Organization successfully submitted for review! Redirecting...
                </MudAlert>
            }

            <EditForm EditContext="_editContext" OnValidSubmit="@HandleSubmit">
                <FormSubmissionGuard State="@_submitState">
                <AppValidationSummary />

            <MudStepper OnPreviewInteraction="OnPreviewStepInteraction">
                <MudStep Title="Basic Info" Icon="@Icons.Material.Filled.Info">
                    <div class="py-6">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="4" Class="d-flex flex-column align-center">
                                <MudText Typo="Typo.subtitle1" Class="mb-4" Style="font-weight: 700;">Logo</MudText>
                                <ImageUpload @ref="_imageUpload"
                                             PreviewUrl="@logoPreview"
                                             PreviewUrlChanged="OnLogoPreviewUrlChanged"
                                             FileDataSelected="OnLogoFileDataSelected"
                                             IsProcessing="_isUploadingLogo"
                                             Width="180px"
                                             Height="180px"
                                             PlaceholderText="Select Logo"
                                             Icon="@Icons.Material.Filled.Business" />
                                @if (_isUploadingLogo)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Class="mt-4">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                        <MudText Typo="Typo.caption">Uploading...</MudText>
                                    </MudStack>
                                }
                                @if (_logoUploadError != null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@_logoUploadError</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudStack Spacing="4">
                                    <MudTextField T="string" @bind-Value="organization.FullName"
                                                  Label="Organization Name"
                                                  Variant="Variant.Outlined"
                                                  Required
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Business" />

                                    <MudTextField T="string" @bind-Value="organization.WebsiteUrl"
                                                  Label="Website URL (Optional)"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Language" />

                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Organization Page Appearance (Optional)</MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="4">
                                            <MudTextField T="string" @bind-Value="_appearance.BackgroundColor"
                                                          Label="Background Color"
                                                          Variant="Variant.Outlined"
                                                          InputType="InputType.Color" />
                                        </MudItem>
                                        <MudItem xs="12" sm="8">
                                            <MudTextField T="string" @bind-Value="_appearance.ImageUri"
                                                          Label="Banner Picture URL"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="https://... (image or GIF)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string"
                                                       Label="Background Effect"
                                                       Variant="Variant.Outlined"
                                                       @bind-Value="_appearance.BackgroundEffect">
                                                <MudSelectItem Value="@("None")">None</MudSelectItem>
                                                <MudSelectItem Value="@("SoftOverlay")">Soft Overlay</MudSelectItem>
                                                <MudSelectItem Value="@("StrongOverlay")">Strong Overlay</MudSelectItem>
                                                <MudSelectItem Value="@("Blur")">Blur</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudStep>

                <MudStep Title="Contact & Address" Icon="@Icons.Material.Filled.LocationOn">
                    <div class="py-6">
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="organization.Email"
                                              Label="Contact Email"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Email"
                                              Required
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="organization.Address"
                                              Label="Street Address"
                                              Variant="Variant.Outlined"
                                              Required
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Home" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudNumericField @bind-Value="organization.Postcode"
                                                 Label="Postal Code"
                                                 Variant="Variant.Outlined"
                                                 Required
                                                 HideSpinButtons="true"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.Pin" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="organization.City"
                                              Label="City"
                                              Variant="Variant.Outlined"
                                              Required
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="organization.Country"
                                           Label="Country"
                                           Variant="Variant.Outlined"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Required>
                                    <MudSelectItem Value="@("Netherlands")">Netherlands</MudSelectItem>
                                    <MudSelectItem Value="@("Belgium")">Belgium</MudSelectItem>
                                    <MudSelectItem Value="@("Germany")">Germany</MudSelectItem>
                                    <MudSelectItem Value="@("France")">France</MudSelectItem>
                                    <MudSelectItem Value="@("United Kingdom")">United Kingdom</MudSelectItem>
                                    <MudSelectItem Value="@("Spain")">Spain</MudSelectItem>
                                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudStep>

                <MudStep Title="Review & Submit" Icon="@Icons.Material.Filled.DoneAll">
                    <div class="py-6">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-4">Information Summary</MudText>
                                <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                    <MudStack Spacing="2">
                                        <div class="d-flex justify-space-between">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Name:</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@organization.FullName</MudText>
                                        </div>
                                        <div class="d-flex justify-space-between">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Email:</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@organization.Email</MudText>
                                        </div>
                                        <div class="d-flex justify-space-between">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Website:</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@(string.IsNullOrWhiteSpace(organization.WebsiteUrl) ? "N/A" : organization.WebsiteUrl)</MudText>
                                        </div>
                                        <MudDivider Class="my-2" />
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Address:</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@organization.Address</MudText>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@organization.Postcode @organization.City, @organization.Country</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-4">Confirm Details</MudText>
                                <MudStack Spacing="2">
                                    <MudCheckBox @bind-Value="acceptTerms"
                                                 Color="Color.Primary"
                                                 Label="I agree to the Terms and Conditions" />

                                    <MudCheckBox @bind-Value="confirmInformation"
                                                 Color="Color.Primary"
                                                 Label="I confirm that all information is accurate" />
                                </MudStack>

                                <MudAlert Severity="Severity.Info" Class="mt-6 rounded-lg">
                                    <MudText Typo="Typo.body2">
                                        Your request will be reviewed by an administrator. This usually takes 1-3 business days.
                                    </MudText>
                                </MudAlert>
                            </MudItem>
                        </MudGrid>

                        <div class="d-flex justify-end mt-8">
                            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="@(!CanSubmit() || _submitState.IsSubmitting)"
                                       Class="rounded-pill px-8">
                                @if (_submitState.IsSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <span>Submit for Review</span>
                                }
                            </MudButton>
                        </div>
                    </div>
                </MudStep>
            </MudStepper>
                </FormSubmissionGuard>
            </EditForm>
        </div>
    </MudCard>
</MudContainer>
