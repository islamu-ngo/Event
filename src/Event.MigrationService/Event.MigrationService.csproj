<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>event-shared-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite.csproj" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.MySql\Explore.Persistence.DataProtection.Migrations.MySql.csproj" />
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.Sqlite\Explore.Persistence.DataProtection.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.SqlServer\Explore.Persistence.DataProtection.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.MySql\Explore.Persistence.Migrations.MySql.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.Sqlite\Explore.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.SqlServer\Explore.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Explore.Infrastructure\Explore.Infrastructure.csproj" />
    <ProjectReference Include="..\Explore.Persistence\Explore.Persistence.csproj" />
    <ProjectReference Include="..\Explore.ServiceDefaults\Explore.ServiceDefaults.csproj" />
  </ItemGroup>
  <Target Name="DeclareAssuranceOwningBuild" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_AssuranceSourceRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'Directory.Packages.props'))</_AssuranceSourceRoot>
      <_AssuranceProjectPath>$([MSBuild]::MakeRelative('$(_AssuranceSourceRoot)', '$(MSBuildProjectFullPath)').Replace('\', '/'))</_AssuranceProjectPath>
      <_AssuranceTargetPath>$([MSBuild]::MakeRelative('$(_AssuranceSourceRoot)', '$(TargetPath)').Replace('\', '/'))</_AssuranceTargetPath>
    </PropertyGroup>
    <Error Condition="'$(_AssuranceSourceRoot)' == '' Or '$(_AssuranceProjectPath)' == '' Or '$(_AssuranceTargetPath)' == '' Or '$(TargetName)' == ''"
           Text="The owning build must resolve its repository-relative project and target." />
    <Error Condition="$([System.IO.Path]::IsPathRooted('$(_AssuranceProjectPath)')) Or $([System.IO.Path]::IsPathRooted('$(_AssuranceTargetPath)')) Or $(_AssuranceProjectPath.StartsWith('../')) Or $(_AssuranceTargetPath.StartsWith('../'))"
           Text="The owning build must remain inside its discovered source root." />
    <ItemGroup>
      <AssemblyMetadata Include="ISLAMU.Assurance.ProjectPath" Value="$(_AssuranceProjectPath)" />
      <AssemblyMetadata Include="ISLAMU.Assurance.TargetPath" Value="$(_AssuranceTargetPath)" />
      <AssemblyMetadata Include="ISLAMU.Assurance.TargetName" Value="$(TargetName)" />
    </ItemGroup>
  </Target>

</Project>
