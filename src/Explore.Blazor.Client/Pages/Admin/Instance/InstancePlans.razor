@page "/admin/instance/plans"
@using System.Globalization
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.ControlPlane
@using Explore.Blazor.Client.Routing.ControlPlane
@using Explore.Blazor.Client.Contracts.Services.ControlPlane
@using Explore.Blazor.Client.Components.ControlPlane
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IControlPlanePlanCatalogService PlanCatalog
@inject IAccessibilityFocusService FocusService
@inject IAccessibilityAnnouncerService Announcer

<PageTitle>Tenant Plans</PageTitle>

<main class="instance-plans">
    <header class="instance-plans__header">
        <div>
            <p class="instance-plans__eyebrow" dir="auto">Instance console</p>
            <h1 dir="auto">Plans</h1>
            <p class="instance-plans__description" dir="auto">Review the tenant plans and current versions available for provisioning.</p>
        </div>
        <div class="instance-plans__header-actions">
            @if (CanCreatePlan)
            {
                <AppButton id="plans-create"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@IsBusy"
                           OnClick="StartCreateAsync">
                    Create plan
                </AppButton>
            }
            <AppButton Variant="Variant.Outlined" Href="@ControlPlaneRoutes.Overview" aria-label="Back to instance overview" dir="auto">
                Back to overview
            </AppButton>
        </div>
    </header>

    @if (_loading)
    {
        <div class="instance-plans__state" role="status" aria-live="polite">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <span dir="auto">Loading plans</span>
        </div>
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Error" role="alert" aria-live="assertive">
            <span dir="auto">Tenant plans are currently unavailable.</span>
        </MudAlert>
    }
    else
    {
        @if (_draft is not null)
        {
            <section class="instance-plans__editor" aria-labelledby="create-plan-heading">
                <h2 id="create-plan-heading">Create plan draft</h2>
                <ControlPlanePlanDraftEditor @key="_draft"
                                             Draft="_draft"
                                             Busy="@IsBusy"
                                             CanValidate="@CanValidateDraft"
                                             SubmitLabel="Create draft"
                                             ValidationErrors="_validationErrors"
                                             OnValidate="ValidateDraftAsync"
                                             OnSubmit="CreateDraftAsync"
                                             OnCancel="CancelCreateAsync" />
            </section>
        }

        @if (_plans.Count == 0)
        {
            <MudAlert Severity="Severity.Info"><span dir="auto">No tenant plans are available.</span></MudAlert>
        }
        else
        {
            <section class="instance-plans__catalog" aria-labelledby="plan-catalog-heading">
            <div class="instance-plans__section-heading">
                <h2 id="plan-catalog-heading" dir="auto">Plan catalog</h2>
                <span dir="ltr">@PlanCountLabel</span>
            </div>

            <div class="instance-plans__list" role="list">
                @foreach (var plan in _plans)
                {
                    <article class="instance-plans__item" role="listitem" data-plan-key="@plan.Key" @key="plan.Id">
                        <div class="instance-plans__item-main">
                            <div class="instance-plans__title-row">
                                <h3 dir="auto">@plan.DisplayName</h3>
                                <span class="instance-plans__status instance-plans__status--@(plan.IsActiveForProvisioning == true ? "active" : "inactive")" dir="auto">
                                    @(plan.IsActiveForProvisioning == true ? "Provisioning enabled" : "Provisioning disabled")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <p class="instance-plans__item-description" data-plan-description dir="auto">@plan.Description</p>
                            }

                            <dl class="instance-plans__facts">
                                <div>
                                    <dt dir="auto">Key</dt>
                                    <dd><code dir="ltr">@plan.Key</code></dd>
                                </div>
                                <div>
                                    <dt dir="auto">Pricing</dt>
                                    <dd dir="ltr">@FormatPricing(plan)</dd>
                                </div>
                                <div>
                                    <dt dir="auto">Latest version</dt>
                                    <dd dir="ltr">v@plan.LatestVersionNumber</dd>
                                </div>
                                <div>
                                    <dt dir="auto">Current version</dt>
                                    <dd dir="ltr">@(plan.PublishedVersionNumber is { } version ? $"v{version}" : "None")</dd>
                                </div>
                            </dl>
                        </div>

                        @if (ControlPlaneHal.HasLink(plan._links, ControlPlaneLinkRelations.Self))
                        {
                            <AppButton Variant="Variant.Outlined"
                                       Href="@PlanHref(plan.Key)"
                                       aria-label="@($"View plan {plan.DisplayName}")"
                                       dir="auto">
                                View details
                            </AppButton>
                        }
                    </article>
                }
            </div>
            </section>
        }
    }

    @if (_commandMessage is not null)
    {
        <MudAlert Severity="@(_commandSucceeded ? Severity.Success : Severity.Error)"
                  role="@(_commandSucceeded ? "status" : "alert")"
                  aria-live="@(_commandSucceeded ? "polite" : "assertive")">
            <span dir="auto">@_commandMessage</span>
        </MudAlert>
    }
</main>

@code {
    private HalCollectionResourceOfControlPlaneTenantPlanListItemDto? _catalog;
    private IReadOnlyList<HalResourceOfControlPlaneTenantPlanListItemDto> _plans = [];
    private TenantPlanDraft? _draft;
    private IReadOnlyList<TenantPlanValidationError> _validationErrors = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private bool _focusEditor;
    private string? _commandMessage;
    private bool _commandSucceeded;

    private string PlanCountLabel => _plans.Count == 1 ? "1 plan" : $"{_plans.Count} plans";
    private bool IsBusy => _busy;
    private bool CanCreatePlan => ControlPlaneHal.HasLink(_catalog?._links, ControlPlaneLinkRelations.Create);
    private bool CanValidateDraft => ControlPlaneHal.HasLink(_catalog?._links, ControlPlaneLinkRelations.Validate);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPlansAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditor)
        {
            return;
        }

        _focusEditor = false;
        await FocusService.FocusAsync(".control-plane-plan-editor input");
    }

    private async Task LoadPlansAsync()
    {
        _catalog = await PlanCatalog.GetPlansAsync();
        _plans = _catalog._embedded?.Items?.ToArray() ?? [];
    }

    private async Task StartCreateAsync()
    {
        await FocusService.SaveFocusAsync();
        _draft = NewDraft();
        _validationErrors = [];
        ClearCommandMessage();
        _focusEditor = true;
    }

    private async Task CancelCreateAsync()
    {
        _draft = null;
        _validationErrors = [];
        ClearCommandMessage();
        await FocusService.RestoreFocusAsync("#plans-create");
    }

    private async Task ValidateDraftAsync(TenantPlanDraft draft)
    {
        await RunDraftActionAsync(async () =>
        {
            TenantPlanValidationResult result = await PlanCatalog.ValidateDraftAsync(draft);
            _validationErrors = result.Errors.ToArray();
            _commandSucceeded = result.IsValid == true;
            _commandMessage = result.IsValid == true ? "Draft is valid." : "Draft validation found issues.";
            return false;
        });
    }

    private async Task CreateDraftAsync(TenantPlanDraft draft)
    {
        await RunDraftActionAsync(async () =>
        {
            BaseCommandResponseOfGuid result = await PlanCatalog.CreatePlanDraftAsync(draft);
            _commandSucceeded = result.Success == true;
            _commandMessage = result.Message ?? (result.Success == true ? "Plan draft created." : "Plan draft could not be created.");
            if (result.Success != true)
            {
                return false;
            }

            _draft = null;
            _validationErrors = [];
            await LoadPlansAsync();
            await FocusService.RestoreFocusAsync("#plans-create");
            return true;
        });
    }

    private async Task RunDraftActionAsync(Func<Task<bool>> action)
    {
        _busy = true;
        ClearCommandMessage();
        try
        {
            bool succeeded = await action();
            string message = _commandMessage ?? (succeeded ? "Plan action completed." : "Plan action could not be completed.");
            if (_commandSucceeded)
            {
                await Announcer.AnnouncePoliteAsync(message);
            }
            else
            {
                await Announcer.AnnounceAssertiveAsync(message);
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            _commandSucceeded = false;
            _commandMessage = "The plan action could not be completed.";
            await Announcer.AnnounceAssertiveAsync(_commandMessage);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearCommandMessage()
    {
        _commandMessage = null;
        _commandSucceeded = false;
    }

    private static TenantPlanDraft NewDraft() => new()
    {
        Pricing = new TenantPlanPricing
        {
            CurrencyCode = "EUR",
            BillingPeriod = "monthly"
        },
        IsActiveForProvisioning = true
    };

    private static string FormatPricing(HalResourceOfControlPlaneTenantPlanListItemDto plan) =>
        $"{(plan.PriceAmount ?? 0).ToString("0.##", CultureInfo.InvariantCulture)} {plan.CurrencyCode} / {plan.BillingPeriod}";

    private static string PlanHref(string key) => $"{ControlPlaneRoutes.Plans}/{Uri.EscapeDataString(key)}";
}
