@* ABOUTME: Login provider selection page that queries BFF for enabled auth providers. *@
@* ABOUTME: Supports Local sign-in, Keycloak/Google button flows, and AT Protocol handle-input challenges. *@

@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using Explore.Blazor.Client.Models.Requests
@using MudBlazor
@inject NavigationManager Navigation
@inject IBffAuthApi BffAuthApi
@inject Explore.Blazor.Client.Services.Http.IBffClient BffClient
@inject ILogger<LoginRedirect> Logger
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Sign in</PageTitle>

<div class="login-page">
<MudContainer MaxWidth="MaxWidth.Small" Class="login-page__container py-8">
    <MudPaper Class="login-page__card pa-6">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="login-page__title mb-2">
            Sign in
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="login-page__subtitle mb-4">
            @LoginSubtitle
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_challengeErrorMessage))
        {
            <div role="alert">
                <MudAlert Severity="Severity.Warning" Class="mb-4">@_challengeErrorMessage</MudAlert>
            </div>
        }

        @if (_isLoading || _isAutoRedirecting)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.h6">@(_isAutoRedirecting ? "Redirecting to sign-in..." : "Loading providers...")</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div role="alert">
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            </div>
            <MudButton Elevation="0" Variant="Variant.Outlined" Color="Color.Default" OnClick="LoadProvidersAsync">
                Retry
            </MudButton>
        }
        else
        {
            <MudStack Spacing="3" Class="login-page__providers">
                @foreach (var provider in _providers)
                {
                    <div class="login-page__provider" @key="provider.Name">
                        @if (_providers.Count > 1)
                        {
                            <div class="login-page__provider-header">
                                <MudText Typo="Typo.subtitle2">@GetProviderDisplayName(provider)</MudText>
                                @if (provider.Recommended)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Outlined"
                                             Class="login-page__recommended-chip">
                                        Recommended
                                    </MudChip>
                                }
                            </div>
                        }

                        @if (IsLocal(provider))
                        {
                            <EditForm Model="_localCredentials"
                                      OnValidSubmit="SubmitLocalCredentialsAsync"
                                      class="login-page__credentials-panel"
                                      data-local-login="true">
                                <DataAnnotationsValidator />
                                <MudTextField T="string"
                                              Label="Username or email"
                                              InputType="InputType.Text"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Username or email is required"
                                              For="@(() => _localCredentials.Identifier)"
                                              @bind-Value="_localCredentials.Identifier"
                                              Disabled="_isSubmittingLocal"
                                              autocomplete="username"
                                              Class="login-page__credential-input" />
                                <MudTextField T="string"
                                              Label="Password"
                                              InputType="InputType.Password"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Password is required"
                                              For="@(() => _localCredentials.Password)"
                                              @bind-Value="_localCredentials.Password"
                                              Disabled="_isSubmittingLocal"
                                              autocomplete="current-password"
                                              Class="login-page__credential-input" />
                                <MudCheckBox T="bool"
                                             @bind-Value="_localCredentials.IsPersistent"
                                             Label="Keep me signed in"
                                             Disabled="_isSubmittingLocal"
                                             Class="login-page__persistent-option" />

                                @if (!string.IsNullOrWhiteSpace(_localAuthErrorMessage))
                                {
                                    <div role="alert">
                                        <MudAlert Severity="Severity.Error">
                                            @_localAuthErrorMessage
                                        </MudAlert>
                                    </div>
                                }

                                <MudButton Elevation="0"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Size="Size.Large"
                                           ButtonType="ButtonType.Submit"
                                           Disabled="_isSubmittingLocal"
                                           aria-busy="@_isSubmittingLocal.ToString().ToLowerInvariant()"
                                           Class="login-page__credential-submit">
                                    @LocalSubmitLabel
                                </MudButton>
                            </EditForm>
                            @if (_lifecycleLinks?.ContainsKey("recover-password") == true)
                            {
                                <p><a href="/auth/local-account-recovery?mode=recover-password">Forgot your Local password?</a></p>
                            }
                            @if (_lifecycleLinks?.ContainsKey("verify-email") == true)
                            {
                                <p><a href="/auth/local-account-recovery?mode=verify-email">Send a verification email</a></p>
                            }
                        }
                        else if (!IsAtprotoPrimary || !IsAtproto(provider))
                        {
                            <MudButton Elevation="0" Variant="@(provider.Recommended ? Variant.Filled : Variant.Outlined)"
                                       Color="@(provider.Recommended ? Color.Primary : Color.Default)"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       StartIcon="@GetProviderIcon(provider)"
                                       OnClick="@(() => StartProvider(provider))"
                                       Class="login-page__provider-button">
                                Continue with @GetProviderDisplayName(provider)
                            </MudButton>
                        }

                        @if (IsAtproto(provider)
                            && (IsAtprotoPrimary
                                || string.Equals(_expandedProviderName, provider.Name, StringComparison.OrdinalIgnoreCase)))
                        {
                            <EditForm Model="@this" OnValidSubmit="StartAtprotoChallenge" class="login-page__handle-panel">
                                <MudTextField Variant="Variant.Outlined" T="string"
                                              Label="ATProto handle"
                                              Placeholder="user.bsky.social"
                                              AutoFocus="true"
                                              Required="true"
                                              RequiredError="ATProto handle is required"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                              Immediate="true"
                                              @bind-Value="_atprotoHandle" />

                                <MudButton Elevation="0" Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Size="Size.Large"
                                           ButtonType="ButtonType.Submit"
                                           Disabled="@string.IsNullOrWhiteSpace(_atprotoHandle)"
                                           Class="login-page__handle-submit">
                                    Continue
                                </MudButton>
                            </EditForm>
                        }
                    </div>
                }
            </MudStack>

            @if (VisitorSignupDestinations.Count > 0)
            {
                <section class="login-page__visitor-signup"
                         aria-labelledby="visitor-signup-heading"
                         data-testid="visitor-signup-destinations">
                    <div>
                        <MudText Id="visitor-signup-heading" Typo="Typo.h6" HtmlTag="h2">
                            New visitor account
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            These links are for new visitor access. Operator and existing-account sign-in remains above.
                        </MudText>
                    </div>
                    <div class="login-page__visitor-signup-links">
                        @foreach (var destination in VisitorSignupDestinations)
                        {
                            <a class="login-page__visitor-signup-link"
                               href="@destination.Url"
                               data-signup-provider="@GetSignupProviderCode(destination.Provider)">
                                Continue as a new visitor with @GetSignupProviderDisplayName(destination.Provider)
                            </a>
                        }
                    </div>
                </section>
            }
        }
    </MudPaper>
</MudContainer>
</div>

@code {
    private const string PersonClassification = "person";
    private bool _isLoading = true;
    private bool _isAutoRedirecting;
    private bool _hasTriggeredRedirect;
    private string? _errorMessage;
    private string? _challengeErrorMessage;
    private string _returnUrl = "/";
    private string _forcedProviderQuery = string.Empty;
    private string _atprotoHandle = string.Empty;
    private string? _expandedProviderName;
    private string? _localAuthErrorMessage;
    private bool _isSubmittingLocal;
    private bool _disposed;
    private int _localRequestGeneration;
    private string _primaryProvider = string.Empty;
    private IJSObjectReference? _bffModule;
    private readonly LocalCredentialsInput _localCredentials = new();
    private List<BffAuthProviderItem> _providers = [];
    private VisitorAccessCapabilityDto? _visitorAccess;
    private Dictionary<string, Explore.Blazor.Client.Clients.HalLink>? _lifecycleLinks;

    private IReadOnlyList<VisitorSignupDestinationDto> VisitorSignupDestinations =>
        _visitorAccess?.SignupDestinations?
            .Where(destination => destination.Provider != AuthenticationProviderKind.Local && !string.IsNullOrWhiteSpace(destination.Url))
            .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        ReadQueryParameters();
        await LoadProvidersAsync();
    }

    private async Task LoadProvidersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await BffAuthApi.GetProvidersAsync(CancellationToken.None);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"Authentication providers returned HTTP {(int)response.StatusCode}.");
            }

            var providers = response.Content?.Providers ?? [];
            _lifecycleLinks = response.Content?._links;
            _visitorAccess = response.Content?.VisitorAccess;
            _primaryProvider = response.Content?.PrimaryProvider
                .Trim()
                .ToLowerInvariant() ?? string.Empty;

            if (providers.Count == 0)
            {
                _errorMessage = "No authentication providers are configured. Ask an instance administrator to configure at least one provider.";
                _isLoading = false;
                return;
            }

            _providers = providers
                .OrderBy(GetProviderSortOrder)
                .ThenBy(p => GetProviderDisplayName(p), StringComparer.OrdinalIgnoreCase)
                .ToList();

            var hintedAtproto = _providers.FirstOrDefault(IsAtproto);
            if (hintedAtproto is not null
                && (IsAtprotoPrimary
                    || string.Equals(_forcedProviderQuery, "atproto", StringComparison.Ordinal)
                    || !string.IsNullOrWhiteSpace(_atprotoHandle)))
            {
                _expandedProviderName = hintedAtproto.Name;
            }

            _isLoading = false;

            await TryAutoRedirectAsync(providers);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load authentication providers from /auth/providers");
            _errorMessage = "Could not load authentication providers. Please try again.";
            _isLoading = false;
        }
    }

    private async Task TryAutoRedirectAsync(List<BffAuthProviderItem> providers)
    {
        if (_hasTriggeredRedirect)
        {
            return;
        }

        // Don't auto-redirect when the last challenge failed — let user see the error
        if (!string.IsNullOrWhiteSpace(_challengeErrorMessage))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_forcedProviderQuery))
        {
            var forcedProvider = providers.FirstOrDefault(provider =>
                string.Equals(MapProviderNameToQueryValue(provider.Name), _forcedProviderQuery, StringComparison.OrdinalIgnoreCase));

            if (forcedProvider is not null)
            {
                if (IsButtonProvider(forcedProvider))
                {
                    _isAutoRedirecting = true;
                    _hasTriggeredRedirect = true;
                    await Task.Yield();
                    StartButtonProviderChallenge(forcedProvider);
                    return;
                }

                if (IsAtproto(forcedProvider)
                    && !string.IsNullOrWhiteSpace(_atprotoHandle))
                {
                    _isAutoRedirecting = true;
                    _hasTriggeredRedirect = true;
                    await Task.Yield();
                    await StartAtprotoChallenge();
                    return;
                }
            }
        }

        if (providers.Count != 1)
        {
            return;
        }

        var provider = providers[0];

        if (IsButtonProvider(provider))
        {
            _isAutoRedirecting = true;
            _hasTriggeredRedirect = true;
            await Task.Yield();
            StartButtonProviderChallenge(provider);
            return;
        }

        if (IsAtproto(provider) && !string.IsNullOrWhiteSpace(_atprotoHandle))
        {
            _isAutoRedirecting = true;
            _hasTriggeredRedirect = true;
            await Task.Yield();
            await StartAtprotoChallenge();
        }
    }

    private void StartButtonProviderChallenge(BffAuthProviderItem provider)
    {
        var providerKey = MapProviderNameToQueryValue(provider.Name);
        var challengeUrl = $"/auth/challenge?provider={Uri.EscapeDataString(providerKey)}&returnUrl={Uri.EscapeDataString(_returnUrl)}";
        Navigation.NavigateTo(challengeUrl, forceLoad: true);
    }

    private void StartProvider(BffAuthProviderItem provider)
    {
        _localRequestGeneration++;
        _localCredentials.Password = string.Empty;
        if (IsAtproto(provider))
        {
            _expandedProviderName = provider.Name;
            return;
        }

        StartButtonProviderChallenge(provider);
    }

    private async Task StartAtprotoChallenge()
    {
        if (string.IsNullOrWhiteSpace(_atprotoHandle))
        {
            return;
        }

        _errorMessage = null;
        AtprotoChallengeResponse? response;
        try
        {
            response = await BffClient.SendAsync<AtprotoChallengeRequest, AtprotoChallengeResponse>(
                HttpMethod.Post,
                "/auth/atproto/challenge",
                new(_atprotoHandle.Trim(), _returnUrl, PersonClassification));
        }
        catch (Exception)
        {
            Logger.LogWarning("ATProto challenge request failed (errorCode=atproto_challenge_unavailable)");
            response = null;
        }

        if (response is null || string.IsNullOrWhiteSpace(response.AuthorizationUrl))
        {
            _errorMessage = "ATProto sign-in could not be started. Check the handle and try again.";
            return;
        }

        _atprotoHandle = string.Empty;
        Navigation.NavigateTo(response.AuthorizationUrl, forceLoad: true);
    }

    private async Task SubmitLocalCredentialsAsync()
    {
        if (_disposed || _isSubmittingLocal)
        {
            return;
        }

        _isSubmittingLocal = true;
        int generation = ++_localRequestGeneration;
        _localAuthErrorMessage = null;
        try
        {
            IJSObjectReference module = await GetBffModuleAsync();
            var request = new LocalBffLoginRequest(
                Identifier: _localCredentials.Identifier.Trim(),
                Password: _localCredentials.Password,
                IsPersistent: _localCredentials.IsPersistent,
                ReturnUrl: _returnUrl);
            LocalBffAuthenticationResponse? response =
                await module.InvokeAsync<LocalBffAuthenticationResponse?>(
                    "authenticateLocal",
                    "/bff/auth/local/login",
                    request);
            if (_disposed || generation != _localRequestGeneration) return;
            if (response is null || !string.IsNullOrEmpty(response.ErrorCode)
                || string.IsNullOrWhiteSpace(response.RedirectUrl))
            {
                _localCredentials.Password = string.Empty;
                _localAuthErrorMessage = response?.ErrorCode == "email_verification_required"
                    ? "Verify your email address before signing in."
                    : "The username or password was not accepted. Check your details and try again.";
                return;
            }

            _localCredentials.Password = string.Empty;
            Navigation.NavigateTo(
                GetSafeReturnUrl(response.RedirectUrl),
                forceLoad: true);
        }
        catch (Exception)
        {
            _localCredentials.Password = string.Empty;
            if (_disposed || generation != _localRequestGeneration) return;
            Logger.LogWarning(
                "Local Identity sign-in request failed (errorCode=local_login_unavailable)");
            _localAuthErrorMessage =
                "Local sign-in is temporarily unavailable. Please try again.";
        }
        finally
        {
            _localCredentials.Password = string.Empty;
            _isSubmittingLocal = false;
        }
    }

    private async ValueTask<IJSObjectReference> GetBffModuleAsync() =>
        _bffModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "/js/bff.js");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _localRequestGeneration++;
        _localCredentials.Password = string.Empty;
        if (_bffModule is not null)
        {
            try
            {
                await _bffModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit may already be disconnected.
            }
        }
    }

    private string LoginSubtitle => IsAtprotoPrimary
            ? "Sign in without a local password by authorizing your AT Protocol account."
        : _providers.Count > 1
            ? "Use your local account or choose another available provider."
            : "Sign in with your local account.";

    private string LocalSubmitLabel => _isSubmittingLocal ? "Signing in..." : "Sign in";

    // HandleAtprotoKeyUp removed in favor of EditForm submission

    private static bool IsButtonProvider(BffAuthProviderItem provider)
    {
        return string.Equals(provider.Type, "button", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAtproto(BffAuthProviderItem provider)
    {
        return string.Equals(provider.Type, "handle_input", StringComparison.OrdinalIgnoreCase)
            || string.Equals(MapProviderNameToQueryValue(provider.Name), "atproto", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsLocal(BffAuthProviderItem provider) =>
        string.Equals(provider.Type, "credentials", StringComparison.OrdinalIgnoreCase)
        || string.Equals(
            MapProviderNameToQueryValue(provider.Name),
            "local",
            StringComparison.OrdinalIgnoreCase);

    private bool IsAtprotoPrimary =>
        string.Equals(
            _primaryProvider,
            "atproto",
            StringComparison.Ordinal);

    private static int GetProviderSortOrder(BffAuthProviderItem provider)
    {
        return MapProviderNameToQueryValue(provider.Name) switch
        {
            "local" => 0,
            "keycloak" => 1,
            "google" => 2,
            "atproto" => 3,
            _ => 100
        };
    }

    private static string GetProviderDisplayName(BffAuthProviderItem provider)
    {
        return IsLocal(provider)
            ? "Local account"
            : IsAtproto(provider)
                ? "ATProto"
                : provider.DisplayName;
    }

    private static string GetSignupProviderCode(AuthenticationProviderKind provider) => provider switch
    {
        AuthenticationProviderKind.Keycloak => "keycloak",
        AuthenticationProviderKind.Atproto => "atproto",
        AuthenticationProviderKind.Google => "google",
        _ => "external"
    };

    private static string GetSignupProviderDisplayName(AuthenticationProviderKind provider) => provider switch
    {
        AuthenticationProviderKind.Keycloak => "Keycloak",
        AuthenticationProviderKind.Atproto => "ATProto",
        AuthenticationProviderKind.Google => "Google",
        _ => "an external provider"
    };

    private static string GetProviderIcon(BffAuthProviderItem provider)
    {
        return MapProviderNameToQueryValue(provider.Name) switch
        {
            "local" => Icons.Material.Filled.AccountCircle,
            "google" => Icons.Material.Filled.AccountCircle,
            "atproto" => Icons.Material.Filled.AlternateEmail,
            _ => Icons.Material.Filled.Login
        };
    }

    private void ReadQueryParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var returnUrlValue))
        {
            _returnUrl = GetSafeReturnUrl(returnUrlValue);
        }

        if (query.TryGetValue("provider", out var providerValue))
        {
            _forcedProviderQuery = providerValue.Trim().ToLowerInvariant();
        }

        if (query.TryGetValue("challengeError", out var challengeErrorValue)
            && (string.Equals(challengeErrorValue, "1", StringComparison.OrdinalIgnoreCase)
                || string.Equals(challengeErrorValue, "true", StringComparison.OrdinalIgnoreCase)))
        {
            _challengeErrorMessage = query.GetValueOrDefault("errorCode") switch
            {
                "atproto_callback_failed" => "ATProto sign-in could not be completed. Please try again.",
                "atproto_challenge_failed" => "ATProto sign-in could not be started. Please try again.",
                _ => "The last login attempt failed. Please choose a provider and try again."
            };
        }
    }

    private sealed record AtprotoChallengeRequest(
        string Handle,
        string ReturnPath,
        string Classification);

    private sealed record AtprotoChallengeResponse(string AuthorizationUrl);

    private static Dictionary<string, string> ParseQuery(string queryString)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(queryString))
        {
            return result;
        }

        var trimmed = queryString.StartsWith('?') ? queryString[1..] : queryString;
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return result;
        }

        var pairs = trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in pairs)
        {
            var separatorIndex = pair.IndexOf('=');
            if (separatorIndex <= 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(pair[..separatorIndex]);
            var value = Uri.UnescapeDataString(pair[(separatorIndex + 1)..]);
            result[key] = value;
        }

        return result;
    }

    private static string GetSafeReturnUrl(string? rawReturnUrl)
    {
        if (string.IsNullOrWhiteSpace(rawReturnUrl))
        {
            return "/";
        }

        return rawReturnUrl.StartsWith('/') &&
               !rawReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
               !rawReturnUrl.StartsWith("/\\", StringComparison.Ordinal)
            ? rawReturnUrl
            : "/";
    }

    private static string MapProviderNameToQueryValue(string providerName)
    {
        return providerName.ToLowerInvariant() switch
        {
            "keycloak" => "keycloak",
            "google" => "google",
            "atproto" => "atproto",
            "local" => "local",
            _ => providerName.ToLowerInvariant()
        };
    }

    private sealed class LocalCredentialsInput
    {
        [Required]
        [StringLength(256)]
        public string Identifier { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool IsPersistent { get; set; }
    }

}
