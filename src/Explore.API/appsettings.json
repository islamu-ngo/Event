{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromName": "",
    "FromAddress": "contact@openislamu.org"
  },
  "Reporting": {
    "CaseSlaHours": 48
  },
  "Cors": {
    "AllowedOrigins": [
      "https://iloveibadah.app"
    ]
  },
  "ForwardedHeadersTrust": {
    "ForwardLimit": 1,
    "TrustLoopbackProxy": true,
    "KnownProxies": [
      "127.0.0.1"
    ],
    "KnownNetworks": [
      "::1/128"
    ]
  },
  "Payments": {
    "Stripe": {
      "Mode": "Test",
      "AllowedCheckoutHosts": [
        "checkout.stripe.com"
      ]
    },
    "OrganizerDirect": {
      "ProviderCode": "",
      "ConnectPlatformId": ""
    },
    "CheckoutGovernance": {
      "ComplaintOwner": "",
      "RefundOwner": "",
      "DisputeOwner": "",
      "ReconciliationOwner": "",
      "ActivationStatus": "suspended",
      "RefundPolicyLanguageTag": "",
      "StatementDescriptor": "",
      "ChargeType": "direct-charge"
    }
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 200,
      "ReplenishPeriodSeconds": 10,
      "TokensPerPeriod": 40
    },
    "Authenticated": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "PublicIngestion": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "PublicTransactional": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AnonymousRegistration": {
      "IpPermitLimit": 10,
      "SubnetPermitLimit": 40,
      "WindowSeconds": 60,
      "ConcurrencyLimit": 8,
      "QueueLimit": 0
    },
    "ControlPlane": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "ConcurrencyLimit": 4,
      "QueueLimit": 0
    },
    "SetupSecret": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "RequestTimeouts": {
    "DefaultSeconds": 30,
    "LookupSeconds": 10,
    "ComplexSeconds": 60,
    "ControlPlaneSeconds": 20
  },
  "EmailDispatch": {
    "EventReminderLeadTimeHours": 24
  },
  "EmailDispatchProcessor": {
    "Enabled": true,
    "Mode": "Quartz",
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRowsPerTenantPerBatch": 5,
    "MaxConcurrentDispatches": 8,
    "MaxConcurrentDispatchesPerTenant": 2,
    "GlobalSmtpRateLimitPerMinute": 120,
    "TenantSmtpRateLimitPerMinute": 30,
    "OptionalBacklogHighWatermark": 1000,
    "OptionalBacklogLowWatermark": 500,
    "MaxAttemptCount": 5,
    "InitialRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 3600,
    "ProcessingLeaseTimeoutSeconds": 900,
    "HealthDueDispatchWarningThreshold": 1000,
    "HealthStaleProcessingWarningThreshold": 1,
    "HealthUnknownWarningThreshold": 1,
    "HealthDeadLetterWarningThreshold": 1,
    "HealthOldestPendingWarningSeconds": 900,
    "HealthTenantBacklogWarningThreshold": 250,
    "HealthTenantSampleLimit": 10
  },
  "NotificationFanoutProcessor": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "PageSize": 250,
    "MaxClaimsPerRound": 8,
    "MaxActiveClaims": 8,
    "MaxActiveClaimsPerTenant": 2,
    "ClaimLeaseSeconds": 120,
    "OptionalReminderBacklogHighWatermark": 1000,
    "OptionalReminderBacklogLowWatermark": 500,
    "HealthDueOccurrenceWarningThreshold": 1000,
    "HealthExpiredClaimWarningThreshold": 1,
    "HealthOldestDueWarningSeconds": 900
  },
  "EmailDispatchRetention": {
    "Enabled": true,
    "DryRun": false,
    "InitialDelaySeconds": 60,
    "PollingIntervalMinutes": 60,
    "MaxTenantsPerPass": 100,
    "BatchSize": 500,
    "RetentionDays": 180
  },
  "Scheduler": {
    "Quartz": {
      "Enabled": true,
      "SchedulerName": "islamu-event-scheduler",
      "InstanceId": "AUTO",
      "UsePersistentStore": true,
      "TablePrefix": "QRTZ_",
      "ClusteringEnabled": false,
      "ClusterCheckinIntervalSeconds": 20,
      "ApplySchemaOnStartup": true,
      "ValidateSchemaOnStartup": true,
      "StatusEndpointEnabled": false,
      "StatusEndpointPath": "/admin/scheduler",
      "StatusEndpointAuthorizationPolicy": "quartz_instance_admin"
    }
  },
  "Atproto": {
    "PdsSync": {
      "Enabled": true,
      "PollingIntervalSeconds": 5,
      "BatchSize": 20,
      "MaxConcurrency": 10,
      "LeaseDurationSeconds": 90
    },
    "Jetstream": {
      "Endpoint": "https://jetstream.us-east.bsky.network",
      "MaxMessageSizeBytes": 2113536,
      "EnableCompression": false,
      "ArchiveProbeMaximumBlocks": 64,
      "ArchiveProbeDownloadConcurrency": 4,
      "LeaseDurationSeconds": 60,
      "LeaseRenewalSeconds": 20,
      "CapabilityPollMilliseconds": 5000,
      "RetryMinimumMilliseconds": 1000,
      "RetryMaximumMilliseconds": 30000,
      "AllowedDids": []
    }
  },
  "Cerbos": {
    "GrpcEndpoint": "http://localhost:3593",
    "PlaintextMode": true,
    "AdminApi": {
      "Endpoints": [],
      "AdminUsername": "",
      "AdminPassword": ""
    },
    "PolicyPackagePath": "cerbos/policies"
  }
}
