@page "/events/{EventId:guid}/sessions/{SessionId:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize]

@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Explore.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@inject ILogger<EditSession> Logger

<PageTitle>Edit program item</PageTitle>

<main class="edit-session" aria-labelledby="edit-session-title">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Class="edit-session__surface pa-6" Elevation="0">
            <MudText Typo="Typo.h4" HtmlTag="h1" id="edit-session-title" Class="mb-2">Edit program item</MudText>
            @if (_isLoading)
            {
                <div class="edit-session__loading" role="status" aria-live="polite">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading session...</MudText>
                </div>
            }
            else if (_event is null || _sourceSession is null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @(_submitState.ErrorMessage ?? "The program item could not be loaded. Return to the event draft and try again.")
                </MudAlert>

                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft">
                    Back to event draft
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Update <strong>@_sourceSession.Title</strong> for <strong>@_event.Title</strong>. Program items are sessions, not child events.
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" role="status">
                        @_successMessage
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    This dedicated composer edits the saved program item without reopening the event shell drawer.
                </MudAlert>

                @if (!_canEditSession)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                        You do not currently have permission to edit this program item.
                    </MudAlert>
                }

                @if (_locations.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                        No event-associated locations are available. Location and room selection stays unavailable until a venue is linked through an authorized event management flow.
                    </MudAlert>
                }

                <EditForm EditContext="_editContext" OnValidSubmit="SaveSessionAsync">
                    <FormSubmissionGuard State="@_submitState">
                    <AppValidationSummary />

                    <EventSessionForm FormGridClass="edit-session__form-grid"
                                      TimeGridClass="edit-session__time-grid"
                                      Title="@_session.Title!.Value!.Value"
                                      TitleChanged="@(value => _session.Title!.Value!.Value = value)"
                                      TitleFor="@(() => _session.Title!.Value!.Value)"
                                      Description="@_session.Description!.Value!.Value"
                                      DescriptionChanged="@(value => _session.Description!.Value!.Value = value)"
                                      DescriptionFor="@(() => _session.Description!.Value!.Value)"
                                      SessionDate="@_sessionDate"
                                      SessionDateChanged="@(value => _sessionDate = value)"
                                      StartTime="@_startTime"
                                      StartTimeChanged="@(value => _startTime = value)"
                                      EndTime="@_endTime"
                                      EndTimeChanged="@(value => _endTime = value)"
                                      LocationId="@_session.Location!.Value!.Value"
                                      LocationIdChanged="OnLocationChangedAsync"
                                      RoomId="@_session.Room!.Value!.Value"
                                      RoomIdChanged="@(value => _session.Room!.Value!.Value = value)"
                                      RoomDisabled="@(!_session.Location!.Value!.Value.HasValue || !_rooms.Any())"
                                      ProgramSectionId="@_selectedSessionGroupId"
                                      ProgramSectionIdChanged="@(value => _selectedSessionGroupId = value)"
                                      ProgramSectionDisabled="@(!_sessionGroups.Any())"
                                      Capacity="@_session.MaxAudienceAttendees!.Value!.Value"
                                      CapacityChanged="@(value => _session.MaxAudienceAttendees!.Value!.Value = value)"
                                      RegistrationModeId="@_session.RegistrationMode!.Value!.Value"
                                      RegistrationModeIdChanged="@(value => _session.RegistrationMode!.Value!.Value = value)"
                                      RegistrationModeDisabled="@(!_registrationModes.Any())">
                        <LocationOptions>
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No location yet</MudSelectItem>
                            @foreach (var location in _locations.Where(location => location.Id.HasValue))
                            {
                                <MudSelectItem T="Guid?" Value="@location.Id">@FormatLocation(location)</MudSelectItem>
                            }
                        </LocationOptions>
                        <RoomOptions>
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No room yet</MudSelectItem>
                            @foreach (var room in _rooms)
                            {
                                <MudSelectItem T="Guid?" Value="@room.Id">@FormatRoom(room)</MudSelectItem>
                            }
                        </RoomOptions>
                        <ProgramSectionOptions>
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No program section yet</MudSelectItem>
                            @foreach (var group in _sessionGroups.OrderBy(group => group.SortOrder).ThenBy(group => group.Name))
                            {
                                <MudSelectItem T="Guid?" Value="@group.Id">@FormatSessionGroup(group)</MudSelectItem>
                            }
                        </ProgramSectionOptions>
                        <RegistrationModeOptions>
                            @foreach (var mode in _registrationModes.Where(mode => mode.Id.HasValue).OrderBy(mode => mode.Id))
                            {
                                <MudSelectItem T="int?" Value="@mode.Id">@FormatRegistrationMode(mode)</MudSelectItem>
                            }
                        </RegistrationModeOptions>
                    </EventSessionForm>

                    <div class="edit-session__actions">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft" Disabled="@_submitState.IsSubmitting">
                            Back to event draft
                        </MudButton>
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_submitState.IsSubmitting || !_canEditSession)">
                            @(_submitState.IsSubmitting ? "Saving..." : "Save changes")
                        </MudButton>
                    </div>
                    </FormSubmissionGuard>
                </EditForm>
            }
        </MudPaper>
    </MudContainer>
</main>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid SessionId { get; set; }

    [Inject] private IEventService EventService { get; set; } = default!;
    [Inject] private Explore.Blazor.Client.Contracts.Services.IEventSessionService EventSessionService { get; set; } = default!;
    [Inject] private Explore.Blazor.Client.Contracts.Services.Lookup.IEventLookupService EventLookupService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private EventDto? _event;
    private EventSessionDto? _sourceSession;
    private ICollection<EventSessionCreateLocationOptionDto> _locations = new List<EventSessionCreateLocationOptionDto>();
    private ICollection<EventSessionCreateRoomOptionDto> _allRooms = new List<EventSessionCreateRoomOptionDto>();
    private ICollection<EventSessionCreateRoomOptionDto> _rooms = new List<EventSessionCreateRoomOptionDto>();
    private ICollection<HalResourceOfEventSessionGroupListDto> _sessionGroups = new List<HalResourceOfEventSessionGroupListDto>();
    private ICollection<RegistrationModeListDto> _registrationModes = new List<RegistrationModeListDto>();
    private readonly UpdateEventSessionDto _session = new();
    private DateTime? _sessionDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private bool _isLoading = true;
    private bool _canEditSession;
    private Guid? _selectedSessionGroupId;
    private Guid? _initialSessionGroupId;
    private string? _successMessage;
    private string? _eventTimeZoneId;

    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    protected override async Task OnInitializedAsync()
    {
        ApplyRouteParametersFromCurrentUri();

        _editContext = new EditContext(_session);
        _errorStore.Init(_editContext);
        var eventTask = EventService.GetEventByIdAsync(EventId);
        var sessionTask = EventSessionService.GetManagedSessionByIdAsync(EventId, SessionId);
        var createContextTask = EventSessionService.GetEventSessionCreateContextAsync(EventId);
        var sessionGroupsTask = EventSessionService.GetManagedSessionGroupsByEventAsync(EventId);
        var registrationModesTask = EventLookupService.GetRegistrationModesAsync();

        _event = await eventTask;
        _sourceSession = await sessionTask;
        var createContext = await createContextTask;
        _eventTimeZoneId = createContext?.TimeZoneId;
        _locations = createContext?.Locations ?? new List<EventSessionCreateLocationOptionDto>();
        _allRooms = createContext?.Rooms ?? new List<EventSessionCreateRoomOptionDto>();
        _sessionGroups = await sessionGroupsTask;
        _registrationModes = await registrationModesTask;

        if (_event is null)
        {
            _submitState.Fail("The event draft could not be loaded.");
        }
        else if (_sourceSession is null)
        {
            _submitState.Fail("The session could not be loaded.");
        }
        else if (_sourceSession.EventId != EventId)
        {
            _submitState.Fail("This session does not belong to the selected event draft.");
            _sourceSession = null;
        }
        else if (string.IsNullOrWhiteSpace(_eventTimeZoneId))
        {
            _submitState.Fail("The event timezone is missing. Set it before editing program times.");
            _sourceSession = null;
        }
        else
        {
            _canEditSession = _sourceSession.HasHalLink("edit");
            var formState = PopulateSession(_sourceSession);
            _selectedSessionGroupId = formState.PrimarySessionGroupId;
            _initialSessionGroupId = _selectedSessionGroupId;
            await LoadRoomsForLocationAsync(_session.Location!.Value!.Value);
        }

        _isLoading = false;
    }

    private void ApplyRouteParametersFromCurrentUri()
    {
        var segments = Navigation
            .ToAbsoluteUri(Navigation.Uri)
            .AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries);
        var eventSegmentIndex = Array.FindIndex(
            segments,
            segment => string.Equals(segment, "events", StringComparison.OrdinalIgnoreCase));

        if (eventSegmentIndex < 0 || eventSegmentIndex + 5 != segments.Length)
        {
            return;
        }

        if (!string.Equals(segments[eventSegmentIndex + 2], "sessions", StringComparison.OrdinalIgnoreCase)
            || !string.Equals(segments[eventSegmentIndex + 4], "edit", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (Guid.TryParse(segments[eventSegmentIndex + 1], out var eventId))
        {
            EventId = eventId;
        }

        if (Guid.TryParse(segments[eventSegmentIndex + 3], out var sessionId))
        {
            SessionId = sessionId;
        }
    }

    private async Task OnLocationChangedAsync(Guid? locationId)
    {
        _session.Location!.Value!.Value = locationId;
        _session.Room!.Value!.Value = null;
        await LoadRoomsForLocationAsync(locationId);
    }

    private Task LoadRoomsForLocationAsync(Guid? locationId)
    {
        if (!locationId.HasValue || locationId.Value == Guid.Empty)
        {
            _rooms = new List<EventSessionCreateRoomOptionDto>();
            _session.Room!.Value!.Value = null;
            return Task.CompletedTask;
        }

        _rooms = _allRooms.Where(room => room.LocationId == locationId).ToList();
        if (_session.Room!.Value!.Value.HasValue
            && _rooms.All(room => room.Id != _session.Room.Value.Value.Value))
        {
            _session.Room.Value.Value = null;
        }

        return Task.CompletedTask;
    }

    private EventSessionEditFormState PopulateSession(EventSessionDto session)
    {
        var formState = EventSessionFormModelMapper.PopulateUpdateRequest(
            _session,
            session,
            EventId,
            _eventTimeZoneId!);
        _sessionDate = formState.SessionDate;
        _startTime = formState.StartTime;
        _endTime = formState.EndTime;
        return formState;
    }

    private async Task SaveSessionAsync()
    {
        _successMessage = null;

        if (!TryPrepareSession(out var validationError))
        {
            _submitState.Fail(validationError!);
            return;
        }

        if (_submitState.IsSubmitting) return;
        _submitState.Start();
        try
        {
            var result = await EventSessionSaveCoordinator.SaveUpdateSessionAsync(
                EventSessionService,
                _session,
                EventId,
                SessionId,
                _sourceSession?.ConcurrencyStamp ?? Guid.Empty,
                _selectedSessionGroupId,
                _initialSessionGroupId);
            if (result.Success)
            {
                _successMessage = "Program item saved. Returning to the event draft.";
                Navigation.NavigateTo($"/events/{EventId}/edit?programUpdated=1");
                return;
            }

            _submitState.Fail(result.ErrorMessage!);
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                Logger.LogError(ex, "Exception during program item update");
                _submitState.Fail("Program item could not be saved. Please try again.");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during program item update");
            _submitState.Fail("Program item could not be saved. Please try again.");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private bool TryPrepareSession(out string? validationError)
    {
        validationError = null;
        if (!_canEditSession)
        {
            validationError = "You do not currently have permission to edit this program item.";
            return false;
        }

        return EventSessionFormModelMapper.TryPrepareUpdateRequest(
            _session,
            EventId,
            SessionId,
            _sourceSession?.Id,
            _sessionDate,
            _startTime,
            _endTime,
            out validationError,
            _eventTimeZoneId!,
            _sourceSession?.StartTime,
            _sourceSession?.EndTime);
    }

    private static string FormatLocation(EventSessionCreateLocationOptionDto location)
    {
        if (!string.IsNullOrWhiteSpace(location.City) && !string.IsNullOrWhiteSpace(location.Country))
        {
            return $"{location.FullName} — {location.City}, {location.Country}";
        }

        return location.FullName;
    }

    private static string FormatRoom(EventSessionCreateRoomOptionDto room) => room.Capacity.HasValue
        ? $"{room.Name} · {room.Capacity.Value} seats"
        : room.Name;

    private static string FormatSessionGroup(HalResourceOfEventSessionGroupListDto group)
    {
        if (!string.IsNullOrWhiteSpace(group.RoomName))
            return $"{group.Name} · {group.RoomName}";

        if (!string.IsNullOrWhiteSpace(group.LocationName))
            return $"{group.Name} · {group.LocationName}";

        return group.Name;
    }

    private static string FormatRegistrationMode(RegistrationModeListDto mode)
        => string.IsNullOrWhiteSpace(mode.Description)
            ? mode.FullName
            : $"{mode.FullName} · {mode.Description}";

    private void BackToEventDraft() => Navigation.NavigateTo($"/events/{EventId}/edit");
}
