<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Explore.Secrets</RootNamespace>
    <UserSecretsId>event-shared-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Explore.Secrets.UnitTests" />
  </ItemGroup>

  <!-- Use ASP.NET Core shared framework for Http, DI, Configuration, Logging, Options, HealthChecks -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Secret provider SDKs -->
  <ItemGroup>
    <PackageReference Include="Infisical.Sdk" />
  </ItemGroup>

  <!-- Database configuration provider -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- Phase 3 control-plane: Explore.Secrets implements ISecretSource/ISecretResolver from Application layer. -->
  <ItemGroup>
    <ProjectReference Include="..\Explore.Application\Explore.Application.csproj" />
  </ItemGroup>

</Project>
