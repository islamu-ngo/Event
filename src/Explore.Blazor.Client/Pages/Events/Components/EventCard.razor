<div class="event-card-root">
    @if (Layout == LayoutMode.CompactGrid)
    {
        @* ── Mode 1: Compact Grid — image-dominant with overlay + progressive disclosure ── *@
        <MudCard @onclick="HandleClick"
                 @onkeydown="HandleKeyDown"
                 Class="@CardCssClass"
                 Outlined="true"
                 Elevation="0"
                 Style="@CardInteractionStyle"
                 role="@CardRole"
                 tabindex="@CardTabIndex"
                 aria-label="@CardAriaLabel">
            <div class="event-card__image-wrapper">
                @if (ExternalEventUrl is not null || HasCardActions)
                {
                    <div class="event-card__image-actions">
                        @if (ExternalEventUrl is { } compactExternalEventUrl)
                        {
                            <a class="event-card__external-link"
                               href="@compactExternalEventUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="@ExternalEventLinkLabel"
                               @onclick:stopPropagation="true"
                               @onkeydown:stopPropagation="true">
                                <span>Open</span>
                                <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-hidden="true" />
                            </a>
                        }
                        @if (HasCardActions)
                        {
                            <div class="event-card__action-menu event-card__action-menu--overlay"
                                 @onclick:stopPropagation="true"
                                 @onkeydown:stopPropagation="true">
                                @if (CanShare)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Share"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="ShareEventAsync"
                                                   aria-label="@ShareButtonLabel" />
                                }
                                @if (HasManagementMenu)
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                             Class="event-card__menu-button">
                                        @if (CanEdit)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => HandleEdit())">Edit</MudMenuItem>
                                        }
                                        @if (CanDelete)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => HandleDelete())">Delete</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>
                        }
                    </div>
                }
                @if (HasActualImage)
                {
                    <div class="event-card__image-blur" style="background-image: url('@DisplayImageSource');"></div>
                }
                <img src="@DisplayImageSource"
                     alt="@Event.Title"
                     width="300"
                     height="400"
                     loading="lazy"
                     decoding="async"
                     @onerror="HandleImageError"
                     class="event-card__image"
                     style="@ImageFitStyle" />

                @* Icon badges (top-left) — always visible *@
                <div class="event-card__icon-badges event-card__icon-badges--compact">
                    <MudTooltip Text="@Event.VisibilityTypeFullName">
                        <MudIcon Icon="@VisibilityIcon" Size="Size.Small" />
                    </MudTooltip>
                    <MudTooltip Text="@Event.AudienceGenderFullName">
                        <MudIcon Icon="@AudienceGenderIcon" Size="Size.Small" />
                    </MudTooltip>
                    <MudTooltip Text="@FormatTooltip">
                        <MudIcon Icon="@FormatIcon" Size="Size.Small" />
                    </MudTooltip>
                </div>

                @* Overlay — title + date + progressive disclosure *@
                <div class="event-card__overlay">
                    @if (IsModerated)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="event-card__overlay-chip">
                            Moderated
                        </MudChip>
                    }
                    @if (IsFederated)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="event-card__overlay-chip">
                            AT Protocol
                        </MudChip>
                    }
                    @if (IsCommunityReported)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="event-card__provenance-badge">
                            Community reported
                        </MudChip>
                    }
                    @if (AtprotoDeliveryLabel is { } compactDeliveryLabel)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@AtprotoDeliveryColor" Variant="Variant.Filled"
                                 Class="event-card__overlay-chip" title="@AtprotoDeliveryGuidance">
                            @compactDeliveryLabel
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="event-card__overlay-chip">
                        @EventTypeName
                    </MudChip>
                    @if (IsPastEvent)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="event-card__ended-chip event-card__overlay-chip">
                            Ended
                        </MudChip>
                    }
                    <MudText Typo="Typo.subtitle2" Class="event-card__overlay-title">@Event.Title</MudText>
                    @if (IsFieldVisible("event_list.card.show_date"))
                    {
                        <div class="event-card__overlay-meta">
                            <MudText Typo="Typo.caption">@FormattedEventDate</MudText>
                        </div>
                    }
                    @if (CompactExtraFieldCount > 0)
                    {
                        <div class="event-card__more-badge">
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Class="event-card__more-chip">
                                +@CompactExtraFieldCount more
                            </MudChip>
                        </div>
                    }
                </div>

                @* Hover reveal — hidden fields shown on hover *@
                @if (CompactExtraFieldCount > 0)
                {
                    <div class="event-card__hover-reveal">
                        @if (IsFieldVisible("event_list.card.show_price") && TicketPriceSummaryText is { } compactPriceSummary)
                        {
                            <span class="event-card__hover-item event-card__hover-item--price">
                                <MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" />
                                <span>@compactPriceSummary</span>
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_status"))
                        {
                            <span class="event-card__hover-item">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                @Event.EventStatusFullName
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_location"))
                        {
                            <span class="event-card__hover-item">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" />
                                @LocationText
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_organizer"))
                        {
                            <span class="event-card__hover-item">
                                <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" />
                                @Event.ActorDisplayName
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_description"))
                        {
                            <span class="event-card__hover-item event-card__hover-item--description">
                                @TruncatedDescription
                            </span>
                        }
                    </div>
                }
            </div>
        </MudCard>
    }
    else if (Layout == LayoutMode.DetailedList)
    {
        @* ── Mode 2: Detailed List — horizontal card with icon badges ── *@
        <MudCard @onclick="HandleClick"
                 @onkeydown="HandleKeyDown"
                 Class="@CardCssClass"
                 Outlined="true"
                 Elevation="0"
                 Style="@CardInteractionStyle"
                 role="@CardRole"
                 tabindex="@CardTabIndex"
                 aria-label="@CardAriaLabel">
            <div class="event-card__horizontal">
                <div class="event-card__horizontal-image">
                    @if (ExternalEventUrl is { } detailedExternalEventUrl)
                    {
                        <a class="event-card__external-link"
                           href="@detailedExternalEventUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@ExternalEventLinkLabel"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true">
                            <span>Open</span>
                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-hidden="true" />
                        </a>
                    }
                    @if (HasActualImage)
                    {
                        <div class="event-card__image-blur" style="background-image: url('@DisplayImageSource');"></div>
                    }
                    <img src="@DisplayImageSource"
                         alt="@Event.Title"
                         width="200"
                         height="280"
                         loading="lazy"
                         decoding="async"
                         @onerror="HandleImageError"
                         class="event-card__image-foreground"
                         style="@ImageFitStyle" />
                </div>
                <div class="event-card__horizontal-content">
                    @* Header: Title + icon badges + Actions *@
                    <div class="event-card__dl-header">
                        <MudText Typo="Typo.subtitle1" Class="event-card__dl-title">@Event.Title</MudText>
                        <div class="d-flex align-center gap-1 flex-shrink-0">
                            @* Icon badges inline *@
                            <div class="event-card__icon-badges">
                                <MudTooltip Text="@Event.VisibilityTypeFullName">
                                    <MudIcon Icon="@VisibilityIcon" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                                <MudTooltip Text="@Event.AudienceGenderFullName">
                                    <MudIcon Icon="@AudienceGenderIcon" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                                <MudTooltip Text="@FormatTooltip">
                                    <MudIcon Icon="@FormatIcon" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                            </div>
                            @if (CanShare)
                            {
                                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Share"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="ShareEventAsync"
                                                   aria-label="@ShareButtonLabel" />
                                </div>
                            }
                            @if (HasManagementMenu)
                            {
                                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        @if (CanEdit)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => HandleEdit())">Edit</MudMenuItem>
                                        }
                                        @if (CanDelete)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => HandleDelete())">Delete</MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                            }
                        </div>
                    </div>

                    @* Chips: type + price (reduced from full chip row) *@
                    <div class="event-card__dl-chips">
                        @if (IsFederated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">AT Protocol</MudChip>
                        }
                        @if (IsCommunityReported)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="event-card__provenance-badge">Community reported</MudChip>
                        }
                        @if (AtprotoDeliveryLabel is { } detailedDeliveryLabel)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@AtprotoDeliveryColor" Variant="Variant.Filled">
                                @detailedDeliveryLabel
                            </MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="font-weight-bold">@EventTypeName</MudChip>
                        @if (IsModerated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Moderated</MudChip>
                        }
                        else if (IsPastEvent)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="event-card__ended-chip">Ended</MudChip>
                        }
                        else if (IsFieldVisible("event_list.card.show_status"))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Event.EventStatusFullName</MudChip>
                        }
                        @if (IsFieldVisible("event_list.card.show_price") && TicketPriceSummaryText is { } detailedPriceSummary)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@TicketPriceSummaryColor" Variant="Variant.Text" Class="event-card__price-summary">@detailedPriceSummary</MudChip>
                        }
                    </div>

                    @if (AtprotoDeliveryGuidance is { } detailedDeliveryGuidance)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">
                            @detailedDeliveryGuidance
                        </MudText>
                    }

                    @* Description *@
                    @if (IsFieldVisible("event_list.card.show_description"))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="event-card__dl-description">@TruncatedDescription</MudText>
                    }

                    @* Meta: Date, location, organizer *@
                    <div class="event-card__dl-meta">
                        @if (IsFieldVisible("event_list.card.show_date"))
                        {
                            <span class="event-card__dl-meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />
                                @FormattedEventDate
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_location"))
                        {
                            <span class="event-card__dl-meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" />
                                @LocationText
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_organizer"))
                        {
                            var dlOrgUrl = GetActorProfileUrl(Event.ActorId, Event.ActorTypeId);
                            <span class="event-card__organizer @(dlOrgUrl != null ? "event-card__organizer--clickable" : "")"
                                  @onclick:stopPropagation="true"
                                  @onkeydown:stopPropagation="true"
                                  @onclick="@(() => NavigateToActorProfile(Event.ActorId, Event.ActorTypeId))">
                                <MudAvatar Size="Size.Small" Image="@Event.ActorProfilePictureUri" Color="Color.Primary" Style="width: 20px; height: 20px; font-size: 0.65rem;">
                                    @if (string.IsNullOrEmpty(Event.ActorProfilePictureUri) && !string.IsNullOrEmpty(Event.ActorDisplayName))
                                    {
                                        @(Event.ActorDisplayName.FirstOrDefault())
                                    }
                                </MudAvatar>
                                <span class="event-card__organizer-name">@Event.ActorDisplayName</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </MudCard>
    }
    else
    {
        @* ── Mode 3: Single Row — full-width with all fields + icon badges ── *@
        <MudCard @onclick="HandleClick"
                 @onkeydown="HandleKeyDown"
                 Class="@CardCssClass"
                 Outlined="true"
                 Elevation="0"
                 Style="@CardInteractionStyle"
                 role="@CardRole"
                 tabindex="@CardTabIndex"
                 aria-label="@CardAriaLabel">
            <div class="event-card__full-row">
                <div class="event-card__full-row-image">
                    @if (ExternalEventUrl is { } rowExternalEventUrl)
                    {
                        <a class="event-card__external-link"
                           href="@rowExternalEventUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@ExternalEventLinkLabel"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true">
                            <span>Open</span>
                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-hidden="true" />
                        </a>
                    }
                    @if (HasActualImage)
                    {
                        <div class="event-card__image-blur" style="background-image: url('@DisplayImageSource');"></div>
                    }
                    <img src="@DisplayImageSource"
                         alt="@Event.Title"
                         width="210"
                         height="280"
                         loading="lazy"
                         decoding="async"
                         @onerror="HandleImageError"
                         class="event-card__image-foreground"
                         style="@ImageFitStyle" />
                </div>
                <div class="event-card__full-row-content">
                    @* Header: Title + subtitle + actions *@
                    <div class="event-card__sr-header">
                        <div class="event-card__sr-title-block">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @Event.Title
                            </MudText>
                            @if (!string.IsNullOrEmpty(Event.Subtitle))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @Event.Subtitle
                                </MudText>
                            }
                        </div>
                        <div class="event-card__sr-status-chips">
                            @if (CanShare)
                            {
                                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Share"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="ShareEventAsync"
                                                   aria-label="@ShareButtonLabel" />
                                </div>
                            }
                            @if (HasManagementMenu)
                            {
                                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        @if (CanEdit)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => HandleEdit())">Edit</MudMenuItem>
                                        }
                                        @if (CanDelete)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => HandleDelete())">Delete</MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                            }
                        </div>
                    </div>

                    @* Chips + icon badges: type, status, price + visibility/gender/format icons *@
                    <div class="event-card__sr-chips">
                        @if (IsFederated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">AT Protocol</MudChip>
                        }
                        @if (IsCommunityReported)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="event-card__provenance-badge">Community reported</MudChip>
                        }
                        @if (AtprotoDeliveryLabel is { } rowDeliveryLabel)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@AtprotoDeliveryColor" Variant="Variant.Filled">
                                @rowDeliveryLabel
                            </MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="font-weight-bold">@EventTypeName</MudChip>
                        @if (IsModerated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Moderated</MudChip>
                        }
                        else if (IsPastEvent)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="event-card__ended-chip">Ended</MudChip>
                        }
                        else if (IsFieldVisible("event_list.card.show_status"))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Event.EventStatusFullName</MudChip>
                        }
                        @if (IsFieldVisible("event_list.card.show_price") && TicketPriceSummaryText is { } rowPriceSummary)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@TicketPriceSummaryColor" Variant="Variant.Text" Class="event-card__price-summary">@rowPriceSummary</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(Event.MadhabFullName))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Text">@Event.MadhabFullName</MudChip>
                        }
                        @* Icon badges inline with chips *@
                        <div class="event-card__icon-badges event-card__icon-badges--inline">
                            <MudTooltip Text="@Event.VisibilityTypeFullName">
                                <MudIcon Icon="@VisibilityIcon" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                            <MudTooltip Text="@Event.AudienceGenderFullName">
                                <MudIcon Icon="@AudienceGenderIcon" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                            <MudTooltip Text="@FormatTooltip">
                                <MudIcon Icon="@FormatIcon" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                            @if (!string.IsNullOrEmpty(Event.AudienceAgeFullName))
                            {
                                <MudTooltip Text="@Event.AudienceAgeFullName">
                                    <MudIcon Icon="@Icons.Material.Outlined.Escalator" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                            }
                        </div>
                    </div>

                    @if (AtprotoDeliveryGuidance is { } rowDeliveryGuidance)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">
                            @rowDeliveryGuidance
                        </MudText>
                    }

                    @* Description *@
                    @if (IsFieldVisible("event_list.card.show_description"))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="event-card__sr-description">@TruncatedDescription</MudText>
                    }

                    @* Meta: Date, sessions, location, organizer *@
                    <div class="event-card__sr-meta">
                        @if (IsFieldVisible("event_list.card.show_date"))
                        {
                            <span class="event-card__sr-meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />
                                @FormattedEventDate
                                @if (Event.SessionCount > 1)
                                {
                                    <span class="mud-secondary-text">(@Event.SessionCount sessions)</span>
                                }
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_location"))
                        {
                            <span class="event-card__sr-meta-item">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" />
                                @LocationText
                            </span>
                        }
                        @if (IsFieldVisible("event_list.card.show_organizer"))
                        {
                            var srOrgUrl = GetActorProfileUrl(Event.ActorId, Event.ActorTypeId);
                            <span class="event-card__organizer @(srOrgUrl != null ? "event-card__organizer--clickable" : "")"
                                  @onclick:stopPropagation="true"
                                  @onkeydown:stopPropagation="true"
                                  @onclick="@(() => NavigateToActorProfile(Event.ActorId, Event.ActorTypeId))">
                                <MudAvatar Size="Size.Small" Image="@Event.ActorProfilePictureUri" Color="Color.Primary" Style="width: 20px; height: 20px; font-size: 0.65rem;">
                                    @if (string.IsNullOrEmpty(Event.ActorProfilePictureUri) && !string.IsNullOrEmpty(Event.ActorDisplayName))
                                    {
                                        @(Event.ActorDisplayName.FirstOrDefault())
                                    }
                                </MudAvatar>
                                <span class="event-card__organizer-name">@Event.ActorDisplayName</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </MudCard>
    }
</div>
