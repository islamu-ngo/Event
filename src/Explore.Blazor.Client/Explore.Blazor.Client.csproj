<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Strip .NET IL after AOT compilation for smaller WASM bundles (20-50% reduction).
         DISABLED: Can cause WASM runtime failures when IL interpreter is needed (reflection, late-bound calls).
         Only enable in Release after thorough testing. See: https://learn.microsoft.com/en-us/aspnet/core/blazor/performance/webassembly-runtime-performance -->
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
    <MudAllowedAttributePattern>HTMLAttributes</MudAllowedAttributePattern>
    <MudAllowedAttributeList>Elevation,Title,Id,DropdownWidth,Dense,Checked,T,PanelClass,Image,DisablePadding,AriaLabel,Icon,IsInitiallyExpanded,CheckedChanged,IsExpanded,IsExpandedChanged,OnClick,AccessibleName,AlignItems,LabelPosition,DisableToolbar,Clickable,id,dir,onclick,autocomplete,title,onkeydown,tabindex,rel</MudAllowedAttributeList>
    <!-- Blazor WASM client runtime packages (Microsoft.NET.Sdk.WebAssembly.Pack) track host runtime patch versions,
         making static lock files non-portable across dev and CI runners. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <GeneratedApiClientFile>$(MSBuildProjectDirectory)\Clients\EventApiTagClients.g.cs</GeneratedApiClientFile>
    <GeneratedApiSchemaFile Condition="'$(GeneratedApiSchemaFile)' == ''">$(MSBuildProjectDirectory)/../../schemas/openapi_islamu-event.json</GeneratedApiSchemaFile>
    <GeneratedContractCaptureDirectory>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/generated-contracts', '$(MSBuildProjectDirectory)'))</GeneratedContractCaptureDirectory>
    <CapturedApiClientFile>$(GeneratedContractCaptureDirectory)/EventApiTagClients.g.cs</CapturedApiClientFile>
    <CapturedApiSchemaFile>$(GeneratedContractCaptureDirectory)/openapi_islamu-event.json</CapturedApiSchemaFile>
    <CapturedMutablePolicyFile>$(GeneratedContractCaptureDirectory)/mutable-generated-contracts.txt</CapturedMutablePolicyFile>
    <DotNetToolManifest>$(MSBuildProjectDirectory)\..\..\dotnet-tools.json</DotNetToolManifest>
    <GeneratedRecordMutablePolicy>$(MSBuildProjectDirectory)\..\..\eng\tools\Explore.GeneratedContracts\mutable-generated-contracts.txt</GeneratedRecordMutablePolicy>
    <GeneratedRecordTransformerStamp>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\generated-api-client-records.stamp</GeneratedRecordTransformerStamp>
  </PropertyGroup>

  <Import Project="../../eng/tools/Explore.GeneratedContracts/GeneratedContractTool.targets" />

  <ItemGroup>
    <ProjectReference Include="..\Event.Wire.Contracts\Event.Wire.Contracts.csproj" />
    <TrimmerRootDescriptor Include="EventApiClients.TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.FluentValidation" />
    <PackageReference Include="Blazouter" />
    <PackageReference Include="Blazouter.WebAssembly" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MudBlazor" />
    <!-- Newtonsoft.Json removed: NSwag client + HalResourceExtensions migrated to System.Text.Json -->
    <PackageReference Include="Refit.HttpClientFactory" />
  </ItemGroup>

  <!--
    OpenAPI Client Generation (NSwag)
    ==================================
    WORKFLOW:
    1. Refresh the canonical OpenAPI schema when the backend contract changes
    2. Build Blazor.Client → NSwag regenerates EventApiTagClients.g.cs BEFORE compilation

    KEY DESIGN: Generation happens BEFORE CoreCompile, so:
    - If openapi.json changed, client regenerates first
    - Then compiler sees the fresh generated code
    - You can regenerate even if your other code has build errors

    The openapi.json is checked into source control for CI/CD builds and is not written by API runtime startup.

    To manually regenerate (bypasses build):
      dotnet msbuild -t:GenerateApiClient

    NSwag and all repairs run on private files. Only the completed client is
    atomically published; compilation uses its exact intermediate capture.
    INPUTS/OUTPUTS: MSBuild skips only the completed generation pipeline.
  -->

  <!-- Custom inline task for regex text replacement (avoids PowerShell escaping issues) -->
  <UsingTask TaskName="ReplaceFileText" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFilename ParameterType="System.String" Required="true" />
      <MatchExpression ParameterType="System.String" Required="true" />
      <ReplacementText ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (File.Exists(InputFilename))
        {
            var content = File.ReadAllText(InputFilename);
            var newContent = Regex.Replace(content, MatchExpression, ReplacementText);
            if (content != newContent)
            {
                File.WriteAllText(InputFilename, newContent);
                Log.LogMessage(MessageImportance.High, "Fixed NSwag void returns in {0}", Path.GetFileName(InputFilename));
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <GeneratedRecordTransformerInput Include="$(MSBuildProjectDirectory)\..\..\eng\tools\Explore.GeneratedContracts\*.cs" />
    <GeneratedRecordTransformerInput Include="$(GeneratedContractToolProject)" />
    <GeneratedRecordTransformerInput Include="../../eng/tools/Explore.GeneratedContracts/GeneratedContractTool.targets" />
    <GeneratedRecordTransformerInput Include="$(GeneratedRecordMutablePolicy)" />
  </ItemGroup>

  <!-- NSwag emits per-tag clients and canonical DTOs before repository-owned policy is applied. -->
  <Target Name="GenerateApiClientSource" DependsOnTargets="BuildGeneratedContractTool">
    <PropertyGroup>
      <GeneratedContractStagingDirectory>$(GeneratedContractCaptureDirectory)/staging/$([System.Guid]::NewGuid())</GeneratedContractStagingDirectory>
      <GeneratedApiClientCandidate>$(GeneratedContractStagingDirectory)/EventApiTagClients.g.cs</GeneratedApiClientCandidate>
      <GeneratedApiSchemaCandidate>$(GeneratedContractStagingDirectory)/openapi.json</GeneratedApiSchemaCandidate>
      <GeneratedMutablePolicyCandidate>$(GeneratedContractStagingDirectory)/mutable-generated-contracts.txt</GeneratedMutablePolicyCandidate>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedContractStagingDirectory)" />
    <Copy SourceFiles="$(GeneratedApiSchemaFile);$(GeneratedRecordMutablePolicy)" DestinationFiles="$(GeneratedApiSchemaCandidate);$(GeneratedMutablePolicyCandidate)" />
    <Message Importance="high" Text="NSwag: Preparing API clients privately..." />
    <Exec Command="dotnet nswag run nswag.pertag.json &quot;/variables:SchemaInput=$(GeneratedApiSchemaCandidate),ClientOutput=$(GeneratedApiClientCandidate)&quot;" WorkingDirectory="$(ProjectDir)" ConsoleToMSBuild="true" />
    <Error Condition="!Exists('$(GeneratedApiClientCandidate)')" Text="NSwag completed without producing $(GeneratedApiClientCandidate)." />
  </Target>

  <!-- Fix the NSwag 204-response bug in generated client surfaces. -->
  <Target Name="FixNSwagVoidReturns" DependsOnTargets="GenerateApiClientSource">
    <ReplaceFileText InputFilename="$(GeneratedApiClientCandidate)" MatchExpression="return default\(void\)!;" ReplacementText="return;" />
  </Target>

  <!-- Convert structurally eligible contracts in the generated client. -->
  <Target Name="TransformGeneratedApiClientRecords" DependsOnTargets="FixNSwagVoidReturns">
    <Exec Command="dotnet &quot;$(GeneratedContractToolAssembly)&quot; &quot;$(GeneratedApiClientCandidate)&quot; &quot;$(GeneratedMutablePolicyCandidate)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" />
  </Target>

  <!-- Final byte normalization runs after semantic syntax transformation. -->
  <Target Name="NormalizeGeneratedApiClient"
          DependsOnTargets="TransformGeneratedApiClientRecords">
    <ReplaceFileText InputFilename="$(GeneratedApiClientCandidate)" MatchExpression="[ \t]+(\r?\n)" ReplacementText="$1" />
  </Target>

  <!-- Order solution consumers without changing standalone schema-driven client builds. -->
  <Target Name="BuildApiContractForClient" BeforeTargets="PrepareForBuild" Condition="'$(BuildingSolutionFile)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../Explore.API/Explore.API.csproj" Targets="GetOpenApiContractInput" />
  </Target>

  <Target Name="CheckGeneratedContractCapture" BeforeTargets="PrepareGeneratedApiClient">
    <Error Condition="!Exists('$(GeneratedApiSchemaFile)')" Text="Missing OpenAPI input: $(GeneratedApiSchemaFile)." />
    <GetFileHash Files="$(GeneratedApiSchemaFile)">
      <Output TaskParameter="Hash" PropertyName="SelectedApiSchemaHash" />
    </GetFileHash>
    <GetFileHash Files="$(CapturedApiSchemaFile)" Condition="Exists('$(CapturedApiSchemaFile)')">
      <Output TaskParameter="Hash" PropertyName="CapturedApiSchemaHash" />
    </GetFileHash>
    <Delete Files="$(GeneratedRecordTransformerStamp)" Condition="!Exists('$(GeneratedApiClientFile)') Or !Exists('$(CapturedApiClientFile)') Or !Exists('$(CapturedApiSchemaFile)') Or !Exists('$(CapturedMutablePolicyFile)') Or '$(SelectedApiSchemaHash)' != '$(CapturedApiSchemaHash)'" />
  </Target>

  <Target Name="PrepareGeneratedApiClient"
          Inputs="$(GeneratedApiSchemaFile);nswag.pertag.json;$(DotNetToolManifest);$(MSBuildProjectFullPath);@(GeneratedRecordTransformerInput)"
          Outputs="$(GeneratedRecordTransformerStamp)">
    <CallTarget Targets="CompleteGeneratedApiClient" />
  </Target>

  <Target Name="CompleteGeneratedApiClient" DependsOnTargets="NormalizeGeneratedApiClient">
    <Exec Command="dotnet &quot;$(GeneratedContractToolAssembly)&quot; complete-client &quot;$(GeneratedApiClientCandidate)&quot; &quot;$(GeneratedApiSchemaCandidate)&quot; &quot;$(GeneratedMutablePolicyCandidate)&quot; &quot;$(GeneratedContractCaptureDirectory)&quot; &quot;$(GeneratedApiClientFile)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(GeneratedRecordTransformerStamp)" AlwaysCreate="true" />
    <RemoveDir Directories="$(GeneratedContractStagingDirectory)" />
  </Target>

  <Target Name="GenerateApiClient" BeforeTargets="CoreCompile" DependsOnTargets="PrepareGeneratedApiClient" />

  <Target Name="GetGeneratedContractInputs" Returns="@(GeneratedContractInput)">
    <ItemGroup>
      <GeneratedContractInput Include="$(CapturedApiSchemaFile);$(CapturedApiClientFile);$(CapturedMutablePolicyFile)" />
    </ItemGroup>
    <Error Condition="!Exists('%(GeneratedContractInput.Identity)')" Text="Missing build-captured contract: %(GeneratedContractInput.Identity). Build the client before collecting its inputs." />
  </Target>

  <!-- Exclude generated files from source analysis (they're auto-generated). -->
  <ItemGroup>
    <Compile Remove="Clients\EventApiTagClients.g.cs" />
    <Compile Include="$(CapturedApiClientFile)">
      <AutoGen>true</AutoGen>
      <DependentUpon>nswag.pertag.json</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Blazor WASM Lazy Loading Configuration
       
       IMPLEMENTATION NOTES:
       =====================
       
       To enable lazy loading in Blazor WASM, pages must be in separate class libraries.
       Currently, all pages are compiled into Explore.Blazor.Client.dll.
       
       To implement lazy loading:
       1. Create separate class libraries:
          - Explore.Blazor.Client.Pages.Admin
          - Explore.Blazor.Client.Pages.Onboarding
          - Explore.Blazor.Client.Pages.Organization
       
       2. Move pages to respective libraries:
          - Pages/Admin/* → Explore.Blazor.Client.Pages.Admin/Pages/*
          - Pages/Onboarding/* → Explore.Blazor.Client.Pages.Onboarding/Pages/*
          - Pages/Organization/* → Explore.Blazor.Client.Pages.Organization/Pages/*
       
       3. Add project references to Explore.Blazor.Client:
          <ProjectReference Include="Explore.Blazor.Client.Pages.Admin.csproj" />
          <ProjectReference Include="Explore.Blazor.Client.Pages.Onboarding.csproj" />
          <ProjectReference Include="Explore.Blazor.Client.Pages.Organization.csproj" />
       
       4. Add BlazorWebAssemblyLazyLoad items:
          <BlazorWebAssemblyLazyLoad Include="Explore.Blazor.Client.Pages.Admin.dll" />
          <BlazorWebAssemblyLazyLoad Include="Explore.Blazor.Client.Pages.Onboarding.dll" />
          <BlazorWebAssemblyLazyLoad Include="Explore.Blazor.Client.Pages.Organization.dll" />
       
       5. Update Routes.razor to load assemblies on-demand via ILazyAssemblyLoader
       
       CURRENT STATUS:
       ===============
       - ILazyAssemblyLoader service created and registered
       - Routes.razor updated to call PreloadLazyAssemblies()
       - Ready for library separation when refactoring is planned
       
       BENEFITS:
       =========
       - Reduces initial WASM bundle size by 10-20%
       - Improves Time to Interactive (TTI)
       - Admin/Onboarding/Organization pages load on-demand
       - Core pages (EventList, Home, EventDetail) load immediately
  -->

</Project>
