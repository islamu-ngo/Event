<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>(^|.*[/\\])(Explore|Event)\.[^/\\]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <!-- Match assembly filenames, not test output directories containing production DLLs. -->
        <ModulePath>(^|.*[/\\])[^/\\]*(Tests|Benchmarks|AppHost|GeneratedContracts|AssuranceAudit|\.Migrations\.)[^/\\]*\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[/\\](obj|bin|Migrations|Generated)[/\\].*</Source>
        <Source>.*\.(g|generated|designer)\.cs$</Source>
        <Source>.*ModelSnapshot\.cs$</Source>
        <Source>.*[/\\]Explore\.AppHost[/\\].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
