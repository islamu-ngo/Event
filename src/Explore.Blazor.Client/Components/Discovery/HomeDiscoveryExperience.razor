@using Explore.Blazor.Client.Components.Collection
@using Explore.Blazor.Client.Components.Presentation
@using Explore.Blazor.Client.Contracts.Interop
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Pages.Events.Components
@implements IDisposable
@inject IHomeDiscoveryService HomeDiscoveryService
@inject IHomeDiscoveryGeolocation Geolocation
@inject ITranslationService Translation
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService Focus
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<section class="home-discovery" aria-busy="@_isLoading">
    @if (_isLoading)
    {
        <header class="home-discovery__context home-discovery__context--loading">
            <h1>@T("home.discovery.context.heading", "Browsing events in")</h1>
            <div class="home-discovery__context-skeleton" aria-hidden="true"></div>
        </header>
        <div class="home-discovery__hero-skeleton" aria-hidden="true"></div>
        <section class="home-discovery__section" aria-label="@T("home.discovery.loading", "Loading events")">
            <div class="home-discovery__detailed-grid">
                @for (var index = 0; index < 3; index++)
                {
                    <EventCardSkeleton Layout="LayoutMode.DetailedList" />
                }
            </div>
        </section>
    }
    else if (_discovery is null)
    {
        <header class="home-discovery__context">
            <h1>@T("home.discovery.context.heading", "Browsing events in")</h1>
        </header>
        <div class="home-discovery__failure" role="alert">
            <h2>@T("home.discovery.failure.title", "Events could not be loaded")</h2>
            <p>@T("home.discovery.failure.body", "Try again, or browse the full public event catalog.")</p>
            <div class="home-discovery__actions">
                <button type="button" @onclick="RetryAsync">@T("common.retry", "Try again")</button>
                <a href="/events">@T("home.discovery.browse_all", "Browse all events")</a>
            </div>
        </div>
    }
    else
    {
        <div class="home-discovery__hero">
            <HeroCarousel Events="HeroEvents"
                          RightToLeft="@IsRightToLeft"
                          AriaLabel="@T("home.discovery.hero.label", "Featured events")"
                          PreviousLabel="@T("home.discovery.hero.previous", "Previous featured event")"
                          NextLabel="@T("home.discovery.hero.next", "Next featured event")"
                          ViewEventLabel="@T("home.discovery.view_event", "View event")">
                <HeaderContent>
                    <header class="home-discovery__context">
                        <div class="home-discovery__context-heading" data-testid="home-discovery-context">
                            <h1>@T("home.discovery.context.heading", "Browsing events in")</h1>
                            <div class="home-discovery__context-menu" @onkeydown="HandleContextMenuKeyDownAsync">
                                <button id="home-discovery-context-trigger"
                                        class="home-discovery__context-trigger"
                                        data-testid="home-discovery-context-trigger"
                                        type="button"
                                        disabled="@_isBusy"
                                        aria-expanded="@_isContextMenuOpen.ToString().ToLowerInvariant()"
                                        aria-controls="home-discovery-context-menu"
                                        aria-label="@ContextTriggerLabel"
                                        @onclick="ToggleContextMenu">
                                    <span>@SelectedContextName</span>
                                    <span class="home-discovery__context-chevron" aria-hidden="true"></span>
                                </button>

                                @if (_isContextMenuOpen)
                                {
                                    <div id="home-discovery-context-menu"
                                         class="home-discovery__context-options"
                                         data-testid="home-discovery-context-menu"
                                         aria-label="@T("home.discovery.context.options", "Choose event browsing context")">
                                        @if (HasCentroidAreas)
                                        {
                                            <button class="home-discovery__context-option"
                                                    type="button"
                                                    disabled="@_isBusy"
                                                    @onclick="UseCurrentLocationFromMenuAsync">
                                                <span class="home-discovery__context-icon" aria-hidden="true">
                                                    <MudIcon Icon="@Icons.Material.Outlined.MyLocation" />
                                                </span>
                                                <span>@T("home.discovery.use_location", "Use my current location")</span>
                                            </button>
                                        }
                                        <button class="home-discovery__context-option @(IsOnlineMode ? "home-discovery__context-option--active" : null)"
                                                type="button"
                                                disabled="@(_isBusy || IsOnlineMode)"
                                                aria-current="@(IsOnlineMode ? "true" : null)"
                                                @onclick="BrowseOnlineFromMenuAsync">
                                            <span class="home-discovery__context-icon" aria-hidden="true">
                                                <MudIcon Icon="@Icons.Material.Outlined.Language" />
                                            </span>
                                            <span>@T("home.discovery.browse_online", "Browse online events")</span>
                                        </button>

                                        @if (AvailableAreas.Count > 0)
                                        {
                                            <div class="home-discovery__context-divider" role="separator"></div>
                                            @foreach (var area in AvailableAreas)
                                            {
                                                var isSelected = IsAreaMode && area.Id == _discovery.Context?.SelectedAreaId;
                                                <button class="home-discovery__context-option @(isSelected ? "home-discovery__context-option--active" : null)"
                                                        type="button"
                                                        disabled="@_isBusy"
                                                        aria-current="@(isSelected ? "location" : null)"
                                                        @onclick="() => SelectAreaFromMenuAsync(area.Id!.Value)">
                                                    <span class="home-discovery__context-icon" aria-hidden="true">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" />
                                                    </span>
                                                    <span class="home-discovery__context-option-copy">
                                                        <span>@area.DisplayName</span>
                                                        @if (AreaSecondaryLabel(area) is { } secondaryLabel)
                                                        {
                                                            <span>@secondaryLabel</span>
                                                        }
                                                    </span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_locationStatus))
                        {
                            <p class="home-discovery__location-status" role="status">@_locationStatus</p>
                        }
                    </header>
                </HeaderContent>
            </HeroCarousel>
        </div>

        @if (HeroEvents.Count == 0 && SectionStatus("hero") == HomeDiscoverySectionStatus.Empty)
        {
            <p class="home-discovery__hero-empty" role="status">
                @T("home.discovery.hero.empty", "No featured events match this browsing context yet.")
            </p>
        }

        @if (HeroEvents.Count == 0 && SectionStatus("hero") == HomeDiscoverySectionStatus.Failed)
        {
            <p class="home-discovery__section-failure" role="status">
                @T("home.discovery.hero.failure", "Featured events are temporarily unavailable.")
            </p>
        }

        <section class="home-discovery__section" aria-labelledby="home-upcoming-title">
            <div class="home-discovery__section-heading">
                <h2 id="home-upcoming-title">@UpcomingTitle</h2>
                <a class="home-discovery__section-link"
                   href="/events"
                   aria-label="@T("common.view_all", "View all")"
                   title="@T("common.view_all", "View all")">
                    <span aria-hidden="true">→</span>
                </a>
            </div>
            @if (UpcomingEvents.Count > 0)
            {
                <UpcomingEventList Events="UpcomingEvents"
                                   DateToBeAnnouncedLabel="@T("home.discovery.date_tba", "Date to be announced")"
                                   ViewEventLabel="@T("home.discovery.view_event", "View event")" />
            }
            else
            {
                <p class="home-discovery__empty" role="status">@SectionEmptyMessage("upcoming")</p>
            }
        </section>

        @if (SpotlightEvents.Count > 0)
        {
            <section class="home-discovery__section" aria-labelledby="home-spotlight-title">
                <div class="home-discovery__section-heading">
                    <h2 id="home-spotlight-title">@_discovery.Spotlight!.Label</h2>
                    <a href="/events">@T("common.view_all", "View all")</a>
                </div>
                <div class="home-discovery__single-row">
                    @foreach (var eventItem in SpotlightEvents)
                    {
                        <EventCard @key="eventItem.Id"
                                   Event="eventItem"
                                   Layout="LayoutMode.SingleRow"
                                   OnClick="OpenEvent" />
                    }
                </div>
            </section>
        }

        @if (!IsOnlineMode && IsAreaMode)
        {
            <EventHorizontalRail Title="@MostViewedAreaTitle"
                                 Events="MostViewedAreaEvents"
                                 EmptyMessage="@(SectionEmptyMessage("most-viewed-area"))"
                                 ViewAllLabel="@T("common.view_all", "View all")"
                                 ViewAllUrl="/events?sortBy=views&amp;sortDescending=true"
                                 RightToLeft="@IsRightToLeft"
                                 OnEventClick="OpenEvent" />
        }

        <EventHorizontalRail Title="@T("home.discovery.most_viewed_online", "Most viewed online")"
                             Events="MostViewedOnlineEvents"
                             EmptyMessage="@(SectionEmptyMessage("most-viewed-online"))"
                             ViewAllLabel="@T("common.view_all", "View all")"
                             ViewAllUrl="/events?formatIds=2&amp;sortBy=views&amp;sortDescending=true"
                             RightToLeft="@IsRightToLeft"
                             OnEventClick="OpenEvent" />

        @foreach (var section in CuratedSections)
        {
            <EventHorizontalRail @key="section.Key"
                                 Title="@section.Label"
                                 Events="@Events(section.Items)"
                                 EmptyMessage="@T("home.discovery.empty", "No events are available in this section yet.")"
                                 ViewAllLabel="@T("common.view_all", "View all")"
                                 ViewAllUrl="/events"
                                 RightToLeft="@IsRightToLeft"
                                 OnEventClick="OpenEvent" />
        }

        <EventHorizontalRail Title="@T("home.discovery.recently_added", "Recently added")"
                             Events="RecentlyAddedEvents"
                             EmptyMessage="@(SectionEmptyMessage("recently-added"))"
                             ViewAllLabel="@T("common.view_all", "View all")"
                             ViewAllUrl="/events?sortBy=createdat&amp;sortDescending=true"
                             RightToLeft="@IsRightToLeft"
                             OnEventClick="OpenEvent" />
    }
</section>

@code {
    private HomeDiscoveryDto? _discovery;
    private CancellationTokenSource? _loadCancellation;
    private string? _loadedRequestKey;
    private string? _locationStatus;
    private string? _pendingAnnouncement;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isContextMenuOpen;

    [Parameter] public Guid? UrlAreaId { get; set; }
    [Parameter] public string? UrlMode { get; set; }

    [CascadingParameter] private LanguageContext? LanguageContext { get; set; }

    [PersistentState] public HomeDiscoveryDto? PersistedDiscovery { get; set; }

    private IReadOnlyList<PublicDiscoveryAreaDto> AvailableAreas =>
        _discovery?.Context?.AvailableAreas?
            .Where(area => area.Id.HasValue)
            .OrderBy(area => area.SortOrder)
            .ThenBy(area => area.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private bool HasCentroidAreas => AvailableAreas.Any(area =>
        area.CentroidLatitude.HasValue && area.CentroidLongitude.HasValue);
    private bool IsOnlineMode => _discovery?.Context?.Mode == HomeDiscoveryMode.Online;
    private bool IsAreaMode => _discovery?.Context?.Mode == HomeDiscoveryMode.Area;
    private bool IsRightToLeft => LanguageContext?.EffectiveIsRtl ?? false;
    private string SelectedAreaName => string.IsNullOrWhiteSpace(_discovery?.Context?.SelectedAreaDisplayName)
        ? T("home.discovery.all_areas", "all areas")
        : _discovery.Context.SelectedAreaDisplayName;
    private string SelectedContextName => IsOnlineMode
        ? T("home.discovery.context.online_name", "online events")
        : SelectedAreaName;
    private string ContextTriggerLabel => string.Format(
        T("home.discovery.context.trigger", "Choose event browsing context. Current: {0}"),
        SelectedContextName);
    private string UpcomingTitle => IsAreaMode
        ? string.Format(T("home.discovery.upcoming.area", "Upcoming in {0}"), SelectedAreaName)
        : IsOnlineMode
            ? T("home.discovery.upcoming.online", "Upcoming online")
            : T("home.discovery.upcoming.all", "Upcoming events");
    private string MostViewedAreaTitle =>
        string.Format(T("home.discovery.most_viewed.area", "Most viewed in {0}"), SelectedAreaName);

    private IReadOnlyList<EventListDto> HeroEvents => Events(_discovery?.Hero);
    private IReadOnlyList<EventListDto> UpcomingEvents => Events(_discovery?.UpcomingInArea);
    private IReadOnlyList<EventListDto> SpotlightEvents => Events(_discovery?.Spotlight?.Items);
    private IReadOnlyList<EventListDto> MostViewedAreaEvents => Events(_discovery?.MostViewedInArea);
    private IReadOnlyList<EventListDto> MostViewedOnlineEvents => Events(_discovery?.MostViewedOnline);
    private IReadOnlyList<HomeDiscoverySectionDto> CuratedSections =>
        _discovery?.CuratedSections?.Where(section => !string.IsNullOrWhiteSpace(section.Label)).ToArray() ?? [];
    private IReadOnlyList<EventListDto> RecentlyAddedEvents => Events(_discovery?.RecentlyAdded);

    protected override async Task OnParametersSetAsync()
    {
        var requestKey = $"{UrlAreaId}:{UrlMode?.Trim().ToLowerInvariant()}";
        if (_loadedRequestKey == requestKey)
        {
            return;
        }

        if (_loadedRequestKey is null && PersistedDiscoveryMatchesRequest())
        {
            _discovery = PersistedDiscovery;
            _loadedRequestKey = requestKey;
            _isLoading = false;
            _pendingAnnouncement = T("home.discovery.loaded", "Events loaded");
            return;
        }

        await LoadAsync(requestKey);
    }

    private bool PersistedDiscoveryMatchesRequest()
    {
        if (PersistedDiscovery?.Context is not { } context)
        {
            return false;
        }

        if (UrlAreaId.HasValue && context.SelectedAreaId != UrlAreaId)
        {
            return false;
        }

        return UrlMode?.Trim().ToLowerInvariant() switch
        {
            "area" => context.Mode == HomeDiscoveryMode.Area,
            "online" => context.Mode == HomeDiscoveryMode.Online,
            "all" => context.Mode == HomeDiscoveryMode.All,
            _ => true
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAnnouncement is not { } announcement)
        {
            return;
        }

        _pendingAnnouncement = null;
        await Announcer.AnnouncePoliteAsync(announcement);
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }

    private async Task LoadAsync(string requestKey)
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        var cancellationToken = _loadCancellation.Token;
        _isLoading = true;
        _locationStatus = null;

        try
        {
            var discovery = await HomeDiscoveryService.LoadAsync(UrlAreaId, UrlMode, cancellationToken);
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            _discovery = discovery;
            PersistedDiscovery = discovery;
            _loadedRequestKey = requestKey;
            _pendingAnnouncement = discovery is null
                ? T("home.discovery.failure.announcement", "Events could not be loaded")
                : T("home.discovery.loaded", "Events loaded");
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    private async Task RetryAsync() => await LoadAsync($"{UrlAreaId}:{UrlMode?.Trim().ToLowerInvariant()}");

    private void ToggleContextMenu() => _isContextMenuOpen = !_isContextMenuOpen;

    private async Task HandleContextMenuKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            return;
        }

        _isContextMenuOpen = false;
        await Focus.FocusByIdAsync("home-discovery-context-trigger", true);
    }

    private async Task SelectAreaFromMenuAsync(Guid areaId) =>
        await RunContextActionAsync(() => ApplyAreaAsync(areaId));

    private async Task BrowseOnlineFromMenuAsync() =>
        await RunContextActionAsync(BrowseOnlineAsync);

    private async Task UseCurrentLocationFromMenuAsync() =>
        await RunContextActionAsync(UseCurrentLocationAsync);

    private async Task RunContextActionAsync(Func<Task> action)
    {
        _isContextMenuOpen = false;
        try
        {
            await action();
        }
        finally
        {
            await Focus.FocusByIdAsync("home-discovery-context-trigger", true);
        }
    }

    private async Task ApplyAreaAsync(Guid areaId)
    {
        _isBusy = true;
        try
        {
            var discovery = await HomeDiscoveryService.SelectAreaAsync(areaId, CurrentCancellationToken);
            if (discovery is null)
            {
                _locationStatus = T("home.discovery.area.failure", "That area could not be loaded. Your previous view is unchanged.");
                return;
            }

            await SetDiscoveryAsync(discovery, areaId, "area");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task BrowseOnlineAsync()
    {
        _isBusy = true;
        try
        {
            var areaId = _discovery?.Context?.SelectedAreaId;
            var discovery = await HomeDiscoveryService.SelectOnlineAsync(areaId, CurrentCancellationToken);
            if (discovery is null)
            {
                _locationStatus = T("home.discovery.online.failure", "Online events could not be loaded. Your previous view is unchanged.");
                return;
            }

            await SetDiscoveryAsync(discovery, areaId, "online");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task UseCurrentLocationAsync()
    {
        _isBusy = true;
        _locationStatus = T("home.discovery.location.requesting", "Finding the closest configured event area…");
        try
        {
            var position = await Geolocation.GetCurrentPositionAsync(CurrentCancellationToken);
            if (position.Status == HomeDiscoveryGeolocationStatus.Denied)
            {
                _locationStatus = T("home.discovery.location.denied", "Location permission was denied. Your previous area is unchanged.");
                return;
            }

            if (position.Status != HomeDiscoveryGeolocationStatus.Available ||
                !position.Latitude.HasValue ||
                !position.Longitude.HasValue)
            {
                _locationStatus = T("home.discovery.location.unavailable", "Your location is unavailable. Choose an event area instead.");
                return;
            }

            var area = HomeDiscoveryService.FindClosestArea(
                AvailableAreas,
                position.Latitude.Value,
                position.Longitude.Value);
            if (area?.Id is not { } areaId)
            {
                _locationStatus = T("home.discovery.location.no_areas", "No configured event area can use your location yet.");
                return;
            }

            await ApplyAreaAsync(areaId);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetDiscoveryAsync(HomeDiscoveryDto discovery, Guid? areaId, string mode)
    {
        _discovery = discovery;
        PersistedDiscovery = discovery;
        UrlAreaId = areaId;
        UrlMode = mode;
        _loadedRequestKey = $"{areaId}:{mode}";
        _locationStatus = null;
        await JsRuntime.InvokeVoidAsync(
            "history.replaceState",
            null,
            string.Empty,
            BuildHomeUrl(areaId, mode));
    }

    private void OpenEvent(EventListDto eventItem) =>
        Navigation.NavigateTo(EventUrlHelper.BuildPublicPath(eventItem.Slug, eventItem.PublicCode) ?? "/events");

    private string SectionEmptyMessage(string key) => SectionStatus(key) == HomeDiscoverySectionStatus.Failed
        ? T("home.discovery.section.failure", "This section is temporarily unavailable. Other event sections are still available.")
        : T("home.discovery.empty", "No events are available in this section yet.");

    private HomeDiscoverySectionStatus? SectionStatus(string key) =>
        _discovery?.SectionStatuses?.TryGetValue(key, out var status) == true ? status : null;

    private CancellationToken CurrentCancellationToken => _loadCancellation?.Token ?? CancellationToken.None;

    private string T(string key, string fallback) => Translation.T(key, fallback);

    private static IReadOnlyList<EventListDto> Events(IEnumerable<EventDiscoveryItemDto>? items) =>
        items?.Select(item => item.ToEventListDto()).OfType<EventListDto>().ToArray() ?? [];

    private static string? AreaSecondaryLabel(PublicDiscoveryAreaDto area)
    {
        var city = string.Equals(area.City, area.DisplayName, StringComparison.OrdinalIgnoreCase)
            ? null
            : area.City;
        var label = string.Join(" · ", new[] { city, area.CountryCode }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

        return string.IsNullOrWhiteSpace(label) ? null : label;
    }

    private static string BuildHomeUrl(Guid? areaId, string mode) => areaId.HasValue
        ? $"/home?areaId={areaId.Value}&mode={mode}"
        : $"/home?mode={mode}";
}
