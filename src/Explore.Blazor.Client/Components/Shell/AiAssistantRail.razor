    [JSInvokable]
    public PromptReferenceDeletionResult DeletePromptReferenceFromKeyboard(
        int selectionStart,
        int selectionEnd,
        string key)
    {
        if (ConversationState.SelectedReferences.Count == 0)
        {
            return PromptReferenceDeletionResult.NotHandled(_promptText, selectionStart);
        }

        var deletion = FindReferenceDeletion(selectionStart, selectionEnd, key);
        if (deletion is null)
        {
            return PromptReferenceDeletionResult.NotHandled(_promptText, selectionStart);
        }

        _promptText = _promptText.Remove(deletion.Start, deletion.Length);
        SyncSelectedReferencesWithPromptText();
        UpdateReferenceAutocompleteFromPrompt();
        StateHasChanged();

        return new PromptReferenceDeletionResult(true, _promptText, deletion.Start);
    }

    [JSInvokable]
    public async Task SelectPromptReferenceFromKeyboardAsync()
    {
        if (!IsReferenceAutocompleteVisible || ConversationState.ReferenceResults.Count == 0)
        {
            return;
        }

        _activeReferenceIndex = Math.Clamp(_activeReferenceIndex, 0, ConversationState.ReferenceResults.Count - 1);
        await SelectReferenceAsync(ConversationState.ReferenceResults[_activeReferenceIndex]);
