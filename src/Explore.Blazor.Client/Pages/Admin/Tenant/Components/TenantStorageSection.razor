@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@implements IDisposable
@inject ITenantStorageSettingsAdminService StorageSettingsService

<div class="settings-section tenant-storage-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Object Storage</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Review inherited storage policy and configure tenant-specific limits when platform delegation allows overrides.
        </MudText>
    </div>

    @if (Model.TenantOverridesAllowed != true || Model.TenantStorageLocked == true || Model.IsReadOnly == true)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="tenant-storage-section__alert">
            Storage overrides are read-only for this tenant. The effective provider and quotas below are inherited from platform policy.
        </MudAlert>
    }
    else if (!Model.HasLink("edit"))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="tenant-storage-section__alert">
            Storage settings are visible, but the API response did not include an edit affordance for this session.
        </MudAlert>
    }

    <div class="tenant-storage-section__summary">
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Effective Provider</MudText>
            <MudText Typo="Typo.subtitle1">@StorageProviderOptions.Label(Model.EffectivePolicy?.Provider)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.ProviderSource</MudText>
        </div>
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Max Upload</MudText>
            <MudText Typo="Typo.subtitle1">@FormatBytes(Model.EffectivePolicy?.MaxUploadBytes ?? 0)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.MaxUploadSource</MudText>
        </div>
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Tenant Quota</MudText>
            <MudText Typo="Typo.subtitle1">@FormatBytes(Model.EffectivePolicy?.TenantQuotaBytes ?? 0)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.QuotaSource</MudText>
        </div>
    </div>

    <div class="tenant-storage-section__usage" aria-label="Tenant storage usage">
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Used</MudText>
            <MudText Typo="Typo.h6">@FormatBytes(Model.Usage?.UsedBytes ?? 0)</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Reserved</MudText>
            <MudText Typo="Typo.h6">@FormatBytes(Model.Usage?.ReservedBytes ?? 0)</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Available</MudText>
            <MudText Typo="Typo.h6">@(Model.Usage?.AvailableBytes is long available ? FormatBytes(available) : "Not tracked")</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Objects</MudText>
            <MudText Typo="Typo.h6">@(Model.Usage?.ObjectCount ?? 0)</MudText>
        </div>
    </div>

    <MudStack Spacing="3" Class="tenant-storage-section__form">
        <MudSelect T="string"
                   Label="Tenant Storage Provider"
                   Variant="Variant.Outlined"
                   Value="@Provider"
                   ValueChanged="OnProviderChangedAsync"
                   Disabled="@ControlsDisabled">
            <MudSelectItem T="string" Value="@StorageProviderOptions.Local">Local file storage</MudSelectItem>
            <MudSelectItem T="string" Value="@StorageProviderOptions.S3Compatible">S3-compatible object storage</MudSelectItem>
        </MudSelect>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudNumericField T="long"
                                 Label="Max upload (MB)"
                                 Variant="Variant.Outlined"
                                 Value="@MaxUploadMiB"
                                 ValueChanged="OnMaxUploadChanged"
                                 OnBlur="@(_ => FlushPolicySaveAsync())"
                                 Immediate="true"
                                 Min="1L"
                                 Max="@InstanceMaxUploadMiB"
                                 Disabled="@ControlsDisabled"
                                 HelperText="@($"Platform ceiling: {FormatBytes(Model.EffectivePolicy?.InstanceMaxUploadBytes ?? 0)}")" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="long"
                                 Label="Tenant quota (GB)"
                                 Variant="Variant.Outlined"
                                 Value="@TenantQuotaGiB"
                                 ValueChanged="OnTenantQuotaChanged"
                                 OnBlur="@(_ => FlushPolicySaveAsync())"
                                 Immediate="true"
                                 Min="1L"
                                 Disabled="@ControlsDisabled"
                                 HelperText="Total storage quota for this tenant." />
            </MudItem>
        </MudGrid>

        <MudPaper Class="tenant-storage-section__route-matrix pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Hybrid storage routes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Tenant overrides stay bounded by the platform ceiling and are disabled when storage delegation is locked.
                    </MudText>
                </div>

                @foreach (var route in Model.Routes ?? [])
                {
                    <MudGrid Spacing="3" Class="tenant-storage-section__route-row" aria-label="@($"{StorageRouteOptions.Label(route.RouteKey)} storage route")">
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.subtitle2">@StorageRouteOptions.Label(route.RouteKey)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@StorageRouteOptions.Description(route.RouteKey)</MudText>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string"
                                       Label="@($"{StorageRouteOptions.Label(route.RouteKey)} provider")"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Value="@route.Provider"
                                       ValueChanged="@(value => OnRouteProviderChangedAsync(route, value))"
                                       Disabled="@(ControlsDisabled || route.IsReadOnly == true)">
                                <MudSelectItem T="string" Value="@StorageProviderOptions.Local">Local file storage</MudSelectItem>
                                <MudSelectItem T="string" Value="@StorageProviderOptions.S3Compatible">S3-compatible object storage</MudSelectItem>
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Source: @route.ProviderSource</MudText>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="long"
                                             Label="@($"{StorageRouteOptions.Label(route.RouteKey)} max upload (MB)")"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                              Value="@StorageAdminExtensions.BytesToMiB(route.MaxUploadBytes)"
                                              ValueChanged="@(value => OnRouteMaxUploadChanged(route, value))"
                                              OnBlur="@(_ => FlushPolicySaveAsync())"
                                              Immediate="true"
                                             Min="1L"
                                             Max="@InstanceMaxUploadMiB"
                                             Disabled="@(ControlsDisabled || route.IsReadOnly == true)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Source: @route.MaxUploadSource</MudText>
                        </MudItem>
                    </MudGrid>
                }
            </MudStack>
        </MudPaper>

        @if (Provider == StorageProviderOptions.S3Compatible)
        {
            <div class="tenant-storage-section__provider-panel">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">S3-Compatible Override</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Endpoint"
                                      Variant="Variant.Outlined"
                                      Value="@Model.S3Endpoint"
                                      ValueChanged="OnS3EndpointChanged"
                                      OnBlur="@(_ => FlushS3SaveAsync())"
                                      Immediate="true"
                                      Disabled="@ControlsDisabled"
                                      Placeholder="https://object-storage.example.com" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Public Endpoint"
                                      Variant="Variant.Outlined"
                                      Value="@Model.S3PublicEndpoint"
                                      ValueChanged="OnS3PublicEndpointChanged"
                                      OnBlur="@(_ => FlushS3SaveAsync())"
                                      Immediate="true"
                                      Disabled="@ControlsDisabled"
                                      Placeholder="https://cdn.example.com" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Bucket Name"
                                      Variant="Variant.Outlined"
                                      Value="@Model.S3BucketName"
                                      ValueChanged="OnS3BucketNameChanged"
                                      OnBlur="@(_ => FlushS3SaveAsync())"
                                      Immediate="true"
                                      Disabled="@ControlsDisabled" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Region"
                                      Variant="Variant.Outlined"
                                      Value="@Model.S3Region"
                                      ValueChanged="OnS3RegionChanged"
                                      OnBlur="@(_ => FlushS3SaveAsync())"
                                      Immediate="true"
                                      Disabled="@ControlsDisabled" />
                    </MudItem>
                </MudGrid>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    S3 credentials are managed by the selected external secret authority.
                </MudAlert>

                @if (Model.HasLink("provider-test"))
                {
                    <MudButton Elevation="0"
                               Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@(_isTesting ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.NetworkCheck)"
                               OnClick="TestProviderAsync"
                               Disabled="@(!CanTestProvider)">
                        @(_isTesting ? "Testing..." : "Test Provider")
                    </MudButton>
                }

                <MudSwitch T="bool"
                           Value="@S3ForcePathStyle"
                           ValueChanged="OnS3ForcePathStyleChangedAsync"
                           Color="Color.Primary"
                           Disabled="@ControlsDisabled">
                    Force path-style URLs
                </MudSwitch>

                <MudNumericField T="int"
                                 Label="Upload URL expiration (minutes)"
                                 Variant="Variant.Outlined"
                                 Value="@S3UploadUrlExpirationMinutes"
                                 ValueChanged="OnS3UploadExpirationChanged"
                                 OnBlur="@(_ => FlushS3SaveAsync())"
                                 Immediate="true"
                                 Min="1"
                                 Max="1440"
                                 Disabled="@ControlsDisabled" />

                @if (_testedProviderStatus is not null)
                {
                    <MudAlert Severity="@(_testedProviderStatus.IsAvailable == true ? Severity.Success : Severity.Warning)"
                              Variant="Variant.Outlined"
                              role="status">
                        Provider status: @(_testedProviderStatus.IsAvailable == true ? "available" : "unavailable").
                        @if (!string.IsNullOrWhiteSpace(_testedProviderStatus.Message))
                        {
                            <span>@_testedProviderStatus.Message</span>
                        }
                        @if (_testedProviderStatus.Preflight?.Steps is { Count: > 0 })
                        {
                            <MudStack Spacing="1" Class="mt-2">
                                @foreach (var step in _testedProviderStatus.Preflight.Steps)
                                {
                                    <MudText Typo="Typo.body2">
                                        <strong>@step.StepName:</strong> @step.Status. @step.Message
                                    </MudText>
                                }
                            </MudStack>
                        }
                    </MudAlert>
                }
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                Local file storage is selected for this tenant. Files remain accessible only through metadata-backed API URLs.
            </MudAlert>
        }

        <div role="status" aria-live="polite" aria-atomic="true">@_saveStatusMessage</div>
        <div role="alert">@_saveErrorMessage</div>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public HalResourceOfTenantStorageSettingsDto Model { get; set; } = null!;

    private const int AutosaveDelayMilliseconds = 400;

    private readonly SemaphoreSlim _saveLock = new(1, 1);
    private readonly CancellationTokenSource _lifetimeCts = new();
    private CancellationTokenSource? _policyDebounceCts;
    private CancellationTokenSource? _s3DebounceCts;
    private long _saveVersion;
    private long _policySaveVersion;
    private long _s3SaveVersion;
    private string? _saveStatusMessage;
    private string? _saveErrorMessage;
    private bool _isTesting;
    private InstanceStorageProviderStatusDto? _testedProviderStatus;
    private bool _disposed;

    private bool ControlsDisabled => !Model.IsEditable();
    private bool SavePending => _isTesting
        || _saveLock.CurrentCount == 0
        || _policyDebounceCts is not null
        || _s3DebounceCts is not null;
    private bool CanTestProvider => Model.HasLink("provider-test")
        && !SavePending;

    private string Provider
    {
        get => StorageProviderOptions.Normalize(Model.Provider);
        set => Model.Provider = value;
    }

    private long MaxUploadMiB
    {
        get => StorageAdminExtensions.BytesToMiB(Model.MaxUploadBytes);
        set => Model.MaxUploadBytes = StorageAdminExtensions.MiBToBytes(value);
    }

    private long TenantQuotaGiB
    {
        get => StorageAdminExtensions.BytesToGiB(Model.TenantQuotaBytes);
        set => Model.TenantQuotaBytes = StorageAdminExtensions.GiBToBytes(value);
    }

    private bool S3ForcePathStyle
    {
        get => Model.S3ForcePathStyle ?? true;
        set => Model.S3ForcePathStyle = value;
    }

    private int S3UploadUrlExpirationMinutes
    {
        get => Model.S3UploadUrlExpirationMinutes ?? 60;
        set => Model.S3UploadUrlExpirationMinutes = value;
    }

    private long InstanceMaxUploadMiB =>
        StorageAdminExtensions.BytesToMiB(Model.EffectivePolicy?.InstanceMaxUploadBytes);

    private Task OnProviderChangedAsync(string value)
    {
        if (ControlsDisabled) return Task.CompletedTask;
        Model.Provider = StorageProviderOptions.Normalize(value);
        return SavePolicyImmediatelyAsync();
    }

    private Task OnRouteProviderChangedAsync(Routes2 route, string value)
    {
        if (ControlsDisabled || route.IsReadOnly == true) return Task.CompletedTask;
        route.Provider = StorageProviderOptions.Normalize(value);
        return SavePolicyImmediatelyAsync();
    }

    private void OnMaxUploadChanged(long value)
    {
        if (ControlsDisabled) return;
        MaxUploadMiB = value;
        SchedulePolicySave();
    }

    private void OnTenantQuotaChanged(long value)
    {
        if (ControlsDisabled) return;
        TenantQuotaGiB = value;
        SchedulePolicySave();
    }

    private void OnRouteMaxUploadChanged(Routes2 route, long value)
    {
        if (ControlsDisabled || route.IsReadOnly == true) return;
        route.MaxUploadBytes = StorageAdminExtensions.MiBToBytes(value);
        SchedulePolicySave();
    }

    private void OnS3EndpointChanged(string value) => ChangeS3Text(value, updated => Model.S3Endpoint = updated);
    private void OnS3PublicEndpointChanged(string value) => ChangeS3Text(value, updated => Model.S3PublicEndpoint = updated);
    private void OnS3BucketNameChanged(string value) => ChangeS3Text(value, updated => Model.S3BucketName = updated);
    private void OnS3RegionChanged(string value) => ChangeS3Text(value, updated => Model.S3Region = updated);
    private void ChangeS3Text(string? value, Action<string> apply)
    {
        if (ControlsDisabled) return;
        apply(value ?? string.Empty);
        ScheduleS3Save();
    }

    private Task OnS3ForcePathStyleChangedAsync(bool value)
    {
        if (ControlsDisabled) return Task.CompletedTask;
        Model.S3ForcePathStyle = value;
        return SaveS3ImmediatelyAsync();
    }

    private void OnS3UploadExpirationChanged(int value)
    {
        if (ControlsDisabled) return;
        S3UploadUrlExpirationMinutes = value;
        ScheduleS3Save();
    }

    private Task SavePolicyImmediatelyAsync()
    {
        CancelDebounce(ref _policyDebounceCts);
        return SavePolicyAsync(BeginSave(), _lifetimeCts.Token);
    }

    private Task SaveS3ImmediatelyAsync()
    {
        CancelDebounce(ref _s3DebounceCts);
        return SaveS3Async(BeginSave(), _lifetimeCts.Token);
    }

    private long BeginSave()
    {
        _saveStatusMessage = "Saving storage settings...";
        _saveErrorMessage = null;
        return ++_saveVersion;
    }

    private async Task SavePolicyAsync(long version, CancellationToken cancellationToken) =>
        await SaveAsync(() => StorageSettingsService.PatchPolicyAsync(Model, cancellationToken), version, cancellationToken);

    private async Task SaveS3Async(long version, CancellationToken cancellationToken) =>
        await SaveAsync(() => StorageSettingsService.PatchS3Async(Model, cancellationToken), version, cancellationToken);

    private async Task TestProviderAsync()
    {
        if (!CanTestProvider) return;

        _isTesting = true;
        _saveStatusMessage = "Testing storage provider...";
        _saveErrorMessage = null;
        try
        {
            _testedProviderStatus = await StorageSettingsService.TestProviderAsync(Model, _lifetimeCts.Token);
            if (_testedProviderStatus.IsAvailable == true)
            {
                _saveStatusMessage = _testedProviderStatus.Message ?? "Storage provider test passed.";
            }
            else
            {
                _saveStatusMessage = null;
                _saveErrorMessage = _testedProviderStatus.Message ?? "Storage provider test failed.";
            }
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task SaveAsync(
        Func<Task<BaseCommandResponseOfGuid>> save,
        long version,
        CancellationToken cancellationToken)
    {
        var lockTaken = false;
        try
        {
            await _saveLock.WaitAsync(cancellationToken);
            lockTaken = true;
            BaseCommandResponseOfGuid response = await save();
            if (_disposed || version != _saveVersion) return;

            if (response.Success == true)
            {
                _saveStatusMessage = "Storage settings saved.";
                _saveErrorMessage = null;
            }
            else
            {
                _saveStatusMessage = null;
                _saveErrorMessage = response.Message ?? "Storage settings could not be saved.";
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (!_disposed && version == _saveVersion)
            {
                _saveStatusMessage = null;
                _saveErrorMessage = "Storage settings could not be saved.";
            }
        }
        finally
        {
            if (lockTaken) _saveLock.Release();
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private void SchedulePolicySave()
    {
        CancelDebounce(ref _policyDebounceCts);
        _policyDebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _policySaveVersion = BeginSave();
        _ = RunPolicyDebounceAsync(_policyDebounceCts, _policySaveVersion);
    }

    private async Task RunPolicyDebounceAsync(CancellationTokenSource source, long version)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, source.Token);
            if (ReferenceEquals(_policyDebounceCts, source)) _policyDebounceCts = null;
            await SavePolicyAsync(version, source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
        }
        finally
        {
            source.Dispose();
        }
    }

    private Task FlushPolicySaveAsync()
    {
        if (_policyDebounceCts is null) return Task.CompletedTask;
        long version = _policySaveVersion;
        CancelDebounce(ref _policyDebounceCts);
        return SavePolicyAsync(version, _lifetimeCts.Token);
    }

    private void ScheduleS3Save()
    {
        CancelDebounce(ref _s3DebounceCts);
        _s3DebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _s3SaveVersion = BeginSave();
        _ = RunS3DebounceAsync(_s3DebounceCts, _s3SaveVersion);
    }

    private async Task RunS3DebounceAsync(CancellationTokenSource source, long version)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, source.Token);
            if (ReferenceEquals(_s3DebounceCts, source)) _s3DebounceCts = null;
            await SaveS3Async(version, source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
        }
        finally
        {
            source.Dispose();
        }
    }

    private Task FlushS3SaveAsync()
    {
        if (_s3DebounceCts is null) return Task.CompletedTask;
        long version = _s3SaveVersion;
        CancelDebounce(ref _s3DebounceCts);
        return SaveS3Async(version, _lifetimeCts.Token);
    }

    private static void CancelDebounce(ref CancellationTokenSource? source)
    {
        CancellationTokenSource? pending = source;
        source = null;
        pending?.Cancel();
    }

    private static string ConfiguredText(bool? configured, string label) =>
        configured == true ? $"An existing {label} is configured. Leave blank to keep it." : string.Empty;

    private static string FormatBytes(long bytes)
    {
        const double oneKiB = 1024d;
        string[] units = ["bytes", "KB", "MB", "GB", "TB"];
        var value = (double)Math.Max(0, bytes);
        var unit = 0;
        while (value >= oneKiB && unit < units.Length - 1)
        {
            value /= oneKiB;
            unit++;
        }

        return unit == 0 ? $"{value:0} {units[unit]}" : $"{value:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetimeCts.Cancel();
        CancelDebounce(ref _policyDebounceCts);
        CancelDebounce(ref _s3DebounceCts);
        _lifetimeCts.Dispose();
    }
}
