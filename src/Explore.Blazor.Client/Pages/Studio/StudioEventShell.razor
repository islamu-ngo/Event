@page "/studio/events/{EventId:guid}"
@page "/studio/events/{EventId:guid}/schedule"
@page "/studio/events/{EventId:guid}/registration"
@page "/studio/events/{EventId:guid}/tickets"
@page "/studio/events/{EventId:guid}/promotions"
@page "/studio/events/{EventId:guid}/orders"
@page "/studio/events/{EventId:guid}/integrations"
@page "/studio/events/{EventId:guid}/forms"
@page "/studio/events/{EventId:guid}/analytics"
@page "/studio/events/{EventId:guid}/publication"
@using Blazouter.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouterStateService RouterState
@inject NavigationManager Navigation
@inject StudioEventContextState EventContext

<PageTitle>@(Resource?.Title ?? "Studio Event")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="studio-event-shell">
    @if (EventContext.IsLoading && Resource is null)
    {
        <section class="studio-event-shell__state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">Loading event…</MudText>
        </section>
    }
    else if (Resource is null)
    {
        <section class="studio-event-shell__state" role="alert">
            <MudText Typo="Typo.h4" HtmlTag="h1">Event unavailable</MudText>
            <MudText Typo="Typo.body1">@(EventContext.ErrorMessage ?? "This event could not be loaded.")</MudText>
            <AppButton Href="/studio/events" Variant="Variant.Outlined">All events</AppButton>
        </section>
    }
    else
    {
        <header class="studio-event-shell__header">
            <div>
                <MudText Typo="Typo.h4" HtmlTag="h1">@Resource.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Resource.EventStatusFullName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Resource.EventStatusFullName</MudText>
                }
            </div>
        </header>

        <section class="studio-event-shell__section" aria-labelledby="studio-event-section-title">
            <MudText Id="studio-event-section-title" Typo="Typo.h5" HtmlTag="h2">@SectionTitle</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@SectionDescription</MudText>
            @if (Section == "tickets")
            {
                @if (!CanManageTickets)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="ticketing-route-unavailable">
                        Ticket catalog management is not available for this event.
                    </div>
                }
                else
                {
                    <EventTicketCatalogEditor EventId="EventId"
                                              CanManageTicketTypes="CanManageTicketTypes"
                                              CanManageCapacityPools="CanManageCapacityPools" />
                }
            }
            else if (Section == "registration")
            {
                @if (!CanConfigureParticipation)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="participation-route-unavailable">
                        Participation configuration is not available for this event.
                    </div>
                }
                else if (Resource.ParticipationConfiguration is null)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="participation-configuration-missing">
                        The current participation configuration could not be loaded. Refresh and try again.
                    </div>
                }
                else
                {
                    <ParticipationConfigurationEditor EventId="EventId"
                                                      Configuration="Resource.ParticipationConfiguration"
                                                      OnSaved="ReloadEventAsync" />
                }
            }
            else if (Section == "orders")
            {
                @if (!CanViewOrders)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="orders-route-unavailable">
                        Registration orders are not available for this event.
                    </div>
                }
                else
                {
                    <StudioOrderList EventId="EventId" />
                }
            }
            else if (Section == "promotions")
            {
                <StudioEventPromotions EventId="EventId" />
            }
            else if (Section == "forms")
            {
                @if (!CanManageRegistrationWorkflow)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="registration-forms-route-unavailable">
                        Registration form management is not available for this event.
                    </div>
                }
                else
                {
                    <Explore.Blazor.Client.Pages.Studio.RegistrationForms.RegistrationFormBuilder EventId="EventId" />
                }
            }
            else if (Section == "analytics")
            {
                @if (!CanViewRegistrationAnalytics)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="registration-analytics-route-unavailable">
                        Registration analytics are not available for this event.
                    </div>
                }
                else
                {
                    <StudioRegistrationAnalytics EventId="EventId" AnalyticsLink="AnalyticsLink" />
                }
            }
            else if (Section == "integrations")
            {
                @if (!CanViewIntegrations)
                {
                    <div class="studio-event-shell__state" role="alert" data-testid="integrations-route-unavailable">
                        Registration provider integrations are not available for this event.
                    </div>
                }
                else
                {
                    <StudioEventIntegrations Event="Resource" />
                }
            }
            else
            {
                <div class="studio-event-shell__actions">
                    @if (Section == "schedule" && CanAddSession)
                    {
                        <AppButton Href="@($"/events/{EventId}/sessions/create")" StartIcon="@Icons.Material.Filled.Add">Add session</AppButton>
                    }
                    @if (Resource.HasHalLink("edit"))
                    {
                        <AppButton Href="@($"/events/{EventId}/edit")" Variant="Variant.Outlined">Open event editor</AppButton>
                    }
                </div>
            }
        </section>
    }
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventDto? Resource => EventContext.EventId == EventId ? EventContext.Event : null;
    private string Section => ResolveSection();
    private string SectionTitle => Section switch
    {
        "schedule" => "Schedule",
        "registration" => "Registration",
        "tickets" => "Tickets",
        "promotions" => "Promotions",
        "orders" => "Orders",
        "integrations" => "Integrations",
        "forms" => "Forms",
        "analytics" => "Analytics",
        "publication" => "Publication",
        _ => "Details"
    };
    private string SectionDescription => Section switch
    {
        "schedule" => "Manage this event's sessions in the existing event editor.",
        "registration" => "Define how people participate, whether advance registration applies, and which identity options are available.",
        "tickets" => "Define ticket types, shared capacity pools, prices, limits, and admission entitlements.",
        "promotions" => "Create and manage event promotion codes when the server advertises the required affordances.",
        "orders" => "Review registration order status and server-calculated commercial snapshots.",
        "integrations" => "Connect registration providers, monitor health, and reconcile provider submissions.",
        "forms" => "Author versioned registration questions, conditional rules, and publication readiness.",
        "analytics" => "Review privacy-bounded aggregates for governed registration answers.",
        "publication" => "Review and edit publication details in the existing event editor.",
        _ => "Edit this event using the existing event editor."
    };
    private bool CanAddSession => Resource?.HasHalLink("add-session") == true
        || Resource?.HasHalLink("create-session-draft") == true;
    private bool CanConfigureParticipation => Resource?.HasHalLink("configure-participation") == true;
    private bool CanManageTicketTypes => Resource?.HasHalLink("manage-ticket-types") == true;
    private bool CanManageCapacityPools => Resource?.HasHalLink("manage-capacity-pools") == true;
    private bool CanManageTickets => CanManageTicketTypes || CanManageCapacityPools;
    private bool CanViewOrders => Resource?.HasHalLink("view-registration-orders") == true;
    private bool CanViewIntegrations => Resource?.HasHalLink("manage-registration-channels") == true
        || Resource?.HasHalLink("view-registration-provider-health") == true;
    private bool CanManageRegistrationWorkflow => Resource?.HasHalLink("manage-registration-workflow") == true;
    private bool CanViewRegistrationAnalytics => Resource?.HasHalLink("view-registration-analytics") == true;
    private HalLink? AnalyticsLink => Resource is null
        ? null
        : Explore.Blazor.Client.Pages.Studio.RegistrationForms.RegistrationFormHal.Link(Resource.AdditionalProperties, "view-registration-analytics");

    protected override async Task OnParametersSetAsync()
    {
        if (EventId == Guid.Empty
            && Guid.TryParse(RouterState.GetParam("eventId"), out var routeEventId))
        {
            EventId = routeEventId;
        }

        if (EventId != Guid.Empty)
        {
            await EventContext.LoadAsync(EventId);
        }
    }

    private string ResolveSection()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return path.EndsWith("/schedule", StringComparison.OrdinalIgnoreCase) ? "schedule"
            : path.EndsWith("/registration", StringComparison.OrdinalIgnoreCase) ? "registration"
            : path.EndsWith("/tickets", StringComparison.OrdinalIgnoreCase) ? "tickets"
            : path.EndsWith("/promotions", StringComparison.OrdinalIgnoreCase) ? "promotions"
            : path.EndsWith("/orders", StringComparison.OrdinalIgnoreCase) ? "orders"
            : path.EndsWith("/integrations", StringComparison.OrdinalIgnoreCase) ? "integrations"
            : path.EndsWith("/forms", StringComparison.OrdinalIgnoreCase) ? "forms"
            : path.EndsWith("/analytics", StringComparison.OrdinalIgnoreCase) ? "analytics"
            : path.EndsWith("/publication", StringComparison.OrdinalIgnoreCase) ? "publication"
            : "details";
    }

    private async Task ReloadEventAsync()
    {
        await EventContext.ReloadAsync(EventId);
    }

}
