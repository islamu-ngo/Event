@implements IAsyncDisposable

@if (_slides.Count > 0 || HeaderContent is not null)
{
    <section class="hero-carousel @(_slides.Count == 0 ? "hero-carousel--empty" : null)"
             data-testid="hero-carousel"
             role="@(_slides.Count > 0 ? "region" : null)"
             aria-roledescription="@(_slides.Count > 0 ? "carousel" : null)"
             aria-label="@AriaLabel"
             dir="@(RightToLeft ? "rtl" : "ltr")"
             @onpointerdown="HandlePointerDown"
             @onpointerup="HandlePointerUp"
             @onpointercancel="ClearPointer">
        @if (_slides.Count == 0 && HeaderContent is not null)
        {
            <div class="hero-carousel__inner hero-carousel__inner--empty">
                <div class="hero-carousel__header">
                    @HeaderContent
                </div>
            </div>
        }
        else
        {
            @if (HeaderContent is not null)
            {
                <div class="hero-carousel__persistent-header">
                    <div class="hero-carousel__persistent-header-inner">
                        <div class="hero-carousel__header">
                            @HeaderContent
                        </div>
                    </div>
                </div>
            }
            <div class="hero-carousel__viewport">
            @for (var index = 0; index < _slides.Count; index++)
            {
                var slide = _slides[index];
                var actorProfileUrl = GetActorProfileUrl(slide);
                var externalEventUrl = GetExternalEventUrl(slide);
                var isActive = index == _selectedIndex;
                var isLeaving = _leavingIndex == index;
                var isIncoming = _incomingIndex == index;
                var isVisible = isActive || isLeaving || isIncoming;
                var transitionDirection = _transitionDirection > 0
                    ? "hero-carousel__slide--forward"
                    : "hero-carousel__slide--backward";
                var slideClasses = "hero-carousel__slide " +
                    (isLeaving
                        ? $"hero-carousel__slide--leaving {transitionDirection}"
                        : isIncoming
                            ? $"hero-carousel__slide--incoming {transitionDirection}"
                            : isActive
                                ? "hero-carousel__slide--active"
                                : string.Empty);

                <article class="@slideClasses"
                              data-testid="hero-slide"
                              role="group"
                              aria-roledescription="slide"
                              aria-label="@(index + 1) of @_slides.Count"
                              aria-hidden="@(!isActive)"
                              hidden="@(!isVisible)">
                        <div class="hero-carousel__visual" aria-hidden="true">
                            <img class="hero-carousel__backdrop"
                                 src="@GetImageSource(slide, index)"
                                 alt=""
                                 width="1600"
                                 height="900"
                                 loading="@(isActive ? "eager" : "lazy")"
                                 fetchpriority="@(isActive ? "high" : "low")"
                                 decoding="async"
                                 @onerror="() => HandleImageError(index)" />
                            <div class="hero-carousel__scrim"></div>
                        </div>
                        @if (GetEventUrl(slide) is { } slideUrl)
                        {
                            <a class="hero-carousel__slide-link"
                               href="@slideUrl"
                               aria-label="@GetEventLinkLabel(slide)"></a>
                        }
                        <div class="hero-carousel__inner @(HeaderContent is not null ? "hero-carousel__inner--with-header" : null)">
                            <div class="hero-carousel__poster-frame">
                                <img class="hero-carousel__poster-image"
                                     src="@GetImageSource(slide, index)"
                                     alt="@GetPosterAlt(slide)"
                                     width="350"
                                     height="500"
                                     loading="@(isActive ? "eager" : "lazy")"
                                     fetchpriority="@(isActive ? "high" : "low")"
                                     decoding="async"
                                     @onerror="() => HandleImageError(index)" />
                            </div>
                            <div class="hero-carousel__content @(externalEventUrl is not null ? "hero-carousel__content--with-external-link" : null)">
                                @if (externalEventUrl is not null)
                                {
                                    <a class="hero-carousel__external-link"
                                       href="@externalEventUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="@GetExternalEventLinkLabel(slide)"
                                       @onclick:stopPropagation="true"
                                       @onkeydown:stopPropagation="true">
                                        <span>Open</span>
                                        <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-hidden="true" />
                                    </a>
                                }
                                <h2 class="hero-carousel__title">@slide.Title</h2>
                                <div class="hero-carousel__badges" aria-label="Event classifications">
                                    @foreach (var badge in GetBadges(slide))
                                    {
                                        <span class="hero-carousel__badge">@badge.ToUpperInvariant()</span>
                                    }
                                </div>
                                <p class="hero-carousel__metadata">@GetMetadata(slide)</p>
                                @if (!string.IsNullOrWhiteSpace(slide.Description))
                                {
                                    <p class="hero-carousel__description">@slide.Description</p>
                                }
                                @if (actorProfileUrl is not null && !string.IsNullOrWhiteSpace(slide.ActorDisplayName))
                                {
                                    <a class="hero-carousel__actor-link"
                                       href="@actorProfileUrl"
                                       aria-label="@($"View {slide.ActorDisplayName}'s profile")"
                                       @onclick:stopPropagation="true"
                                       @onkeydown:stopPropagation="true">
                                        @if (!string.IsNullOrWhiteSpace(slide.ActorProfilePictureUri))
                                        {
                                            <img class="hero-carousel__actor-image"
                                                 src="@slide.ActorProfilePictureUri"
                                                 alt=""
                                                 width="32"
                                                 height="32"
                                                 loading="lazy"
                                                 decoding="async" />
                                        }
                                        else
                                        {
                                            <span class="hero-carousel__actor-fallback" aria-hidden="true">
                                                @slide.ActorDisplayName.Trim()[0]
                                            </span>
                                        }
                                        <span class="hero-carousel__actor-name">@slide.ActorDisplayName</span>
                                    </a>
                                }
                            </div>
                        </div>
                </article>
            }
            </div>
        }

        @if (_slides.Count > 1)
        {
            <div class="hero-carousel__controls">
                <span class="hero-carousel__counter"
                      data-testid="hero-counter"
                      aria-live="polite"
                      aria-label="@($"{_selectedIndex + 1} of {_slides.Count}")">
                    NO. @(_selectedIndex + 1)
                </span>
                <button class="hero-carousel__control"
                        type="button"
                        aria-label="@PreviousLabel"
                        disabled="@_isTransitioning"
                        @onclick="ShowPreviousAsync">
                    <span aria-hidden="true">‹</span>
                </button>
                <button class="hero-carousel__control"
                        type="button"
                        aria-label="@NextLabel"
                        disabled="@_isTransitioning"
                        @onclick="ShowNextAsync">
                    <span aria-hidden="true">›</span>
                </button>
            </div>
        }
    </section>
}

@code {
    private const string DefaultPlaceholderImage = "https://placeholder.islamu.org/event-default.jpg";
    private const int SlideTransitionMilliseconds = 300;
    private const double SwipeThreshold = 48;
    private static readonly TimeSpan AutoplayInterval = TimeSpan.FromSeconds(9);
    private IReadOnlyList<EventListDto> _slides = [];
    private readonly CancellationTokenSource _autoplayCancellation = new();
    private readonly HashSet<int> _failedImages = [];
    private Task? _autoplayTask;
    private int _selectedIndex;
    private int? _leavingIndex;
    private int? _incomingIndex;
    private int _transitionDirection = 1;
    private bool _isTransitioning;
    private double? _pointerStartX;

    [Parameter] public IEnumerable<EventListDto> Events { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "Featured events";
    [Parameter] public string PreviousLabel { get; set; } = "Previous featured event";
    [Parameter] public string NextLabel { get; set; } = "Next featured event";
    [Parameter] public string ViewEventLabel { get; set; } = "View event";
    [Parameter] public bool RightToLeft { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    protected override void OnParametersSet()
    {
        _slides = Events.Take(10).ToArray();
        _selectedIndex = _slides.Count == 0 ? 0 : Math.Min(_selectedIndex, _slides.Count - 1);
        _failedImages.RemoveWhere(index => index >= _slides.Count);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_autoplayTask is null && _slides.Count > 1)
            _autoplayTask = AutoplayAsync(_autoplayCancellation.Token);

        return Task.CompletedTask;
    }

    private Task ShowPreviousAsync() => TransitionToAsync(-1);

    private Task ShowNextAsync() => TransitionToAsync(1);

    private async Task AutoplayAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(AutoplayInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(ShowNextAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task TransitionToAsync(int direction)
    {
        if (_isTransitioning || _slides.Count < 2)
            return;

        var nextIndex = (_selectedIndex + direction + _slides.Count) % _slides.Count;
        _leavingIndex = _selectedIndex;
        _incomingIndex = nextIndex;
        _selectedIndex = nextIndex;
        _transitionDirection = direction;
        _isTransitioning = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(SlideTransitionMilliseconds, _autoplayCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _leavingIndex = null;
        _incomingIndex = null;
        _isTransitioning = false;
        await InvokeAsync(StateHasChanged);
    }

    private void HandlePointerDown(PointerEventArgs args)
    {
        if (args.IsPrimary)
            _pointerStartX = args.ClientX;
    }

    private async Task HandlePointerUp(PointerEventArgs args)
    {
        if (!_pointerStartX.HasValue || !args.IsPrimary)
            return;

        var distance = args.ClientX - _pointerStartX.Value;
        _pointerStartX = null;

        if (Math.Abs(distance) < SwipeThreshold)
            return;

        var swipedForward = RightToLeft ? distance > 0 : distance < 0;
        if (swipedForward)
            await ShowNextAsync();
        else
            await ShowPreviousAsync();
    }

    private void ClearPointer() => _pointerStartX = null;

    private void HandleImageError(int index) => _failedImages.Add(index);

    private string GetImageSource(EventListDto slide, int index) =>
        _failedImages.Contains(index) ||
        string.IsNullOrWhiteSpace(slide.FeaturedImageUri) ||
        string.Equals(slide.FeaturedImageUri, DefaultPlaceholderImage, StringComparison.OrdinalIgnoreCase)
            ? ImageHelper.GetEventImageUrl(null, slide.Title, GetEventColor(slide), width: 300, height: 400)
            : slide.FeaturedImageUri;

    private static string GetEventColor(EventListDto slide)
    {
        var color = EventColorHelper.GetColorByTypeId(slide.EventTypeId);
        return color == EventColorHelper.DefaultColor
            ? EventColorHelper.GetColorByHash(slide.Title)
            : color;
    }

    private static IEnumerable<string> GetBadges(EventListDto slide)
    {
        if (!string.IsNullOrWhiteSpace(slide.EventTypeFullName))
            yield return slide.EventTypeFullName;

        if (!string.IsNullOrWhiteSpace(slide.EventFormatFullName) &&
            !string.Equals(slide.EventFormatFullName, slide.EventTypeFullName, StringComparison.OrdinalIgnoreCase))
        {
            yield return slide.EventFormatFullName;
        }
    }

    private static string GetMetadata(EventListDto slide)
    {
        return slide.FirstSessionDate?.ToString("ddd, MMM d") ?? "Date to be announced";
    }

    private static string GetPosterAlt(EventListDto slide) => $"Poster for {slide.Title}";

    private string GetEventLinkLabel(EventListDto slide) => slide.IsFederatedDiscoveryEvent()
        ? slide.GetHalHref("source") is null
            ? $"AT Protocol event: {slide.Title}"
            : $"View AT Protocol source: {slide.Title}"
        : $"{ViewEventLabel}: {slide.Title}";

    private static string? GetEventUrl(EventListDto slide) => slide.IsFederatedDiscoveryEvent()
        ? slide.GetHalHref("source")
        : EventUrlHelper.BuildPublicPath(slide.Slug, slide.PublicCode) ?? "/events";

    private static string? GetExternalEventUrl(EventListDto slide) =>
        slide.IsFederatedDiscoveryEvent() ? slide.GetHalHref("source") : null;

    private static string GetExternalEventLinkLabel(EventListDto slide) =>
        $"Open {slide.Title} on its external platform in a new tab";

    private static string? GetActorProfileUrl(EventListDto slide)
    {
        if (slide.ActorId is not Guid actorId)
            return null;

        return slide.ActorTypeId switch
        {
            2 => $"/organization/profile/{actorId}",
            4 => $"/group/profile/{actorId}",
            _ => null
        };
    }

    public ValueTask DisposeAsync()
    {
        _autoplayCancellation.Cancel();
        _autoplayCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
