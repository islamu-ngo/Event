@using Explore.Blazor.Client.Helpers
@inject IRegistrationPaymentService RegistrationPaymentService
@inject IDialogService Dialogs
@implements IDisposable

@if (_payment is not null)
{
    <section class="studio-payment-status @(IsAttention ? "studio-payment-status--attention" : null)"
             aria-labelledby="@HeadingId"
             role="@(IsAttention ? "alert" : null)"
             data-testid="studio-payment-status">
        <MudText Id="@HeadingId" Typo="Typo.subtitle2" HtmlTag="h4">Payment</MudText>
        <dl class="studio-payment-status__facts" dir="auto">
            <div>
                <dt>Status</dt>
                <dd class="studio-payment-status__status">
                    @if (IsAttention)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" aria-hidden="true" />
                    }
                    <span>@(_payment.StatusName ?? _payment.StatusCode ?? "Unknown")</span>
                </dd>
            </div>
            @if (_payment.LastUpdatedAt is { } updated)
            {
                <div><dt>Last updated</dt><dd>@updated.ToLocalTime().ToString("g")</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(_payment.FailureCode))
            {
                <div><dt>Reconciliation outcome</dt><dd>@BoundedOutcome(_payment.FailureCode)</dd></div>
            }
        </dl>

        @if (_payment.Refunds is { Count: > 0 })
        {
            <section aria-labelledby="@RefundHeadingId" class="studio-payment-status__refunds">
                <MudText Id="@RefundHeadingId" Typo="Typo.subtitle2" HtmlTag="h5">Refunds</MudText>
                <ul>
                    @foreach (RegistrationRefundDto refund in _payment.Refunds)
                    {
                        <li data-testid="studio-refund-status">
                            <span>@refund.StatusName</span>
                            <span>@RegistrationOrderMoneyFormatter.Format(refund.AmountMinor ?? 0, refund.CurrencyCode ?? _payment.CurrencyCode)</span>
                            @if (!string.IsNullOrWhiteSpace(refund.FailureCode))
                            {
                                <span>Attention required (@refund.FailureCode)</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (_payment.Disputes is { Count: > 0 })
        {
            <section aria-labelledby="@DisputeHeadingId" class="studio-payment-status__disputes">
                <MudText Id="@DisputeHeadingId" Typo="Typo.subtitle2" HtmlTag="h5">Disputes</MudText>
                <ul>
                    @foreach (RegistrationPaymentDisputeDto dispute in _payment.Disputes)
                    {
                        <li data-testid="studio-dispute-status">
                            @dispute.StageCode — @dispute.StatusCode
                            @if (dispute.StatusCode == "Open" && dispute.ResponseDueAt is { } dueAt)
                            {
                                <span>Respond by @dueAt.ToLocalTime().ToString("g")</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (_payment._links?.ContainsKey("create-refund") == true)
        {
            <AppButton Variant="Variant.Outlined" Disabled="_isRefunding" OnClick="CreateRefundAsync" data-testid="studio-create-refund">
                Refund remaining amount
            </AppButton>
        }
        @if (_payment._links?.ContainsKey("retry-refund") == true)
        {
            <AppButton Variant="Variant.Outlined" Disabled="_isRefunding" OnClick="RetryRefundAsync" data-testid="studio-retry-refund">
                Retry refund settlement
            </AppButton>
        }
        @if (_actionMessage is not null)
        {
            <div class="studio-payment-status__action-message" role="@(_actionFailed ? "alert" : "status")" aria-live="@(_actionFailed ? "assertive" : "polite")" tabindex="-1">@_actionMessage</div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid EventId { get; set; }
    [Parameter, EditorRequired] public HalResourceOfRegistrationOrderDto Order { get; set; } = default!;

    private CancellationTokenSource? _requestCancellation;
    private HalResourceOfRegistrationPaymentDto? _payment;
    private long _loadGeneration;
    private bool _disposed;
    private bool _isRefunding;
    private string? _actionMessage;
    private bool _actionFailed;
    private string HeadingId => $"studio-payment-status-heading-{Order.Id:N}";
    private string RefundHeadingId => $"studio-payment-refunds-heading-{Order.Id:N}";
    private string DisputeHeadingId => $"studio-payment-disputes-heading-{Order.Id:N}";
    private bool IsAttention => string.Equals(_payment?.StatusCode, "NeedsReconciliation", StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        CancelPendingRequest();
        long generation = ++_loadGeneration;
        Guid eventId = EventId;
        Guid? orderId = Order.Id;
        bool hasRelation = Order._links?.ContainsKey("studio-payment-status") == true;
        _payment = null;
        if (orderId is null || !hasRelation)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _requestCancellation = cancellation;
        try
        {
            HalResourceOfRegistrationPaymentDto? payment = await RegistrationPaymentService.GetStudioPaymentAsync(
                eventId, orderId.Value, Order, cancellation.Token);
            if (_disposed || cancellation.IsCancellationRequested || generation != _loadGeneration ||
                EventId != eventId || Order.Id != orderId || Order._links?.ContainsKey("studio-payment-status") != true)
            {
                return;
            }

            _payment = payment;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_requestCancellation, cancellation))
            {
                _requestCancellation = null;
            }
            cancellation.Dispose();
        }
    }

    private static string BoundedOutcome(string failureCode) => failureCode.ToUpperInvariant() switch
    {
        "PAYMENT_RETRY_NOT_AVAILABLE" => "Retry is not available",
        "PAYMENT_START_FAILED" => "Payment could not be started",
        _ => "Review required"
    };

    private async Task CreateRefundAsync()
    {
        if (_payment?._links?.ContainsKey("create-refund") != true || Order.Id is not { } orderId || _isRefunding)
        {
            return;
        }

        long remaining = Math.Max(0, (_payment.CapturedAmountMinor ?? 0) -
            (_payment.RefundedAmountMinor ?? 0) - (_payment.RefundPendingAmountMinor ?? 0));
        bool? confirmed = await Dialogs.ShowMessageBoxAsync(
            "Confirm refund",
            $"Refund the remaining {RegistrationOrderMoneyFormatter.Format(remaining, _payment.CurrencyCode)}? Provider confirmation may take time.",
            yesText: "Create refund",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isRefunding = true;
        _actionMessage = null;
        try
        {
            HalResourceOfRegistrationPaymentDto? refreshed = await RegistrationPaymentService.CreateStudioRefundAsync(
                EventId, orderId, _payment, remaining, CancellationToken.None);
            _payment = refreshed ?? _payment;
            _actionFailed = refreshed is null;
            _actionMessage = refreshed is null
                ? "The refund could not be created. Refresh before trying again."
                : "The refund was requested. Provider confirmation is pending.";
        }
        finally
        {
            _isRefunding = false;
        }
    }

    private async Task RetryRefundAsync()
    {
        if (_payment?._links?.ContainsKey("retry-refund") != true || Order.Id is not { } orderId || _isRefunding)
        {
            return;
        }

        bool? confirmed = await Dialogs.ShowMessageBoxAsync(
            "Retry refund settlement",
            "Recheck this refund with the payment provider? This reuses the existing refund and does not create another buyer refund.",
            yesText: "Retry settlement",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isRefunding = true;
        _actionMessage = null;
        try
        {
            HalResourceOfRegistrationPaymentDto? refreshed = await RegistrationPaymentService.RetryStudioRefundAsync(
                EventId, orderId, _payment, CancellationToken.None);
            _payment = refreshed ?? _payment;
            _actionFailed = refreshed is null;
            _actionMessage = refreshed is null
                ? "The settlement retry could not be scheduled. Refresh before trying again."
                : "The existing refund was queued for provider reconciliation.";
        }
        finally
        {
            _isRefunding = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ++_loadGeneration;
        CancelPendingRequest();
    }

    private void CancelPendingRequest()
    {
        _requestCancellation?.Cancel();
        _requestCancellation?.Dispose();
        _requestCancellation = null;
    }
}
