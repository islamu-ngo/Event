<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allow version downgrades for transitive dependencies -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Execution/TestExecutionProfile.cs" Link="Execution/TestExecutionProfile.cs" />
    <Compile Include="../Shared/Execution/BoundedTestDiscoveryHook.cs" Link="Execution/BoundedTestDiscoveryHook.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Event.Testing.TestSuiteKindAttribute">
      <_Parameter1>HostInProcess</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Blazor.Client\Explore.Blazor.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing Framework -->
    <PackageReference Include="TUnit" />

    <!-- BUnit for Blazor Component Testing -->
    <PackageReference Include="bunit" />

    <!-- Mocking -->
    <PackageReference Include="NSubstitute" />

    <!-- Data Generation -->
    <PackageReference Include="Bogus" />

    <!-- MudBlazor Testing Support (same version as client) -->
    <PackageReference Include="MudBlazor" />

  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
