{
  "schemaVersion": "release-provider.v1",
  "providerId": "github",
  "displayName": "GitHub",
  "discoveryWorkflows": [
    ".github/workflows/release-adapter-preview.yml",
    ".github/workflows/release-adapter-final.yml"
  ],
  "publicationWorkflows": [
    ".github/workflows/release-publish.yml"
  ],
  "actions": [
    "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
    "actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68"
  ],
  "previewLane": {
    "event": "pull_request",
    "trustedCodeOnly": false,
    "secrets": [],
    "permissions": [
      "contents:read"
    ],
    "requiredChecks": [
      "release-adapter-preview"
    ],
    "alwaysPresentNoop": true
  },
  "finalLane": {
    "event": "workflow_dispatch",
    "trustedRef": "default-branch",
    "trustedCodeOnly": true,
    "environmentApproval": true,
    "requiresSelfHostedTrustedRunner": false,
    "requiredChecks": [
      "release-adapter-final"
    ],
    "alwaysPresentNoop": true,
    "candidateStopsBeforeFinal": true
  },
  "capabilities": {
    "artifacts": true,
    "retentionDays": 90,
    "protectedRefCas": true,
    "releasePublication": true,
    "operatorEvidenceRequired": false
  },
  "guards": {
    "immutableBundleVerification": true,
    "providerNeutralChecksumEquality": true,
    "metadataAuthoritative": false,
    "misleadingSuccessForbidden": true
  },
  "diagnostics": [
    "adapter_validation_passed",
    "adapter_github_preview_event_invalid"
  ]
}
