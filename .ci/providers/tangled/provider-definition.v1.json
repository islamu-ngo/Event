{
  "schemaVersion": "release-provider.v1",
  "providerId": "tangled",
  "displayName": "Tangled",
  "discoveryWorkflows": [
    ".ci/providers/tangled/release-adapter-preview.yml",
    ".ci/providers/tangled/release-adapter-final.yml"
  ],
  "publicationWorkflows": [
    ".ci/providers/tangled/release-publish.yml"
  ],
  "actions": [],
  "previewLane": {
    "event": "pull_request",
    "trustedCodeOnly": false,
    "secrets": [],
    "permissions": [
      "contents:read"
    ],
    "requiredChecks": [
      "release-adapter-preview"
    ],
    "alwaysPresentNoop": true
  },
  "finalLane": {
    "event": "manual",
    "trustedRef": "no-checkout-discovery",
    "trustedCodeOnly": true,
    "environmentApproval": false,
    "requiresSelfHostedTrustedRunner": false,
    "requiredChecks": [
      "release-adapter-final"
    ],
    "alwaysPresentNoop": true,
    "candidateStopsBeforeFinal": true
  },
  "capabilities": {
    "artifacts": true,
    "retentionDays": 30,
    "protectedRefCas": false,
    "releasePublication": false,
    "operatorEvidenceRequired": true
  },
  "guards": {
    "immutableBundleVerification": true,
    "providerNeutralChecksumEquality": true,
    "metadataAuthoritative": false,
    "misleadingSuccessForbidden": true
  },
  "diagnostics": [
    "adapter_validation_passed",
    "adapter_provider_action_unsupported"
  ]
}
