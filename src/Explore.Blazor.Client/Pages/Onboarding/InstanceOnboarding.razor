@page "/onboarding/instance"
@using Explore.Blazor.Client.Components.Common
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Models.Responses
@using Explore.Blazor.Client.Pages.Onboarding.Components
@using Explore.Blazor.Client.Routing.ControlPlane
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@implements IAsyncDisposable
@layout SetupLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject IInstanceOnboardingService InstanceOnboardingService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<InstanceOnboarding> Logger
@inject IJSRuntime JSRuntime
@inject IBffAuthApi BffAuthApi
@inject IAccessibilityAnnouncerService Announcer
@inject ITranslationService Translation

<PageTitle>@T("page_title", "Site profile and launch")</PageTitle>

<OnboardingWorkspace Steps="@WorkspaceSteps"
                     ProgressLabel="@T("workspace.progress_label", "Instance onboarding progress")"
                     StepPositionFormatter="FormatStepPosition"
                     HeadingId="instance-onboarding-heading"
                     SummaryLabel="@T("workspace.summary_label", "Setup summary")"
                     ActionsLabel="@T("workspace.actions_label", "Instance onboarding actions")"
                     StatusText="@WorkspaceStatusText">
    <HeadingContent>
        <MudText Id="instance-onboarding-heading" Typo="Typo.h3" HtmlTag="h1">
            @T("title", "Site profile and launch")
        </MudText>
    </HeadingContent>
    <ChildContent>
<div class="instance-onboarding">
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        @T("intro", "Complete the public site profile, review authoritative readiness checks, and launch when every blocker is resolved.")
    </MudText>

    <section class="instance-onboarding__operator-context" aria-labelledby="deployment-mode-heading">
        <MudText Typo="Typo.h5" HtmlTag="h2" id="deployment-mode-heading">
            @T("deployment.heading", "Deployment context")
        </MudText>
        <dl class="instance-onboarding__definition-list">
            <div class="instance-onboarding__definition-row">
                <dt>@T("deployment.mode_label", "Deployment mode")</dt>
                <dd>@DeploymentModeText</dd>
            </div>
        </dl>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @DeploymentModeNotice
        </MudText>
    </section>

    @if (!string.IsNullOrWhiteSpace(CurrentError))
    {
        <div role="alert">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@CurrentError</MudAlert>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_syncWarning))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@_syncWarning</MudAlert>
    }

    @if (_isLoading)
    {
        <div class="instance-onboarding__loading">
            <span class="sr-only">@T("loading_aria", "Loading setup status")</span>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudSkeleton Width="100%" Height="72px" />
            <MudSkeleton Width="100%" Height="72px" />
            <MudSkeleton Width="100%" Height="72px" />
        </div>
    }
    else
    {
        @if (_isCompleted)
        {
            <section class="instance-onboarding__section" aria-labelledby="launch-handoff-heading">
                <MudText Typo="Typo.h5" HtmlTag="h2" id="launch-handoff-heading">
                    @T("success.heading", "Instance setup is complete")
                </MudText>
                <div role="status">
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                        @T("success.message", "The platform is live. Continue with the destination that matches this deployment mode.")
                    </MudAlert>
                </div>
                <div class="instance-onboarding__actions">
                    @if (_localCompleted)
                    {
                        <MudAlert Severity="Severity.Info">Sign in with the temporary password, replace it privately, then sign in again. Setup has not created a signed-in session.</MudAlert>
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/login?provider=local">Sign in to replace password</MudButton>
                    }
                    else if (IsSingleTenantMode)
                    {
                        <MudButton Elevation="0"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Href="/events"
                                   StartIcon="@Icons.Material.Filled.Event">
                            @T("success.single_primary", "Browse events")
                        </MudButton>
                        <MudButton Elevation="0"
                                   Color="Color.Secondary"
                                   Variant="Variant.Outlined"
                        Href="/settings/instance"
                                   StartIcon="@Icons.Material.Filled.Settings">
                            @T("success.single_secondary", "Open instance settings")
                        </MudButton>
                    }
                    else if (IsMultiTenantMode)
                    {
                        <MudButton Elevation="0"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Href="@ControlPlaneRoutes.Overview"
                                   StartIcon="@Icons.Material.Filled.Dashboard">
                            @T("success.multi_primary", "Open control plane")
                        </MudButton>
                        @if (CanManageTenants)
                        {
                            <MudButton Elevation="0"
                                       Color="Color.Secondary"
                                       Variant="Variant.Outlined"
                                       Href="@ControlPlaneRoutes.Tenants"
                                       StartIcon="@Icons.Material.Filled.Domain">
                                @T("success.multi_secondary", "Manage first tenant (optional)")
                            </MudButton>
                        }
                    }
                </div>
            </section>
        }
        else
        {
            <EditForm EditContext="_profileEditContext" OnValidSubmit="CompleteOnboardingAsync">
                <DataAnnotationsValidator />

                <section id="site-profile" class="instance-onboarding__section" aria-labelledby="site-profile-heading">
                    <MudText Typo="Typo.h5" HtmlTag="h2" id="site-profile-heading">
                        @T("profile.heading", "Site profile")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @T("profile.description", "Set the minimum public identity for this instance. These values remain editable after launch.")
                    </MudText>

                    <ValidationSummary />

                    <div class="instance-onboarding__fields">
                        <MudTextField T="string"
                                      Label="@T("profile.site_name_label", "Site name (required)")"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="@T("profile.site_name_required", "Site name is required.")"
                                      Immediate="true"
                                      For="@(() => _siteProfile.SiteName)"
                                      @bind-Value="_siteProfile.SiteName"
                                      Placeholder="@T("profile.site_name_placeholder", "Community Events")" />
                        <ValidationMessage For="@(() => _siteProfile.SiteName)" />

                        <MudTextField T="string"
                                      Label="@T("profile.support_email_label", "Support email (optional)")"
                                      Variant="Variant.Outlined"
                                      For="@(() => _siteProfile.SupportEmail)"
                                      @bind-Value="_siteProfile.SupportEmail"
                                      Placeholder="@T("profile.support_email_placeholder", "support@example.org")" />
                        <ValidationMessage For="@(() => _siteProfile.SupportEmail)" />

                        <MudTextField T="string"
                                      Label="@T("profile.canonical_url_label", "Canonical URL (optional)")"
                                      Variant="Variant.Outlined"
                                      For="@(() => _siteProfile.CanonicalUrl)"
                                      @bind-Value="_siteProfile.CanonicalUrl"
                                      Placeholder="@T("profile.canonical_url_placeholder", "https://events.example.org")" />
                        <ValidationMessage For="@(() => _siteProfile.CanonicalUrl)" />

                        <MudTextField T="string"
                                      Label="@T("profile.purpose_label", "Purpose (optional)")"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      For="@(() => _siteProfile.Purpose)"
                                      @bind-Value="_siteProfile.Purpose"
                                      Placeholder="@T("profile.purpose_placeholder", "A short note for future administrators about this site.")" />
                        <ValidationMessage For="@(() => _siteProfile.Purpose)" />
                    </div>
                </section>

                @if (IsSingleTenantMode)
                {
                    <fieldset class="instance-onboarding__section">
                        <legend>Directory operator identity</legend>
                        <MudText Typo="Typo.body2">These public accountability details are separate from the administrator's optional credential email.</MudText>
                        <AppTextField T="string" Id="operator-public-name" Label="Public name" Required="true" @bind-Value="_directoryOperator.PublicName" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-legal-name" Label="Legal name" Required="true" @bind-Value="_directoryOperator.LegalName" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-kind-code" Label="Operator kind code" Required="true" @bind-Value="_directoryOperator.OperatorKindCode" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-jurisdiction-country-code" Label="Jurisdiction country code" Required="true" MaxLength="2" @bind-Value="_directoryOperator.JurisdictionCountryCode" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-registration-identifier" Label="Registration identifier (optional)" @bind-Value="_directoryOperator.RegistrationIdentifier" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-public-contact-email" Label="Public contact email" InputType="InputType.Email" Required="true" @bind-Value="_directoryOperator.PublicContactEmail" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-legal-notice-url" Label="Legal notice URL" InputType="InputType.Url" Required="true" @bind-Value="_directoryOperator.LegalNoticeUrl" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-terms-url" Label="Terms URL (optional)" InputType="InputType.Url" @bind-Value="_directoryOperator.TermsUrl" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Id="operator-privacy-url" Label="Privacy URL" InputType="InputType.Url" Required="true" @bind-Value="_directoryOperator.PrivacyUrl" Disabled="_submitState.IsSubmitting" />
                    </fieldset>
                }

                @if (IsLocalSetup)
                {
                    <fieldset class="instance-onboarding__section">
                        <legend>Initial Local administrator</legend>
                        <MudText Typo="Typo.body2">No credential email is required. The temporary password must be replaced after setup before administrative access is available.</MudText>
                        <AppTextField T="string" Label="Username" InputType="InputType.Text" Required="true" MaxLength="256" autocomplete="username" @bind-Value="_localUsername" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Label="Temporary password" InputType="InputType.Password" Required="true" MaxLength="128" autocomplete="new-password" @bind-Value="_localPassword" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Label="Credential email (optional)" InputType="InputType.Email" MaxLength="256" @bind-Value="_localEmail" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Label="First name (optional)" MaxLength="200" @bind-Value="_localFirstName" Disabled="_submitState.IsSubmitting" />
                        <AppTextField T="string" Label="Last name (optional)" MaxLength="200" @bind-Value="_localLastName" Disabled="_submitState.IsSubmitting" />
                        <MudButton ButtonType="ButtonType.Button" OnClick="CancelLocalSetup">Cancel Local setup</MudButton>
                    </fieldset>
                }

                <section id="launch-readiness" class="instance-onboarding__section" aria-labelledby="launch-readiness-heading">
                    <MudText Typo="Typo.h5" HtmlTag="h2" id="launch-readiness-heading">
                        @T("readiness.heading", "Launch readiness")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @T("readiness.description", "Blocking checks must pass. Operational warnings remain non-blocking unless a serious warning requires acknowledgement.")
                    </MudText>

                    @if (_preflight is null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            @T("readiness.unavailable", "Launch readiness is unavailable. Refresh setup status before continuing.")
                        </MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" HtmlTag="h3" id="required-launch-checks-heading">
                            @T("readiness.blocking_label", "Required launch checks")
                        </MudText>
                        <div class="instance-onboarding__checks" aria-labelledby="required-launch-checks-heading">
                            @foreach (var check in _preflight.BlockingChecks ?? [])
                            {
                                <div class="@($"instance-onboarding__check {GetBlockingCheckClass(check)}")">
                                    <MudIcon Icon="@GetBlockingCheckIcon(check)"
                                             Color="@GetBlockingCheckColor(check)"
                                             Size="Size.Small" />
                                    <div class="instance-onboarding__check-copy">
                                        <MudText Typo="Typo.subtitle2">@check.Name</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@check.Message</MudText>
                                    </div>
                                    <MudText Typo="Typo.caption">@GetBlockingCheckStatusText(check)</MudText>
                                </div>
                            }
                        </div>

                        <div class="instance-onboarding__warnings" aria-labelledby="operational-warnings-heading">
                            <MudText Typo="Typo.h6" HtmlTag="h3" id="operational-warnings-heading">
                                @T("readiness.warnings_heading", "Operational warnings")
                            </MudText>
                            @if ((_preflight.WarningChecks?.Count ?? 0) == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @T("readiness.no_warnings", "No operational warnings were reported.")
                                </MudText>
                            }
                            else
                            {
                                @foreach (var check in _preflight.WarningChecks ?? [])
                                {
                                    <div class="instance-onboarding__check instance-onboarding__check--warning">
                                        <MudChip T="string" Size="Size.Small" Color="@GetWarningColor(check.Severity)" Variant="Variant.Outlined">
                                            @check.Severity
                                        </MudChip>
                                        <div class="instance-onboarding__check-copy">
                                            <MudText Typo="Typo.subtitle2">@check.Name</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@check.Message</MudText>
                                            @if (!string.IsNullOrWhiteSpace(check.Detail))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@check.Detail</MudText>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (HasSeriousWarning && _preflight.IsReadyToLaunch == true)
                        {
                            <div class="instance-onboarding__acknowledgement">
                                <MudText Typo="Typo.h6" HtmlTag="h3">
                                    @T("acknowledgement.heading", "Required acknowledgement")
                                </MudText>
                                <MudCheckBox T="bool"
                                             @bind-Value="_acknowledgePublicExposure"
                                             Color="Color.Warning"
                                             Label="@T("acknowledgement.public_exposure", "I understand that this site will be publicly accessible and I have reviewed the operational warnings.")" />
                            </div>
                        }
                    }
                </section>

                <div class="instance-onboarding__actions instance-onboarding__actions--submit">
                    <MudButton Elevation="0"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit"
                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                               Disabled="@CannotComplete">
                        @CompleteButtonLabel
                    </MudButton>
                </div>
            </EditForm>
        }
    }
</div>
    </ChildContent>
    <SummaryContent>
        <OnboardingTaskList Items="@TaskItems"
                            AccessibleLabel="@T("tasks.accessible_label", "Instance setup tasks")" />
    </SummaryContent>
    <HelpContent>
        <p>@T("workspace.help", "Provider and readiness states come from the server. Refresh after changing deployment-managed configuration.")</p>
    </HelpContent>
    <ActionsContent>
        <MudButton Elevation="0"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   Disabled="@_isRefreshing"
                   OnClick="RefreshAsync"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   aria-label="@T("actions.refresh_aria", "Refresh setup status")">
            @T("actions.refresh", "Refresh status")
        </MudButton>
    </ActionsContent>
</OnboardingWorkspace>

@code {
    private readonly object _refreshGate = new();
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SelfHostOnboardingProfileDto _siteProfile = new();
    private readonly TenantDirectoryOperatorIdentityInputDto _directoryOperator = new();
    private string _localUsername = string.Empty;
    private string _localPassword = string.Empty;
    private string? _localEmail;
    private string? _localFirstName;
    private string? _localLastName;
    private Guid _localOperationId = Guid.CreateVersion7();
    private int _localRequestGeneration;
    private bool _localCompleted;
    private bool IsLocalSetup => !_isCompleted && string.Equals(_status?.Provider, "Local", StringComparison.OrdinalIgnoreCase);
    private EditContext _profileEditContext = default!;
    private Task? _refreshTask;
    private string? _deploymentMode;
    private OnboardingPreflightDto? _preflight;
    private InstanceOnboardingStatusDto? _status;
    private bool? _authProviderConfigured;
    private bool? _authorizationProviderConfigured;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _hasLoaded;
    private bool _isCompleted;
    private bool _acknowledgePublicExposure;
    private bool _setupSecretSynced;
    private bool _disposed;
    private FormSubmitState _submitState = new();
    private string? _loadError;
    private string? _completionError;
    private string? _setupSecretError;
    private string? _syncWarning;
    private IJSObjectReference? _bffModule;

    private bool SiteProfileComplete => _isCompleted || !string.IsNullOrWhiteSpace(_siteProfile.SiteName);
    private bool IsReadinessCurrent => _isCompleted || (!_isLoading && SiteProfileComplete);

    private IReadOnlyList<OnboardingWorkspace.StepDescriptor> WorkspaceSteps
    {
        get
        {
            var complete = T("workspace.status.complete", "Complete");
            var upcoming = T("workspace.status.upcoming", "Upcoming");
            var unavailable = T("workspace.status.unavailable", "Status unavailable");

            return
            [
                new(
                    T("workspace.step.authentication", "Authentication"),
                    _authProviderConfigured == true ? complete : unavailable,
                    ProviderState(_authProviderConfigured),
                    Href: CanOpenAuthenticationProvider ? AuthenticationProviderHref : null),
                new(
                    T("workspace.step.authorization", "Authorization"),
                    _authorizationProviderConfigured == true ? complete : unavailable,
                    ProviderState(_authorizationProviderConfigured),
                    Href: CanOpenAuthorizationProvider ? AuthorizationProviderHref : null),
                new(
                    T("workspace.step.site_profile", "Site profile"),
                    SiteProfileComplete ? complete : WorkspaceStatusText,
                    SiteProfileComplete
                        ? OnboardingWorkspace.PresentationState.Complete
                        : _isLoading
                            ? OnboardingWorkspace.PresentationState.Loading
                            : OnboardingWorkspace.PresentationState.Current,
                    IsCurrent: !IsReadinessCurrent,
                    Href: _isCompleted ? null : "#site-profile"),
                new(
                    T("workspace.step.readiness", "Readiness"),
                    _isCompleted ? complete : IsReadinessCurrent ? WorkspaceStatusText : upcoming,
                    _isCompleted
                        ? OnboardingWorkspace.PresentationState.Complete
                        : IsReadinessCurrent
                            ? OnboardingWorkspace.PresentationState.Current
                            : OnboardingWorkspace.PresentationState.Upcoming,
                    IsCurrent: IsReadinessCurrent,
                    Href: _isCompleted ? null : "#launch-readiness")
            ];
        }
    }

    private string WorkspaceStatusText => _isLoading
        ? T("workspace.status.loading", "Loading setup status")
        : CurrentError is not null
            ? T("workspace.status.error", "Setup status needs attention")
            : _isCompleted
                ? T("workspace.status.complete", "Complete")
                : T("workspace.status.current", "Current step");

    private OnboardingWorkspace.PresentationState ProviderState(bool? configured) => configured switch
    {
        true => OnboardingWorkspace.PresentationState.Complete,
        false => OnboardingWorkspace.PresentationState.Locked,
        null when _isLoading => OnboardingWorkspace.PresentationState.Loading,
        _ => OnboardingWorkspace.PresentationState.Error
    };

    private string FormatStepPosition(int current, int total) => string.Format(
        System.Globalization.CultureInfo.CurrentCulture,
        T("workspace.step_position", "Step {0} of {1}"),
        current,
        total);

    private bool IsSingleTenantMode => string.Equals(_deploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase);
    private bool IsMultiTenantMode => string.Equals(_deploymentMode, "MultiTenant", StringComparison.OrdinalIgnoreCase);
    private bool CanOpenAuthenticationProvider => _hasLoaded
        && _loadError is null
        && _authProviderConfigured.HasValue
        && _status?.HasHalLink("manage-authentication") == true;
    private bool CanOpenAuthorizationProvider => _hasLoaded
        && _loadError is null
        && _authorizationProviderConfigured.HasValue
        && _status?.HasHalLink("manage-authorization") == true;
    private bool CanManageTenants => _isCompleted
        && _status?.HasHalLink("manage-tenants") == true;
    private string AuthenticationProviderHref => _isCompleted
            ? "/settings/instance?section=auth-providers"
        : "/onboarding/auth-provider";
    private string AuthorizationProviderHref => _isCompleted
            ? "/settings/instance?section=auth-providers"
        : "/onboarding/authz-provider";
    private string? CurrentError => _completionError ?? _setupSecretError ?? _loadError;
    private string CompleteButtonLabel => _submitState.IsSubmitting
        ? T("actions.launching", "Launching...")
        : T("actions.launch", "Launch instance");
    private bool HasSeriousWarning => _preflight?.WarningChecks?.Any(check =>
        string.Equals(check.Severity, "Critical", StringComparison.OrdinalIgnoreCase)
        || string.Equals(check.Severity, "High", StringComparison.OrdinalIgnoreCase)) == true;
    private bool AllAcknowledgementsChecked => !HasSeriousWarning || _acknowledgePublicExposure;
    private bool CannotComplete => _submitState.IsSubmitting
        || _isRefreshing
        || !_hasLoaded
        || string.IsNullOrWhiteSpace(_siteProfile.SiteName)
        || _authProviderConfigured != true
        || _authorizationProviderConfigured != true
        || _preflight?.IsReadyToLaunch != true
        || !AllAcknowledgementsChecked
        || _status?.HasHalLink(IsLocalSetup ? "complete-local" : "complete") != true;

    private string DeploymentModeText => IsSingleTenantMode
        ? T("deployment.single", "Single tenant")
        : IsMultiTenantMode
            ? T("deployment.multi", "Multi tenant")
            : T("deployment.unavailable", "Unavailable");

    private string DeploymentModeNotice => IsSingleTenantMode
        ? T("deployment.single_notice", "The operator configured a single-tenant deployment. This value is read-only during onboarding.")
        : IsMultiTenantMode
            ? T("deployment.multi_notice", "The operator configured a multi-tenant deployment. Tenant creation is an optional post-launch task.")
            : T("deployment.unavailable_notice", "The operator-managed deployment mode could not be loaded. Refresh before launching.");

    private IReadOnlyList<OnboardingTaskList.TaskItem> TaskItems
    {
        get
        {
            var required = T("tasks.required", "Required");
            var optional = T("tasks.optional", "Optional");
            var instanceScope = T("tasks.scope.instance", "Instance scope");
            var operatorScope = T("tasks.scope.operator", "Instance operator scope");

            var items = new List<OnboardingTaskList.TaskItem>
            {
                new(
                    T("tasks.profile.title", "Site profile"),
                    T("tasks.profile.description", "Define the public name and contact details used by this instance."),
                    true,
                    required,
                    _isCompleted || !string.IsNullOrWhiteSpace(_siteProfile.SiteName)
                        ? OnboardingTaskList.TaskStatus.Completed
                        : OnboardingTaskList.TaskStatus.NotStarted,
                    _isCompleted || !string.IsNullOrWhiteSpace(_siteProfile.SiteName)
                        ? T("tasks.status.complete", "Complete")
                        : T("tasks.status.not_started", "Not started"),
                    instanceScope,
                    _isCompleted ? null : "#site-profile",
                    _isCompleted ? null : T("tasks.profile.action", "Edit profile"),
                    _isCompleted ? null : T("tasks.profile.action_aria", "Edit the site profile")),
                new(
                    T("tasks.authentication.title", "Authentication provider"),
                    _authProviderConfigured == true
                        ? T("tasks.authentication.configured_description", "Authentication is configured. Open provider management to review, repair, or switch the active sign-in authority.")
                        : _authProviderConfigured == false
                            ? T("tasks.authentication.description", "At least one sign-in provider must be configured before launch.")
                            : T("tasks.authentication.unavailable_description", "Authentication provider status is unavailable. Refresh before taking action."),
                    true,
                    required,
                    _authProviderConfigured == true ? OnboardingTaskList.TaskStatus.Completed : OnboardingTaskList.TaskStatus.Blocked,
                    _authProviderConfigured == true
                        ? T("tasks.status.complete", "Complete")
                        : _authProviderConfigured == false
                            ? T("tasks.status.action_required", "Action required")
                            : T("tasks.status.unavailable", "Status unavailable"),
                    operatorScope,
                    CanOpenAuthenticationProvider ? AuthenticationProviderHref : null,
                    CanOpenAuthenticationProvider
                        ? _authProviderConfigured == true
                            ? T("tasks.authentication.manage_action", "Manage authentication")
                            : T("tasks.authentication.action", "Configure authentication")
                        : null,
                    CanOpenAuthenticationProvider
                        ? T("tasks.authentication.action_aria", "Open authentication provider configuration")
                        : null),
                new(
                    T("tasks.authorization.title", "Authorization provider"),
                    _authorizationProviderConfigured.HasValue
                        ? T("tasks.authorization.description", "A policy provider must be configured before the platform can authorize requests.")
                        : T("tasks.authorization.unavailable_description", "Authorization provider status is unavailable. Refresh before taking action."),
                    true,
                    required,
                    _authorizationProviderConfigured == true ? OnboardingTaskList.TaskStatus.Completed : OnboardingTaskList.TaskStatus.Blocked,
                    _authorizationProviderConfigured == true
                        ? T("tasks.status.complete", "Complete")
                        : _authorizationProviderConfigured == false
                            ? T("tasks.status.action_required", "Action required")
                            : T("tasks.status.unavailable", "Status unavailable"),
                    operatorScope,
                    CanOpenAuthorizationProvider ? AuthorizationProviderHref : null,
                    CanOpenAuthorizationProvider
                        ? _authorizationProviderConfigured == true
                            ? T("tasks.authorization.manage_action", "Manage authorization")
                            : T("tasks.authorization.action", "Configure authorization")
                        : null,
                    CanOpenAuthorizationProvider
                        ? T("tasks.authorization.action_aria", "Open authorization provider configuration")
                        : null),
                new(
                    T("tasks.readiness.title", "Launch readiness"),
                    T("tasks.readiness.description", "Server-evaluated blocking checks must pass; operational warnings are reported separately."),
                    true,
                    required,
                    GetReadinessTaskStatus(),
                    GetReadinessTaskStatusText(),
                    T("tasks.scope.server", "Server-evaluated instance scope"),
                    _isCompleted ? null : "#launch-readiness",
                    _isCompleted ? null : T("tasks.readiness.action", "Review readiness"),
                    _isCompleted ? null : T("tasks.readiness.action_aria", "Review launch readiness"))
            };

            if (IsMultiTenantMode)
            {
                items.Add(new OnboardingTaskList.TaskItem(
                    T("tasks.first_tenant.title", "First tenant"),
                    T("tasks.first_tenant.description", "Create and configure the first tenant after platform launch. This never blocks instance launch."),
                    false,
                    optional,
                    _isCompleted ? OnboardingTaskList.TaskStatus.Available : OnboardingTaskList.TaskStatus.NotStarted,
                    _isCompleted
                        ? T("tasks.status.available", "Available")
                        : T("tasks.status.post_launch", "Post-launch"),
                    T("tasks.scope.tenant", "Tenant scope"),
                    CanManageTenants ? ControlPlaneRoutes.Tenants : null,
                    CanManageTenants ? T("tasks.first_tenant.action", "Manage tenants") : null,
                    CanManageTenants ? T("tasks.first_tenant.action_aria", "Manage the optional first tenant") : null));
            }

            return items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _profileEditContext = new EditContext(_siteProfile);

        await RefreshAsync();
        if (!IsLocalSetup && !_disposed && _status?.HasHalLink("complete") == true)
        {
            try
            {
                await UserService.SyncUserAsync();
                await UserService.GetCurrentUserAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not fully hydrate user context during instance onboarding.");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || IsLocalSetup || _setupSecretSynced || _disposed || _status?.HasHalLink("complete") != true)
        {
            return;
        }

        await SynchronizeSetupSecretAsync();
    }

    public Task RefreshAsync()
    {
        lock (_refreshGate)
        {
            if (_refreshTask is { IsCompleted: false })
            {
                return _refreshTask;
            }

            _refreshTask = RefreshCoreAsync();
            return _refreshTask;
        }
    }

    private async Task RefreshCoreAsync()
    {
        if (_disposed)
        {
            return;
        }

        if (_hasLoaded && IsLocalSetup)
        {
            _localPassword = string.Empty;
            _localRequestGeneration++;
        }
        _isLoading = !_hasLoaded;
        _isRefreshing = true;
        _loadError = null;
        _completionError = null;

        try
        {
            var status = await InstanceOnboardingService.GetStatusAsync();
            if (_disposed)
            {
                return;
            }

            var systemStatusTask = InstanceOnboardingService.GetSystemOnboardingStatusAsync();
            var brandingTask = InstanceOnboardingService.GetBrandingSettingsAsync();
            var authenticationTask = InstanceOnboardingService.GetAuthProviderConfiguredStateAsync();
            var authorizationTask = InstanceOnboardingService.GetAuthorizationProviderConfiguredStateAsync();
            var preflightTask = InstanceOnboardingService.GetOnboardingPreflightAsync();

            await Task.WhenAll(systemStatusTask, brandingTask, authenticationTask, authorizationTask, preflightTask);
            if (_disposed)
            {
                return;
            }

            var systemStatus = await systemStatusTask;
            var branding = await brandingTask;

            bool wasLocal = IsLocalSetup;
            _status = status;
            _isCompleted = status?.IsCompleted == true;
            if (wasLocal && !IsLocalSetup)
            {
                _localPassword = string.Empty;
                _localRequestGeneration++;
            }
            if (IsLocalSetup)
                _localOperationId = status?.PendingOperationId ?? _localOperationId;
            _deploymentMode = NormalizeDeploymentMode(systemStatus?.DeploymentMode);
            _authProviderConfigured = await authenticationTask;
            _authorizationProviderConfigured = await authorizationTask;
            _preflight = await preflightTask;
            _acknowledgePublicExposure = false;

            if (!string.IsNullOrWhiteSpace(branding?.DefaultBrandDisplayName))
            {
                _siteProfile.SiteName = branding.DefaultBrandDisplayName;
            }
            _siteProfile.SupportEmail = branding?.SupportEmail;

            if (status is null
                || systemStatus is null
                || _deploymentMode is null
                || _preflight is null
                || !_authProviderConfigured.HasValue
                || !_authorizationProviderConfigured.HasValue)
            {
                await SetLoadErrorAsync(T("errors.status_unavailable", "Some authoritative setup state is unavailable. Refresh before launching."));
            }
            else
            {
                await Announcer.AnnouncePoliteAsync(T("announcements.loaded", "Setup status loaded."));
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load authoritative instance onboarding state.");
            _deploymentMode = null;
            _preflight = null;
            _status = null;
            _authProviderConfigured = null;
            _authorizationProviderConfigured = null;
            await SetLoadErrorAsync(T("errors.load_failed", "Setup status could not be loaded. Refresh and try again."));
        }
        finally
        {
            if (!_disposed)
            {
                _hasLoaded = true;
                _isLoading = false;
                _isRefreshing = false;
            }
        }
    }

    private async Task CompleteOnboardingAsync()
    {
        if (_disposed)
        {
            return;
        }

        _completionError = null;

        if (!_profileEditContext.Validate())
        {
            await SetCompletionErrorAsync(T("errors.profile_invalid", "Correct the site profile errors before launching."));
            return;
        }

        if (_authProviderConfigured != true || _authorizationProviderConfigured != true)
        {
            await SetCompletionErrorAsync(T("errors.providers_incomplete", "Configure both required providers before launching."));
            return;
        }

        if (_preflight?.IsReadyToLaunch != true)
        {
            await SetCompletionErrorAsync(T("errors.blockers", "Resolve blocking launch checks before completing setup."));
            return;
        }

        if (!AllAcknowledgementsChecked)
        {
            await SetCompletionErrorAsync(T("errors.acknowledgement", "Acknowledge the serious operational warning before launching."));
            return;
        }

        if (_status?.HasHalLink(IsLocalSetup ? "complete-local" : "complete") != true)
        {
            await SetCompletionErrorAsync(T("errors.completion_unavailable", "The server did not expose permission to complete setup. Refresh and try again."));
            return;
        }

        if (IsLocalSetup)
        {
            await CompleteLocalSetupAsync();
            return;
        }

        _submitState.Start();

        try
        {
            _setupSecretSynced = false;
            await SynchronizeSetupSecretAsync();
            if (_disposed || !_setupSecretSynced)
            {
                return;
            }

            var completion = new CompleteInstanceOnboardingRequest
            {
                DeploymentMode = IsSingleTenantMode ? DeploymentMode.SingleTenant : DeploymentMode.MultiTenant,
                AdministrationAccessMode = "Embedded",
                SiteProfile = new SelfHostOnboardingProfileDto
                {
                    SiteName = _siteProfile.SiteName?.Trim(),
                    SupportEmail = NormalizeOptional(_siteProfile.SupportEmail),
                    CanonicalUrl = NormalizeOptional(_siteProfile.CanonicalUrl),
                    Locale = string.IsNullOrWhiteSpace(_siteProfile.Locale) ? "en" : _siteProfile.Locale.Trim(),
                    TimeZone = string.IsNullOrWhiteSpace(_siteProfile.TimeZone) ? "UTC" : _siteProfile.TimeZone.Trim(),
                    Purpose = NormalizeOptional(_siteProfile.Purpose)
                },
                InstanceName = _siteProfile.SiteName?.Trim(),
                DirectoryOperatorIdentity = IsSingleTenantMode ? _directoryOperator : null
            };

            var preRefreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
            if (_disposed)
            {
                return;
            }

            if (!preRefreshed)
            {
                Logger.LogWarning("Pre-complete auth session refresh failed. Aborting completion and redirecting to login.");
                await SetCompletionErrorAsync(T("errors.session_expired", "Your session expired. Sign in again to complete setup."));
                Navigation.NavigateTo(
                    "/login?returnUrl=%2Fonboarding%2Finstance",
                    forceLoad: true);
                return;
            }

            var response = await InstanceOnboardingService.CompleteAsync(completion);
            if (_disposed)
            {
                return;
            }

            if (response.Success == true)
            {
                var refreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
                if (_disposed)
                {
                    return;
                }

                if (!refreshed)
                {
                    Logger.LogWarning("Instance onboarding completed but the BFF auth session refresh failed.");
                }

                var confirmedStatus = await InstanceOnboardingService.GetStatusAsync();
                if (_disposed)
                {
                    return;
                }

                if (confirmedStatus?.IsCompleted != true)
                {
                    Logger.LogWarning("Instance onboarding completion succeeded but authoritative status did not confirm completion.");
                    await SetCompletionErrorAsync(T("errors.completion_unconfirmed", "The completion request succeeded, but the server has not confirmed setup completion. Refresh before continuing."));
                    return;
                }

                _status = confirmedStatus;
                _isCompleted = true;
                _completionError = null;
                Snackbar.Add(T("success.snackbar", "Instance setup completed."), Severity.Success);
                await Announcer.AnnouncePoliteAsync(T("announcements.completed", "Instance setup completed."));
                return;
            }

            await SetCompletionErrorAsync(GetSafeCompletionError(response));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Instance onboarding completion failed.");
            if (!_disposed)
            {
                await SetCompletionErrorAsync(T("errors.completion_failed", "Instance setup could not be completed. Review the status and try again."));
            }
        }
        finally
        {
            if (!_disposed)
            {
                _submitState.Complete();
            }
        }
    }

    private async Task CompleteLocalSetupAsync()
    {
        _submitState.Start();
        int generation = ++_localRequestGeneration;
        try
        {
            var response = await InstanceOnboardingService.CompleteLocalAsync(new CompleteLocalInstanceOnboardingRequestDto
            {
                OperationId = _localOperationId,
                Username = _localUsername.Trim(), TemporaryPassword = _localPassword,
                Email = NormalizeOptional(_localEmail), FirstName = NormalizeOptional(_localFirstName), LastName = NormalizeOptional(_localLastName),
                Settings = new CompleteInstanceOnboardingRequest
                {
                    DeploymentMode = IsSingleTenantMode ? DeploymentMode.SingleTenant : DeploymentMode.MultiTenant,
                    SiteProfile = _siteProfile,
                    DirectoryOperatorIdentity = IsSingleTenantMode ? _directoryOperator : null,
                    AdministrationAccessMode = "Embedded", InstanceName = _siteProfile.SiteName?.Trim()
                }
            }, _lifetimeCancellation.Token);
            if (_disposed || generation != _localRequestGeneration) return;
            if (response.Success == true)
            {
                _localCompleted = true;
                _isCompleted = true;
                await Announcer.AnnouncePoliteAsync(T("local.completed", "Setup is complete. Sign in and replace your temporary password."));
            }
            else
            {
                await SetCompletionErrorAsync(T("local.failed", "Local setup did not complete. Refresh status and retry with the same account details."));
            }
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested) { }
        catch (Exception)
        {
            Logger.LogWarning("Local setup completion could not be confirmed.");
            if (!_disposed && generation == _localRequestGeneration)
                await SetCompletionErrorAsync(T("local.failed", "Local setup did not complete. Refresh status and retry with the same account details."));
        }
        finally
        {
            _localPassword = string.Empty;
            if (!_disposed) _submitState.Complete();
        }
    }

    private void CancelLocalSetup()
    {
        _localRequestGeneration++;
        _localPassword = string.Empty;
        Navigation.NavigateTo("/setup", forceLoad: true);
    }

    private async Task SynchronizeSetupSecretAsync()
    {
        try
        {
            var bffModule = await GetBffModuleAsync();

            for (var attempt = 0; attempt <= 3 && !_disposed; attempt++)
            {
                if (attempt > 0)
                {
                    await Task.Delay(TimeSpan.FromSeconds(attempt * 2), _lifetimeCancellation.Token);
                }

                var syncResult = await bffModule.InvokeAsync<BffMutationResult>("syncSetupSecret", (string?)null);
                if (_disposed)
                {
                    return;
                }

                if (syncResult is { Ok: true })
                {
                    _setupSecretSynced = true;
                    _setupSecretError = null;
                    _syncWarning = null;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (syncResult?.Status is 400 or 403 or 410)
                {
                    await BffAuthApi.DeleteSetupSecretAsync(CancellationToken.None);
                    var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
                    var returnUrl = string.IsNullOrWhiteSpace(relativePath) ? "/" : $"/{relativePath}";
                    Navigation.NavigateTo($"/setup?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
                    return;
                }
            }

            if (!_disposed)
            {
                _syncWarning = T("warnings.setup_secret_pending", "Setup secret synchronization is pending. Saving may require entering the setup secret again.");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
            // Component disposal cancels retry delays; no UI update is needed.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Setup secret synchronization failed during instance onboarding.");
            if (!_disposed)
            {
                _syncWarning = T("warnings.setup_secret_pending", "Setup secret synchronization is pending. Saving may require entering the setup secret again.");
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private OnboardingTaskList.TaskStatus GetReadinessTaskStatus()
    {
        if (_isCompleted)
        {
            return OnboardingTaskList.TaskStatus.Completed;
        }

        if (_preflight is null)
        {
            return OnboardingTaskList.TaskStatus.Blocked;
        }

        return _preflight.IsReadyToLaunch == true
            ? OnboardingTaskList.TaskStatus.Completed
            : OnboardingTaskList.TaskStatus.Blocked;
    }

    private string GetReadinessTaskStatusText() => GetReadinessTaskStatus() switch
    {
        OnboardingTaskList.TaskStatus.Completed => T("tasks.status.complete", "Complete"),
        OnboardingTaskList.TaskStatus.Blocked => T("tasks.status.blocked", "Blocked"),
        _ => T("tasks.status.not_started", "Not started")
    };

    private static string? NormalizeDeploymentMode(string? deploymentMode)
    {
        if (string.Equals(deploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase))
        {
            return "SingleTenant";
        }

        return string.Equals(deploymentMode, "MultiTenant", StringComparison.OrdinalIgnoreCase)
            ? "MultiTenant"
            : null;
    }

    private static bool CheckPassed(OnboardingPreflightCheckDto check) =>
        string.Equals(check.Status, "Pass", StringComparison.OrdinalIgnoreCase);

    private static string GetBlockingCheckClass(OnboardingPreflightCheckDto check) =>
        CheckPassed(check) ? "instance-onboarding__check--pass" : "instance-onboarding__check--fail";

    private static string GetBlockingCheckIcon(OnboardingPreflightCheckDto check) =>
        CheckPassed(check) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error;

    private static Color GetBlockingCheckColor(OnboardingPreflightCheckDto check) =>
        CheckPassed(check) ? Color.Success : Color.Error;

    private string GetBlockingCheckStatusText(OnboardingPreflightCheckDto check) =>
        CheckPassed(check)
            ? T("readiness.passed", "Passed")
            : T("readiness.failed", "Blocked");

    private static Color GetWarningColor(string? severity) =>
        string.Equals(severity, "Critical", StringComparison.OrdinalIgnoreCase) ? Color.Error
        : string.Equals(severity, "High", StringComparison.OrdinalIgnoreCase) ? Color.Warning
        : string.Equals(severity, "Medium", StringComparison.OrdinalIgnoreCase) ? Color.Info
        : Color.Default;

    private async Task SetLoadErrorAsync(string message)
    {
        _loadError = message;
        if (!_disposed)
        {
            await Announcer.AnnounceAssertiveAsync(message);
        }
    }

    private async Task SetCompletionErrorAsync(string message)
    {
        _localPassword = string.Empty;
        _completionError = message;
        if (!_disposed)
        {
            await Announcer.AnnounceAssertiveAsync(message);
        }
    }

    private string GetSafeCompletionError(BaseCommandResponseOfGuid response)
    {
        var message = string.IsNullOrWhiteSpace(response.Message)
            ? T("errors.completion_failed", "Instance setup could not be completed. Review the status and try again.")
            : response.Message.Trim();
        var errors = response.Errors?
            .Where(error => !string.IsNullOrWhiteSpace(error))
            .Select(error => error.Trim())
            .ToList();

        return errors is { Count: > 0 }
            ? $"{message} {string.Join(" ", errors)}"
            : message;
    }

    private static string? NormalizeOptional(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string T(string key, string fallback) =>
        Translation.T($"ui.onboarding.instance.{key}", fallback);

    private async Task<IJSObjectReference> GetBffModuleAsync()
    {
        _bffModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/bff.js");
        return _bffModule;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _localRequestGeneration++;
        _localPassword = string.Empty;
        _lifetimeCancellation.Cancel();

        if (_bffModule is not null)
        {
            try
            {
                await _bffModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit may already be gone during component disposal.
            }
        }

        _lifetimeCancellation.Dispose();
    }
}
