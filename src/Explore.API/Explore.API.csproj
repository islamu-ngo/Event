<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(Configuration)' == 'Release'">true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(Configuration)' != 'Release'">false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/openapi', '$(MSBuildProjectDirectory)'))</OpenApiDocumentsDirectory>
    <CanonicalOpenApiDocument>$(MSBuildProjectDirectory)/../../schemas/openapi_islamu-event.json</CanonicalOpenApiDocument>
    <OpenApiGenerateDocumentsOptions>--document-name islamu-event --file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <Import Project="../../eng/tools/Explore.GeneratedContracts/GeneratedContractTool.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="Event.API.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Aspire.Keycloak.Authentication" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenFeature.Hosting" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.AspNetCore" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\Explore.Infrastructure\Explore.Infrastructure.csproj" />
    <ProjectReference Include="..\Explore.Persistence\Explore.Persistence.csproj" />
    <ProjectReference Include="..\Explore.Secrets\Explore.Secrets.csproj" />
    <ProjectReference Include="..\Explore.ServiceDefaults\Explore.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Fonts/NotoSansArabic[wdth,wght].ttf" />
    <EmbeddedResource Include="Resources/Quartz/*.sql" />
  </ItemGroup>

  <!-- Include openapi.json as content (committed to source control) -->
  <ItemGroup>
    <None Include="../../schemas/openapi_islamu-event.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../schemas/openapi_islamu-event.json')" />
  </ItemGroup>

  <Target Name="PrepareOpenApiPublication" BeforeTargets="GenerateOpenApiDocuments">
    <PropertyGroup>
      <_OpenApiDocumentsCache>$(OpenApiDocumentsDirectory)/OpenApiFiles.cache</_OpenApiDocumentsCache>
    </PropertyGroup>
    <MakeDir Directories="$(OpenApiDocumentsDirectory)" />
    <Delete Files="$(_OpenApiDocumentsCache)" Condition="'$(ForceOpenApiGeneration)' == 'true' Or !Exists('$(OpenApiDocumentsDirectory)/openapi_islamu-event.json')" />
  </Target>

  <Target Name="PublishOpenApiDocument" AfterTargets="GenerateOpenApiDocuments" DependsOnTargets="BuildGeneratedContractTool">
    <Exec Command="dotnet &quot;$(GeneratedContractToolAssembly)&quot; publish-schema &quot;$(OpenApiDocumentsDirectory)/openapi_islamu-event.json&quot; &quot;$(CanonicalOpenApiDocument)&quot;" />
  </Target>

  <Target Name="GetOpenApiContractInput" DependsOnTargets="Build;GenerateOpenApiDocuments" Returns="@(OpenApiContractInput)">
    <ItemGroup>
      <OpenApiContractInput Include="$(OpenApiDocumentsDirectory)/openapi_islamu-event.json" />
    </ItemGroup>
    <Error Condition="!Exists('%(OpenApiContractInput.Identity)')" Text="Missing exported OpenAPI contract: %(OpenApiContractInput.Identity)." />
  </Target>

</Project>
