@page "/auth/local/register"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Explore.Blazor.Client.Models.Requests
@inject IBffAuthApi BffAuthApi
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Create a Local account</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Class="pa-6">
        <MudStack Spacing="3">
            <h1>Create a Local account</h1>
            @if (_loading)
            {
                <p role="status">Checking account creation availability...</p>
            }
            @if (_error is not null)
            {
                <p role="alert">@_error</p>
            }
            @if (_loginPath is not null)
            {
                <p role="status">Your account was created. Sign in with the password originally submitted.</p>
                <AppButton Href="@_loginPath" FullWidth="true">Sign in</AppButton>
            }
            else if (!_loading && _canRegister)
            {
                <EditForm Model="@_input" OnSubmit="SubmitAsync" FormName="local-visitor-registration">
                    <MudStack Spacing="3" aria-busy="@_busy">
                        <MudTextField T="string" Label="Username" @bind-Value="_input.Username"
                                      Required="true" Immediate="true" Disabled="@_busy"
                                      HelperText="The username you will use to sign in." autocomplete="username" />
                        <MudTextField T="string" Label="Password" @bind-Value="_input.Password"
                                      InputType="InputType.Password" Required="true" Immediate="true" Disabled="@_busy"
                                      HelperText="Use 15 to 128 characters. Your password is checked against the operator's blocklist."
                                      autocomplete="new-password" />
                        <MudTextField T="string" Label="Confirm password" @bind-Value="_confirmation"
                                      InputType="InputType.Password" Required="true" Immediate="true" Disabled="@_busy"
                                      autocomplete="new-password" />
                        <MudTextField T="string" Label="Email (optional)" @bind-Value="_input.Email"
                                      InputType="InputType.Email" Immediate="true" Disabled="@_busy"
                                      autocomplete="email" />
                        <p>Email remains unverified until you verify it. Email password recovery is unavailable without a verified address.</p>
                        <AppButton ButtonType="ButtonType.Submit" Disabled="@_busy" FullWidth="true">
                            @(_busy ? "Creating account..." : "Create account")
                        </AppButton>
                    </MudStack>
                </EditForm>
            }
            else if (!_loading && _error is null)
            {
                <p role="status">Account creation is not available for this tenant.</p>
                <MudLink Href="/login">Return to sign in</MudLink>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly Input _input = new();
    private readonly CancellationTokenSource _lifetime = new();
    private IJSObjectReference? _module;
    private string _confirmation = string.Empty;
    private string? _error;
    private string? _loginPath;
    private bool _loading = true;
    private bool _canRegister;
    private bool _busy;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var response = await BffAuthApi.GetProvidersAsync(_lifetime.Token);
            if (_disposed) return;
            if (!response.IsSuccessStatusCode || response.Content is null)
                _error = "Account creation could not be checked. Please try again later.";
            else
                _canRegister = response.Content._links?.ContainsKey("local-register") == true;
        }
        catch (Exception exception) when (exception is HttpRequestException or Refit.ApiException or OperationCanceledException)
        {
            if (!_disposed) _error = "Account creation could not be checked. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync(EditContext context)
    {
        if (_busy || !_canRegister || _disposed) return;
        _error = null;
        if (string.IsNullOrWhiteSpace(_input.Username) || string.IsNullOrEmpty(_input.Password))
        {
            _error = "Enter a username and password.";
            return;
        }
        if (!string.Equals(_input.Password, _confirmation, StringComparison.Ordinal))
        {
            _error = "The passwords do not match.";
            return;
        }
        _busy = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _lifetime.Token, "./js/bff.js");
            var started = await _module.InvokeAsync<LocalVisitorEnrollmentBrowserResult>(
                "startLocalVisitorEnrollment", _lifetime.Token, ReturnUrl);
            if (_disposed) return;
            if (!started.Ok) { ShowFailure(started.Status); return; }
            var result = await _module.InvokeAsync<LocalVisitorEnrollmentBrowserResult>(
                "registerLocalVisitorEnrollment", _lifetime.Token,
                new LocalVisitorEnrollmentSubmission(_input.Username, _input.Password,
                    string.IsNullOrWhiteSpace(_input.Email) ? null : _input.Email.Trim()));
            if (_disposed) return;
            if (!result.Ok) { ShowFailure(result.Status); return; }
            if (result.State != "account_created" || !IsSafeLoginPath(result.LoginPath))
            {
                ShowFailure(503);
                return;
            }
            _loginPath = result.LoginPath;
        }
        catch (Exception exception) when (exception is JSException or OperationCanceledException)
        {
            if (!_disposed) ShowFailure(503);
        }
        finally
        {
            _input.Password = string.Empty;
            _confirmation = string.Empty;
            _busy = false;
        }
    }

    private void ShowFailure(int status)
    {
        _error = status switch
        {
            0 or 503 => "The outcome is not confirmed. Retry only with the same original credentials; do not start a different attempt.",
            401 or 403 or 409 => "This account creation attempt is no longer available. Return to sign in or begin a new attempt.",
            429 => "Too many attempts. Please wait before trying again.",
            _ => "The account details were rejected. Check the username, password and optional email."
        };
        if (status is 401 or 403 or 409) _canRegister = false;
    }

    private bool IsSafeLoginPath(string? path) =>
        path is not null && path.StartsWith('/') && !path.StartsWith("//", StringComparison.Ordinal)
        && !path.Contains('\\') && !path.Any(char.IsControl)
        && Uri.TryCreate(new Uri(Navigation.Uri), path, out var target)
        && target.GetLeftPart(UriPartial.Authority) == new Uri(Navigation.Uri).GetLeftPart(UriPartial.Authority)
        && target.AbsolutePath.EndsWith("/login", StringComparison.Ordinal);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _input.Password = string.Empty;
        _confirmation = string.Empty;
        await _lifetime.CancelAsync();
        _lifetime.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private sealed class Input
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? Email { get; set; }
        public override string ToString() => nameof(Input);
    }
}
