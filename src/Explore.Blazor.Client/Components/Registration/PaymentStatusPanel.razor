@using System.Globalization
@using Explore.Blazor.Client.Contracts.Services
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Localization
@implements IAsyncDisposable
@inject ITranslationService Translations
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService Focus
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<section class="payment-status" aria-labelledby="payment-status-heading" data-testid="payment-status" lang="@Translations.CurrentLanguage" dir="@Direction">
    <MudText Id="payment-status-heading" Typo="Typo.h5" HtmlTag="h2">@T("payment.heading", "Payment")</MudText>

    @if (_actionError is not null)
    {
        <div id="payment-action-error"
             class="payment-status__message payment-status__message--attention"
             tabindex="-1"
             data-testid="payment-action-error">@_actionError</div>
    }

    @if (_payment is null)
    {
        @if (_acceptance is not null && Start is not null)
        {
            <section class="payment-acceptance" aria-labelledby="payment-acceptance-heading" data-testid="payment-acceptance" lang="@Translations.CurrentLanguage" dir="@Direction">
                <MudText Id="payment-acceptance-heading" Typo="Typo.h6" HtmlTag="h3">@T("payment.acceptance.heading", "Review before payment")</MudText>
                <MudText Typo="Typo.body2" HtmlTag="p">@_acceptance.AcceptanceTemplateText</MudText>
                <dl>
                    <dt>@T("payment.acceptance.merchant", "Organizer merchant")</dt><dd data-testid="payment-acceptance-organizer-merchant">@_acceptance.OrganizerMerchant.MerchantDisclosureText</dd>
                    <dt>@T("payment.acceptance.directoryOperator", "Directory operator")</dt><dd data-testid="payment-acceptance-directory-operator">@_acceptance.TenantDirectoryOperator.PublicName (@_acceptance.TenantDirectoryOperator.LegalName), @_acceptance.TenantDirectoryOperator.JurisdictionCountryCode</dd>
                    <dt>@T("payment.acceptance.directoryLinks", "Directory legal information")</dt>
                    <dd class="payment-acceptance__links">
                        <a href="@_acceptance.TenantDirectoryOperator.LegalNoticeUrl" rel="noopener">@T("payment.operator.legal", "Legal notice")</a>
                        @if (!string.IsNullOrWhiteSpace(_acceptance.TenantDirectoryOperator.TermsUrl))
                        {
                            <a href="@_acceptance.TenantDirectoryOperator.TermsUrl" rel="noopener">@T("payment.operator.terms", "Terms")</a>
                        }
                        <a href="@_acceptance.TenantDirectoryOperator.PrivacyUrl" rel="noopener">@T("payment.operator.privacy", "Privacy")</a>
                    </dd>
                    <dt>@T("payment.acceptance.operator", "Instance operator")</dt><dd data-testid="payment-acceptance-instance-operator">@_acceptance.InstanceOperator.PublicName (@(_acceptance.InstanceOperator.IsOfficialInstance == true ? T("payment.operator.official", "official") : T("payment.operator.independent", "independent"))), @_acceptance.InstanceOperator.JurisdictionCountryCode</dd>
                    <dt>@T("payment.acceptance.officialOrigin", "Operator origin")</dt><dd data-testid="acceptance-official-origin">@_acceptance.InstanceOperator.OfficialOrigin</dd>
                    <dt>@T("payment.acceptance.activationStatus", "Payment activation status")</dt><dd data-testid="acceptance-activation-status">@_acceptance.PaymentOperations.ActivationStatus</dd>
                    <dt>@T("payment.acceptance.operatorLinks", "Operator legal information")</dt>
                    <dd class="payment-acceptance__links">
                        <a href="@_acceptance.InstanceOperator.WebsiteUrl" rel="noopener">@T("payment.operator.website", "Website")</a>
                        <a href="@_acceptance.InstanceOperator.LegalNoticeUrl" rel="noopener">@T("payment.operator.legal", "Legal notice")</a>
                        <a href="@_acceptance.InstanceOperator.TermsUrl" rel="noopener">@T("payment.operator.terms", "Terms")</a>
                        <a href="@_acceptance.InstanceOperator.PrivacyUrl" rel="noopener">@T("payment.operator.privacy", "Privacy")</a>
                    </dd>
                    <dt>@T("payment.acceptance.delivery", "Event schedule")</dt><dd>@FormatSchedule(_acceptance)</dd>
                    <dt>@T("payment.acceptance.organizerAmount", "Organizer amount")</dt><dd>@FormatMoney(_acceptance.OrganizerAmountMinor, _acceptance)</dd>
                    <dt>@T("payment.acceptance.platformFee", "Platform fee")</dt><dd>@FormatMoney(_acceptance.PlatformFeeMinor, _acceptance)</dd>
                    <dt>@T("payment.acceptance.platformContribution", "Platform contribution")</dt><dd>@FormatMoney(_acceptance.PlatformContributionMinor, _acceptance)</dd>
                    <dt>@T("payment.acceptance.total", "Total")</dt><dd><strong>@FormatMoney(_acceptance.TotalMinor, _acceptance)</strong></dd>
                    <dt>@string.Format(Culture, T("payment.acceptance.refundPolicy", "Refund policy (version {0})"), _acceptance.RefundPolicyVersion)</dt><dd lang="@_acceptance.RefundPolicyLanguageTag" dir="auto">@_acceptance.RefundPolicyText</dd>
                    <dt>@T("payment.acceptance.support", "Support")</dt><dd>@_acceptance.SupportContact</dd>
                    <dt>@T("payment.acceptance.complaints", "Complaints")</dt><dd>@_acceptance.PaymentOperations.ComplaintContact (@_acceptance.PaymentOperations.ComplaintOwner)</dd>
                    <dt>@T("payment.acceptance.operations", "Payment operations")</dt><dd>@_acceptance.PaymentOperations.RefundOwner; @_acceptance.PaymentOperations.DisputeOwner; @_acceptance.PaymentOperations.ReconciliationOwner</dd>
                    <dt>@T("payment.acceptance.payment", "Payment")</dt><dd>@_acceptance.OrganizerMerchant.ProviderCode (@_acceptance.OrganizerMerchant.ProviderEnvironment), @_acceptance.OrganizerMerchant.ChargeType, @T("payment.acceptance.credentialOwner", "credential owner") @_acceptance.OrganizerMerchant.ProviderCredentialOwner, @T("payment.acceptance.statementDescriptor", "statement descriptor") @_acceptance.OrganizerMerchant.StatementDescriptor</dd>
                    <dt>@T("payment.acceptance.providerProfile", "Provider profile")</dt><dd data-testid="acceptance-provider-profile">@_acceptance.OrganizerMerchant.ProviderProfileCode</dd>
                </dl>
                <section class="payment-acceptance__lines" aria-labelledby="payment-acceptance-lines-heading">
                    <MudText Id="payment-acceptance-lines-heading" Typo="Typo.subtitle2" HtmlTag="h4">@T("payment.acceptance.lines", "Accepted ticket lines")</MudText>
                    <ul>
                        @foreach (PaidOrderAcceptanceLineDto line in _acceptance.Lines)
                        {
                            <li data-testid="acceptance-line">
                                <MudText Typo="Typo.body1" HtmlTag="h5">@line.Name</MudText>
                                <dl>
                                    <dt>@T("payment.acceptance.lineQuantity", "Quantity")</dt><dd>@line.Quantity.ToString("N0", Culture)</dd>
                                    <dt>@T("payment.acceptance.lineUnitAmount", "Unit amount")</dt><dd>@FormatMoney(line.UnitAmountMinor, _acceptance)</dd>
                                    <dt>@T("payment.acceptance.lineDiscount", "Discount")</dt><dd>@FormatMoney(line.DiscountAmountMinor, _acceptance)</dd>
                                    <dt>@T("payment.acceptance.lineTotal", "Line total")</dt><dd>@FormatMoney(line.LineTotalMinor, _acceptance)</dd>
                                </dl>
                            </li>
                        }
                    </ul>
                </section>
                <label class="payment-acceptance__acknowledgement">
                    <input type="checkbox" checked="@_acknowledged" @onchange="SetAcknowledgement" data-testid="payment-acceptance-acknowledgement" />
                    @T("payment.acceptance.acknowledgement", "I have reviewed and accept these payment, schedule, refund, operator, support, and complaint facts.")
                </label>
                <AppButton Disabled="@(_isBusy || !_acknowledged)" OnClick="StartAsync" data-testid="start-payment">@T("payment.start", "Start payment")</AppButton>
            </section>
        }
    }
    else
    {
        <div id="payment-actionable-status"
             class="payment-status__message @StatusClass"
             tabindex="-1">
            <MudIcon Icon="@StatusIcon" aria-hidden="true" />
            <div dir="auto">
                <MudText Typo="Typo.subtitle1">@StatusTitle</MudText>
                <MudText Typo="Typo.body2">@StatusCopy</MudText>
                @if (_payment.LastUpdatedAt is { } updated)
                {
                    <MudText Typo="Typo.caption" dir="auto">@T("payment.lastUpdated", "Last updated") @updated.ToLocalTime().ToString("g", Culture)</MudText>
                }
            </div>
        </div>

        @if (_payment.Refunds is { Count: > 0 })
        {
            <section class="payment-status__refunds" aria-labelledby="payment-refunds-heading" data-testid="payment-refunds">
                <MudText Id="payment-refunds-heading" Typo="Typo.h6" HtmlTag="h3">@T("payment.refunds.heading", "Refunds")</MudText>
                <ul>
                    @foreach (RegistrationRefundDto refund in _payment.Refunds)
                    {
                        <li data-testid="payment-refund">
                            <span>@refund.StatusName</span>
                            <span>@FormatRefundMoney(refund.AmountMinor ?? 0, refund.CurrencyCode ?? _payment.CurrencyCode ?? "")</span>
                            <span>@T("payment.refunds.policy", "Accepted policy version") @refund.AcceptedRefundPolicyVersion</span>
                            @if (!string.IsNullOrWhiteSpace(refund.FailureCode))
                            {
                                <span>@T("payment.refunds.attention", "Attention required") (@refund.FailureCode)</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_payment.Disputes is { Count: > 0 })
        {
            <section class="payment-status__disputes" aria-labelledby="payment-disputes-heading" data-testid="payment-disputes">
                <MudText Id="payment-disputes-heading" Typo="Typo.h6" HtmlTag="h3">@T("payment.disputes.heading", "Payment disputes")</MudText>
                <ul>
                    @foreach (RegistrationPaymentDisputeDto dispute in _payment.Disputes)
                    {
                        <li data-testid="payment-dispute">
                            @dispute.StageCode — @dispute.StatusCode
                            @if (dispute.StatusCode == "Open" && dispute.ResponseDueAt is { } dueAt)
                            {
                                <span>@T("payment.disputes.respondBy", "Respond by") @dueAt.ToLocalTime().ToString("g", Culture)</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_payment.MaterialChangeChoices is { Count: > 0 })
        {
            <section class="payment-status__material-changes" aria-labelledby="payment-material-changes-heading" data-testid="payment-material-changes">
                <MudText Id="payment-material-changes-heading" Typo="Typo.h6" HtmlTag="h3">@T("payment.materialChange.heading", "Event changes")</MudText>
                <ul>
                    @foreach (var choice in _payment.MaterialChangeChoices)
                    {
                        <li data-testid="payment-material-change-choice">
                            <span>@(choice.StatusCode == "Pending"
                                ? T("payment.materialChange.pending", "Choose whether to accept the new event terms or request a refund.")
                                : choice.StatusCode)</span>
                            @if (choice.StatusCode == "Pending" && choice.CampaignId.HasValue && CanRespondMaterialChange)
                            {
                                <div class="payment-status__choice-actions">
                                    <AppButton Disabled="_isBusy" Variant="Variant.Outlined"
                                               OnClick="@(() => RespondMaterialChangeAsync(choice.CampaignId.Value, "accept_new_terms"))"
                                               data-testid="accept-material-change">@T("payment.materialChange.accept", "Accept new terms")</AppButton>
                                    <AppButton Disabled="_isBusy" Variant="Variant.Outlined"
                                               OnClick="@(() => RespondMaterialChangeAsync(choice.CampaignId.Value, "request_refund"))"
                                               data-testid="refund-material-change">@T("payment.materialChange.refund", "Request refund")</AppButton>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (!_isExpired)
        {
        <div class="payment-status__actions">
            @if (TryGetCheckoutUri(out var checkoutUri) && IssueCheckoutTicket is not null)
            {
                @if (_preparedCheckoutPath is null)
                {
                    <AppButton Disabled="_isBusy" OnClick="@(() => PrepareCheckoutAsync(checkoutUri))" data-testid="prepare-checkout">@T("payment.prepareCheckout", "Prepare secure checkout")</AppButton>
                }
                else
                {
                    <AppButton Href="@_preparedCheckoutPath" target="_blank" rel="opener" data-testid="checkout-redirect">@T("payment.continueCheckout", "Continue to secure checkout")</AppButton>
                }
            }
            @if (CanRetry)
            {
                <AppButton Disabled="_isBusy" Variant="Variant.Outlined" OnClick="RetryAsync" data-testid="retry-payment">@T("payment.retry", "Retry payment")</AppButton>
            }
            @if (CanRequestRefund)
            {
                <AppButton Disabled="_isBusy" Variant="Variant.Outlined" OnClick="RequestRefundAsync" data-testid="request-refund">@T("payment.refund.request", "Request remaining refund")</AppButton>
            }
        </div>
        }
    }
</section>

@code {
    [Parameter] public Func<string, CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? Start { get; set; }
    [Parameter] public Func<CancellationToken, Task<PaidOrderAcceptanceDisclosureDto?>>? LoadAcceptance { get; set; }
    [Parameter] public Func<CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? Load { get; set; }
    [Parameter] public Func<HalResourceOfRegistrationPaymentDto, CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? Refresh { get; set; }
    [Parameter] public Func<HalResourceOfRegistrationPaymentDto, CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? Retry { get; set; }
    [Parameter] public Func<HalResourceOfRegistrationPaymentDto, CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? RequestRefund { get; set; }
    [Parameter] public Func<HalResourceOfRegistrationPaymentDto, Guid, string, CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? RespondMaterialChange { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<string?>>? IssueCheckoutTicket { get; set; }
    [Parameter] public EventCallback Succeeded { get; set; }
    [Parameter] public EventCallback Expired { get; set; }
    [Parameter] public DateTimeOffset? OrderExpiresAt { get; set; }
    [Parameter] public TimeProvider Clock { get; set; } = TimeProvider.System;
    [Parameter] public Func<TimeSpan, CancellationToken, Task>? PollDelay { get; set; }

    private static readonly TimeSpan[] PollingBackoff =
        [TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(15)];
    private readonly CancellationTokenSource _disposeCancellation = new();
    private HalResourceOfRegistrationPaymentDto? _payment;
    private PaidOrderAcceptanceDisclosureDto? _acceptance;
    private string? _actionError;
    private bool _acknowledged;
    private bool _isBusy;
    private bool _initialized;
    private bool _isExpired;
    private bool _expiryReloaded;
    private int _pollAttempt;
    private Task? _pollingTask;
    private string? _preparedCheckoutPath;

    private string StatusCode => _payment?.StatusCode ?? "Unknown";
    private bool CanRetry => !_isExpired && _payment?._links?.ContainsKey("retry-payment") == true && Retry is not null;
    private bool CanRequestRefund => !_isExpired && _payment?._links?.ContainsKey("request-refund") == true && RequestRefund is not null;
    private bool CanRespondMaterialChange => !_isExpired && _payment?._links?.ContainsKey("respond-material-change") == true && RespondMaterialChange is not null;
    private bool HasNonterminalRefund => _payment?.Refunds?.Any(refund =>
        refund.StatusCode is "Requested" or "DispatchPending" or "Pending" or "RequiresAction" or "Unknown") == true;
    private bool ShouldPoll => !_isExpired && _payment?._links?.ContainsKey("payment-status") == true &&
        (StatusCode is "Created" or "Processing" or "RequiresAction" or "Unknown" || HasNonterminalRefund);
    private bool IsAttention => _isExpired || StatusCode is "Failed" or "Cancelled" or "NeedsReconciliation";
    private bool IsActionableError => StatusCode == "Failed" && CanRetry;
    private string StatusClass => IsAttention ? "payment-status__message--attention" : "payment-status__message--progress";
    private string StatusIcon => _isExpired ? Icons.Material.Filled.Schedule : StatusCode switch
    {
        "Succeeded" => Icons.Material.Filled.CheckCircle,
        "Failed" or "Cancelled" => Icons.Material.Filled.ErrorOutline,
        "NeedsReconciliation" => Icons.Material.Filled.SupportAgent,
        "RequiresAction" => Icons.Material.Filled.OpenInNew,
        _ => Icons.Material.Filled.HourglassTop
    };
    private CultureInfo Culture => TryCulture(Translations.CurrentLanguage);
    private string Direction =>
        CultureRegistry.TryGetEntry(Translations.CurrentLanguage, out CultureEntry entry) && entry.IsRtl
            ? "rtl"
            : "ltr";
    private string StatusTitle => _isExpired ? T("payment.status.expired.title", "Payment window expired") : StatusCode switch
    {
        "Created" => T("payment.status.created.title", "Payment created"),
        "Processing" => T("payment.status.processing.title", "Payment processing"),
        "RequiresAction" => T("payment.status.action.title", "Payment action required"),
        "Failed" => T("payment.status.failed.title", "Payment failed"),
        "Cancelled" => T("payment.status.cancelled.title", "Payment cancelled"),
        "Succeeded" => T("payment.status.succeeded.title", "Payment succeeded"),
        "NeedsReconciliation" => T("payment.status.review.title", "Payment needs review"),
        _ => T("payment.status.unknown.title", "Payment outcome unknown")
    };
    private string StatusCopy => _isExpired
        ? T("payment.status.expired.copy", "Automatic payment checks stopped at the server-provided expiry. Your order is being reloaded for current options.")
        : StatusCode switch
    {
        "Created" => T("payment.status.created.copy", "Your payment has been created and is waiting to continue."),
        "Processing" => T("payment.status.processing.copy", "The payment is still processing. This page will check again automatically."),
        "RequiresAction" => T("payment.status.action.copy", "Continue to secure checkout when the action is available."),
        "Failed" => T("payment.status.failed.copy", "The payment failed. Retry is available only when the server confirms it is safe."),
        "Cancelled" => T("payment.status.cancelled.copy", "The payment was cancelled. Any next action must be offered by the server."),
        "Succeeded" => T("payment.status.succeeded.copy", "Payment is confirmed by the server. Your order is being refreshed."),
        "NeedsReconciliation" => T("payment.status.review.copy", "The payment needs organizer review. Do not submit another payment."),
        _ => T("payment.status.unknown.copy", "The payment outcome is not known yet. Do not retry unless the server offers that action.")
    };

    protected override void OnInitialized() => Translations.OnLanguageChanged += HandleLanguageChanged;

    private void HandleLanguageChanged(string languageCode)
    {
        _ = languageCode;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        if (LoadAcceptance is not null)
        {
            try
            {
                _acceptance = await LoadAcceptance(_disposeCancellation.Token);
            }
            catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
            {
            }
            catch (Exception) when (!_disposeCancellation.IsCancellationRequested)
            {
                await ShowActionErrorAsync(T("payment.error.disclosureLoad", "Payment disclosures could not be loaded."), focus: false);
            }
        }

        if (Load is not null)
        {
            try
            {
                _payment = await Load(_disposeCancellation.Token);
                if (_payment is not null)
                {
                    if (await ExpireIfNeededAsync())
                    {
                        return;
                    }
                    await AnnounceAndFocusAsync();
                    if (StatusCode == "Succeeded")
                    {
                        await Succeeded.InvokeAsync();
                    }
                    else
                    {
                        StartPolling();
                    }
                }
            }
            catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
            {
            }
            catch (Exception) when (!_disposeCancellation.IsCancellationRequested)
            {
                await ShowActionErrorAsync(T("payment.error.statusLoad", "Payment status could not be loaded."), focus: false);
            }
        }
    }

    private Task StartAsync() => Start is null || _acceptance is null || !_acknowledged
        ? Task.CompletedTask
        : ExecuteAsync(cancellationToken => Start(_acceptance.DisclosureRevision, cancellationToken));

    private void SetAcknowledgement(ChangeEventArgs args) =>
        _acknowledged = args.Value is bool value && value;

    private Task RetryAsync() => Retry is null || _payment is null
        ? Task.CompletedTask
        : ExecuteAsync(cancellationToken => Retry(_payment, cancellationToken));

    private async Task RequestRefundAsync()
    {
        if (!CanRequestRefund || _payment is null)
        {
            return;
        }

        bool? confirmed = await Dialogs.ShowMessageBoxAsync(
            T("payment.refund.confirm.title", "Confirm refund request"),
            T("payment.refund.confirm.body", "Request a refund for the remaining captured amount? The provider result may take time."),
            yesText: T("payment.refund.confirm.yes", "Request refund"),
            cancelText: T("common.cancel", "Cancel"));
        if (confirmed == true)
        {
            await ExecuteAsync(cancellationToken => RequestRefund(_payment, cancellationToken));
        }
    }

    private async Task RespondMaterialChangeAsync(Guid campaignId, string choiceCode)
    {
        if (!CanRespondMaterialChange || _payment is null || RespondMaterialChange is null)
        {
            return;
        }

        bool refund = choiceCode == "request_refund";
        bool? confirmed = await Dialogs.ShowMessageBoxAsync(
            refund
                ? T("payment.materialChange.refundConfirmTitle", "Confirm refund request")
                : T("payment.materialChange.acceptConfirmTitle", "Confirm new event terms"),
            refund
                ? T("payment.materialChange.refundConfirmBody", "Request a refund instead of accepting the changed event terms?")
                : T("payment.materialChange.acceptConfirmBody", "Accept the changed event terms for this registration?"),
            yesText: refund
                ? T("payment.materialChange.refund", "Request refund")
                : T("payment.materialChange.accept", "Accept new terms"),
            cancelText: T("common.cancel", "Cancel"));
        if (confirmed == true)
        {
            await ExecuteAsync(cancellationToken =>
                RespondMaterialChange(_payment, campaignId, choiceCode, cancellationToken));
        }
    }

    private async Task ExecuteAsync(Func<CancellationToken, Task<HalResourceOfRegistrationPaymentDto?>>? operation)
    {
        if (_isBusy || operation is null)
        {
            return;
        }

        _isBusy = true;
        _actionError = null;
        try
        {
            _payment = await operation(_disposeCancellation.Token);
            if (_payment is null || _disposeCancellation.IsCancellationRequested)
            {
                await ShowActionErrorAsync(T("payment.error.action", "The payment action could not be completed."), focus: true);
                return;
            }

            if (await ExpireIfNeededAsync())
            {
                return;
            }

            await AnnounceAndFocusAsync();
            if (StatusCode == "Succeeded")
            {
                await Succeeded.InvokeAsync();
            }
            else
            {
                StartPolling();
            }
        }
        catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception) when (!_disposeCancellation.IsCancellationRequested)
        {
            await ShowActionErrorAsync(T("payment.error.action", "The payment action could not be completed."), focus: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (ShouldPoll && Refresh is not null && _payment is not null && !_disposeCancellation.IsCancellationRequested)
            {
                if (await ExpireIfNeededAsync())
                {
                    return;
                }

                TimeSpan delay = PollingBackoff[Math.Min(_pollAttempt, PollingBackoff.Length - 1)];
                _pollAttempt++;
                await DelayForPollAsync(delay, _disposeCancellation.Token);
                if (await ExpireIfNeededAsync())
                {
                    return;
                }

                var payment = await Refresh(_payment, _disposeCancellation.Token);
                if (payment is null || _disposeCancellation.IsCancellationRequested)
                {
                    return;
                }

                string previousStatus = StatusCode;
                _payment = payment;
                if (!string.Equals(previousStatus, StatusCode, StringComparison.Ordinal))
                {
                    await AnnounceAndFocusAsync();
                }
                await InvokeAsync(StateHasChanged);
                if (!string.Equals(previousStatus, StatusCode, StringComparison.Ordinal))
                {
                    if (StatusCode == "Succeeded")
                    {
                        await Succeeded.InvokeAsync();
                    }
                }
            }
        }
        catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception) when (!_disposeCancellation.IsCancellationRequested)
        {
            await ShowActionErrorAsync(T("payment.error.refresh", "Payment status could not be refreshed."), focus: false);
        }
    }

    private void StartPolling()
    {
        if (_pollingTask is { IsCompleted: false } || !ShouldPoll || Refresh is null)
        {
            return;
        }

        _pollAttempt = 0;
        _pollingTask = PollAsync();
    }

    private Task DelayForPollAsync(TimeSpan delay, CancellationToken cancellationToken) =>
        PollDelay is null
            ? Task.Delay(delay, Clock, cancellationToken)
            : PollDelay(delay, cancellationToken);

    private async Task<bool> ExpireIfNeededAsync()
    {
        DateTimeOffset? cutoff = EffectiveExpiry();
        if (_isExpired || cutoff is null || Clock.GetUtcNow() < cutoff.Value)
        {
            return _isExpired;
        }

        _isExpired = true;
        _actionError = null;
        await Announcer.AnnouncePoliteAsync(StatusCopy);
        await InvokeAsync(StateHasChanged);
        if (!_expiryReloaded)
        {
            _expiryReloaded = true;
            await Expired.InvokeAsync();
        }
        return true;
    }

    private DateTimeOffset? EffectiveExpiry()
    {
        DateTimeOffset? paymentExpiry = _payment?.ExpiresAt;
        if (paymentExpiry is null)
        {
            return OrderExpiresAt;
        }
        if (OrderExpiresAt is null)
        {
            return paymentExpiry;
        }
        return paymentExpiry < OrderExpiresAt ? paymentExpiry : OrderExpiresAt;
    }

    private Task AnnounceAsync() => IsAttention
        ? Announcer.AnnounceAssertiveAsync(StatusCopy)
        : Announcer.AnnouncePoliteAsync(StatusCopy);

    private async Task AnnounceAndFocusAsync()
    {
        if (IsActionableError && !_disposeCancellation.IsCancellationRequested)
        {
            await Focus.FocusAsync("#payment-actionable-status");
            return;
        }

        await AnnounceAsync();
    }

    private async Task ShowActionErrorAsync(string message, bool focus)
    {
        _actionError = message;
        await InvokeAsync(StateHasChanged);
        if (focus && !_disposeCancellation.IsCancellationRequested)
        {
            await Focus.FocusAsync("#payment-action-error");
            return;
        }


        await Announcer.AnnounceAssertiveAsync(message);
    }

    private bool TryGetCheckoutUri(out Uri checkoutUri)
    {
        checkoutUri = null!;
        var baseUri = new Uri(Navigation.BaseUri);
        string expectedPrefix = baseUri.AbsolutePath.TrimEnd('/') + "/bff/registration-payments/";
        if (_payment?._links is not { } links ||
            !links.TryGetValue("checkout-redirect", out var link) ||
            !string.Equals(link.Method, "POST", StringComparison.OrdinalIgnoreCase) ||
            !Uri.TryCreate(baseUri, link.Href, out var candidate) ||
            !string.Equals(candidate.Scheme, baseUri.Scheme, StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(candidate.Authority, baseUri.Authority, StringComparison.OrdinalIgnoreCase) ||
            candidate.Query.Length != 0 ||
            !candidate.AbsolutePath.StartsWith(expectedPrefix, StringComparison.Ordinal))
        {
            return false;
        }

        checkoutUri = candidate;
        return true;
    }

    private async Task PrepareCheckoutAsync(Uri checkoutUri)
    {
        if (_isBusy || IssueCheckoutTicket is null)
        {
            return;
        }

        _isBusy = true;
        _actionError = null;
        HalResourceOfRegistrationPaymentDto? payment = _payment;
        try
        {
            string? checkoutPath = await IssueCheckoutTicket(checkoutUri.AbsolutePath, _disposeCancellation.Token);
            if (_disposeCancellation.IsCancellationRequested || !ReferenceEquals(payment, _payment) ||
                !TryGetCheckoutUri(out Uri currentCheckoutUri) || currentCheckoutUri != checkoutUri)
            {
                return;
            }

            var baseUri = new Uri(Navigation.BaseUri);
            string expectedPath = baseUri.AbsolutePath.TrimEnd('/') + "/bff/registration-payments/checkout";
            if (checkoutPath is null || !Uri.TryCreate(baseUri, checkoutPath, out Uri? navigation) ||
                !string.Equals(navigation.Scheme, baseUri.Scheme, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(navigation.Authority, baseUri.Authority, StringComparison.OrdinalIgnoreCase) ||
                navigation.Query.Length != 0 ||
                !string.Equals(navigation.AbsolutePath, expectedPath, StringComparison.Ordinal))
            {
                await ShowActionErrorAsync(T("payment.error.checkout", "Secure checkout could not be opened."), focus: true);
                return;
            }

            _preparedCheckoutPath = navigation.AbsolutePath;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_disposeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception) when (!_disposeCancellation.IsCancellationRequested)
        {
            await ShowActionErrorAsync(T("payment.error.checkout", "Secure checkout could not be opened."), focus: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string T(string key, string fallback) => Translations.T(key, fallback);

    private static CultureInfo TryCulture(string languageCode)
    {
        try
        {
            return CultureInfo.GetCultureInfo(languageCode);
        }
        catch (CultureNotFoundException)
        {
            return CultureInfo.GetCultureInfo("en-GB");
        }
    }

    private string FormatMoney(long minorAmount, PaidOrderAcceptanceDisclosureDto disclosure)
    {
        int digits = disclosure.CurrencyMinorUnitDigits;
        decimal divisor = 1m;
        for (int index = 0; index < digits; index++) divisor *= 10m;
        decimal major = minorAmount / divisor;
        string number = major.ToString($"N{digits}", Culture);
        return Culture.NumberFormat.CurrencyPositivePattern is 1 or 3
            ? $"{number} {disclosure.CurrencyCode}"
            : $"{disclosure.CurrencyCode} {number}";
    }

    private string FormatRefundMoney(long minorAmount, string currencyCode)
    {
        int digits = _payment?.CurrencyCode == currencyCode ? _payment.CurrencyMinorUnitDigits ?? 2 : 2;
        decimal divisor = 1m;
        for (int index = 0; index < digits; index++) divisor *= 10m;
        return $"{currencyCode} {(minorAmount / divisor).ToString($"N{digits}", Culture)}";
    }

    private string FormatSchedule(PaidOrderAcceptanceDisclosureDto disclosure)
    {
        DateTimeOffset starts = disclosure.DeliveryStartsAtUtc;
        DateTimeOffset ends = disclosure.DeliveryEndsAtUtc;
        try
        {
            TimeZoneInfo zone = TimeZoneInfo.FindSystemTimeZoneById(disclosure.EventTimeZoneId);
            starts = TimeZoneInfo.ConvertTime(starts, zone);
            ends = TimeZoneInfo.ConvertTime(ends, zone);
        }
        catch (TimeZoneNotFoundException)
        {
        }
        catch (InvalidTimeZoneException)
        {
        }
        return $"{starts.ToString("g", Culture)} - {ends.ToString("g", Culture)} ({disclosure.EventTimeZoneId})";
    }

    public async ValueTask DisposeAsync()
    {
        Translations.OnLanguageChanged -= HandleLanguageChanged;
        _disposeCancellation.Cancel();
        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _disposeCancellation.Dispose();
    }
}
