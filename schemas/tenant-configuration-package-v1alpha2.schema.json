          "type": [
            "null",
            "string"
          ],
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "displayName": {
          "type": [
            "null",
            "string"
          ],
          "maxLength": 200
        },
        "faviconUrl": {
          "type": [
            "null",
            "string"
          ],
