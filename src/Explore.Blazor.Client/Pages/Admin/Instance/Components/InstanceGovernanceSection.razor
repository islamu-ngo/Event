    }

    private Task OnAllowOrganizationSelfRegistrationChangedAsync(bool value)
    {
        OrganizationPolicy.AllowOrganizationSelfRegistration = value;
        return SaveSettingsAsync(
            () => SaveOrganizationPolicyAsync(new OrganizationPolicyDto { AllowOrganizationSelfRegistration = value }),
