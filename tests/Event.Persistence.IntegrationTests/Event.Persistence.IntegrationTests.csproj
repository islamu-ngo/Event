<Project Sdk="Microsoft.NET.Sdk">

  <!-- The privacy meter factory is declared once and linked into every suite that builds
       privacy-instrumented services, so no lane invents its own meter root. -->
  <ItemGroup>
    <Compile Include="..\Shared\Telemetry\EventLocationPrivacyMetricsFactory.cs" Link="Telemetry\EventLocationPrivacyMetricsFactory.cs" />
    <Compile Include="..\Shared\Moderation\ModerationMeasurementJournalAttribute.cs" Link="Moderation\ModerationMeasurementJournalAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Infrastructure\Explore.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence\Explore.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.MySql\Explore.Persistence.Migrations.MySql.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.Sqlite\Explore.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.SqlServer\Explore.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.DataProtection.Migrations.Sqlite\Explore.Persistence.DataProtection.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.DataProtection.Migrations.SqlServer\Explore.Persistence.DataProtection.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.DataProtection.Migrations.MySql\Explore.Persistence.DataProtection.Migrations.MySql.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- SSH.NET: direct ref activates CPM pin 2026.0.0, remediating GHSA-q939-rpr3-3284 transitive via Testcontainers -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
