    [JSInvokable]
    public Task MovePromptReferenceSelectionAsync(int delta)
    {
        if (!IsReferenceAutocompleteVisible || ConversationState.ReferenceResults.Count == 0)
        {
            return Task.CompletedTask;
        }

        var count = ConversationState.ReferenceResults.Count;
        _activeReferenceIndex = ((_activeReferenceIndex + delta) % count + count) % count;
        StateHasChanged();
        return Task.CompletedTask;
    }

