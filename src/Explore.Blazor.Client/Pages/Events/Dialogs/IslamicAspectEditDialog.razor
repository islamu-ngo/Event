@* Allows setting Madhab, prayer timing, gender mode, Quran recitation, and language. *@

@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Contracts.Services.Lookup
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Components.Forms
@using MudBlazor

@inject IEventAspectService EventAspectService
@inject IMadhabService MadhabService
@inject ILanguageService LanguageService
@inject ILogger<IslamicAspectEditDialog> Logger

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Mosque" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(IsNew ? "Add Islamic Characteristics" : "Edit Islamic Characteristics")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <EditForm EditContext="_editContext">
                <FormSubmissionGuard State="@_submitState">
                <AppValidationSummary />
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?"
                                   Label="Madhab (School of Jurisprudence)"
                                   @bind-Value="_model.MadhabId"
                                   Clearable="true"
                                   Variant="Variant.Outlined">
                            @foreach (var madhab in _madhabs)
                            {
                                <MudSelectItem T="int?" Value="@madhab.Id">@madhab.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="GenderSegregationMode?"
                                   Label="Gender Mode"
                                   @bind-Value="_model.GenderMode"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="GenderSegregationMode?" Value="GenderSegregationMode.Mixed">Mixed</MudSelectItem>
                            <MudSelectItem T="GenderSegregationMode?" Value="GenderSegregationMode.MenOnly">Men Only</MudSelectItem>
                            <MudSelectItem T="GenderSegregationMode?" Value="GenderSegregationMode.WomenOnly">Women Only</MudSelectItem>
                            <MudSelectItem T="GenderSegregationMode?" Value="GenderSegregationMode.Segregated">Segregated</MudSelectItem>
                            <MudSelectItem T="GenderSegregationMode?" Value="GenderSegregationMode.Family">Family</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="PrayerTime?"
                                   Label="Reference Prayer Time"
                                   @bind-Value="_model.ReferencePrayer"
                                   Clearable="true"
                                   HelperText="Schedule event relative to a prayer time"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomLeft"
                                   TransformOrigin="Origin.TopLeft"
                                   DropdownWidth="DropdownWidth.Relative">
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Fajr">Fajr</MudSelectItem>
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Sunrise">Sunrise</MudSelectItem>
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Dhuhr">Dhuhr</MudSelectItem>
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Asr">Asr</MudSelectItem>
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Maghrib">Maghrib</MudSelectItem>
                            <MudSelectItem T="PrayerTime?" Value="PrayerTime.Isha">Isha</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int?"
                                         Label="Prayer Time Offset (minutes)"
                                         @bind-Value="_model.PrayerTimeOffset"
                                         Disabled="@(_model.ReferencePrayer == null)"
                                         HelperText="Minutes before (-) or after (+) prayer"
                                         Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?"
                                   Label="Primary Language"
                                   @bind-Value="_model.PrimaryLanguageId"
                                   Clearable="true"
                                   Variant="Variant.Outlined">
                            @foreach (var language in _languages)
                            {
                                <MudSelectItem T="int?" Value="@language.Id">@language.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool?"
                                     @bind-Value="_model.IncludesQuranRecitation"
                                     Label="Includes Quran Recitation"
                                     Color="Color.Primary" />
                    </MudItem>
                </MudGrid>
                </FormSubmissionGuard>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" OnClick="Cancel" Variant="Variant.Text" Disabled="_submitState.IsSubmitting">Cancel</MudButton>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@(_isLoading || _submitState.IsSubmitting)">
            @if (_submitState.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid EventId { get; set; }

    [Parameter]
    public EventIslamicAspectDto? ExistingAspect { get; set; }

    private bool IsNew => ExistingAspect == null;

    private bool _isLoading = true;
    
    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    private CreateUpdateIslamicAspectDto _model = new();
    private ICollection<MadhabListDto> _madhabs = new List<MadhabListDto>();
    private ICollection<LanguageListDto> _languages = new List<LanguageListDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();

        if (ExistingAspect != null)
        {
            _model = new CreateUpdateIslamicAspectDto
            {
                MadhabId = ExistingAspect.MadhabId,
                ReferencePrayer = ExistingAspect.ReferencePrayer,
                PrayerTimeOffset = ExistingAspect.PrayerTimeOffset,
                GenderMode = ExistingAspect.GenderMode,
                IncludesQuranRecitation = ExistingAspect.IncludesQuranRecitation,
                PrimaryLanguageId = ExistingAspect.PrimaryLanguageId
            };
        }

        _editContext = new EditContext(_model);
        _errorStore.Init(_editContext);

        _isLoading = false;
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var madhabsTask = MadhabService.GetMadhabsAsync();
            var languagesTask = LanguageService.GetLanguagesAsync();

            await Task.WhenAll(madhabsTask, languagesTask);

            _madhabs = await madhabsTask;
            _languages = await languagesTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load lookups for Islamic aspect dialog");
            _submitState.Fail("Failed to load form data");
        }
    }

    private async Task SaveAsync()
    {
        if (_submitState.IsSubmitting) return;
        if (!_editContext.Validate()) return;

        _submitState.Start();

        try
        {
            var response = IsNew
                ? await EventAspectService.CreateIslamicAspectAsync(EventId, _model)
                : await EventAspectService.UpdateIslamicAspectAsync(EventId, new UpdateEventIslamicAspectDto
                {
                    Jurisprudence = new UpdateEventIslamicJurisprudenceDto
                    {
                        MadhabId = new OptionalUpdateOfint { HasValue = true, Value = _model.MadhabId }
                    },
                    PrayerSchedule = new UpdateEventIslamicPrayerScheduleDto
                    {
                        ReferencePrayer = new OptionalUpdateOfPrayerTime { HasValue = true, Value = _model.ReferencePrayer },
                        PrayerTimeOffset = new OptionalUpdateOfint { HasValue = true, Value = _model.PrayerTimeOffset }
                    },
                    Participation = new UpdateEventIslamicParticipationDto
                    {
                        GenderMode = _model.GenderMode,
                        IncludesQuranRecitation = _model.IncludesQuranRecitation
                    },
                    Language = new UpdateEventIslamicLanguageDto
                    {
                        PrimaryLanguageId = new OptionalUpdateOfint { HasValue = true, Value = _model.PrimaryLanguageId }
                    }
                });

            if (response?.Success == true)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMessage = response?.Errors?.FirstOrDefault() ?? "Failed to save Islamic characteristics";
                _submitState.Fail(errorMessage);
            }
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Failed to save aspect: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving Islamic aspect for event {EventId}", EventId);
            _submitState.Fail("An error occurred while saving");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
