@typeparam T
@using System.Linq.Expressions

<div class="app-text-field">
    <MudTextField T="T"
                  Value="@Value"
                  ValueChanged="@OnValueChangedAsync"
                  Variant="@Variant"
                  Margin="@Margin"
                  InputType="@InputType"
                  Adornment="@Adornment"
                  AdornmentIcon="@AdornmentIcon"
                  Dense="@Dense"
                  Required="@Required"
                  Disabled="@Disabled"
                  ReadOnly="@ReadOnly"
                  Error="@Error"
                  ErrorText="@ErrorText"
                  Id="@Id"
                  Immediate="@Immediate"
                  Clearable="@Clearable"
                  FullWidth="@FullWidth"
                  Lines="@Lines"
                  MaxLength="@MaxLength"
                  Placeholder="@Placeholder"
                  DebounceInterval="@DebounceInterval"
                  For="@For"
                  Class="@Class"
                  @attributes="FilteredAttributes" />
</div>

@code {
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T> ValueChanged { get; set; }

    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public InputType InputType { get; set; } = InputType.Text;
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    [Parameter] public string? AdornmentIcon { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public int MaxLength { get; set; } = 524288;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public double DebounceInterval { get; set; }
    [Parameter] public Expression<Func<T>>? For { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnValueChangedAsync(T? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private IDictionary<string, object>? FilteredAttributes
    {
        get
        {
            if (AdditionalAttributes is null)
                return null;

            var filtered = new Dictionary<string, object>(AdditionalAttributes);
            // Remove string-valued event handlers that would cause type errors
            var eventHandlers = new[] { "TextChanged", "OnKeyUp" };
            foreach (var handler in eventHandlers)
            {
                if (filtered.TryGetValue(handler, out var value) && value is string)
                {
                    filtered.Remove(handler);
                }
            }
            return filtered;
        }
    }
}
