@* ABOUTME: Instance admin settings section for authentication and authorization provider management. *@
@* ABOUTME: Uses explicit enable/disable actions while preserving onboarding provider configuration state. *@

@using Explore.Blazor.Client.Contracts.Interop
@using Explore.Blazor.Client.Services
@using MudBlazor

@inject IDialogService DialogService
@inject IBrowserActionInterop BrowserActionInterop

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Authentication and Authorization Providers</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure how users sign in and how protected operations are authorized on this instance.
        </MudText>
    </div>

    <MudStack Spacing="4">
        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Authentication Providers</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Choose Local Identity, Keycloak, or passwordless AT Protocol as the primary sign-in authority.
                    </MudText>
                </div>

                <MudAlert Severity="Severity.Info" Dense="true">
                    Existing sessions remain valid when the primary provider changes. Create and verify administrator credentials with the target provider before saving a switch.
                </MudAlert>

                <MudRadioGroup T="int"
                               Value="CurrentPrimaryProviderId"
                               ValueChanged="SelectPrimaryProviderAsync"
                               aria-label="Primary authentication provider">
                    <MudPaper Outlined="true" Class="pa-4 mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <div>
                                <MudRadio T="int"
                                          Value="LocalIdentityProviderId"
                                          Color="Color.Primary"
                                          Dense="true"
                                          Disabled="@(Model.LockPrimaryProvider == true)"
                                          data-testid="primary-provider-local">
                                    Local Identity
                                </MudRadio>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ms-8">
                                    Built-in ASP.NET Core Identity credentials with no external identity service.
                                </MudText>
                            </div>
                            @ProviderStatusChip(IsLocalIdentityPrimary)
                        </MudStack>
                    </MudPaper>

                    <MudPaper Outlined="true" Class="pa-4 mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <div>
                                <MudRadio T="int"
                                          Value="AtprotoProviderId"
                                          Color="Color.Primary"
                                          Dense="true"
                                          Disabled="@(Model.LockPrimaryProvider == true)"
                                          data-testid="primary-provider-atproto">
                                    AT Protocol
                                </MudRadio>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ms-8">
                                    Passwordless decentralized sign-in through each user's personal data server.
                                </MudText>
                            </div>
                            @ProviderStatusChip(IsAtprotoPrimary)
                        </MudStack>
                    </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudRadio T="int"
                                          Value="KeycloakProviderId"
                                          Color="Color.Primary"
                                          Dense="true"
                                          Disabled="@(Model.LockPrimaryProvider == true)"
                                          data-testid="primary-provider-keycloak">
                                    Keycloak
                                </MudRadio>
                                <MudTooltip Text="Self-hosted OIDC provider for full identity management control.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </MudTooltip>
                                @if (Model.KeycloakDetectedFromEnvironment == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Auto-detected</MudChip>
                                }
                                @ProviderStatusChip(IsKeycloakPrimary)
                            </MudStack>
                        </MudStack>

                        <MudTextField Variant="Variant.Outlined" T="string" Label="Authority URL" @bind-Value="Model.KeycloakAuthority"
                                      HelperText="Configure and verify the target realm before switching the primary provider." />
                        <MudTextField Variant="Variant.Outlined" T="string" Label="Client ID" @bind-Value="Model.KeycloakClientId" />
                        <MudTextField Variant="Variant.Outlined" T="string" Label="Client Secret" InputType="InputType.Password"
                                      @bind-Value="Model.KeycloakClientSecret" autocomplete="new-password" />

                        <section class="instance-auth-provider__visitor-onboarding"
                                 aria-labelledby="keycloak-public-onboarding-heading">
                            <MudText Id="keycloak-public-onboarding-heading" Typo="Typo.subtitle2" HtmlTag="h3">
                                Keycloak visitor signup
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                This controls new public visitor accounts, not operator or existing-account sign-in.
                            </MudText>
                            <MudSelect T="PublicOnboardingPolicy?"
                                       Label="Public onboarding policy"
                                       @bind-Value="Model.KeycloakPublicOnboardingPolicy"
                                       Variant="Variant.Outlined"
                                       data-testid="keycloak-public-onboarding-policy">
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingUnknown)">Unknown - do not advertise signup</MudSelectItem>
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingAllowed)">Allowed</MudSelectItem>
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingDenied)">Denied</MudSelectItem>
                            </MudSelect>
                            @if (Model.KeycloakPublicOnboardingPolicy == PublicOnboardingAllowed)
                            {
                                <MudTextField T="string"
                                              Label="Public signup URL"
                                              @bind-Value="Model.KeycloakPublicSignupUrl"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              HelperText="Use the exact public HTTPS account-registration destination." />
                                @PublicSignupUrlWarning(Model.KeycloakPublicSignupUrl)
                            }
                        </section>

                        @if (IsKeycloakPrimary)
                        {
                            <MudPaper Outlined="true" Class="pa-4 mt-2">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <div>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.subtitle2">Keycloak client-secret rotation</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@OwnershipChipColor(Model.KeycloakClientSecretOwnership)" Variant="Variant.Outlined">
                                                    @(Model.KeycloakClientSecretOwnership?.Badge ?? "Unknown")
                                                </MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Rotates only the configured confidential Blazor client secret. Secret values and temporary admin credentials are cleared after submit and never returned.
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Warning"
                                                   StartIcon="@(_isRotatingKeycloakClientSecret ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.VpnKey)"
                                                   Disabled="@(!CanRotateKeycloakClientSecret)"
                                                   OnClick="RotateKeycloakClientSecretAsync">
                                            @(_isRotatingKeycloakClientSecret ? "Rotating..." : "Rotate Client Secret")
                                        </MudButton>
                                    </MudStack>

                                    <MudAlert Severity="@OwnershipAlertSeverity(Model.KeycloakClientSecretOwnership)" Dense="true">
                                        @Model.KeycloakClientSecretOwnership?.Description
                                    </MudAlert>

                                    @if (IsKeycloakSecretApplicationManaged)
                                    {
                                        <MudTextField Variant="Variant.Outlined" T="string" Label="New client secret" InputType="InputType.Password" @bind-Value="_newKeycloakClientSecret" />
                                        <MudTextField Variant="Variant.Outlined" T="string" Label="Temporary admin username" @bind-Value="_rotationKeycloakAdminUsername" />
                                        <MudTextField Variant="Variant.Outlined" T="string" Label="Temporary admin password" InputType="InputType.Password" @bind-Value="_rotationKeycloakAdminPassword" />
                                        <MudCheckBox T="bool" @bind-Value="_confirmApplicationManagedKeycloakSecret" Color="Color.Warning">
                                            I understand the platform will store this new application-managed Keycloak client secret and refresh authentication schemes after rotation.
                                        </MudCheckBox>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                            Deployment-managed secrets must be rotated in the deployment secret provider and the matching Keycloak client. The application will not store or overwrite them.
                                        </MudAlert>
                                    }

                                    @if (_keycloakSecretRotationResult is not null)
                                    {
                                        <MudAlert Severity="@PlanSeverity(_keycloakSecretRotationResult.Status)" Dense="true">
                                            @_keycloakSecretRotationResult.Message
                                        </MudAlert>
                                        @if (!string.IsNullOrWhiteSpace(_keycloakSecretRotationResult.OperatorInstructions))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_keycloakSecretRotationResult.OperatorInstructions</MudText>
                                        }
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Outlined="true" Class="pa-4 mt-2">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Keycloak realm doctor</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Runs read-only diagnostics against the configured realm. Temporary admin credentials are used only for this request and are cleared after the run.
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@(_isRunningKeycloakDoctor ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.HealthAndSafety)"
                                                   Disabled="@(!CanRunKeycloakDoctor)"
                                                   OnClick="RunKeycloakDoctorAsync">
                                            @(_isRunningKeycloakDoctor ? "Running..." : "Run Doctor")
                                        </MudButton>
                                    </MudStack>

                                    <MudSwitch T="bool" @bind-Value="_useTemporaryKeycloakAdmin" Color="Color.Primary">
                                        Include temporary admin read-only inspection
                                    </MudSwitch>

                                    @if (_useTemporaryKeycloakAdmin)
                                    {
                                        <MudTextField Variant="Variant.Outlined" T="string" Label="Temporary admin username" @bind-Value="_temporaryKeycloakAdminUsername" />
                                        <MudTextField Variant="Variant.Outlined" T="string" Label="Temporary admin password" InputType="InputType.Password" @bind-Value="_temporaryKeycloakAdminPassword" />
                                    }

                                    @if (_keycloakDoctorResult is not null)
                                    {
                                        <MudAlert Severity="@DoctorSeverity(_keycloakDoctorResult.OverallStatus)" Dense="true">
                                            @_keycloakDoctorResult.Message
                                        </MudAlert>

                                        <MudStack Spacing="1">
                                            @foreach (var check in _keycloakDoctorResult.Checks ?? [])
                                            {
                                                <MudAlert Severity="@DoctorSeverity(check.Status)" Dense="true" NoIcon="true">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.subtitle2">@check.Name</MudText>
                                                        <MudText Typo="Typo.body2">@check.Message</MudText>
                                                        @if (!string.IsNullOrWhiteSpace(check.Remediation))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@check.Remediation</MudText>
                                                        }
                                                    </MudStack>
                                                </MudAlert>
                                            }
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Outlined="true" Class="pa-4 mt-2">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Keycloak sync preview</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Builds a read-only additive sync plan from the configured realm, then applies only backup-confirmed additive repairs.
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@(_isPreviewingKeycloakSync ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Preview)"
                                                   Disabled="@(!CanPreviewKeycloakSync)"
                                                   OnClick="PreviewKeycloakSyncAsync">
                                            @(_isPreviewingKeycloakSync ? "Previewing..." : "Preview Sync")
                                        </MudButton>
                                     </MudStack>

                                     <MudAlert Severity="Severity.Info" Dense="true">
                                        Preview is read-only. Apply requires a confirmed Keycloak backup, uses the temporary admin fields above, clears the password after the request, and never deletes realms, users, groups, or unrelated clients.
                                     </MudAlert>

                                     <MudCheckBox T="bool" @bind-Value="_keycloakBackupConfirmed" Color="Color.Warning">
                                          I have a current Keycloak backup and understand apply only adds or updates platform-owned realm settings.
                                     </MudCheckBox>

                                     <MudButton Variant="Variant.Filled"
                                                Color="Color.Warning"
                                                StartIcon="@(_isApplyingKeycloakSync ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Build)"
                                                Disabled="@(!CanApplyKeycloakSync)"
                                                OnClick="ApplyKeycloakSyncAsync">
                                         @(_isApplyingKeycloakSync ? "Applying..." : "Apply Additive Repairs")
                                     </MudButton>

                                     @if (_keycloakSyncPlan is not null)
                                     {
                                        <MudAlert Severity="@PlanSeverity(_keycloakSyncPlan.Status)" Dense="true">
                                            @_keycloakSyncPlan.Message
                                        </MudAlert>

                                        <MudStack Spacing="1">
                                            @foreach (var operation in _keycloakSyncPlan.Operations ?? [])
                                            {
                                                <MudAlert Severity="@PlanSeverity(operation.Status)" Dense="true" NoIcon="true">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.subtitle2">@operation.Summary</MudText>
                                                        <MudText Typo="Typo.body2">@operation.Reason</MudText>
                                                        @if (operation.Changes?.Count > 0)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Join("; ", operation.Changes!)</MudText>
                                                        }
                                                    </MudStack>
                                                </MudAlert>
                                            }
                                        </MudStack>

                                        @if (_keycloakSyncPlan.DesiredState?.Clients?.Count > 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Desired clients: @string.Join(", ", _keycloakSyncPlan.DesiredState.Clients.Select(client => client.ClientId))
                                            </MudText>
                                        }
                                    }
                                </MudStack>
                            </MudPaper>
                        }

                        @if (!IsSingleTenant)
                        {
                            <MudSwitch T="bool" Value="@(Model.LockPrimaryProvider == true)" ValueChanged="@(value => Model.LockPrimaryProvider = value)" Color="Color.Warning">
                                Lock primary provider for tenants
                            </MudSwitch>
                        }
                    </MudStack>
                </MudPaper>
                </MudRadioGroup>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">AT Protocol Login</MudText>
                                <MudTooltip Text="Users authenticate with linked AT Protocol identities through the server-side OAuth flow.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </MudTooltip>
                                @ProviderStatusChip(Model.AtprotoLoginEnabled == true)
                            </MudStack>
                            @if (IsAtprotoPrimary)
                            {
                                <MudSwitch T="bool"
                                           Value="true"
                                           Disabled="true"
                                           Color="Color.Primary"
                                           data-testid="atproto-login-toggle">
                                    Required for AT Protocol primary mode
                                </MudSwitch>
                            }
                            else
                            {
                                @AuthenticationProviderButton("AT Protocol Login", Model.AtprotoLoginEnabled == true, () => SetAuthenticationProviderAsync("AT Protocol Login", v => Model.AtprotoLoginEnabled = v, Model.AtprotoLoginEnabled == true))
                            }
                        </MudStack>

                        @if (IsAtprotoPrimary)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                AT Protocol is the sole primary authority. Its login axis cannot be disabled, and Google SSO is unavailable in this mode.
                            </MudAlert>
                        }

                        @if (Model.AtprotoLoginEnabled == true)
                        {
                            <MudTextField Variant="Variant.Outlined" T="string" Label="Public URL" @bind-Value="Model.AtprotoPublicUrl" HelperText="Used to serve ATProto OAuth client metadata." />
                        }

                        @if (!IsSingleTenant)
                        {
                            <MudSwitch T="bool" Value="@(Model.LockAtprotoLoginEnabled == true)" ValueChanged="@(value => Model.LockAtprotoLoginEnabled = value)" Color="Color.Warning">
                                Lock AT Protocol setting for tenants
                            </MudSwitch>
                        }
                    </MudStack>
                </MudPaper>

                @if (!IsAtprotoPrimary)
                {
                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Google SSO</MudText>
                                <MudTooltip Text="OAuth sign-in using Google accounts.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </MudTooltip>
                                @ProviderStatusChip(Model.GoogleSsoEnabled == true)
                            </MudStack>
                            @AuthenticationProviderButton("Google SSO", Model.GoogleSsoEnabled == true, () => SetAuthenticationProviderAsync("Google SSO", v => Model.GoogleSsoEnabled = v, Model.GoogleSsoEnabled == true))
                        </MudStack>

                        @if (Model.GoogleSsoEnabled == true)
                        {
                            <MudTextField Variant="Variant.Outlined" T="string" Label="Client ID" @bind-Value="Model.GoogleClientId" />
                            <MudTextField Variant="Variant.Outlined" T="string" Label="Client Secret" InputType="InputType.Password" @bind-Value="Model.GoogleClientSecret" />
                        }

                        <section class="instance-auth-provider__visitor-onboarding"
                                 aria-labelledby="google-public-onboarding-heading">
                            <MudText Id="google-public-onboarding-heading" Typo="Typo.subtitle2" HtmlTag="h3">
                                Google visitor signup
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                This controls new public visitor accounts, not operator or existing-account sign-in.
                            </MudText>
                            <MudSelect T="PublicOnboardingPolicy?"
                                       Label="Public onboarding policy"
                                       @bind-Value="Model.GooglePublicOnboardingPolicy"
                                       Variant="Variant.Outlined"
                                       data-testid="google-public-onboarding-policy">
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingUnknown)">Unknown - do not advertise signup</MudSelectItem>
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingAllowed)">Allowed</MudSelectItem>
                                <MudSelectItem T="PublicOnboardingPolicy?" Value="@((PublicOnboardingPolicy?)PublicOnboardingDenied)">Denied</MudSelectItem>
                            </MudSelect>
                            @if (Model.GooglePublicOnboardingPolicy == PublicOnboardingAllowed)
                            {
                                <MudTextField T="string"
                                              Label="Public signup URL"
                                              @bind-Value="Model.GooglePublicSignupUrl"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              HelperText="Use the exact public HTTPS account-registration destination." />
                                @PublicSignupUrlWarning(Model.GooglePublicSignupUrl)
                            }
                        </section>

                        @if (!IsSingleTenant)
                        {
                            <MudSwitch T="bool" Value="@(Model.LockGoogleSsoEnabled == true)" ValueChanged="@(value => Model.LockGoogleSsoEnabled = value)" Color="Color.Warning">
                                Lock Google setting for tenants
                            </MudSwitch>
                        }
                    </MudStack>
                </MudPaper>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Authorization Providers</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Exactly one authorization provider is active. Cerbos mode fails closed when the external PDP is unavailable.
                    </MudText>
                </div>

                @if (IsDeploymentAuthorizationProvider)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Authorization is managed by deployment configuration. Change <code>AUTHORIZATION_PROVIDER</code> and related Cerbos settings at the deployment source; authentication-provider management remains available here.
                    </MudAlert>
                }

                <MudPaper Outlined="true" Class="pa-4" Style="@GetAuthorizationCardStyle(LocalProvider)">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Local (Built-in RBAC)</MudText>
                                <MudTooltip Text="Use the built-in authorization implementation with no external Cerbos dependency.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </MudTooltip>
                                @ProviderStatusChip(IsAuthorizationProviderSelected(LocalProvider))
                            </MudStack>
                            @if (!IsDeploymentAuthorizationProvider)
                            {
                                <MudButton Variant="@(IsAuthorizationProviderSelected(LocalProvider) ? Variant.Outlined : Variant.Filled)"
                                           Color="Color.Primary"
                                           Disabled="@IsAuthorizationProviderSelected(LocalProvider)"
                                           OnClick="@(() => SelectAuthorizationProviderAsync(LocalProvider))">
                                    @(IsAuthorizationProviderSelected(LocalProvider) ? "Enabled" : "Enable Local Authorization")
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4" Style="@GetAuthorizationCardStyle(CerbosProvider)">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Cerbos (External PDP)</MudText>
                                <MudTooltip Text="Route protected authorization checks to Cerbos. When selected, authorized requests are denied if Cerbos is unavailable.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </MudTooltip>
                                @if (AuthorizationModel.CerbosDetectedFromEnvironment == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Auto-detected</MudChip>
                                }
                                <MudChip T="string" Size="Size.Small" Color="@OwnershipChipColor(AuthorizationModel.CerbosEndpointOwnership)" Variant="Variant.Outlined">@(AuthorizationModel.CerbosEndpointOwnership?.Badge ?? "Unknown")</MudChip>
                                @if (AuthorizationModel.CerbosEndpointVerified == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Verified</MudChip>
                                }
                                @ProviderStatusChip(IsAuthorizationProviderSelected(CerbosProvider))
                            </MudStack>
                            @if (!IsDeploymentAuthorizationProvider)
                            {
                                <MudButton Variant="@(IsAuthorizationProviderSelected(CerbosProvider) ? Variant.Outlined : Variant.Filled)"
                                           Color="Color.Primary"
                                           Disabled="@IsAuthorizationProviderSelected(CerbosProvider)"
                                           OnClick="@(() => SelectAuthorizationProviderAsync(CerbosProvider))">
                                    @(IsAuthorizationProviderSelected(CerbosProvider) ? "Enabled" : "Enable Cerbos Authorization")
                                </MudButton>
                            }
                        </MudStack>

                        @if (IsAuthorizationProviderSelected(CerbosProvider))
                        {
                            @if (AuthorizationModel.CerbosDetectedFromEnvironment == true && AuthorizationModel.CerbosEndpointVerified == true)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                                    Cerbos was detected from environment and verified successfully during setup.
                                </MudAlert>
                            }
                            else if (AuthorizationModel.CerbosDetectedFromEnvironment == true)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    A Cerbos endpoint was detected from environment, but it is not currently marked verified. Saving Cerbos will verify the endpoint before applying it.
                                </MudAlert>
                            }

                            <MudAlert Severity="@OwnershipAlertSeverity(AuthorizationModel.CerbosEndpointOwnership)" Dense="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@(AuthorizationModel.CerbosEndpointOwnership?.Badge ?? "Unknown")</MudText>
                                    <MudText Typo="Typo.body2">@AuthorizationModel.CerbosEndpointOwnership?.Description</MudText>
                                </MudStack>
                            </MudAlert>

                            <MudTextField Variant="Variant.Outlined" T="string"
                                          Label="Cerbos gRPC Endpoint"
                                          Value="AuthorizationModel.CerbosGrpcEndpoint"
                                          ValueChanged="OnCerbosEndpointChanged"
                                          Placeholder="https://cerbosgrpc.example.com:443 or cerbosgrpc.example.com:443"
                                          Disabled="@IsCerbosEndpointReadOnly"
                                          HelperText="@CerbosEndpointHelperText" />

                            @if (AuthorizationModel.CerbosEndpointVerified != true)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    Saving with Cerbos enabled will test the endpoint before changing the active authorization provider.
                                </MudAlert>
                            }

                            <MudPaper Outlined="true" Class="pa-4 mt-2">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Policy package sync</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Publish the latest embedded authorization policy bundle through the BFF using @((AuthorizationModel.CerbosAdminCredentialsOwnership?.Badge ?? "configured").ToLowerInvariant()) server-side credentials, or download the same package for manual cerbosctl put installation. The browser never owns the Admin API password.
                                            </MudText>
                                        </div>
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       StartIcon="@(_isDownloadingPackage ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Download)"
                                                       Disabled="@(!CanDownloadCerbosPackage)"
                                                       OnClick="DownloadCerbosPolicyPackageAsync">
                                                @(_isDownloadingPackage ? "Preparing ZIP..." : "Download ZIP")
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       StartIcon="@(_isSyncing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Sync)"
                                                       Disabled="@(!CanSyncCerbosPolicies)"
                                                       OnClick="SyncCerbosPoliciesAsync">
                                                @(_isSyncing ? "Syncing..." : IsDeploymentAuthorizationProvider ? "Retry Authorization Setup" : "Sync Policies")
                                            </MudButton>
                                        </MudStack>
                                    </MudStack>

                                    @if (AuthorizationModel.CerbosEndpointVerified != true)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">
                                            @(IsDeploymentAuthorizationProvider
                                                ? "Fix the deployment-managed Cerbos settings, then retry endpoint verification and policy synchronization."
                                                : "Save and verify the Cerbos endpoint before syncing authorization policies.")
                                        </MudAlert>
                                    }

                                    @if (_syncResult is not null)
                                    {
                                        <MudAlert Severity="@(_syncResult.Success == true ? Severity.Success : Severity.Error)" Dense="true">
                                            @_syncResult.Message
                                        </MudAlert>
                                    }

                                    @if (_downloadResult is not null)
                                    {
                                        <MudAlert Severity="@(_downloadResult.Success == true ? Severity.Success : Severity.Error)" Dense="true">
                                            @_downloadResult.Message
                                        </MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudPaper>
    </MudStack>
</div>

@code {
    private const string LocalProvider = "local";
    private const string CerbosProvider = "cerbos";
    private const int KeycloakProviderId = 1;
    private const int AtprotoProviderId = 2;
    private const int LocalIdentityProviderId = 4;
    private const PublicOnboardingPolicy PublicOnboardingUnknown = PublicOnboardingPolicy.Unknown;
    private const PublicOnboardingPolicy PublicOnboardingAllowed = PublicOnboardingPolicy.Allowed;
    private const PublicOnboardingPolicy PublicOnboardingDenied = PublicOnboardingPolicy.Denied;

    [Parameter, EditorRequired]
    public AuthProviderConfigurationDto Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public AuthorizationProviderConfigurationDto AuthorizationModel { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    [Parameter]
    public IInstanceOnboardingService? OnboardingService { get; set; }

    private bool _isSyncing;
    private bool _isDownloadingPackage;
    private bool _isRunningKeycloakDoctor;
    private bool _isPreviewingKeycloakSync;
    private bool _isApplyingKeycloakSync;
    private bool _isRotatingKeycloakClientSecret;
    private bool _useTemporaryKeycloakAdmin;
    private bool _keycloakBackupConfirmed;
    private bool _confirmApplicationManagedKeycloakSecret;
    private string _temporaryKeycloakAdminUsername = string.Empty;
    private string _temporaryKeycloakAdminPassword = string.Empty;
    private string _rotationKeycloakAdminUsername = string.Empty;
    private string _rotationKeycloakAdminPassword = string.Empty;
    private string _newKeycloakClientSecret = string.Empty;
    private KeycloakRealmDoctorResultDto? _keycloakDoctorResult;
    private KeycloakRealmSyncPlanDto? _keycloakSyncPlan;
    private KeycloakClientSecretRotationResultDto? _keycloakSecretRotationResult;
    private BaseCommandResponseOfGuid? _syncResult;
    private BaseCommandResponseOfGuid? _downloadResult;

    private int CurrentPrimaryProviderId =>
        Model.PrimaryProviderId is KeycloakProviderId
            or AtprotoProviderId
            or LocalIdentityProviderId
            ? Model.PrimaryProviderId.Value
            : LocalIdentityProviderId;

    private bool IsLocalIdentityPrimary =>
        CurrentPrimaryProviderId == LocalIdentityProviderId;

    private bool IsKeycloakPrimary =>
        CurrentPrimaryProviderId == KeycloakProviderId;

    private bool IsAtprotoPrimary =>
        CurrentPrimaryProviderId == AtprotoProviderId;

    private static RenderFragment PublicSignupUrlWarning(string? url) => builder =>
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out Uri? parsed)
            && parsed.Scheme == Uri.UriSchemeHttps
            && string.IsNullOrEmpty(parsed.UserInfo))
        {
            return;
        }

        builder.OpenComponent<MudAlert>(0);
        builder.AddAttribute(1, nameof(MudAlert.Severity), Severity.Warning);
        builder.AddAttribute(2, nameof(MudAlert.Dense), true);
        builder.AddAttribute(3, nameof(MudAlert.ChildContent),
            (RenderFragment)(content => content.AddContent(4,
                "Public signup requires an absolute HTTPS URL without embedded credentials.")));
        builder.CloseComponent();
    };

    private RenderFragment ProviderStatusChip(bool enabled) => @<MudChip T="string"
        Size="Size.Small"
        Color="@(enabled ? Color.Success : Color.Default)"
        Variant="Variant.Outlined">@(enabled ? "Enabled" : "Disabled")</MudChip>;

    private RenderFragment AuthenticationProviderButton(string providerName, bool enabled, Func<Task> onClick) => @<MudButton Variant="@(enabled ? Variant.Outlined : Variant.Filled)"
        Color="@(enabled ? Color.Error : Color.Primary)"
        OnClick="CreateAuthenticationClick(onClick)">@(enabled ? $"Disable {providerName}" : $"Enable {providerName}")</MudButton>;

    private EventCallback<MouseEventArgs> CreateAuthenticationClick(Func<Task> onClick) =>
        EventCallback.Factory.Create<MouseEventArgs>(this, onClick);

    private async Task SetAuthenticationProviderAsync(string providerName, Action<bool> setEnabled, bool currentlyEnabled)
    {
        var action = currentlyEnabled ? "Disable" : "Enable";
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = $"{action} {providerName}",
            Message = currentlyEnabled
                ? $"Disable {providerName} for new sign-ins? Existing sessions are not immediately signed out."
                : $"Enable {providerName} for sign-ins after these settings are saved?",
            YesText = action,
            CancelText = "Cancel"
        }, DialogOptionsFactory.Confirmation());

        if (confirmed == true)
        {
            setEnabled(!currentlyEnabled);
        }
    }

    private async Task SelectPrimaryProviderAsync(int providerId)
    {
        if (providerId == CurrentPrimaryProviderId)
        {
            return;
        }

        if (providerId == KeycloakProviderId
            && (string.IsNullOrWhiteSpace(Model.KeycloakAuthority)
                || string.IsNullOrWhiteSpace(Model.KeycloakClientId)
                || (string.IsNullOrWhiteSpace(Model.KeycloakClientSecret)
                    && Model.KeycloakClientSecretOwnership?.Configured != true)))
        {
            await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
            {
                Title = "Prepare Keycloak first",
                Message = "Enter the Keycloak authority, client ID, and client secret, then verify the target realm before switching.",
                YesText = "OK"
            }, DialogOptionsFactory.Confirmation());
            return;
        }

        if (providerId == AtprotoProviderId
            && (!Uri.TryCreate(
                    Model.AtprotoPublicUrl,
                    UriKind.Absolute,
                    out Uri? atprotoPublicUrl)
                || atprotoPublicUrl.Scheme is not (
                    "http" or "https")))
        {
            await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
            {
                Title = "Prepare AT Protocol first",
                Message = "Enter a valid public URL before switching to AT Protocol.",
                YesText = "OK"
            }, DialogOptionsFactory.Confirmation());
            return;
        }

        string targetName = providerId switch
        {
            LocalIdentityProviderId => "Local Identity",
            KeycloakProviderId => "Keycloak",
            AtprotoProviderId => "AT Protocol",
            _ => throw new ArgumentOutOfRangeException(
                nameof(providerId),
                providerId,
                null)
        };
        string targetRequirement = providerId switch
        {
            LocalIdentityProviderId =>
                "A verified Local Identity administrator account must already exist. The server rejects this change if the target account cannot sign in.",
            KeycloakProviderId =>
                "The target Keycloak realm and administrator account must already be usable. The server rejects this change if target credentials are unavailable.",
            AtprotoProviderId =>
                "Your administrator account must already have an exact AT Protocol identity binding. The server rejects the switch if that authority is unavailable.",
            _ => throw new ArgumentOutOfRangeException(
                nameof(providerId),
                providerId,
                null)
        };
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            new MessageBoxOptions
            {
                Title = $"Switch primary provider to {targetName}",
                Message = $"{targetRequirement} Existing sessions continue until their normal expiry.",
                YesText = $"Switch to {targetName}",
                CancelText = "Cancel"
            },
            DialogOptionsFactory.Confirmation());
        if (confirmed != true)
        {
            return;
        }

        Model.PrimaryProviderId = providerId;
        Model.PrimaryProviderCode = providerId switch
        {
            LocalIdentityProviderId => "LOCAL",
            KeycloakProviderId => "KEYCLOAK",
            AtprotoProviderId => "ATPROTO",
            _ => throw new ArgumentOutOfRangeException(
                nameof(providerId),
                providerId,
                null)
        };
        Model.PrimaryProviderName = targetName;
        if (providerId == AtprotoProviderId)
        {
            Model.AtprotoLoginEnabled = true;
            Model.GoogleSsoEnabled = false;
            Model.GoogleClientSecret = string.Empty;
        }
    }

    private bool IsAuthorizationProviderSelected(string provider) =>
        string.Equals(AuthorizationModel.Provider, provider, StringComparison.OrdinalIgnoreCase);

    private bool IsDeploymentAuthorizationProvider =>
        AuthorizationModel.AuthorizationProviderManagedByDeployment == true;

    private string GetAuthorizationCardStyle(string provider) =>
        IsAuthorizationProviderSelected(provider)
            ? "border: 2px solid var(--mud-palette-primary);"
            : string.Empty;

    private static Color OwnershipChipColor(SecretOwnershipDto? ownership) =>
        string.Equals(ownership?.Mode, "deployment-managed", StringComparison.OrdinalIgnoreCase)
            ? Color.Warning
            : ownership?.BootstrapAvailable == true
                ? Color.Info
                : Color.Success;

    private static Severity OwnershipAlertSeverity(SecretOwnershipDto? ownership) =>
        string.Equals(ownership?.Mode, "deployment-managed", StringComparison.OrdinalIgnoreCase)
            ? Severity.Warning
            : ownership?.BootstrapAvailable == true
                ? Severity.Info
                : Severity.Success;


    private bool CanSyncCerbosPolicies =>
        !_isSyncing
        && OnboardingService is not null
        && IsAuthorizationProviderSelected(CerbosProvider)
        && (IsDeploymentAuthorizationProvider
            || (AuthorizationModel.CerbosEndpointVerified == true
                && AuthorizationModel.CerbosAdminUsernameConfigured == true
                && AuthorizationModel.CerbosAdminPasswordConfigured == true));

    private bool IsCerbosEndpointReadOnly => AuthorizationModel.CerbosEndpointOwnership?.Editable != true;

    private string CerbosEndpointHelperText => IsCerbosEndpointReadOnly
        ? "Deployment-managed endpoint. Change it in the environment, secret provider, or appsettings and redeploy/restart."
        : "Accepts a full URL or bare host:port. Environment values are bootstrap prefills only; saved application settings take precedence after you edit.";

    private bool CanDownloadCerbosPackage =>
        !_isDownloadingPackage
        && IsAuthorizationProviderSelected(CerbosProvider);

    private bool CanRunKeycloakDoctor =>
        !_isRunningKeycloakDoctor
        && !_isPreviewingKeycloakSync
        && !_isApplyingKeycloakSync
        && !_isRotatingKeycloakClientSecret
        && OnboardingService is not null
        && IsKeycloakPrimary
        && !string.IsNullOrWhiteSpace(Model.KeycloakAuthority)
        && !string.IsNullOrWhiteSpace(Model.KeycloakClientId)
        && (!_useTemporaryKeycloakAdmin
            || (!string.IsNullOrWhiteSpace(_temporaryKeycloakAdminUsername)
                && !string.IsNullOrWhiteSpace(_temporaryKeycloakAdminPassword)));

    private bool CanPreviewKeycloakSync =>
        !_isPreviewingKeycloakSync
        && !_isRunningKeycloakDoctor
        && !_isApplyingKeycloakSync
        && !_isRotatingKeycloakClientSecret
        && OnboardingService is not null
        && IsKeycloakPrimary
        && !string.IsNullOrWhiteSpace(Model.KeycloakAuthority)
        && !string.IsNullOrWhiteSpace(Model.KeycloakClientId)
        && (!_useTemporaryKeycloakAdmin
            || (!string.IsNullOrWhiteSpace(_temporaryKeycloakAdminUsername)
                && !string.IsNullOrWhiteSpace(_temporaryKeycloakAdminPassword)));

    private bool CanApplyKeycloakSync =>
        !_isApplyingKeycloakSync
        && !_isPreviewingKeycloakSync
        && !_isRunningKeycloakDoctor
        && !_isRotatingKeycloakClientSecret
        && _keycloakBackupConfirmed
        && OnboardingService is not null
        && IsKeycloakPrimary
        && !string.IsNullOrWhiteSpace(Model.KeycloakAuthority)
        && !string.IsNullOrWhiteSpace(Model.KeycloakClientId)
        && !string.IsNullOrWhiteSpace(_temporaryKeycloakAdminUsername)
        && !string.IsNullOrWhiteSpace(_temporaryKeycloakAdminPassword);

    private bool IsKeycloakSecretApplicationManaged =>
        !string.Equals(Model.KeycloakClientSecretOwnership?.Mode, "deployment-managed", StringComparison.OrdinalIgnoreCase);

    private bool CanRotateKeycloakClientSecret =>
        !_isRotatingKeycloakClientSecret
        && !_isRunningKeycloakDoctor
        && !_isPreviewingKeycloakSync
        && !_isApplyingKeycloakSync
        && OnboardingService is not null
        && IsKeycloakPrimary
        && !string.IsNullOrWhiteSpace(Model.KeycloakAuthority)
        && !string.IsNullOrWhiteSpace(Model.KeycloakClientId)
        && (!IsKeycloakSecretApplicationManaged
            || (_confirmApplicationManagedKeycloakSecret
                && !string.IsNullOrWhiteSpace(_newKeycloakClientSecret)
                && !string.IsNullOrWhiteSpace(_rotationKeycloakAdminUsername)
                && !string.IsNullOrWhiteSpace(_rotationKeycloakAdminPassword)));

    private static Severity DoctorSeverity(string? status) => status?.ToLowerInvariant() switch
    {
        "healthy" => Severity.Success,
        "warning" => Severity.Warning,
        "needs-repair" => Severity.Warning,
        _ => Severity.Error
    };

    private static Severity PlanSeverity(string? status) => status?.ToLowerInvariant() switch
    {
        "healthy" => Severity.Success,
        "up-to-date" => Severity.Success,
        "applied" => Severity.Success,
        "rotated" => Severity.Success,
        "changes-planned" => Severity.Warning,
        "planned" => Severity.Warning,
        "warning" => Severity.Warning,
        "operator-action-required" => Severity.Warning,
        _ => Severity.Error
    };

    private async Task SelectAuthorizationProviderAsync(string provider)
    {
        if (IsDeploymentAuthorizationProvider || IsAuthorizationProviderSelected(provider))
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = provider == LocalProvider ? "Switch to local authorization" : "Switch to Cerbos authorization",
            Message = provider == LocalProvider
                ? "Switching from Cerbos to local authorization removes Cerbos policy evaluation, centralized decision logs, and external PDP enforcement. Use this only when you intend to run authorization locally or need to recover from Cerbos being unavailable."
                : "Switching to Cerbos routes protected authorization checks to the external PDP. If Cerbos is unavailable, authenticated requests fail closed by design.",
            YesText = provider == LocalProvider ? "Switch to Local" : "Switch to Cerbos",
            CancelText = "Cancel"
        }, DialogOptionsFactory.Confirmation());

        if (confirmed == true)
        {
            AuthorizationModel.Provider = provider;
        }
    }

    private void OnCerbosEndpointChanged(string value)
    {
        if (IsCerbosEndpointReadOnly)
        {
            return;
        }

        var endpointChanged = !string.Equals(AuthorizationModel.CerbosGrpcEndpoint, value, StringComparison.Ordinal);
        AuthorizationModel.CerbosGrpcEndpoint = value;

        if (endpointChanged)
        {
            AuthorizationModel.CerbosEndpointVerified = false;
            _syncResult = null;
            _downloadResult = null;
        }
    }

    private async Task DownloadCerbosPolicyPackageAsync()
    {
        if (!CanDownloadCerbosPackage)
        {
            return;
        }

        _isDownloadingPackage = true;
        _downloadResult = null;
        StateHasChanged();

        try
        {
            var downloaded = await BrowserActionInterop.DownloadFileFromUrlAsync(
                "/api/instance/settings/authz-provider/package");

            if (!downloaded)
            {
                _downloadResult = new BaseCommandResponseOfGuid
                {
                    Success = false,
                    Message = "Authorization policy package download failed. Try again or check server logs."
                };
                return;
            }

            _downloadResult = new BaseCommandResponseOfGuid
            {
                Success = true,
                Message = "Authorization policy package download started."
            };
        }
        catch
        {
            _downloadResult = new BaseCommandResponseOfGuid
            {
                Success = false,
                Message = "Authorization policy package download failed. Try again or check server logs."
            };
        }
        finally
        {
            _isDownloadingPackage = false;
        }
    }

    private async Task RunKeycloakDoctorAsync()
    {
        if (!CanRunKeycloakDoctor || OnboardingService is null)
        {
            return;
        }

        _isRunningKeycloakDoctor = true;
        _keycloakDoctorResult = null;
        StateHasChanged();

        try
        {
            _keycloakDoctorResult = await OnboardingService.RunKeycloakRealmDoctorAsync(new KeycloakRealmDoctorRequestDto
            {
                UseTemporaryAdminCredentials = _useTemporaryKeycloakAdmin,
                BootstrapAdminUsername = _useTemporaryKeycloakAdmin ? _temporaryKeycloakAdminUsername : null,
                BootstrapAdminPassword = _useTemporaryKeycloakAdmin ? _temporaryKeycloakAdminPassword : null,
                ApiClientId = "islamu-event-api"
            });
        }
        finally
        {
            _temporaryKeycloakAdminPassword = string.Empty;
            _isRunningKeycloakDoctor = false;
        }
    }

    private async Task PreviewKeycloakSyncAsync()
    {
        if (!CanPreviewKeycloakSync || OnboardingService is null)
        {
            return;
        }

        _isPreviewingKeycloakSync = true;
        _keycloakSyncPlan = null;
        StateHasChanged();

        try
        {
            _keycloakSyncPlan = await OnboardingService.PreviewKeycloakRealmSyncAsync(new KeycloakRealmSyncPreviewRequestDto
            {
                UseTemporaryAdminCredentials = _useTemporaryKeycloakAdmin,
                BootstrapAdminUsername = _useTemporaryKeycloakAdmin ? _temporaryKeycloakAdminUsername : null,
                BootstrapAdminPassword = _useTemporaryKeycloakAdmin ? _temporaryKeycloakAdminPassword : null,
                ApiClientId = "islamu-event-api"
            });
        }
        finally
        {
            _temporaryKeycloakAdminPassword = string.Empty;
            _isPreviewingKeycloakSync = false;
        }
    }

    private async Task ApplyKeycloakSyncAsync()
    {
        if (!CanApplyKeycloakSync || OnboardingService is null)
        {
            return;
        }

        _isApplyingKeycloakSync = true;
        StateHasChanged();

        try
        {
            _keycloakSyncPlan = await OnboardingService.ApplyKeycloakRealmSyncAsync(new KeycloakRealmSyncApplyRequestDto
            {
                BackupConfirmed = _keycloakBackupConfirmed,
                BootstrapAdminUsername = _temporaryKeycloakAdminUsername,
                BootstrapAdminPassword = _temporaryKeycloakAdminPassword,
                ApiClientId = "islamu-event-api"
            });
        }
        finally
        {
            _temporaryKeycloakAdminPassword = string.Empty;
            _keycloakBackupConfirmed = false;
            _isApplyingKeycloakSync = false;
        }
    }

    private async Task RotateKeycloakClientSecretAsync()
    {
        if (!CanRotateKeycloakClientSecret || OnboardingService is null)
        {
            return;
        }

        _isRotatingKeycloakClientSecret = true;
        _keycloakSecretRotationResult = null;
        StateHasChanged();

        try
        {
            _keycloakSecretRotationResult = await OnboardingService.RotateKeycloakClientSecretAsync(new KeycloakClientSecretRotationRequestDto
            {
                ClientId = Model.KeycloakClientId,
                SecretOwnershipMode = Model.KeycloakClientSecretOwnership?.Mode,
                ConfirmApplicationManagedSecret = _confirmApplicationManagedKeycloakSecret,
                NewClientSecret = IsKeycloakSecretApplicationManaged ? _newKeycloakClientSecret : null,
                BootstrapAdminUsername = IsKeycloakSecretApplicationManaged ? _rotationKeycloakAdminUsername : null,
                BootstrapAdminPassword = IsKeycloakSecretApplicationManaged ? _rotationKeycloakAdminPassword : null
            });
        }
        finally
        {
            _newKeycloakClientSecret = string.Empty;
            _rotationKeycloakAdminPassword = string.Empty;
            _confirmApplicationManagedKeycloakSecret = false;
            _isRotatingKeycloakClientSecret = false;
        }
    }

    private async Task SyncCerbosPoliciesAsync()
    {
        if (!CanSyncCerbosPolicies || OnboardingService is null)
        {
            return;
        }

        _isSyncing = true;
        _syncResult = null;
        StateHasChanged();

        try
        {
            var response = await OnboardingService.SyncAuthorizationPolicyPackageAsAdminAsync();
            if (response.Success == true && IsDeploymentAuthorizationProvider)
            {
                AuthorizationModel = await OnboardingService.GetAuthorizationProviderConfigurationAsAdminAsync();
            }

            _syncResult = response.Success == true
                ? new BaseCommandResponseOfGuid
                {
                    Success = true,
                    Message = string.IsNullOrWhiteSpace(response.Message)
                        ? "Authorization policy package synced."
                        : response.Message
                }
                : new BaseCommandResponseOfGuid
                {
                    Success = false,
                    Message = "Authorization policy package sync failed. Check Admin API settings and retry."
                };
        }
        catch
        {
            _syncResult = new BaseCommandResponseOfGuid
            {
                Success = false,
                Message = "Authorization policy package sync failed. Check Admin API settings and retry."
            };
        }
        finally
        {
            _isSyncing = false;
        }
    }
}
