<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../tests/Shared/Execution/TestExecutionProfile.cs" Link="Execution/TestExecutionProfile.cs" />
    <Compile Include="../../../../tests/Shared/Execution/BoundedTestDiscoveryHook.cs" Link="Execution/BoundedTestDiscoveryHook.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="Event.Testing.TestSuiteKindAttribute">
      <_Parameter1>UnitPure</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ISLAMU.ReleaseEngineering/ISLAMU.ReleaseEngineering.csproj" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <Target Name="CopyReleaseEngineAppHost" AfterTargets="Build">
    <MSBuild Projects="../../src/ISLAMU.ReleaseEngineering/ISLAMU.ReleaseEngineering.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_ReleaseEngineTarget" />
    </MSBuild>
    <PropertyGroup>
      <_ReleaseEngineAppHostSuffix Condition="'$(OS)' == 'Windows_NT'">.exe</_ReleaseEngineAppHostSuffix>
    </PropertyGroup>
    <Copy SourceFiles="@(_ReleaseEngineTarget->'%(RootDir)%(Directory)%(Filename)$(_ReleaseEngineAppHostSuffix)')"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
