<div class="upcoming-event-list" data-testid="upcoming-event-list">
    @foreach (var column in EventColumns)
    {
        <div class="upcoming-event-list__column" data-testid="upcoming-event-column">
            @foreach (var eventItem in column)
            {
                <div @key="eventItem" class="upcoming-event-list__item">
                    @if (GetEventUrl(eventItem) is { } eventUrl)
                    {
                        <a class="upcoming-event-list__row"
                           data-testid="upcoming-event-row"
                           href="@eventUrl"
                           aria-label="@GetEventLinkLabel(eventItem)">
                            <img class="upcoming-event-list__image"
                                 src="@GetImageSource(eventItem)"
                                 alt=""
                                 width="56"
                                 height="80"
                                 loading="lazy"
                                 decoding="async"
                                 @onerror="() => HandleImageError(eventItem)" />
                            <span class="upcoming-event-list__copy">
                                <span class="upcoming-event-list__title" title="@eventItem.Title">@eventItem.Title</span>
                                @Schedule(eventItem)
                                @if (GetContext(eventItem) is { } context)
                                {
                                    <span class="upcoming-event-list__context">@context</span>
                                }
                            </span>
                        </a>
                    }
                    else
                    {
                        <div class="upcoming-event-list__row"
                             data-testid="upcoming-event-row"
                             role="article"
                             aria-label="@GetEventLinkLabel(eventItem)">
                            <img class="upcoming-event-list__image"
                                 src="@GetImageSource(eventItem)"
                                 alt=""
                                 width="56"
                                 height="80"
                                 loading="lazy"
                                 decoding="async"
                                 @onerror="() => HandleImageError(eventItem)" />
                            <span class="upcoming-event-list__copy">
                                <span class="upcoming-event-list__title" title="@eventItem.Title">@eventItem.Title</span>
                                @Schedule(eventItem)
                                @if (GetContext(eventItem) is { } context)
                                {
                                    <span class="upcoming-event-list__context">@context</span>
                                }
                            </span>
                        </div>
                    }

                    @if (GetExternalEventUrl(eventItem) is { } externalEventUrl)
                    {
                        <a class="upcoming-event-list__external-link"
                           href="@externalEventUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@GetExternalEventLinkLabel(eventItem)">
                            <span>Open</span>
                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-hidden="true" />
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private const int ItemsPerColumn = 6;
    private const int MaximumColumns = 3;
    private readonly HashSet<EventListDto> _failedImages = [];
    private IReadOnlyList<EventListDto> _events = [];

    [Parameter] public IEnumerable<EventListDto> Events { get; set; } = [];
    [Parameter] public string DateToBeAnnouncedLabel { get; set; } = "Date to be announced";
    [Parameter] public string ViewEventLabel { get; set; } = "View event";
    [Parameter] public DateTimeOffset? ReferenceTimeUtc { get; set; }
    [Parameter] public string OngoingLabel { get; set; } = "Ongoing";
    [Parameter] public string TodayLabel { get; set; } = "Today";
    [Parameter] public string TomorrowLabel { get; set; } = "Tomorrow";

    private IEnumerable<EventListDto[]> EventColumns => _events.Chunk(ItemsPerColumn);

    protected override void OnParametersSet()
    {
        _events = Events.Take(ItemsPerColumn * MaximumColumns).ToArray();
        _failedImages.RemoveWhere(eventItem => !_events.Contains(eventItem));
    }

    private void HandleImageError(EventListDto eventItem) => _failedImages.Add(eventItem);

    private string GetImageSource(EventListDto eventItem)
    {
        if (!_failedImages.Contains(eventItem) && !string.IsNullOrWhiteSpace(eventItem.FeaturedImageUri))
        {
            return eventItem.FeaturedImageUri;
        }

        var color = EventColorHelper.GetColorByTypeId(eventItem.EventTypeId);
        if (color == EventColorHelper.DefaultColor)
        {
            color = EventColorHelper.GetColorByHash(eventItem.Title);
        }

        return ImageHelper.GetEventImageUrl(null, eventItem.Title, color, width: 280, height: 400);
    }

    private string GetScheduleAndFormat(EventListDto eventItem)
    {
        var startDate = eventItem.MatchingSession?.LocalStartDate ?? eventItem.FirstSessionDate;
        var format = startDate is { } start && ReferenceTimeUtc is { } now && start.Year != now.Year
            ? "ddd, MMM d, yyyy"
            : "ddd, MMM d";
        var date = startDate?.ToString(format) ?? DateToBeAnnouncedLabel;
        var relativeDay = GetRelativeDay(eventItem);
        if (relativeDay is not null)
            date = $"{(relativeDay == "today" ? TodayLabel : TomorrowLabel)} · {date}";
        if (eventItem.MatchingSession is { } session)
        {
            if (session.LocalStartTime is { } time)
                date += $" · {time:hh\\:mm}";
            if (session.IsOpenEnded)
                date += " · Open ended";
        }
        return string.IsNullOrWhiteSpace(eventItem.EventFormatFullName)
            ? date
            : $"{date} · {eventItem.EventFormatFullName}";
    }

    private RenderFragment Schedule(EventListDto eventItem) => @<span class="upcoming-event-list__metadata">
        <time datetime="@((eventItem.MatchingSession?.LocalStartDate ?? eventItem.FirstSessionDate)?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))"
              data-relative-day="@GetRelativeDay(eventItem)">@GetScheduleAndFormat(eventItem)</time>
        @if (IsOngoing(eventItem))
        {
            <span data-occurrence-state="ongoing"> · @OngoingLabel</span>
        }
        @if (eventItem.MatchingSession?.Title is { Length: > 0 } title
            && !string.Equals(title, eventItem.Title, StringComparison.Ordinal))
        {
            <span class="upcoming-event-list__session-title">@title</span>
        }
        @if (eventItem.AdditionalSessionCount is > 0)
        {
            <span data-additional-session-count="@eventItem.AdditionalSessionCount"> · @eventItem.AdditionalSessionCount additional matching sessions</span>
        }
    </span>;

    private bool IsOngoing(EventListDto eventItem) =>
        ReferenceTimeUtc is { } now
        && eventItem.MatchingSession is { StartsAtUtc: { } start } session
        && start <= now
        && (session.IsOpenEnded == true || session.EndsAtUtc is { } end && now < end);

    private string? GetRelativeDay(EventListDto eventItem)
    {
        var startDate = eventItem.MatchingSession?.LocalStartDate ?? eventItem.FirstSessionDate;
        if (startDate is not { } date || ReferenceTimeUtc is not { } now
            || string.IsNullOrWhiteSpace(eventItem.Timezone))
            return null;

        try
        {
            var today = DateOnly.FromDateTime(DateTimeHelper.ConvertUtcToLocal(now, eventItem.Timezone));
            return (DateOnly.FromDateTime(date.Date).DayNumber - today.DayNumber) switch
            {
                0 => "today",
                1 => "tomorrow",
                _ => null
            };
        }
        catch (TimeZoneNotFoundException)
        {
            return null;
        }
        catch (InvalidTimeZoneException)
        {
            return null;
        }
    }

    private static string? GetContext(EventListDto eventItem)
    {
        if (string.Equals(eventItem.ProvenanceTypeCode, "COMMUNITY_REPORTED", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(eventItem.ActorDisplayName)
                ? "Community reported"
                : $"Community reported · Contributor: {eventItem.ActorDisplayName}";

        if (!string.IsNullOrWhiteSpace(eventItem.ActorDisplayName))
        {
            return eventItem.ActorDisplayName;
        }

        return string.IsNullOrWhiteSpace(eventItem.EventTypeFullName)
            ? null
            : eventItem.EventTypeFullName;
    }

    private string GetEventLinkLabel(EventListDto eventItem)
    {
        var label = eventItem.IsFederatedDiscoveryEvent()
            ? eventItem.GetHalHref("source") is null
                ? $"AT Protocol event: {eventItem.Title}"
                : $"View AT Protocol source: {eventItem.Title}"
            : $"{ViewEventLabel}: {eventItem.Title}";
        return $"{label}. {GetScheduleAndFormat(eventItem)}{(IsOngoing(eventItem) ? $" · {OngoingLabel}" : string.Empty)}";
    }

    private static string? GetEventUrl(EventListDto eventItem) => eventItem.IsFederatedDiscoveryEvent()
        ? eventItem.GetHalHref("source")
        : EventUrlHelper.BuildPublicPath(eventItem.Slug, eventItem.PublicCode) ?? "/events";

    private static string? GetExternalEventUrl(EventListDto eventItem) =>
        eventItem.IsFederatedDiscoveryEvent() ||
        string.Equals(eventItem.ProvenanceTypeCode, "COMMUNITY_REPORTED", StringComparison.OrdinalIgnoreCase)
            ? eventItem.GetHalHref("source") : null;

    private static string GetExternalEventLinkLabel(EventListDto eventItem) =>
        $"Open {eventItem.Title} on its external platform in a new tab";
}
