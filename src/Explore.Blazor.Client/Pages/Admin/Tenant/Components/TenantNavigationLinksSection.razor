@inject ITenantNavigationService NavigationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TenantNavLinksState TenantNavLinksState

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Navigation Links</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Manage custom navigation links displayed in the navbar for your visitors.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading navigation links...</MudText>
        </MudStack>
    }
    else
    {
        <!-- Create Button -->
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-6">
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Create Link
            </MudButton>
        </MudStack>

        @if (_navigationLinks.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                No navigation links yet. Create one to get started.
            </MudAlert>
        }
        else
        {
            <MudTable Items="@_navigationLinks" Hover="true" Striped="true" Dense="false">
                <HeaderContent>
                    <MudTh>Order</MudTh>
                    <MudTh>Label</MudTh>
                    <MudTh>URL</MudTh>
                    <MudTh>Icon</MudTh>
                    <MudTh>Open in New Tab</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Order">
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(() => MoveUp(context))"
                                           Disabled="@IsFirstItem(context)"
                                           Title="Move up" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(() => MoveDown(context))"
                                           Disabled="@IsLastItem(context)"
                                           Title="Move down" />
                            <MudText Typo="Typo.body2">@context.Order</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Label">@context.Label</MudTd>
                    <MudTd DataLabel="URL">
                        <MudLink Href="@context.Url" Target="_blank">@context.Url</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Icon">
                        @if (!string.IsNullOrWhiteSpace(context.Icon))
                        {
                            <MudIcon Icon="@context.Icon" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="ml-2">@context.Icon</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(default)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Open in New Tab">
                        <MudCheckBox T="bool" Value="@(context.OpenInNewTab ?? false)" Disabled="true" />
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(context))"
                                           Title="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteLink(context))"
                                           Title="Delete" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</div>

@code {
    private List<TenantNavigationLinkDto> _navigationLinks = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLinksAsync();
    }

    private async Task LoadLinksAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var links = await NavigationService.GetNavigationLinksAsync();
            _navigationLinks = links.OrderBy(l => l.Order).ToList();
        }
        catch
        {
            _errorMessage = "Failed to load navigation links.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await TenantNavigationDialog.ShowAsync(DialogService, "Create Navigation Link");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTenantNavigationLinkDto createDto)
        {
            await CreateLink(createDto);
        }
    }

    private async Task OpenEditDialog(TenantNavigationLinkDto link)
    {
        var parameters = new DialogParameters<TenantNavigationDialog>
        {
            { x => x.ExistingLink, link }
        };

        var dialog = await TenantNavigationDialog.ShowAsync(DialogService, "Edit Navigation Link", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UpdateTenantNavigationLinkDto updateDto)
        {
            await UpdateLink(link.Id!.Value, updateDto);
        }
    }

    private async Task CreateLink(CreateTenantNavigationLinkDto dto)
    {
        try
        {
            var response = await NavigationService.CreateNavigationLinkAsync(dto);
            if (response?.Success == true)
            {
                Snackbar.Add("Navigation link created successfully.", Severity.Success);
                await LoadLinksAsync();
                await TenantNavLinksState.RefreshAsync(NavigationService);
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to create navigation link.";
            }
        }
        catch
        {
            _errorMessage = "An error occurred while creating the navigation link.";
        }
    }

    private async Task UpdateLink(Guid id, UpdateTenantNavigationLinkDto dto)
    {
        try
        {
            var response = await NavigationService.UpdateNavigationLinkAsync(id, dto);
            if (response?.Success == true)
            {
                Snackbar.Add("Navigation link updated successfully.", Severity.Success);
                await LoadLinksAsync();
                await TenantNavLinksState.RefreshAsync(NavigationService);
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to update navigation link.";
            }
        }
        catch
        {
            _errorMessage = "An error occurred while updating the navigation link.";
        }
    }

    private async Task DeleteLink(TenantNavigationLinkDto link)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete '{link.Label}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var response = await NavigationService.DeleteNavigationLinkAsync(link.Id.Value);
                if (response?.Success == true)
                {
                    Snackbar.Add("Navigation link deleted successfully.", Severity.Success);
                    await LoadLinksAsync();
                    await TenantNavLinksState.RefreshAsync(NavigationService);
                }
                else
                {
                    _errorMessage = response?.Message ?? "Failed to delete navigation link.";
                }
            }
            catch
            {
                _errorMessage = "An error occurred while deleting the navigation link.";
            }
        }
    }

    private async Task MoveUp(TenantNavigationLinkDto link)
    {
        var index = _navigationLinks.IndexOf(link);
        if (index > 0)
        {
            await SwapOrder(index, index - 1);
        }
    }

    private async Task MoveDown(TenantNavigationLinkDto link)
    {
        var index = _navigationLinks.IndexOf(link);
        if (index < _navigationLinks.Count - 1)
        {
            await SwapOrder(index, index + 1);
        }
    }

    private async Task SwapOrder(int index1, int index2)
    {
        var link1 = _navigationLinks[index1];
        var link2 = _navigationLinks[index2];

        var tempOrder = link1.Order;
        link1.Order = link2.Order;
        link2.Order = tempOrder;

        _navigationLinks[index1] = link2;
        _navigationLinks[index2] = link1;

        var orders = _navigationLinks.Select(l => new UpdateTenantNavigationLinkOrderDto
        {
            Id = l.Id,
            Order = l.Order
        }).ToList();

        try
        {
            var response = await NavigationService.ReorderNavigationLinksAsync(orders);
            if (response?.Success == true)
            {
                await TenantNavLinksState.RefreshAsync(NavigationService);
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to reorder navigation links.";
                await LoadLinksAsync();
            }
        }
        catch
        {
            _errorMessage = "An error occurred while reordering navigation links.";
            await LoadLinksAsync();
        }
    }

    private bool IsFirstItem(TenantNavigationLinkDto link)
    {
        return _navigationLinks.IndexOf(link) == 0;
    }

    private bool IsLastItem(TenantNavigationLinkDto link)
    {
        return _navigationLinks.IndexOf(link) == _navigationLinks.Count - 1;
    }
}
