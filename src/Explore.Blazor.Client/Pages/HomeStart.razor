@using Explore.Blazor.Client.Pages.Events
@using Explore.Blazor.Client.Pages.Events.Components
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@inject IStartupRoutingService StartupRoutingService
@inject IInstanceOnboardingService InstanceOnboardingService
@inject IUserService UserService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrlHelper.Build(Navigation, "/")" />
</HeadContent>

@switch (_state)
{
    case RootState.Loading:
        <MudContainer Class="pb-8">
            <MudSkeleton Width="200px" Height="20px" Class="mt-4 mb-4" />
            <MudGrid Spacing="4">
                @for (int i = 0; i < 8; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
        break;
    case RootState.ShowLanding:
        <Home />
        break;
    case RootState.ShowEvents:
        <EventList />
        break;
    case RootState.ShowMultiTenantLogin:
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 75vh;">
            <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default text-center w-100" Style="background: var(--mud-palette-surface);">
                @if (IsAuthenticatedButNoTenant)
                {
                    <div class="mb-6">
                        <MudAvatar Color="Color.Error" Size="Size.Large" Variant="Variant.Outlined" Style="width: 80px; height: 80px; margin: 0 auto;">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
                        </MudAvatar>
                    </div>
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 700; color: var(--mud-palette-error);">Access Denied</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                        You have successfully signed in, but you are not registered as a member of any organization on this platform. Please contact your workspace administrator to get access.
                    </MudText>
                    
                    <MudButton Elevation="0" Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Logout"
                               OnClick="SignOut"
                               Class="rounded-pill py-3">
                        Sign Out
                    </MudButton>
                }
                else
                {
                    <div class="mb-6">
                        <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Outlined" Style="width: 80px; height: 80px; margin: 0 auto;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" />
                        </MudAvatar>
                    </div>
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 700;">Sign in Required</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                        Please sign in to access your community organization workspace.
                    </MudText>
                    
                    <MudButton Elevation="0" Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Login"
                               OnClick="RedirectToLogin"
                               Class="rounded-pill py-3 mb-4">
                        Continue to Login
                    </MudButton>

                    <MudDivider Class="my-4" />
                    
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 500;">
                        No sign up, only Sign in
                    </MudText>
                }
            </MudPaper>
        </MudContainer>
        break;
    default:
        <MudContainer Class="pb-8">
            <MudSkeleton Width="200px" Height="20px" Class="mt-4 mb-4" />
            <MudGrid Spacing="4">
                @for (int i = 0; i < 4; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
        break;
}

@code {
    private RootState _state = RootState.Loading;
    private bool _isInitialized;

    [CascadingParameter(Name = "TenantContext")]
    private TenantContext? TenantContext { get; set; }

    [PersistentState]
    public RootState? PersistedRootState { get; set; }

    public bool IsAuthenticatedButNoTenant { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (_isInitialized)
        {
            return;
        }

        _isInitialized = true;

        if (PersistedRootState.HasValue)
        {
            _state = PersistedRootState.Value;
            return;
        }

        await ResolveRootAsync();
    }

    private async Task ResolveRootAsync()
    {
        var instanceStatus = await InstanceOnboardingService.GetStartupStatusAsync();
        switch (instanceStatus.Disposition)
        {
            case InstanceOnboardingStartupDisposition.InteractivePending:
                Navigation.NavigateTo("/setup");
                return;
            case InstanceOnboardingStartupDisposition.ConfiguredAdministratorPending:
                NavigateToProviderChallenge(instanceStatus.Provider);
                return;
            case InstanceOnboardingStartupDisposition.Unavailable:
                Navigation.NavigateTo("/startup");
                return;
            case InstanceOnboardingStartupDisposition.Completed:
                break;
            default:
                Navigation.NavigateTo("/startup");
                return;
        }

        var isSingleTenant = string.Equals(
            instanceStatus.SelectedDeploymentMode,
            "SingleTenant",
            StringComparison.Ordinal);
        var isMultiTenant = string.Equals(
            instanceStatus.SelectedDeploymentMode,
            "MultiTenant",
            StringComparison.Ordinal);
        if (!isSingleTenant && !isMultiTenant)
        {
            Navigation.NavigateTo("/startup");
            return;
        }

        if (isMultiTenant)
        {
            var resolvedTenantId = TenantContext?.TenantId;
            if (resolvedTenantId == null || resolvedTenantId == Guid.Empty)
            {
                if (instanceStatus.IsAuthenticated)
                {
                    var redirection = await UserService.ResolveUserTenantRedirectionAsync();
                    if (redirection != null && !string.IsNullOrWhiteSpace(redirection.TenantSlug))
                    {
                        var tenantUrl = $"/t/{redirection.TenantSlug}/";
                        Navigation.NavigateTo(tenantUrl, forceLoad: true);
                        return;
                    }
                    else
                    {
                        if (instanceStatus.IsCurrentUserInstanceAdmin)
                        {
                            Navigation.NavigateTo("/settings/instance?section=getting-started");
                            return;
                        }

                        IsAuthenticatedButNoTenant = true;
                        _state = RootState.ShowMultiTenantLogin;
                        PersistedRootState = _state;
                        return;
                    }
                }
                else
                {
                    _state = RootState.ShowMultiTenantLogin;
                    PersistedRootState = _state;
                    return;
                }
            }
        }

        var decision = await StartupRoutingService.GetRootDecisionAsync();
        switch (decision)
        {
            case StartupRouteDecision.Setup:
                Navigation.NavigateTo("/setup");
                return;
            case StartupRouteDecision.InstanceAdmin:
                Navigation.NavigateTo("/settings/instance?section=getting-started");
                return;
            case StartupRouteDecision.KeycloakChallenge:
                NavigateToProviderChallenge("Keycloak");
                return;
            case StartupRouteDecision.AtprotoChallenge:
                NavigateToProviderChallenge("Atproto");
                return;
            case StartupRouteDecision.Unavailable:
                Navigation.NavigateTo("/startup");
                return;
            case StartupRouteDecision.PublicLanding:
                _state = RootState.ShowLanding;
                PersistedRootState = _state;
                return;
            default:
                _state = RootState.ShowEvents;
                PersistedRootState = _state;
                return;
        }
    }

    private void NavigateToProviderChallenge(string? provider)
    {
        var providerQuery = provider switch
        {
            "Keycloak" => "keycloak",
            "Atproto" => "atproto",
            _ => null
        };
        if (providerQuery is null)
        {
            Navigation.NavigateTo("/startup");
            return;
        }

        Navigation.NavigateTo(
            $"/auth/challenge?provider={providerQuery}&returnUrl={Uri.EscapeDataString("/startup")}",
            forceLoad: true);
    }

    private void RedirectToLogin()
    {
        Navigation.NavigateTo("/auth/login?returnUrl=/", forceLoad: true);
    }

    private void SignOut()
    {
        Navigation.NavigateTo("/auth/signout", forceLoad: true);
    }

    public enum RootState
    {
        Loading,
        ShowLanding,
        ShowEvents,
        ShowMultiTenantLogin
    }
}
