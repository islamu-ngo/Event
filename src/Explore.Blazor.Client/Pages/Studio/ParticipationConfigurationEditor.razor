@using Explore.Blazor.Client.Contracts.Services.Accessibility
@inject IEventService EventService
@inject IAccessibilityAnnouncerService Announcer

<div class="participation-configuration-editor" data-testid="participation-configuration-editor">
    <div class="participation-configuration-editor__intro">
        <MudText Typo="Typo.h6" HtmlTag="h3">Participation configuration</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Changes affect how participation is presented and managed for this event.
        </MudText>
    </div>

    <div class="participation-configuration-editor__fields">
        <MudSelect T="int?"
                   Label="Participation handling"
                   Value="_handlingModeId"
                   ValueChanged="OnHandlingModeChanged"
                   Variant="Variant.Outlined"
                   Required="true"
                   Disabled="_isSaving"
                   data-testid="participation-handling-select">
            <MudSelectItem T="int?" Value="@((int?)InformationOnly)">Information only</MudSelectItem>
            <MudSelectItem T="int?" Value="@((int?)WalkIn)">Walk-in</MudSelectItem>
            <MudSelectItem T="int?" Value="@((int?)ExternalManaged)">Externally managed</MudSelectItem>
            <MudSelectItem T="int?" Value="@((int?)PlatformManaged)">Platform managed</MudSelectItem>
        </MudSelect>

        <MudSelect T="int?"
                   Label="Advance registration"
                   Value="_advanceObligationId"
                   ValueChanged="OnAdvanceObligationChanged"
                   Variant="Variant.Outlined"
                   Required="true"
                   Disabled="@(_isSaving || IsNoAdvanceMode)"
                   data-testid="advance-registration-select">
            @if (IsNoAdvanceMode)
            {
                <MudSelectItem T="int?" Value="@((int?)NotApplicable)">Not applicable</MudSelectItem>
            }
            else
            {
                <MudSelectItem T="int?" Value="@((int?)Optional)">Optional</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)Required)">Required</MudSelectItem>
            }
        </MudSelect>

        @if (IsPlatformManaged)
        {
            <MudSelect T="int?"
                       Label="Identity access"
                       Value="_identityAccessModeId"
                       ValueChanged="OnIdentityAccessModeChanged"
                       Variant="Variant.Outlined"
                       Required="true"
                       Disabled="_isSaving"
                       data-testid="identity-access-select">
                <MudSelectItem T="int?" Value="@((int?)AccountRequired)">Account required</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)GuestAllowed)">Guests allowed</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)CapabilityTokenAllowed)">Capability-token access</MudSelectItem>
            </MudSelect>
        }

        @if (UsesEmailRecovery)
        {
            <MudSelect T="int?"
                       Label="Guest recovery"
                        Value="@((int?)_guestRecoveryPolicy)"
                       ValueChanged="OnGuestRecoveryPolicyChanged"
                       Variant="Variant.Outlined"
                       Required="true"
                       Disabled="_isSaving"
                       data-testid="guest-recovery-select">
                <MudSelectItem T="int?" Value="@((int?)VerifiedEmailRequired)">Verified email required</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)UnverifiedEmailAccepted)">Unverified email accepted</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)EmailOptional)">Email optional</MudSelectItem>
            </MudSelect>
        }
        else if (UsesCapabilityRecovery)
        {
            <MudSelect T="int?"
                       Label="Guest recovery"
                        Value="@((int?)_guestRecoveryPolicy)"
                       ValueChanged="OnGuestRecoveryPolicyChanged"
                       Variant="Variant.Outlined"
                       Required="true"
                       Disabled="_isSaving"
                       data-testid="guest-recovery-select">
                <MudSelectItem T="int?" Value="@((int?)CapabilityLinkOnly)">Capability link only</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)NoRecovery)">No recovery</MudSelectItem>
            </MudSelect>
        }
    </div>

    @if (!HasConcurrencyStamp)
    {
        <div class="participation-configuration-editor__message" role="alert" data-testid="participation-concurrency-missing">
            The latest configuration version is missing. Refresh before saving.
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="participation-configuration-editor__message" role="alert" data-testid="participation-save-error">
            <span>@_errorMessage</span>
            @if (_errors.Count > 0)
            {
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="participation-configuration-editor__message" role="status" data-testid="participation-save-status">
            @_statusMessage
        </div>
    }

    <div class="participation-configuration-editor__actions">
        <AppButton OnClick="SaveAsync"
                   Disabled="@(!CanSave)"
                   StartIcon="@Icons.Material.Filled.Save"
                   data-testid="save-participation-configuration">
            @(_isSaving ? "Saving…" : "Save participation configuration")
        </AppButton>
    </div>
</div>

@code {
    private const int InformationOnly = 1;
    private const int WalkIn = 2;
    private const int ExternalManaged = 3;
    private const int PlatformManaged = 4;
    private const int NotApplicable = 1;
    private const int Optional = 2;
    private const int Required = 3;
    private const int AccountRequired = 1;
    private const int GuestAllowed = 2;
    private const int CapabilityTokenAllowed = 3;
    private const int VerifiedEmailRequired = 1;
    private const int UnverifiedEmailAccepted = 2;
    private const int EmailOptional = 3;
    private const int CapabilityLinkOnly = 4;
    private const int NoRecovery = 5;

    [Parameter, EditorRequired] public Guid EventId { get; set; }
    [Parameter, EditorRequired] public ParticipationConfiguration Configuration { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private Guid? _loadedConcurrencyStamp;
    private int? _handlingModeId;
    private int? _advanceObligationId;
    private int? _identityAccessModeId;
        private int? _guestRecoveryPolicy;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _statusMessage;
    private IReadOnlyList<string> _errors = [];

    private bool IsNoAdvanceMode => _handlingModeId is InformationOnly or WalkIn;
    private bool IsPlatformManaged => _handlingModeId == PlatformManaged;
    private bool UsesEmailRecovery => IsPlatformManaged && _identityAccessModeId == GuestAllowed;
    private bool UsesCapabilityRecovery => IsPlatformManaged && _identityAccessModeId == CapabilityTokenAllowed;
    private bool HasConcurrencyStamp => Configuration.ConcurrencyStamp is { } stamp && stamp != Guid.Empty;
    private bool CanSave => !_isSaving && HasConcurrencyStamp && IsLegalConfiguration();

    protected override void OnParametersSet()
    {
        if (_loadedConcurrencyStamp == Configuration.ConcurrencyStamp)
        {
            return;
        }

        _loadedConcurrencyStamp = Configuration.ConcurrencyStamp;
        _handlingModeId = Configuration.ParticipationHandlingModeId;
        _advanceObligationId = Configuration.AdvanceRegistrationObligationId;
        _identityAccessModeId = Configuration.IdentityAccessModeId;
        _guestRecoveryPolicy = (int?)Configuration.GuestRecoveryPolicy;
    }

    private Task OnHandlingModeChanged(int? value)
    {
        ClearFeedback();
        _handlingModeId = value;
        switch (value)
        {
            case InformationOnly:
            case WalkIn:
                _advanceObligationId = NotApplicable;
                _identityAccessModeId = null;
                _guestRecoveryPolicy = null;
                break;
            case ExternalManaged:
                _advanceObligationId = _advanceObligationId is Optional or Required ? _advanceObligationId : Optional;
                _identityAccessModeId = null;
                _guestRecoveryPolicy = null;
                break;
            case PlatformManaged:
                _advanceObligationId = _advanceObligationId is Optional or Required ? _advanceObligationId : Optional;
                break;
        }

        return Task.CompletedTask;
    }

    private Task OnAdvanceObligationChanged(int? value)
    {
        ClearFeedback();
        _advanceObligationId = value;
        return Task.CompletedTask;
    }

    private Task OnIdentityAccessModeChanged(int? value)
    {
        ClearFeedback();
        _identityAccessModeId = value;
        _guestRecoveryPolicy = value switch
        {
            AccountRequired => null,
            GuestAllowed when _guestRecoveryPolicy is VerifiedEmailRequired or UnverifiedEmailAccepted or EmailOptional => _guestRecoveryPolicy,
            CapabilityTokenAllowed when _guestRecoveryPolicy is CapabilityLinkOnly or NoRecovery => _guestRecoveryPolicy,
            _ => null
        };
        return Task.CompletedTask;
    }

    private Task OnGuestRecoveryPolicyChanged(int? value)
    {
        ClearFeedback();
        _guestRecoveryPolicy = value;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (!CanSave
            || Configuration.ConcurrencyStamp is not Guid concurrencyStamp
            || _handlingModeId is not int handlingModeId
            || _advanceObligationId is not int advanceObligationId)
        {
            return;
        }

        _isSaving = true;
        ClearFeedback();
        try
        {
            var response = await EventService.ConfigureEventParticipationAsync(
                EventId,
                new ConfigureEventParticipationDto
                {
                    ParticipationHandlingModeId = handlingModeId,
                    AdvanceRegistrationObligationId = advanceObligationId,
                    IdentityAccessModeId = _identityAccessModeId,
                    GuestRecoveryPolicy = (GuestRecoveryPolicyEnum?)_guestRecoveryPolicy
                },
                concurrencyStamp);

            if (response.Success == true)
            {
                _statusMessage = "Participation configuration saved.";
                await Announcer.AnnouncePoliteAsync(_statusMessage);
                await OnSaved.InvokeAsync();
            }
            else
            {
                _errorMessage = response.Message ?? "Participation configuration could not be saved.";
                _errors = response.Errors?.ToList() ?? [];
                await Announcer.AnnounceAssertiveAsync(_errorMessage);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private bool IsLegalConfiguration() => _handlingModeId switch
    {
        InformationOnly or WalkIn => _advanceObligationId == NotApplicable
            && _identityAccessModeId is null
            && _guestRecoveryPolicy is null,
        ExternalManaged => _advanceObligationId is Optional or Required
            && _identityAccessModeId is null
            && _guestRecoveryPolicy is null,
        PlatformManaged => _advanceObligationId is Optional or Required
            && _identityAccessModeId switch
            {
                AccountRequired => _guestRecoveryPolicy is null,
                GuestAllowed => _guestRecoveryPolicy is VerifiedEmailRequired or UnverifiedEmailAccepted or EmailOptional,
                CapabilityTokenAllowed => _guestRecoveryPolicy is CapabilityLinkOnly or NoRecovery,
                _ => false
            },
        _ => false
    };

    private void ClearFeedback()
    {
        _errorMessage = null;
        _statusMessage = null;
        _errors = [];
    }
}
