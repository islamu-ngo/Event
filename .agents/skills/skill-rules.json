  "architectureLayers": {
    "Domain": {
      "project": "{Project}.Domain",
      "description": "Core business logic, entities, enums, value objects. No external dependencies.",
      "allowedDependencies": []
    },
    "Application": {
      "project": "{Project}.Application",
      "description": "Use cases, CQRS handlers, DTOs, interfaces, validation, Specification Pattern (filters/sorts), MediatR pipeline behaviors. Orchestrates domain logic.",
      "allowedDependencies": ["Domain"]
    },
    "Infrastructure": {
      "projects": ["{Project}.Persistence", "{Project}.Infrastructure"],
      "description": "Database access, external services, repository implementations.",
      "allowedDependencies": ["Application", "Domain"]
    },
    "Presentation": {
      "projects": ["{Project}.API", "{Project}.Blazor", "{Project}.Blazor.Client"],
      "description": "REST API controllers, Blazor UI components, HATEOAS assemblers/policies, middleware, action filters. Entry points to the application.",
      "allowedDependencies": ["Application", "Infrastructure"]
    }
  }
}
