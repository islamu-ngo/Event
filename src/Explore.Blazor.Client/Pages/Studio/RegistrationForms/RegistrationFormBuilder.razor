@using System.Globalization
@using System.Text.Json
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Contracts.Services.Events
@implements IDisposable
@inject IRegistrationFormAuthoringService Authoring
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService FocusService
@inject IDialogService DialogService
@inject ITranslationService Translation

<div class="registration-form-builder" data-testid="registration-form-builder">
    @if (_loading)
    {
        <div class="registration-form-builder__state" role="status" data-testid="registration-form-loading">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            @T("loading", "Loading registration forms…")
        </div>
    }
    else if (_workflow is null)
    {
        <div class="registration-form-builder__state" role="alert" data-testid="registration-form-error">@(_error ?? T("load_failed_short", "Registration forms could not be loaded."))</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="registration-form-builder__message" role="alert" data-testid="registration-form-error">@_error</div>
        }
        else if (!string.IsNullOrWhiteSpace(_status))
        {
            <div class="registration-form-builder__message" role="status" aria-live="polite" data-testid="registration-form-status">@_status</div>
        }

        @if (_workflow.Forms.Count == 0)
        {
            <section class="registration-form-builder__empty" aria-labelledby="registration-form-empty-title" data-testid="registration-form-empty">
                <h3 id="registration-form-empty-title">@T("empty.title", "No registration form yet")</h3>
                @if (WorkflowLink("create-form") is not null)
                {
                    <div class="registration-form-builder__inline-editor">
                        <AppTextField T="string" Label="@T("form.name", "Form name")" @bind-Value="_newFormName" Disabled="_mutating" />
                        <AppButton OnClick="CreateFormAsync" Disabled="@(_mutating || string.IsNullOrWhiteSpace(_newFormName))">@T("form.create", "Create form")</AppButton>
                    </div>
                }
                @if (_templates.Count > 0)
                {
                    <div class="registration-form-builder__template-picker" data-testid="registration-form-template-picker">
                        <MudSelect T="Guid" Label="@T("template.label", "Template")" Value="_templateId" ValueChanged="SelectTemplate" Variant="Variant.Outlined" Disabled="_mutating">
                            @foreach (TemplateOption template in _templates)
                            {
                                <MudSelectItem T="Guid" Value="template.Id">@template.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <AppTextField T="string" Label="@T("template.form_name", "New form name")" @bind-Value="_templateFormName" Disabled="_mutating" />
                        <AppButton OnClick="InstantiateTemplateAsync" Disabled="@(_mutating || _templateId == Guid.Empty || string.IsNullOrWhiteSpace(_templateFormName))" data-testid="instantiate-registration-form-template">@T("template.instantiate", "Use template")</AppButton>
                    </div>
                }
                @if (WorkflowLink("create-form") is null && _templates.Count == 0)
                {
                    <p>@T("workflow.read_only", "This workflow is read-only.")</p>
                }
            </section>
        }
        else
        {
            <div class="registration-form-builder__selector">
                <MudSelect T="Guid" Label="@T("form.label", "Form")" Value="_formId" ValueChanged="SelectFormAsync" Variant="Variant.Outlined" Disabled="_mutating">
                    @foreach (RegistrationFormDto form in _workflow.Forms)
                    {
                        <MudSelectItem T="Guid" Value="form.Id">@form.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (_form is not null)
                {
                    <MudSelect T="Guid" Label="@T("version.label", "Version")" Value="_versionId" ValueChanged="SelectVersionAsync" Variant="Variant.Outlined" Disabled="_mutating">
                        @foreach (RegistrationFormVersionSummaryDto version in _form.Versions.OrderByDescending(item => item.Version))
                        {
                            <MudSelectItem T="Guid" Value="version.Id">@F("version.option", "Version {0} · {1}", version.Version, version.StatusName)</MudSelectItem>
                        }
                    </MudSelect>
                }
            </div>

            @if (_version is not null)
            {
                <article class="registration-form-builder__version" data-testid="registration-form-version" data-version-status="@_version.StatusCode">
                    <header class="registration-form-builder__version-header">
                        <div>
                            <h3>@F("version.heading", "Version {0}", _version.Version)</h3>
                            <span class="registration-form-builder__badge">@_version.StatusName</span>
                            <span lang="@_version.LanguageTag">@_version.LanguageTag</span>
                        </div>
                        <div class="registration-form-builder__actions">
                            @if (FormLink("create-version") is not null)
                            {
                                <AppButton Variant="Variant.Outlined" OnClick="CloneVersionAsync" Disabled="_mutating" data-testid="clone-registration-form-version">@T("version.clone", "Edit as new version")</AppButton>
                            }
                            @if (VersionLink("preflight") is not null)
                            {
                                <AppButton Variant="Variant.Outlined" OnClick="PreflightAsync" Disabled="_mutating" data-testid="preflight-registration-form-version">@T("version.preflight", "Check readiness")</AppButton>
                            }
                            @if (VersionLink("publish") is not null)
                            {
                                <AppButton OnClick="PublishAsync" Disabled="_mutating" StartIcon="@Icons.Material.Filled.Publish" data-testid="publish-registration-form-version">@T("version.publish", "Publish")</AppButton>
                            }
                        </div>
                    </header>

                    @if (_preflight is not null)
                    {
                        <section class="registration-form-builder__preflight" aria-labelledby="preflight-title" data-testid="registration-form-preflight" role="status">
                            <h4 id="preflight-title">@T("preflight.title", "Publication readiness")</h4>
                            <p>@(_preflight.CanPublish ? T("preflight.ready", "Ready to publish.") : T("preflight.blocked", "Resolve these issues before publishing."))</p>
                            @if (_preflight.Issues.Count > 0)
                            {
                                <ul>
                                    @foreach (RegistrationFormPublishPreflightIssueDto issue in _preflight.Issues)
                                    {
                                        <li><strong>@issue.Code</strong>: @issue.Message</li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    <section aria-labelledby="sections-title">
                        <div class="registration-form-builder__section-heading">
                            <h4 id="sections-title">@T("sections.title", "Sections and fields")</h4>
                            @if (VersionLink("add-section") is not null)
                            {
                                <div class="registration-form-builder__inline-editor">
                                    <AppTextField T="string" Label="@T("section.new_title", "New section title")" @bind-Value="_newSectionTitle" Disabled="_mutating" />
                                    <AppButton OnClick="AddSectionAsync" Disabled="@(_mutating || string.IsNullOrWhiteSpace(_newSectionTitle))" data-testid="add-registration-form-section">@T("section.add", "Add section")</AppButton>
                                </div>
                            }
                        </div>

                        @if (_version.Sections.Count == 0)
                        {
                            <p data-testid="registration-form-sections-empty">@T("sections.empty", "This version has no sections.")</p>
                        }
                        else
                        {
                            <ol class="registration-form-builder__list" data-testid="registration-form-sections">
                                @foreach ((RegistrationFormSectionDto section, int index) in OrderedSections().Select((item, index) => (item, index)))
                                {
                                    <li>
                                        <article class="registration-form-builder__section"
                                                 data-section-id="@section.Id"
                                                 data-testid="registration-form-section-drag-target"
                                                 draggable="@(VersionLink("reorder-sections") is not null && !_mutating ? "true" : "false")"
                                                 @ondragstart="@(() => StartSectionDrag(section.Id))"
                                                 @ondragover:preventDefault
                                                 @ondrop="@(() => DropSectionAsync(section.Id))"
                                                 @ondragend="ClearDragState">
                                            <header class="registration-form-builder__item-header">
                                                <h5>@section.Title</h5>
                                                <div class="registration-form-builder__actions">
                                                    @if (VersionLink("reorder-sections") is not null)
                                                    {
                                                        <div class="registration-form-builder__reorder" aria-label="@F("section.reorder", "Reorder section {0}", section.Title)">
                                                            <AppButton id="@SectionMoveId(section.Id, -1)" Variant="Variant.Text" OnClick="@(() => MoveSectionAsync(index, -1))" Disabled="@(_mutating || index == 0)" aria-label="@F("section.move_up_named", "Move section {0} up", section.Title)">@T("move.up", "Move up")</AppButton>
                                                            <AppButton id="@SectionMoveId(section.Id, 1)" Variant="Variant.Text" OnClick="@(() => MoveSectionAsync(index, 1))" Disabled="@(_mutating || index == _version.Sections.Count - 1)" aria-label="@F("section.move_down_named", "Move section {0} down", section.Title)">@T("move.down", "Move down")</AppButton>
                                                        </div>
                                                    }
                                                    @if (SectionLink(section, "edit") is not null)
                                                    {
                                                        <AppButton Variant="Variant.Text" OnClick="@(() => StartSectionEdit(section))" Disabled="_mutating" data-testid="edit-registration-form-section">@T("common.edit", "Edit")</AppButton>
                                                    }
                                                    @if (SectionLink(section, "delete") is not null)
                                                    {
                                                        <AppButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteSectionAsync(section))" Disabled="_mutating" data-testid="delete-registration-form-section">@T("common.delete", "Delete")</AppButton>
                                                    }
                                                    @if (SectionLink(section, "add-field") is not null)
                                                    {
                                                        <AppButton Variant="Variant.Text" OnClick="@(() => StartFieldAdd(section))" Disabled="_mutating" data-testid="add-registration-form-field">@T("field.add", "Add field")</AppButton>
                                                    }
                                                </div>
                                            </header>

                                            @if (_editingSectionId == section.Id)
                                            {
                                                <div class="registration-form-builder__inline-editor">
                                                    <AppTextField T="string" Label="@T("section.title", "Section title")" @bind-Value="_editingSectionTitle" Disabled="_mutating" />
                                                    <AppButton OnClick="@(() => SaveSectionAsync(section))" Disabled="@(_mutating || string.IsNullOrWhiteSpace(_editingSectionTitle))">@T("section.save", "Save section")</AppButton>
                                                    <AppButton Variant="Variant.Text" OnClick="CancelSectionEdit" Disabled="_mutating">@T("common.cancel", "Cancel")</AppButton>
                                                </div>
                                            }

                                            @if (_fieldSectionId == section.Id && _fieldEditor is not null)
                                            {
                                                <RegistrationFormFieldEditor Model="_fieldEditor" IsSaving="_mutating" OnSave="SaveFieldAsync" OnCancel="CancelFieldEdit" />
                                            }

                                            @if (section.Fields.Count == 0)
                                            {
                                                <p>@T("fields.empty", "No fields in this section.")</p>
                                            }
                                            else
                                            {
                                                <ol class="registration-form-builder__fields">
                                                    @foreach ((RegistrationFormFieldDto field, int fieldIndex) in section.Fields.OrderBy(item => item.Ordinal).Select((item, itemIndex) => (item, itemIndex)))
                                                    {
                                                        <li>
                                                            <article class="registration-form-builder__field"
                                                                     data-field-id="@field.Id"
                                                                     data-testid="registration-form-field-drag-target"
                                                                     draggable="@(SectionLink(section, "reorder-fields") is not null && !_mutating ? "true" : "false")"
                                                                     @ondragstart="@(() => StartFieldDrag(section.Id, field.Id))"
                                                                     @ondragstart:stopPropagation
                                                                     @ondragover:preventDefault
                                                                     @ondrop="@(() => DropFieldAsync(section, field.Id))"
                                                                     @ondragend="ClearDragState">
                                                                <div class="registration-form-builder__field-summary">
                                                                    <h6>@field.Label</h6>
                                                                    <MudText Typo="Typo.caption">@field.FieldTypeName · @(field.IsRequired ? T("field.required", "Required") : T("field.optional", "Optional"))</MudText>
                                                                    @if (field.Options.Count > 0)
                                                                    {
                                                                        <ul class="registration-form-builder__options" aria-label="@F("option.list_for", "Options for {0}", field.Label)">
                                                                            @foreach (RegistrationFormFieldOptionDto option in field.Options.OrderBy(item => item.Ordinal))
                                                                            {
                                                                                <li>
                                                                                    <span>@option.Label @(option.RetiredAt is null ? null : T("option.retired_marker", "(retired)"))</span>
                                                                                    <span class="registration-form-builder__actions">
                                                                                        @if (OptionLink(option, "edit") is not null)
                                                                                        {
                                                                                            <AppButton Variant="Variant.Text" OnClick="@(() => StartOptionEdit(section, field, option))" Disabled="_mutating" data-testid="edit-registration-form-option">@T("common.edit", "Edit")</AppButton>
                                                                                        }
                                                                                        @if (OptionLink(option, "retire") is not null)
                                                                                        {
                                                                                            <AppButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RetireOptionAsync(section, field, option))" Disabled="_mutating" data-testid="retire-registration-form-option">@T("option.retire", "Retire")</AppButton>
                                                                                        }
                                                                                    </span>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                    }
                                                                    @if (FieldLink(field, "add-option") is not null)
                                                                    {
                                                                        <AppButton Variant="Variant.Text" OnClick="@(() => StartOptionAdd(section, field))" Disabled="_mutating" data-testid="add-registration-form-option">@T("option.add", "Add option")</AppButton>
                                                                    }
                                                                    @if (_optionEditor?.Field.Id == field.Id)
                                                                    {
                                                                        <fieldset class="registration-form-builder__option-editor">
                                                                            <legend>@(_optionEditor.Option is null ? T("option.new", "New option") : T("option.edit", "Edit option"))</legend>
                                                                            <MudNumericField T="int" Label="@T("option.position", "Position")" @bind-Value="_optionEditor.Ordinal" Min="1" Variant="Variant.Outlined" Disabled="_mutating" />
                                                                            <AppTextField T="string" Label="@T("option.key", "Option key")" @bind-Value="_optionEditor.Key" Disabled="_mutating" />
                                                                            <AppTextField T="string" Label="@T("option.label", "Option label")" @bind-Value="_optionEditor.Label" Disabled="_mutating" />
                                                                            <AppButton OnClick="SaveOptionAsync" Disabled="@(_mutating || !_optionEditor.IsValid)">@T("option.save", "Save option")</AppButton>
                                                                            <AppButton Variant="Variant.Text" OnClick="CancelOptionEdit" Disabled="_mutating">@T("common.cancel", "Cancel")</AppButton>
                                                                        </fieldset>
                                                                    }
                                                                </div>
                                                                <div class="registration-form-builder__actions">
                                                                    @if (SectionLink(section, "reorder-fields") is not null)
                                                                    {
                                                                        <div class="registration-form-builder__reorder" aria-label="@F("field.reorder", "Reorder field {0}", field.Label)">
                                                                            <AppButton id="@FieldMoveId(field.Id, -1)" Variant="Variant.Text" OnClick="@(() => MoveFieldAsync(section, fieldIndex, -1))" Disabled="@(_mutating || fieldIndex == 0)" aria-label="@F("field.move_up_named", "Move field {0} up", field.Label)">@T("move.up", "Move up")</AppButton>
                                                                            <AppButton id="@FieldMoveId(field.Id, 1)" Variant="Variant.Text" OnClick="@(() => MoveFieldAsync(section, fieldIndex, 1))" Disabled="@(_mutating || fieldIndex == section.Fields.Count - 1)" aria-label="@F("field.move_down_named", "Move field {0} down", field.Label)">@T("move.down", "Move down")</AppButton>
                                                                        </div>
                                                                    }
                                                                    @if (FieldLink(field, "edit") is not null)
                                                                    {
                                                                        <AppButton Variant="Variant.Text" OnClick="@(() => StartFieldEdit(section, field))" Disabled="_mutating" data-testid="edit-registration-form-field">@T("common.edit", "Edit")</AppButton>
                                                                    }
                                                                    @if (FieldLink(field, "delete") is not null)
                                                                    {
                                                                        <AppButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteFieldAsync(section, field))" Disabled="_mutating" data-testid="delete-registration-form-field">@T("common.delete", "Delete")</AppButton>
                                                                    }
                                                                </div>
                                                            </article>
                                                        </li>
                                                    }
                                                </ol>
                                            }
                                        </article>
                                    </li>
                                }
                            </ol>
                        }
                    </section>

                    <section aria-labelledby="conditions-title">
                        <div class="registration-form-builder__section-heading">
                            <h4 id="conditions-title">@T("conditions.title", "Conditions")</h4>
                            @if (VersionLink("add-rule") is not null && AllFields.Count > 1)
                            {
                                <AppButton Variant="Variant.Text" OnClick="StartRuleAdd" Disabled="_mutating" data-testid="add-registration-form-rule">@T("rule.add", "Add rule")</AppButton>
                            }
                        </div>
                        @if (_ruleEditor is not null)
                        {
                            <RegistrationFormRuleEditor Model="_ruleEditor" Fields="AllFields" IsSaving="_mutating" OnSave="SaveRuleAsync" OnCancel="CancelRuleEdit" />
                        }
                        @if (_version.Rules.Count == 0)
                        {
                            <p>@T("rules.empty", "No conditional rules.")</p>
                        }
                        else
                        {
                            <ul class="registration-form-builder__rules">
                                @foreach (RegistrationFormRuleDto rule in _version.Rules.OrderBy(item => item.Ordinal))
                                {
                                    <li>
                                        <article class="registration-form-builder__rule">
                                            <span><strong>@rule.TargetNamespace.@rule.TargetKey</strong> · @rule.Condition.Operator</span>
                                            <span class="registration-form-builder__actions">
                                                @if (RuleLink(rule, "edit") is not null)
                                                {
                                                    <AppButton Variant="Variant.Text" OnClick="@(() => StartRuleEdit(rule))" Disabled="_mutating" data-testid="edit-registration-form-rule">@T("common.edit", "Edit")</AppButton>
                                                }
                                                @if (RuleLink(rule, "delete") is not null)
                                                {
                                                    <AppButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteRuleAsync(rule))" Disabled="_mutating" data-testid="delete-registration-form-rule">@T("common.delete", "Delete")</AppButton>
                                                }
                                            </span>
                                        </article>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </article>
            }
        }
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }

    private HalResourceOfRegistrationWorkflowDto? _workflow;
    private HalResourceOfRegistrationFormDto? _form;
    private HalResourceOfRegistrationFormVersionDto? _version;
    private HalResourceOfRegistrationFormPublishPreflightDto? _preflight;
    private IReadOnlyList<TemplateOption> _templates = [];
    private Guid _formId;
    private Guid _versionId;
    private Guid _templateId;
    private Guid _loadedEventId;
    private bool _loading;
    private bool _mutating;
    private bool _disposed;
    private string? _error;
    private string? _status;
    private string _newFormName = string.Empty;
    private string _templateFormName = string.Empty;
    private string _newSectionTitle = string.Empty;
    private Guid? _editingSectionId;
    private string _editingSectionTitle = string.Empty;
    private Guid? _fieldSectionId;
    private RegistrationFormFieldEditModel? _fieldEditor;
    private OptionEditorState? _optionEditor;
    private RegistrationFormRuleEditModel? _ruleEditor;
    private Guid? _draggedSectionId;
    private (Guid SectionId, Guid FieldId)? _draggedField;
    private CancellationTokenSource? _requestCancellation;

    private IReadOnlyList<RegistrationFormFieldDto> AllFields => _version?.Sections
        .OrderBy(section => section.Ordinal)
        .SelectMany(section => section.Fields.OrderBy(item => item.Ordinal))
        .ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed || EventId == _loadedEventId)
        {
            return;
        }

        CancelPendingRequests();
        ResetState();
        _loadedEventId = EventId;
        _loading = EventId != Guid.Empty;
        if (EventId == Guid.Empty)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _requestCancellation = cancellation;
        await LoadAsync(EventId, cancellation.Token);
    }

    private async Task LoadAsync(Guid eventId, CancellationToken cancellationToken)
    {
        try
        {
            HalResourceOfRegistrationWorkflowDto workflow = await Authoring.GetWorkflowAsync(eventId, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!IsCurrent(eventId, cancellationToken)) return;
            _workflow = workflow;
            if (workflow.Forms.FirstOrDefault() is { } first)
            {
                await SelectFormCoreAsync(eventId, first.Id, cancellationToken);
            }
            else
            {
                _templates = await LoadTemplatesAsync(cancellationToken);
                SelectTemplate(_templates.FirstOrDefault()?.Id ?? Guid.Empty);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (!IsCurrent(eventId, cancellationToken)) return;
            _error = T("load_failed", "Registration forms could not be loaded. Refresh and try again.");
            await Announcer.AnnounceAssertiveAsync(_error);
        }
        finally
        {
            if (IsCurrent(eventId, cancellationToken)) _loading = false;
        }
    }

    private async Task SelectFormAsync(Guid formId)
    {
        CancellationToken token = CurrentToken;
        try
        {
            await SelectFormCoreAsync(EventId, formId, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            await ShowSelectionErrorAsync(EventId, token);
        }
    }

    private async Task SelectFormCoreAsync(Guid eventId, Guid formId, CancellationToken cancellationToken)
    {
        HalResourceOfRegistrationFormDto form = await Authoring.GetFormAsync(eventId, formId, cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (!IsCurrent(eventId, cancellationToken)) return;
        _formId = formId;
        _form = form;
        if (form.Versions.OrderByDescending(item => item.Version).FirstOrDefault() is { } version)
        {
            await SelectVersionCoreAsync(eventId, formId, version.Id, cancellationToken);
        }
        else
        {
            _version = null;
            _versionId = Guid.Empty;
        }
    }

    private async Task SelectVersionAsync(Guid versionId)
    {
        CancellationToken token = CurrentToken;
        try
        {
            await SelectVersionCoreAsync(EventId, _formId, versionId, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            await ShowSelectionErrorAsync(EventId, token);
        }
    }

    private async Task SelectVersionCoreAsync(Guid eventId, Guid formId, Guid versionId, CancellationToken cancellationToken)
    {
        HalResourceOfRegistrationFormVersionDto version = await Authoring.GetVersionAsync(eventId, formId, versionId, cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (!IsCurrent(eventId, cancellationToken)) return;
        _versionId = versionId;
        _version = version;
        _preflight = null;
        CancelEditors();
    }

    private async Task ShowSelectionErrorAsync(Guid eventId, CancellationToken cancellationToken)
    {
        if (!IsCurrent(eventId, cancellationToken)) return;
        _error = T("selection_failed", "The selected registration form could not be loaded. Refresh and try again.");
        await Announcer.AnnounceAssertiveAsync(_error);
    }

    private HalLink? WorkflowLink(string relation) => TryLink(_workflow?._links, relation);
    private HalLink? FormLink(string relation) => TryLink(_form?._links, relation);
    private HalLink? VersionLink(string relation) => TryLink(_version?._links, relation);
    private static HalLink? TryLink(IDictionary<string, HalLink>? links, string relation) =>
        links?.TryGetValue(relation, out HalLink? link) == true ? link : null;
    private static HalLink? SectionLink(RegistrationFormSectionDto section, string relation) => RegistrationFormHal.Link(section.AdditionalProperties, relation);
    private static HalLink? FieldLink(RegistrationFormFieldDto field, string relation) => RegistrationFormHal.Link(field.AdditionalProperties, relation);
    private static HalLink? OptionLink(RegistrationFormFieldOptionDto option, string relation) => RegistrationFormHal.Link(option.AdditionalProperties, relation);
    private static HalLink? RuleLink(RegistrationFormRuleDto rule, string relation) => RegistrationFormHal.Link(rule.AdditionalProperties, relation);
    private IEnumerable<RegistrationFormSectionDto> OrderedSections() => _version!.Sections.OrderBy(item => item.Ordinal);

    private Task CreateFormAsync() => MutateAsync(async (eventId, token) =>
    {
        Guid id = await Authoring.CreateFormAsync(eventId, _workflow!.Id, _workflow.ConcurrencyStamp,
            new RegistrationFormInput { Namespace = "event", Key = Slug(_newFormName), Name = _newFormName.Trim(), LanguageTag = "en" }, WorkflowLink("create-form")!, token);
        _workflow = await Authoring.GetWorkflowAsync(eventId, token);
        await SelectFormCoreAsync(eventId, id, token);
        _newFormName = string.Empty;
    }, T("status.form_created", "Registration form created."));

    private void SelectTemplate(Guid templateId)
    {
        _templateId = templateId;
        if (_templates.FirstOrDefault(item => item.Id == templateId) is { } template && string.IsNullOrWhiteSpace(_templateFormName))
        {
            _templateFormName = template.Name;
        }
    }

    private Task InstantiateTemplateAsync() => MutateAsync(async (eventId, token) =>
    {
        TemplateOption template = _templates.Single(item => item.Id == _templateId);
        Guid id = await Authoring.InstantiateTemplateAsync(template.Id,
            new InstantiateRegistrationFormTemplateInputDto
            {
                EventId = eventId,
                WorkflowId = _workflow!.Id,
                Namespace = "event",
                Key = Slug(_templateFormName),
                Name = _templateFormName.Trim(),
                ExpectedWorkflowConcurrencyStamp = _workflow.ConcurrencyStamp
