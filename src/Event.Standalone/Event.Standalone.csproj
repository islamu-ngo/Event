<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StandaloneContainerPublish)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <MvcEnhancedModelMetadataSupport>true</MvcEnhancedModelMetadataSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <UseAppHost>true</UseAppHost>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\Explore.Blazor\Explore.Blazor.csproj" />
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.MySql\Explore.Persistence.DataProtection.Migrations.MySql.csproj" />
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.Sqlite\Explore.Persistence.DataProtection.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Explore.Persistence.DataProtection.Migrations.SqlServer\Explore.Persistence.DataProtection.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.MySql\Explore.Persistence.Migrations.MySql.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.Sqlite\Explore.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Explore.Persistence.Migrations.SqlServer\Explore.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The combined host is the only topology where Blazor and the scheduler share a process, so it is the
         only project that may reference the dashboard. -->
    <PackageReference Include="Quartz.Dashboard" />
  </ItemGroup>

  <Target Name="PublishStandaloneConfiguration" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <StandaloneConfigurationDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</StandaloneConfigurationDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.json' And
                                        '%(ResolvedFileToPublish.RelativePath)' == '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' And
                                        $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('appsettings')) And
                                        '%(ResolvedFileToPublish.RootDir)%(ResolvedFileToPublish.Directory)' != '$(StandaloneConfigurationDirectory)'" />
    </ItemGroup>
  </Target>

</Project>
