@using MudBlazor

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Analytics & Privacy</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure analytics provider behavior, cookie consent banner, and privacy controls.
            Analytics provider and API keys are configured via environment variables or secret management.
        </MudText>
    </div>

    @* ── Global Kill Switch ─────────────────────────────────────────── *@
    <MudStack Spacing="3">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                  Class="@(Model.GlobalDisableClientTracking == true ? "" : "d-none")">
            <strong>Client-side analytics are globally disabled.</strong>
            No browser-side tracking will run regardless of other settings.
        </MudAlert>

        <MudSwitch T="bool"
                   Value="Model.GlobalDisableClientTracking == true"
                   ValueChanged="OnGlobalDisableChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Error" Label="Emergency: Disable all client-side analytics" />

        @* ── Provider Info (read-only) ──────────────────────────────── *@
        <MudDivider Class="my-1" />
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Analytics Provider</MudText>

        <MudGrid>
            <MudItem xs="6">
                <MudTextField Variant="Variant.Outlined" T="string" Label="Provider"
                              Value="@Model.Provider" ReadOnly="true"
                              HelperText="Set via environment variable or secret manager" />
            </MudItem>
            <MudItem xs="3">
                <MudChip T="string" Color="@(Model.Enabled == true ? Color.Success : Color.Default)"
                         Size="Size.Small" Class="mt-4">
                    @(Model.Enabled == true ? "Enabled" : "Disabled")
                </MudChip>
            </MudItem>
            <MudItem xs="3">
                <MudChip T="string" Color="@(Model.HasApiKey == true ? Color.Success : Color.Warning)"
                         Size="Size.Small" Class="mt-4">
                    @(Model.HasApiKey == true ? "API Key Set" : "No API Key")
                </MudChip>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(Model.EndpointUrl))
        {
            <MudTextField Variant="Variant.Outlined" T="string" Label="Endpoint URL"
                          Value="@Model.EndpointUrl" ReadOnly="true" />
        }

        @* ── Computed Advisory ─────────────────────────────────────── *@
        @if (HasProvider)
        {
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Effective Runtime Behavior</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                These values are computed from your provider and settings below. They show what will happen at runtime.
            </MudText>

            <MudGrid>
                <MudItem xs="4">
                    <MudChip T="string" Color="@(Model.CookieBannerRequired == true ? Color.Info : Color.Success)"
                             Size="Size.Small">
                        @(Model.CookieBannerRequired == true ? "Banner Required" : "No Banner Needed")
                    </MudChip>
                </MudItem>
                <MudItem xs="4">
                    <MudChip T="string" Color="@(Model.CanRunBeforeConsent == true ? Color.Info : Color.Warning)"
                             Size="Size.Small">
                        @(Model.CanRunBeforeConsent == true ? "Analytics Before Consent" : "Blocked Until Consent")
                    </MudChip>
                </MudItem>
                <MudItem xs="4">
                    <MudChip T="string" Size="Size.Small">
                        Storage: @Model.StorageProfile
                    </MudChip>
                </MudItem>
            </MudGrid>
        }

        @* ── Cookie Consent Banner ────────────────────────────────── *@
        @if (HasProvider)
        {
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Cookie Consent Banner</MudText>

            @if (Model.CookieBannerRequired == true && Model.CookieConsentEnabled != true)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                    <strong>Legal Warning:</strong> Your current analytics configuration stores data on users' devices,
                    which requires a cookie consent banner under GDPR/ePrivacy. You should enable the banner or
                    switch to a fully cookieless analytics mode.
                </MudAlert>
            }

            <MudSwitch T="bool"
                       Value="Model.CookieConsentEnabled == true"
                       ValueChanged="OnCookieConsentChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary"
                       Label="Enable cookie consent banner" />

            @if (Model.CookieConsentEnabled == true)
            {
                <MudSelect T="DeclineBehavior?" Value="Model.DeclineBehavior"
                           ValueChanged="OnDeclineBehaviorChangedAsync"
                           Disabled="_isSaving"
                           Label="When user declines cookies"
                           Variant="Variant.Outlined"
                           HelperText="Controls what happens to analytics when a user clicks 'Decline'">
                    <MudSelectItem T="DeclineBehavior?" Value="DeclineBehavior.Cookieless">
                        Privacy Analytics — Switch to cookieless tracking (recommended)
                    </MudSelectItem>
                    <MudSelectItem T="DeclineBehavior?" Value="DeclineBehavior.Disable">
                        Strict — Disable all analytics completely
                    </MudSelectItem>
                </MudSelect>

                @if (Model.DeclineBehavior == DeclineBehavior.Cookieless && IsPosthog
                     && Model.PosthogCookielessMode == PosthogCookielessMode.Off)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        You selected "Privacy Analytics" on decline, but PostHog cookieless mode is Off.
                        Set PostHog Cookieless Mode to "On Reject" below for this to work correctly.
                    </MudAlert>
                }

                <MudNumericField T="int?" Value="Model.ConsentCookieLifetimeDays"
                                 ValueChanged="OnConsentLifetimeChangedAsync"
                                 Disabled="_isSaving"
                                 Label="Consent cookie lifetime (days)"
                                 Variant="Variant.Outlined"
                                 Min="30" Max="365"
                                 HelperText="ICO guidance suggests 6 months (180 days). Default: 180." />
            }
        }

        @* ── PostHog Privacy Controls ─────────────────────────────── *@
        @if (IsPosthog && HasProvider)
        {
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">PostHog Privacy Controls</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                These settings control which PostHog features run in visitors' browsers.
                Disabling features here reduces data collection and may remove the need for a consent banner.
            </MudText>

            <MudSelect T="PosthogCookielessMode?" Value="Model.PosthogCookielessMode"
                       ValueChanged="OnCookielessModeChangedAsync"
                       Disabled="_isSaving"
                       Label="Cookieless Mode"
                       Variant="Variant.Outlined"
                       HelperText="Controls whether PostHog stores data on users' devices">
                <MudSelectItem T="PosthogCookielessMode?" Value="PosthogCookielessMode.Off">
                    Off — Normal cookies/local storage (banner required)
                </MudSelectItem>
                <MudSelectItem T="PosthogCookielessMode?" Value="PosthogCookielessMode.Always">
                    Always — Never store anything on device (no banner needed)
                </MudSelectItem>
                <MudSelectItem T="PosthogCookielessMode?" Value="PosthogCookielessMode.OnReject">
                    On Reject — Cookieless only for users who decline (recommended)
                </MudSelectItem>
            </MudSelect>

            @if (Model.PosthogCookielessMode == PosthogCookielessMode.Always)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    With cookieless mode set to "Always", PostHog will not store any data on users' devices.
                    A consent banner is not legally required. You may still enable one for transparency.
                    <br /><br />
                    <strong>Note:</strong> Cookieless mode must also be enabled in your PostHog project settings
                    for these events to be accepted.
                </MudAlert>
            }

            <MudSelect T="PosthogPersonProfiles?" Value="Model.PosthogPersonProfiles"
                       ValueChanged="OnPersonProfilesChangedAsync"
                       Disabled="_isSaving"
                       Label="Person Profiles"
                       Variant="Variant.Outlined"
                       HelperText="Controls when PostHog creates user profiles">
                <MudSelectItem T="PosthogPersonProfiles?" Value="PosthogPersonProfiles.Always">
                    Always — Create profiles for all visitors
                </MudSelectItem>
                <MudSelectItem T="PosthogPersonProfiles?" Value="PosthogPersonProfiles.IdentifiedOnly">
                    Identified Only — Profiles only for logged-in users (recommended)
                </MudSelectItem>
                <MudSelectItem T="PosthogPersonProfiles?" Value="PosthogPersonProfiles.Never">
                    Never — No user profiles at all
                </MudSelectItem>
            </MudSelect>

            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-2">
                Feature Toggles
            </MudText>

            <MudSwitch T="bool"
                       Value="Model.PosthogSessionReplay == true"
                       ValueChanged="OnSessionReplayChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary"
                       Label="Session Replay" />

            @if (Model.PosthogSessionReplay == true && Model.PosthogCookielessMode == PosthogCookielessMode.Always)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    Session Replay requires device storage and is incompatible with "Always Cookieless" mode.
                    PostHog will ignore this setting when running in cookieless mode.
                </MudAlert>
            }

            <MudSwitch T="bool"
                       Value="Model.PosthogAutocapture == true"
                       ValueChanged="OnAutocaptureChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary"
                       Label="Autocapture (automatic click/input tracking)" />

            <MudSwitch T="bool"
                       Value="Model.PosthogHeatmaps == true"
                       ValueChanged="OnHeatmapsChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary"
                       Label="Heatmaps" />

            <MudSwitch T="bool"
                       Value="Model.PosthogToolbar == true"
                       ValueChanged="OnToolbarChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary"
                       Label="PostHog Toolbar (debug overlay)" />

            @if (Model.PosthogSessionReplay == true || Model.PosthogAutocapture == true || Model.PosthogHeatmaps == true)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    <strong>Reminder:</strong> These features must also be disabled in your PostHog project settings
                    to fully prevent data collection. Disabling them here only prevents the browser SDK from activating them.
                </MudAlert>
            }
        }

        @* ── Rybbit / Plausible Info ──────────────────────────────── *@
        @if (IsRybbit && HasProvider)
        {
            <MudDivider Class="my-1" />
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                <strong>Rybbit/Plausible:</strong> This analytics provider uses server-side hashing and does not
                store any data on users' devices. No cookie consent banner is legally required.
                You may still enable one for transparency if desired.
            </MudAlert>
        }

        @if (!IsSingleTenant)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Tenant Delegation</MudText>
            <MudSwitch T="bool" Value="LockForTenants"
                       ValueChanged="OnLockForTenantsChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Warning">
                Lock analytics settings — tenants cannot configure their own analytics and privacy
            </MudSwitch>
        }
        <div role="status" aria-live="polite" aria-atomic="true">@_saveStatus</div>
        <div role="alert">@_saveError</div>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public AnalyticsGovernanceSettingsDto Model { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    [Parameter]
    public bool LockForTenants { get; set; }

    [Parameter]
    public EventCallback<bool> LockForTenantsChanged { get; set; }

    [Parameter, EditorRequired]
    public Func<AnalyticsGovernanceSettingsDto, Task<BaseCommandResponseOfGuid>> SaveAnalyticsAsync { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<TenantDelegationSettingsDto, Task<BaseCommandResponseOfGuid>> SaveDelegationAsync { get; set; } = null!;

    private bool _isSaving;
    private string? _saveStatus;
    private string? _saveError;

    private bool IsPosthog => string.Equals(Model.Provider, "posthog", StringComparison.OrdinalIgnoreCase);

    private bool IsRybbit => string.Equals(Model.Provider, "rybbit", StringComparison.OrdinalIgnoreCase);

    private bool HasProvider => Model.Enabled == true
                                && !string.Equals(Model.Provider, "none", StringComparison.OrdinalIgnoreCase);

    private Task OnGlobalDisableChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { GlobalDisableClientTracking = value }, () => Model.GlobalDisableClientTracking = value);

    private Task OnCookieConsentChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { CookieConsentEnabled = value }, () => Model.CookieConsentEnabled = value);

    private Task OnDeclineBehaviorChangedAsync(DeclineBehavior? value) => SaveAnalyticsValueAsync(
        new() { DeclineBehavior = value }, () => Model.DeclineBehavior = value);

    private Task OnConsentLifetimeChangedAsync(int? value) => SaveAnalyticsValueAsync(
        new() { ConsentCookieLifetimeDays = value }, () => Model.ConsentCookieLifetimeDays = value);

    private Task OnCookielessModeChangedAsync(PosthogCookielessMode? value) => SaveAnalyticsValueAsync(
        new() { PosthogCookielessMode = value }, () => Model.PosthogCookielessMode = value);

    private Task OnPersonProfilesChangedAsync(PosthogPersonProfiles? value) => SaveAnalyticsValueAsync(
        new() { PosthogPersonProfiles = value }, () => Model.PosthogPersonProfiles = value);

    private Task OnSessionReplayChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { PosthogSessionReplay = value }, () => Model.PosthogSessionReplay = value);

    private Task OnAutocaptureChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { PosthogAutocapture = value }, () => Model.PosthogAutocapture = value);

    private Task OnHeatmapsChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { PosthogHeatmaps = value }, () => Model.PosthogHeatmaps = value);

    private Task OnToolbarChangedAsync(bool value) => SaveAnalyticsValueAsync(
        new() { PosthogToolbar = value }, () => Model.PosthogToolbar = value);

    private Task SaveAnalyticsValueAsync(AnalyticsGovernanceSettingsDto patch, Action apply)
    {
        apply();
        return SaveAsync(() => SaveAnalyticsAsync(patch), "Analytics settings");
    }

    private async Task OnLockForTenantsChangedAsync(bool value)
    {
        await LockForTenantsChanged.InvokeAsync(value);
        await SaveAsync(
            () => SaveDelegationAsync(new TenantDelegationSettingsDto { LockTenantAnalytics = value }),
            "Analytics delegation");
    }

    private async Task SaveAsync(Func<Task<BaseCommandResponseOfGuid>> save, string label)
    {
        _isSaving = true;
        _saveStatus = $"Saving {label.ToLowerInvariant()}...";
        _saveError = null;
        try
        {
            BaseCommandResponseOfGuid response = await save();
            _saveStatus = response.Success == true ? $"{label} saved." : null;
            _saveError = response.Success == true
                ? null
                : string.IsNullOrWhiteSpace(response.Message) ? $"{label} could not be saved." : response.Message;
        }
        catch (Exception)
        {
            _saveStatus = null;
            _saveError = $"{label} could not be saved.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
