{
  "schemaVersion": "release-provider.v1",
  "providerId": "forgejo-codeberg",
  "displayName": "Forgejo / Codeberg",
  "discoveryWorkflows": [
    ".ci/providers/forgejo-codeberg/release-adapter-preview.yml",
    ".ci/providers/forgejo-codeberg/release-adapter-final.yml"
  ],
  "publicationWorkflows": [
    ".ci/providers/forgejo-codeberg/release-publish.yml"
  ],
  "actions": [],
  "previewLane": {
    "event": "pull_request",
    "trustedCodeOnly": false,
    "secrets": [],
    "permissions": [
      "contents:read"
    ],
    "requiredChecks": [
      "release-adapter-preview"
    ],
    "alwaysPresentNoop": true
  },
  "finalLane": {
    "event": "workflow_dispatch",
    "trustedRef": "no-checkout-discovery",
    "trustedCodeOnly": true,
    "environmentApproval": true,
    "requiresSelfHostedTrustedRunner": true,
    "requiredChecks": [
      "release-adapter-final"
    ],
    "alwaysPresentNoop": true,
    "candidateStopsBeforeFinal": true
  },
  "capabilities": {
    "artifacts": true,
    "retentionDays": 90,
    "protectedRefCas": true,
    "releasePublication": true,
    "operatorEvidenceRequired": false
  },
  "guards": {
    "immutableBundleVerification": true,
    "providerNeutralChecksumEquality": true,
    "metadataAuthoritative": false,
    "misleadingSuccessForbidden": true
  },
  "diagnostics": [
    "adapter_validation_passed",
    "adapter_self_hosted_runner_required"
  ]
}
