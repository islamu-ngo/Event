<section class="event-rail" aria-label="@Title">
    <header class="event-rail__header">
        <h2 class="event-rail__title">@Title</h2>
        @if (!string.IsNullOrWhiteSpace(ViewAllUrl))
        {
            <a class="event-rail__view-all" href="@ViewAllUrl">@ViewAllLabel</a>
        }
    </header>

    @if (IsLoading)
    {
        <div class="event-rail__track" aria-busy="true" aria-label="@Title">
            @for (var index = 0; index < 5; index++)
            {
                <div class="event-rail__item" data-testid="event-rail-skeleton">
                    <Explore.Blazor.Client.Pages.Events.Components.EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                </div>
            }
        </div>
    }
    else if (_events.Count == 0)
    {
        <p class="event-rail__empty" role="status">@EmptyMessage</p>
    }
    else
    {
        <div class="event-rail__track"
             data-testid="event-horizontal-rail"
             role="list"
             tabindex="0"
             aria-label="@Title"
             dir="@(RightToLeft ? "rtl" : "ltr")">
            @foreach (var item in _events)
            {
                <div class="event-rail__item" role="listitem">
                    <Explore.Blazor.Client.Pages.Events.Components.EventCard Event="item"
                                                                                 Layout="LayoutMode.CompactGrid"
                                                                                 OnClick="HandleEventClick" />
                </div>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<EventListDto> _events = [];

    [Parameter] public string Title { get; set; } = "Events";
    [Parameter] public string ViewAllLabel { get; set; } = "View all";
    [Parameter] public string ViewAllUrl { get; set; } = "/events";
    [Parameter] public string EmptyMessage { get; set; } = "No events available.";
    [Parameter] public IEnumerable<EventListDto>? Events { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool RightToLeft { get; set; }
    [Parameter] public EventCallback<EventListDto> OnEventClick { get; set; }

    protected override void OnParametersSet() => _events = Events?.ToArray() ?? [];

    private Task HandleEventClick(EventListDto item) => OnEventClick.InvokeAsync(item);
}
