@inherits LayoutComponentBase

<div class="setup-layout-root" style="color-scheme: @ActiveColorScheme;">
    <MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider DefaultFocus="DefaultFocus.FirstChild" />
    <MudSnackbarProvider />

    <div class="setup-layout-root__switchers">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" 
                  Class="pa-1 px-4 rounded-pill mud-elevation-8 mud-surface" 
                  Style="border:1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-primary); pointer-events: all;">
            <LanguagePicker />
            <MudDivider Vertical="true" FlexItem="true" Style="height:24px;margin:0 4px; border-color: var(--mud-palette-divider);" />
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"
                           Size="Size.Medium"
                           aria-label="Toggle dark mode" />
        </MudStack>
    </div>

    <MudLayout Style="padding:0;margin:0;">
        <MudMainContent Style="padding:0;margin:0;padding-top:0;">
            <main id="main-content" tabindex="-1">
                @Body
            </main>
        </MudMainContent>
    </MudLayout>
</div>
