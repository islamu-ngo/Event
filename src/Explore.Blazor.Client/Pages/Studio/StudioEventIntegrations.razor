    private static IEnumerable<IntegrationHalItem> Items(System.Collections.IEnumerable? items)
    {
        if (items is null) yield break;
        foreach (var item in items)
        {
            var element = item is JsonElement json ? json : JsonSerializer.SerializeToElement(item, JsonOptions);
            yield return new IntegrationHalItem(element.Clone());
        }
    }

