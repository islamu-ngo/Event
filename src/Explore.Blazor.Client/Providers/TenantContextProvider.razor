@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Contracts.Services.Shell
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUiShellContextService ShellContextService
@inject IUserService UserService
@inject ILogger<TenantContextProvider> Logger

<CascadingValue Value="@_tenantContext" Name="TenantContext">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private TenantContext _tenantContext = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            bool isAuthenticated =
                authenticationState.User.Identity?.IsAuthenticated == true;

            if (isAuthenticated)
            {
                UiShellContextDto? shellContext =
                    await ShellContextService.GetCachedContextAsync();
                _tenantContext.TenantId = shellContext?.TenantId;
                _tenantContext.IsAuthenticated = shellContext is not null;

                if (_tenantContext.TenantId.HasValue && _tenantContext.TenantId.Value != Guid.Empty)
                {
                    await UserService.UpdateUserLastActiveTenantAsync(_tenantContext.TenantId.Value);
                }
            }
            else
            {
                // User is not authenticated - set default values
                _tenantContext.IsAuthenticated = false;
                Logger.LogDebug("User is not authenticated - tenant context not loaded");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize tenant context");
            _tenantContext.IsAuthenticated = false;
        }
    }
}
