    private static AiSelectedReferenceDto ToSelectedReferenceDto(HalResourceOfAiReferenceSearchResultDto reference) => new()
    {
        Kind = NormalizeSelectedReferenceKind(reference.Kind),
        ReferenceId = reference.ReferenceId,
        DisplayName = reference.DisplayName,
        Summary = reference.Summary
    };

    private static string NormalizeSelectedReferenceKind(string? kind)
    {
        var normalizedKind = kind?.Trim();
        return normalizedKind switch
        {
            "User" => ActorReferenceKind,
            "Group" => ActorReferenceKind,
            _ when string.IsNullOrWhiteSpace(normalizedKind) => ActorReferenceKind,
            _ => normalizedKind
        };
    }

    private static string GetReferenceDisplayKind(HalResourceOfAiReferenceSearchResultDto reference)
    {
        var actorContextKind = GetActorContextKind(reference);
        return string.IsNullOrWhiteSpace(actorContextKind)
            ? reference.Kind?.Trim() ?? string.Empty
            : actorContextKind;
    }

    private static string? GetActorContextKind(HalResourceOfAiReferenceSearchResultDto reference)
    {
        var summary = reference.Summary?.Trim();
        if (summary is null || !summary.StartsWith(ActorContextSummaryPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var kind = summary[ActorContextSummaryPrefix.Length..].Trim();
        return string.IsNullOrWhiteSpace(kind) ? null : kind;
    }

    private static string FormatFileSize(long bytes)
    {
        const decimal oneMegabyte = 1024m * 1024m;
        if (bytes >= oneMegabyte)
        {
            return $"{bytes / oneMegabyte:0.#} MB";
        }

        return $"{Math.Max(1, bytes / 1024)} KB";
    }

    private async Task DeleteCurrentChatAsync()
    {
        if (ConversationState.SelectedConversation?.Id is Guid conversationId)
        {
            ConversationState.RemoveConversation(conversationId);
            var nextId = ConversationState.Conversations.FirstOrDefault()?.Id;
            if (nextId is Guid id)
            {
                await SelectConversationAsync(id);
            }
            else
            {
                ConversationState.SelectConversation(null);
                if (ConversationState.CanCreateConversation)
                {
                    ConversationState.SetLoading(true);
                    var result = await ClientService.CreateConversationAsync(new CreateAiConversationRequestDto
                    {
                        Title = "AI Assistant",
                        ActorId = _selectedActorId
                    });

                    if (result.Success && result.Id is Guid newConversationId)
                    {
                        var newCollection = await ClientService.GetConversationCollectionAsync();
                        ConversationState.SetConversationCollection(newCollection);
                        await SelectConversationAsync(newConversationId);
                    }
                    else
                    {
                        ConversationState.SetError(result.Message ?? "The AI assistant conversation could not be created.");
                    }
                    ConversationState.SetLoading(false);
                }
            }
            Snackbar.Add("Conversation deleted.", Severity.Success);
        }
    }

