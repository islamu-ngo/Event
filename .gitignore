AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
[Ee]xpress/

# Windows installer packages
*.cab
*.msi
*.msix
*.msm
*.msp

# Node.js & Web assets
node_modules/
.ntvs_analysis.dat
.sass-cache/

# Python cache files
__pycache__/
*.pyc

# BizTalk & Orleans codegen
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs
orleans.codegen.cs

# Databases & local state
*.sqlite
*.db
*.mdf
*.ldf
*.ndf
