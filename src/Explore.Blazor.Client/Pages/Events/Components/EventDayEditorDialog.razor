@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Components.Forms

@inject IEventDayService EventDayService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" />
            <MudText Typo="Typo.h6">@(IsNew ? "Add Day" : "Edit Day")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingDetail)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm EditContext="_editContext">
                <FormSubmissionGuard State="@_submitState">
                <AppValidationSummary />
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_model.Label"
                                  Label="Label"
                                  Placeholder="e.g. Day 1, Opening Day, Workshop Day"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                    <MudDatePicker @bind-Date="_localDate"
                                   Label="Date"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="Date is required" />

                    <MudTextField T="string"
                                  @bind-Value="_model.Description"
                                  Label="Description"
                                  Placeholder="Optional description for this day"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  FullWidth="true" />

                    <MudTextField T="string"
                                  @bind-Value="_model.BannerText"
                                  Label="Banner Text"
                                  Placeholder="Optional banner message"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                    <MudNumericField T="int?"
                                     @bind-Value="_model.SortOrder"
                                     Label="Sort Order"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1" />

                    <MudSwitch T="bool?"
                               @bind-Value="_model.IsPublished"
                               Label="Published"
                               Color="Color.Primary" />

                    <MudSwitch T="bool?"
                               @bind-Value="_model.AllowsDayScopeRegistration"
                               Label="Allow Day-Scope Registration"
                               Color="Color.Primary" />
                </MudStack>
                </FormSubmissionGuard>
            </EditForm>

        }
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel" Disabled="_submitState.IsSubmitting">Cancel</MudButton>
        <MudButton Elevation="0" Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save"
                   Disabled="_submitState.IsSubmitting">
            @if (_submitState.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsNew ? "Add" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid? DayId { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public int InitialSortOrder { get; set; } = 1;

    private bool _isLoadingDetail;
    private DateTime? _localDate;
    private Guid _concurrencyStamp;

    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    private CreateEventDayDto _model = new() { IsPublished = true };

    protected override async Task OnInitializedAsync()
    {
        _model.SortOrder = InitialSortOrder;
        _model.EventId = EventId;

        if (!IsNew && DayId.HasValue)
        {
            _isLoadingDetail = true;
            var day = await EventDayService.GetDayByIdAsync(DayId.Value);
            if (day != null)
            {
                _model.Label = day.Label ?? string.Empty;
                _localDate = day.LocalDate?.DateTime;
                _model.Description = day.Description ?? string.Empty;
                _model.BannerText = day.BannerText ?? string.Empty;
                _model.SortOrder = day.SortOrder ?? 0;
                _model.IsPublished = day.IsPublished == true;
                _model.AllowsDayScopeRegistration = day.AllowsDayScopeRegistration == true;
                _concurrencyStamp = day.ConcurrencyStamp ?? Guid.Empty;
            }
            _isLoadingDetail = false;
        }

        _editContext = new EditContext(_model);
        _errorStore.Init(_editContext);
    }

    private async Task Save()
    {
        if (_submitState.IsSubmitting) return;
        if (!_editContext.Validate()) return;

        if (!_localDate.HasValue)
        {
            _submitState.Fail("Date is required.");
            return;
        }

        _model.LocalDate = _localDate.Value;
        _submitState.Start();

        try
        {
            if (IsNew)
            {
                var dto = new CreateEventDayDto
                {
                    EventId = EventId,
                    LocalDate = _localDate.Value,
                    Label = string.IsNullOrWhiteSpace(_model.Label) ? null : _model.Label,
                    Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                    BannerText = string.IsNullOrWhiteSpace(_model.BannerText) ? null : _model.BannerText,
                    IsPublished = _model.IsPublished,
                    SortOrder = _model.SortOrder,
                    AllowsDayScopeRegistration = _model.AllowsDayScopeRegistration
                };

                var result = await EventDayService.CreateDayAsync(dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to create day.");
                }
            }
            else if (DayId.HasValue)
            {
                if (_concurrencyStamp == Guid.Empty)
                {
                    _submitState.Fail("Event day must be reloaded before saving.");
                    return;
                }

                var dto = new UpdateEventDayDto
                {
                    LocalDate = new UpdateEventDayLocalDateDto { Value = _localDate.Value },
                    Label = new UpdateEventDayLabelDto { Value = OptionalString(_model.Label) },
                    Description = new UpdateEventDayDescriptionDto { Value = OptionalString(_model.Description) },
                    BannerText = new UpdateEventDayBannerTextDto { Value = OptionalString(_model.BannerText) },
                    Publication = new UpdateEventDayPublicationDto { IsPublished = _model.IsPublished },
                    SortOrder = new UpdateEventDaySortOrderDto { Value = _model.SortOrder },
                    Registration = new UpdateEventDayRegistrationDto { AllowsDayScopeRegistration = _model.AllowsDayScopeRegistration }
                };

                var result = await EventDayService.UpdateDayAsync(DayId.Value, _concurrencyStamp, dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to update day.");
                }
            }
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Failed to save day: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            _submitState.Fail($"Error: {ex.Message}");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static OptionalUpdateOfstring OptionalString(string? value) => new()
    {
        HasValue = true,
        Value = string.IsNullOrWhiteSpace(value) ? null : value
    };
}
