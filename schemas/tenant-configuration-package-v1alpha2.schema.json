      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageTag",
        "markdown",
        "summary",
        "title"
      ],
      "properties": {
        "languageTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*|x(?:-[A-Za-z0-9]{1,8})+)$"
        },
        "markdown": {
