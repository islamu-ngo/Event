<!-- ABOUTME: Composes infrastructure integrations and their generated protocol clients. -->
<!-- ABOUTME: Exposes internal transport seams only to owning hosts and integration-test assemblies. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CarpaNet_LexiconAutoResolve>false</CarpaNet_LexiconAutoResolve>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Explore.API" />
    <InternalsVisibleTo Include="Explore.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Event.Persistence.IntegrationTests" />
    <InternalsVisibleTo Include="Event.API.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="CarpaNet" />
    <PackageReference Include="CarpaNet.Jetstream" />
    <PackageReference Include="CarpaNet.OAuth" />
    <PackageReference Include="Cerbos.Sdk" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenFeature" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Svix" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="WebPush" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.Atproto.Transport\Explore.Atproto.Transport.csproj" />
    <ProjectReference Include="..\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\Explore.Secrets\Explore.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <LexiconFiles Include="../../schemas/lexicons/com.atproto.server.getSession.json" />
    <LexiconFiles Include="../../schemas/lexicons/com.atproto.repo.strongRef.json" />
    <LexiconFiles Include="../../schemas/lexicons/community.lexicon.location.address.json" />
    <LexiconFiles Include="../../schemas/lexicons/community.lexicon.location.fsq.json" />
    <LexiconFiles Include="../../schemas/lexicons/community.lexicon.location.geo.json" />
    <LexiconFiles Include="../../schemas/lexicons/community.lexicon.location.hthree.json" />
    <LexiconFiles Include="../../schemas/lexicons/lexicon-community-calendar-events.json" />
    <LexiconFiles Include="../../schemas/lexicons/lexicon-community-calendar-rsvp.json" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\osprey\rpc\common\v1\verdicts.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\osprey\rpc\osprey_coordinator\sync_action\v1\service.proto" GrpcServices="Client" ProtoRoot="Protos" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Bundles\*.json" />
    <EmbeddedResource Include="Deployment\ticketing-capabilities.json" />
  </ItemGroup>

</Project>
