    private async Task SearchReferencesAsync(string? searchTerm, long requestId)
    {
        var term = (searchTerm ?? _referenceSearchTerm).Trim();
        _referenceSearchTerm = term;
        var actorReferences = BuildActorReferenceResults(term);
        if (term.Length < MinimumReferenceSearchLength)
        {
            SetReferenceResults(actorReferences);
            return;
        }

        _hasSearchedReferences = true;
        _isReferenceSearchRunning = true;
        ConversationState.SetError(null);
        StateHasChanged();

        var references = await ClientService.SearchReferencesAsync(term);
        if (requestId != _referenceSearchRequestId)
        {
            return;
        }

        SetReferenceResults(MergeReferenceResults(actorReferences, references));
        _isReferenceSearchRunning = false;
    }

    private void SetReferenceResults(IReadOnlyList<HalResourceOfAiReferenceSearchResultDto> references)
    {
        _hasSearchedReferences = true;
        _isReferenceSearchRunning = false;
        ConversationState.SetReferenceResults(references);
        _activeReferenceIndex = 0;
    }

    private IReadOnlyList<HalResourceOfAiReferenceSearchResultDto> BuildActorReferenceResults(string searchTerm)
    {
        var term = searchTerm.Trim();
        return _actorOptions
            .Where(actor => ActorReferenceMatches(actor, term))
            .Select(ToActorContextReference)
            .ToList();
    }

    private static bool ActorReferenceMatches(AiConversationComposer.ActorOption actor, string searchTerm)
    {
        return searchTerm.Length == 0
            || actor.ActorDisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || actor.ActorType.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
    }

    private static HalResourceOfAiReferenceSearchResultDto ToActorContextReference(AiConversationComposer.ActorOption actor) => new()
    {
        Kind = ActorReferenceKind,
        ReferenceId = actor.ActorId,
        DisplayName = actor.ActorDisplayName,
        Summary = $"{ActorContextSummaryPrefix} {actor.ActorType}"
    };

    private static IReadOnlyList<HalResourceOfAiReferenceSearchResultDto> MergeReferenceResults(
        IReadOnlyList<HalResourceOfAiReferenceSearchResultDto> primary,
        IReadOnlyList<HalResourceOfAiReferenceSearchResultDto>? secondary)
    {
        var merged = new List<HalResourceOfAiReferenceSearchResultDto>();
        var seenById = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var seenByDisplay = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        AddRange(primary);
        AddRange(secondary ?? []);
        return merged;

        void AddRange(IEnumerable<HalResourceOfAiReferenceSearchResultDto> references)
        {
            foreach (var reference in references)
            {
                Add(reference);
            }
        }

        void Add(HalResourceOfAiReferenceSearchResultDto reference)
        {
            var referenceId = reference.ReferenceId;
            if (referenceId == Guid.Empty
                || string.IsNullOrWhiteSpace(reference.DisplayName))
            {
                return;
            }

            var idKey = $"{NormalizeSelectedReferenceKind(reference.Kind)}:{referenceId:N}";
            var displayKey = $"{GetReferenceDisplayKind(reference)}:{reference.DisplayName.Trim()}";
            if (!seenById.Add(idKey) || !seenByDisplay.Add(displayKey))
            {
                return;
            }

            merged.Add(reference);
        }
    }

    private async Task SelectReferenceAsync(HalResourceOfAiReferenceSearchResultDto reference)
    {
        if (!ConversationState.SelectedReferences.Any(selected =>
                string.Equals(selected.Kind, reference.Kind, StringComparison.OrdinalIgnoreCase)
                && selected.ReferenceId == reference.ReferenceId))
        {
            ConversationState.SetSelectedReferences([.. ConversationState.SelectedReferences, reference]);
        }

        InsertReferenceMention(reference);
        CloseReferenceAutocomplete(clearResults: true);
        await FocusPromptAsync();
    }

    private void QueueReferenceSearch(string searchTerm)
    {
        _referenceSearchDebounceCts?.Cancel();
        _referenceSearchDebounceCts?.Dispose();

        var term = searchTerm.Trim();
        _referenceSearchTerm = term;
        _referenceSearchRequestId++;

        if (term.Length < MinimumReferenceSearchLength)
        {
            SetReferenceResults(BuildActorReferenceResults(term));
            return;
        }

        var requestId = _referenceSearchRequestId;
        var cts = new CancellationTokenSource();
        _referenceSearchDebounceCts = cts;
        _ = RunReferenceSearchAfterDelayAsync(term, requestId, cts);
    }

    private async Task RunReferenceSearchAfterDelayAsync(
        string searchTerm,
        long requestId,
        CancellationTokenSource cancellationTokenSource)
    {
        try
        {
            await Task.Delay(ReferenceSearchDebounceDelay, cancellationTokenSource.Token);
            await InvokeAsync(async () =>
            {
                if (!cancellationTokenSource.IsCancellationRequested)
                {
                    await SearchReferencesAsync(searchTerm, requestId);
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_referenceSearchDebounceCts, cancellationTokenSource))
            {
                _referenceSearchDebounceCts = null;
            }

            cancellationTokenSource.Dispose();
        }
    }

    private async Task ConfirmActionAsync(ProposedActions2 action)
    {
        if (!IsBuildCapabilitySelected)
        {
            ConversationState.SetError("Switch to Build mode to confirm proposed AI actions.");
            return;
        }

        if (ConversationState.SelectedConversation?.Id is not Guid conversationId || action.Id is not Guid actionId)
        {
            return;
        }

        await RunActionAsync(actionId, async () =>
        {
            var result = await ClientService.ConfirmProposedActionAsync(
                conversationId,
                actionId,
                $"blazor-ai-confirm-{Guid.CreateVersion7()}");

            if (!result.Success)
            {
                ConversationState.SetError(result.Message ?? "The AI proposed action could not be confirmed.");
                return;
            }

            await SelectConversationAsync(conversationId);
        });
    }

    private async Task RejectActionAsync(ProposedActions2 action)
    {
        if (!IsBuildCapabilitySelected)
        {
            ConversationState.SetError("Switch to Build mode to reject proposed AI actions.");
            return;
        }

        if (ConversationState.SelectedConversation?.Id is not Guid conversationId || action.Id is not Guid actionId)
        {
            return;
        }

        await RunActionAsync(actionId, async () =>
        {
            var result = await ClientService.RejectProposedActionAsync(conversationId, actionId);
            if (!result.Success)
            {
                ConversationState.SetError(result.Message ?? "The AI proposed action could not be rejected.");
                return;
            }

            await SelectConversationAsync(conversationId);
        });
    }

    private async Task RunCommandAsync(Func<Task> operation)
    {
        if (_isCommandRunning)
        {
            return;
        }

        _isCommandRunning = true;
        try
        {
            await operation();
        }
        finally
        {
            _isCommandRunning = false;
        }
    }

    private async Task RunActionAsync(Guid actionId, Func<Task> operation)
    {
        if (!_busyActionIds.Add(actionId))
        {
            return;
        }

        try
        {
            await operation();
        }
        finally
        {
            _busyActionIds.Remove(actionId);
        }
    }

