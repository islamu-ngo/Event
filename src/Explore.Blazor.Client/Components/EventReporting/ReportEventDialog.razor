@using System.Globalization
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.EventReporting
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudDialog Class="report-event-dialog">
    <TitleContent>
        <div class="report-event-dialog__title">
            <MudIcon Icon="@Icons.Material.Outlined.Flag" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Report event</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="report-event-dialog__body">
            @if (_isLoadingOptions)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_options is null)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    Reporting is unavailable for this event.
                </MudAlert>
            }
            else if (_options.IsReportable != true)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @GetUnavailableMessage()
                </MudAlert>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Class="report-event-dialog__alert"
                              role="alert">
                        @_errorMessage
                    </MudAlert>
                }

                @if (string.IsNullOrWhiteSpace(FixedSubcategoryCode))
                {
                    <MudSelect T="string"
                               Label="Reason"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="_isSubmitting"
                               @bind-Value="_selectedReasonCode">
                        @foreach (var option in ReasonOptions)
                        {
                            <MudSelectItem T="string" Value="@option.ReasonCode">
                                @option.ReasonName
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (FixedIntentLabel is not null)
                {
                    <MudText Typo="Typo.subtitle2">@FixedIntentLabel</MudText>
                }

                @if (SelectedReason is not null && !string.IsNullOrWhiteSpace(SelectedReason.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="report-event-dialog__reason-copy">
                        @SelectedReason.Description
                    </MudText>
                }

                <AppTextField T="string"
                              Label="Details"
                              Placeholder="Add context for the moderation team."
                              Value="_reporterText"
                              ValueChanged="OnReporterTextChanged"
                              Lines="4"
                              MaxLength="@MaxReporterTextLength"
                              Required="true"
                              FullWidth="true"
                              Disabled="_isSubmitting"
                              Immediate="true" />

                <div class="report-event-dialog__counter">
                    <MudText Typo="Typo.caption" Color="@CounterColor">
                        @ReporterTextLength / @MaxReporterTextLength
                    </MudText>
                </div>

                <fieldset class="report-event-dialog__consent-group">
                    <legend class="report-event-dialog__consent-legend">Email preferences</legend>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Both choices are optional. You can submit the report without selecting either one.
                    </MudText>

                    <div class="report-event-dialog__consent-option">
                        <MudCheckBox T="bool"
                                     @bind-Value="_reportCaseUpdatesConsent"
                                     Disabled="_isSubmitting"
                                     Color="Color.Primary"
                                     Label="Case updates"
                                     aria-describedby="@CaseUpdatesDescriptionId" />
                        <MudText id="@CaseUpdatesDescriptionId"
                                 Typo="Typo.caption"
                                 Color="Color.Secondary"
                                 Class="report-event-dialog__consent-description">
                            Receive an acknowledgement, status updates, and the final outcome by email.
                        </MudText>
                    </div>

                    <div class="report-event-dialog__consent-option">
                        <MudCheckBox T="bool"
                                     @bind-Value="_reportFollowUpContactConsent"
                                     Disabled="_isSubmitting"
                                     Color="Color.Primary"
                                     Label="Follow-up contact"
                                     aria-describedby="@FollowUpContactDescriptionId" />
                        <MudText id="@FollowUpContactDescriptionId"
                                 Typo="Typo.caption"
                                 Color="Color.Secondary"
                                 Class="report-event-dialog__consent-description">
                            Allow the moderation team to email me for clarification or additional evidence.
                        </MudText>
                    </div>
                </fieldset>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_isSubmitting">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Report"
                   Disabled="@(!CanSubmit)"
                   OnClick="SubmitAsync">
            @(_isSubmitting ? "Submitting..." : "Submit report")
        </MudButton>
    </DialogActions>
</MudDialog>
