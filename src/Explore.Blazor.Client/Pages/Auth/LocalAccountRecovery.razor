@* ABOUTME: Hosts explicit Local verification, email change, recovery, and current-password change. *@
@* ABOUTME: Uses server HAL affordances and one-shot memory-only capabilities without granting a session. *@

@page "/auth/local-account-recovery"
@using Explore.Blazor.Client.Clients
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Local account recovery and security</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Class="pa-6">
        <h1>@Title</h1>
        @if (_loading)
        {
            <p role="status">Checking available account actions...</p>
        }
        @if (_error is not null)
        {
            <p id="local-account-error" role="alert">@_error</p>
        }
        @if (_message is not null)
        {
            <p role="status">@_message</p>
        }
        @if (_allowed && !_finished)
        {
            <p id="local-account-help">@Help</p>
            <form id="local-account-form" class="local-account__form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true"
                  aria-busy="@(_submitting ? "true" : "false")">
                @if (_capability is null && !_consuming && _mode is "verify-email" or "recover-password")
                {
                    <label for="local-account-identifier">Username or email</label>
                    <input id="local-account-identifier" @bind="_identifier" required maxlength="256" autocomplete="username"
                           disabled="@_submitting" aria-describedby="@DescriptionIds" />
                }
                @if (_mode == "change-email")
                {
                    <label for="local-account-email">Proposed email address</label>
                    <input id="local-account-email" type="email" @bind="_email" required maxlength="256" autocomplete="email"
                           disabled="@_submitting" aria-describedby="@DescriptionIds" />
                }
                @if (_mode == "change-password")
                {
                    <label for="local-account-current-password">Current password</label>
                    <input id="local-account-current-password" type="password" @bind="_currentPassword" required maxlength="128" autocomplete="current-password"
                           disabled="@_submitting" aria-describedby="@DescriptionIds" />
                }
                @if (NeedsPassword)
                {
                    <label for="local-account-new-password">New password</label>
                    <input id="local-account-new-password" type="password" @bind="_newPassword" required minlength="12" maxlength="128" autocomplete="new-password"
                           disabled="@_submitting" aria-describedby="@DescriptionIds" />
                    <label for="local-account-confirm-password">Confirm new password</label>
                    <input id="local-account-confirm-password" type="password" @bind="_confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password"
                           disabled="@_submitting" aria-describedby="@DescriptionIds" />
                }
                <button type="submit" disabled="@_submitting">@(_submitting ? "Submitting..." : SubmitLabel)</button>
            </form>
        }
        <p class="mt-4"><a href="/login" @onclick="Cancel">Return to sign in</a></p>
    </MudPaper>
</MudContainer>

@code {
    private IJSObjectReference? _module;
    private LocalEmailConfirmationRequestDto? _capability;
    private string _mode = string.Empty;
    private string _identifier = string.Empty, _email = string.Empty;
    private string _currentPassword = string.Empty, _newPassword = string.Empty, _confirmPassword = string.Empty;
    private string? _error, _message;
    private bool _loading = true, _allowed, _submitting, _finished, _disposed, _consuming;
    private int _generation;
    private bool NeedsPassword => _mode == "change-password" || (_capability is not null || _consuming) && _mode == "recover-password";
    private string DescriptionIds => _error is null ? "local-account-help" : "local-account-help local-account-error";
    private string Title => _mode switch
    {
        "change-password" => "Change your Local password",
        "change-email" => "Change your Local email address",
        "verify-current-email" or "verify-email" => "Verify your Local email address",
        "recover-password" => "Recover your Local password",
        _ => "Local account recovery and security"
    };
    private string SubmitLabel => _capability is not null ? (_mode == "recover-password" ? "Set new password" : "Confirm email address")
        : _mode == "change-password" ? "Change password" : "Send email";
    private string Help => NeedsPassword
        ? "Use 12 to 128 characters for your new password. Completion requires a fresh sign-in."
        : _capability is not null
            ? "Confirm this email operation once. The server checks whether the link is still valid. This does not sign you in."
            : "Email delivery must be available. If the account is eligible, instructions will be sent; this page does not confirm whether an account exists.";

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        int generation = ++_generation;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/local-account-recovery.js");
            if (!Current(generation)) return;
            var pointer = await _module.InvokeAsync<LocalEmailConfirmationRequestDto?>("takeLocalAccountCapability");
            if (!Current(generation)) return;
            var query = System.Web.HttpUtility.ParseQueryString(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            _mode = query["mode"] ?? string.Empty;
            if (pointer is not null)
            {
                int purpose = (int)pointer.Purpose;
                string expectedMode = purpose == 3 ? "recover-password" : "verify-email";
                if (pointer.OperationId == Guid.Empty || pointer.LocalSubjectId == Guid.Empty || pointer.PersonalActorId == Guid.Empty
                    || pointer.ExternalLoginId == Guid.Empty || pointer.Generation == Guid.Empty || purpose is < 1 or > 3
                    || pointer.Token is not { Length: >= 1 and <= 8192 }
                    || _mode.Length > 0 && _mode != expectedMode)
                {
                    _error = "This link is invalid. Request a new email or return to sign in.";
                    return;
                }
                _mode = expectedMode;
                _capability = pointer;
                _allowed = true;
                return;
            }
            // These are native API HAL resources, not client-derived provider or SMTP permissions.
            var bff = await JS.InvokeAsync<IJSObjectReference>("import", "/js/bff.js");
            try
            {
                if (!Current(generation)) return;
                IDictionary<string, HalLink>? links;
                if (_mode is "change-email" or "change-password" or "verify-current-email")
                {
                    var current = await bff.InvokeAsync<HalResourceOfUserDto>("fetchJson", "/api/User");
                    links = current?._links;
                }
                else if (_mode is "verify-email" or "recover-password")
                {
                    var configuration = await bff.InvokeAsync<HalResourceOfAuthProviderConfigurationDto>("fetchJson", "/api/InstanceOnboarding/auth-provider-configuration");
                    links = configuration?._links;
                }
                else
                {
                    _error = "This link is missing or invalid. Request a new email or return to sign in.";
                    return;
                }
                if (!Current(generation)) return;
                string relation = _mode is "change-email" or "verify-current-email" ? "verify-email" : _mode;
                _allowed = links?.ContainsKey(relation) == true;
                if (!_allowed) _error = "This account action is not currently available. Return to sign in or contact the instance administrator.";
            }
            finally { await bff.DisposeAsync(); }
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or OperationCanceledException)
        {
            if (Current(generation)) _error = "Account actions could not be checked. Return to sign in and try again.";
        }
        finally
        {
            if (Current(generation)) { _loading = false; await InvokeAsync(StateHasChanged); }
        }
    }

    private async Task SubmitAsync()
    {
        if (_disposed || !_allowed || _submitting || _finished || _module is null) return;
        _error = null;
        if (NeedsPassword && (_newPassword.Length is < 12 or > 128 || _newPassword != _confirmPassword))
        {
            ClearCredentials();
            _capability = null;
            _finished = true;
            _error = "The passwords must match and contain 12 to 128 characters. Return to sign in or open a new recovery link.";
            return;
        }
        int generation = ++_generation;
        _submitting = true;
        bool consume = _capability is not null || _mode == "change-password";
        _consuming = consume;
        string path;
        object body;
        if (_capability is { } pointer)
        {
            path = _mode == "recover-password" ? "/password-recoveries/consume" : "/email-verifications/consume";
            body = _mode == "recover-password" ? new LocalPasswordRecoveryCompletionRequestDto
            {
                OperationId = pointer.OperationId, LocalSubjectId = pointer.LocalSubjectId, PersonalActorId = pointer.PersonalActorId,
                ExternalLoginId = pointer.ExternalLoginId, Generation = pointer.Generation, Purpose = pointer.Purpose,
                Token = pointer.Token, NewPassword = _newPassword
            } : pointer;
        }
        else if (_mode == "change-password")
        {
            path = "/password";
            body = new LocalPasswordChangeRequestDto { CurrentPassword = _currentPassword, NewPassword = _newPassword };
        }
        else if (_mode == "recover-password")
        {
            path = "/password-recoveries";
            body = new LocalPasswordRecoveryRequestDto { Identifier = _identifier.Trim() };
        }
        else
        {
            path = "/email-verifications";
            body = new LocalEmailVerificationRequestDto
            {
                Identifier = _mode == "verify-email" ? _identifier.Trim() : null,
                ProposedEmail = _mode == "change-email" ? _email.Trim() : null
            };
        }
        ClearCredentials();
        _capability = null;
        try
        {
            int status = await _module.InvokeAsync<int>("submitLocalAccountRequest", "/bff/auth/local" + path, body);
            if (!Current(generation)) return;
            _finished = true;
            if (consume && status == 204)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            if (!consume && status == 202)
                _message = "If the account is eligible, an email will be sent. Check your inbox. No sign-in session has been created.";
            else _error = status switch
            {
                400 or 409 => "This request or link was not accepted. It may be invalid, expired, or already used. Request a new email or return to sign in.",
                401 or 403 => "Sign in again before changing your account credentials.",
                429 => "Too many requests. Return to sign in and try again later.",
                503 => "This account service is currently unavailable. Contact the instance administrator or try again later.",
                _ => "Completion could not be confirmed. This request will not be repeated automatically. Return to sign in."
            };
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or OperationCanceledException)
        {
            if (Current(generation)) { _finished = true; _error = "Completion could not be confirmed. Return to sign in; this request will not be repeated automatically."; }
        }
        finally
        {
            ClearCredentials();
            if (Current(generation)) _submitting = false;
        }
    }

    private bool Current(int generation) => !_disposed && generation == _generation;
    private void ClearCredentials() => _identifier = _email = _currentPassword = _newPassword = _confirmPassword = string.Empty;
    private void Cancel() { ++_generation; ClearCredentials(); _capability = null; _allowed = false; }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => Cancel();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Cancel();
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* Browser circuit has already released the module. */ }
        }
    }
}
