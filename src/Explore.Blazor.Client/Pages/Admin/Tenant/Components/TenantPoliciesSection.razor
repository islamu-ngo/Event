@implements IDisposable
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Contracts.Services.Federation
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Services
@inject IAtprotoFederationSettingsService AtprotoFederationSettingsService
@inject ITenantOnboardingService TenantOnboardingService
@inject IAccessibilityAnnouncerService Announcer
@inject ILogger<TenantPoliciesSection> Logger

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Event & Organization Policies</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Control how events are submitted, approved, and how organizations are verified.
        </MudText>
    </div>
    <TenantReportingIntakePolicySection />
    <MudStack Spacing="3">
        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(EventsUserSubmissionEnabledKey)"
                   ValueChanged="SetAllowUserSubmittedEventsAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(EventsUserSubmissionEnabledKey)">
            Allow users to submit events
        </MudSwitch>
        @if (IsPolicyDisabled(EventsUserSubmissionEnabledKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(EventsUserSubmissionEnabledKey)
            </MudText>
        }

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(EventsOrganizationSubmissionEnabledKey)"
                   ValueChanged="SetAllowOrganizationSubmittedEventsAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(EventsOrganizationSubmissionEnabledKey)">
            Allow organizations to submit events
        </MudSwitch>
        @if (IsPolicyDisabled(EventsOrganizationSubmissionEnabledKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(EventsOrganizationSubmissionEnabledKey)
            </MudText>
        }

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(EventsGroupSubmissionEnabledKey)"
                   ValueChanged="SetAllowGroupSubmittedEventsAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(EventsGroupSubmissionEnabledKey)">
            Allow groups to submit events
        </MudSwitch>
        @if (IsPolicyDisabled(EventsGroupSubmissionEnabledKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(EventsGroupSubmissionEnabledKey)
            </MudText>
        }

        @if (PolicyDisplayValue(EventsUserSubmissionEnabledKey) != true
            && PolicyDisplayValue(EventsOrganizationSubmissionEnabledKey) != true
            && PolicyDisplayValue(EventsGroupSubmissionEnabledKey) != true)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No entity types are allowed to submit events. Only administrators will be able to create events through entities they manage.
            </MudAlert>
        }

        <MudDivider />

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(OrganizationsSelfRegistrationEnabledKey)"
                   ValueChanged="SetAllowOrganizationSelfRegistrationAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(OrganizationsSelfRegistrationEnabledKey)">
            Allow organization self-registration
        </MudSwitch>
        @if (IsPolicyDisabled(OrganizationsSelfRegistrationEnabledKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(OrganizationsSelfRegistrationEnabledKey)
            </MudText>
        }

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(GroupsSelfRegistrationEnabledKey)"
                   ValueChanged="SetAllowGroupSelfRegistrationAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(GroupsSelfRegistrationEnabledKey)">
            Allow group self-registration
        </MudSwitch>
        @if (IsPolicyDisabled(GroupsSelfRegistrationEnabledKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(GroupsSelfRegistrationEnabledKey)
            </MudText>
        }

        <MudDivider />

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(EventsRequireApprovalKey)"
                   ValueChanged="SetRequireEventApprovalAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(EventsRequireApprovalKey)">
            Require approval before publication
        </MudSwitch>
        @if (IsPolicyDisabled(EventsRequireApprovalKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(EventsRequireApprovalKey)
            </MudText>
        }

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(OrganizationsVerificationRequiredKey)"
                   ValueChanged="SetRequireOrganizationVerificationAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(OrganizationsVerificationRequiredKey)">
            Require organization verification
        </MudSwitch>

        @if (IsPolicyDisabled(OrganizationsVerificationRequiredKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(OrganizationsVerificationRequiredKey)
            </MudText>
        }

        <MudDivider />

        <MudSwitch T="bool?"
                   Value="@PolicyDisplayValue(EventsCardClickOpensDetailPageKey)"
                   ValueChanged="SetEventCardClickOpensDetailPageAsync"
                   Color="Color.Primary"
                   Disabled="@IsPolicyDisabled(EventsCardClickOpensDetailPageKey)">
            Event card click opens detail page
        </MudSwitch>

        @if (IsPolicyDisabled(EventsCardClickOpensDetailPageKey))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                @PolicyDisabledReason(EventsCardClickOpensDetailPageKey)
            </MudText>
        }

        @if (!string.IsNullOrWhiteSpace(_policyMessage))
        {
            <MudAlert Severity="@(_policySaveSucceeded ? Severity.Success : Severity.Error)"
                      Dense="true"
                      role="@(_policySaveSucceeded ? "status" : "alert")">
                @_policyMessage
            </MudAlert>
        }

        <MudDivider />

        <MudStack Spacing="2" aria-labelledby="tenant-atproto-events-title">
            <MudText id="tenant-atproto-events-title" Typo="Typo.subtitle1" Style="font-weight:600;">
                AT Protocol Event Federation
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Default">
                When event federation is enabled, public inbound discovery works without AT&nbsp;Protocol authentication.
                Publishing and RSVP synchronization require AT&nbsp;Protocol authentication.
            </MudText>

            @if (_atprotoLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="Loading AT Protocol event settings" />
            }
            else if (_atprotoSettings is null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" role="alert">
                    @_atprotoMessage
                </MudAlert>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAtprotoSettingsAsync">
                    Retry AT Protocol settings
                </MudButton>
            }
            else
            {
                var eventsSetting = FindSetting(AtprotoEventsEnabledKey);
                <MudSwitch T="bool"
                           Value="@AtprotoEventsEnabled"
                           ValueChanged="SetAtprotoEventsEnabledAsync"
                           Color="Color.Primary"
                           Disabled="@(_atprotoSaving || !CanEdit(AtprotoEventsEnabledKey))">
                    Enable AT Protocol events
                </MudSwitch>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Source: @SettingSourceLabel(eventsSetting?.Source). Lock: @LockStateLabel(eventsSetting?.IsLocked).
                </MudText>

                @if (!CanEdit(AtprotoEventsEnabledKey))
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                        @LockedReason(AtprotoEventsEnabledKey)
                    </MudText>
                }

                @if (UseInstanceScope && HasAtprotoAffordance(LockRelation(AtprotoEventsEnabledKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsEnabledKey, true))">
                        Lock tenant override
                    </MudButton>
                }
                else if (UseInstanceScope && HasAtprotoAffordance(UnlockRelation(AtprotoEventsEnabledKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsEnabledKey, false))">
                        Unlock tenant override
                    </MudButton>
                }

                var profileSetting = FindSetting(AtprotoValidationProfileKey);
                <MudSelect T="string"
                           Label="Event creation validation"
                           Value="@AtprotoValidationProfile"
                           ValueChanged="SetAtprotoValidationProfileAsync"
                           Variant="Variant.Outlined"
                           Disabled="@(_atprotoSaving || !CanEdit(AtprotoValidationProfileKey))">
                    <MudSelectItem Value="@PlatformValidationProfile">Platform publishing rules</MudSelectItem>
                    <MudSelectItem Value="@CommunityValidationProfile">Community lexicon minimum</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Community lexicon minimum reduces required business fields, but privacy, authorization, local commit, and payload safety checks still apply.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Source: @SettingSourceLabel(profileSetting?.Source). Lock: @LockStateLabel(profileSetting?.IsLocked).
                </MudText>

                @if (!CanEdit(AtprotoValidationProfileKey))
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                        @LockedReason(AtprotoValidationProfileKey)
                    </MudText>
                }

                @if (UseInstanceScope && HasAtprotoAffordance(LockRelation(AtprotoValidationProfileKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoValidationProfileKey, true))">
                        Lock validation-profile tenant override
                    </MudButton>
                }
                else if (UseInstanceScope && HasAtprotoAffordance(UnlockRelation(AtprotoValidationProfileKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoValidationProfileKey, false))">
                        Unlock validation-profile tenant override
                    </MudButton>
                }

                <MudDivider />

                var backfillEnabledSetting = FindSetting(AtprotoEventsBackfillEnabledKey);
                <MudSwitch T="bool"
                           Value="@AtprotoEventsBackfillEnabled"
                           ValueChanged="SetAtprotoEventsBackfillEnabledAsync"
                           Color="Color.Primary"
                           Disabled="@(_atprotoSaving || !CanEdit(AtprotoEventsBackfillEnabledKey))">
                    Enable inbound event recovery
                </MudSwitch>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Recover inbound AT Protocol events missed while processing was unavailable. Outbound publication is unaffected.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Source: @SettingSourceLabel(backfillEnabledSetting?.Source). Lock: @LockStateLabel(backfillEnabledSetting?.IsLocked).
                </MudText>

                @if (!CanEdit(AtprotoEventsBackfillEnabledKey))
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                        @LockedReason(AtprotoEventsBackfillEnabledKey)
                    </MudText>
                }

                @if (UseInstanceScope && HasAtprotoAffordance(LockRelation(AtprotoEventsBackfillEnabledKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsBackfillEnabledKey, true))"
                               aria-label="Lock inbound event recovery for tenants">
                        Lock tenant override
                    </MudButton>
                }
                else if (UseInstanceScope && HasAtprotoAffordance(UnlockRelation(AtprotoEventsBackfillEnabledKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsBackfillEnabledKey, false))"
                               aria-label="Unlock inbound event recovery for tenants">
                        Unlock tenant override
                    </MudButton>
                }

                <MudDivider />

                var backfillModeSetting = FindSetting(AtprotoEventsBackfillModeKey);
                <MudSelect T="string"
                           Label="Inbound recovery mode"
                           Value="@AtprotoEventsBackfillMode"
                           ValueChanged="SetAtprotoEventsBackfillModeAsync"
                           Variant="Variant.Outlined"
                           Disabled="@(_atprotoSaving || !CanEdit(AtprotoEventsBackfillModeKey))">
                    <MudSelectItem Value="@DowntimeOnlyBackfillMode">Downtime gaps only</MudSelectItem>
                    <MudSelectItem Value="@FullBackfillMode">Full replay</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Downtime gaps only is the safe default. Full replay requests recovery across all available history.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Source: @SettingSourceLabel(backfillModeSetting?.Source). Lock: @LockStateLabel(backfillModeSetting?.IsLocked).
                </MudText>

                @if (!CanEdit(AtprotoEventsBackfillModeKey))
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" role="status">
                        @LockedReason(AtprotoEventsBackfillModeKey)
                    </MudText>
                }

                @if (UseInstanceScope && HasAtprotoAffordance(LockRelation(AtprotoEventsBackfillModeKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsBackfillModeKey, true))"
                               aria-label="Lock inbound recovery mode for tenants">
                        Lock tenant override
                    </MudButton>
                }
                else if (UseInstanceScope && HasAtprotoAffordance(UnlockRelation(AtprotoEventsBackfillModeKey)))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="@_atprotoSaving"
                               OnClick="@(() => SetAtprotoLockAsync(AtprotoEventsBackfillModeKey, false))"
                               aria-label="Unlock inbound recovery mode for tenants">
                        Unlock tenant override
                    </MudButton>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_atprotoMessage) && _atprotoSettings is not null)
            {
                <MudAlert Severity="@(_atprotoSaveSucceeded ? Severity.Success : Severity.Error)" Dense="true"
                          role="@(_atprotoSaveSucceeded ? "status" : "alert")">
                    @_atprotoMessage
                </MudAlert>
            }
        </MudStack>
    </MudStack>
</div>

@code {
    private const string EventsCategory = "Events";
    private const string OrganizationsCategory = "Organizations";
    private const string GroupsCategory = "Groups";
    private const string EventsUserSubmissionEnabledKey = "events.user_submission_enabled";
    private const string EventsOrganizationSubmissionEnabledKey = "events.organization_submission_enabled";
    private const string EventsGroupSubmissionEnabledKey = "events.group_submission_enabled";
    private const string EventsRequireApprovalKey = "events.require_approval";
    private const string EventsCardClickOpensDetailPageKey = "events.card_click_opens_detail_page";
    private const string OrganizationsVerificationRequiredKey = "organizations.verification_required";
    private const string OrganizationsSelfRegistrationEnabledKey = "organizations.self_registration_enabled";
    private const string GroupsSelfRegistrationEnabledKey = "groups.self_registration_enabled";
    private const string AtprotoEventsEnabledKey = "federation.atproto_events_enabled";
    private const string AtprotoValidationProfileKey = "federation.atproto_event_validation_profile";
    private const string AtprotoEventsBackfillEnabledKey = "federation.atproto_events_backfill_enabled";
    private const string AtprotoEventsBackfillModeKey = "federation.atproto_events_backfill_mode";
    private const string PlatformValidationProfile = "platform";
    private const string CommunityValidationProfile = "community_lexicon";
    private const string DowntimeOnlyBackfillMode = "downtime_only";
    private const string FullBackfillMode = "full";

    private static readonly string[] EventsPolicyKeys =
    [
        EventsUserSubmissionEnabledKey,
        EventsOrganizationSubmissionEnabledKey,
        EventsGroupSubmissionEnabledKey,
        EventsRequireApprovalKey,
        EventsCardClickOpensDetailPageKey
    ];

    private static readonly string[] OrganizationsPolicyKeys =
    [
        OrganizationsVerificationRequiredKey,
        OrganizationsSelfRegistrationEnabledKey
    ];

    private static readonly string[] GroupsPolicyKeys = [GroupsSelfRegistrationEnabledKey];

    private readonly Dictionary<string, EffectiveSettingDto> _policySettings = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _confirmedPolicyValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _policyDisplayValues = new(StringComparer.Ordinal);
    private readonly HashSet<string> _pendingPolicyKeys = new(StringComparer.Ordinal);
    private IReadOnlyList<AtprotoSettingView>? _atprotoSettings;
    private IReadOnlyDictionary<string, HalLink> _atprotoLinks = new Dictionary<string, HalLink>();
    private bool _atprotoLoading = true;
    private bool _atprotoSaving;
    private bool _atprotoSaveSucceeded;
    private string? _atprotoMessage;
    private bool _canManageTenantSettings;
    private bool _policySaveSucceeded;
    private string? _policyMessage;
    private bool _disposed;

    [Parameter, EditorRequired]
    public TenantPolicySettingsDto Model { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    [Parameter]
    public bool UseInstanceScope { get; set; }

    [Parameter]
    public EventCallback<bool> PendingChanged { get; set; }

    private bool AtprotoEventsEnabled => ReadBool(FindSetting(AtprotoEventsEnabledKey)?.Value);

    private string AtprotoValidationProfile =>
        ReadString(FindSetting(AtprotoValidationProfileKey)?.Value) is CommunityValidationProfile
            ? CommunityValidationProfile
            : PlatformValidationProfile;

    private bool AtprotoEventsBackfillEnabled =>
        ReadBool(FindSetting(AtprotoEventsBackfillEnabledKey)?.Value);

    private string AtprotoEventsBackfillMode =>
        ReadString(FindSetting(AtprotoEventsBackfillModeKey)?.Value) is FullBackfillMode
            ? FullBackfillMode
            : DowntimeOnlyBackfillMode;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPolicySettingsAsync(), LoadAtprotoSettingsAsync());
    }

    private Task SetAllowUserSubmittedEventsAsync(bool? enabled) =>
        SavePolicySettingAsync(EventsUserSubmissionEnabledKey, enabled);

    private Task SetAllowOrganizationSubmittedEventsAsync(bool? enabled) =>
        SavePolicySettingAsync(EventsOrganizationSubmissionEnabledKey, enabled);

    private Task SetAllowGroupSubmittedEventsAsync(bool? enabled) =>
        SavePolicySettingAsync(EventsGroupSubmissionEnabledKey, enabled);

    private Task SetRequireEventApprovalAsync(bool? enabled) =>
        SavePolicySettingAsync(EventsRequireApprovalKey, enabled);

    private Task SetEventCardClickOpensDetailPageAsync(bool? enabled) =>
        SavePolicySettingAsync(EventsCardClickOpensDetailPageKey, enabled);

    private Task SetRequireOrganizationVerificationAsync(bool? enabled) =>
        SavePolicySettingAsync(OrganizationsVerificationRequiredKey, enabled);

    private Task SetAllowOrganizationSelfRegistrationAsync(bool? enabled) =>
        SavePolicySettingAsync(OrganizationsSelfRegistrationEnabledKey, enabled);

    private Task SetAllowGroupSelfRegistrationAsync(bool? enabled) =>
        SavePolicySettingAsync(GroupsSelfRegistrationEnabledKey, enabled);

    private async Task LoadPolicySettingsAsync()
    {
        SeedConfirmedPolicyValues();

        try
        {
            TenantOnboardingStatusDto? status = await TenantOnboardingService.GetStatusAsync();
            if (_disposed)
            {
                return;
            }

            _canManageTenantSettings = status?.HasHalLink("manage-tenant-settings") == true;
            if (!_canManageTenantSettings)
            {
                return;
            }

            await LoadPolicyCategoryAsync(EventsCategory);
            await LoadPolicyCategoryAsync(OrganizationsCategory);
            await LoadPolicyCategoryAsync(GroupsCategory);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to load tenant policy setting metadata.");
            if (!_disposed)
            {
                _canManageTenantSettings = false;
                _policySettings.Clear();
            }
        }
    }

    private async Task SavePolicySettingAsync(string key, bool? enabled)
    {
        if (_disposed
            || enabled is not bool requestedValue
            || !CanEditPolicy(key)
            || !_pendingPolicyKeys.Add(key))
        {
            return;
        }

        _policyDisplayValues[key] = requestedValue;
        _policyMessage = null;
        try
        {
            if (_pendingPolicyKeys.Count == 1)
            {
                await PendingChanged.InvokeAsync(true);
            }

            BaseCommandResponseOfGuid response = await TenantOnboardingService.UpdateTenantSettingAsync(
                key,
                requestedValue ? "true" : "false");
            if (response.Success == true)
            {
                ApplyPolicyValue(key, requestedValue);
                if (!_disposed)
                {
                    _confirmedPolicyValues[key] = requestedValue;
                    _policyDisplayValues[key] = requestedValue;
                    _policySaveSucceeded = true;
                    _policyMessage = $"{PolicyLabel(key)} saved.";
                    await Announcer.AnnouncePoliteAsync(_policyMessage);
                }

                return;
            }

            await RecoverPolicySettingAsync(key);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to update tenant policy setting {SettingKey}.", key);
            await RecoverPolicySettingAsync(key);
        }
        finally
        {
            _pendingPolicyKeys.Remove(key);
            if (_pendingPolicyKeys.Count == 0)
            {
                await PendingChanged.InvokeAsync(false);
            }
        }
    }

    private async Task RecoverPolicySettingAsync(string key)
    {
        string? category = PolicyCategory(key);
        (EffectiveSettingDto Setting, bool Value)? recovery = category is null
            ? null
            : await LoadRecoveryValueAsync(category, key);
        if (recovery is { } authoritative)
        {
            ApplyPolicyValue(key, authoritative.Value);
            if (!_disposed)
            {
                _policySettings[key] = authoritative.Setting;
                _confirmedPolicyValues[key] = authoritative.Value;
                _policyDisplayValues[key] = authoritative.Value;
            }
        }
        else if (_confirmedPolicyValues.TryGetValue(key, out bool confirmedValue))
        {
            ApplyPolicyValue(key, confirmedValue);
            if (!_disposed)
            {
                _policyDisplayValues[key] = confirmedValue;
            }
        }

        if (!_disposed)
        {
            _policySaveSucceeded = false;
            _policyMessage = $"{PolicyLabel(key)} could not be saved. The latest setting value was restored.";
            await Announcer.AnnounceAssertiveAsync(_policyMessage);
        }
    }

    private async Task<(EffectiveSettingDto Setting, bool Value)?> LoadRecoveryValueAsync(
        string category,
        string key)
    {
        try
        {
            SettingGroupResponseDto? response = await TenantOnboardingService.GetTenantSettingsAsync(category);
            if (response is null || !string.Equals(response.Category, category, StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            EffectiveSettingDto[] matches = response.Settings
                .Where(setting => string.Equals(setting.Key, key, StringComparison.Ordinal))
                .Take(2)
                .ToArray();
            return matches.Length == 1 && TryReadBoolean(matches[0].Value, out bool value)
                ? (matches[0], value)
                : null;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to reload tenant policy category {Category}.", category);
            return null;
        }
    }

    private async Task LoadPolicyCategoryAsync(string category, string? recoveryKey = null)
    {
        try
        {
            SettingGroupResponseDto? response = await TenantOnboardingService.GetTenantSettingsAsync(category);
            if (_disposed)
            {
                return;
            }

            if (response is null || !string.Equals(response.Category, category, StringComparison.OrdinalIgnoreCase))
            {
                InvalidatePolicyCategory(category, recoveryKey);
                return;
            }

            foreach (string key in PolicyKeysForCategory(category))
            {
                if (_pendingPolicyKeys.Contains(key) && !string.Equals(key, recoveryKey, StringComparison.Ordinal))
                {
                    continue;
                }

                EffectiveSettingDto[] matches = response.Settings
                    .Where(setting => string.Equals(setting.Key, key, StringComparison.Ordinal))
                    .Take(2)
                    .ToArray();
                if (matches.Length != 1 || !TryReadBoolean(matches[0].Value, out bool value))
                {
                    _policySettings.Remove(key);
                    RestoreConfirmedValue(key, recoveryKey);
                    continue;
                }

                _policySettings[key] = matches[0];
                _confirmedPolicyValues[key] = value;
                ApplyPolicyValue(key, value);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to reload tenant policy category {Category}.", category);
            if (!_disposed)
            {
                InvalidatePolicyCategory(category, recoveryKey);
            }
        }
    }

    private void InvalidatePolicyCategory(string category, string? recoveryKey)
    {
        foreach (string key in PolicyKeysForCategory(category))
        {
            if (_pendingPolicyKeys.Contains(key) && !string.Equals(key, recoveryKey, StringComparison.Ordinal))
            {
                continue;
            }

            _policySettings.Remove(key);
            RestoreConfirmedValue(key, recoveryKey);
        }
    }

    private void RestoreConfirmedValue(string key, string? recoveryKey)
    {
        if (string.Equals(key, recoveryKey, StringComparison.Ordinal)
            && _confirmedPolicyValues.TryGetValue(key, out bool confirmedValue))
        {
            ApplyPolicyValue(key, confirmedValue);
        }
    }

    private void SeedConfirmedPolicyValues()
    {
        SeedConfirmedPolicyValue(EventsUserSubmissionEnabledKey, Model.AllowUserSubmittedEvents);
        SeedConfirmedPolicyValue(EventsOrganizationSubmissionEnabledKey, Model.AllowOrganizationSubmittedEvents);
        SeedConfirmedPolicyValue(EventsGroupSubmissionEnabledKey, Model.AllowGroupSubmittedEvents);
        SeedConfirmedPolicyValue(EventsRequireApprovalKey, Model.RequireEventApproval);
        SeedConfirmedPolicyValue(EventsCardClickOpensDetailPageKey, Model.EventCardClickOpensDetailPage);
        SeedConfirmedPolicyValue(OrganizationsVerificationRequiredKey, Model.RequireOrganizationVerification);
        SeedConfirmedPolicyValue(OrganizationsSelfRegistrationEnabledKey, Model.AllowOrganizationSelfRegistration);
        SeedConfirmedPolicyValue(GroupsSelfRegistrationEnabledKey, Model.AllowGroupSelfRegistration);
    }

    private void SeedConfirmedPolicyValue(string key, bool? value)
    {
        if (value is bool confirmedValue)
        {
            _confirmedPolicyValues[key] = confirmedValue;
            _policyDisplayValues[key] = confirmedValue;
        }
    }

    private bool? PolicyDisplayValue(string key) =>
        _policyDisplayValues.TryGetValue(key, out bool displayValue)
            ? displayValue
            : ReadModelPolicyValue(key);

    private bool? ReadModelPolicyValue(string key) => key switch
    {
        EventsUserSubmissionEnabledKey => Model.AllowUserSubmittedEvents,
        EventsOrganizationSubmissionEnabledKey => Model.AllowOrganizationSubmittedEvents,
        EventsGroupSubmissionEnabledKey => Model.AllowGroupSubmittedEvents,
        EventsRequireApprovalKey => Model.RequireEventApproval,
        EventsCardClickOpensDetailPageKey => Model.EventCardClickOpensDetailPage,
        OrganizationsVerificationRequiredKey => Model.RequireOrganizationVerification,
        OrganizationsSelfRegistrationEnabledKey => Model.AllowOrganizationSelfRegistration,
        GroupsSelfRegistrationEnabledKey => Model.AllowGroupSelfRegistration,
        _ => null
    };

    private bool CanEditPolicy(string key) =>
        _canManageTenantSettings
        && !_pendingPolicyKeys.Contains(key)
        && _policySettings.TryGetValue(key, out EffectiveSettingDto? setting)
        && setting.CanEdit == true;

    private bool IsPolicyDisabled(string key) => !CanEditPolicy(key);

    private string PolicyDisabledReason(string key)
    {
        if (_pendingPolicyKeys.Contains(key))
        {
            return $"{PolicyLabel(key)} is saving.";
        }

        if (!_canManageTenantSettings)
        {
            return "The server has not granted tenant settings management access.";
        }

        return _policySettings.TryGetValue(key, out EffectiveSettingDto? setting)
            ? setting.Reason ?? "This setting is not editable."
            : "Setting metadata is unavailable.";
    }

    private void ApplyPolicyValue(string key, bool value)
    {
        switch (key)
        {
            case EventsUserSubmissionEnabledKey:
                Model.AllowUserSubmittedEvents = value;
                break;
            case EventsOrganizationSubmissionEnabledKey:
                Model.AllowOrganizationSubmittedEvents = value;
                break;
            case EventsGroupSubmissionEnabledKey:
                Model.AllowGroupSubmittedEvents = value;
                break;
            case EventsRequireApprovalKey:
                Model.RequireEventApproval = value;
                break;
            case EventsCardClickOpensDetailPageKey:
                Model.EventCardClickOpensDetailPage = value;
                break;
            case OrganizationsVerificationRequiredKey:
                Model.RequireOrganizationVerification = value;
                break;
            case OrganizationsSelfRegistrationEnabledKey:
                Model.AllowOrganizationSelfRegistration = value;
                break;
            case GroupsSelfRegistrationEnabledKey:
                Model.AllowGroupSelfRegistration = value;
                break;
        }
    }

    private static IReadOnlyList<string> PolicyKeysForCategory(string category) => category switch
    {
        EventsCategory => EventsPolicyKeys,
        OrganizationsCategory => OrganizationsPolicyKeys,
        GroupsCategory => GroupsPolicyKeys,
        _ => []
    };

    private static string? PolicyCategory(string key) => key switch
    {
        EventsUserSubmissionEnabledKey
            or EventsOrganizationSubmissionEnabledKey
            or EventsGroupSubmissionEnabledKey
            or EventsRequireApprovalKey
            or EventsCardClickOpensDetailPageKey => EventsCategory,
        OrganizationsVerificationRequiredKey
            or OrganizationsSelfRegistrationEnabledKey => OrganizationsCategory,
        GroupsSelfRegistrationEnabledKey => GroupsCategory,
        _ => null
    };

    private static string PolicyLabel(string key) => key switch
    {
        EventsUserSubmissionEnabledKey => "Allow users to submit events",
        EventsOrganizationSubmissionEnabledKey => "Allow organizations to submit events",
        EventsGroupSubmissionEnabledKey => "Allow groups to submit events",
        EventsRequireApprovalKey => "Require approval before publication",
        EventsCardClickOpensDetailPageKey => "Event card click opens detail page",
        OrganizationsVerificationRequiredKey => "Require organization verification",
        OrganizationsSelfRegistrationEnabledKey => "Allow organization self-registration",
        GroupsSelfRegistrationEnabledKey => "Allow group self-registration",
        _ => "Policy setting"
    };

    private static bool TryReadBoolean(string? value, out bool parsed) =>
        bool.TryParse(value?.Trim().Trim('"'), out parsed);

    public void Dispose()
    {
        _disposed = true;
    }

    private async Task LoadAtprotoSettingsAsync()
    {
        if (_disposed)
        {
            return;
        }

        _atprotoLoading = true;
        _atprotoMessage = null;
        try
        {
            await RefreshAtprotoSettingsAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == (int)System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(exception, "Application session expired while loading tenant AT Protocol event settings.");
            if (!_disposed)
            {
                _atprotoSettings = null;
                _atprotoLinks = new Dictionary<string, HalLink>();
                _atprotoMessage = "Your application session expired. Sign in again to manage federation settings.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to load tenant AT Protocol event settings.");
            if (!_disposed)
            {
                _atprotoSettings = null;
                _atprotoLinks = new Dictionary<string, HalLink>();
                _atprotoMessage = "AT Protocol event settings are temporarily unavailable.";
            }
        }
        finally
        {
            if (!_disposed)
            {
                _atprotoLoading = false;
            }
        }
    }

    private Task SetAtprotoEventsEnabledAsync(bool enabled) =>
        SaveAtprotoSettingAsync(AtprotoEventsEnabledKey, enabled ? "true" : "false");

    private Task SetAtprotoValidationProfileAsync(string profile) =>
        SaveAtprotoSettingAsync(
            AtprotoValidationProfileKey,
            profile == CommunityValidationProfile ? CommunityValidationProfile : PlatformValidationProfile);

    private Task SetAtprotoEventsBackfillEnabledAsync(bool enabled) =>
        SaveAtprotoSettingAsync(AtprotoEventsBackfillEnabledKey, enabled ? "true" : "false");

    private Task SetAtprotoEventsBackfillModeAsync(string mode) =>
        SaveAtprotoSettingAsync(
            AtprotoEventsBackfillModeKey,
            mode == FullBackfillMode ? FullBackfillMode : DowntimeOnlyBackfillMode);

    private async Task SaveAtprotoSettingAsync(string key, string value)
    {
        if (_disposed || _atprotoSaving || !CanEdit(key))
        {
            return;
        }

        _atprotoSaving = true;
        _atprotoMessage = null;
        try
        {
            BaseCommandResponseOfGuid response = UseInstanceScope
                ? await AtprotoFederationSettingsService.UpdateInstanceAsync(key, value)
                : await AtprotoFederationSettingsService.UpdateTenantAsync(key, value);
            if (_disposed)
            {
                return;
            }

            _atprotoSaveSucceeded = response.Success == true;
            _atprotoMessage = _atprotoSaveSucceeded
                ? "AT Protocol event settings saved."
                : "AT Protocol event settings could not be saved.";
            if (_atprotoSaveSucceeded)
            {
                await RefreshAtprotoSettingsAsync();
            }
        }
        catch (ApiException exception) when (exception.StatusCode == (int)System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(exception, "Application session expired while updating tenant AT Protocol event setting {SettingKey}.", key);
            if (!_disposed)
            {
                _atprotoSaveSucceeded = false;
                _atprotoMessage = "Your application session expired. Sign in again to manage federation settings.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to update tenant AT Protocol event setting {SettingKey}.", key);
            if (!_disposed)
            {
                _atprotoSaveSucceeded = false;
                _atprotoMessage = "AT Protocol event settings could not be saved.";
            }
        }
        finally
        {
            if (!_disposed)
            {
                _atprotoSaving = false;
            }
        }
    }

    private async Task SetAtprotoLockAsync(string key, bool shouldLock)
    {
        var relation = shouldLock ? LockRelation(key) : UnlockRelation(key);
        if (_disposed || _atprotoSaving || !UseInstanceScope || !HasAtprotoAffordance(relation))
        {
            return;
        }

        _atprotoSaving = true;
        _atprotoMessage = null;
        try
        {
            var response = await AtprotoFederationSettingsService.SetInstanceLockAsync(key, shouldLock);
            if (_disposed)
            {
                return;
            }

            _atprotoSaveSucceeded = response.Success == true;
            _atprotoMessage = _atprotoSaveSucceeded
                ? shouldLock ? "Tenant override locked." : "Tenant override unlocked."
                : "The tenant lock could not be changed.";
            if (_atprotoSaveSucceeded)
            {
                await RefreshAtprotoSettingsAsync();
            }
        }
        catch (ApiException exception) when (exception.StatusCode == (int)System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(exception, "Application session expired while changing the instance lock for AT Protocol setting {SettingKey}.", key);
            if (!_disposed)
            {
                _atprotoSaveSucceeded = false;
                _atprotoMessage = "Your application session expired. Sign in again to manage federation settings.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to change the instance lock for AT Protocol setting {SettingKey}.", key);
            if (!_disposed)
            {
                _atprotoSaveSucceeded = false;
                _atprotoMessage = "The tenant lock could not be changed.";
            }
        }
        finally
        {
            if (!_disposed)
            {
                _atprotoSaving = false;
            }
        }
    }

    private async Task RefreshAtprotoSettingsAsync()
    {
        if (UseInstanceScope)
        {
            var resource = await AtprotoFederationSettingsService.GetInstanceAsync();
            if (_disposed)
            {
                return;
            }

            _atprotoSettings = resource.Settings.Select(setting => new AtprotoSettingView(
                setting.Key,
                setting.Value,
                setting.Source is { } source && Enum.IsDefined(typeof(SettingSource), source)
                    ? (SettingSource)source
                    : null,
                setting.IsLocked,
                setting.CanEdit == true,
                setting.Reason)).ToArray();
            _atprotoLinks = resource._links is null
                ? new Dictionary<string, HalLink>()
                : new Dictionary<string, HalLink>(resource._links, StringComparer.Ordinal);
            return;
        }

        var tenantSettings = await AtprotoFederationSettingsService.GetTenantAsync();
        if (_disposed)
        {
            return;
        }

        _atprotoSettings = tenantSettings.Settings.Select(setting => new AtprotoSettingView(
            setting.Key,
            setting.Value,
            setting.Source,
            setting.IsLocked,
            setting.CanEdit == true,
            setting.Reason)).ToArray();
        _atprotoLinks = new Dictionary<string, HalLink>();
    }

    private AtprotoSettingView? FindSetting(string key) =>
        _atprotoSettings?.FirstOrDefault(setting =>
            string.Equals(setting.Key, key, StringComparison.Ordinal));

    private bool CanEdit(string key) => UseInstanceScope
        ? HasAtprotoAffordance(UpdateRelation(key))
        : FindSetting(key)?.CanEdit == true;

    private bool HasAtprotoAffordance(string relation) => _atprotoLinks.ContainsKey(relation);

    private string LockedReason(string key) =>
        FindSetting(key)?.Reason ?? (UseInstanceScope
            ? "The server has not granted an update affordance for this instance setting."
            : "This setting is locked by the instance administrator.");

    private static string UpdateRelation(string key) => $"update-{key}";

    private static string LockRelation(string key) => $"lock-{key}";

    private static string UnlockRelation(string key) => $"unlock-{key}";

    private static bool ReadBool(string? value) =>
        bool.TryParse(value?.Trim().Trim('"'), out bool parsed) && parsed;

    private static string ReadString(string? value) => value?.Trim().Trim('"') ?? string.Empty;

    private static string LockStateLabel(bool? isLocked) => isLocked switch
    {
        true => "Locked",
        false => "Unlocked",
        null => "Unknown"
    };

    private static string SettingSourceLabel(SettingSource? source) => source switch
    {
        SettingSource.SystemDefault => "System default",
        SettingSource.TenantOverride => "Tenant override",
        SettingSource.SystemLocked => "System locked",
        SettingSource.OrganizationOverride => "Organization override",
        SettingSource.GroupOverride => "Group override",
        SettingSource.UserPreference => "User preference",
        SettingSource.TenantLocked => "Tenant locked",
        _ => "Unknown"
    };

    private sealed record AtprotoSettingView(
        string Key,
        string Value,
        SettingSource? Source,
        bool? IsLocked,
        bool CanEdit,
        string? Reason);
}
