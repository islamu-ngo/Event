@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Webhooks
@using MudBlazor
@inject IWebhookManagementService WebhookService
@inject IWebhookOperationsService WebhookOperations
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="settings-section webhook-management"
     role="region"
     aria-label="@($"{Owner.DisplayName} webhook management")"
     aria-busy="@_isLoading.ToString().ToLowerInvariant()">
    <div class="settings-section-header webhook-management__header">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 700;">Webhooks</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                Manage @Owner.DisplayName.ToLowerInvariant()-owned outgoing webhook consumers, endpoints, and delivery activity.
            </MudText>
        </div>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="webhook-management__header-actions">
            <MudTooltip Text="Refresh webhooks">
                <AppIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="RefreshAsync"
                               Disabled="_isLoading || _isBusy"
                               aria-label="Refresh webhooks" />
            </MudTooltip>
            @if (_snapshot.CanCreateConsumer)
            {
                <AppButton
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.AddBusiness"
                           OnClick="OpenCreateConsumerDialog"
                           Disabled="_isLoading || _isBusy">
                    Create Consumer
                </AppButton>
            }
            @if (_snapshot.CanCreateEndpoint)
            {
                <AppButton
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.AddLink"
                           OnClick="OpenCreateEndpointDialog"
                           Disabled="_isLoading || _isBusy || _snapshot.Consumers.Count == 0 || SelectableEventTypes.Count == 0">
                    Create Endpoint
                </AppButton>
            }
        </MudStack>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
            @_errorMessage
        </MudAlert>
    }

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="webhook-management__loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Loading webhooks...</MudText>
        </MudStack>
    }
    else if (!_snapshot.IsSuccess)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_snapshot.ErrorMessage
        </MudAlert>
    }
    else
    {
        <div class="webhook-management__metrics" aria-label="Webhook status summary">
            <div class="webhook-management__metric">
                <span class="webhook-management__metric-value">@_snapshot.Consumers.Count</span>
                <span class="webhook-management__metric-label">Consumers</span>
            </div>
            <div class="webhook-management__metric">
                <span class="webhook-management__metric-value">@_snapshot.Endpoints.Count</span>
                <span class="webhook-management__metric-label">Endpoints</span>
            </div>
            <div class="webhook-management__metric">
                <span class="webhook-management__metric-value">@FailingEndpointCount</span>
                <span class="webhook-management__metric-label">Failing</span>
            </div>
            <div class="webhook-management__metric">
                <span class="webhook-management__metric-value">@RetryableAttemptCount</span>
                <span class="webhook-management__metric-label">Retryable</span>
            </div>
            <div class="webhook-management__metric webhook-management__metric--wide">
                <span class="webhook-management__metric-value">@ProviderModeSummary</span>
                <span class="webhook-management__metric-label">Provider modes</span>
            </div>
        </div>

        <MudTabs Elevation="0"
                 Rounded="false"
                 KeepPanelsAlive="true"
                 MinimumTabWidth="0px"
                 Class="webhook-management__tabs"
                 TabPanelsClass="webhook-management__tab-panel"
                 Color="Color.Transparent"
                 SliderColor="Color.Primary">
            <MudTabPanel Text="Consumers" Icon="@Icons.Material.Filled.AccountTree">
                <MudTable T="HalResourceOfWebhookConsumerDto"
                          Items="_snapshot.Consumers"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Xl"
                          Class="webhook-management__table">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Kind</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Class="webhook-management__actions-cell">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Kind">@context.ConsumerKindName</MudTd>
                        <MudTd DataLabel="Provider">
                            <div class="webhook-management__provider-summary">
                                <MudChip T="string" Size="Size.Small" Color="@ProviderColor(context.ProviderModeName)" Variant="Variant.Outlined">@context.ProviderModeName</MudChip>
                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary"
                                         Class="webhook-management__capability-summary"
                                         title="@ProviderCapabilityExplanation(context)">
                                    @ProviderCapabilitySummary(context)
                                </MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusName)" Variant="Variant.Outlined">@context.StatusName</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="webhook-management__actions-cell">
                            <div class="webhook-management__action-group">
                                @if (HasProviderPortalLink(context))
                                {
                                    <MudTooltip Text="Open provider portal">
                                        <AppIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenProviderPortalAsync(context))"
                                                       Disabled="_isBusy"
                                                       aria-label="Open provider portal" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No webhook consumers.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Endpoints" Icon="@Icons.Material.Filled.Hub">
                <MudTable T="HalResourceOfWebhookEndpointDto"
                          Items="_snapshot.Endpoints"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Xl"
                          Class="webhook-management__table">
                    <HeaderContent>
                        <MudTh>Destination</MudTh>
                        <MudTh>Consumer</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Events</MudTh>
                        <MudTh>Last Result</MudTh>
                        <MudTh Class="webhook-management__actions-cell">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Destination">
                            <div class="webhook-management__cell-content">
                                <div class="webhook-management__url">@context.DestinationHost</div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Secret v@(context.SecretVersion ?? 0)</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Consumer">
                            <div class="webhook-management__cell-content">
                                <MudText Typo="Typo.body2">@context.ConsumerName</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@ProviderColor(context.ProviderModeName)" Variant="Variant.Text">@ShortText(context.ProviderModeName, 24)</MudChip>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusName)" Variant="Variant.Outlined">@context.StatusName</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Events">@SubscriptionSummary(context)</MudTd>
                        <MudTd DataLabel="Last Result">
                            <div class="webhook-management__cell-content">
                                <MudText Typo="Typo.caption">OK @FormatDate(context.LastSuccessAt)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Fail @FormatDate(context.LastFailureAt)</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="webhook-management__actions-cell">
                            <div class="webhook-management__action-content">
                                <div class="webhook-management__action-group">
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.Update))
                                    {
                                        <MudTooltip Text="Update endpoint">
                                            <AppIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenUpdateEndpointDialog(context))"
                                                           Disabled="_isBusy"
                                                           aria-label="Update endpoint" />
                                        </MudTooltip>
                                    }
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.RotateSecret))
                                    {
                                        <MudTooltip Text="Rotate signing secret">
                                            <AppIconButton Icon="@Icons.Material.Filled.Key"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenRotateDialog(context))"
                                                           Disabled="_isBusy"
                                                           aria-label="Rotate signing secret" />
                                        </MudTooltip>
                                    }
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.Test))
                                    {
                                        <MudTooltip Text="Send test webhook">
                                            <AppIconButton Icon="@Icons.Material.Filled.Bolt"
                                                           Color="Color.Info"
                                                           Size="Size.Small"
                                                           OnClick="@(() => TestEndpointAsync(context))"
                                                           Disabled="_isBusy"
                                                           aria-label="Send test webhook" />
                                        </MudTooltip>
                                    }
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.Pause))
                                    {
                                        <MudTooltip Text="Pause Local delivery">
                                            <AppIconButton Icon="@Icons.Material.Filled.PauseCircle"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenEndpointControlDialog(context, EndpointControlMode.Pause))"
                                                           Disabled="_isBusy"
                                                           aria-label="Pause webhook endpoint" />
                                        </MudTooltip>
                                    }
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.Resume))
                                    {
                                        <MudTooltip Text="Resume Local delivery">
                                            <AppIconButton Icon="@Icons.Material.Filled.PlayCircle"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenEndpointControlDialog(context, EndpointControlMode.Resume))"
                                                           Disabled="_isBusy"
                                                           aria-label="Resume webhook endpoint" />
                                        </MudTooltip>
                                    }
                                    @if (HasEndpointLink(context, WebhookClientLinkRelations.Delete))
                                    {
                                        <MudTooltip Text="Archive endpoint">
                                            <AppIconButton Icon="@Icons.Material.Filled.Archive"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenArchiveDialog(context))"
                                                           Disabled="_isBusy"
                                                           aria-label="Archive endpoint" />
                                        </MudTooltip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="webhook-management__action-availability">
                                    @EndpointDeliveryControlAvailability(context)
                                </MudText>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No webhook endpoints.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Events" Icon="@Icons.Material.Filled.Schema">
                <div class="webhook-management__catalog">
                    @foreach (var group in _snapshot.EventTypes.GroupBy(eventType => eventType.GroupName).OrderBy(group => group.Key))
                    {
                        <section class="webhook-management__catalog-group" aria-label="@group.Key">
                            <MudText Typo="Typo.subtitle2" Class="webhook-management__catalog-heading">@group.Key</MudText>
                            <div class="webhook-management__event-list">
                                @foreach (var eventType in group.OrderBy(item => item.Name))
                                {
                                    <div class="webhook-management__event-row">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="webhook-management__event-name">@eventType.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@eventType.Description</MudText>
                                        </div>
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <MudChip T="string" Size="Size.Small" Color="@(eventType.IsEnabled == true ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                                @(eventType.IsEnabled == true ? "Enabled" : "Disabled")
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">v@(eventType.SchemaVersion ?? 0)</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@((eventType.PayloadRetentionDays ?? 0).ToString())d</MudChip>
                                        </MudStack>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Deliveries" Icon="@Icons.Material.Filled.Send">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="webhook-management__section-title">Messages</MudText>
                        <MudTable T="HalResourceOfWebhookMessageDto"
                                  Items="_snapshot.Messages"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0"
                                  Breakpoint="Breakpoint.Xl"
                                  Class="webhook-management__table webhook-management__desktop-table">
                            <HeaderContent>
                                <MudTh>Event</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Created</MudTh>
                                <MudTh Class="webhook-management__actions-cell">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Event">
                                    <MudText Typo="Typo.body2">@context.EventType</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ShortText(context.PayloadHash, 18)</MudText>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(MessageState(context))" Variant="Variant.Outlined">@MessageState(context)</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Created">@FormatDate(context.CreatedAt)</MudTd>
                                <MudTd DataLabel="Actions" Class="webhook-management__actions-cell">
                                    <div class="webhook-management__action-group">
                                        @if (context.Id is Guid messageId)
                                        {
                                            @if (HasMessageLink(context, WebhookClientLinkRelations.DeliveryAttempts))
                                            {
                                                <MudTooltip Text="View delivery attempts">
                                                    <AppIconButton Icon="@Icons.Material.Filled.ListAlt"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => LoadAttemptsForMessageAsync(messageId, context.EventType))"
                                                                   Disabled="_isBusy"
                                                                   aria-label="View delivery attempts" />
                                                </MudTooltip>
                                            }
                                            @if (HasMessageLink(context, WebhookClientLinkRelations.Payload))
                                            {
                                                <MudTooltip Text="View retained payload">
                                                    <AppIconButton Icon="@Icons.Material.Filled.DataObject"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => ViewPayloadAsync(messageId))"
                                                                   Disabled="_isBusy"
                                                                   aria-label="View webhook payload" />
                                                </MudTooltip>
                                            }
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No webhook messages.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                        <div class="webhook-management__mobile-list">
                            @if (_snapshot.Messages.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No webhook messages.</MudText>
                            }
                            else
                            {
                                @foreach (var message in _snapshot.Messages)
                                {
                                    <section class="webhook-management__mobile-card"
                                             aria-label="@($"Webhook message {message.EventType}")">
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Event</span>
                                            <span class="webhook-management__mobile-value">
                                                <MudText Typo="Typo.body2">@message.EventType</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ShortText(message.PayloadHash, 18)</MudText>
                                            </span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Status</span>
                                            <span class="webhook-management__mobile-value">
                                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(MessageState(message))" Variant="Variant.Outlined">@MessageState(message)</MudChip>
                                            </span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Created</span>
                                            <span class="webhook-management__mobile-value">@FormatDate(message.CreatedAt)</span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Actions</span>
                                            <span class="webhook-management__mobile-value">
                                                @if (message.Id is Guid messageId)
                                                {
                                                    @if (HasMessageLink(message, WebhookClientLinkRelations.DeliveryAttempts))
                                                    {
                                                        <MudTooltip Text="View delivery attempts">
                                                            <AppIconButton Icon="@Icons.Material.Filled.ListAlt"
                                                                           Color="Color.Primary"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => LoadAttemptsForMessageAsync(messageId, message.EventType))"
                                                                           Disabled="_isBusy"
                                                                           aria-label="View delivery attempts" />
                                                        </MudTooltip>
                                                    }
                                                    @if (HasMessageLink(message, WebhookClientLinkRelations.Payload))
                                                    {
                                                        <MudTooltip Text="View retained payload">
                                                            <AppIconButton Icon="@Icons.Material.Filled.DataObject"
                                                                           Color="Color.Info"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => ViewPayloadAsync(messageId))"
                                                                           Disabled="_isBusy"
                                                                           aria-label="View webhook payload" />
                                                        </MudTooltip>
                                                    }
                                                }
                                            </span>
                                        </div>
                                    </section>
                                }
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="webhook-management__section-title-row">
                            <MudText Typo="Typo.subtitle2" Class="webhook-management__section-title">@_attemptScopeLabel</MudText>
                            @if (_attemptScopeMessageId.HasValue)
                            {
                                <AppButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAttemptFilterAsync" Disabled="_isBusy">
                                    All attempts
                                </AppButton>
                            }
                        </MudStack>
                        <MudTable T="HalResourceOfWebhookDeliveryAttemptDto"
                                  Items="_visibleAttempts"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0"
                                  Breakpoint="Breakpoint.Xl"
                                  Class="webhook-management__table webhook-management__desktop-table">
                            <HeaderContent>
                                <MudTh>Endpoint</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>HTTP</MudTh>
                                <MudTh>Scheduled</MudTh>
                                <MudTh Class="webhook-management__actions-cell">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Endpoint">
                                    <MudText Typo="Typo.body2">@ShortId(context.EndpointId)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MessageEventType</MudText>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.OutcomeName)" Variant="Variant.Outlined">@context.OutcomeName</MudChip>
                                    @if (!string.IsNullOrWhiteSpace(context.FailureCategory))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.FailureCategory</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="HTTP">@HttpSummary(context)</MudTd>
                                <MudTd DataLabel="Scheduled">@FormatDate(context.ScheduledAt)</MudTd>
                                <MudTd DataLabel="Actions" Class="webhook-management__actions-cell">
                                    <div class="webhook-management__action-group">
                                        @if (context.Id is Guid attemptId && HasAttemptLink(context, WebhookClientLinkRelations.Retry))
                                        {
                                            <MudTooltip Text="Retry delivery">
                                                <AppIconButton Icon="@Icons.Material.Filled.Replay"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               OnClick="@(() => RetryAttemptAsync(attemptId))"
                                                               Disabled="_isBusy"
                                                               data-testid="@($"webhook-retry-attempt-{attemptId:D}")"
                                                               aria-label="Retry delivery" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No delivery attempts.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                        <div class="webhook-management__mobile-list">
                            @if (_visibleAttempts.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No delivery attempts.</MudText>
                            }
                            else
                            {
                                @foreach (var attempt in _visibleAttempts)
                                {
                                    <section class="webhook-management__mobile-card"
                                             aria-label="@($"Delivery attempt {attempt.AttemptNumber} for {ShortId(attempt.EndpointId)}")">
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Endpoint</span>
                                            <span class="webhook-management__mobile-value">
                                                <MudText Typo="Typo.body2">@ShortId(attempt.EndpointId)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@attempt.MessageEventType</MudText>
                                            </span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Status</span>
                                            <span class="webhook-management__mobile-value">
                                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(attempt.OutcomeName)" Variant="Variant.Outlined">@attempt.OutcomeName</MudChip>
                                                @if (!string.IsNullOrWhiteSpace(attempt.FailureCategory))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@attempt.FailureCategory</MudText>
                                                }
                                            </span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">HTTP</span>
                                            <span class="webhook-management__mobile-value">@HttpSummary(attempt)</span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Scheduled</span>
                                            <span class="webhook-management__mobile-value">@FormatDate(attempt.ScheduledAt)</span>
                                        </div>
                                        <div class="webhook-management__mobile-row">
                                            <span class="webhook-management__mobile-label">Actions</span>
                                            <span class="webhook-management__mobile-value">
                                                @if (attempt.Id is Guid attemptId && HasAttemptLink(attempt, WebhookClientLinkRelations.Retry))
                                                {
                                                    <MudTooltip Text="Retry delivery">
                                                        <AppIconButton Icon="@Icons.Material.Filled.Replay"
                                                                       Color="Color.Primary"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => RetryAttemptAsync(attemptId))"
                                                                       Disabled="_isBusy"
                                                                       data-testid="@($"webhook-retry-attempt-{attemptId:D}")"
                                                                       aria-label="Retry delivery" />
                                                    </MudTooltip>
                                                }
                                            </span>
                                        </div>
                                    </section>
                                }
                            }
                        </div>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            @if (_snapshot.CanViewProviderPublications)
            {
                <MudTabPanel Text="Provider" Icon="@Icons.Material.Filled.CloudSync">
                    <WebhookProviderPublicationsPanel />
                </MudTabPanel>
            }

            @if (_snapshot.CanUseBulkReplay)
            {
                <MudTabPanel Text="Replay" Icon="@Icons.Material.Filled.ReplayCircleFilled">
                    <WebhookBulkReplayPanel Consumers="_snapshot.Consumers"
                                            Endpoints="_snapshot.Endpoints"
                                            EventTypes="_snapshot.EventTypes" />
                </MudTabPanel>
            }
        </MudTabs>
    }

    <MudDialog @bind-Visible="_consumerDialogOpen" Options="DialogOptionsFactory.Medium()">
        <TitleContent>
            <MudText Typo="Typo.h6">Create Webhook Consumer</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <AppTextField T="string" @bind-Value="_consumerForm.Name" Label="Name" Required="true" Immediate="true" />
                <MudTextField T="string"
                              Value="@Owner.DisplayName"
                              Label="Owner scope"
                              Variant="Variant.Outlined"
                              Dense="true"
                              ReadOnly="true" />
                <MudSelect T="int" @bind-Value="_consumerForm.ProviderModeId" Label="Provider" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="int" Value="1">Disabled</MudSelectItem>
                    <MudSelectItem T="int" Value="2">Local</MudSelectItem>
                    <MudSelectItem T="int" Value="3">Svix</MudSelectItem>
                    <MudSelectItem T="int" Value="4">Composite</MudSelectItem>
                    <MudSelectItem T="int" Value="5">DryRun</MudSelectItem>
                </MudSelect>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="@(() => _consumerDialogOpen = false)" Disabled="_isBusy">Cancel</AppButton>
            <AppButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateConsumerAsync" Disabled="_isBusy || !_snapshot.CanCreateConsumer || string.IsNullOrWhiteSpace(_consumerForm.Name)">
                @(_isBusy ? "Saving..." : "Create")
            </AppButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_endpointDialogOpen" Options="DialogOptionsFactory.Medium()">
        <TitleContent>
            <MudText Typo="Typo.h6">@(_endpointDialogMode == EndpointDialogMode.Create ? "Create Webhook Endpoint" : "Update Webhook Endpoint")</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                @if (_endpointDialogMode == EndpointDialogMode.Create)
                {
                    <MudSelect T="Guid" @bind-Value="_endpointForm.ConsumerId" Label="Consumer" Variant="Variant.Outlined" Dense="true" Required="true">
                        @foreach (var consumer in _snapshot.Consumers.Where(consumer => consumer.Id.HasValue))
                        {
                            <MudSelectItem T="Guid" Value="@consumer.Id!.Value">@consumer.Name (@consumer.ProviderModeName)</MudSelectItem>
                        }
                    </MudSelect>
                }
                <AppTextField T="string" @bind-Value="_endpointForm.Url" Label="Endpoint URL" Required="true" Immediate="true" />
                <AppTextField T="string" @bind-Value="_endpointForm.Description" Label="Description" />
                @if (_endpointDialogMode == EndpointDialogMode.Create)
                {
                    <AppTextField T="string" @bind-Value="_endpointForm.SecretRef" Label="Signing secret reference" Required="true" Immediate="true" />
                }
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?" @bind-Value="_endpointForm.MaxAttempts" Label="Max attempts" Variant="Variant.Outlined" Min="1" Max="20" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?" @bind-Value="_endpointForm.TimeoutSeconds" Label="Timeout seconds" Variant="Variant.Outlined" Min="1" Max="60" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?" @bind-Value="_endpointForm.RateLimitPerMinute" Label="Rate per minute" Variant="Variant.Outlined" Min="1" />
                    </MudItem>
                </MudGrid>
                <div class="webhook-management__event-picker">
                    <MudText Typo="Typo.subtitle2">Event subscriptions</MudText>
                    <div class="webhook-management__event-picker-grid">
                        @foreach (var eventType in SelectableEventTypes)
                        {
                            <MudCheckBox T="bool"
                                         Value="@IsEventTypeSelected(eventType)"
                                         ValueChanged="@((bool value) => ToggleEventType(eventType, value))"
                                         Color="Color.Primary"
                                         Dense="true">
                                @eventType.Name
                            </MudCheckBox>
                        }
                    </div>
                </div>
                @if (_endpointDialogMode == EndpointDialogMode.Update)
                {
                    <MudDivider />
                    <MudText Typo="Typo.subtitle2">Pending delivery work</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Choose whether already queued, never-attempted deliveries keep their frozen configuration or adopt this update.
                    </MudText>
                    <MudRadioGroup T="int" @bind-Value="_endpointForm.PendingWorkDecisionId" Class="webhook-management__pending-work-options">
                        <MudRadio T="int"
                                  Value="WebhookPendingWorkDecisionIds.PreserveExisting"
                                  Color="Color.Primary"
                                  Dense="true"
                                  data-testid="webhook-update-preserve-pending">
                            Preserve existing snapshots
                        </MudRadio>
                        <MudRadio T="int"
                                  Value="WebhookPendingWorkDecisionIds.MigrateEligible"
                                  Color="Color.Warning"
                                  Dense="true"
                                  data-testid="webhook-update-migrate-pending">
                            Migrate eligible pending deliveries
                        </MudRadio>
                    </MudRadioGroup>
                    <AppTextField T="string"
                                  @bind-Value="_endpointForm.PendingWorkReason"
                                  Label="Decision reason"
                                  Required="true"
                                  Immediate="true"
                                  data-testid="webhook-update-pending-reason" />
                    <MudCheckBox T="bool"
                                 @bind-Value="_endpointForm.AcknowledgeUncertainProviderPublications"
                                 Color="Color.Warning"
                                 Dense="true"
                                 data-testid="webhook-update-acknowledge-uncertain">
                        Acknowledge that provider publications with an uncertain outcome may still use the previous configuration.
                    </MudCheckBox>
                }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="@(() => _endpointDialogOpen = false)" Disabled="_isBusy">Cancel</AppButton>
            <AppButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEndpointAsync" Disabled="@EndpointSaveDisabled">
                @(_isBusy ? "Saving..." : "Save")
            </AppButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_rotateDialogOpen" Options="DialogOptionsFactory.Small()">
        <TitleContent>
            <MudText Typo="Typo.h6">Rotate Signing Secret</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2">@_rotateEndpoint?.DestinationHost</MudText>
                <AppTextField T="string" @bind-Value="_rotateForm.NewSecretRef" Label="New secret reference" Required="true" Immediate="true" />
                <MudNumericField T="int?" @bind-Value="_rotateForm.PreviousSecretValidForSeconds" Label="Previous secret valid seconds" Variant="Variant.Outlined" Min="0" />
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Pending delivery work</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Choose whether already queued, never-attempted deliveries keep their frozen credential reference or adopt this rotation.
                </MudText>
                <MudRadioGroup T="int" @bind-Value="_rotateForm.PendingWorkDecisionId" Class="webhook-management__pending-work-options">
                    <MudRadio T="int"
                              Value="WebhookPendingWorkDecisionIds.PreserveExisting"
                              Color="Color.Primary"
                              Dense="true"
                              data-testid="webhook-rotate-preserve-pending">
                        Preserve existing snapshots
                    </MudRadio>
                    <MudRadio T="int"
                              Value="WebhookPendingWorkDecisionIds.MigrateEligible"
                              Color="Color.Warning"
                              Dense="true"
                              data-testid="webhook-rotate-migrate-pending">
                        Migrate eligible pending deliveries
                    </MudRadio>
                </MudRadioGroup>
                <AppTextField T="string"
                              @bind-Value="_rotateForm.PendingWorkReason"
                              Label="Decision reason"
                              Required="true"
                              Immediate="true"
                              data-testid="webhook-rotate-pending-reason" />
                <MudCheckBox T="bool"
                             @bind-Value="_rotateForm.AcknowledgeUncertainProviderPublications"
                             Color="Color.Warning"
                             Dense="true"
                             data-testid="webhook-rotate-acknowledge-uncertain">
                    Acknowledge that provider publications with an uncertain outcome may still use the previous credential.
                </MudCheckBox>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="@(() => _rotateDialogOpen = false)" Disabled="_isBusy">Cancel</AppButton>
            <AppButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RotateSecretAsync" Disabled="@RotateSaveDisabled">
                @(_isBusy ? "Rotating..." : "Rotate")
            </AppButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_archiveDialogOpen" Options="DialogOptionsFactory.Small()">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Archive" Color="Color.Error" />
                <MudText Typo="Typo.h6">Archive Webhook Endpoint</MudText>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudText Typo="Typo.body2">@_archiveEndpoint?.DestinationHost</MudText>
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="@(() => _archiveDialogOpen = false)" Disabled="_isBusy">Cancel</AppButton>
            <AppButton Color="Color.Error" Variant="Variant.Filled" OnClick="ArchiveEndpointAsync" Disabled="_isBusy || !HasCurrentEndpointLink(_archiveEndpoint, WebhookClientLinkRelations.Delete)">
                @(_isBusy ? "Archiving..." : "Archive")
            </AppButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_endpointControlDialogOpen" Options="DialogOptionsFactory.Small()">
        <TitleContent>
            <MudText Typo="Typo.h6">@EndpointControlTitle</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2">@_endpointControlTarget?.DestinationHost</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@EndpointControlExplanation</MudText>
                <AppTextField T="string"
                              @bind-Value="_endpointControlReasonCode"
                              Label="Reason code"
                              HelperText="Letters, digits, underscore, dash, dot, and colon only."
                              Required="true"
                              Immediate="true"
                              data-testid="webhook-endpoint-control-reason" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="CloseEndpointControlDialog" Disabled="_isBusy">Cancel</AppButton>
            <AppButton Color="@EndpointControlColor"
                       Variant="Variant.Filled"
                       OnClick="ApplyEndpointControlAsync"
                       Disabled="@EndpointControlDisabled">
                @(_isBusy ? "Applying..." : EndpointControlActionLabel)
            </AppButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="_payloadDialogOpen" Options="DialogOptionsFactory.Medium()">
        <TitleContent>
            <MudText Typo="Typo.h6">Webhook Payload</MudText>
        </TitleContent>
        <DialogContent>
            @if (_payload is not null)
            {
                <MudStack Spacing="2">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Sensitive payload access is audited. This response is not cached by the API.
                    </MudAlert>
                    <div class="webhook-management__payload-metadata">
                        <MudText Typo="Typo.caption">@_payload.ContentType / @_payload.ContentEncoding</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(_payload.PayloadByteLength ?? 0) bytes / retained until @FormatDate(_payload.PayloadRetentionUntil)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_payload.PayloadHash</MudText>
                    </div>
                    <MudTabs Elevation="0" Rounded="false" Color="Color.Transparent" SliderColor="Color.Primary">
                        <MudTabPanel Text="Decoded">
                            <pre class="webhook-management__payload" data-testid="webhook-payload-decoded">@_payloadDisplayText</pre>
                        </MudTabPanel>
                        <MudTabPanel Text="Exact base64">
                            <pre class="webhook-management__payload" data-testid="webhook-payload-base64">@_payload.PayloadBase64</pre>
                        </MudTabPanel>
                    </MudTabs>
                </MudStack>
            }
        </DialogContent>
        <DialogActions>
            <AppButton Variant="Variant.Text" OnClick="ClosePayloadDialog">Close</AppButton>
        </DialogActions>
    </MudDialog>
</div>

@code {
    [Parameter, EditorRequired]
    public WebhookOwnerSelection Owner { get; set; } = null!;

    private WebhookManagementSnapshot _snapshot = new();
    private WebhookOwnerSelection? _loadedOwner;
    private IReadOnlyList<HalResourceOfWebhookDeliveryAttemptDto> _visibleAttempts = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;
    private string _attemptScopeLabel = "Delivery attempts";
    private Guid? _attemptScopeMessageId;

    private bool _consumerDialogOpen;
    private ConsumerForm _consumerForm = new();

    private bool _endpointDialogOpen;
    private EndpointDialogMode _endpointDialogMode = EndpointDialogMode.Create;
    private EndpointForm _endpointForm = new();
    private Guid? _editingEndpointId;
    private readonly HashSet<Guid> _selectedEventTypeIds = [];

    private bool _rotateDialogOpen;
    private HalResourceOfWebhookEndpointDto? _rotateEndpoint;
    private RotateForm _rotateForm = new();

    private bool _archiveDialogOpen;
    private HalResourceOfWebhookEndpointDto? _archiveEndpoint;

    private bool _endpointControlDialogOpen;
    private HalResourceOfWebhookEndpointDto? _endpointControlTarget;
    private EndpointControlMode _endpointControlMode;
    private string _endpointControlReasonCode = string.Empty;

    private bool _payloadDialogOpen;
    private WebhookMessagePayloadDto? _payload;
    private string _payloadDisplayText = string.Empty;

    private string EndpointControlTitle =>
        _endpointControlMode == EndpointControlMode.Pause ? "Pause Webhook Endpoint" : "Resume Webhook Endpoint";

    private string EndpointControlActionLabel =>
        _endpointControlMode == EndpointControlMode.Pause ? "Pause" : "Resume";

    private string EndpointControlExplanation =>
        _endpointControlMode == EndpointControlMode.Pause
            ? "Pausing stops new Local delivery claims. Existing immutable delivery evidence remains intact."
            : "Resuming resets the Local delivery circuit and allows eligible work to be claimed again.";

    private Color EndpointControlColor =>
        _endpointControlMode == EndpointControlMode.Pause ? Color.Warning : Color.Success;

    private bool EndpointControlDisabled =>
        _isBusy ||
        _endpointControlTarget?.Id is null ||
        _endpointControlTarget.DeliveryStateVersion is null or < 0 ||
        !HasCurrentEndpointLink(
            _endpointControlTarget,
            _endpointControlMode == EndpointControlMode.Pause
                ? WebhookClientLinkRelations.Pause
                : WebhookClientLinkRelations.Resume) ||
        string.IsNullOrWhiteSpace(_endpointControlReasonCode);

    private IReadOnlyList<WebhookEventTypeDto> SelectableEventTypes =>
        _snapshot.EventTypes
            .Where(eventType => eventType.Id.HasValue && eventType.IsEnabled == true)
            .ToList();

    private int FailingEndpointCount =>
        _snapshot.Endpoints.Count(endpoint => string.Equals(endpoint.StatusName, "Failing", StringComparison.OrdinalIgnoreCase));

    private int RetryableAttemptCount =>
        _snapshot.DeliveryAttempts.Count(attempt => HasAttemptLink(attempt, WebhookClientLinkRelations.Retry));

    private string ProviderModeSummary
    {
        get
        {
            var modes = _snapshot.Consumers
                .GroupBy(consumer => string.IsNullOrWhiteSpace(consumer.ProviderModeName) ? "Unknown" : consumer.ProviderModeName)
                .OrderBy(group => group.Key, StringComparer.Ordinal)
                .Select(group => $"{group.Key} {group.Count()}")
                .ToList();

            return modes.Count == 0 ? "None" : string.Join(" / ", modes);
        }
    }

    private bool EndpointSaveDisabled =>
        _isBusy ||
        (_endpointDialogMode == EndpointDialogMode.Create
            ? !_snapshot.CanCreateEndpoint
            : !HasCurrentEndpointLink(_editingEndpointId, WebhookClientLinkRelations.Update)) ||
        _endpointForm.ConsumerId == Guid.Empty ||
        string.IsNullOrWhiteSpace(_endpointForm.Url) ||
        (_endpointDialogMode == EndpointDialogMode.Create && string.IsNullOrWhiteSpace(_endpointForm.SecretRef)) ||
        (_endpointDialogMode == EndpointDialogMode.Update &&
         (_endpointForm.ExpectedConfigurationVersion <= 0 ||
          _endpointForm.PendingWorkDecisionId <= 0 ||
          string.IsNullOrWhiteSpace(_endpointForm.PendingWorkReason))) ||
        _selectedEventTypeIds.Count == 0;

    private bool RotateSaveDisabled =>
        _isBusy ||
        _rotateEndpoint?.Id is null ||
        !HasCurrentEndpointLink(_rotateEndpoint, WebhookClientLinkRelations.RotateSecret) ||
        _rotateForm.ExpectedConfigurationVersion <= 0 ||
        _rotateForm.PendingWorkDecisionId <= 0 ||
        string.IsNullOrWhiteSpace(_rotateForm.NewSecretRef) ||
        string.IsNullOrWhiteSpace(_rotateForm.PendingWorkReason);

    protected override async Task OnParametersSetAsync()
    {
        ArgumentNullException.ThrowIfNull(Owner);
        if (Owner == _loadedOwner)
        {
            return;
        }

        _loadedOwner = Owner;
        await LoadSnapshotAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadSnapshotAsync();
    }

    private async Task LoadSnapshotAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        _snapshot = await WebhookService.GetSnapshotAsync(Owner);
        _visibleAttempts = _snapshot.DeliveryAttempts;
        _attemptScopeLabel = "Delivery attempts";
        _attemptScopeMessageId = null;

        if (!_snapshot.IsSuccess)
        {
            _errorMessage = _snapshot.ErrorMessage;
        }

        _isLoading = false;
    }

    private void OpenCreateConsumerDialog()
    {
        if (!_snapshot.CanCreateConsumer)
        {
            return;
        }

        _consumerForm = new ConsumerForm();
        _consumerDialogOpen = true;
    }

    private async Task CreateConsumerAsync()
    {
        if (!_snapshot.CanCreateConsumer)
        {
            return;
        }

        await RunActionAsync(
            () => WebhookService.CreateConsumerAsync(
                new CreateWebhookConsumerRequestDto
                {
                    OwnerId = Owner.OwnerId,
                    ConsumerKindId = Owner.OwnerKindId,
                    Name = _consumerForm.Name.Trim(),
                    ProviderModeId = _consumerForm.ProviderModeId
                }),
            closeDialog: () => _consumerDialogOpen = false);
    }

    private void OpenCreateEndpointDialog()
    {
        if (!_snapshot.CanCreateEndpoint)
        {
            return;
        }

        var defaultConsumer = _snapshot.Consumers.FirstOrDefault(consumer =>
            string.Equals(consumer.ProviderModeName, "Local", StringComparison.Ordinal)) ??
            _snapshot.Consumers.FirstOrDefault(consumer => consumer.Id.HasValue);

        _endpointDialogMode = EndpointDialogMode.Create;
        _editingEndpointId = null;
        _endpointForm = new EndpointForm
        {
            ConsumerId = defaultConsumer?.Id ?? Guid.Empty,
            MaxAttempts = 8,
            TimeoutSeconds = 15
        };
        _selectedEventTypeIds.Clear();
        foreach (var eventTypeId in SelectableEventTypes.Select(eventType => eventType.Id!.Value))
        {
            _selectedEventTypeIds.Add(eventTypeId);
        }

        _endpointDialogOpen = true;
    }

    private void OpenUpdateEndpointDialog(HalResourceOfWebhookEndpointDto endpoint)
    {
        if (!HasEndpointLink(endpoint, WebhookClientLinkRelations.Update))
        {
            return;
        }

        _endpointDialogMode = EndpointDialogMode.Update;
        _editingEndpointId = endpoint.Id;
        _endpointForm = new EndpointForm
        {
            ConsumerId = endpoint.ConsumerId ?? Guid.Empty,
            Url = string.Empty,
            Description = endpoint.Description ?? string.Empty,
            MaxAttempts = endpoint.MaxAttempts,
            TimeoutSeconds = endpoint.TimeoutSeconds,
            RateLimitPerMinute = endpoint.RateLimitPerMinute,
            ExpectedConfigurationVersion = endpoint.ConfigurationVersion ?? 0
        };
        _selectedEventTypeIds.Clear();
        foreach (var eventTypeId in endpoint.Subscriptions?
                     .Where(subscription => subscription.IsEnabled == true && subscription.EventTypeId.HasValue)
                     .Select(subscription => subscription.EventTypeId!.Value) ?? [])
        {
            _selectedEventTypeIds.Add(eventTypeId);
        }

        _endpointDialogOpen = true;
    }

    private async Task SaveEndpointAsync()
    {
        if (_endpointDialogMode == EndpointDialogMode.Create)
        {
            if (!_snapshot.CanCreateEndpoint)
            {
                return;
            }

            await RunActionAsync(
                () => WebhookService.CreateEndpointAsync(
                    new CreateWebhookEndpointRequestDto
                    {
                        ConsumerId = _endpointForm.ConsumerId,
                        Url = _endpointForm.Url.Trim(),
                        Description = NullIfWhiteSpace(_endpointForm.Description),
                        SecretRef = _endpointForm.SecretRef.Trim(),
                        EventTypeIds = _selectedEventTypeIds.ToList(),
                        MaxAttempts = _endpointForm.MaxAttempts,
                        TimeoutSeconds = _endpointForm.TimeoutSeconds,
                        RateLimitPerMinute = _endpointForm.RateLimitPerMinute
                    }),
                closeDialog: () => _endpointDialogOpen = false);
            return;
        }

        if (_editingEndpointId is not Guid endpointId ||
            !HasCurrentEndpointLink(endpointId, WebhookClientLinkRelations.Update))
        {
            return;
        }

        await RunActionAsync(
            () => WebhookService.UpdateEndpointAsync(
                endpointId,
                new UpdateWebhookEndpointRequestDto
                {
                    Destination = new UpdateWebhookEndpointDestinationDto
                    {
                        Url = _endpointForm.Url.Trim(),
                        Description = NullIfWhiteSpace(_endpointForm.Description)
                    },
                    Subscriptions = new UpdateWebhookEndpointSubscriptionsDto
                    {
                        EventTypeIds = _selectedEventTypeIds.ToList()
                    },
                    DeliveryPolicy = new UpdateWebhookEndpointDeliveryPolicyDto
                    {
                        MaxAttempts = _endpointForm.MaxAttempts,
                        TimeoutSeconds = _endpointForm.TimeoutSeconds,
                        RateLimitPerMinute = _endpointForm.RateLimitPerMinute
                    },
                    Governance = new UpdateWebhookEndpointGovernanceDto
                    {
                        ExpectedConfigurationVersion = _endpointForm.ExpectedConfigurationVersion,
                        PendingWorkDecisionId = _endpointForm.PendingWorkDecisionId,
                        PendingWorkReason = _endpointForm.PendingWorkReason.Trim(),
                        AcknowledgeUncertainProviderPublications = _endpointForm.AcknowledgeUncertainProviderPublications
                    }
                }),
            closeDialog: () => _endpointDialogOpen = false);
    }

    private void OpenRotateDialog(HalResourceOfWebhookEndpointDto endpoint)
    {
        if (!HasEndpointLink(endpoint, WebhookClientLinkRelations.RotateSecret))
        {
            return;
        }

        _rotateEndpoint = endpoint;
        _rotateForm = new RotateForm
        {
            PreviousSecretValidForSeconds = 86400,
            ExpectedConfigurationVersion = endpoint.ConfigurationVersion ?? 0
        };
        _rotateDialogOpen = true;
    }

    private async Task RotateSecretAsync()
    {
        if (_rotateEndpoint?.Id is not Guid endpointId ||
            !HasCurrentEndpointLink(_rotateEndpoint, WebhookClientLinkRelations.RotateSecret))
        {
            return;
        }

        await RunActionAsync(
            () => WebhookService.RotateEndpointSecretAsync(
                endpointId,
                new RotateWebhookEndpointSecretRequestDto
                {
                    NewSecretRef = _rotateForm.NewSecretRef.Trim(),
                    PreviousSecretValidForSeconds = _rotateForm.PreviousSecretValidForSeconds,
                    ExpectedConfigurationVersion = _rotateForm.ExpectedConfigurationVersion,
                    PendingWorkDecisionId = _rotateForm.PendingWorkDecisionId,
                    PendingWorkReason = _rotateForm.PendingWorkReason.Trim(),
                    AcknowledgeUncertainProviderPublications = _rotateForm.AcknowledgeUncertainProviderPublications
                }),
            closeDialog: () => _rotateDialogOpen = false);
    }

    private void OpenArchiveDialog(HalResourceOfWebhookEndpointDto endpoint)
    {
        if (!HasEndpointLink(endpoint, WebhookClientLinkRelations.Delete))
        {
            return;
        }

        _archiveEndpoint = endpoint;
        _archiveDialogOpen = true;
    }

    private async Task ArchiveEndpointAsync()
    {
        if (_archiveEndpoint?.Id is not Guid endpointId ||
            !HasCurrentEndpointLink(_archiveEndpoint, WebhookClientLinkRelations.Delete))
        {
            return;
        }

        await RunActionAsync(
            () => WebhookService.DeleteEndpointAsync(endpointId),
            closeDialog: () => _archiveDialogOpen = false);
    }

    private async Task TestEndpointAsync(HalResourceOfWebhookEndpointDto endpoint)
    {
        if (endpoint.Id is Guid endpointId &&
            HasEndpointLink(endpoint, WebhookClientLinkRelations.Test))
        {
            await RunActionAsync(() => WebhookService.TestEndpointAsync(endpointId));
        }
    }

    private void OpenEndpointControlDialog(
        HalResourceOfWebhookEndpointDto endpoint,
        EndpointControlMode mode)
    {
        var relation = mode == EndpointControlMode.Pause
            ? WebhookClientLinkRelations.Pause
            : WebhookClientLinkRelations.Resume;
        if (!HasEndpointLink(endpoint, relation))
        {
            return;
        }

        _endpointControlTarget = endpoint;
        _endpointControlMode = mode;
        _endpointControlReasonCode = string.Empty;
        _endpointControlDialogOpen = true;
    }

    private void CloseEndpointControlDialog() => _endpointControlDialogOpen = false;

    private async Task ApplyEndpointControlAsync()
    {
        if (_endpointControlTarget?.Id is not Guid endpointId ||
            _endpointControlTarget.DeliveryStateVersion is not long deliveryStateVersion ||
            !HasCurrentEndpointLink(
                _endpointControlTarget,
                _endpointControlMode == EndpointControlMode.Pause
                    ? WebhookClientLinkRelations.Pause
                    : WebhookClientLinkRelations.Resume))
        {
            return;
        }

        var reasonCode = _endpointControlReasonCode.Trim();
        await RunActionAsync(
            _endpointControlMode == EndpointControlMode.Pause
                ? () => WebhookOperations.PauseEndpointAsync(
                    endpointId,
                    new PauseWebhookEndpointRequestDto
                    {
                        ExpectedDeliveryStateVersion = deliveryStateVersion,
                        ReasonCode = reasonCode
                    })
                : () => WebhookOperations.ResumeEndpointAsync(
                    endpointId,
                    new ResumeWebhookEndpointRequestDto
                    {
                        ExpectedDeliveryStateVersion = deliveryStateVersion,
                        ReasonCode = reasonCode
                    }),
            CloseEndpointControlDialog);
    }

    private async Task ViewPayloadAsync(Guid messageId)
    {
        if (!HasCurrentMessageLink(messageId, WebhookClientLinkRelations.Payload))
        {
            return;
        }

        _isBusy = true;
        var result = await WebhookOperations.GetMessagePayloadAsync(messageId);
        _isBusy = false;
        if (!result.Success || result.Payload is null)
        {
            Snackbar.Add(result.Message, Severity.Error);
            return;
        }

        _payload = result.Payload;
        _payloadDisplayText = DecodePayload(result.Payload);
        _payloadDialogOpen = true;
    }

    private void ClosePayloadDialog()
    {
        _payloadDialogOpen = false;
        _payload = null;
        _payloadDisplayText = string.Empty;
    }

    private async Task RetryAttemptAsync(Guid attemptId)
    {
        if (!HasCurrentAttemptLink(attemptId, WebhookClientLinkRelations.Retry))
        {
            return;
        }

        await RunActionAsync(() => WebhookService.RetryDeliveryAttemptAsync(attemptId));
    }

    private async Task OpenProviderPortalAsync(HalResourceOfWebhookConsumerDto consumer)
    {
        if (consumer.Id is not Guid consumerId || !HasProviderPortalLink(consumer))
        {
            return;
        }

        _isBusy = true;
        var result = await WebhookService.OpenProviderPortalAsync(consumerId);
        _isBusy = false;

        if (!result.Success || string.IsNullOrWhiteSpace(result.Url))
        {
            Snackbar.Add(result.Message, Severity.Error);
            return;
        }

        Navigation.NavigateTo(result.Url, forceLoad: true);
    }

    private async Task LoadAttemptsForMessageAsync(Guid messageId, string eventType)
    {
        if (!HasCurrentMessageLink(messageId, WebhookClientLinkRelations.DeliveryAttempts))
        {
            return;
        }

        _isBusy = true;
        _visibleAttempts = await WebhookService.GetDeliveryAttemptsAsync(Owner, messageId: messageId);
        _attemptScopeMessageId = messageId;
        _attemptScopeLabel = $"Attempts for {eventType}";
        _isBusy = false;
    }

    private async Task ClearAttemptFilterAsync()
    {
        _isBusy = true;
        _visibleAttempts = await WebhookService.GetDeliveryAttemptsAsync(Owner);
        _attemptScopeMessageId = null;
        _attemptScopeLabel = "Delivery attempts";
        _isBusy = false;
    }

    private async Task RunActionAsync(
        Func<Task<WebhookActionResult>> action,
        Action? closeDialog = null)
    {
        _isBusy = true;
        var result = await action();
        _isBusy = false;

        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        if (!result.Success)
        {
            return;
        }

        closeDialog?.Invoke();
        await LoadSnapshotAsync();
    }

    private bool IsEventTypeSelected(WebhookEventTypeDto eventType) =>
        eventType.Id.HasValue && _selectedEventTypeIds.Contains(eventType.Id.Value);

    private void ToggleEventType(WebhookEventTypeDto eventType, bool selected)
    {
        if (eventType.Id is not Guid eventTypeId)
        {
            return;
        }

        if (selected)
        {
            _selectedEventTypeIds.Add(eventTypeId);
            return;
        }

        _selectedEventTypeIds.Remove(eventTypeId);
    }

    private static bool HasProviderPortalLink(HalResourceOfWebhookConsumerDto consumer) =>
        WebhookHal.HasLink(consumer._links, WebhookClientLinkRelations.OpenProviderPortal);

    private static string ProviderCapabilitySummary(HalResourceOfWebhookConsumerDto consumer)
    {
        if (consumer.ProviderCapabilityAuthorityAvailable != true)
        {
            return "Capability authority unavailable";
        }

        var capabilities = consumer.ProviderCapabilities ?? [];
        return capabilities.Count == 0
            ? "Capability metadata unavailable"
            : $"{capabilities.Count(capability => capability.IsAvailable == true)} of {capabilities.Count} capabilities available";
    }

    private static string ProviderCapabilityExplanation(HalResourceOfWebhookConsumerDto consumer)
    {
        if (consumer.ProviderCapabilityAuthorityAvailable != true)
        {
            return CapabilityReasonExplanation(consumer.CapabilityUnavailableReasonCode);
        }

        var capabilities = consumer.ProviderCapabilities ?? [];
        var available = capabilities
            .Where(capability => capability.IsAvailable == true)
            .Select(capability =>
            {
                var sources = capability.AvailableFromProviderCodes?.Count > 0
                    ? $" ({string.Join(" / ", capability.AvailableFromProviderCodes)})"
                    : string.Empty;
                return $"{capability.CapabilityName}{sources}";
            })
            .ToArray();

        return available.Length == 0
            ? "No capabilities are available for this provider mode."
            : $"Available: {string.Join(", ", available)}.";
    }

    private static string CapabilityReasonExplanation(string? reasonCode) =>
        reasonCode switch
        {
            "webhook_provider_binding_unverified" => "Provider binding verification is required.",
            "svix_self_hosted_profile_unsupported" => "The configured self-hosted Svix profile is unsupported.",
            "webhook_provider_disabled" => "The webhook provider is disabled by instance configuration.",
            "webhook_provider_tenant_override_disabled" => "The instance provider mode does not permit this consumer mode.",
            "webhook_provider_mode_invalid" => "The provider mode is invalid.",
            "webhook_provider_capability_not_applicable" => "The capability does not apply to this provider mode.",
            "webhook_provider_capability_unproven" => "The capability is not proven for the configured provider profile.",
            _ => "Capability authority is unavailable."
        };

    private static bool HasEndpointLink(HalResourceOfWebhookEndpointDto endpoint, string relation) =>
        WebhookHal.HasLink(endpoint._links, relation);

    private static bool HasAttemptLink(HalResourceOfWebhookDeliveryAttemptDto attempt, string relation) =>
        WebhookHal.HasLink(attempt._links, relation);

    private static bool HasMessageLink(HalResourceOfWebhookMessageDto message, string relation) =>
        WebhookHal.HasLink(message._links, relation);

    private bool HasCurrentEndpointLink(Guid? endpointId, string relation) =>
        endpointId is Guid id &&
        HasCurrentEndpointLink(
            _snapshot.Endpoints.SingleOrDefault(endpoint => endpoint.Id == id),
            relation);

    private static bool HasCurrentEndpointLink(
        HalResourceOfWebhookEndpointDto? endpoint,
        string relation) =>
        endpoint is not null && HasEndpointLink(endpoint, relation);

    private bool HasCurrentMessageLink(Guid messageId, string relation) =>
        _snapshot.Messages.Any(message =>
            message.Id == messageId && HasMessageLink(message, relation));

    private bool HasCurrentAttemptLink(Guid attemptId, string relation) =>
        _visibleAttempts.Any(attempt =>
            attempt.Id == attemptId && HasAttemptLink(attempt, relation));

    private static string EndpointDeliveryControlAvailability(HalResourceOfWebhookEndpointDto endpoint)
    {
        if (HasEndpointLink(endpoint, WebhookClientLinkRelations.Pause))
        {
            return "Local delivery can be paused.";
        }

        if (HasEndpointLink(endpoint, WebhookClientLinkRelations.Resume))
        {
            return "Local delivery can be resumed.";
        }

        if (!string.Equals(endpoint.ProviderModeCode, "LOCAL", StringComparison.Ordinal) &&
            !string.Equals(endpoint.ProviderModeCode, "COMPOSITE", StringComparison.Ordinal))
        {
            return "Delivery control is managed by the configured provider mode.";
        }

        return string.Equals(endpoint.StatusCode, "ARCHIVED", StringComparison.Ordinal)
            ? "Archived endpoints have no delivery controls."
            : "Delivery control is unavailable for the current state and capability.";
    }

    private static string DecodePayload(WebhookMessagePayloadDto payload)
    {
        try
        {
            var bytes = Convert.FromBase64String(payload.PayloadBase64);
            var text = new System.Text.UTF8Encoding(false, true).GetString(bytes);
            if (!payload.ContentType.Contains("json", StringComparison.OrdinalIgnoreCase))
            {
                return text;
            }

            using var document = System.Text.Json.JsonDocument.Parse(bytes);
            return System.Text.Json.JsonSerializer.Serialize(
                document.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (FormatException)
        {
            return "The payload could not be decoded. Use the exact base64 view.";
        }
        catch (System.Text.DecoderFallbackException)
        {
            return "The payload is not UTF-8 text. Use the exact base64 view.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "The payload is not valid JSON. Use the exact base64 view.";
        }
    }

    private static string SubscriptionSummary(HalResourceOfWebhookEndpointDto endpoint)
    {
        var subscriptions = endpoint.Subscriptions?
            .Where(subscription => subscription.IsEnabled == true)
            .Select(subscription => subscription.EventTypeName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? [];

        return subscriptions.Count switch
        {
            0 => "None",
            <= 2 => string.Join(", ", subscriptions),
            _ => $"{subscriptions.Count} events"
        };
    }

    private static string HttpSummary(HalResourceOfWebhookDeliveryAttemptDto attempt)
    {
        var status = attempt.HttpStatusCode?.ToString() ?? "-";
        return attempt.DurationMs.HasValue
            ? $"{status} / {attempt.DurationMs} ms"
            : status;
    }

    private static string MessageState(HalResourceOfWebhookMessageDto message) =>
        message.PayloadClearedAt.HasValue ? "Payload cleared" : "Payload retained";

    private static string ShortId(Guid? value) =>
        value.HasValue ? value.Value.ToString("N")[..12] : "-";

    private static string FormatDate(DateTimeOffset? value) =>
        value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "-";

    private static string ShortText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Length <= maxLength
            ? value
            : string.Concat(value.AsSpan(0, Math.Max(1, maxLength - 1)), "...");
    }

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static Color StatusColor(string? status) =>
        status?.ToLowerInvariant() switch
        {
            "active" or "delivered" or "succeeded" => Color.Success,
            "pending" or "queued" or "scheduled" or "sending" => Color.Info,
            "failing" or "partially_failed" or "partiallyfailed" => Color.Warning,
            "failed" or "abandoned" or "disabled" => Color.Error,
            _ => Color.Default
        };

    private static Color ProviderColor(string? mode) =>
        mode?.ToLowerInvariant() switch
        {
            "local" => Color.Success,
            "svix" => Color.Primary,
            "composite" => Color.Info,
            "dryrun" => Color.Warning,
            "disabled" => Color.Default,
            _ => Color.Default
        };

