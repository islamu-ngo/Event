    private async Task OnFilesSelectedAsync(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is null || files.Count == 0)
        {
            return;
        }

        var remainingSlots = MaxSelectedImages - _selectedImages.Count;
        if (remainingSlots <= 0)
        {
            Snackbar.Add($"You can attach at most {MaxSelectedImages} images.", Severity.Warning);
            return;
        }

        var addedCount = 0;
        foreach (var file in files.Take(remainingSlots))
        {
            if (!ImageUploadClientPolicy.IsAllowedImageContentType(file.ContentType))
            {
                Snackbar.Add($"{file.Name} is not a supported image file.", Severity.Warning);
                continue;
            }

            try
            {
                await using var stream = file.OpenReadStream(MaxImageBytes);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                var bytes = memoryStream.ToArray();
                if (bytes.Length == 0)
                {
                    Snackbar.Add($"{file.Name} is empty and was not attached.", Severity.Warning);
                    continue;
                }

                if (!ImageUploadClientPolicy.TryValidateImageFile(
                        file.Name,
                        file.ContentType,
                        bytes,
                        out var mediaType))
                {
                    Snackbar.Add($"{file.Name} is not a supported image file.", Severity.Warning);
                    continue;
                }

                _selectedImages.Add(new AiConversationComposer.ImageAttachment(
                    Guid.CreateVersion7(),
                    file.Name,
                    mediaType,
                    bytes.LongLength,
                    Convert.ToBase64String(bytes)));
                addedCount++;
            }
            catch (IOException)
            {
                Snackbar.Add($"{file.Name} could not be attached. Images must be {FormatFileSize(MaxImageBytes)} or smaller.", Severity.Error);
            }
            catch (InvalidOperationException)
            {
                Snackbar.Add($"{file.Name} could not be attached. Images must be {FormatFileSize(MaxImageBytes)} or smaller.", Severity.Error);
            }
        }

        if (files.Count > remainingSlots)
        {
            Snackbar.Add($"Only {remainingSlots} image(s) were attached because the limit is {MaxSelectedImages}.", Severity.Info);
        }

        if (addedCount > 0)
        {
            Snackbar.Add($"{addedCount} image(s) attached.", Severity.Success);
        }
    }

    private void RemoveSelectedImage(Guid imageId)
    {
        var removed = _selectedImages.RemoveAll(image => image.Id == imageId);
        if (removed > 0)
        {
            Snackbar.Add("Image removed.", Severity.Info);
