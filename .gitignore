config.make
config.status
aclocal.m4
install-sh
autom4te.cache/
*.tar.gz
tarballs/


# =============================================================================
# 6. Environment, Secrets & Local Overrides
# =============================================================================

# Dotenv environment variables & local configuration
.env
.env.local
.env.*.local
config.ini

# AI tool configs & MCP configurations (contain sensitive API keys / tokens)
.mcp.json
.codex/config.toml
.gemini/settings.json
.copilot/mcp-config.json
opencode.jsonc
jean.json
.cursorrules

# Local agent configuration overrides
AGENTS.local.md

# Certificates, keys & publishing credentials
*.pfx
*.publishsettings
*.jfm


# =============================================================================
# 7. Agentic Workbench & AI Tooling Runtime State
# =============================================================================

# Isolated git worktrees for agent sessions
.worktrees/

# OmO rules-injector hook runtime state (preserves committed rules in .omo/rules/)
.omo/*
!.omo/rules/
!.omo/rules/**

# Sisyphus agent runtime state
.sisyphus/

# Automaker
.automaker

# Code review graph index
.code-review-graph/

# Claude CLI build cache and context state
.claude/hooks/.claude/build-cache/
.claude/build-cache/
.claude/context-state.json

# Playwright MCP & CLI runtime state
.playwright-mcp/
.playwright-cli/

# QA cookies & debug journals
.qa-cookie/
.debug-journal.md

# Repomix markdown dumps
.repomix/*.md

# CI tooling & artifacts
.tools/


# =============================================================================
# 8. Repository & Workflow Ephemeral Data
# =============================================================================

# Active local implementation plans & scratch memory (README is tracked)
dev/active/*
!dev/active/README.md

# Development scratchpads, reports, and backlog notes
dev/archive/*
dev/zarchive
dev/backlog/
dev/next/
dev/pause/
dev/report/
dev/report/visuals/
inbox

# Project events, local storage & ephemeral data stores
event/
storage-data/
schemas/archive/
privacy-erasure-authority-data/aspire-local/
privacy-erasure-authority-data/aspire-agent/
evidence/mdb-real-postgres-qa/


