<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Explore.Diagnostic.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Execution/TestExecutionProfile.cs" Link="Execution/TestExecutionProfile.cs" />
    <Compile Include="../Shared/Execution/BoundedTestDiscoveryHook.cs" Link="Execution/BoundedTestDiscoveryHook.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Event.Testing.TestSuiteKindAttribute">
      <_Parameter1>UnitPure</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Diagnostic\Explore.Diagnostic.csproj" />
    <ProjectReference Include="..\..\src\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
    <ProjectReference Include="..\..\src\Explore.ServiceDefaults\Explore.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

</Project>
