    private Task MoveSectionAsync(int index, int delta) => MutateAsync(async (eventId, token) =>
    {
        RegistrationFormSectionDto moved = OrderedSections().ElementAt(index);
        List<Guid> orderedIds = OrderedSections().Select(item => item.Id).ToList();
        (orderedIds[index], orderedIds[index + delta]) = (orderedIds[index + delta], orderedIds[index]);
        _version = await Authoring.ReorderSectionsAsync(eventId, _form!.Id, _version!.Id,
            _version.ConcurrencyStamp, orderedIds, VersionLink("reorder-sections")!, token);
        await InvokeAsync(StateHasChanged);
        await FocusService.FocusByIdAsync(SectionMoveId(moved.Id, delta), true);
    }, delta < 0 ? T("status.section_moved_up", "Section moved up.") : T("status.section_moved_down", "Section moved down."));

    private Task MoveFieldAsync(RegistrationFormSectionDto section, int index, int delta) => MutateAsync(async (eventId, token) =>
    {
        RegistrationFormFieldDto moved = section.Fields.OrderBy(item => item.Ordinal).ElementAt(index);
        List<Guid> orderedIds = section.Fields.OrderBy(item => item.Ordinal).Select(item => item.Id).ToList();
        (orderedIds[index], orderedIds[index + delta]) = (orderedIds[index + delta], orderedIds[index]);
        _version = await Authoring.ReorderFieldsAsync(eventId, _form!.Id, _version!.Id, section.Id,
            _version.ConcurrencyStamp, orderedIds, SectionLink(section, "reorder-fields")!, token);
        await InvokeAsync(StateHasChanged);
        await FocusService.FocusByIdAsync(FieldMoveId(moved.Id, delta), true);
    }, delta < 0 ? T("status.field_moved_up", "Field moved up.") : T("status.field_moved_down", "Field moved down."));

    private void StartSectionDrag(Guid sectionId)
    {
        if (!_mutating && VersionLink("reorder-sections") is not null)
        {
            _draggedSectionId = sectionId;
            _draggedField = null;
        }
    }

    private Task DropSectionAsync(Guid targetId)
    {
        Guid? sourceId = _draggedSectionId;
        ClearDragState();
        if (sourceId is null || sourceId == targetId || _mutating || VersionLink("reorder-sections") is null)
        {
            return Task.CompletedTask;
        }

        List<RegistrationFormSectionDto> sections = OrderedSections().ToList();
        int sourceIndex = sections.FindIndex(item => item.Id == sourceId);
        int targetIndex = sections.FindIndex(item => item.Id == targetId);
        if (sourceIndex < 0 || targetIndex < 0)
        {
            return Task.CompletedTask;
        }

        RegistrationFormSectionDto moved = sections[sourceIndex];
        sections.RemoveAt(sourceIndex);
        sections.Insert(targetIndex, moved);
        return MutateAsync(async (eventId, token) =>
        {
            _version = await Authoring.ReorderSectionsAsync(eventId, _form!.Id, _version!.Id,
                _version.ConcurrencyStamp, sections.Select(item => item.Id).ToArray(), VersionLink("reorder-sections")!, token);
        }, F("status.section_moved_position", "Section moved to position {0}.", targetIndex + 1));
    }

    private void StartFieldDrag(Guid sectionId, Guid fieldId)
    {
        RegistrationFormSectionDto? section = _version?.Sections.FirstOrDefault(item => item.Id == sectionId);
        if (!_mutating && section is not null && SectionLink(section, "reorder-fields") is not null)
        {
            _draggedField = (sectionId, fieldId);
            _draggedSectionId = null;
        }
    }

    private Task DropFieldAsync(RegistrationFormSectionDto section, Guid targetId)
    {
        (Guid SectionId, Guid FieldId)? source = _draggedField;
        ClearDragState();
        if (source is null || source.Value.SectionId != section.Id || source.Value.FieldId == targetId || _mutating ||
            SectionLink(section, "reorder-fields") is null)
        {
            return Task.CompletedTask;
        }

        List<RegistrationFormFieldDto> fields = section.Fields.OrderBy(item => item.Ordinal).ToList();
        int sourceIndex = fields.FindIndex(item => item.Id == source.Value.FieldId);
        int targetIndex = fields.FindIndex(item => item.Id == targetId);
        if (sourceIndex < 0 || targetIndex < 0)
        {
            return Task.CompletedTask;
        }

        RegistrationFormFieldDto moved = fields[sourceIndex];
        fields.RemoveAt(sourceIndex);
        fields.Insert(targetIndex, moved);
        return MutateAsync(async (eventId, token) =>
        {
            _version = await Authoring.ReorderFieldsAsync(eventId, _form!.Id, _version!.Id, section.Id,
                _version.ConcurrencyStamp, fields.Select(item => item.Id).ToArray(), SectionLink(section, "reorder-fields")!, token);
        }, F("status.field_moved_position", "Field moved to position {0}.", targetIndex + 1));
    }

    private void ClearDragState()
    {
        _draggedSectionId = null;
        _draggedField = null;
    }

