@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models

<div class="tri-state-tag-filter" style="position: relative;">
    @* Trigger styled to match MudSelect Outlined Dense *@
    <div class="tri-state-filter-trigger @(_isOpen ? "tri-state-filter-trigger--open" : "") @(HasActiveFilters() ? "tri-state-filter-trigger--active" : "")"
         @onclick="TogglePopover"
         role="button"
         tabindex="0">
        <div class="tri-state-filter-trigger__content">
            <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Class="mr-2" Style="font-size: 1.1rem; opacity: 0.7;" />
            <span class="tri-state-filter-trigger__text">@GetBadgeText()</span>
        </div>
        <MudIcon Icon="@(_isOpen ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
                 Size="Size.Small"
                 Class="tri-state-filter-trigger__arrow" />
    </div>

    @* Overlay for click-outside-to-close *@
    <MudOverlay Visible="_isOpen" OnClick="ClosePopover" LockScroll="false" />

    @if (_isOpen)
    {
        <div class="tri-state-tag-filter__popover" role="dialog" aria-label="Tag filters">
        <MudPaper Class="pa-4" Style="min-width: 520px; max-width: min(650px, 92vw); max-height: 70vh; overflow-y: auto; overflow-x: hidden;" Elevation="8">

            @* Search + Reset controls *@
            <div class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="_searchTerm"
                              Placeholder="Search tags..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="flex-grow-1" />
                <MudButton Elevation="0" Variant="Variant.Text"
                           Color="MudBlazor.Color.Warning"
                           Size="Size.Small"
                           OnClick="ClearVisible"
                           Disabled="@(!HasActiveFilters())">
                    Clear Visible
                </MudButton>
                <MudButton Elevation="0" Variant="Variant.Text"
                           Color="MudBlazor.Color.Error"
                           Size="Size.Small"
                           OnClick="ResetAll"
                           Disabled="@(!HasActiveFilters())">
                    Reset All
                </MudButton>
            </div>

            <MudText Typo="Typo.caption" Class="mb-3" Style="opacity: 0.6;">
                Click: include → exclude → clear
            </MudText>

            @* Tag groups with MangaDex-style section headers *@
            @foreach (var group in GetFilteredGroups())
            {
                <div class="d-flex align-center gap-2 mb-1 mt-2">
                    <MudText Typo="Typo.subtitle2" Style="white-space: nowrap; font-weight: 600;">@group.FullName</MudText>
                    <MudDivider Class="flex-grow-1" />
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var tag in group.Tags)
                    {
                        if (tag.Id.HasValue)
                        {
                            var tagId = tag.Id.Value;
                            var state = GetTagState(tagId);
                            <MudChip T="string"
                                     data-tag-id="@tagId"
                                     Color="@GetChipColor(state)"
                                     Variant="@GetChipVariant(state)"
                                     Icon="@GetChipIcon(state)"
                                     Size="Size.Small"
                                     OnClick="@(() => ToggleTagState(tagId))">
                                @tag.FullName
                            </MudChip>
                        }
                    }
                </div>
            }

            @if (!GetFilteredGroups().Any())
            {
                <MudText Typo="Typo.body2" Class="pa-4" Align="Align.Center" Style="opacity: 0.5;">
                    No tags match your search.
                </MudText>
            }

            @* Other Options: Inclusion/Exclusion mode (MangaDex-style select dropdowns) *@
            <div class="d-flex align-center gap-2 mb-1 mt-3">
                <MudText Typo="Typo.subtitle2" Style="white-space: nowrap; font-weight: 600;">Other Options</MudText>
                <MudDivider Class="flex-grow-1" />
            </div>
            <div class="d-flex flex-wrap gap-4 mb-2">
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.caption" Style="white-space: nowrap;">Inclusion mode</MudText>
                    <MudSelect T="string" @bind-Value="_inclusionMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 80px;" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                        <MudSelectItem Value="@("and")">And</MudSelectItem>
                        <MudSelectItem Value="@("or")">Or</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.caption" Style="white-space: nowrap;">Exclusion mode</MudText>
                    <MudSelect T="string" @bind-Value="_exclusionMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 80px;" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                        <MudSelectItem Value="@("or")">Or</MudSelectItem>
                        <MudSelectItem Value="@("and")">And</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            </MudPaper>
        </div>
    }
</div>
