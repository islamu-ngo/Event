@using Explore.Blazor.Client.Contracts.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Components.Forms
@using MudBlazor

@inject IEventSessionService EventSessionService
@inject IDialogService DialogService
@inject ILogger<ProgramSectionsDialog> Logger

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Program sections</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="program-sections-dialog">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Create tracks, devrooms, stages, or neutral program sections. Assign saved sessions to one section at a time.
            </MudText>

            @if (_locations.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    No event-associated locations are available. Location and room selection stays unavailable until a venue is linked through an authorized event management flow.
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_errorMessage</MudAlert>
            }

            @if (_sections.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    No sections or tracks yet. Add one to organize saved program items.
                </MudAlert>
            }
            else
            {
                <ul class="program-sections-dialog__list" aria-label="Existing program sections">
                    @foreach (var programSection in _sections.OrderBy(programSection => programSection.SortOrder).ThenBy(programSection => programSection.Name))
                    {
                        <li class="program-sections-dialog__item">
                            <div class="program-sections-dialog__item-main">
                                <span class="program-sections-dialog__name">@programSection.Name</span>
                                <span class="program-sections-dialog__meta">@FormatSectionMeta(programSection)</span>
                            </div>
                            <div class="program-sections-dialog__item-actions">
                                <MudButton Elevation="0" Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Disabled="@(!programSection.HasHalLink("edit") || _submitState.IsSubmitting)"
                                           OnClick="@(() => EditSectionAsync(programSection))">
                                    Edit
                                </MudButton>
                                 @if (programSection.HasHalLink("delete"))
                                 {
                                     <MudButton Elevation="0" Variant="Variant.Text"
                                               Color="Color.Error"
                                               Disabled="@_submitState.IsSubmitting"
                                               OnClick="@(() => DeleteSectionAsync(programSection))">
                                         Delete
                                     </MudButton>
                                 }
                                 <MudButton Elevation="0" Variant="Variant.Text"
                                            Color="Color.Secondary"
                                            Disabled="@(!programSection.HasHalLink(AssignSessionLinkRel) || _submitState.IsSubmitting)"
                                            OnClick="@(() => SelectAssignmentSectionAsync(programSection))">
                                     Assign sessions
                                 </MudButton>
                             </div>
                         </li>
                     }
                 </ul>
             }

            @if (_assignmentSection is not null)
            {
                <section class="program-sections-dialog__assignments" aria-labelledby="program-section-assignments-title">
                    <div class="program-sections-dialog__assignment-header">
                        <div>
                            <h3 id="program-section-assignments-title" class="program-sections-dialog__form-title">
                                Assign sessions to @_assignmentSection.Name
                            </h3>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Assignment changes save immediately and refresh from the server.
                            </MudText>
                        </div>
                        <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Default" OnClick="ClearAssignmentSection" Disabled="@_isAssignmentSaving">
                            Close assignments
                        </MudButton>
                    </div>

                    @if (!CanManageAssignments(_assignmentSection))
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            You do not currently have permission to manage session assignments for this program section.
                        </MudAlert>
                    }
                    else if (_sessions.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            No saved sessions are available yet. Add a program item before assigning it to a section.
                        </MudAlert>
                    }
                    else
                    {
                        <ul class="program-sections-dialog__assignment-list" aria-label="Saved sessions for assignment">
                            @foreach (var session in _sessions.OrderBy(session => session.StartTime).ThenBy(session => session.Title))
                            {
                                var isAssigned = IsAssignedToSelectedSection(session);
                                <li class="program-sections-dialog__assignment-item">
                                    <div class="program-sections-dialog__item-main">
                                        <span class="program-sections-dialog__name">@FormatSessionTitle(session)</span>
                                        <span class="program-sections-dialog__meta">@FormatSessionAssignmentMeta(session)</span>
                                    </div>
                                    @if (isAssigned)
                                    {
                                        <MudButton Elevation="0" Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   Disabled="@_isAssignmentSaving"
                                                   OnClick="@(() => UnassignSessionAsync(session))">
                                            Remove
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Elevation="0" Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   Disabled="@_isAssignmentSaving"
                                                   OnClick="@(() => AssignSessionAsync(session))">
                                            Assign
                                        </MudButton>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <MudDivider />

            <section class="program-sections-dialog__form" aria-labelledby="program-section-form-title">
                <h3 id="program-section-form-title" class="program-sections-dialog__form-title">
                    @(_editingSectionId is null ? "Add section or track" : "Edit section or track")
                </h3>

                <MudTextField T="string"
                              Label="Section or track name"
                              Value="@_name"
                              ValueChanged="@(value => _name = value ?? string.Empty)"
                              Required="true"
                              Variant="Variant.Outlined"
                              Placeholder="Main stage, Workshops, Devroom A" />

                <MudTextField T="string"
                              Label="Description"
                              Value="@_description"
                              ValueChanged="@(value => _description = value)"
                              Lines="3"
                              Variant="Variant.Outlined" />

                <div class="program-sections-dialog__compact-grid">
                    <MudSelect T="Guid?"
                               Label="Default location"
                               Value="@_locationId"
                               ValueChanged="OnLocationChangedAsync"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">No location yet</MudSelectItem>
                        @foreach (var location in _locations.Where(location => location.Id.HasValue).OrderBy(FormatLocation))
                        {
                            <MudSelectItem T="Guid?" Value="@location.Id">@FormatLocation(location)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="Guid?"
                               Label="Default room"
                               Value="@_roomId"
                               ValueChanged="@(value => _roomId = value)"
                               Variant="Variant.Outlined"
                               Disabled="@(!_locationId.HasValue || !_rooms.Any())"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">No room yet</MudSelectItem>
                        @foreach (var room in _rooms.OrderBy(room => room.SortOrder).ThenBy(room => room.Name))
                        {
                            <MudSelectItem T="Guid?" Value="@room.Id">@FormatRoom(room)</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="program-sections-dialog__compact-grid">
                    <MudTextField T="string"
                                  Label="Color"
                                  Value="@_color"
                                  ValueChanged="@(value => _color = value)"
                                  Variant="Variant.Outlined"
                                  Placeholder="#4263eb" />

                    <MudNumericField T="int?"
                                     Label="Sort order"
                                     Value="@_sortOrder"
                                     ValueChanged="@(value => _sortOrder = value)"
                                     Min="0"
                                     Variant="Variant.Outlined" />
                </div>

                <MudCheckBox T="bool"
                             Label="Visible in program"
                             Value="@_isPublished"
                             ValueChanged="@(value => _isPublished = value)"
                             Color="Color.Primary" />
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        @if (_editingSectionId is not null)
        {
            <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Default" OnClick="ResetForm" Disabled="@_submitState.IsSubmitting">Cancel edit</MudButton>
        }
        <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Default" OnClick="Close" Disabled="@_submitState.IsSubmitting">Close</MudButton>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@_submitState.IsSubmitting">
            @if (_submitState.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(_editingSectionId is null ? "Add section" : "Save section")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid EventId { get; set; }

    [Parameter]
    public ICollection<HalResourceOfEventSessionGroupListDto>? InitialSections { get; set; }

    private List<HalResourceOfEventSessionGroupListDto> _sections = [];
    private Guid? _editingSectionId;
    private Guid? _editingConcurrencyStamp;
    private string _name = string.Empty;
    private string? _description;
    private string? _color;
    private Guid? _locationId;
    private Guid? _roomId;
    private int? _sortOrder;
    private bool _isPublished = true;
    private ICollection<EventSessionCreateLocationOptionDto> _locations = new List<EventSessionCreateLocationOptionDto>();
    private ICollection<EventSessionCreateRoomOptionDto> _allRooms = new List<EventSessionCreateRoomOptionDto>();
    private ICollection<EventSessionCreateRoomOptionDto> _rooms = new List<EventSessionCreateRoomOptionDto>();
    private List<EventSessionListDto> _sessions = [];
    private HalResourceOfEventSessionGroupListDto? _assignmentSection;
    private bool _isAssignmentSaving;
    private FormSubmitState _submitState = new();
    private string? _errorMessage;
    private bool _hasChanges;
    private const string AssignSessionLinkRel = "assign-session";

    protected override async Task OnInitializedAsync()
    {
        _sections = InitialSections?.OrderBy(section => section.SortOrder).ThenBy(section => section.Name).ToList() ?? [];
        _sortOrder = _sections.Count == 0 ? 0 : _sections.Max(section => section.SortOrder ?? 0) + 10;
        var createContext = await EventSessionService.GetEventSessionCreateContextAsync(EventId);
        _locations = createContext?.Locations ?? new List<EventSessionCreateLocationOptionDto>();
        _allRooms = createContext?.Rooms ?? new List<EventSessionCreateRoomOptionDto>();
    }

    private async Task EditSectionAsync(HalResourceOfEventSessionGroupListDto section)
    {
        if (!section.HasHalLink("edit"))
        {
            _errorMessage = "You do not currently have permission to edit this program section.";
            return;
        }

        _editingSectionId = section.Id;
        _editingConcurrencyStamp = section.ConcurrencyStamp;
        _name = section.Name;
        _description = section.Description;
        _color = section.Color;
        _locationId = section.LocationId;
        _roomId = section.RoomId;
        _sortOrder = section.SortOrder;
        _isPublished = section.IsPublished ?? true;
        _errorMessage = null;
        await LoadRoomsForLocationAsync(_locationId);
    }

    private async Task OnLocationChangedAsync(Guid? locationId)
    {
        _locationId = locationId;
        _roomId = null;
        await LoadRoomsForLocationAsync(locationId);
    }

    private Task LoadRoomsForLocationAsync(Guid? locationId)
    {
        if (!locationId.HasValue || locationId.Value == Guid.Empty)
        {
            _rooms = new List<EventSessionCreateRoomOptionDto>();
            _roomId = null;
            return Task.CompletedTask;
        }

        _rooms = _allRooms.Where(room => room.LocationId == locationId).ToList();
        if (_roomId.HasValue && _rooms.All(room => room.Id != _roomId.Value))
        {
            _roomId = null;
        }

        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (EventId == Guid.Empty)
        {
            _errorMessage = "Save the event before adding program sections.";
            return;
        }

        var trimmedName = _name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            _errorMessage = "Section or track name is required.";
            return;
        }

        _submitState.Start();

        try
        {
            BaseCommandResponseOfGuid response = _editingSectionId is null
                ? await EventSessionService.CreateSessionGroupAsync(new CreateEventSessionGroupRequestDto
                {
                    EventId = EventId,
                    Name = trimmedName,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    LocationId = _locationId,
                    RoomId = _roomId,
                    Color = string.IsNullOrWhiteSpace(_color) ? null : _color.Trim(),
                    SortOrder = _sortOrder ?? 0,
                    IsPublished = _isPublished
                })
                : _editingConcurrencyStamp is not Guid concurrencyStamp || concurrencyStamp == Guid.Empty
                    ? new BaseCommandResponseOfGuid
                    {
                        Success = false,
                        Message = "Program section must be reloaded before saving."
                    }
                    : await EventSessionService.UpdateSessionGroupAsync(
                        _editingSectionId.Value,
                        concurrencyStamp,
                        new UpdateEventSessionGroupRequestDto
                        {
                            Metadata = new UpdateEventSessionGroupMetadataDto
                            {
                                Name = trimmedName,
                                Description = new OptionalUpdateOfstring
                                {
                                    HasValue = true,
                                    Value = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim()
                                },
                                Color = new OptionalUpdateOfstring
                                {
                                    HasValue = true,
                                    Value = string.IsNullOrWhiteSpace(_color) ? null : _color.Trim()
                                }
                            },
                            Placement = new UpdateEventSessionGroupPlacementDto
                            {
                                LocationId = new OptionalUpdateOfGuid { HasValue = true, Value = _locationId },
                                RoomId = new OptionalUpdateOfGuid { HasValue = true, Value = _roomId }
                            },
                            Ordering = new UpdateEventSessionGroupOrderingDto { SortOrder = _sortOrder ?? 0 },
                            Publication = new UpdateEventSessionGroupPublicationDto { IsPublished = _isPublished }
                        });

            if (response.Success != true)
            {
                _errorMessage = response.Message ?? "Program section could not be saved.";
                return;
            }

            _sections = (await EventSessionService.GetManagedSessionGroupsByEventAsync(EventId))
                .OrderBy(section => section.SortOrder)
                .ThenBy(section => section.Name)
                .ToList();
            _hasChanges = true;
            ResetForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Program section save failed for event {EventId}", EventId);
            _errorMessage = $"Program section could not be saved: {ex.Message}";
        }
        finally
        {
            _submitState.Complete();
        }
    }

    private async Task DeleteSectionAsync(HalResourceOfEventSessionGroupListDto section)
    {
        _errorMessage = null;

        if (!section.HasHalLink("delete"))
        {
            _errorMessage = "You do not currently have permission to delete this program section.";
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete program section?",
            $"Delete {section.Name}? Sessions stay saved, but this section and its assignments will be removed.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _submitState.Start();

        try
        {
            bool deleted = await EventSessionService.DeleteSessionGroupAsync(EventId, section.Id ?? Guid.Empty);
            if (!deleted)
            {
                _errorMessage = "Program section could not be deleted.";
                return;
            }

            _sections = (await EventSessionService.GetManagedSessionGroupsByEventAsync(EventId))
                .OrderBy(programSection => programSection.SortOrder)
                .ThenBy(programSection => programSection.Name)
                .ToList();
            _hasChanges = true;

            if (_editingSectionId == section.Id)
            {
                ResetForm();
            }
            else
            {
                _sortOrder = _sections.Count == 0 ? 0 : _sections.Max(programSection => programSection.SortOrder ?? 0) + 10;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Program section delete failed for event {EventId}", EventId);
            _errorMessage = $"Program section could not be deleted: {ex.Message}";
        }
        finally
        {
            _submitState.Complete();
        }
    }

    private async Task SelectAssignmentSectionAsync(HalResourceOfEventSessionGroupListDto section)
    {
        _errorMessage = null;
        _assignmentSection = section;

        if (!CanManageAssignments(section))
        {
            _errorMessage = "You do not currently have permission to manage session assignments for this program section.";
            return;
        }

        await LoadSessionsAsync();
    }

    private void ClearAssignmentSection()
    {
        _assignmentSection = null;
        _errorMessage = null;
    }

    private async Task AssignSessionAsync(EventSessionListDto session)
    {
        if (!TryGetAssignmentContext(session, out var sectionId, out var sessionId))
        {
            return;
        }

        _isAssignmentSaving = true;
        _errorMessage = null;

        try
        {
            int sortOrder = GetNextAssignmentSortOrder(sectionId);
            BaseCommandResponseOfGuid response = await EventSessionService.AssignSessionToGroupAsync(
                EventId,
                sectionId,
                sessionId,
                isPrimary: true,
                sortOrder: sortOrder);

            if (response.Success != true)
            {
                _errorMessage = response.Message ?? "Session could not be assigned to the selected program section.";
                return;
            }

            await LoadSessionsAsync();
            _hasChanges = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Session assignment failed for event {EventId}", EventId);
            _errorMessage = $"Session could not be assigned: {ex.Message}";
        }
        finally
        {
            _isAssignmentSaving = false;
        }
    }

    private async Task UnassignSessionAsync(EventSessionListDto session)
    {
        if (!TryGetAssignmentContext(session, out var sectionId, out var sessionId))
        {
            return;
        }

        _isAssignmentSaving = true;
        _errorMessage = null;

        try
        {
            BaseCommandResponseOfGuid response = await EventSessionService.UnassignSessionFromGroupAsync(EventId, sectionId, sessionId);
            if (response.Success != true)
            {
                _errorMessage = response.Message ?? "Session could not be removed from the selected program section.";
                return;
            }

            await LoadSessionsAsync();
            _hasChanges = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Session unassignment failed for event {EventId}", EventId);
            _errorMessage = $"Session could not be removed: {ex.Message}";
        }
        finally
        {
            _isAssignmentSaving = false;
        }
    }

    private async Task LoadSessionsAsync()
    {
        _sessions = (await EventSessionService.GetSessionsByEventAsync(EventId, includeManagedSessions: true))
            .OrderBy(session => session.StartTime ?? DateTimeOffset.MaxValue)
            .ThenBy(session => session.Title)
            .ToList();
    }

    private bool TryGetAssignmentContext(EventSessionListDto session, out Guid sectionId, out Guid sessionId)
    {
        sectionId = _assignmentSection?.Id ?? Guid.Empty;
        sessionId = session.Id ?? Guid.Empty;

        if (_assignmentSection is null || sectionId == Guid.Empty || sessionId == Guid.Empty)
        {
            _errorMessage = "Select a program section and saved session before changing assignments.";
            return false;
        }

        if (!CanManageAssignments(_assignmentSection))
        {
            _errorMessage = "You do not currently have permission to manage session assignments for this program section.";
            return false;
        }

        return true;
    }

    private bool CanManageAssignments(HalResourceOfEventSessionGroupListDto section)
    {
        return section.HasHalLink(AssignSessionLinkRel);
    }

    private bool IsAssignedToSelectedSection(EventSessionListDto session)
    {
        var sectionId = _assignmentSection?.Id;
        return sectionId.HasValue && session.SessionGroups?.Any(group => group.EventSessionGroupId == sectionId.Value) == true;
    }

    private int GetNextAssignmentSortOrder(Guid sectionId)
    {
        var maxSortOrder = _sessions
            .SelectMany(session => session.SessionGroups ?? Enumerable.Empty<SessionGroups2>())
            .Where(group => group.EventSessionGroupId == sectionId)
            .Select(group => group.SortOrder ?? 0)
            .DefaultIfEmpty(0)
            .Max();

        return maxSortOrder + 10;
    }

    private void ResetForm()
    {
        _editingSectionId = null;
        _editingConcurrencyStamp = null;
        _name = string.Empty;
        _description = null;
        _color = null;
        _locationId = null;
        _roomId = null;
        _rooms = new List<EventSessionCreateRoomOptionDto>();
        _sortOrder = _sections.Count == 0 ? 0 : _sections.Max(section => section.SortOrder ?? 0) + 10;
        _isPublished = true;
        _errorMessage = null;
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(_hasChanges));

    private static string FormatSectionMeta(HalResourceOfEventSessionGroupListDto section)
    {
        var details = new List<string>();

        if (!string.IsNullOrWhiteSpace(section.RoomName))
            details.Add(section.RoomName);
        else if (!string.IsNullOrWhiteSpace(section.LocationName))
            details.Add(section.LocationName);

        details.Add(section.IsPublished == true ? "Visible" : "Hidden");
        details.Add($"Sort {section.SortOrder ?? 0}");

        return string.Join(" · ", details);
    }

    private static string FormatLocation(EventSessionCreateLocationOptionDto location)
    {
        var fullName = location.FullName ?? string.Empty;
        return string.IsNullOrWhiteSpace(location.City) ? fullName : $"{fullName} · {location.City}";
    }

    private static string FormatRoom(EventSessionCreateRoomOptionDto room)
    {
        return room.Capacity.HasValue ? $"{room.Name} ({room.Capacity} seats)" : room.Name ?? string.Empty;
    }

    private static string FormatSessionTitle(EventSessionListDto session)
    {
        return string.IsNullOrWhiteSpace(session.Title) ? "Untitled program item" : session.Title;
    }

    private string FormatSessionAssignmentMeta(EventSessionListDto session)
    {
        var details = new List<string>();

        if (session.StartTime.HasValue)
        {
            details.Add(session.StartTime.Value.ToLocalTime().ToString("ddd d MMM, HH:mm", System.Globalization.CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrWhiteSpace(session.RoomName))
            details.Add(session.RoomName);
        else if (!string.IsNullOrWhiteSpace(session.LocationFullName))
            details.Add(session.LocationFullName);

        if (IsAssignedToSelectedSection(session))
        {
            details.Add("Assigned here");
        }
        else if (session.SessionGroups?.Any() == true)
        {
            details.Add("Assigned elsewhere");
        }
        else
        {
            details.Add("Unassigned");
        }

        return string.Join(" · ", details);
    }
}
