<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CA1707;CA1716;CA1816;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- SSH.NET: direct ref activates CPM pin 2026.0.0, remediating GHSA-q939-rpr3-3284 transitive via Testcontainers -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\..\src\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence\Explore.Persistence.csproj" />
  </ItemGroup>
</Project>
