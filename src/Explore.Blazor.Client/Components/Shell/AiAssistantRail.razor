@using Explore.Blazor.Client.Contracts.Services.Ai
@using Explore.Blazor.Client.Components.Shell.AiAssistant
@using Explore.Blazor.Client.Services.Ai
@using Explore.Blazor.Client.Services.Shell
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JsRuntime

@if (AiAssistantState.IsAvailable)
{
    @if (!HostedInDock && AiAssistantState.IsOpen)
    {
        <div class="ai-rail__backdrop" @onclick="AiAssistantState.Close" aria-hidden="true"></div>
    }

    <aside id="ai-assistant-rail"
           class="@RootClass"
           data-testid="shell-ai-rail"
           aria-label="AI Assistant"
           role="complementary">

        @* ── Header bar ── *@
        <div class="ai-rail__header">
            <div class="ai-rail__header-brand">
                @if (HostedInWorkspace)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   OnClick="ReturnFromWorkspace"
                                   Title="Return to previous workspace"
                                   aria-label="Return to previous workspace"
                                   data-testid="ai-workspace-return" />
                }
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="ai-rail__header-icon" />
                <MudMenu @bind-Open="_modelMenuOpen"
                         AnchorOrigin="Origin.BottomLeft"
                         TransformOrigin="Origin.TopLeft"
                         Dense="true"
                         Class="ai-rail__model-menu">
                    <ActivatorContent>
                        <button type="button" class="ai-rail__model-picker-btn" @onclick="ToggleModelMenu">
                            <span class="ai-rail__header-title">AI Assistant (@SelectedModelLabel)</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="ai-rail__model-arrow" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var model in _modelOptions)
                        {
                            <MudMenuItem OnClick="() => SelectModel(model.Id)"
                                         Class="@GetModelItemClass(model.Id)">
                                @model.DisplayName
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </div>
            <div class="ai-rail__header-actions">
                @if (HostedInDock && AiAssistantState.CanOpenWorkspace)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   OnClick="OpenInWorkspace"
                                   Title="Open in AI workspace"
                                   aria-label="Open in AI workspace"
                                   data-testid="ai-rail-open-workspace" />
                }
                @if (ConversationState.CanCreateConversation)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   OnClick="CreateConversationAsync"
                                   Disabled="@_isCommandRunning"
                                   Title="New conversation"
                                   aria-label="New conversation"
                                   data-testid="ai-rail-new-conversation" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.History"
                               Color="@(_showConversations ? Color.Primary : Color.Inherit)"
                               Size="Size.Small"
                               OnClick="ToggleConversations"
                               Title="Conversation history"
                               aria-label="Conversation history" />
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Color="Color.Inherit"
                         Size="Size.Small"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Title="Close AI Assistant"
                         aria-label="Close AI Assistant"
                         data-testid="ai-rail-options-menu">
                    <MudMenuItem OnClick="DeleteCurrentChatAsync" Disabled="@(ConversationState.SelectedConversation is null)">
                        Delete chat
                    </MudMenuItem>
                </MudMenu>
            </div>
        </div>

        @* Drawer removed in favor of history sidebar overlay *@

        @* ── Chat body ── *@
        <div class="ai-rail__body">
            @if (ConversationState.IsLoading)
            {
                <div class="ai-rail__placeholder" role="status" aria-live="polite">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Loading assistant context...
                    </MudText>
                </div>
            }
            else if (ConversationState.SelectedConversation is not null)
            {
                <AiConversationTimeline Conversation="ConversationState.SelectedConversation"
                                        IsActionBusy="IsActionBusy"
                                        ActionsEnabled="@IsBuildCapabilitySelected"
                                        OnConfirm="ConfirmActionAsync"
                                        OnReject="RejectActionAsync" />
            }
        </div>

        @* ── Error ── *@
        @if (!string.IsNullOrWhiteSpace(ConversationState.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="ai-rail__alert" data-testid="ai-rail-error">
                @ConversationState.ErrorMessage
            </MudAlert>
        }

        @if (GetActiveRunId() is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="ai-rail__alert" data-testid="ai-rail-running">
                <div class="d-flex align-center gap-2">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    <span>AI is thinking. You can wait here or cancel this run.</span>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Disabled="@_isCancelRunRunning"
                               OnClick="CancelActiveRunAsync"
                               data-testid="ai-rail-cancel-run">
                        Cancel
                    </MudButton>
                </div>
            </MudAlert>
        }

        @* ── Composer (bottom-pinned) ── *@
        @if (ConversationState.SelectedConversation is not null)
        {
            <AiConversationComposer @ref="_conversationComposer"
                                    IdPrefix="ai-rail"
                                    ActorOptions="_actorOptions"
                                    SelectedActorId="_selectedActorId"
                                    SelectedActorIdChanged="OnActorSelectionChanged"
                                    SelectedImages="_selectedImages"
                                    ReferenceResults="ConversationState.ReferenceResults"
                                    PromptText="@_promptText"
                                    OnPromptInput="OnPromptInput"
                                    OnPromptChange="OnPromptChange"
                                    IsReferenceAutocompleteVisible="IsReferenceAutocompleteVisible"
                                    IsReferenceSearchRunning="_isReferenceSearchRunning"
                                    HasSearchedReferences="_hasSearchedReferences"
                                    ActiveReferenceIndex="_activeReferenceIndex"
                                    HasPromptReferenceHighlights="HasPromptReferenceHighlights"
                                    PromptReferenceHighlights="PromptReferenceHighlights"
                                    PromptTextAreaClass="@PromptTextAreaClass"
                                    ReferenceAutocompleteOpenData="@ReferenceAutocompleteOpenData"
                                    ReferenceAutocompleteSelectableData="@ReferenceAutocompleteSelectableData"
                                    ReferenceMentionTokensData="@ReferenceMentionTokensData"
                                    SelectedCapability="@_selectedCapability"
                                    SelectedCapabilityChanged="SelectCapability"
                                    IsSendDisabled="IsSendDisabled"
                                    MaximumFileCount="MaxSelectedImages"
                                    OnFilesSelected="OnFilesSelectedAsync"
                                    OnImageRemoved="RemoveSelectedImage"
                                    OnReferenceSelected="SelectReferenceAsync"
                                    OnReferenceSearchOpened="OpenReferenceSearchFromMenuAsync"
                                    OnSend="SendMessageAsync" />
        }

        @* ── History Overlay (Plane-style right sidebar overlay) ── *@
        <div class="@HistoryOverlayClass" aria-label="AI conversations history">
            <div class="ai-rail__history-header">
                <span class="ai-rail__history-title">Chat history</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               OnClick="ToggleConversations"
                               Title="Close history"
                               aria-label="Close history" />
            </div>

            <div class="ai-rail__history-search-row">
                <button type="button" class="ai-rail__history-new-chat" @onclick="CreateConversationAsync" disabled="@_isCommandRunning">
                    <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                    <span>New chat</span>
                </button>
                <div class="ai-rail__history-search-btn">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                </div>
            </div>

            <div class="ai-rail__history-section-title">Recents</div>

            <div class="ai-rail__history-body">
                @if (ConversationState.Conversations.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ai-rail__empty-hint">
                        @(ConversationState.CanCreateConversation
                            ? "Start a conversation to ask for event planning help."
                            : "Conversation creation is not available for your account.")
                    </MudText>
                }
                else
                {
                    <div class="ai-rail__history-list" role="list">
                        @foreach (var conversation in ConversationState.Conversations)
                        {
                            <button type="button"
                                    class="@GetConversationButtonClass(conversation.Id)"
                                    role="listitem"
                                    @onclick="() => SelectConversationAndCloseHistoryAsync(conversation.Id)"
                                    data-testid="ai-rail-conversation">
                                <span class="ai-rail__conversation-title">@GetConversationTitle(conversation)</span>
                                <span class="ai-rail__conversation-status">@conversation.Status</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </aside>
}

@code
{
    [Inject]
    protected AiAssistantState AiAssistantState { get; set; } = null!;

    [Inject]
    protected AiAssistantConversationState ConversationState { get; set; } = null!;

    [Inject]
    protected IAiAssistantClientService ClientService { get; set; } = null!;

    [Inject]
    protected ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    protected IBffAuthApi BffAuthApi { get; set; } = null!;

    [Inject]
    protected ILogger<AiAssistantRail> Logger { get; set; } = null!;

    [Inject]
    protected NavigationManager Navigation { get; set; } = null!;

    [Inject]
    protected UiShellState ShellState { get; set; } = null!;

    [Parameter]
    public bool HostedInDock { get; set; }

    [Parameter]
    public bool HostedInWorkspace { get; set; }

    [Parameter]
    public Guid? ConversationId { get; set; }

    [Parameter]
    public bool StartNewConversation { get; set; }

    private const int MaxSelectedImages = 4;
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private const int MinimumReferenceSearchLength = 2;
    private const string ActorReferenceKind = "Actor";
    private const string ActorContextSummaryPrefix = "Actor context:";
    private static readonly TimeSpan ReferenceSearchDebounceDelay = TimeSpan.FromMilliseconds(250);

    private readonly HashSet<Guid> _busyActionIds = [];
    private readonly List<AiConversationComposer.ImageAttachment> _selectedImages = [];
    private bool _hasLoaded;
    private bool _isLoadingConversations;
    private bool _wasOpen;
    private bool _hasSearchedReferences;
    private bool _isCommandRunning;
    private bool _isCancelRunRunning;
    private bool _isReferenceSearchRunning;
    private bool _showConversations;
    private bool _isReferenceAutocompleteOpen;
    private bool _isReferenceAutocompleteManuallyOpened;
    private string _promptText = string.Empty;
    private string _referenceSearchTerm = string.Empty;
    private int _activeReferenceIndex;
    private int? _referenceMentionStartIndex;
    private long _referenceSearchRequestId;

    private bool _modelMenuOpen;
    private IReadOnlyList<AiRailModelOption> _modelOptions = [];
    private IReadOnlyList<AiConversationComposer.ActorOption> _actorOptions = [];
    private string _selectedModelId = string.Empty;
    private Guid? _selectedActorId;
    private string _selectedCapability = "Build";
    private Guid? _activeRunId;
    private AiConversationComposer? _conversationComposer;
    private IJSObjectReference? _promptModule;
    private DotNetObjectReference<AiAssistantRail>? _promptInteropReference;
    private CancellationTokenSource? _referenceSearchDebounceCts;
    private bool _hasProcessedNewConversationRequest;
    private bool _isSynchronizingWorkspaceRequest;
    private bool _workspaceSynchronizationPending;

    private bool IsBuildCapabilitySelected =>
        string.Equals(_selectedCapability, "Build", StringComparison.OrdinalIgnoreCase);

    private string SelectedInteractionMode => IsBuildCapabilitySelected ? "build" : "ask";

    private string SelectedModelLabel => _modelOptions
        .FirstOrDefault(model => string.Equals(model.Id, _selectedModelId, StringComparison.OrdinalIgnoreCase))
        ?.DisplayName ?? (_selectedModelId.Length > 0 ? _selectedModelId : "Default");

    private string RootClass => string.Join(' ', new[]
    {
        "ai-rail",
        AiAssistantState.IsOpen ? "ai-rail--open" : null,
        HostedInDock ? "ai-rail--docked" : null,
        HostedInWorkspace ? "ai-rail--workspace" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string HistoryOverlayClass => string.Join(' ', new[]
    {
        "ai-rail__history-overlay",
        _showConversations ? "ai-rail__history-overlay--open" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private bool IsSendDisabled =>
        _isCommandRunning
        || ConversationState.SelectedConversation?.Id is not Guid
        || !AiAssistantConversationState.CanSendMessage(ConversationState.SelectedConversation)
        || (string.IsNullOrWhiteSpace(_promptText) && _selectedImages.Count == 0);

    private bool IsReferenceAutocompleteVisible => _isReferenceAutocompleteOpen;

    private bool HasPromptReferenceHighlights =>
        _promptText.Length > 0
        && GetReferenceMentionTokens().Any(token =>
            _promptText.Contains(token, StringComparison.OrdinalIgnoreCase));

    private string PromptTextAreaClass => HasPromptReferenceHighlights
        ? "ai-rail__textarea ai-rail__textarea--with-highlights"
        : "ai-rail__textarea";

    private RenderFragment PromptReferenceHighlights => BuildPromptReferenceHighlights;

    private string ReferenceAutocompleteOpenData => IsReferenceAutocompleteVisible ? "true" : "false";

    private string ReferenceAutocompleteSelectableData =>
        IsReferenceAutocompleteVisible && ConversationState.ReferenceResults.Count > 0 ? "true" : "false";

    private string ReferenceMentionTokensData => System.Text.Json.JsonSerializer.Serialize(GetReferenceMentionTokens());

    protected override void OnInitialized()
    {
        _wasOpen = AiAssistantState.IsOpen;
        AiAssistantState.OnChange += OnAiAssistantStateChanged;
        ConversationState.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!StartNewConversation)
        {
            _hasProcessedNewConversationRequest = false;
        }

        if (HostedInWorkspace)
        {
            await SynchronizeWorkspaceRequestAsync();
            return;
        }

        if (!_hasLoaded && AiAssistantState.IsAvailable && (AiAssistantState.IsOpen || HostedInDock))
        {
            await LoadConversationsAsync();
        }
    }

    private async Task SynchronizeWorkspaceRequestAsync()
    {
        if (_isSynchronizingWorkspaceRequest)
        {
            _workspaceSynchronizationPending = true;
            return;
        }

        _isSynchronizingWorkspaceRequest = true;
        try
        {
            do
            {
                _workspaceSynchronizationPending = false;
                await SynchronizeWorkspaceRequestCoreAsync();
            }
            while (_workspaceSynchronizationPending);
        }
        finally
        {
            _isSynchronizingWorkspaceRequest = false;
        }
    }

    private async Task SynchronizeWorkspaceRequestCoreAsync()
    {
        if (!AiAssistantState.IsAvailable)
        {
            return;
        }

        if (!_hasLoaded)
        {
            await LoadConversationsAsync(
                requestedConversationId: ConversationId,
                deferStartupConversation: StartNewConversation);
        }
        else if (ConversationId is Guid requestedConversationId
                 && ConversationState.SelectedConversation?.Id != requestedConversationId)
        {
            await SelectConversationAsync(requestedConversationId);
        }

        if (StartNewConversation && !_hasProcessedNewConversationRequest)
        {
            _hasProcessedNewConversationRequest = true;
            await CreateWorkspaceConversationAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ConversationState.SelectedConversation is not null)
        {
            await AttachPromptKeyboardHandlerAsync();
        }
    }

    private async Task AttachPromptKeyboardHandlerAsync()
    {
        if (_conversationComposer is null)
        {
            return;
        }

        try
        {
            _promptInteropReference ??= DotNetObjectReference.Create(this);
            _promptModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/ai-assistant-rail.js");
            await _conversationComposer.AttachPromptKeyboardHandlerAsync(_promptModule, _promptInteropReference);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "AI assistant prompt keyboard shortcut could not be attached.");
        }
    }

    private void OnAiAssistantStateChanged()
    {
        _ = InvokeAsync(HandleAiAssistantStateChangedAsync);
    }

    private async Task HandleAiAssistantStateChangedAsync()
    {
        var isOpen = AiAssistantState.IsOpen;
        if (HostedInWorkspace && AiAssistantState.IsAvailable)
        {
            await SynchronizeWorkspaceRequestAsync();
            _wasOpen = isOpen;
        }
        else if (isOpen && !_wasOpen && AiAssistantState.IsAvailable)
        {
            _wasOpen = true;
            await LoadConversationsAsync(forceStartupConversation: true);
        }
        else
        {
            _wasOpen = isOpen;
        }

        StateHasChanged();
    }

    private void ToggleConversations() => _showConversations = !_showConversations;

    private async Task LoadConversationsAsync(
        bool forceStartupConversation = false,
        Guid? requestedConversationId = null,
        bool deferStartupConversation = false)
    {
        if (_isLoadingConversations)
        {
            return;
        }

        _isLoadingConversations = true;
        _hasLoaded = true;
        ConversationState.SetLoading(true);
        ConversationState.SetError(null);

        try
        {
            await LoadBootstrapAsync();

            var collection = await ClientService.GetConversationCollectionAsync();
            ConversationState.SetConversationCollection(collection);
            if (collection is null)
            {
                ConversationState.SetError("AI assistant conversations are not available for your account.");
                return;
            }

            if (requestedConversationId is Guid conversationId)
            {
                await SelectConversationAsync(conversationId);
            }
            else if (!deferStartupConversation
                     && (forceStartupConversation || ConversationState.SelectedConversation is null))
            {
                await SelectStartupConversationAsync();
            }
        }
        finally
        {
            _isLoadingConversations = false;
            ConversationState.SetLoading(false);
        }
    }

    private async Task CreateConversationAsync()
    {
        if (!ConversationState.CanCreateConversation)
        {
            ConversationState.SetError("Conversation creation is not available for your account.");
            return;
        }

        await RunCommandAsync(async () =>
        {
            await CreateAndSelectConversationAsync();
            await LoadBootstrapAsync();
        });
    }

    private async Task CreateWorkspaceConversationAsync()
    {
        if (!ConversationState.CanCreateConversation)
        {
            ConversationState.SetError("Conversation creation is not available for your account.");
            return;
        }

        await RunCommandAsync(async () =>
        {
            await CreateAndSelectConversationAsync(replaceWorkspaceRoute: true);
            await LoadBootstrapAsync();
        });
    }

    private async Task SelectStartupConversationAsync()
    {
        if (TryGetReusableLatestConversationId(out var reusableConversationId))
        {
            await SelectConversationAsync(reusableConversationId, replaceWorkspaceRoute: true);
            return;
        }

        if (ConversationState.CanCreateConversation)
        {
            await CreateAndSelectConversationAsync(replaceWorkspaceRoute: true);
            return;
        }

        if (ConversationState.Conversations.FirstOrDefault()?.Id is Guid fallbackConversationId)
        {
            await SelectConversationAsync(fallbackConversationId, replaceWorkspaceRoute: true);
            return;
        }

        ConversationState.SetError("Conversation creation is not available for your account.");
    }

    private bool TryGetReusableLatestConversationId(out Guid conversationId)
    {
        var latestConversation = ConversationState.Conversations.FirstOrDefault();
        if (latestConversation?.Id is Guid latestConversationId && IsReusableEmptyConversation(latestConversation))
        {
            conversationId = latestConversationId;
            return true;
        }

        conversationId = default;
        return false;
    }

    private bool IsReusableEmptyConversation(HalResourceOfAiConversationSummaryDto conversation)
    {
        if (ConversationState.SelectedConversation is { } selectedConversation
            && selectedConversation.Id == conversation.Id)
        {
            return IsEmptyConversation(selectedConversation);
        }

        return conversation.LastMessageSequence.GetValueOrDefault() <= 0;
    }

    private static bool IsEmptyConversation(HalResourceOfAiConversationDto conversation)
    {
        return conversation.LastMessageSequence.GetValueOrDefault() <= 0 && (conversation.Messages?.Count ?? 0) == 0;
    }

    private async Task CreateAndSelectConversationAsync(bool replaceWorkspaceRoute = false)
    {
        var result = await ClientService.CreateConversationAsync(new CreateAiConversationRequestDto
        {
            Title = "AI Assistant",
            ActorId = _selectedActorId
        });

        if (!result.Success || result.Id is not Guid conversationId)
        {
            ConversationState.SetError(result.Message ?? "The AI assistant conversation could not be created.");
            return;
        }

        var newCollection = await ClientService.GetConversationCollectionAsync();
        ConversationState.SetConversationCollection(newCollection);
        await SelectConversationAsync(conversationId, replaceWorkspaceRoute);
    }

    private async Task SelectConversationAsync(Guid? conversationId, bool replaceWorkspaceRoute = false)
    {
        if (conversationId is not Guid id)
        {
            return;
        }

        ConversationState.SetLoading(true);
        ConversationState.SetError(null);

        var conversation = await ClientService.GetConversationAsync(id);
        if (conversation is null)
        {
            ConversationState.SetError("The AI assistant conversation could not be loaded.");
        }

        ConversationState.SelectConversation(conversation);
        _activeRunId = FindActiveRunId(conversation);
        ConversationState.SetLoading(false);
        NavigateToWorkspaceConversation(id, replaceWorkspaceRoute);
    }

    private void OpenInWorkspace()
    {
        ConversationState.SetReturnWorkspace(ShellState.ActiveWorkspace);
        var route = ConversationState.SelectedConversation?.Id is Guid conversationId
            ? $"/ai/chats/{conversationId:D}"
            : "/ai";
        Navigation.NavigateTo(route);
    }

    private void ReturnFromWorkspace()
    {
        var route = ShellState.GetLastRoute(ConversationState.ReturnWorkspace) ?? "/";
        Navigation.NavigateTo(route);
    }

    private void NavigateToWorkspaceConversation(Guid conversationId, bool replaceHistoryEntry)
    {
        if (!HostedInWorkspace)
        {
            return;
        }

        var route = $"/ai/chats/{conversationId:D}";
        var currentRoute = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimStart('/');
        if (string.Equals(currentRoute, route, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (replaceHistoryEntry)
        {
            Navigation.NavigateTo(route, new NavigationOptions { ReplaceHistoryEntry = true });
            return;
        }

        Navigation.NavigateTo(route);
    }

    private async Task SendMessageAsync()
    {
        if (ConversationState.SelectedConversation?.Id is not Guid conversationId
            || (string.IsNullOrWhiteSpace(_promptText) && _selectedImages.Count == 0))
        {
            return;
        }

        if (!AiAssistantConversationState.CanSendMessage(ConversationState.SelectedConversation))
        {
            ConversationState.SetError("Sending messages is not available for this conversation.");
            return;
        }

        var content = _promptText.Trim();
        var images = _selectedImages.ToList();
        var selectedReferences = ConversationState.SelectedReferences.ToList();
        var imageInputs = images.Select(ToImageInputDto).ToList();
        var referenceInputs = selectedReferences.Select(ToSelectedReferenceDto).ToList();
        var idempotencyKey = $"blazor-ai-send-{Guid.CreateVersion7()}";

        await RunCommandAsync(async () =>
        {
            _promptText = string.Empty;
            _selectedImages.Clear();
            CloseReferenceAutocomplete(clearResults: true);
            ConversationState.SetSelectedReferences([]);
            ConversationState.SetError(null);

            var result = await SendAiMessageRequestAsync(
                conversationId,
                content,
                idempotencyKey,
                imageInputs,
                referenceInputs);

            if (IsAuthenticationFailure(result))
            {
                var authOk = await TryRefreshAuthSessionAsync();
                if (!authOk)
                {
                    _promptText = content;
                    _selectedImages.AddRange(images);
                    ConversationState.SetSelectedReferences(selectedReferences);
                    RedirectToLogin();
                    return;
                }

                result = await SendAiMessageRequestAsync(
                    conversationId,
                    content,
                    idempotencyKey,
                    imageInputs,
                    referenceInputs);
            }

            if (!result.Success)
            {
                _promptText = content;
                _selectedImages.AddRange(images);
                ConversationState.SetSelectedReferences(selectedReferences);
                await RefreshSelectedConversationAsync(conversationId);
                ConversationState.SetError(result.Message ?? "The AI assistant message could not be sent.");
                return;
            }

            await RefreshSelectedConversationAsync(conversationId);
            if (result.Id is Guid runId)
            {
                _activeRunId = runId;
                await PollRunUntilCompleteAsync(conversationId, runId);
            }
        });
    }

    private Task<AiAssistantCommandResult> SendAiMessageRequestAsync(
        Guid conversationId,
        string content,
        string idempotencyKey,
        IReadOnlyList<AiMessageImageInputDto> images,
        IReadOnlyList<AiSelectedReferenceDto> references)
    {
        return ClientService.SendMessageAsync(
            conversationId,
            content,
            _selectedModelId,
            idempotencyKey,
            mode: SelectedInteractionMode,
            actorId: _selectedActorId,
            images: images,
            references: references);
    }

    private static bool IsAuthenticationFailure(AiAssistantCommandResult result) =>
