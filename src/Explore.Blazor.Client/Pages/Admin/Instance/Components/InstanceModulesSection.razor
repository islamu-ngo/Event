@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Modules &amp; Policy Defaults</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Enable or disable platform modules and configure default policies for event submissions and verification.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudSwitch T="bool"
                   Value="Model.EnableIslamicModule == true"
                   ValueChanged="OnIslamicModuleChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Primary">
            Enable Islamic module
        </MudSwitch>

        <MudSwitch T="bool"
                   Value="Model.EnableTechModule == true"
                   ValueChanged="OnTechModuleChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Primary">
            Enable Tech module
        </MudSwitch>

        <MudSwitch T="bool"
                   Value="EventPolicy.AllowUserSubmittedEvents == true"
                   ValueChanged="OnUserSubmittedEventsChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Primary">
            Allow user-submitted events
        </MudSwitch>

        <MudSwitch T="bool"
                   Value="OrganizationPolicy.RequireOrganizationVerification == true"
                   ValueChanged="OnRequireOrganizationVerificationChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Primary">
            Require organization verification
        </MudSwitch>

        @if (!IsSingleTenant)
        {
            <MudSwitch T="bool"
                       Value="OrganizationPolicy.AllowTenantToOmitVerification == true"
                       ValueChanged="OnAllowTenantToOmitVerificationChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary">
                Allow tenant admins to omit organization verification
            </MudSwitch>
        }

        <div role="status" aria-live="polite" aria-atomic="true">@_saveStatusMessage</div>
        <div role="alert">@_saveErrorMessage</div>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public ModuleSettingsDto Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventPolicyDto EventPolicy { get; set; } = null!;

    [Parameter, EditorRequired]
    public OrganizationPolicyDto OrganizationPolicy { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    [Parameter, EditorRequired]
    public Func<ModuleSettingsDto, Task<BaseCommandResponseOfGuid>> SaveModuleSettingsAsync { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<EventPolicyDto, Task<BaseCommandResponseOfGuid>> SaveEventPolicyAsync { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<OrganizationPolicyDto, Task<BaseCommandResponseOfGuid>> SaveOrganizationPolicyAsync { get; set; } = null!;

    private bool _isSaving;
    private string? _saveStatusMessage;
    private string? _saveErrorMessage;

    private Task OnIslamicModuleChangedAsync(bool value)
    {
        Model.EnableIslamicModule = value;
        return SaveAsync(() => SaveModuleSettingsAsync(new ModuleSettingsDto { EnableIslamicModule = value }));
    }

    private Task OnTechModuleChangedAsync(bool value)
    {
        Model.EnableTechModule = value;
        return SaveAsync(() => SaveModuleSettingsAsync(new ModuleSettingsDto { EnableTechModule = value }));
    }

    private Task OnUserSubmittedEventsChangedAsync(bool value)
    {
        EventPolicy.AllowUserSubmittedEvents = value;
        return SaveAsync(() => SaveEventPolicyAsync(new EventPolicyDto { AllowUserSubmittedEvents = value }));
    }

    private Task OnRequireOrganizationVerificationChangedAsync(bool value)
    {
        OrganizationPolicy.RequireOrganizationVerification = value;
        return SaveAsync(() => SaveOrganizationPolicyAsync(new OrganizationPolicyDto { RequireOrganizationVerification = value }));
    }

    private Task OnAllowTenantToOmitVerificationChangedAsync(bool value)
    {
        OrganizationPolicy.AllowTenantToOmitVerification = value;
        return SaveAsync(() => SaveOrganizationPolicyAsync(new OrganizationPolicyDto { AllowTenantToOmitVerification = value }));
    }

    private async Task SaveAsync(Func<Task<BaseCommandResponseOfGuid>> save)
    {
        _isSaving = true;
        _saveStatusMessage = "Saving module settings...";
        _saveErrorMessage = null;

        try
        {
            BaseCommandResponseOfGuid response = await save();
            if (response.Success == true)
            {
                _saveStatusMessage = "Module settings saved.";
                return;
            }

            _saveStatusMessage = null;
            _saveErrorMessage = string.IsNullOrWhiteSpace(response.Message)
                ? "Module settings could not be saved."
                : response.Message;
        }
        catch (Exception)
        {
            _saveStatusMessage = null;
            _saveErrorMessage = "Module settings could not be saved.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
