    private void UpdateReferenceAutocompleteFromPrompt()
    {
        _referenceMentionStartIndex = FindActiveMentionStart(_promptText);
        if (_referenceMentionStartIndex is int mentionStart)
        {
            _isReferenceAutocompleteManuallyOpened = false;
            _isReferenceAutocompleteOpen = true;
            QueueReferenceSearch(_promptText[(mentionStart + 1)..]);
            return;
        }

        if (!_isReferenceAutocompleteOpen || !_isReferenceAutocompleteManuallyOpened)
        {
            CloseReferenceAutocomplete(clearResults: true);
            return;
        }

        QueueReferenceSearch(GetTrailingReferenceSearchTerm(_promptText));
    }

    private async Task FocusPromptAsync()
    {
        if (_conversationComposer is null)
        {
            return;
        }

        try
        {
            _promptModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/ai-assistant-rail.js");
            await _conversationComposer.FocusPromptAsync(_promptModule);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "AI assistant prompt could not be focused.");
        }
    }

    private void CloseReferenceAutocomplete(bool clearResults)
    {
        _referenceSearchDebounceCts?.Cancel();
        _referenceSearchDebounceCts?.Dispose();
        _referenceSearchDebounceCts = null;
        _referenceSearchRequestId++;
        _isReferenceAutocompleteOpen = false;
        _isReferenceAutocompleteManuallyOpened = false;
        _isReferenceSearchRunning = false;
        _referenceMentionStartIndex = null;
        _activeReferenceIndex = 0;

        if (clearResults)
        {
            _referenceSearchTerm = string.Empty;
            _hasSearchedReferences = false;
            ConversationState.SetReferenceResults([]);
        }
    }

    private void InsertReferenceMention(HalResourceOfAiReferenceSearchResultDto reference)
    {
        var displayName = reference.DisplayName?.Trim();
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return;
        }

        var mention = $"@{displayName}";
        if (_referenceMentionStartIndex is int mentionStart
            && mentionStart >= 0
            && mentionStart < _promptText.Length)
        {
            var tokenEnd = mentionStart + 1;
            while (tokenEnd < _promptText.Length && !char.IsWhiteSpace(_promptText[tokenEnd]))
            {
                tokenEnd++;
            }

            var before = _promptText[..mentionStart].TrimEnd();
            var after = _promptText[tokenEnd..].TrimStart();
            var separator = before.Length == 0 ? string.Empty : " ";
            _promptText = string.IsNullOrWhiteSpace(after)
                ? $"{before}{separator}{mention} "
                : $"{before}{separator}{mention} {after}";
            return;
        }

        var prefix = _promptText.TrimEnd();
        _promptText = prefix.Length == 0 ? $"{mention} " : $"{prefix} {mention} ";
    }

    private void SyncSelectedReferencesWithPromptText()
    {
        if (ConversationState.SelectedReferences.Count == 0)
        {
            return;
        }

        var retainedReferences = ConversationState.SelectedReferences
            .Where(PromptContainsReferenceMention)
            .ToList();

        if (retainedReferences.Count != ConversationState.SelectedReferences.Count)
        {
            ConversationState.SetSelectedReferences(retainedReferences);
        }
    }

    private bool PromptContainsReferenceMention(HalResourceOfAiReferenceSearchResultDto reference)
    {
        var token = GetReferenceMentionToken(reference);
        return token is not null && _promptText.Contains(token, StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<string> GetReferenceMentionTokens()
    {
        return ConversationState.SelectedReferences
            .Select(GetReferenceMentionToken)
            .OfType<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(token => token.Length)
            .ToList();
    }

    private static string? GetReferenceMentionToken(HalResourceOfAiReferenceSearchResultDto reference)
    {
        var displayName = reference.DisplayName?.Trim();
        return string.IsNullOrWhiteSpace(displayName) ? null : $"@{displayName}";
    }

    private ReferenceDeletionRange? FindReferenceDeletion(int selectionStart, int selectionEnd, string key)
    {
        var textLength = _promptText.Length;
        var rangeStart = Math.Clamp(Math.Min(selectionStart, selectionEnd), 0, textLength);
        var rangeEnd = Math.Clamp(Math.Max(selectionStart, selectionEnd), 0, textLength);

        if (rangeStart == rangeEnd)
        {
            if (string.Equals(key, "Backspace", StringComparison.Ordinal))
            {
                if (rangeStart == 0)
                {
                    return null;
                }

                rangeStart--;
            }
            else if (string.Equals(key, "Delete", StringComparison.Ordinal))
            {
                if (rangeStart >= textLength)
                {
                    return null;
                }

                rangeEnd++;
            }
            else
            {
                return null;
            }
        }

        foreach (var token in GetReferenceMentionTokens())
        {
            var tokenStart = 0;
            while (tokenStart < _promptText.Length)
            {
                tokenStart = _promptText.IndexOf(token, tokenStart, StringComparison.OrdinalIgnoreCase);
                if (tokenStart < 0)
                {
                    break;
                }

                var tokenEnd = tokenStart + token.Length;
                if (RangesIntersect(rangeStart, rangeEnd, tokenStart, tokenEnd))
                {
                    return ExpandReferenceDeletionRange(tokenStart, tokenEnd);
                }

                tokenStart = tokenEnd;
            }
        }

        return null;
    }

    private ReferenceDeletionRange ExpandReferenceDeletionRange(int tokenStart, int tokenEnd)
    {
        var deleteStart = tokenStart;
        var deleteEnd = tokenEnd;

        if (deleteEnd < _promptText.Length && char.IsWhiteSpace(_promptText[deleteEnd]))
        {
            while (deleteEnd < _promptText.Length && char.IsWhiteSpace(_promptText[deleteEnd]))
            {
                deleteEnd++;
            }
        }
        else if (deleteStart > 0 && char.IsWhiteSpace(_promptText[deleteStart - 1]))
        {
            while (deleteStart > 0 && char.IsWhiteSpace(_promptText[deleteStart - 1]))
            {
                deleteStart--;
            }
        }

        return new ReferenceDeletionRange(deleteStart, deleteEnd - deleteStart);
    }

    private static bool RangesIntersect(int firstStart, int firstEnd, int secondStart, int secondEnd) =>
        firstStart < secondEnd && firstEnd > secondStart;

    private void BuildPromptReferenceHighlights(RenderTreeBuilder builder)
    {
        var tokens = GetReferenceMentionTokens();
        if (_promptText.Length == 0 || tokens.Count == 0)
        {
            return;
        }

        var sequence = 0;
        var index = 0;
        while (index < _promptText.Length)
        {
            var match = tokens.FirstOrDefault(token =>
                index + token.Length <= _promptText.Length
                && string.Compare(
                    _promptText,
                    index,
                    token,
                    0,
                    token.Length,
                    StringComparison.OrdinalIgnoreCase) == 0);

            if (match is not null)
            {
                var text = _promptText.Substring(index, match.Length);
                builder
                    .OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "ai-rail__prompt-reference-token");
                builder.AddAttribute(sequence++, "data-testid", "ai-rail-prompt-reference-token");
                builder.AddContent(sequence++, text);
                builder.CloseElement();
                index += match.Length;
                continue;
            }

            builder.AddContent(sequence++, _promptText[index].ToString());
            index++;
        }
    }

    private static int? FindActiveMentionStart(string text)
    {
        var start = text.LastIndexOf('@');
        if (start < 0)
        {
            return null;
        }

        for (var index = start + 1; index < text.Length; index++)
        {
            if (char.IsWhiteSpace(text[index]))
            {
                return null;
            }
        }

        return start;
    }

    private static string GetTrailingReferenceSearchTerm(string text)
    {
        var trimmed = text.TrimEnd();
        if (trimmed.Length == 0)
        {
            return string.Empty;
        }

        var lastWhitespace = trimmed.LastIndexOfAny([' ', '\t', '\r', '\n']);
        var term = lastWhitespace < 0 ? trimmed : trimmed[(lastWhitespace + 1)..];
        return term.TrimStart('@');
    }

    private void OnActorSelectionChanged(Guid? actorId)
    {
        _selectedActorId = actorId is Guid id && _actorOptions.Any(actor => actor.ActorId == id) ? id : null;
    }

    public async ValueTask DisposeAsync()
    {
        AiAssistantState.OnChange -= OnAiAssistantStateChanged;
        ConversationState.OnChange -= StateHasChanged;

        if (_promptModule is not null)
        {
            try
            {
                if (_conversationComposer is not null)
                {
                    await _conversationComposer.DetachPromptKeyboardHandlerAsync(_promptModule);
                }
                await _promptModule.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "AI assistant prompt keyboard shortcut cleanup failed.");
            }
        }

        _referenceSearchDebounceCts?.Cancel();
        _referenceSearchDebounceCts?.Dispose();
        _promptInteropReference?.Dispose();
    }

    private sealed record AiRailModelOption(string Id, string DisplayName);
    public sealed record PromptReferenceDeletionResult(bool Handled, string Text, int SelectionStart)
    {
        public static PromptReferenceDeletionResult NotHandled(string text, int selectionStart) =>
            new(false, text, selectionStart);
    }

    private sealed record ReferenceDeletionRange(int Start, int Length);

