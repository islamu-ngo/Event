@* ABOUTME: Renders SMTP settings fields for Instance Admin Settings. *@
@* ABOUTME: Keeps credentials in external authority while editing only non-secret delivery policy. *@

@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">SMTP Configuration</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure non-secret SMTP delivery policy. Credentials come from the selected secret authority.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <Explore.Blazor.Client.Pages.Admin.Components.EmailDeliveryAdminSection InstanceScope="true" Changed="DeliveryChanged" />
        <MudTextField T="string" Label="SMTP Host"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.Host"
                      Placeholder="smtp.example.com" />

        <MudNumericField T="int?" Label="SMTP Port"
                         Variant="Variant.Outlined"
                         @bind-Value="Model.Port"
                         Min="1"
                         Max="65535" />

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            SMTP username and password are managed by the selected external secret authority.
        </MudAlert>

        <MudSelect T="string"
                   Label="Security Mode"
                   Variant="Variant.Outlined"
                   @bind-Value="Model.Security">
            <MudSelectItem Value="@("None")">None</MudSelectItem>
            <MudSelectItem Value="@("StartTls")">Start TLS</MudSelectItem>
            <MudSelectItem Value="@("SslOnConnect")">SSL on connect</MudSelectItem>
            <MudSelectItem Value="@("Auto")">Auto</MudSelectItem>
        </MudSelect>

        <MudTextField T="string" Label="From Address"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.FromAddress"
                      Placeholder="noreply@example.com" />

        <MudTextField T="string" Label="From Name"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.FromName"
                      Placeholder="Community Events" />

        <MudNumericField T="int?" Label="Timeout (seconds)"
                         Variant="Variant.Outlined"
                         @bind-Value="Model.TimeoutSeconds"
                         Min="1"
                         Max="300" />

        <MudSwitch T="bool"
                   Value="Model.SkipCertificateValidation == true"
                   ValueChanged="@(value => Model.SkipCertificateValidation = value)"
                   Color="Color.Warning">
            Skip certificate validation (development only)
        </MudSwitch>

        <MudDivider Class="my-2" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Elevation="0" Variant="Variant.Outlined"
                       Color="Color.Info"
                       OnClick="TestConnectionAsync"
                       Disabled="_isTesting"
                       StartIcon="@(_isTesting ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.NetworkCheck)">
                @(_isTesting ? "Testing..." : "Test Connection")
            </MudButton>

            @if (_testResult != null)
            {
                <MudAlert Severity="@(_testResult.Success == true ? Severity.Success : Severity.Error)"
                          Dense="true"
                          NoIcon="false"
                          Class="flex-grow-1">
                    @_testResult.Message
                </MudAlert>
            }
        </MudStack>
        @if (!IsSingleTenant)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Tenant Delegation</MudText>
            <MudSwitch T="bool" Value="LockForTenants"
                       ValueChanged="SaveTenantLockAsync"
                       Disabled="_lockSavePending"
                       Color="Color.Warning">
                Lock SMTP settings — tenants cannot configure their own email delivery
            </MudSwitch>
            @if (!string.IsNullOrWhiteSpace(_lockSaveMessage))
            {
                <MudAlert Severity="@(_lockSaveSucceeded ? Severity.Success : Severity.Error)"
                          Dense="true"
                          role="@(_lockSaveSucceeded ? "status" : "alert")">
                    @_lockSaveMessage
                </MudAlert>
            }
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public HalResourceOfInstanceSmtpSettingsDto Model { get; set; } = null!;

    [Parameter]
    public EventCallback DeliveryChanged { get; set; }

    [Parameter]
    public IInstanceOnboardingService? OnboardingService { get; set; }

    [Parameter]
    public bool IsSingleTenant { get; set; }

    [Parameter]
    public bool LockForTenants { get; set; }

    [Parameter]
    public Func<bool, Task<bool>>? SaveLockAsync { get; set; }

    private bool _isTesting;
    private bool _lockSavePending;
    private bool _lockSaveSucceeded;
    private string? _lockSaveMessage;
    private SmtpConnectionTestResultDto? _testResult;

    private async Task TestConnectionAsync()
    {
        if (OnboardingService == null)
        {
            return;
        }

        _isTesting = true;
        _testResult = null;
        StateHasChanged();

        _testResult = await OnboardingService.TestSmtpConnectionAsync();
        _isTesting = false;
    }

    private async Task SaveTenantLockAsync(bool value)
    {
        if (_lockSavePending || SaveLockAsync is null)
        {
            return;
        }

        _lockSavePending = true;
        _lockSaveMessage = null;
        bool saved = await SaveLockAsync(value);
        _lockSaveSucceeded = saved;
        _lockSaveMessage = saved
            ? "SMTP tenant lock saved."
            : "SMTP tenant lock could not be saved. The latest value was restored.";
        _lockSavePending = false;
    }
}
