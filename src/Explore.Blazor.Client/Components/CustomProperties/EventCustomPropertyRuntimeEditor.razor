@using Explore.Blazor.Client.Contracts.Services.CustomProperties
@using Explore.Blazor.Client.Models.CustomProperties
@using MudBlazor

@inject ICustomPropertyValueService CustomPropertyValueService
@inject ISnackbar Snackbar

<div class="event-cpr-editor">
    @if (IsLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @if (Errors != null && Errors.Any())
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                <ul>
                    @foreach (var error in Errors)
                    {
                        <li>@error.Key: @string.Join(", ", error.Value)</li>
                    }
                </ul>
            </MudAlert>
        }

        @foreach (var def in Definitions.OrderBy(d => d.SortOrder))
        {
            if (!_valueDictionary.TryGetValue(def.Id ?? Guid.Empty, out var values))
            {
                values = new List<CustomPropertyValueModel>();
                _valueDictionary[def.Id ?? Guid.Empty] = values;
            }

            <CustomPropertyFieldEditor Definition="@def"
                                       Values="@values"
                                       ParentId="@EventId"
                                       OnChanged="HandleFieldChanged" />
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(IsSaving || HasLoadError)" OnClick="SaveAsync" Class="mt-4">
            @if (IsSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving</MudText>
            }
            else
            {
                <MudText>Save Properties</MudText>
            }
        </MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid EventId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<CustomPropertyDefinitionDto> Definitions { get; set; } = Array.Empty<CustomPropertyDefinitionDto>();

    [Parameter]
    public EventCallback OnSaved { get; set; }

    public bool IsLoading { get; private set; } = true;
    public bool IsSaving { get; private set; }
    
    private Dictionary<Guid, List<CustomPropertyValueModel>> _valueDictionary = new();
    private Dictionary<string, string[]> Errors { get; set; } = new();
    private Guid _loadedEventId;
    private string _loadedDefinitionSignature = string.Empty;

    private bool HasLoadError => Errors.ContainsKey("Load");

    protected override async Task OnParametersSetAsync()
    {
        var definitionSignature = GetDefinitionSignature();
        if (EventId != Guid.Empty && (EventId != _loadedEventId || definitionSignature != _loadedDefinitionSignature))
        {
            _loadedEventId = EventId;
            _loadedDefinitionSignature = definitionSignature;
            await LoadValuesAsync();
        }
    }

    private async Task LoadValuesAsync()
    {
        IsLoading = true;
        Errors.Clear();
        try
        {
            var values = await CustomPropertyValueService.GetEventValuesAsync(EventId);
            
            _valueDictionary = Definitions.ToDictionary(
                d => d.Id ?? Guid.Empty,
                d => values.Where(v => v.DefinitionId == d.Id).OrderBy(v => v.Ordinal).ToList()
            );
        }
        catch (Exception)
        {
            Errors["Load"] = new[] { "Failed to load custom properties. Refresh and try again before saving." };
            Snackbar.Add("Failed to load custom properties.", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleFieldChanged()
    {
        // For potential auto-save or form dirty state tracking
    }

    public async Task SaveAsync()
    {
        if (HasLoadError)
        {
            Snackbar.Add("Refresh custom properties before saving.", Severity.Warning);
            return;
        }

        IsSaving = true;
        Errors.Clear();
        bool hasErrors = false;

        try
        {
            foreach (var def in Definitions)
            {
                if (_valueDictionary.TryGetValue(def.Id ?? Guid.Empty, out var values))
                {
                    if (!PrepareValuesForSave(def, values))
                    {
                        hasErrors = true;
                        continue;
                    }

                    BaseCommandResponseOfGuid? response;
                    if (def.IsMulti == true)
                    {
                        response = await CustomPropertyValueService.SetEventMultiValuesAsync(def.Id ?? Guid.Empty, EventId, values);
                    }
                    else
                    {
                        var model = values.FirstOrDefault();
                        if (model == null) continue; // Should not happen, CustomPropertyFieldEditor adds one
                        
                        response = await CustomPropertyValueService.SetEventValueAsync(def.Id ?? Guid.Empty, EventId, model);
                    }

                    if (response is null)
                    {
                        hasErrors = true;
                        Errors[$"Definition {def.DisplayName}"] = new[] { "Save did not return a result." };
                    }
                    else if (response.Success != true)
                    {
                        hasErrors = true;
                        if (response.Errors != null && response.Errors.Any())
                        {
                            Errors[$"Definition {def.DisplayName}"] = response.Errors.ToArray();
                        }
                    }
                }
            }

            if (!hasErrors)
            {
                Snackbar.Add("Custom properties saved successfully.", Severity.Success);
                if (OnSaved.HasDelegate)
                {
                    await OnSaved.InvokeAsync();
                }
            }
        }
        catch (Explore.Blazor.Client.Clients.ApiException<Explore.Blazor.Client.Clients.ProblemDetails> apiEx)
        {
            hasErrors = true;
            Errors["API Error"] = new[] { apiEx.Result?.Detail ?? apiEx.Message };
        }
        catch (Exception)
        {
            hasErrors = true;
            Snackbar.Add("An unexpected error occurred while saving.", Severity.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private string GetDefinitionSignature()
    {
        return string.Join('|', Definitions.OrderBy(d => d.Id).Select(d => $"{d.Id:N}:{d.SortOrder}:{d.IsRequired}:{d.IsMulti}:{d.PropertyType ?? 0}"));
    }

    private bool PrepareValuesForSave(CustomPropertyDefinitionDto definition, List<CustomPropertyValueModel> values)
    {
        var propertyType = (PropertyType)(definition.PropertyType ?? 0);
        if (definition.IsMulti == true)
        {
            RemoveEmptyOptionalValues(values, propertyType);
            Reorder(values);

            if (definition.IsRequired == true && !values.Any(v => HasValue(v, propertyType)))
            {
                Errors[$"Definition {definition.DisplayName}"] = new[] { $"{definition.DisplayName} requires at least one value." };
                return false;
            }

            return true;
        }

        var value = values.FirstOrDefault();
        if (definition.IsRequired == true && (value is null || !HasValue(value, propertyType)))
        {
            Errors[$"Definition {definition.DisplayName}"] = new[] { $"{definition.DisplayName} is required." };
            return false;
        }

        return true;
    }

    private static void RemoveEmptyOptionalValues(List<CustomPropertyValueModel> values, PropertyType propertyType)
    {
        values.RemoveAll(v => !HasValue(v, propertyType));
    }

    private static bool HasValue(CustomPropertyValueModel value, PropertyType propertyType)
    {
        return propertyType switch
        {
            PropertyType.Text => !string.IsNullOrWhiteSpace(value.TextValue),
            PropertyType.Url => !string.IsNullOrWhiteSpace(value.TextValue),
            PropertyType.Number => value.NumberValue.HasValue,
            PropertyType.Option => value.OptionId.HasValue,
            PropertyType.Boolean => value.BooleanValue.HasValue,
            PropertyType.DateTime => value.DateTimeValue.HasValue,
            _ => false
        };
    }

    private static void Reorder(List<CustomPropertyValueModel> values)
    {
        for (var i = 0; i < values.Count; i++)
        {
            values[i].Ordinal = i;
        }
    }
}
