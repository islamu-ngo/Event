@using Explore.Blazor.Client.Pages.Studio
@using Explore.Blazor.Client.Contracts.Services.Events
@implements IDisposable
@inject StudioEventContextState EventContext
@inject IEventTicketingService Ticketing
@inject IEventPromotionService Promotions

<nav class="studio-event-navigation" aria-label="Event management navigation" data-testid="studio-event-navigation">
    <MudNavMenu Dense="false" Class="studio-event-navigation__menu px-2">
        <MudNavLink Href="/studio/events"
                    Icon="@Icons.Material.Filled.ArrowBack"
                    Match="NavLinkMatch.All">
            All events
        </MudNavLink>

        @if (EventContext.IsLoading && Resource is null)
        {
            <div class="studio-event-navigation__state" role="status">Loading event…</div>
        }
        else if (Resource is not null)
        {
            <div class="studio-event-navigation__header">
                <MudText Typo="Typo.h6" Class="studio-event-navigation__title">@Resource.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Resource.EventStatusFullName))
                {
                    <span class="studio-event-navigation__status">@Resource.EventStatusFullName</span>
                }
            </div>

            @if (Resource.HasHalLink("edit"))
            {
                <MudNavLink Href="@StudioRoute" Icon="@Icons.Material.Outlined.Edit" Match="NavLinkMatch.All" data-event-section="details">
                    Details
                </MudNavLink>
            }
            @if (HasScheduleRelation(Resource))
            {
                <MudNavLink Href="@($"{StudioRoute}/schedule")" Icon="@Icons.Material.Outlined.CalendarMonth" Match="NavLinkMatch.All" data-event-section="schedule">
                    Schedule
                </MudNavLink>
            }
            @if (Resource.HasHalLink("configure-participation"))
            {
                <MudNavLink Href="@($"{StudioRoute}/registration")" Icon="@Icons.Material.Outlined.HowToReg" Match="NavLinkMatch.All" data-event-section="registration">
                    Registration
                </MudNavLink>
            }
            @if (Resource.HasHalLink("manage-ticket-types") || Resource.HasHalLink("manage-capacity-pools"))
            {
                <MudNavLink Href="@($"{StudioRoute}/tickets")" Icon="@Icons.Material.Outlined.ConfirmationNumber" Match="NavLinkMatch.All" data-event-section="tickets">
                    Tickets
                </MudNavLink>
            }
            @if (Resource.HasHalLink("view-registration-orders"))
            {
                <MudNavLink Href="@($"{StudioRoute}/orders")" Icon="@Icons.Material.Outlined.ReceiptLong" Match="NavLinkMatch.All" data-event-section="orders">
                    Orders
                </MudNavLink>
            }
            @if (_promotionNavigationAvailable)
            {
                <MudNavLink Href="@($"{StudioRoute}/promotions")" Icon="@Icons.Material.Outlined.LocalOffer" Match="NavLinkMatch.All" data-event-section="promotions">
                    Promotions
                </MudNavLink>
            }
            @if (HasIntegrationRelation(Resource))
            {
                <MudNavLink Href="@($"{StudioRoute}/integrations")" Icon="@Icons.Material.Outlined.Extension" Match="NavLinkMatch.All" data-event-section="integrations">
                    Integrations
                </MudNavLink>
            }
            @if (Resource.HasHalLink("manage-registration-workflow"))
            {
                <MudNavLink Href="@($"{StudioRoute}/forms")" Icon="@Icons.Material.Outlined.DynamicForm" Match="NavLinkMatch.All" data-event-section="forms">
                    Forms
                </MudNavLink>
            }
            @if (Resource.HasHalLink("check-in-admissions"))
            {
                <MudNavLink Href="@($"{StudioRoute}/check-in")" Icon="@Icons.Material.Outlined.QrCodeScanner" Match="NavLinkMatch.All" data-event-section="check-in">
                    Check-in
                </MudNavLink>
            }
            @if (Resource.HasHalLink("view-participants"))
            {
                <MudNavLink Href="@($"{StudioRoute}/attendees")" Icon="@Icons.Material.Outlined.Groups" Match="NavLinkMatch.All" data-event-section="attendees">
                    Attendees
                </MudNavLink>
            }
            @if (Resource.HasHalLink("publish-readiness"))
            {
                <MudNavLink Href="@($"{StudioRoute}/publication")" Icon="@Icons.Material.Outlined.Publish" Match="NavLinkMatch.All" data-event-section="publication">
                    Publication
                </MudNavLink>
            }
            @if (Resource.HasHalLink("team"))
            {
                <MudNavLink Href="@PublicEventRoute" Icon="@Icons.Material.Outlined.Groups" Match="NavLinkMatch.All" data-event-section="team">
                    Team
                </MudNavLink>
            }
            @if (Resource.HasHalLink("delete"))
            {
                <MudNavLink Href="@PublicEventRoute" Icon="@Icons.Material.Outlined.Warning" Match="NavLinkMatch.All" data-event-section="danger">
                    Danger zone
                </MudNavLink>
            }
        }
        else if (EventContext.ErrorMessage is not null)
        {
            <div class="studio-event-navigation__state" role="alert">@EventContext.ErrorMessage</div>
        }
    </MudNavMenu>
</nav>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventDto? Resource => EventContext.EventId == EventId ? EventContext.Event : null;
    private string StudioRoute => $"/studio/events/{EventId}";
    private string PublicEventRoute => EventUrlHelper.BuildPublicPath(Resource?.Slug, Resource?.PublicCode)
        ?? $"/events/{EventId}/edit";
    private CancellationTokenSource? _promotionRequest;
    private long _promotionLoadGeneration;
    private bool _promotionNavigationAvailable;

    protected override async Task OnParametersSetAsync()
    {
        EventContext.Changed -= OnContextChanged;
        EventContext.Changed += OnContextChanged;
        await EventContext.LoadAsync(EventId);
        await LoadPromotionNavigationAsync();
    }

    private static bool HasScheduleRelation(EventDto resource) =>
        resource.HasHalLink("sessions")
        || resource.HasHalLink("program")
        || resource.HasHalLink("session-groups")
        || resource.HasHalLink("add-session")
        || resource.HasHalLink("create-session-draft");

    private static bool HasIntegrationRelation(EventDto resource) =>
        resource.HasHalLink("manage-registration-channels")
        || resource.HasHalLink("view-registration-provider-health");

    private async Task LoadPromotionNavigationAsync()
    {
        _promotionRequest?.Cancel();
        _promotionRequest?.Dispose();
        var generation = ++_promotionLoadGeneration;
        var eventId = EventId;
        _promotionNavigationAvailable = false;
        if (Resource is not { } resource
            || (!resource.HasHalLink("manage-ticket-types") && !resource.HasHalLink("manage-capacity-pools")))
        {
            return;
        }

        var request = new CancellationTokenSource();
        _promotionRequest = request;
        try
        {
            EventTicketCatalogState? catalog = await Ticketing.GetCatalogAsync(eventId, request.Token);
            PromotionManagementCollectionState? promotions = catalog?.CatalogId is { } catalogVersionId
                ? await Promotions.GetPromotionsAsync(eventId, catalogVersionId, request.Token)
                : null;
            if (generation == _promotionLoadGeneration && EventId == eventId && ReferenceEquals(_promotionRequest, request))
            {
                _promotionNavigationAvailable = promotions?.HasLink("create-promotion") == true;
            }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _promotionNavigationAvailable = false;
        }
    }

    private void OnContextChanged() => _ = InvokeAsync(async () =>
    {
        await LoadPromotionNavigationAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        EventContext.Changed -= OnContextChanged;
        ++_promotionLoadGeneration;
        _promotionRequest?.Cancel();
        _promotionRequest?.Dispose();
        GC.SuppressFinalize(this);
    }
}
