@using Explore.Blazor.Client.Services.Shell

<nav class="app-workspace-rail" aria-label="Application workspaces" data-testid="app-workspace-rail">
    <ul class="app-workspace-rail__list">
        @foreach (var workspace in _visibleWorkspaces.Where(workspace => workspace.Key != WorkspaceKey.Settings))
        {
            var isActive = IsActive(workspace);
            <li class="app-workspace-rail__item">
                <a href="@GetRoute(workspace)"
                   class="@GetLinkClass(isActive, false)"
                   aria-current="@(isActive ? "page" : null)"
                   title="@GetLabel(workspace)"
                   aria-label="@GetLabel(workspace)">
                    <MudIcon Icon="@workspace.Icon" Class="app-workspace-rail__icon" />
                    <span class="app-workspace-rail__label">@GetLabel(workspace)</span>
                </a>
            </li>
        }

        @if (TenantLinks.Count > 0)
        {
            <li class="app-workspace-rail__divider" role="separator"></li>
            @foreach (var link in TenantLinks)
            {
                var isActive = IsTenantLinkActive(link);
                <li @key="link.Id" class="app-workspace-rail__item app-workspace-rail__item--tenant">
                    <a href="@link.Url"
                       class="@GetTenantLinkClass(isActive)"
                       target="@(link.OpenInNewTab == true ? "_blank" : null)"
                       rel="@(link.OpenInNewTab == true ? "noopener noreferrer" : null)"
                       aria-current="@(isActive ? "page" : null)"
                       title="@link.Label"
                       aria-label="@link.Label"
                       data-testid="tenant-rail-link">
                        <TenantNavigationLinkIcon Icon="@link.Icon" Url="@link.Url" />
                        <span class="app-workspace-rail__label">@link.Label</span>
                    </a>
                </li>
            }

            <li class="app-workspace-rail__item app-workspace-rail__item--mobile-links-tab">
                <button type="button"
                        class="app-workspace-rail__link"
                        title="Links"
                        aria-label="Open navigation links"
                        aria-haspopup="dialog"
                        aria-expanded="@(_isMobileLinksSheetOpen ? "true" : "false")"
                        aria-controls="tenant-nav-bottom-sheet"
                        data-testid="mobile-links-tab"
                        @onclick="OpenMobileLinksSheet">
                    <MudIcon Icon="@Icons.Material.Filled.Apps" Class="app-workspace-rail__icon" />
                    <span class="app-workspace-rail__label">Links</span>
                </button>
            </li>
        }

        @if (_visibleWorkspaces.FirstOrDefault(workspace => workspace.Key == WorkspaceKey.Settings) is { } settingsWorkspace)
        {
            var isActive = IsActive(settingsWorkspace);
            var isUtilityOpen = IsUtilityOpen(settingsWorkspace);
            <li class="app-workspace-rail__item app-workspace-rail__item--settings">
                <div class="app-workspace-rail__action">
                    <a href="@GetRoute(settingsWorkspace)"
                       class="@GetLinkClass(isActive, isUtilityOpen)"
                       @onclick="@(args => OnWorkspaceClicked(settingsWorkspace, args))"
                       aria-current="@(isActive ? "page" : null)"
                       data-utility-open="@(isUtilityOpen ? "true" : null)"
                       title="@GetLabel(settingsWorkspace)"
                       aria-label="@GetLabel(settingsWorkspace)">
                        <MudIcon Icon="@settingsWorkspace.Icon" Class="app-workspace-rail__icon" />
                        <span class="app-workspace-rail__label">@GetLabel(settingsWorkspace)</span>
                    </a>
                    @if (_settingsLinks.Count > 0)
                    {
                        <details class="app-workspace-rail__settings-menu">
                            <summary aria-label="Open Settings menu" title="More Settings">⋮</summary>
                            <div class="app-workspace-rail__settings-menu-content">
                                <a href="/settings">All settings</a>
                                @if (_showSiteAdministration)
                                {
                                    <span class="app-workspace-rail__settings-menu-label">Site administration</span>
                                }
                                @foreach (var link in _settingsLinks)
                                {
                                    <a href="@link.Href">@link.Label</a>
                                }
                            </div>
                        </details>
                    }
                </div>
            </li>
        }
    </ul>
</nav>

<TenantNavBottomSheet IsOpen="@_isMobileLinksSheetOpen"
                      Links="@TenantLinks"
                      OnClose="CloseMobileLinksSheet" />
