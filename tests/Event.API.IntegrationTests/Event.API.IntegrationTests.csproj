<Project Sdk="Microsoft.NET.Sdk">

  <!-- The provider-neutral parity corpus is declared once and linked into every lane that evaluates it,
       so Local and Cerbos can never drift onto different scenario sets. -->
  <ItemGroup>
    <Compile Include="..\Shared\Authorization\ProviderNeutralCorpus.cs" Link="Authorization\ProviderNeutralCorpus.cs" />
    <Compile Include="..\Shared\Moderation\ModerationMeasurementJournalAttribute.cs" Link="Moderation\ModerationMeasurementJournalAttribute.cs" />
    <Compile Include="..\Shared\Settings\SmtpSettingsDatabase.cs" Link="Settings\SmtpSettingsDatabase.cs" />
    <!-- Terminal HTTP regressions share the original native publication fixture, not a success-providing substitute. -->
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationPolicyPublicationTests.Fixture.cs" Link="Moderation\ModerationPolicyPublicationTests.Fixture.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationNoticePrivacyFixture.cs" Link="Moderation\ModerationNoticePrivacyFixture.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Fixtures\LocalIdentitySqliteTemplate.cs" Link="Fixtures\LocalIdentitySqliteTemplate.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Fixtures\SqliteTestDatabaseFactory.cs" Link="Fixtures\SqliteTestDatabaseFactory.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\TestDbContextOptions.cs" Link="Fixtures\TestDbContextOptions.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationNoticeReadTests.CorrectionFixture.cs" Link="Moderation\ModerationNoticeReadTests.CorrectionFixture.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationQualificationWriterTests.Fixture.cs" Link="Moderation\ModerationQualificationWriterTests.Fixture.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationResourceGenerationWriterTests.Fixture.cs" Link="Moderation\ModerationResourceGenerationWriterTests.Fixture.cs" />
    <Compile Include="..\Event.Persistence.IntegrationTests\Moderation\ModerationNativeAuthorityParticipantTests.UnconfiguredKeys.cs" Link="Moderation\ModerationNativeAuthorityParticipantTests.UnconfiguredKeys.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\..\src\Explore.Blazor\Explore.Blazor.csproj" Aliases="bff" />
    <ProjectReference Include="..\..\src\Event.Standalone\Event.Standalone.csproj" Aliases="standalone" />
    <ProjectReference Include="..\..\src\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite\Explore.Persistence.PrivacyErasureAuthority.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Explore.ServiceDefaults\Explore.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="Cerbos.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- SSH.NET: direct ref activates CPM pin 2026.0.0, remediating GHSA-q939-rpr3-3284 transitive via Testcontainers -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docker\keycloak\ISLAMU-realm.test.json" Link="TestAssets\ISLAMU-realm.test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\cerbos\policies\**\*" LinkBase="TestAssets\cerbos\policies">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
