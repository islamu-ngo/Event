    private Task SaveFieldAsync(RegistrationFormFieldEditModel model)
    {
        RegistrationFormSectionDto section = _version!.Sections.Single(item => item.Id == _fieldSectionId);
        return MutateAsync(async (eventId, token) =>
        {
            if (model.Source is null)
            {
                Guid fieldId = await Authoring.AddFieldAsync(eventId, _form!.Id, _version!.Id, section.Id, section.ConcurrencyStamp,
                    model.ToCreateInput(), SectionLink(section, "add-field")!, token);
                await ReloadVersionAsync(eventId, token);
                RegistrationFormFieldDto created = _version!.Sections.SelectMany(item => item.Fields).Single(item => item.Id == fieldId);
                await Authoring.UpdateFieldAsync(eventId, _form!.Id, _version.Id, section.Id, created,
                    model.ToUpdateInput(), FieldLink(created, "edit")!, token);
            }
            else
            {
                await Authoring.UpdateFieldAsync(eventId, _form!.Id, _version!.Id, section.Id, model.Source,
                    model.ToUpdateInput(), FieldLink(model.Source, "edit")!, token);
            }
            CancelFieldEdit();
            await ReloadVersionAsync(eventId, token);
        }, model.Source is null ? T("status.field_added", "Field added.") : T("status.field_updated", "Field updated."));
    }

