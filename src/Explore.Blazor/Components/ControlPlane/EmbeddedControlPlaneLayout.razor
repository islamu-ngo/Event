@inherits LayoutComponentBase
@using Explore.Blazor.Client.Routing.ControlPlane

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider DefaultFocus="DefaultFocus.FirstChild" />
<MudSnackbarProvider />

<div class="control-plane-shell">
    <aside class="control-plane-shell__sidebar" aria-label="Control-plane navigation">
        <a class="control-plane-shell__brand" href="@ControlPlaneRoutes.Overview">Event Control Plane</a>
        <nav class="control-plane-shell__nav">
            @foreach (var route in RouteCatalog.All)
            {
                <NavLink class="control-plane-shell__nav-link" href="@route.Path" Match="@NavLinkMatch.Prefix">
                    @LabelFor(route.Key)
                </NavLink>
            }
        </nav>
    </aside>

    <div class="control-plane-shell__main">
        <header class="control-plane-shell__topbar">
            <span>Instance administration</span>
            <a class="control-plane-shell__link" href="/auth/signout">Sign out</a>
        </header>
        @Body
    </div>
</div>

@code {
    [Inject]
    private IControlPlaneRouteCatalog RouteCatalog { get; set; } = null!;

    private static string LabelFor(string key) =>
        key switch
        {
            ControlPlaneRouteKeys.Overview => "Overview",
            ControlPlaneRouteKeys.Tenants => "Tenants",
            ControlPlaneRouteKeys.Domains => "Domains",
            ControlPlaneRouteKeys.Onboarding => "Onboarding",
            ControlPlaneRouteKeys.Health => "Health",
            ControlPlaneRouteKeys.Storage => "Storage",
            ControlPlaneRouteKeys.Jobs => "Jobs",
            ControlPlaneRouteKeys.Security => "Security",
            ControlPlaneRouteKeys.Policies => "Policies",
            _ => key
        };
}
