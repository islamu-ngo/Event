    private async Task<bool> ValidateMappingsAsync(BindingDraft draft)
    {
        var valid = draft.FieldMappings.All(mapping => !string.IsNullOrWhiteSpace(mapping.PlatformFieldKey) && !string.IsNullOrWhiteSpace(mapping.ProviderFieldKey))
            && draft.OptionMappings.All(mapping => !string.IsNullOrWhiteSpace(mapping.PlatformFieldKey) && !string.IsNullOrWhiteSpace(mapping.PlatformOptionKey) && !string.IsNullOrWhiteSpace(mapping.ProviderOptionKey));
        _validationMessage = valid ? null : "Complete mapping keys before saving mappings.";
        if (!valid)
        {
            await Announcer.AnnounceAssertiveAsync(_validationMessage);
            await Focus.RestoreFocusAsync("[data-testid='integrations-validation']");
        }
        return valid;
    }

    private async Task PersistCreatedOriginsAsync(Guid? connectionId, CancellationToken cancellationToken)
    {
        if (connectionId is null || connectionId == Guid.Empty) throw new InvalidOperationException("Created connection response did not include an id.");
        var resource = await Integrations.GetConnectionAsync(TenantId, EventId, connectionId.Value, cancellationToken);
        var item = new IntegrationHalItem(JsonSerializer.SerializeToElement(resource, JsonOptions).Clone());
        if (item.Link(OriginsRel) is not { } originsLink) throw new InvalidOperationException("Created connection did not expose origins link.");
        await Integrations.ReplaceApprovedOriginsAsync(TenantId, EventId, connectionId.Value, originsLink, new ReplaceRegistrationProviderApprovedOriginsRequestDto
        {
            Origins = _connectionDraft.Origins
        }, cancellationToken);
    }

