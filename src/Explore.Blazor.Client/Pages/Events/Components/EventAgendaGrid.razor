@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Services

@inject IEventAgendaItemService AgendaItemService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="event-agenda-grid">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
            Agenda
            @if (_selectedDay != null)
            {
                <span> &mdash; @(!string.IsNullOrEmpty(_selectedDay.Label) ? _selectedDay.Label : _selectedDay.LocalDate?.ToString("MMM d"))</span>
            }
        </MudText>
        <MudButton Elevation="0" StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Text"
                   Size="Size.Small"
                   Color="Color.Primary"
                   OnClick="OpenCreateDialog"
                   Disabled="@(!CanManage)">
            Add Item
        </MudButton>
    </div>

    @if (Days.Count > 1)
    {
        <MudChipSet T="Guid"
                    SelectedValue="_selectedDayId"
                    SelectedValueChanged="OnDaySelected"
                    SelectionMode="SelectionMode.SingleSelection"
                    Class="mb-3">
            <MudChip T="Guid" Value="Guid.Empty" Variant="Variant.Text" Size="Size.Small">All Days</MudChip>
            @foreach (var day in Days.OrderBy(d => d.SortOrder))
            {
                <MudChip T="Guid" Value="@(day.Id ?? Guid.Empty)" Variant="Variant.Text" Size="Size.Small">
                    @(!string.IsNullOrEmpty(day.Label) ? day.Label : day.LocalDate?.ToString("MMM d"))
                </MudChip>
            }
        </MudChipSet>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }
    else if (_filteredItems.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
            No agenda items. Click "Add Item" to schedule activities.
        </MudAlert>
    }
    else
    {
        @if (Rooms.Count > 0)
        {
            @* Grid layout with room columns *@
            <div class="event-agenda-grid__container" style="@GetGridStyle()">
                @* Header row: time axis + room names *@
                <div class="event-agenda-grid__time-header">Time</div>
                @foreach (var room in Rooms.OrderBy(r => r.SortOrder))
                {
                    <div class="event-agenda-grid__room-header">
                        <MudText Typo="Typo.caption" Style="font-weight: 600;">@room.Name</MudText>
                        @if (room.Capacity > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(@room.Capacity)</MudText>
                        }
                    </div>
                }

                @* Agenda items grouped by time slots *@
                @foreach (var timeGroup in GetTimeGroups())
                {
                    <div class="event-agenda-grid__time-slot">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@timeGroup.TimeLabel</MudText>
                    </div>
                    @foreach (var room in Rooms.OrderBy(r => r.SortOrder))
                    {
                        var item = timeGroup.ItemsByRoom.GetValueOrDefault(room.Id ?? Guid.Empty);
                        <div class="event-agenda-grid__cell @(item != null ? "event-agenda-grid__cell--filled" : "")">
                            @if (item != null)
                            {
                                <div class="event-agenda-grid__item" @onclick="@(() => { if (CanManage) OpenEditDialog(item); })">
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@item.Title</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatTime(item.StartTime) &ndash; @FormatTime(item.EndTime)
                                    </MudText>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            @* Simple list view when no rooms are configured *@
            <MudStack Spacing="2">
                @foreach (var item in _filteredItems.OrderBy(i => i.SortOrder).ThenBy(i => i.StartTime))
                {
                    <MudPaper Elevation="0" Class="pa-3 border-solid border-1 mud-border-lines-default rounded-lg">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@item.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @FormatTime(item.StartTime) &ndash; @FormatTime(item.EndTime)
                                    @if (!string.IsNullOrEmpty(item.KindFullName))
                                    {
                                        <span> &middot; @item.KindFullName</span>
                                    }
                                </MudText>
                            </div>
                            @if (CanManage)
                            {
                                <div class="d-flex gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(item))"
                                                   aria-label="@($"Edit {item.Title}")" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteItem(item))"
                                                   aria-label="@($"Delete {item.Title}")" />
                                </div>
                            }
                        </div>
                    </MudPaper>
                }
            </MudStack>
        }
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public List<EventDayListDto> Days { get; set; } = new();
    [Parameter] public List<LocationRoomListDto> Rooms { get; set; } = new();
    [Parameter] public bool CanManage { get; set; } = true;

    private List<EventAgendaItemListDto> _allItems = new();
    private List<EventAgendaItemListDto> _filteredItems = new();
    private bool _isLoading;
    private Guid _selectedDayId = Guid.Empty;
    private EventDayListDto? _selectedDay;

    protected override async Task OnParametersSetAsync()
    {
        if (EventId != Guid.Empty)
        {
            await LoadItems();
        }
    }

    public async Task LoadItems()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = CanManage
                ? await AgendaItemService.GetManagedAgendaItemsByEventAsync(EventId)
                : await AgendaItemService.GetAgendaItemsByEventAsync(EventId);
            _allItems = result?.ToList() ?? new List<EventAgendaItemListDto>();
            ApplyDayFilter();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OnDaySelected(Guid dayId)
    {
        _selectedDayId = dayId;
        _selectedDay = dayId == Guid.Empty ? null : Days.FirstOrDefault(d => d.Id == dayId);
        ApplyDayFilter();
    }

    private void ApplyDayFilter()
    {
        if (_selectedDayId == Guid.Empty)
        {
            _filteredItems = _allItems;
        }
        else
        {
            var day = Days.FirstOrDefault(d => d.Id == _selectedDayId);
            if (day != null)
            {
                _filteredItems = _allItems
                    .Where(i => i.LocalStartDate == day.LocalDate)
                    .ToList();
            }
            else
            {
                _filteredItems = _allItems;
            }
        }
    }

    private string GetGridStyle()
    {
        var roomCount = Rooms.Count;
        // grid-template-columns: [time-axis] 60px [room1] 1fr [room2] 1fr ...
        return $"display: grid; grid-template-columns: 60px repeat({roomCount}, 1fr); gap: 2px;";
    }

    private List<TimeGroup> GetTimeGroups()
    {
        var groups = new List<TimeGroup>();
        var sortedItems = _filteredItems.OrderBy(i => i.StartTime).ToList();

        // Group items by their start time slot
        var timeSlots = sortedItems
            .GroupBy(i => i.LocalStartTime?.ToString(@"hh\:mm") ?? "--:--")
            .OrderBy(g => g.Key);

        foreach (var slot in timeSlots)
        {
            var group = new TimeGroup
            {
                TimeLabel = slot.Key,
                ItemsByRoom = new Dictionary<Guid, EventAgendaItemListDto>()
            };

            foreach (var item in slot)
            {
                // Place items in their assigned room column
                var roomId = item.Id; // Placeholder: items don't expose RoomId in list DTO currently
                // For now, place first item found per room
                // The list DTO doesn't have RoomId, so we use the full grid only when we can resolve rooms
            }

            // Simplified: just put items in order without room assignment from list DTO
            var roomsList = Rooms.OrderBy(r => r.SortOrder).ToList();
            var itemsList = slot.ToList();
            for (int i = 0; i < itemsList.Count && i < roomsList.Count; i++)
            {
                group.ItemsByRoom[roomsList[i].Id ?? Guid.Empty] = itemsList[i];
            }

            groups.Add(group);
        }

        return groups;
    }

    private static string FormatTime(DateTimeOffset? time) =>
        time?.ToString("HH:mm") ?? "--:--";

    private async Task OpenCreateDialog()
    {
        var nextSortOrder = _allItems.Count > 0 ? (_allItems.Max(i => i.SortOrder) ?? 0) + 1 : 1;
        var parameters = new DialogParameters<EventAgendaItemEditorDialog>
        {
            { x => x.EventId, EventId },
            { x => x.IsNew, true },
            { x => x.InitialSortOrder, nextSortOrder },
            { x => x.Days, Days },
            { x => x.Rooms, Rooms },
            { x => x.PreselectedDayId, _selectedDayId != Guid.Empty ? _selectedDayId : null }
        };

        var dialog = await DialogService.ShowAsync<EventAgendaItemEditorDialog>("Add Agenda Item", parameters, DialogOptionsFactory.Small());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadItems();
            Snackbar.Add("Agenda item added", Severity.Success);
        }
    }

    private async Task OpenEditDialog(EventAgendaItemListDto item)
    {
        var parameters = new DialogParameters<EventAgendaItemEditorDialog>
        {
            { x => x.EventId, EventId },
            { x => x.IsNew, false },
            { x => x.ItemId, item.Id },
            { x => x.InitialSortOrder, item.SortOrder ?? 0 },
            { x => x.Days, Days },
            { x => x.Rooms, Rooms }
        };

        var dialog = await DialogService.ShowAsync<EventAgendaItemEditorDialog>("Edit Agenda Item", parameters, DialogOptionsFactory.Small());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadItems();
            Snackbar.Add("Agenda item updated", Severity.Success);
        }
    }

    private async Task DeleteItem(EventAgendaItemListDto item)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Agenda Item",
            $"Are you sure you want to delete \"{item.Title}\"?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await AgendaItemService.DeleteAgendaItemAsync(item.Id ?? Guid.Empty);
            if (success)
            {
                await LoadItems();
                Snackbar.Add("Agenda item deleted", Severity.Info);
            }
            else
            {
                Snackbar.Add("Failed to delete agenda item", Severity.Error);
            }
        }
    }

    private record TimeGroup
    {
        public string TimeLabel { get; init; } = string.Empty;
        public Dictionary<Guid, EventAgendaItemListDto> ItemsByRoom { get; init; } = new();
    }
}
