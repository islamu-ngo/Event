@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Services
@inject IImageStorageService ImageStorageService
@inject ILogger<ImageUpload> Logger

<div class="image-upload" style="@($"width: {Width};")" aria-busy="@BusyState">
    <div class="@PreviewClass" style="@PreviewStyle">
        @if (!string.IsNullOrWhiteSpace(PreviewUrl))
        {
            <img src="@PreviewUrl" alt="@PreviewAlt" class="image-upload__image" />
        }
        else
        {
            <div class="image-upload__placeholder">
                <MudIcon Icon="@(Icon ?? Icons.Material.Filled.Image)" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(PlaceholderText ?? "No image selected")</MudText>
            </div>
        }

        @if (IsBusy)
        {
            <div class="image-upload__loading" role="status" aria-live="polite">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                <span class="sr-only">@_statusMessage</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div role="alert">
            <MudAlert Severity="Severity.Error"
                      Dense="true"
                      Class="image-upload__alert"
                      ShowCloseIcon="true"
                      CloseIconClicked="@(() => _errorMessage = null)">
                @_errorMessage
            </MudAlert>
        </div>
    }

    <div class="image-upload__actions">
        <MudFileUpload T="IBrowserFile"
                       @ref="_fileUpload"
                       FilesChanged="OnFileSelected"
                       Accept="@AcceptedFormats"
                       MaximumFileCount="1"
                       Disabled="@IsBusy">
            <CustomContent Context="fileUpload">
                <MudButton Elevation="0"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@IsBusy"
                           OnClick="@fileUpload.OpenFilePickerAsync">
                    @(UploadButtonText ?? "Select Image")
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (HasImage)
        {
            <MudButton Elevation="0"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Small"
                       Disabled="@IsBusy"
                       OnClick="RemoveImage">
                Remove
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(EffectiveHintText))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="image-upload__hint">
            @EffectiveHintText
        </MudText>
    }
</div>

@code {
    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public EventCallback<string?> PreviewUrlChanged { get; set; }
    [Parameter] public EventCallback<FileUploadData?> FileDataSelected { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "250px";
    [Parameter] public string? PlaceholderText { get; set; }
    [Parameter] public string? UploadButtonText { get; set; }
    [Parameter] public string? HintText { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string AcceptedFormats { get; set; } = ImageUploadClientPolicy.DefaultAcceptedImageFormats;
    [Parameter] public string[] AllowedContentTypes { get; set; } = ImageUploadClientPolicy.AllowedImageContentTypes;
    [Parameter] public long MaxFileSize { get; set; } = ImageUploadClientPolicy.DefaultMaxImageFileSizeBytes;
    [Parameter] public bool IsProcessing { get; set; }

    private MudFileUpload<IBrowserFile>? _fileUpload;
    private bool _isReadingFile;
    private string? _errorMessage;
    private string _statusMessage = "Processing selected image";

    private bool HasImage => !string.IsNullOrWhiteSpace(PreviewUrl);
    private bool IsBusy => _isReadingFile || IsProcessing;
    private string BusyState => IsBusy ? "true" : "false";
    private string PreviewAlt => string.IsNullOrWhiteSpace(Alt) ? "Image preview" : Alt;
    private string PreviewClass => HasImage
        ? "image-upload__preview image-upload__preview--has-image"
        : "image-upload__preview";
    private string PreviewStyle => $"height: {Height};";
    private string EffectiveHintText =>
        HintText ?? $"Supported formats: JPG, PNG, GIF, WebP. Max {ImageUploadClientPolicy.FormatBytes(MaxFileSize)}.";

    private async Task OnFileSelected(IBrowserFile? file)
    {
        _errorMessage = null;
        if (file is null || IsBusy)
        {
            return;
        }

        if (!IsAllowedContentType(file.ContentType))
        {
            _errorMessage = ImageUploadClientPolicy.UnsupportedImageTypeMessage;
            return;
        }

        if (file.Size > MaxFileSize)
        {
            _errorMessage = ImageUploadClientPolicy.FormatMaxFileSizeMessage(MaxFileSize);
            return;
        }

        _isReadingFile = true;
        _statusMessage = "Reading selected image";
        StateHasChanged();

        try
        {
            var fileData = await ImageStorageService.ReadFileAsync(file, MaxFileSize);
            if (fileData is null)
            {
                _errorMessage = ImageUploadClientPolicy.ReadFailureMessage;
                await RemoveImage();
                return;
            }

            _statusMessage = "Generating image preview";
            var localPreview = ImageStorageService.GenerateLocalPreviewFromBytes(fileData);
            if (!string.IsNullOrWhiteSpace(localPreview))
            {
                PreviewUrl = localPreview;
                await PreviewUrlChanged.InvokeAsync(localPreview);
            }
            else
            {
                _errorMessage = ImageUploadClientPolicy.PreviewFailureMessage;
            }

            if (FileDataSelected.HasDelegate)
            {
                _statusMessage = "Preparing image upload";
                await FileDataSelected.InvokeAsync(fileData);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                "Error processing selected image. FailureType={FailureType}, SizeBucket={SizeBucket}",
                ImageUploadClientPolicy.GetFailureType(ex),
                ImageUploadClientPolicy.GetSizeBucket(file.Size));
            _errorMessage = ImageUploadClientPolicy.ProcessingFailureMessage;
            await RemoveImage();
        }
        finally
        {
            _isReadingFile = false;
            _statusMessage = "Processing selected image";
            StateHasChanged();
        }
    }

    public async Task RemoveImage()
    {
        PreviewUrl = null;
        _errorMessage = null;
        await PreviewUrlChanged.InvokeAsync(null);

        if (FileDataSelected.HasDelegate)
        {
            await FileDataSelected.InvokeAsync(null);
        }

        if (_fileUpload is not null)
        {
            await _fileUpload.ClearAsync();
        }

        StateHasChanged();
    }

    private bool IsAllowedContentType(string? contentType) =>
        !string.IsNullOrWhiteSpace(contentType)
        && AllowedContentTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase);
}
