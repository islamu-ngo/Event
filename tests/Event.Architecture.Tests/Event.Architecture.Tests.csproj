<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
    <ProjectReference Include="..\..\src\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence\Explore.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.MySql\Explore.Persistence.Migrations.MySql.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.SqlServer\Explore.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Explore.Persistence.Migrations.Sqlite\Explore.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Explore.Infrastructure\Explore.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\..\src\Explore.Blazor.Client\Explore.Blazor.Client.csproj" />
    <ProjectReference Include="..\..\eng\tools\Explore.GeneratedContracts\Explore.GeneratedContracts.csproj" />
    <ProjectReference Include="..\..\eng\tools\Explore.AssuranceAudit\Explore.AssuranceAudit.csproj" />
    <ProjectReference Include="..\..\eng\configuration-manifest-schema\src\ISLAMU.ConfigurationManifest.SchemaGenerator\ISLAMU.ConfigurationManifest.SchemaGenerator.csproj" />
  </ItemGroup>

  <!-- The standalone test-project entry point needs the same ordering as a solution build. -->
  <Target Name="PrepareArchitectureContractInputs" BeforeTargets="AssignProjectConfiguration" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../../src/Explore.API/Explore.API.csproj" Targets="GetOpenApiContractInput" />
  </Target>

  <Target Name="EmbedArchitectureContractInputs" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../../src/Explore.Blazor.Client/Explore.Blazor.Client.csproj" Targets="GetGeneratedContractInputs">
      <Output TaskParameter="TargetOutputs" ItemName="ArchitectureContractInput" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(ArchitectureContractInput)">
        <LogicalName>GeneratedContracts.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
