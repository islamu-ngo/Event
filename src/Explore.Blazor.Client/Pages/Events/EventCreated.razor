@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Blazouter.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject IEventService EventService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject RouterStateService RouterState

<PageTitle>Event Created - Explore</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    @if (isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4">Loading event details...</MudText>
        </MudPaper>
    }
    else if (eventDetails != null)
    {
        <MudPaper Class="pa-8">
            <div class="text-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                        Color="Color.Success"
                        Size="Size.Large"
                        Style="font-size: 5rem;" />
                <MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Success" Class="mt-4">
                    Event Created Successfully!
                </MudText>
                <MudText Typo="Typo.body1" Class="mt-2 text-muted">
                    Your event has been created and is now visible in your events.
                </MudText>
            </div>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h5" Class="mb-4">Event Details</MudText>

            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Title</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.Title</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Summary</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.Description</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(eventDetails.Content))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">Content</MudText>
                        <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.Content</MudText>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Event Format</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.EventFormatFullName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Event Type</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.EventTypeFullName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Target Audience</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.AudienceGenderFullName, @eventDetails.AudienceAgeFullName</MudText>
                </MudItem>

                @if (TicketPriceSummaryFormatter.Format(eventDetails) is { } ticketPriceSummary)
                {
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">Price</MudText>
                        <MudText Typo="Typo.body1" Class="mb-3">@ticketPriceSummary</MudText>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Participation</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">
                        @(eventDetails.ParticipationConfiguration?.ParticipationHandlingModeName ?? "Not specified")
                    </MudText>
                </MudItem>

                @if (eventDetails.FirstSessionDate.HasValue)
                {
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">First Session</MudText>
                        <MudText Typo="Typo.body1" Class="mb-3">@eventDetails.FirstSessionDate.Value.ToString("g")</MudText>
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="my-4" />

            <div class="d-flex justify-content-between mt-6">
                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined"
                          OnClick="@(() => Navigation.NavigateTo("/events/create"))">
                    Create Another Event
                </MudButton>
                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Navigation.NavigateTo("/my/profile"))">
                    View Profile Posts
                </MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4">Event not found</MudText>
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4"
                      OnClick="@(() => Navigation.NavigateTo("/events"))">
                Go to Events
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private Guid EventId { get; set; }

    private EventDto? eventDetails;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Get route parameter from Blazouter
        var eventIdStr = RouterState.GetParam("eventId");
        if (Guid.TryParse(eventIdStr, out var id))
        {
            EventId = id;
        }

        try
        {
            isLoading = true;
            eventDetails = await EventService.GetEventByIdAsync(EventId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading event details: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
