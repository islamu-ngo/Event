{
  "$comment": "ABOUTME: JSON Schema for strict release-provider definition manifests.",
  "$comment2": "ABOUTME: Documents machine-readable adapter lanes, capabilities, guards, and diagnostics.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openislamu.org/schemas/release-provider-definition.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "displayName", "discoveryWorkflows", "publicationWorkflows", "actions", "previewLane", "finalLane", "capabilities", "guards", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "release-provider.v1" },
    "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "discoveryWorkflows": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "publicationWorkflows": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "previewLane": { "$ref": "#/$defs/lane" },
    "finalLane": { "$ref": "#/$defs/finalLane" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "retentionDays", "protectedRefCas", "releasePublication", "operatorEvidenceRequired"],
      "properties": {
        "artifacts": { "type": "boolean" },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "protectedRefCas": { "type": "boolean" },
        "releasePublication": { "type": "boolean" },
        "operatorEvidenceRequired": { "type": "boolean" }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableBundleVerification", "providerNeutralChecksumEquality", "metadataAuthoritative", "misleadingSuccessForbidden"],
      "properties": {
        "immutableBundleVerification": { "type": "boolean" },
        "providerNeutralChecksumEquality": { "type": "boolean" },
        "metadataAuthoritative": { "type": "boolean" },
        "misleadingSuccessForbidden": { "type": "boolean" }
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "trustedCodeOnly", "secrets", "permissions", "requiredChecks", "alwaysPresentNoop"],
      "properties": {
        "event": { "type": "string" },
        "trustedCodeOnly": { "type": "boolean" },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "requiredChecks": { "type": "array", "items": { "type": "string" } },
        "alwaysPresentNoop": { "type": "boolean" }
      }
    },
    "finalLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "trustedRef", "trustedCodeOnly", "environmentApproval", "requiresSelfHostedTrustedRunner", "requiredChecks", "alwaysPresentNoop", "candidateStopsBeforeFinal"],
      "properties": {
        "event": { "type": "string" },
        "trustedRef": { "enum": ["default-branch", "no-checkout-discovery"] },
        "trustedCodeOnly": { "type": "boolean" },
        "environmentApproval": { "type": "boolean" },
        "requiresSelfHostedTrustedRunner": { "type": "boolean" },
        "requiredChecks": { "type": "array", "items": { "type": "string" } },
        "alwaysPresentNoop": { "type": "boolean" },
        "candidateStopsBeforeFinal": { "type": "boolean" }
      }
    }
  }
}
