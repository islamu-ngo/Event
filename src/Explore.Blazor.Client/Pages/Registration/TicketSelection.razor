@* ABOUTME: Attendee ticket-selection entry page backed by the public checkout composition contract. *@
@* ABOUTME: Sends only selected quantities and prices to the server, which remains authoritative for totals. *@
@page "/registration/events/{EventId:guid}/tickets"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IRegistrationOrderService RegistrationOrderService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ITranslationService Translation

<PageTitle>Select tickets</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(_isSubmitting || HasPendingGuestStart)" OnBeforeInternalNavigation="GuardNavigation" />

<MudContainer MaxWidth="MaxWidth.Small" Class="ticket-selection">
    <MudText Typo="Typo.h4" HtmlTag="h1">Select tickets</MudText>

    @if (!_isLoading && _composition?.DirectoryOperator is { } directoryOperator)
    {
        <aside class="ticket-selection__directory-notice"
               role="note"
               aria-labelledby="directory-operator-heading"
               data-testid="ticket-selection-directory-operator">
            <MudText Id="directory-operator-heading" Typo="Typo.subtitle1" HtmlTag="h2">
                @T("ticketSelection.directoryOperator", "Directory operator")
            </MudText>
            <MudText Typo="Typo.body2">
                <bdi dir="auto">@directoryOperator.PublicName</bdi>
                <span class="ticket-selection__legal-name">(<bdi dir="auto">@directoryOperator.LegalName</bdi>)</span>
            </MudText>
            <MudText Typo="Typo.caption">
                <bdi dir="ltr" lang="en">@directoryOperator.JurisdictionCountryCode</bdi>
                @if (!string.IsNullOrWhiteSpace(directoryOperator.RegistrationIdentifier))
                {
                    <span dir="ltr" lang="en"> · @directoryOperator.RegistrationIdentifier</span>
                }
            </MudText>
            <div class="ticket-selection__directory-links">
                <a href="mailto:@directoryOperator.PublicContactEmail" dir="ltr">@T("ticketSelection.contact", "Contact")</a>
                <a href="@directoryOperator.LegalNoticeUrl" dir="ltr" rel="noopener">@T("ticketSelection.legalNotice", "Legal notice")</a>
                @if (!string.IsNullOrWhiteSpace(directoryOperator.TermsUrl))
                {
                    <a href="@directoryOperator.TermsUrl" dir="ltr" rel="noopener">@T("ticketSelection.terms", "Terms")</a>
                }
                <a href="@directoryOperator.PrivacyUrl" dir="ltr" rel="noopener">@T("ticketSelection.privacy", "Privacy")</a>
            </div>
        </aside>
    }

    @if (_isLoading)
    {
        <div role="status">Loading ticket choices…</div>
    }
    else if (_tickets.Count == 0 && !HasPendingGuestStart)
    {
        <div role="alert">Tickets are not available for this event.</div>
    }
    else if (HasPaidTickets && _composition?.DirectoryOperator is null && !HasPendingGuestStart)
    {
        <div role="alert"
             aria-live="assertive"
             data-testid="paid-checkout-identity-unavailable">
            @T("ticketSelection.identityUnavailable", "Paid tickets are unavailable because the directory operator identity could not be verified.")
        </div>
    }
    else
    {
        <fieldset class="ticket-selection__choices" disabled="@(_isSubmitting || HasPendingGuestStart)">
        <legend class="sr-only">Ticket quantities and prices</legend>
        @foreach (var state in _tickets)
        {
            <section class="ticket-selection__ticket" aria-label="@state.Ticket.Name">
                <MudText Typo="Typo.h6" HtmlTag="h2">@state.Ticket.Name</MudText>
                <MudText Typo="Typo.body2">@PriceLabel(state.Ticket, _composition?.CurrencyCode)</MudText>
                @if (state.Ticket.PerOrderLimit is { } perOrderLimit)
                {
                    <MudNumericField T="int" Label="Quantity" Min="0" Max="@perOrderLimit" @bind-Value="state.Quantity" />
                }
                else
                {
                    <MudNumericField T="int" Label="Quantity" Min="0" @bind-Value="state.Quantity" />
                }
                @if (AllowsChosenPrice(state.Ticket))
                {
                    @if (state.Ticket.SlidingScaleOptions is { Count: > 0 })
                    {
                        <MudSlider T="int"
                                   Min="0"
                                   Max="@(state.Ticket.SlidingScaleOptions.Count - 1)"
                                   Step="1"
                                   @bind-Value="state.SlidingScaleIndex"
                                   aria-label="@T("ticketSelection.slidingScale", "Choose sliding-scale price")"
                                   aria-valuetext="@SlidingScaleValueText(state)"
                                   aria-describedby="@state.MonetaryOutputId" />
                        <output id="@state.MonetaryOutputId" aria-live="off">
                            <MudText Typo="Typo.body2">@T("ticketSelection.youPay", "You pay") @RegistrationOrderMoneyFormatter.Format(state.SelectedSlidingScaleOption!.BuyerPriceMinor, _composition?.CurrencyCode)</MudText>
                            <MudText Typo="Typo.body2">@T("ticketSelection.organizerEarns", "Organizer earns") @RegistrationOrderMoneyFormatter.Format(state.SelectedSlidingScaleOption!.OrganizerEarningsMinor, _composition?.CurrencyCode)</MudText>
                        </output>
                    }
                    else
                    {
                        <MudNumericField T="long" Label="Price per ticket in minor units" Min="@(state.Ticket.MinimumPriceMinor ?? 0)" @bind-Value="state.ChosenUnitPriceMinor" />
                    }
                }
            </section>
        }
        </fieldset>

        @if (_error is not null)
        {
            <div role="alert">@_error</div>
        }

        <div class="ticket-selection__actions">
            <AppButton Disabled="@(_isSubmitting || RetryBlocked)"
                       OnClick="StartAsync"
                       aria-busy="@_isSubmitting.ToString().ToLowerInvariant()"
                       data-testid="ticket-reservation-action">
                @(_isSubmitting
                    ? T("ticketSelection.reserving", "Reserving selected tickets…")
                    : HasPendingGuestStart
                        ? T("ticketSelection.retryOriginal", "Retry original reservation")
                        : T("ticketSelection.reserve", "Reserve selected tickets"))
            </AppButton>
            @if (_isSubmitting && RegistrationOrderService.GuestStartPhase is GuestRegistrationStartPhase.Issuing or GuestRegistrationStartPhase.Solving)
            {
                <AppButton OnClick="CancelChallenge" data-testid="ticket-challenge-cancel">
                    @T("ticketSelection.cancelCheck", "Cancel browser check")
                </AppButton>
            }
        </div>
        <div role="status" aria-live="polite" aria-atomic="true" data-testid="ticket-challenge-status">
            @GuestStatus
        </div>
        @if (HasPendingGuestStart)
        {
            <p data-testid="ticket-reservation-uncertain">
                @T("ticketSelection.uncertain", "The reservation may already exist. Keep this page open. Retry checks the original request; it does not start a replacement. Do not reload or start another reservation.")
            </p>
        }
        @if (RegistrationOrderService.GuestStartPhase is GuestRegistrationStartPhase.Unavailable or GuestRegistrationStartPhase.Expired or GuestRegistrationStartPhase.RetryExhausted)
        {
            <p>@T("ticketSelection.assistedAlternative", "You can ask the event organizer for staff-assisted registration. Browser checks do not reserve tickets until the server accepts the request.")</p>
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }

    private RegistrationCheckoutCompositionDto? _composition;
    private readonly List<TicketState> _tickets = [];
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _error;
    private bool HasPaidTickets => _tickets.Any(state => IsPaidMode(state.Ticket.TicketPricingModeCode));
    private CancellationTokenSource? _submission;
    private Guid _loadedEventId;
    private bool HasPendingGuestStart => RegistrationOrderService.PendingGuestEventId.HasValue;
    private bool RetryBlocked => RegistrationOrderService.GuestStartPhase == GuestRegistrationStartPhase.RetryExhausted
        || (RegistrationOrderService.PendingGuestEventId is { } pending && pending != EventId);

    protected override void OnInitialized() => RegistrationOrderService.GuestStartChanged += GuestStartChanged;
    private void GuestStartChanged() => _ = InvokeAsync(StateHasChanged);
    private void CancelChallenge() => _submission?.Cancel();
    private void GuardNavigation(LocationChangingContext context)
    {
        if (_isSubmitting || HasPendingGuestStart) context.PreventNavigation();
    }
    public void Dispose()
    {
        RegistrationOrderService.GuestStartChanged -= GuestStartChanged;
        _submission?.Cancel();
        _submission?.Dispose();
    }

    private string? GuestStatus => RegistrationOrderService.GuestStartPhase switch
    {
        GuestRegistrationStartPhase.Issuing => T("ticketSelection.preparingCheck", "Preparing a private browser check. No tickets have been reserved."),
        GuestRegistrationStartPhase.Solving => $"{T("ticketSelection.browserCheck", "Checking this browser. You can cancel before reservation.")} {RegistrationOrderService.GuestProofAttempts:N0}",
        GuestRegistrationStartPhase.Submitting => T("ticketSelection.reservingStatus", "Reservation is in progress."),
        GuestRegistrationStartPhase.Cancelled => T("ticketSelection.checkCancelled", "Browser check cancelled. No reservation was sent."),
        GuestRegistrationStartPhase.Expired => T("ticketSelection.checkExpired", "The browser check expired before submission. Select Reserve to request a new check."),
        GuestRegistrationStartPhase.Unavailable => T("ticketSelection.checkUnavailable", "The browser check is unavailable. No reservation was sent. Try again explicitly or contact the organizer."),
        GuestRegistrationStartPhase.IntentChanged => T("ticketSelection.intentChanged", "The event or selection changed. An unresolved original reservation cannot be replaced."),
        GuestRegistrationStartPhase.RetryExhausted => T("ticketSelection.retryLimit", "The retry limit was reached. The original reservation is still unresolved; contact the organizer before making another."),
        _ => _isSubmitting ? T("ticketSelection.reservingStatus", "Reservation is in progress.") : null
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedEventId != EventId) _submission?.Cancel();
        _loadedEventId = EventId;
        _isLoading = true;
        _composition = await RegistrationOrderService.GetCheckoutAsync(EventId);
        _tickets.Clear();
        _tickets.AddRange((_composition?.TicketTypes ?? []).Where(ticket => ticket.Id.HasValue).Select(ticket => new TicketState(ticket)));
        _isLoading = false;
    }

    private async Task StartAsync()
    {
        if (_isSubmitting || RetryBlocked) return;
        if (HasPendingGuestStart)
        {
            _isSubmitting = true;
            _error = null;
            _submission?.Dispose();
            _submission = new CancellationTokenSource();
            try
            {
                var recovered = await RegistrationOrderService.RetryGuestAsync(EventId, _submission.Token);
                if (recovered?.Id is { } recoveredId)
                {
                    _isSubmitting = false;
                    Navigation.NavigateTo($"/registration/guest/events/{EventId}/orders/{recoveredId}");
                }
            }
            finally { _isSubmitting = false; }
            return;
        }
        var lines = _tickets
            .Where(state => state.Quantity > 0 && state.Ticket.Id.HasValue)
            .Select(state => new RegistrationOrderLineSelection
            {
                TicketTypeId = state.Ticket.Id!.Value,
                Quantity = state.Quantity,
                ChosenUnitPriceMinor = AllowsChosenPrice(state.Ticket) ? state.SelectedPriceMinor : null
            })
            .ToArray();
        if (_composition?.TicketCatalogVersionId is not { } catalogId || lines.Length == 0)
        {
            _error = "Select at least one ticket.";
            return;
        }

        _isSubmitting = true;
        _error = null;
        var request = new StartRegistrationOrderRequest
        {
            TicketCatalogVersionId = catalogId,
            BookingPartyType = 1,
            Lines = lines
        };
        _submission?.Dispose();
        _submission = new CancellationTokenSource();
        var eventId = EventId;
        try
        {
            var isAuthenticated = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
            _submission.Token.ThrowIfCancellationRequested();
            var orderId = isAuthenticated
                ? (await RegistrationOrderService.StartAuthenticatedAsync(eventId, request, _submission.Token))?.Id
                : (await RegistrationOrderService.StartGuestAsync(eventId, request, _submission.Token))?.Id;

            if (orderId is null)
            {
                if (isAuthenticated) _error = "The registration order could not be started.";
                return;
            }
            _isSubmitting = false;
            Navigation.NavigateTo(isAuthenticated
                ? $"/registration/events/{eventId}/orders/{orderId}"
                : $"/registration/guest/events/{eventId}/orders/{orderId}");
        }
        catch (OperationCanceledException)
        {
            _error = T("ticketSelection.requestInterrupted", "The request was interrupted. A submitted reservation may still exist.");
        }
        finally { _isSubmitting = false; }
    }

    private static bool AllowsChosenPrice(RegistrationCheckoutTicketTypeDto ticket) =>
        ticket.TicketPricingModeCode is "DONATION" or "PAY_WHAT_YOU_CAN" or "SLIDING_SCALE";

    private static bool IsPaidMode(string? mode) =>
        mode is "FIXED" or "DONATION" or "PAY_WHAT_YOU_CAN" or "SLIDING_SCALE";

    private string SlidingScaleValueText(TicketState state) =>
        $"{T("ticketSelection.youPay", "You pay")} {RegistrationOrderMoneyFormatter.Format(state.SelectedSlidingScaleOption!.BuyerPriceMinor, _composition?.CurrencyCode)}; " +
        $"{T("ticketSelection.organizerEarns", "Organizer earns")} {RegistrationOrderMoneyFormatter.Format(state.SelectedSlidingScaleOption.OrganizerEarningsMinor, _composition?.CurrencyCode)}";

    private string T(string key, string fallback) => Translation.T(key, fallback);

    private static string PriceLabel(RegistrationCheckoutTicketTypeDto ticket, string? currencyCode) => ticket.TicketPricingModeCode switch
    {
        "FREE" => "Free",
        "FIXED" => RegistrationOrderMoneyFormatter.Format(ticket.FixedPriceMinor, currencyCode),
        _ => $"Minimum {RegistrationOrderMoneyFormatter.Format(ticket.MinimumPriceMinor, currencyCode)}"
    };

    private sealed class TicketState(RegistrationCheckoutTicketTypeDto ticket)
    {
        public RegistrationCheckoutTicketTypeDto Ticket { get; } = ticket;
        public int Quantity { get; set; }
        public long ChosenUnitPriceMinor { get; set; } = ticket.SuggestedPriceMinor ?? ticket.MinimumPriceMinor ?? 0;
        public int SlidingScaleIndex { get; set; } = Math.Max(0, (ticket.SlidingScaleOptions?.Count ?? 1) - 1);
        public string MonetaryOutputId { get; } = $"sliding-scale-output-{Guid.NewGuid():N}";
        public RegistrationCheckoutSlidingScaleOptionDto? SelectedSlidingScaleOption =>
            Ticket.SlidingScaleOptions is { Count: > 0 } options ? options.ElementAt(Math.Min(SlidingScaleIndex, options.Count - 1)) : null;
        public long SelectedPriceMinor => SelectedSlidingScaleOption?.BuyerPriceMinor ?? ChosenUnitPriceMinor;
    }
}
