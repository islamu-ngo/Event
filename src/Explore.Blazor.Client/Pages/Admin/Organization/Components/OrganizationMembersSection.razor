@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Pages.Organizations
@using Explore.Blazor.Client.Pages.Organizations.Dialogs
@inject IOrganizationMemberService MemberService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Members</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            People who belong to this organization.
        </MudText>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
            @_errorMessage
        </MudAlert>
    }

    @if (_canCreateMembers)
    {
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenInviteDialog">
                Invite Member
            </MudButton>
        </MudStack>
    }

    @if (!_members.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            No members found for this organization.
        </MudAlert>
    }
    else
    {
        <MudTable Items="_members" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Member</MudTh>
                <MudTh>Role</MudTh>
                @if (HasAnyMemberActions)
                {
                    <MudTh Style="text-align:right">Actions</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Member">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                            @GetInitial(context)
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @(context.UserFullName ?? context.UserEmail ?? "Unknown")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(context.OrganizationPositionFullName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @context.OrganizationPositionFullName
                                </MudText>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string"
                             Color="@RoleHelper.GetRoleColor(context.RoleId)"
                             Size="Size.Small"
                             Variant="Variant.Filled">
                        @RoleHelper.GetRoleName(context.RoleId)
                    </MudChip>
                </MudTd>
                @if (HasAnyMemberActions)
                {
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        @if (CanEditMember(context) || CanDeleteMember(context))
                        {
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     Dense="true"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">
                                @if (CanEditMember(context))
                                {
                                    <MudMenuItem OnClick="@(() => OpenEditRoleDialog(context))" Icon="@Icons.Material.Filled.Edit">Change Role</MudMenuItem>
                                }
                                @if (CanDeleteMember(context))
                                {
                                    <MudMenuItem OnClick="@(() => RemoveMember(context))" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Remove</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.People"
                       OnClick="NavigateToMembers">
                Open Full Members Page
            </MudButton>
        </MudStack>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid OrganizationId { get; set; }

    private List<OrganizationMemberDto> _members = new();
    private bool _loading = true;
    private bool _canCreateMembers;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private static string GetInitial(OrganizationMemberDto member)
    {
        var name = member.UserFullName ?? member.UserEmail;
        return string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
    }

    private bool HasAnyMemberActions => _members.Any(member => CanEditMember(member) || CanDeleteMember(member));

    private static bool CanEditMember(OrganizationMemberDto member)
    {
        return member.HasHalLink("edit");
    }

    private bool CanDeleteMember(OrganizationMemberDto member)
    {
        return member.HasHalLink("delete");
    }

    private async Task LoadMembers()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var result = await MemberService.GetMembersWithAffordancesAsync(OrganizationId);
            _members = result.Members.ToList();
            _canCreateMembers = result.CanCreate;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load members: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenInviteDialog()
    {
        if (!_canCreateMembers)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["OrganizationId"] = OrganizationId
        };
        var dialog = await InviteMemberDialog.ShowAsync(DialogService, "Invite Member", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Member invited.", Severity.Success);
            await LoadMembers();
        }
    }

    private async Task OpenEditRoleDialog(OrganizationMemberDto member)
    {
        if (!CanEditMember(member))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Member"] = member,
            ["OrganizationId"] = OrganizationId
        };
        var dialog = await EditMemberRoleDialog.ShowAsync(DialogService, "Change Role", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Member role updated.", Severity.Success);
            await LoadMembers();
        }
    }

    private async Task RemoveMember(OrganizationMemberDto member)
    {
        if (!CanDeleteMember(member) || !member.Id.HasValue)
        {
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Remove Member",
            $"Are you sure you want to remove {member.UserEmail ?? member.UserFullName ?? "this member"}?",
            yesText: "Remove",
            cancelText: "Cancel");

        if (result != true)
        {
            return;
        }

        try
        {
            await MemberService.DeleteMemberAsync(member.Id.Value);
            Snackbar.Add("Member removed.", Severity.Success);
            await LoadMembers();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to remove member: {ex.Message}";
        }
    }

    private void NavigateToMembers()
    {
        Navigation.NavigateTo($"/organization/{OrganizationId}/members");
    }
}
