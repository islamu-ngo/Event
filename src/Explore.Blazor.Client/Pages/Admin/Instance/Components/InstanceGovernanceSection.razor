    }

    private Task OnAllowGroupSelfRegistrationChangedAsync(bool value)
    {
        OrganizationPolicy.AllowGroupSelfRegistration = value;
        return SaveSettingsAsync(
            () => SaveOrganizationPolicyAsync(new OrganizationPolicyDto { AllowGroupSelfRegistration = value }),
            "Organization policy");
    }

    private Task OnDefaultPublicHomePageChangedAsync(string value)
    {
        Delegation.DefaultPublicHomePage = value;
        return SaveSettingsAsync(
            () => SaveDelegationAsync(new TenantDelegationSettingsDto { DefaultPublicHomePage = value }),
            "Governance settings");
    }

    private Task OnLockTenantHomePagePreferenceChangedAsync(bool value)
    {
        Delegation.LockTenantHomePagePreference = value;
        return SaveSettingsAsync(
            () => SaveDelegationAsync(new TenantDelegationSettingsDto { LockTenantHomePagePreference = value }),
            "Governance settings");
    }

    private Task OnMcpEnabledChangedAsync(bool value)
    {
        Mcp.Enabled = value;
        return SaveSettingsAsync(() => SaveMcpAsync(new McpGovernanceSettingsDto { Enabled = value }), "MCP settings");
    }

    private Task OnMcpLegacySseChangedAsync(bool value)
    {
        Mcp.EnableLegacySse = value;
        return SaveSettingsAsync(() => SaveMcpAsync(new McpGovernanceSettingsDto { EnableLegacySse = value }), "MCP settings");
    }

    private Task OnLockTenantMcpChangedAsync(bool value)
    {
        Mcp.LockTenantMcp = value;
        return SaveSettingsAsync(() => SaveMcpAsync(new McpGovernanceSettingsDto { LockTenantMcp = value }), "MCP settings");
