@using Explore.Blazor.Client.Contracts.ControlPlane
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Routing.ControlPlane
@using Explore.Blazor.Client.Contracts.Services.ControlPlane
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@inject IControlPlaneTenantService TenantService
@inject IAccessibilityFocusService AccessibilityFocusService

<section class="settings-section instance-tenants" aria-labelledby="instance-tenants-title">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" HtmlTag="h2" id="instance-tenants-title">Tenant lifecycle</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" dir="auto">
            Review tenants and run only lifecycle actions authorized by the control-plane API.
        </MudText>
        @if (CanCreateTenant)
        {
            <AppButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsBusy"
                       id="instance-tenants-create-trigger"
                       aria-label="Create tenant" OnClick="StartCreateAsync">Create tenant</AppButton>
        }
    </div>

    @if (_loading)
    {
        <div class="instance-tenants__loading" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <span>Loading tenants...</span>
        </div>
    }
    else if (_tenants is null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@ProblemMessage</MudAlert>
    }
    else if (TenantItems.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No tenants were returned by the control-plane API.</MudAlert>
    }
    else
    {
        <div class="instance-tenants__table">
            <MudTable Items="TenantItems" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Slug</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@TenantName(context)</MudTd>
                    <MudTd DataLabel="Slug"><code>@context.Slug</code></MudTd>
                    <MudTd DataLabel="Status">@TenantStatus(context)</MudTd>
                    <MudTd DataLabel="Actions">
                        <div id="@TenantActionTargetId(TenantId(context))"
                             class="instance-tenants__action-focus-target"
                             role="group"
                             tabindex="-1"
                             aria-label="@($"Tenant lifecycle controls for {TenantName(context)}")">
                            @if (HasTenantAction(context))
                            {
                                <div class="instance-tenants__actions">
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.Configuration))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined"
                                               Href="@TenantConfigurationHref(TenantId(context))"
                                               aria-label="@($"Configure {TenantName(context)}")">Configure</AppButton>
                                }
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.Activate))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy"
                                               aria-label="@($"Activate {TenantName(context)}")"
                                               OnClick="@(() => RunTenantCommandAsync(context, ControlPlaneLinkRelations.Activate))">Activate</AppButton>
                                }
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.Suspend))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy"
                                               aria-label="@($"Suspend {TenantName(context)}")"
                                               OnClick="@(() => StartReasonConfirmation(context, ControlPlaneLinkRelations.Suspend))">Suspend</AppButton>
                                }
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.Archive))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy"
                                               aria-label="@($"Archive {TenantName(context)}")"
                                               OnClick="@(() => StartReasonConfirmation(context, ControlPlaneLinkRelations.Archive))">Archive</AppButton>
                                }
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.Reactivate))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy"
                                               aria-label="@($"Reactivate {TenantName(context)}")"
                                               OnClick="@(() => RunTenantCommandAsync(context, ControlPlaneLinkRelations.Reactivate))">Reactivate</AppButton>
                                }
                                @if (ControlPlaneHal.HasLink(context._links, ControlPlaneLinkRelations.SchedulePurge))
                                {
                                    <AppButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@IsBusy"
                                               aria-label="@($"Schedule purge for {TenantName(context)}")"
                                               OnClick="@(() => StartPurgeConfirmation(context))">Schedule purge</AppButton>
                                }
                                </div>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <p class="instance-tenants__count" dir="auto">@TenantCountLabel</p>
    }

    @if (_showCreate)
    {
        <section class="instance-tenants__confirmation" role="region" aria-labelledby="instance-tenants-create-title">
            <h3 id="instance-tenants-create-title">Create tenant</h3>
            <p>The tenant will begin in provisioning status.</p>

            <label for="instance-tenants-create-name">Tenant name</label>
            <input id="instance-tenants-create-name"
                   aria-label="Tenant name"
                   autocomplete="organization"
                   maxlength="500"
                   required
                   @bind="_createName"
                   disabled="@IsBusy" />

            <label for="instance-tenants-create-slug">Tenant slug</label>
            <input id="instance-tenants-create-slug"
                   aria-label="Tenant slug"
                   autocomplete="off"
                   maxlength="500"
                   pattern="[a-z0-9-]+"
                   required
                   @bind="_createSlug"
                   disabled="@IsBusy" />

            <div class="instance-tenants__checkbox">
                <input id="instance-tenants-create-assign-self"
                       type="checkbox"
                       aria-label="Assign me as administrator of this tenant"
                       @bind="_assignCurrentUserAsTenantAdmin"
                       disabled="@IsBusy" />
                <label for="instance-tenants-create-assign-self">Assign me as administrator of this tenant</label>
            </div>

            <div class="instance-tenants__actions">
                <AppButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSubmitCreate || IsBusy)"
                           aria-label="Submit tenant creation" OnClick="SubmitCreateAsync">Create tenant</AppButton>
                <AppButton Variant="Variant.Text" Disabled="@IsBusy" aria-label="Cancel tenant creation"
                           OnClick="CancelCreateAsync">Cancel</AppButton>
            </div>
        </section>
    }

    @if (_reasonTenant is not null && _reasonRelation is not null)
    {
        <section class="instance-tenants__confirmation" role="region" aria-labelledby="instance-tenants-reason-title">
            <h3 id="instance-tenants-reason-title">Confirm tenant @ReasonActionLabel</h3>
            <p>Provide an operator reason before changing <strong>@TenantName(_reasonTenant)</strong>.</p>

            <label for="instance-tenants-lifecycle-reason">Operator reason</label>
            <input id="instance-tenants-lifecycle-reason"
                   aria-label="Lifecycle reason"
                   autocomplete="off"
                   @bind="_lifecycleReason"
                   disabled="@IsBusy" />

            <div class="instance-tenants__actions">
                <AppButton Variant="Variant.Filled" Disabled="@(!CanConfirmReason || IsBusy)"
                           aria-label="@($"Confirm {ReasonActionLabel} for {TenantName(_reasonTenant)}")"
                           OnClick="ConfirmReasonTransitionAsync">Confirm @ReasonActionLabel</AppButton>
                <AppButton Variant="Variant.Text" Disabled="@IsBusy" aria-label="Cancel tenant lifecycle action"
                           OnClick="CancelReasonConfirmationAsync">Cancel</AppButton>
            </div>
        </section>
    }

    @if (_purgeTenant is not null)
    {
        <section class="instance-tenants__confirmation instance-tenants__purge" role="region" aria-labelledby="instance-tenants-purge-title">
            <h3 id="instance-tenants-purge-title">Confirm tenant purge</h3>
            <p>Type <code>@_purgeTenant.Slug</code> exactly and provide an operator reason.</p>

            <label for="instance-tenants-purge-reason">Operator reason</label>
            <input id="instance-tenants-purge-reason"
                   aria-label="Purge reason"
                   autocomplete="off"
                   @bind="_purgeReason"
                   disabled="@IsBusy" />

            <label for="instance-tenants-purge-confirmation">Tenant slug confirmation</label>
            <input id="instance-tenants-purge-confirmation"
                   aria-label="Purge confirmation"
                   autocomplete="off"
                   @bind="_purgeConfirmation"
                   disabled="@IsBusy" />

            <div class="instance-tenants__actions">
                <AppButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!CanConfirmPurge || IsBusy)"
                           aria-label="@($"Confirm purge for {TenantName(_purgeTenant)}")"
                           OnClick="ConfirmPurgeAsync">Confirm purge</AppButton>
                <AppButton Variant="Variant.Text" Disabled="@IsBusy" aria-label="Cancel tenant purge"
                           OnClick="CancelPurgeConfirmationAsync">Cancel</AppButton>
            </div>
        </section>
    }

    @if (_commandMessage is not null)
    {
        <MudAlert Severity="@(_commandSucceeded ? Severity.Success : Severity.Error)"
                  role="@(_commandSucceeded ? "status" : "alert")"
                  aria-live="@(_commandSucceeded ? "polite" : "assertive")">
            @_commandMessage
        </MudAlert>
    }
</section>

@code {
    [Parameter] public int TenantCount { get; set; }
    [Parameter] public EventCallback<int> TenantCountChanged { get; set; }

    private HalCollectionResourceOfControlPlaneTenantListItemDto? _tenants;
    private bool _loading = true;
    private Guid? _busyTenantId;
    private bool _isCreating;
    private bool _showCreate;
    private string? _createName;
    private string? _createSlug;
    private bool _assignCurrentUserAsTenantAdmin;
    private HalResourceOfControlPlaneTenantListItemDto? _reasonTenant;
    private string? _reasonRelation;
    private string? _lifecycleReason;
    private HalResourceOfControlPlaneTenantListItemDto? _purgeTenant;
    private string? _purgeReason;
    private string? _purgeConfirmation;
    private string? _commandMessage;
    private string? _pendingFocusElementId;
    private bool _commandSucceeded;

    private IReadOnlyList<HalResourceOfControlPlaneTenantListItemDto> TenantItems => _tenants?._embedded?.Items?.ToArray() ?? [];
    private bool CanCreateTenant => ControlPlaneHal.HasLink(_tenants?._links, ControlPlaneLinkRelations.Create);
    private bool IsBusy => _busyTenantId is not null || _isCreating;
    private bool CanSubmitCreate => IsValidName(_createName) && IsValidSlug(_createSlug);
    private bool CanConfirmReason => _reasonTenant is not null
        && _reasonRelation is not null
        && !string.IsNullOrWhiteSpace(_lifecycleReason);
    private bool CanConfirmPurge => _purgeTenant is not null
        && !string.IsNullOrWhiteSpace(_purgeTenant.Slug)
        && !string.IsNullOrWhiteSpace(_purgeReason)
        && string.Equals(_purgeConfirmation, _purgeTenant.Slug, StringComparison.Ordinal);
    private string ReasonActionLabel => _reasonRelation == ControlPlaneLinkRelations.Suspend ? "suspend" : "archive";
    private const string ProblemMessage = "Tenant data is currently unavailable.";
    private int TotalTenantCount => _tenants?.TotalCount ?? TenantItems.Count;
    private string TenantCountLabel => TotalTenantCount == 1 ? "1 tenant total" : $"{TotalTenantCount} tenants total";

    protected override Task OnInitializedAsync() => LoadTenantsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusElementId is null)
        {
            return;
        }

        var elementId = _pendingFocusElementId;
        _pendingFocusElementId = null;
        await AccessibilityFocusService.FocusByIdAsync(elementId);
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            _tenants = await TenantService.GetTenantsAsync();
            await TenantCountChanged.InvokeAsync(TotalTenantCount);
        }
        catch (Exception)
        {
            _tenants = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunTenantCommandAsync(HalResourceOfControlPlaneTenantListItemDto tenant, string relation)
    {
        var tenantId = TenantId(tenant);
        var fallbackSelector = TenantActionTargetSelector(tenantId);
        await AccessibilityFocusService.SaveFocusAsync();
        _busyTenantId = tenantId;
        _commandMessage = null;

        try
        {
            var result = relation switch
            {
                ControlPlaneLinkRelations.Activate => await TenantService.ActivateTenantAsync(tenantId),
                ControlPlaneLinkRelations.Reactivate => await TenantService.ReactivateTenantAsync(tenantId),
                _ => new BaseCommandResponseOfControlPlaneTenantLifecycleTransitionDto
                {
                    Success = false,
                    Message = "This tenant action is not supported.",
                    FailureCode = "control_plane_action_not_supported"
                }
            };

            await ApplyCommandResultAsync(result.Success, result.Message);

            if (result.Success == true)
            {
                await AccessibilityFocusService.RestoreFocusAsync(fallbackSelector);
            }
        }
        catch (Exception)
        {
            SetCommandFailure();
        }
        finally
        {
            _busyTenantId = null;
        }
    }

    private async Task StartCreateAsync()
    {
        await AccessibilityFocusService.SaveFocusAsync();
        ClearReasonConfirmation();
        ClearPurgeConfirmation();
        _showCreate = true;
        _createName = null;
        _createSlug = null;
        _assignCurrentUserAsTenantAdmin = false;
        _commandMessage = null;
        _pendingFocusElementId = "instance-tenants-create-name";
    }

    private async Task CancelCreateAsync()
    {
        ClearCreate();
        await AccessibilityFocusService.RestoreFocusAsync("#instance-tenants-create-trigger");
    }

    private void ClearCreate()
    {
        _showCreate = false;
        _createName = null;
        _createSlug = null;
        _assignCurrentUserAsTenantAdmin = false;
    }

    private async Task SubmitCreateAsync()
    {
        if (!CanSubmitCreate)
        {
            return;
        }

        _isCreating = true;
        _commandMessage = null;

        try
        {
            var result = await TenantService.CreateTenantAsync(new CreateTenantDto
            {
                FullName = _createName!.Trim(),
                Slug = _createSlug!.Trim(),
                IsActive = false,
                AssignCurrentUserAsTenantAdmin = _assignCurrentUserAsTenantAdmin
            });

            if (result.Success == true)
            {
                ClearCreate();
            }

            await ApplyCommandResultAsync(result.Success, result.Message);

            if (result.Success == true)
            {
                await AccessibilityFocusService.RestoreFocusAsync("#instance-tenants-create-trigger");
            }
        }
        catch (Exception)
        {
            SetCommandFailure();
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task StartReasonConfirmation(HalResourceOfControlPlaneTenantListItemDto tenant, string relation)
    {
        await AccessibilityFocusService.SaveFocusAsync();
        ClearCreate();
        ClearPurgeConfirmation();
        _reasonTenant = tenant;
        _reasonRelation = relation;
        _lifecycleReason = null;
        _commandMessage = null;
        _pendingFocusElementId = "instance-tenants-lifecycle-reason";
    }

    private async Task CancelReasonConfirmationAsync()
    {
        var fallbackSelector = _reasonTenant is null
            ? null
            : TenantActionTargetSelector(TenantId(_reasonTenant));
        ClearReasonConfirmation();
        await AccessibilityFocusService.RestoreFocusAsync(fallbackSelector);
    }

    private void ClearReasonConfirmation()
    {
        _reasonTenant = null;
        _reasonRelation = null;
        _lifecycleReason = null;
    }

    private async Task ConfirmReasonTransitionAsync()
    {
        if (!CanConfirmReason || _reasonTenant is null || _reasonRelation is null)
        {
            return;
        }

        var tenantId = TenantId(_reasonTenant);
        _busyTenantId = tenantId;
        _commandMessage = null;

        try
        {
            var reason = _lifecycleReason!.Trim();
            var result = _reasonRelation switch
            {
                ControlPlaneLinkRelations.Suspend => await TenantService.SuspendTenantAsync(tenantId, reason),
                ControlPlaneLinkRelations.Archive => await TenantService.ArchiveTenantAsync(tenantId, reason),
                _ => new BaseCommandResponseOfControlPlaneTenantLifecycleTransitionDto
                {
                    Success = false,
                    Message = "This tenant action is not supported.",
                    FailureCode = "control_plane_action_not_supported"
                }
            };

            if (result.Success == true)
            {
                ClearReasonConfirmation();
            }

            await ApplyCommandResultAsync(result.Success, result.Message);

            if (result.Success == true)
            {
                await AccessibilityFocusService.RestoreFocusAsync(TenantActionTargetSelector(tenantId));
            }
        }
        catch (Exception)
        {
            SetCommandFailure();
        }
        finally
        {
            _busyTenantId = null;
        }
    }

    private async Task StartPurgeConfirmation(HalResourceOfControlPlaneTenantListItemDto tenant)
    {
        await AccessibilityFocusService.SaveFocusAsync();
        ClearCreate();
        ClearReasonConfirmation();
        _purgeTenant = tenant;
        _purgeReason = null;
        _purgeConfirmation = null;
        _commandMessage = null;
        _pendingFocusElementId = "instance-tenants-purge-reason";
    }

    private async Task CancelPurgeConfirmationAsync()
    {
        var fallbackSelector = _purgeTenant is null
            ? null
            : TenantActionTargetSelector(TenantId(_purgeTenant));
        ClearPurgeConfirmation();
        await AccessibilityFocusService.RestoreFocusAsync(fallbackSelector);
    }

    private void ClearPurgeConfirmation()
    {
        _purgeTenant = null;
        _purgeReason = null;
        _purgeConfirmation = null;
    }

    private async Task ConfirmPurgeAsync()
    {
        if (!CanConfirmPurge || _purgeTenant is null)
        {
            return;
        }

        var tenantId = TenantId(_purgeTenant);
        _busyTenantId = tenantId;
        _commandMessage = null;

        try
        {
            var result = await TenantService.ScheduleTenantPurgeAsync(
                tenantId,
                _purgeReason!.Trim(),
                _purgeConfirmation!);

            if (result.Success == true)
            {
                ClearPurgeConfirmation();
            }

            await ApplyCommandResultAsync(result.Success, result.Message);

            if (result.Success == true)
            {
                await AccessibilityFocusService.RestoreFocusAsync(TenantActionTargetSelector(tenantId));
            }
        }
        catch (Exception)
        {
            SetCommandFailure();
        }
        finally
        {
            _busyTenantId = null;
        }
    }

    private async Task ApplyCommandResultAsync(bool? success, string? message)
    {
        _commandSucceeded = success == true;
        _commandMessage = message ?? (_commandSucceeded ? "Tenant updated." : "The tenant action could not be completed.");

        if (_commandSucceeded)
        {
            await LoadTenantsAsync();
        }
    }

    private void SetCommandFailure()
    {
        _commandSucceeded = false;
        _commandMessage = "The tenant action could not be completed.";
    }

    private static bool IsValidName(string? name)
    {
        var value = name?.Trim();
        return !string.IsNullOrEmpty(value) && value.Length <= 500;
    }

    private static bool IsValidSlug(string? slug)
    {
        var value = slug?.Trim();
        return !string.IsNullOrEmpty(value)
            && value.Length <= 500
            && value.All(character => char.IsAsciiLetterLower(character) || char.IsAsciiDigit(character) || character == '-');
    }

    private static bool HasTenantAction(HalResourceOfControlPlaneTenantListItemDto tenant) =>
        ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.Configuration)
        || ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.Activate)
        || ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.Suspend)
        || ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.Archive)
        || ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.Reactivate)
        || ControlPlaneHal.HasLink(tenant._links, ControlPlaneLinkRelations.SchedulePurge);

    private static Guid TenantId(HalResourceOfControlPlaneTenantListItemDto tenant) => tenant.Id ?? Guid.Empty;

    private static string TenantName(HalResourceOfControlPlaneTenantListItemDto tenant) =>
        string.IsNullOrWhiteSpace(tenant.FullName) ? tenant.Slug ?? "Unnamed tenant" : tenant.FullName;

    private static string TenantStatus(HalResourceOfControlPlaneTenantListItemDto tenant) =>
        tenant.StatusName ?? tenant.StatusCode ?? "Unknown";

    private static string TenantActionTargetId(Guid tenantId) => $"instance-tenants-actions-{tenantId:N}";

    private static string TenantActionTargetSelector(Guid tenantId) => $"#{TenantActionTargetId(tenantId)}";

    private static string TenantConfigurationHref(Guid tenantId) =>
        ControlPlaneRoutes.TenantConfiguration.Replace("{TenantId}", tenantId.ToString(), StringComparison.Ordinal);
}
