@page "/startup"
@using Explore.Blazor.Client.Routing.ControlPlane
@using MudBlazor
@inject IStartupRoutingService StartupRoutingService
@inject NavigationManager Navigation
@inject ILogger<StartupGate> Logger
@rendermode InteractiveServer

<PageTitle>Startup Routing</PageTitle>

<MudText Typo="Typo.h1" HtmlTag="h1" Class="sr-only">Startup Routing</MudText>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div role="alert">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_error
            </MudAlert>
        </div>
    }
    else
    {
        <MudPaper Class="pa-6" role="status">
            <MudStack Spacing="3">
                <MudText Typo="Typo.body1">Determining the safe startup destination.</MudText>
                <MudSkeleton Width="60%" Height="32px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="20px" />
                <MudSkeleton Width="80%" Height="20px" Class="mb-4" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" />
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ResolveStartupRouteAsync();
    }

    private async Task ResolveStartupRouteAsync()
    {
        try
        {
            var decision = await StartupRoutingService.GetRootDecisionAsync();
            switch (decision)
            {
                case StartupRouteDecision.Setup:
                    Navigation.NavigateTo("/setup");
                    return;
                case StartupRouteDecision.KeycloakChallenge:
                    NavigateToProviderChallenge("keycloak");
                    return;
                case StartupRouteDecision.AtprotoChallenge:
                    NavigateToProviderChallenge("atproto");
                    return;
                case StartupRouteDecision.InstanceAdmin:
                    Navigation.NavigateTo(ControlPlaneRoutes.Overview);
                    return;
                case StartupRouteDecision.PublicLanding:
                    Navigation.NavigateTo("/home");
                    return;
                case StartupRouteDecision.PublicHome:
                    Navigation.NavigateTo("/events");
                    return;
                case StartupRouteDecision.Unavailable:
                default:
                    _error = "Could not determine a safe startup destination. Try refreshing.";
                    return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Startup routing failed.");
            _error = "Startup routing failed. Try refreshing.";
        }
    }

    private void NavigateToProviderChallenge(string provider)
    {
        Navigation.NavigateTo(
            $"/auth/challenge?provider={provider}&returnUrl={Uri.EscapeDataString("/startup")}",
            forceLoad: true);
    }
}
