@* ABOUTME: Guest registration-order recovery page using only the opaque in-memory capability header. *@
@* ABOUTME: Uses server lifecycle responses and DTO contribution options without locally calculating amounts. *@
@page "/registration/guest/events/{EventId:guid}/orders/{OrderId:guid}"
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Components.Registration.FormRenderer
@using Explore.Blazor.Client.Components.Registration
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@rendermode InteractiveServer
@inject IRegistrationOrderService RegistrationOrderService
@inject IRegistrationPaymentService RegistrationPaymentService
@inject IGuestRegistrationOrderCapabilityStore CapabilityStore
@inject IAccessibilityAnnouncerService Announcer
@inject IAccessibilityFocusService Focus
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Guest registration order</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="guest-order-recovery">
    <MudText Typo="Typo.h4" HtmlTag="h1">Guest registration order</MudText>

    @if (_isLoading)
    {
        <div class="guest-order-recovery__state" role="status">Loading your registration order…</div>
    }
    else if (_order is null)
    {
        <div class="guest-order-recovery__state" role="alert">@(_error ?? "This registration order is unavailable.")</div>
    }
    else
    {
        <section class="guest-order-recovery__summary" aria-labelledby="guest-order-status">
            <MudText Id="guest-order-status" Typo="Typo.h5" HtmlTag="h2">@(_order.StatusName ?? _order.StatusCode ?? "Status unavailable")</MudText>
            <MudText Typo="Typo.body1">@RegistrationOrderRecovery.Guidance(_order.StatusCode)</MudText>
            @if (RegistrationOrderRecovery.Countdown(_order.ExpiresAt, DateTimeOffset.UtcNow) is { } countdown)
            {
                <MudText Typo="Typo.body2" role="status">@countdown</MudText>
            }
        </section>

        <TicketPurchaseGovernancePanel EventId="EventId"
                                       OrderId="OrderId"
                                       Links="_order._links"
                                       IsAuthenticated="false"
                                       GuestCapability="_capability" />

        @if (HasPaymentAction)
        {
            <PaymentStatusPanel @key="(EventId, OrderId)"
                                Start="@(CanStartPayment ? StartPaymentAsync : null)"
                                LoadAcceptance="@(CanReviewPayment ? LoadPaymentAcceptanceAsync : null)"
                                Load="@(CanLoadPayment ? LoadPaymentAsync : null)"
                                 Refresh="RefreshPaymentAsync"
                                 Retry="RetryPaymentAsync"
                                 IssueCheckoutTicket="IssueCheckoutTicketAsync"
                                 Succeeded="ReloadAfterPaymentAsync"
                                 Expired="ReloadAfterPaymentAsync"
                                 OrderExpiresAt="_order.ExpiresAt" />
        }

        <section class="guest-order-recovery__details" aria-labelledby="guest-order-details">
            <MudText Id="guest-order-details" Typo="Typo.h5" HtmlTag="h2">Order details</MudText>
            <ul>
                @foreach (var line in _order.Lines ?? [])
                {
                    <li>@(line.Quantity ?? 0) × @(line.TicketTypeName ?? "Ticket") — @RegistrationOrderMoneyFormatter.Format(line.SubtotalMinor, line.CurrencyCode ?? _order.CurrencyCode)</li>
                }
            </ul>
            <dl class="guest-order-recovery__totals" aria-label="Order pricing totals">
                <div><dt>Organizer amount before promotion</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.PreDiscountOrganizerDirectedTotalMinor, _order.CurrencyCode)</dd></div>
                <div><dt>Promotion discount</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.PromotionDiscountTotalMinor, _order.CurrencyCode)</dd></div>
                <div><dt>Organizer amount after promotion</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.PostDiscountOrganizerDirectedTotalMinor ?? _order.OrganizerDirectedTotalMinor, _order.CurrencyCode)</dd></div>
                <div><dt>Platform fee</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.PlatformFeeTotalMinor, _order.CurrencyCode)</dd></div>
                <div><dt>Voluntary contribution</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.PlatformContributionTotalMinor, _order.CurrencyCode)</dd></div>
                <div><dt>Final total</dt><dd>@RegistrationOrderMoneyFormatter.Format(_order.TotalDueMinor, _order.CurrencyCode)</dd></div>
            </dl>
        </section>

        @if (HasPromotionState)
        {
            <section class="guest-order-recovery__promotion" aria-labelledby="guest-order-promotion">
                <MudText Id="guest-order-promotion" Typo="Typo.h5" HtmlTag="h2">Promotion</MudText>
                <MudText Typo="Typo.body2">Guest promotion eligibility is checked by the server for this order.</MudText>
                @if (CanRemovePromotion)
                {
                    <MudText Typo="Typo.body2">@(_order.AppliedPromotionDisplayLabel ?? "A promotion is applied.")</MudText>
                    <MudText Typo="Typo.body2">Remove this promotion before applying a different code.</MudText>
                    <AppButton Variant="Variant.Outlined" Disabled="_isPromotionBusy" OnClick="RemovePromotionAsync">Remove promotion</AppButton>
                }
                else if (!string.IsNullOrWhiteSpace(_order.AppliedPromotionDisplayLabel))
                {
                    <MudText Typo="Typo.body2">@_order.AppliedPromotionDisplayLabel</MudText>
                    <MudText Typo="Typo.body2">Remove this promotion before applying a different code.</MudText>
                }
                else if (CanApplyPromotion)
                {
                    <form class="guest-order-recovery__promotion-form" @onsubmit="ApplyPromotionAsync" @onsubmit:preventDefault="true">
                        <MudTextField T="string" Id="guest-promotion-code" Label="Promotion code" aria-label="Promotion code" @bind-Value="_promotionCode" Immediate="true" Disabled="_isPromotionBusy" />
                        <AppButton ButtonType="ButtonType.Submit" Disabled="@(_isPromotionBusy || string.IsNullOrWhiteSpace(_promotionCode))">Apply promotion code</AppButton>
                    </form>
                }

                @if (_promotionMessage is not null)
                {
                    <div id="guest-promotion-status" class="guest-order-recovery__promotion-status" role="@(_promotionMessageIsError ? "alert" : "status")" aria-live="@(_promotionMessageIsError ? "assertive" : "polite")" tabindex="-1">@_promotionMessage</div>
                }
            </section>
        }

        @if (_order.PlatformContribution?.Options is { Count: > 0 })
        {
            @if (!string.IsNullOrWhiteSpace(_order.PlatformContribution.Heading))
            {
                <MudText Typo="Typo.h6" HtmlTag="h2">@_order.PlatformContribution.Heading</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_order.PlatformContribution.Body))
            {
                <MudText Typo="Typo.body2">@_order.PlatformContribution.Body</MudText>
            }
            <MudSelect T="int?" Label="Platform contribution" @bind-Value="_contributionBasisPoints">
                @foreach (var option in _order.PlatformContribution.Options)
                {
                    <MudSelectItem Value="@option.ContributionBasisPoints">@FormatPercentage(option.ContributionBasisPoints) — @RegistrationOrderMoneyFormatter.Format(option.AmountMinor, _order.CurrencyCode)</MudSelectItem>
                }
            </MudSelect>
        }


        <RegistrationParticipantEditor EventId="EventId"
                                       OrderId="OrderId"
                                       GuestCapability="_capability" />

        @if (_order._links?.ContainsKey("requirement-progress") == true)
        {
            <NativeRegistrationRequirementJourney EventId="EventId"
                                                  OrderId="OrderId"
                                                  GuestCapability="_capability" />
        }

        <div class="guest-order-recovery__actions">
            @if (CanContinue)
            {
                <AppButton OnClick="ContinueAsync">Continue registration</AppButton>
            }
            @if (CanFinalize)
            {
                <AppButton OnClick="FinalizeAsync">Finalize registration</AppButton>
            }
            @if (CanCancel)
            {
                <AppButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelAsync">Cancel registration order</AppButton>
            }
        </div>
    }
    @if (_hasStatusLink)
    {
        <section class="guest-order-recovery__summary" aria-labelledby="guest-order-private-status">
            <h2 id="guest-order-private-status">Keep your private registration status</h2>
            <p>Save a private link to check this registration after checkout expires. Anyone with the link can read its status. No email is sent, and a lost link cannot be recovered here.</p>
            <AppButton OnClick="OpenStatus">Open status and save private link</AppButton>
        </section>
    }
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid OrderId { get; set; }

    private GuestRegistrationOrderCapability? _capability;
    private HalResourceOfGuestRegistrationOrderDto? _order;
    private bool _isLoading = true;
    private bool _hasStatusLink;
    private string? _error;
    private int? _contributionBasisPoints;
    private string _promotionCode = string.Empty;
    private string? _promotionMessage;
    private bool _promotionMessageIsError;
    private bool _isPromotionBusy;
    private CancellationTokenSource? _promotionCancellation;
    private bool _disposed;
    private long _loadGeneration;
    private Timer? _timer;

    private bool CanContinue => _order?._links?.ContainsKey("continue") == true;
    private bool CanFinalize => _order?._links?.ContainsKey("finalize") == true;
    private bool CanCancel => _order?._links?.ContainsKey("cancel") == true;
    private bool CanApplyPromotion => _order?._links?.ContainsKey("apply-promotion") == true && !CanRemovePromotion;
    private bool CanRemovePromotion => _order?._links?.ContainsKey("remove-promotion") == true;
    private bool HasPromotionState => CanApplyPromotion || CanRemovePromotion || !string.IsNullOrWhiteSpace(_order?.AppliedPromotionDisplayLabel);
    private bool CanReviewPayment => _order?._links?.ContainsKey("payment-acceptance") == true;
    private bool CanStartPayment => _order?._links?.ContainsKey("start-payment") == true && CanReviewPayment;
    private bool CanLoadPayment => _order?._links?.ContainsKey("payment-status") == true;
    private bool HasPaymentAction => CanStartPayment || CanLoadPayment;

    protected override async Task OnParametersSetAsync()
    {
        CancelPromotionMutation();
        ++_loadGeneration;
        _isLoading = true;
        _hasStatusLink = false;
        _order = null;
        _capability = CapabilityStore.TryGet(EventId, OrderId, out var capability) ? capability : null;
        if (_capability is null)
        {
            _error = "Open this order from the same guest registration session to continue securely.";
            _isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = _loadGeneration;
        var order = await RegistrationOrderService.GetGuestAsync(EventId, OrderId, _capability!);
        if (_disposed || generation != _loadGeneration)
        {
            return;
        }

        _order = order;
        _hasStatusLink |= order?._links?.ContainsKey("guest-status") == true;
        _contributionBasisPoints = _order?.PlatformContribution?.SelectedBasisPoints;
        _isLoading = false;
        _timer?.Dispose();
        _timer = _order?.ExpiresAt is null ? null : new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async Task ContinueAsync() => await ApplyAsync(() => RegistrationOrderService.ContinueGuestAsync(EventId, OrderId, _capability!, _contributionBasisPoints));
    private async Task FinalizeAsync() => await ApplyAsync(() => RegistrationOrderService.FinalizeGuestAsync(EventId, OrderId, _capability!));
    private async Task CancelAsync()
    {
        var response = await RegistrationOrderService.CancelGuestAsync(EventId, OrderId, _capability!);
        if (response?.Order is not null) await LoadAsync();
        else _error = response?.Message ?? "This registration order could not be updated.";
    }

    private void OpenStatus() => Navigation.NavigateTo(new Uri(new Uri(Navigation.BaseUri),
        $"registration/guest/events/{EventId:D}/orders/{OrderId:D}/status").AbsoluteUri);
    private Task<PaidOrderAcceptanceDisclosureDto?> LoadPaymentAcceptanceAsync(CancellationToken cancellationToken) =>
        RegistrationPaymentService.GetGuestPaymentAcceptanceAsync(EventId, OrderId, _capability!, _order!, cancellationToken);
    private Task<HalResourceOfRegistrationPaymentDto?> StartPaymentAsync(string disclosureRevision, CancellationToken cancellationToken) =>
        RegistrationPaymentService.StartGuestPaymentAsync(EventId, OrderId, _capability!, _order!, disclosureRevision, cancellationToken);
    private Task<HalResourceOfRegistrationPaymentDto?> LoadPaymentAsync(CancellationToken cancellationToken) =>
        RegistrationPaymentService.GetGuestPaymentAsync(EventId, OrderId, _capability!, _order!, cancellationToken);
    private Task<HalResourceOfRegistrationPaymentDto?> RefreshPaymentAsync(HalResourceOfRegistrationPaymentDto payment, CancellationToken cancellationToken) =>
        RegistrationPaymentService.RefreshGuestPaymentAsync(EventId, OrderId, _capability!, payment, cancellationToken);
    private Task<HalResourceOfRegistrationPaymentDto?> RetryPaymentAsync(HalResourceOfRegistrationPaymentDto payment, CancellationToken cancellationToken) =>
        RegistrationPaymentService.RetryGuestPaymentAsync(EventId, OrderId, _capability!, payment, cancellationToken);
    private Task<string?> IssueCheckoutTicketAsync(string path, CancellationToken cancellationToken) =>
        RegistrationPaymentService.IssueGuestPaymentCheckoutTicketAsync(path, _capability!, cancellationToken);
    private Task ReloadAfterPaymentAsync() => LoadAsync();

    private Task ApplyPromotionAsync()
    {
        if (string.IsNullOrWhiteSpace(_promotionCode))
        {
            return Task.CompletedTask;
        }

        var code = _promotionCode;
        return UpdatePromotionAsync(
            cancellationToken => RegistrationOrderService.ApplyGuestPromotionAsync(EventId, OrderId, _capability!, _order!, code, cancellationToken),
            "Promotion applied.",
            "We could not apply that promotion to this order.");
    }

    private Task RemovePromotionAsync() => UpdatePromotionAsync(
        cancellationToken => RegistrationOrderService.RemoveGuestPromotionAsync(EventId, OrderId, _capability!, _order!, cancellationToken),
        "Promotion removed from your order.",
        "We could not remove the promotion from this order.");

    private async Task UpdatePromotionAsync(
        Func<CancellationToken, Task<HalResourceOfGuestRegistrationOrderDto?>> operation,
        string successMessage,
        string failureMessage)
    {
        if (_isPromotionBusy || _disposed)
        {
            return;
        }

        _isPromotionBusy = true;
        _promotionMessage = null;
        _promotionCode = string.Empty;
        var cancellation = new CancellationTokenSource();
        _promotionCancellation = cancellation;
        var cancellationToken = cancellation.Token;
        try
        {
            var order = await operation(cancellationToken);
            if (cancellationToken.IsCancellationRequested || _disposed)
            {
                return;
            }

            if (order is null)
            {
                _promotionMessage = failureMessage;
                _promotionMessageIsError = true;
                await Announcer.AnnounceAssertiveAsync(_promotionMessage);
                if (!cancellationToken.IsCancellationRequested && !_disposed)
                {
                    await Focus.FocusAsync("#guest-promotion-status");
                }
                return;
            }

            _order = order;
            _contributionBasisPoints = order.PlatformContribution?.SelectedBasisPoints;
            _promotionMessage = successMessage;
            _promotionMessageIsError = false;
            await Announcer.AnnouncePoliteAsync(_promotionMessage);
            if (!cancellationToken.IsCancellationRequested && !_disposed)
            {
                await Focus.FocusAsync("#guest-promotion-status");
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_promotionCancellation, cancellation))
            {
                _promotionCancellation = null;
                if (!_disposed)
                {
                    _isPromotionBusy = false;
                }
            }

            cancellation.Dispose();
        }
    }

    private async Task ApplyAsync(Func<Task<HalResourceOfGuestRegistrationOrderLifecycleResponseDto?>> operation)
    {
        var response = await operation();
        if (response?.Order is not null)
        {
            _hasStatusLink |= response._links?.ContainsKey("guest-status") == true;
            await LoadAsync();
        }
        else
        {
            _error = response?.Message ?? "This registration order could not be updated.";
        }
    }

    private static string FormatPercentage(int? basisPoints) => $"{basisPoints.GetValueOrDefault() / 100m:0.##}%";

    private void CancelPromotionMutation()
    {
        _promotionCancellation?.Cancel();
        _promotionCancellation?.Dispose();
        _promotionCancellation = null;
        _isPromotionBusy = false;
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        CancelPromotionMutation();
        _timer?.Dispose();
    }
}
