@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Change profile picture</MudText>
    </TitleContent>
    <DialogContent>
        <ImageUpload @bind-PreviewUrl="_previewUrl"
                     FileDataSelected="OnFileSelected"
                     UploadButtonText="Choose image"
                     Width="180px"
                     Height="180px"
                     HintText="Recommended: square image, at least 400×400px."
                     Icon="@Icons.Material.Filled.AccountCircle"
                     Alt="Profile picture preview" />
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Elevation="0" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(_uploading || _fileData is null)">
            @if (_uploading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Upload &amp; save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? InitialPreviewUrl { get; set; }

    [Inject] private IImageStorageService ImageStorageService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private FileUploadData? _fileData;
    private string? _previewUrl;
    private bool _uploading;

    public record ProfileImageUploadResult(Guid StorageObjectId, string? ViewUrl);

    protected override void OnInitialized()
    {
        _previewUrl = InitialPreviewUrl;
    }

    private void OnFileSelected(FileUploadData? fileData)
    {
        _fileData = fileData;
        _previewUrl = fileData is null
            ? InitialPreviewUrl
            : ImageStorageService.GenerateLocalPreviewFromBytes(fileData);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (_fileData is null)
        {
            Snackbar.Add("Please choose an image first.", Severity.Warning);
            return;
        }

        _uploading = true;
        try
        {
            var uploadResult = await ImageStorageService.UploadAndCreateRecordFromBytesAsync(_fileData);
            if (uploadResult is null || !uploadResult.Success)
            {
                Snackbar.Add(uploadResult?.ErrorMessage ?? "Image upload failed. Please try again.", Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(new ProfileImageUploadResult(uploadResult.StorageObjectId, uploadResult.ViewUrl)));
        }
        finally
        {
            _uploading = false;
        }
    }
}
