{
  "$schema": "https://schemas.islamu.org/event/configuration-manifest/v1alpha2/schema.json",
  "apiVersion": "configuration.islamu.org/v1alpha2",
  "kind": "ConfigurationManifest",
  "metadata": { "name": "example-deployment" },
  "spec": {
    "instance": {
      "settings": { "events.require_approval": true },
      "documents": {},
      "legalDocuments": {}
    },
    "tenants": [
      {
        "metadata": { "name": "community" },
        "spec": {
          "displayName": "Community",
          "settings": { "events.require_approval": true },
          "documents": {
            "tenant.branding": {
              "schemaVersion": 1,
              "payload": { "displayName": "Community" }
            }
          },
          "legalDocuments": {}
        }
      },
      {
        "metadata": { "name": "second-community" },
        "spec": {
          "displayName": "Second Community",
          "settings": {},
          "documents": {},
          "legalDocuments": {}
        }
      }
    ]
  }
}
