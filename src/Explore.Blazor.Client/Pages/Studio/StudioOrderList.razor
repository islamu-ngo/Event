@using Explore.Blazor.Client.Contracts.Services
@inject IStudioContextService StudioContextService
@implements IDisposable

@if (_isLoading)
{
    <div class="studio-order-list__state" role="status" data-testid="studio-orders-loading">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading registration orders…</span>
    </div>
}
else if (_error is not null)
{
    <div class="studio-order-list__state" role="alert" data-testid="studio-orders-unavailable">
        @_error
    </div>
}
else if (_orders.Count == 0)
{
    <div class="studio-order-list__state" data-testid="studio-orders-empty">
        <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Color="Color.Secondary" aria-hidden="true" />
        <span>No registration orders are available.</span>
    </div>
}
else
{
    <div class="studio-order-list" data-testid="studio-order-list">
        @foreach (var order in _orders)
        {
            <article class="studio-order-list__item">
                <div class="studio-order-list__summary">
                    <MudText Typo="Typo.h6" HtmlTag="h3">Order @ShortId(order.Id)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(order.StatusName ?? order.StatusCode ?? "Unknown status")</MudText>
                </div>
                <dl class="studio-order-list__totals">
                    <div><dt>Total due</dt><dd>@MinorAmount(order.TotalDueMinor, order.CurrencyCode)</dd></div>
                    <div><dt>Organizer earnings</dt><dd>@MinorAmount(order.OrganizerEarningsTotalMinor, order.CurrencyCode)</dd></div>
                </dl>
                @if (order.Lines is { Count: > 0 })
                {
                    <ul class="studio-order-list__lines" aria-label="Order lines">
                        @foreach (var line in order.Lines)
                        {
                            <li>@line.Quantity × @line.TicketTypeName — @MinorAmount(line.SubtotalMinor, line.CurrencyCode)</li>
                        }
                    </ul>
                }
                @if (order._links?.ContainsKey("studio-payment-status") == true)
                {
                    <StudioPaymentStatus EventId="EventId" Order="order" />
                }
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid EventId { get; set; }

    private IReadOnlyList<HalResourceOfRegistrationOrderDto> _orders = [];
    private string? _error;
    private bool _isLoading;
    private CancellationTokenSource? _requestCancellation;
    private long _loadGeneration;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        CancelPendingRequest();
        long generation = ++_loadGeneration;
        Guid eventId = EventId;
        _orders = [];
        _error = null;
        if (EventId == Guid.Empty)
        {
            _isLoading = false;
            return;
        }

        var cancellation = new CancellationTokenSource();
        _requestCancellation = cancellation;
        _isLoading = true;
        try
        {
            IReadOnlyList<HalResourceOfRegistrationOrderDto> orders =
                await StudioContextService.GetEventOrdersAsync(eventId, cancellation.Token);
            if (_disposed || cancellation.IsCancellationRequested || generation != _loadGeneration || EventId != eventId)
            {
                return;
            }

            _orders = orders;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (_disposed || cancellation.IsCancellationRequested || generation != _loadGeneration || EventId != eventId)
            {
                return;
            }
            _orders = [];
            _error = "Registration orders are currently unavailable.";
        }
        finally
        {
            if (ReferenceEquals(_requestCancellation, cancellation))
            {
                _requestCancellation = null;
                if (!_disposed && generation == _loadGeneration && EventId == eventId)
                {
                    _isLoading = false;
                }
            }
            cancellation.Dispose();
        }
    }

    private static string ShortId(Guid? id) => id?.ToString("N")[..8] ?? "unknown";

    private static string MinorAmount(long? amountMinor, string? currencyCode) =>
        $"{amountMinor ?? 0:N0} {currencyCode ?? string.Empty} minor units".TrimEnd();

    public void Dispose()
    {
        _disposed = true;
        ++_loadGeneration;
        CancelPendingRequest();
    }

    private void CancelPendingRequest()
    {
        _requestCancellation?.Cancel();
        _requestCancellation?.Dispose();
        _requestCancellation = null;
    }
}
