    private static bool HasCollectionLink(IReadOnlyDictionary<string, HalLink>? links, string rel) => links?.ContainsKey(rel) == true;
    private static IReadOnlyDictionary<string, HalLink>? Links(IDictionary<string, HalLink>? links) => links?.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.OrdinalIgnoreCase);
    private static IEnumerable<string> RawLines(string? value) => (value ?? string.Empty)
        .Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(origin => !string.IsNullOrWhiteSpace(origin));
    private static IEnumerable<string> SplitLines(string? value) => RawLines(value).Where(origin => Uri.IsWellFormedUriString(origin, UriKind.Absolute));

