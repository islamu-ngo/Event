          "minLength": 1,
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "legalTemplateProvenance": {
      "type": "object",
      "additionalProperties": false,
