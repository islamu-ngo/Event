@page "/admin/events/{EventId:guid}/location-privacy-review"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Events
@using Explore.Blazor.Client.Contracts.Services
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Pages.Events.Components
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@rendermode InteractiveServer
@attribute [Authorize]
@inject IEventLocationService EventLocations
@inject IDialogService DialogService
@inject ITranslationService Translation

<PageTitle>@T("ui.event_location.review_queue.title", "Location privacy review")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <section aria-labelledby="event-location-review-title" aria-busy="@_loading">
        <MudText Id="event-location-review-title" Typo="Typo.h1" HtmlTag="h1" Class="mb-2">
            @T("ui.event_location.review_queue.title", "Location privacy review")
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @T("ui.event_location.review_queue.description", "These locations were flagged after an erasure or a tightened policy. Point each one at a usable venue or mark it to be announced, then confirm.")
        </MudText>

        <div role="status" class="mb-2">
            <MudText Typo="Typo.body2" data-testid="event-location-review-count">
                @string.Format(
                    System.Globalization.CultureInfo.CurrentCulture,
                    T("ui.event_location.review_queue.count", "{0} location(s) awaiting review"),
                    _rows.Count)
            </MudText>
        </div>

        <EventLocationManagementTable Rows="@_rows"
                                      Loading="@_loading"
                                      EmptyMessage="@T("ui.event_location.review_queue.empty", "Nothing is waiting for privacy review.")"
                                      OnEdit="OpenEditorAsync"
                                      OnRemediate="OpenRemediationAsync" />
    </section>
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }

    private IReadOnlyList<HalResourceOfEventLocationManagementDto> _rows = [];
    private bool _loading = true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await EventLocations.GetReviewQueueAsync(EventId);
        _loading = false;
    }

    private async Task OpenEditorAsync(HalResourceOfEventLocationManagementDto row)
    {
        var parameters = new DialogParameters<EventLocationEditorDialog>
        {
            { dialog => dialog.EventId, EventId },
            { dialog => dialog.EventLocationId, row.EventLocationId ?? Guid.Empty },
            { dialog => dialog.Resource, row }
        };

        IDialogReference dialog = await DialogService.ShowAsync<EventLocationEditorDialog>(
            T("ui.event_location.editor.title", "Location disclosure"),
            parameters);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenRemediationAsync(HalResourceOfEventLocationManagementDto row)
    {
        var parameters = new DialogParameters<ConfirmRemediationDialog>
        {
            { dialog => dialog.EventId, EventId },
            { dialog => dialog.Resource, row }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ConfirmRemediationDialog>(
            T("ui.event_location.remediation.title", "Confirm privacy remediation"),
            parameters);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private string T(string key, string fallback) => Translation.T(key, fallback);
}
