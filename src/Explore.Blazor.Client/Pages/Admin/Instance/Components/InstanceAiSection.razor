@using MudBlazor
@using Explore.Blazor.Client.Services

@inject ITenantOnboardingService TenantOnboardingService

<div class="settings-section">
    <div class="settings-section-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.h5" Style="font-weight: 700;">AI Assistant</MudText>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">Beta</MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure the AI provider for the assistant rail. API keys are optional for local providers such as llama.cpp.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudSwitch T="bool"
                   Value="AiAssistant.Enabled == true"
                   ValueChanged="OnEnabledChangedAsync"
                   Disabled="_isSaving"
                   Color="Color.Primary">
            Enable AI Assistant
        </MudSwitch>

        @if (AiAssistant.Enabled == true)
        {
            <MudSelect T="string" Label="Provider" @bind-Value="AiAssistant.Provider" Disabled="_isSaving" Variant="Variant.Outlined">
                <MudSelectItem Value="@("openai-compatible")">OpenAI-compatible</MudSelectItem>
                <MudSelectItem Value="@("anthropic-compatible")">Anthropic-compatible</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool"
                       Value="AiAssistant.AllowAnonymousAccess == true"
                       ValueChanged="OnAllowAnonymousAccessChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Warning">
                Allow anonymous users to open the AI Assistant
            </MudSwitch>

            <MudSwitch T="bool"
                       Value="AiAssistant.ToolProposalsEnabled == true"
                       ValueChanged="OnToolProposalsEnabledChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary">
                Enable tool proposals (Build mode)
            </MudSwitch>

            <MudAlert Severity="Severity.Info" Dense="true">
                The navbar AI button appears only after an endpoint URL and model ID are saved.
            </MudAlert>

            <MudTextField T="string"
                          Value="AiAssistant.EndpointUrl"
                          ValueChanged="OnEndpointUrlChanged"
                          Label="Endpoint URL"
                           InputType="InputType.Url"
                           Disabled="_isSaving"
                          Variant="Variant.Outlined"
                          Placeholder="http://127.0.0.1:1337/v1"
                          HelperText="Provider base URL. Model discovery calls the provider's models endpoint automatically." />

            <MudTextField T="string"
                          Label="API key (leave blank to keep configured key)"
                          @bind-Value="_apiKey"
                           Variant="Variant.Outlined"
                           InputType="InputType.Password"
                           Disabled="_isSaving"
                          HelperText="@(AiAssistant.ApiKeyConfigured == true ? "A provider key is configured on the server. Enter a replacement only when rotating it." : "Enter the provider key to use for model discovery and save with this provider configuration.")" />

            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Class="flex-wrap">
                @if (HasDiscoveredModels)
                {
                    <MudSelect T="string"
                               Value="AiAssistant.ModelId"
                               ValueChanged="OnModelIdChanged"
                               Label="Default model ID"
                               Variant="Variant.Outlined"
                               Disabled="_isSaving"
                               HelperText="Select a model returned by the provider."
                               Class="flex-grow-1">
                        @foreach (var model in ModelOptions)
                        {
                            <MudSelectItem T="string" Value="@model.Id">@FormatModelOption(model)</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string"
                                  Value="AiAssistant.ModelId"
                                  ValueChanged="OnModelIdChanged"
                                  Label="Default model ID"
                                  Variant="Variant.Outlined"
                                  Disabled="_isSaving"
                                  Placeholder="gpt-4o-mini, llama3.1, claude-sonnet-4-20250514"
                                  HelperText="Example: gpt-4o-mini, llama3.1, or the model name exposed by your provider."
                                  Class="flex-grow-1" />
                }

                <MudButton Elevation="0"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadModelsAsync"
                           Disabled="@(_isSaving || !CanLoadModels)">
                    @(_isLoadingModels ? "Loading..." : "Load models")
                </MudButton>
            </MudStack>

            @if (HasDiscoveredModels)
            {
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectedValues="SelectedAllowedModelIds"
                           SelectedValuesChanged="OnSelectedAllowedModelIdsChanged"
                           Label="Allowed models"
                           Variant="Variant.Outlined"
                           Disabled="_isSaving"
                           HelperText="Choose every model the assistant may use.">
                    @foreach (var model in ModelOptions)
                    {
                        <MudSelectItem T="string" Value="@model.Id">@FormatModelOption(model)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField T="string"
                              Value="@AllowedModelsText"
                              ValueChanged="OnAllowedModelsTextChanged"
                              Label="Allowed model IDs"
                               Variant="Variant.Outlined"
                               Lines="3"
                               Disabled="_isSaving"
                              HelperText="Optional. Use commas or one model per line. The default model ID is always included." />
            }

            @if (!string.IsNullOrWhiteSpace(_modelLoadMessage))
            {
                <MudText Typo="Typo.caption" Color="@_modelLoadMessageColor">
                    @_modelLoadMessage
                </MudText>
            }

            @if (HasIncompleteConfiguration)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Enter an endpoint URL and model ID before saving, otherwise the AI Assistant cannot be enabled.
                </MudAlert>
            }

            <MudButton Elevation="0"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveProviderConfigurationAsync"
                       Disabled="@(_isSaving || HasIncompleteConfiguration)">
                @(_isSaving ? "Saving..." : "Save provider configuration")
            </MudButton>
        }

        @if (!IsSingleTenant)
        {
            <MudDivider Class="my-2" />
            <MudSwitch T="bool"
                       Value="AiAssistant.LockTenantAiAssistant == true"
                       ValueChanged="OnLockTenantAiAssistantChangedAsync"
                       Disabled="_isSaving"
                       Color="Color.Primary">
                Lock tenant AI Assistant configuration
            </MudSwitch>
        }

        <div role="status" aria-live="polite" aria-atomic="true">@_saveStatus</div>
        <div role="alert">@_saveError</div>
    </MudStack>
</div>

@code {
    private IReadOnlyList<AiAssistantModelDto> _discoveredModels = [];
    private bool _isLoadingModels;
    private string? _modelLoadMessage;
    private Color _modelLoadMessageColor = Color.Secondary;
    private string _apiKey = string.Empty;
    private bool _isSaving;
    private string? _saveStatus;
    private string? _saveError;
    private long _modelLoadVersion;

    [Parameter, EditorRequired]
    public AiAssistantGovernanceSettingsDto AiAssistant { get; set; } = new();

    [Parameter]
    public string DeploymentMode { get; set; } = "SingleTenant";

    [Parameter, EditorRequired]
    public Func<AiAssistantGovernanceSettingsDto, Task<BaseCommandResponseOfGuid>> SaveAiAssistantAsync { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<AiAssistantProviderConfigurationWriteDto, Task<BaseCommandResponseOfGuid>> SaveAiProviderConfigurationAsync { get; set; } = null!;

    private bool IsSingleTenant => string.Equals(DeploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase)
                                   || string.IsNullOrWhiteSpace(DeploymentMode);

    private bool HasDiscoveredModels => _discoveredModels.Count > 0;

    private bool HasIncompleteConfiguration =>
        string.IsNullOrWhiteSpace(AiAssistant.EndpointUrl)
        || string.IsNullOrWhiteSpace(AiAssistant.ModelId);

    private bool CanLoadModels =>
        !_isLoadingModels
        && !string.IsNullOrWhiteSpace(AiAssistant.EndpointUrl);

    private IReadOnlyCollection<string> SelectedAllowedModelIds => AiAssistant.AllowedModelIds?.ToArray() ?? [];

    private string AllowedModelsText => string.Join(Environment.NewLine, AiAssistant.AllowedModelIds ?? []);

    private IEnumerable<AiAssistantModelDto> ModelOptions
    {
        get
        {
            foreach (var model in _discoveredModels)
            {
                yield return model;
            }

            if (!string.IsNullOrWhiteSpace(AiAssistant.ModelId)
                && !_discoveredModels.Any(m => string.Equals(m.Id, AiAssistant.ModelId, StringComparison.OrdinalIgnoreCase)))
            {
                yield return new AiAssistantModelDto
                {
                    Id = AiAssistant.ModelId,
                    DisplayName = $"{AiAssistant.ModelId} (current)"
                };
            }

            foreach (var allowedModelId in AiAssistant.AllowedModelIds ?? [])
            {
                if (string.IsNullOrWhiteSpace(allowedModelId)
                    || _discoveredModels.Any(m => string.Equals(m.Id, allowedModelId, StringComparison.OrdinalIgnoreCase))
                    || string.Equals(AiAssistant.ModelId, allowedModelId, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                yield return new AiAssistantModelDto
                {
                    Id = allowedModelId,
                    DisplayName = $"{allowedModelId} (allowed)"
                };
            }
        }
    }

    protected override void OnParametersSet()
    {
        EnsureDefaultModelAllowed();
    }

    private Task OnEnabledChangedAsync(bool value)
    {
        AiAssistant.Enabled = value;
        return SaveAsync(new AiAssistantGovernanceSettingsDto { Enabled = value }, "AI Assistant setting");
    }

    private Task OnAllowAnonymousAccessChangedAsync(bool value)
    {
        AiAssistant.AllowAnonymousAccess = value;
        return SaveAsync(new AiAssistantGovernanceSettingsDto { AllowAnonymousAccess = value }, "AI Assistant setting");
    }

    private Task OnToolProposalsEnabledChangedAsync(bool value)
    {
        AiAssistant.ToolProposalsEnabled = value;
        return SaveAsync(new AiAssistantGovernanceSettingsDto { ToolProposalsEnabled = value }, "AI Assistant setting");
    }

    private Task OnLockTenantAiAssistantChangedAsync(bool value)
    {
        AiAssistant.LockTenantAiAssistant = value;
        return SaveAsync(new AiAssistantGovernanceSettingsDto { LockTenantAiAssistant = value }, "AI Assistant setting");
    }

    private async Task SaveProviderConfigurationAsync()
    {
        BaseCommandResponseOfGuid response = await SaveAsync(() => SaveAiProviderConfigurationAsync(new AiAssistantProviderConfigurationWriteDto
        {
            Provider = AiAssistant.Provider ?? string.Empty,
            EndpointUrl = AiAssistant.EndpointUrl ?? string.Empty,
            ApiKey = _apiKey,
            ModelId = AiAssistant.ModelId ?? string.Empty,
            AllowedModelIds = AiAssistant.AllowedModelIds?.ToArray() ?? []
        }), "AI provider configuration");
        if (response.Success == true)
            _apiKey = string.Empty;
    }

    private Task<BaseCommandResponseOfGuid> SaveAsync(AiAssistantGovernanceSettingsDto patch, string label) =>
        SaveAsync(() => SaveAiAssistantAsync(patch), label);

    private async Task<BaseCommandResponseOfGuid> SaveAsync(
        Func<Task<BaseCommandResponseOfGuid>> save,
        string label)
    {
        _isSaving = true;
        _saveStatus = $"Saving {label.ToLowerInvariant()}...";
        _saveError = null;
        try
        {
            BaseCommandResponseOfGuid response = await save();
            _saveStatus = response.Success == true ? $"{label} saved." : null;
            _saveError = response.Success == true
                ? null
                : string.IsNullOrWhiteSpace(response.Message) ? $"{label} could not be saved." : response.Message;
            return response;
        }
        catch (Exception)
        {
            _saveStatus = null;
            _saveError = $"{label} could not be saved.";
            return new BaseCommandResponseOfGuid { Success = false, Message = _saveError };
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OnEndpointUrlChanged(string endpointUrl)
    {
        AiAssistant.EndpointUrl = endpointUrl;
        _modelLoadVersion++;
        _isLoadingModels = false;
        ClearDiscoveredModels();
    }

    private void OnModelIdChanged(string modelId)
    {
        AiAssistant.ModelId = modelId;
        EnsureDefaultModelAllowed();
    }

    private Task OnSelectedAllowedModelIdsChanged(IEnumerable<string> selectedModelIds)
    {
        AiAssistant.AllowedModelIds = NormalizeModelIds(AiAssistant.ModelId, selectedModelIds).ToList();
        return Task.CompletedTask;
    }

    private void OnAllowedModelsTextChanged(string value)
    {
        AiAssistant.AllowedModelIds = NormalizeModelIds(AiAssistant.ModelId, SplitModelIds(value)).ToList();
    }

    private async Task LoadModelsAsync()
    {
        if (string.IsNullOrWhiteSpace(AiAssistant.EndpointUrl))
        {
            SetModelLoadMessage("Enter an endpoint URL before loading models.", Color.Warning);
            return;
        }

        _isLoadingModels = true;
        SetModelLoadMessage(null, Color.Secondary);
        long requestVersion = ++_modelLoadVersion;
        string endpointUrl = AiAssistant.EndpointUrl;
        string apiKey = _apiKey;

        try
        {
            var models = await TenantOnboardingService.GetAiModelsAsync(endpointUrl, apiKey);
            if (requestVersion != _modelLoadVersion
                || !string.Equals(endpointUrl, AiAssistant.EndpointUrl, StringComparison.Ordinal)
                || !string.Equals(apiKey, _apiKey, StringComparison.Ordinal))
            {
                return;
            }

            _discoveredModels = models
                .Where(m => !string.IsNullOrWhiteSpace(m.Id))
                .GroupBy(m => m.Id, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(m => m.Id, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (_discoveredModels.Count == 0)
            {
                SetModelLoadMessage("No models were returned. Enter the model ID manually.", Color.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(AiAssistant.ModelId))
            {
                AiAssistant.ModelId = _discoveredModels[0].Id!;
            }

            if (AiAssistant.AllowedModelIds is null or { Count: 0 })
            {
                AiAssistant.AllowedModelIds = _discoveredModels.Select(m => m.Id!).ToList();
            }

            EnsureDefaultModelAllowed();

            SetModelLoadMessage($"Loaded {_discoveredModels.Count} model{(_discoveredModels.Count == 1 ? string.Empty : "s")} from the provider.", Color.Secondary);
        }
        finally
        {
            if (requestVersion == _modelLoadVersion)
            {
                _isLoadingModels = false;
            }
        }
    }

    private void ClearDiscoveredModels()
    {
        _discoveredModels = [];
        SetModelLoadMessage(null, Color.Secondary);
    }

    private void SetModelLoadMessage(string? message, Color color)
    {
        _modelLoadMessage = message;
        _modelLoadMessageColor = color;
    }

    private static string FormatModelOption(AiAssistantModelDto model)
    {
        return string.IsNullOrWhiteSpace(model.DisplayName) || string.Equals(model.DisplayName, model.Id, StringComparison.OrdinalIgnoreCase)
            ? model.Id ?? string.Empty
            : model.DisplayName;
    }

    private void EnsureDefaultModelAllowed()
    {
        AiAssistant.AllowedModelIds = NormalizeModelIds(AiAssistant.ModelId, AiAssistant.AllowedModelIds ?? []).ToList();
    }

    private static IEnumerable<string> SplitModelIds(string value)
    {
        return value.Split([',', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private static IReadOnlyList<string> NormalizeModelIds(string? defaultModelId, IEnumerable<string?> modelIds)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var normalized = new List<string>();

        foreach (var modelId in new[] { defaultModelId }.Concat(modelIds))
        {
            var trimmed = modelId?.Trim();
            if (string.IsNullOrWhiteSpace(trimmed) || !seen.Add(trimmed))
            {
                continue;
            }

            normalized.Add(trimmed);
        }

        return normalized;
    }
}
