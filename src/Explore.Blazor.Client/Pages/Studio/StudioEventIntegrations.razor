    private async Task CreateConnectionAsync()
    {
        if (!CanCreateConnection || !await ValidateConnectionAsync(_connectionDraft) || _connectionLinks?[ProviderCreateRel] is not { } createLink) return;
        if (RawLines(_connectionDraft.OriginsText).Any() && !await ValidateOriginsAsync(_connectionDraft.OriginsText)) return;
        _isSaving = true;
        _validationMessage = null;
        var cancellationToken = _loadCts?.Token ?? default;
        var createdConnection = false;
        try
        {
            var created = await Integrations.CreateConnectionAsync(TenantId, EventId, createLink, new RegistrationProviderConnectionRequestDto
            {
                Name = _connectionDraft.Name,
                ProviderKindId = _connectionDraft.ProviderKindId,
                DeploymentKindId = _connectionDraft.DeploymentKindId,
                ProviderCode = _connectionDraft.ProviderCode,
                ProviderDeploymentCode = _connectionDraft.ProviderDeploymentCode,
                ApiVersion = _connectionDraft.ApiVersion,
                AdapterPolicyVersion = _connectionDraft.AdapterPolicyVersion,
                ConformanceEvidenceRevision = _connectionDraft.ConformanceEvidenceRevision,
                ManagementApiBaseUrl = _connectionDraft.ManagementApiBaseUrl,
                PublicBaseUrl = _connectionDraft.PublicBaseUrl,
                ProviderWorkspaceId = _connectionDraft.ProviderWorkspaceId,
                GrantedOAuthScopes = _connectionDraft.GrantedOAuthScopes,
                ProviderIdentity = _connectionDraft.ProviderIdentity,
                PubSubConfigurationReference = _connectionDraft.PubSubConfigurationReference,
                ApiTokenSecretBindingId = _connectionDraft.ApiTokenSecretBindingId,
                WebhookSecretBindingId = _connectionDraft.WebhookSecretBindingId
            }, cancellationToken);
            createdConnection = true;
            if (_connectionDraft.Origins.Count > 0)
            {
                await PersistCreatedOriginsAsync(created.Id, cancellationToken);
            }
            await Announcer.AnnouncePoliteAsync("Connection saved");
            await ReloadAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Registration provider connection create failed");
            _validationMessage = createdConnection
                ? "The connection was created, but approved origins could not be saved. The entered origins are still in the form; retry origins after refresh."
                : "The provider action failed. Refresh and try again.";
            await Announcer.AnnounceAssertiveAsync(_validationMessage);
        }
        finally
        {
            _isSaving = false;
            await Focus.RestoreFocusAsync("[data-testid='studio-event-integrations']");
        }
    }

