@using Explore.Blazor.Client.Pages.Admin.Components
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Footer
@using MudBlazor

@implements IDisposable

@inject IFooterAdminService FooterService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="settings-section">
    <!-- Header -->
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Footer Settings</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Customize footer appearance, content, and link groups</MudText>
    </div>

    <div role="alert" aria-live="assertive" aria-atomic="true">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_saveErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_saveErrorMessage</MudAlert>
        }
    </div>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading footer settings...</MudText>
        </MudStack>
    }
    else
    {
        <!-- General Settings -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">General Settings</MudText>

            <MudStack Spacing="3">
                <MudSwitch T="bool" Value="_enabled"
                           ValueChanged="OnEnabledChangedAsync"
                           Disabled="@(!CanEditSettings)"
                           Color="Color.Primary"
                           Label="Footer Enabled" />

                <MudSelect T="string" Value="_template"
                           ValueChanged="OnTemplateChangedAsync"
                           Disabled="@(!CanEditTemplate)"
                           Label="Template"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("standard-3-col")">Standard 3-Column</MudSelectItem>
                    <MudSelectItem Value="@("standard-2-col")">Standard 2-Column</MudSelectItem>
                    <MudSelectItem Value="@("minimal")">Minimal</MudSelectItem>
                    <MudSelectItem Value="@("community")">Community</MudSelectItem>
                </MudSelect>

                <MudSwitch T="bool" Value="_showDescription"
                           ValueChanged="OnShowDescriptionChangedAsync"
                           Disabled="@(!CanEditDescription)"
                           Color="Color.Primary"
                           Label="Show Description" />

                @if (_showDescription)
                {
                    <MudTextField T="string" Value="_descriptionText"
                                  ValueChanged="OnDescriptionTextChanged"
                                  OnBlur="@(_ => FlushDescriptionSaveAsync())"
                                  Immediate="true"
                                  Disabled="@(!CanEditDescription)"
                                  Label="Description Text"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Placeholder="Brief description shown in the footer" />
                }

                <MudTextField Variant="Variant.Outlined" T="string" Value="_copyrightText"
                              ValueChanged="OnCopyrightTextChanged"
                              OnBlur="@(_ => FlushCopyrightSaveAsync())"
                              Immediate="true"
                              Disabled="@(!CanEditCopyright)"
                              Label="Copyright Text"
                              Placeholder="e.g., &copy; 2026 My Organization" />

                <MudSwitch T="bool" Value="_showCookieSettingsLink"
                           ValueChanged="OnShowCookieSettingsLinkChangedAsync"
                           Disabled="@(!CanEditSettings)"
                           Color="Color.Primary"
                           Label="Show Cookie Settings Link" />
            </MudStack>
        </MudPaper>

        <!-- Social Links -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Social Links</MudText>
                <MudSwitch T="bool" Value="_showSocialLinks"
                           ValueChanged="OnShowSocialLinksChangedAsync"
                           Disabled="@(!CanEditSocialLinks)"
                           Color="Color.Primary"
                           Label="Show Social Links" />
            </MudStack>

            @if (_showSocialLinks)
            {
                @if (_socialLinks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        No social links configured. Add one to get started.
                    </MudAlert>
                }
                else
                {
                    @for (var i = 0; i < _socialLinks.Count; i++)
                    {
                        var index = i;
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudSelect T="string" Value="_socialLinks[index].Platform"
                                       ValueChanged="@(value => OnSocialPlatformChanged(value, index))"
                                       Disabled="@(!CanEditSocialLinks)"
                                       Label="Platform"
                                       Variant="Variant.Outlined"
                                       Style="min-width: 160px;"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var platform in AvailablePlatforms)
                                {
                                    <MudSelectItem Value="@platform">@CapitalizePlatform(platform)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField Variant="Variant.Outlined" T="string" Value="_socialLinks[index].Url"
                                          ValueChanged="@(value => OnSocialUrlChanged(value, index))"
                                          OnBlur="@(_ => FlushSocialLinksSaveAsync())"
                                          Immediate="true"
                                          Disabled="@(!CanEditSocialLinks)"
                                          Label="URL"
                                          Placeholder="https://..." />
                            <MudTextField Variant="Variant.Outlined" T="string" Value="_socialLinks[index].Label"
                                          ValueChanged="@(value => OnSocialLabelChanged(value, index))"
                                          OnBlur="@(_ => FlushSocialLinksSaveAsync())"
                                          Immediate="true"
                                          Disabled="@(!CanEditSocialLinks)"
                                          Label="Label (optional)"
                                          Placeholder="Display name" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveSocialLink(index))"
                                           Disabled="@(!CanEditSocialLinks)"
                                           aria-label="Remove social link"
                                           Title="Remove" />
                        </MudStack>
                    }
                }

                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddSocialLink"
                           Disabled="@(!CanEditSocialLinks)"
                           Class="mt-2">
                    Add Social Link
                </MudButton>
            }
        </MudPaper>

        <div role="status" aria-live="polite" aria-atomic="true" class="mb-8">@_saveStatusMessage</div>

        <!-- Link Groups -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Link Groups</MudText>
                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateGroupDialog"
                           Disabled="@(!CanManageLinkGroups)">
                    Create Group
                </MudButton>
            </MudStack>

            @if (_linkGroups.Count == 0)
            {
                <MudAlert Severity="Severity.Info">
                    No link groups yet. Create one to organize footer links.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_linkGroups" Hover="true" Striped="true" Dense="false">
                    <HeaderContent>
                        <MudTh>Order</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>Active</MudTh>
                        <MudTh>Links</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order">
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => MoveGroupUp(context))"
                                               Disabled="@(!CanManageLinkGroups || IsFirstGroup(context))"
                                               Title="Move up" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => MoveGroupDown(context))"
                                               Disabled="@(!CanManageLinkGroups || IsLastGroup(context))"
                                               Title="Move down" />
                                <MudText Typo="Typo.body2">@context.Order</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="Active">
                            <MudChip T="string" Color="@(context.IsActive == true ? Color.Success : Color.Default)"
                                     Size="Size.Small">
                                @(context.IsActive == true ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Links">@context.LinkCount</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Link"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => SelectGroup(context))"
                                               Title="Manage Links" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditGroupDialog(context))"
                                               Disabled="@(!CanManageLinkGroups)"
                                               Title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteGroup(context))"
                                               Disabled="@(!CanManageLinkGroups)"
                                               Title="Delete" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <!-- Selected Group Links -->
        @if (_selectedGroup != null)
        {
            <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       OnClick="DeselectGroup"
                                       Title="Back to groups" />
                        <MudText Typo="Typo.h6">Links in &ldquo;@_selectedGroup.Title&rdquo;</MudText>
                    </MudStack>
                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateLinkDialog"
                               Disabled="@(!CanManageLinkGroups)">
                        Add Link
                    </MudButton>
                </MudStack>

                @if (_selectedGroupLinks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        No links in this group. Add one to get started.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_selectedGroupLinks" Hover="true" Striped="true" Dense="false">
                        <HeaderContent>
                            <MudTh>Order</MudTh>
                            <MudTh>Label</MudTh>
                            <MudTh>URL</MudTh>
                            <MudTh>New Tab</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Order">@context.Order</MudTd>
                            <MudTd DataLabel="Label">@context.Label</MudTd>
                            <MudTd DataLabel="URL">
                                <MudLink Href="@context.Url" Target="_blank">@TruncateUrl(context.Url)</MudLink>
                            </MudTd>
                            <MudTd DataLabel="New Tab">
                                <MudCheckBox T="bool" Value="@(context.OpenInNewTab == true)" Disabled="true" />
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenEditLinkDialog(context))"
                                                   Disabled="@(!CanManageLinkGroups)"
                                                   Title="Edit" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteLink(context))"
                                                   Disabled="@(!CanManageLinkGroups)"
                                                   Title="Delete" />
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }
    }
</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _saveErrorMessage;
    private string? _saveStatusMessage;
    private HalResourceOfTenantFooterSettingsDto? _settings;
    private readonly SemaphoreSlim _saveLock = new(1, 1);
    private readonly CancellationTokenSource _lifetimeCts = new();
    private CancellationTokenSource? _descriptionDebounceCts;
    private CancellationTokenSource? _socialLinksDebounceCts;
    private CancellationTokenSource? _copyrightDebounceCts;
    private long _saveVersion;
    private long _descriptionSaveVersion;
    private long _socialLinksSaveVersion;
    private long _copyrightSaveVersion;
    private bool _disposed;

    private const int AutosaveDelayMilliseconds = 400;

    // Settings fields
    private bool _enabled;
    private string _template = "standard-3-col";
    private bool _showDescription;
    private string _descriptionText = string.Empty;
    private string _copyrightText = string.Empty;
    private bool _showCookieSettingsLink;
    private bool _showSocialLinks;
    private List<FooterSocialLinkDto> _socialLinks = new();

    // Link groups
    private List<FooterLinkGroupListDto> _linkGroups = new();

    // Selected group for link management
    private FooterLinkGroupDetailsDto? _selectedGroup;
    private List<FooterLinkItemDto> _selectedGroupLinks = new();

    // ── Available Platforms ───────────────────────────────────────────────

    private static readonly string[] AvailablePlatforms =
    {
        "facebook", "twitter", "instagram", "linkedin", "youtube",
        "tiktok", "bluesky", "whatsapp", "telegram", "github"
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        var cancellationToken = _lifetimeCts.Token;

        try
        {
            var settingsTask = FooterService.GetTenantFooterSettingsAsync(cancellationToken);
            var groupsTask = FooterService.GetLinkGroupsAsync(cancellationToken);

            await Task.WhenAll(settingsTask, groupsTask);
            if (_disposed) return;

            var settings = settingsTask.Result;
            _settings = settings;
            if (settings != null)
            {
                _enabled = settings.Enabled == true;
                _template = settings.Template ?? "standard-3-col";
                _showDescription = settings.ShowDescription == true;
                _descriptionText = settings.DescriptionText ?? string.Empty;
                _copyrightText = settings.CopyrightText ?? string.Empty;
                _showCookieSettingsLink = settings.ShowCookieSettingsLink == true;
                _showSocialLinks = settings.ShowSocialLinks == true;
                _socialLinks = (settings.SocialLinks ?? [])
                    .Select(s => new FooterSocialLinkDto
                    {
                        Platform = s.Platform ?? "facebook",
                        Url = s.Url ?? string.Empty,
                        Label = s.Label ?? string.Empty
                    })
                    .ToList();
            }

            _linkGroups = groupsTask.Result.OrderBy(g => g.Order).ToList();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (!_disposed)
            {
                _errorMessage = "Failed to load footer settings.";
            }
        }
        finally
        {
            if (!_disposed)
            {
                _isLoading = false;
            }
        }
    }

    // ── Settings Autosave ─────────────────────────────────────────────────

    private bool CanEditSettings => !_disposed && _settings?._links?.ContainsKey("edit") == true;
    private bool CanEditTemplate => CanEditSettings && _settings?.LockTenantTemplate != true;
    private bool CanEditDescription => CanEditSettings && _settings?.LockTenantDescription != true;
    private bool CanEditSocialLinks => CanEditSettings && _settings?.LockTenantSocialLinks != true;
    private bool CanEditCopyright => CanEditSettings && _settings?.LockTenantCopyright != true;
    private bool CanManageLinkGroups => _settings?._links?.ContainsKey("manage-link-groups") == true;

    private Task OnEnabledChangedAsync(bool value)
    {
        if (!CanEditSettings) return Task.CompletedTask;
        _enabled = value;
        return SaveImmediatelyAsync(CreateGeneralPatch());
    }

    private Task OnShowCookieSettingsLinkChangedAsync(bool value)
    {
        if (!CanEditSettings) return Task.CompletedTask;
        _showCookieSettingsLink = value;
        return SaveImmediatelyAsync(CreateGeneralPatch());
    }

    private Task OnTemplateChangedAsync(string value)
    {
        if (!CanEditTemplate) return Task.CompletedTask;
        _template = value;
        return SaveImmediatelyAsync(new PatchTenantFooterSettingsDto
        {
            Template = new PatchTenantFooterTemplateDto
            {
                Value = StringUpdate(_template)
            }
        });
    }

    private Task OnShowDescriptionChangedAsync(bool value)
    {
        if (!CanEditDescription) return Task.CompletedTask;
        CancelDebounce(ref _descriptionDebounceCts);
        _showDescription = value;
        return SaveImmediatelyAsync(CreateDescriptionPatch());
    }

    private Task OnDescriptionTextChanged(string value)
    {
        if (!CanEditDescription) return Task.CompletedTask;
        _descriptionText = value ?? string.Empty;
        ScheduleDescriptionSave();
        return Task.CompletedTask;
    }

    private Task OnShowSocialLinksChangedAsync(bool value)
    {
        if (!CanEditSocialLinks) return Task.CompletedTask;
        CancelDebounce(ref _socialLinksDebounceCts);
        _showSocialLinks = value;
        return SaveImmediatelyAsync(CreateSocialLinksPatch());
    }

    private Task OnSocialPlatformChanged(string value, int index)
    {
        if (!CanEditSocialLinks || index < 0 || index >= _socialLinks.Count) return Task.CompletedTask;
        _socialLinks[index].Platform = value;
        ScheduleSocialLinksSave();
        return Task.CompletedTask;
    }

    private Task OnSocialUrlChanged(string value, int index)
    {
        if (!CanEditSocialLinks || index < 0 || index >= _socialLinks.Count) return Task.CompletedTask;
        _socialLinks[index].Url = value ?? string.Empty;
        ScheduleSocialLinksSave();
        return Task.CompletedTask;
    }

    private Task OnSocialLabelChanged(string value, int index)
    {
        if (!CanEditSocialLinks || index < 0 || index >= _socialLinks.Count) return Task.CompletedTask;
        _socialLinks[index].Label = value ?? string.Empty;
        ScheduleSocialLinksSave();
        return Task.CompletedTask;
    }

    private Task OnCopyrightTextChanged(string value)
    {
        if (!CanEditCopyright) return Task.CompletedTask;
        _copyrightText = value ?? string.Empty;
        ScheduleCopyrightSave();
        return Task.CompletedTask;
    }

    private Task SaveImmediatelyAsync(PatchTenantFooterSettingsDto request)
    {
        var version = BeginSave();
        return SavePatchAsync(request, version, _lifetimeCts.Token);
    }

    private long BeginSave()
    {
        _saveStatusMessage = "Saving footer settings...";
        _saveErrorMessage = null;
        return ++_saveVersion;
    }

    private async Task SavePatchAsync(
        PatchTenantFooterSettingsDto request,
        long version,
        CancellationToken cancellationToken)
    {
        var lockTaken = false;
        try
        {
            await _saveLock.WaitAsync(cancellationToken);
            lockTaken = true;
            var response = await FooterService.PatchTenantFooterSettingsAsync(request, cancellationToken);

            if (!_disposed && version == _saveVersion)
            {
                if (response.Success == true)
                {
                    _saveStatusMessage = "Footer settings saved.";
                    _saveErrorMessage = null;
                }
                else
                {
                    _saveStatusMessage = null;
                    _saveErrorMessage = response.Message ?? "Failed to save footer settings.";
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (!_disposed && version == _saveVersion)
            {
                _saveStatusMessage = null;
                _saveErrorMessage = "An error occurred while saving footer settings.";
            }
        }
        finally
        {
            if (lockTaken)
            {
                _saveLock.Release();
            }

            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private PatchTenantFooterSettingsDto CreateGeneralPatch() => new()
    {
        General = new PatchTenantFooterGeneralDto
        {
            Enabled = BooleanUpdate(_enabled),
            ShowCookieSettingsLink = BooleanUpdate(_showCookieSettingsLink)
        }
    };

    private PatchTenantFooterSettingsDto CreateDescriptionPatch() => new()
    {
        Description = new PatchTenantFooterDescriptionDto
        {
            Show = BooleanUpdate(_showDescription),
            Text = StringUpdate(_descriptionText)
        }
    };

    private PatchTenantFooterSettingsDto CreateSocialLinksPatch() => new()
    {
        SocialLinks = new PatchTenantFooterSocialLinksDto
        {
            Show = BooleanUpdate(_showSocialLinks),
            Items = new OptionalUpdateOfIReadOnlyListOfFooterSocialLinkDto
            {
                HasValue = true,
                Value = _socialLinks.Select(link => new FooterSocialLinkDto
                {
                    Platform = link.Platform,
                    Url = link.Url,
                    Label = link.Label
                }).ToList()
            }
        }
    };

    private PatchTenantFooterSettingsDto CreateCopyrightPatch() => new()
    {
        Copyright = new PatchTenantFooterCopyrightDto
        {
            Text = StringUpdate(_copyrightText)
        }
    };

    private static OptionalUpdateOfboolean BooleanUpdate(bool value) => new() { HasValue = true, Value = value };
    private static OptionalUpdateOfstring StringUpdate(string value) => new() { HasValue = true, Value = value };

    private void ScheduleDescriptionSave()
    {
        CancelDebounce(ref _descriptionDebounceCts);
        _descriptionDebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _descriptionSaveVersion = BeginSave();
        _ = RunDescriptionDebounceAsync(_descriptionDebounceCts, _descriptionSaveVersion);
    }

    private async Task RunDescriptionDebounceAsync(CancellationTokenSource source, long version)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, source.Token);
            if (ReferenceEquals(_descriptionDebounceCts, source))
            {
                _descriptionDebounceCts = null;
            }
            await SavePatchAsync(CreateDescriptionPatch(), version, source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
        }
        finally
        {
            source.Dispose();
        }
    }

    private Task FlushDescriptionSaveAsync()
    {
        if (_descriptionDebounceCts is null) return Task.CompletedTask;
        var version = _descriptionSaveVersion;
        CancelDebounce(ref _descriptionDebounceCts);
        return SavePatchAsync(CreateDescriptionPatch(), version, _lifetimeCts.Token);
    }

    private void ScheduleSocialLinksSave()
    {
        CancelDebounce(ref _socialLinksDebounceCts);
        _socialLinksDebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _socialLinksSaveVersion = BeginSave();
        _ = RunSocialLinksDebounceAsync(_socialLinksDebounceCts, _socialLinksSaveVersion);
    }

    private async Task RunSocialLinksDebounceAsync(CancellationTokenSource source, long version)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, source.Token);
            if (ReferenceEquals(_socialLinksDebounceCts, source))
            {
                _socialLinksDebounceCts = null;
            }
            await SavePatchAsync(CreateSocialLinksPatch(), version, source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
        }
        finally
        {
            source.Dispose();
        }
    }

    private Task FlushSocialLinksSaveAsync()
    {
        if (_socialLinksDebounceCts is null) return Task.CompletedTask;
        var version = _socialLinksSaveVersion;
        CancelDebounce(ref _socialLinksDebounceCts);
        return SavePatchAsync(CreateSocialLinksPatch(), version, _lifetimeCts.Token);
    }

    private void ScheduleCopyrightSave()
    {
        CancelDebounce(ref _copyrightDebounceCts);
        _copyrightDebounceCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _copyrightSaveVersion = BeginSave();
        _ = RunCopyrightDebounceAsync(_copyrightDebounceCts, _copyrightSaveVersion);
    }

    private async Task RunCopyrightDebounceAsync(CancellationTokenSource source, long version)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, source.Token);
            if (ReferenceEquals(_copyrightDebounceCts, source))
            {
                _copyrightDebounceCts = null;
            }
            await SavePatchAsync(CreateCopyrightPatch(), version, source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
        }
        finally
        {
            source.Dispose();
        }
    }

    private Task FlushCopyrightSaveAsync()
    {
        if (_copyrightDebounceCts is null) return Task.CompletedTask;
        var version = _copyrightSaveVersion;
        CancelDebounce(ref _copyrightDebounceCts);
        return SavePatchAsync(CreateCopyrightPatch(), version, _lifetimeCts.Token);
    }

    private static void CancelDebounce(ref CancellationTokenSource? source)
    {
        var pending = source;
        source = null;
        if (pending is null) return;
        pending.Cancel();
    }

    // ── Social Links ──────────────────────────────────────────────────────

    private Task AddSocialLink()
    {
        if (!CanEditSocialLinks) return Task.CompletedTask;
        _socialLinks.Add(new FooterSocialLinkDto
        {
            Platform = "facebook",
            Url = string.Empty,
            Label = string.Empty
        });
        ScheduleSocialLinksSave();
