@using Explore.Blazor.Client.Services.Docking
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using MudBlazor
@implements IDisposable
@implements IAsyncDisposable
@inject DockLayoutState DockLayoutState
@inject IAccessibilityFocusService AccessibilityFocusService
@inject IScrollManager ScrollManager

@if (RenderedEntries.Count > 0)
{
    <div class="@RootClass"
         data-testid="@DataTestId"
         data-dock-scope="@ScopeName"
         aria-live="polite"
         tabindex="-1"
         @onkeydown="HandleKeyDownAsync">
        <button type="button"
                class="@BackdropClass"
                data-testid="dock-overlay-backdrop"
                aria-label="Close dock overlay"
                @onclick="CloseActiveOverlayAsync"></button>
        <MudFocusTrap Disabled="@(ActiveOverlayEntries.Count == 0)" DefaultFocus="DefaultFocus.FirstChild">
            @foreach (var entry in RenderedEntries)
            {
                <div @key="entry.Descriptor.Id" class="@GetSlotClass(entry)" data-dock-overlay-side="@entry.Descriptor.Side.ToString().ToLowerInvariant()">
                    <DockPanelHost Entry="@entry" IsModal="true" />
                </div>
            }
        </MudFocusTrap>
    </div>
}

@code {
    [Parameter] public DockScope Scope { get; set; }
    [Parameter] public string DataTestId { get; set; } = "dock-overlay-host";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool IsMobile { get; set; }

    private const string BodyElementId = "body";
    private const string ScrollLockClass = "scroll-locked";
    private const int CloseAnimationDelayMilliseconds = 300;

    private readonly HashSet<DockPanelId> _closingPanelIds = [];
    private readonly HashSet<DockPanelId> _scheduledClosePanelIds = [];
    private IReadOnlyList<DockPanelEntry> _renderedEntries = [];
    private bool _overlayLifecycleActive;
    private bool _backdropClosing;
    private bool _scrollLocked;
    private bool _focusSaved;

    private IReadOnlyList<DockPanelEntry> ActiveOverlayEntries
    {
        get
        {
            var entries = Enum.GetValues<DockSide>()
                .SelectMany(side => DockLayoutState.GetPanels(Scope, side))
                .Where(IsOverlayEntry)
                .Select(GetEffectiveOverlayEntry)
                .OrderBy(entry => entry.State.Order)
                .ThenBy(entry => entry.Descriptor.Title, StringComparer.Ordinal)
                .ToArray();

            if (!IsMobile || entries.Length <= 1)
            {
                return entries;
            }

            var activeEntry = entries.LastOrDefault(entry => entry.State.IsActive)
                ?? entries.Last();

            return [activeEntry];
        }
    }

    private IReadOnlyList<DockPanelEntry> RenderedEntries => _renderedEntries;

    private bool ShouldLockScroll => ActiveOverlayEntries.Count > 0;

    private string ScopeName => Scope.ToString().ToLowerInvariant();

    private string RootClass => string.Join(' ', new[]
    {
        "dock-overlay-host",
        $"dock-overlay-host--{ScopeName}",
        _backdropClosing ? "dock-overlay-host--closing" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string BackdropClass => string.Join(' ', new[]
    {
        "dock-overlay-host__backdrop",
        _backdropClosing ? "dock-overlay-host__backdrop--closing" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override void OnInitialized()
    {
        DockLayoutState.Changed += OnDockLayoutChanged;
        SyncRenderedEntries(scheduleClosingAnimation: false);
    }

    protected override void OnParametersSet()
    {
        SyncRenderedEntries(scheduleClosingAnimation: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var activeOverlayOpen = ActiveOverlayEntries.Count > 0;
        var renderedOverlayOpen = RenderedEntries.Count > 0;

        if (ShouldLockScroll && !_scrollLocked)
        {
            await ScrollManager.LockScrollAsync(BodyElementId, ScrollLockClass);
            _scrollLocked = true;
        }
        else if (!ShouldLockScroll && _scrollLocked)
        {
            await ScrollManager.UnlockScrollAsync(BodyElementId, ScrollLockClass);
            _scrollLocked = false;
        }

        if (activeOverlayOpen && !_overlayLifecycleActive)
        {
            await ActivateOverlayAsync();
            _overlayLifecycleActive = true;
        }
        else if (!renderedOverlayOpen && _overlayLifecycleActive)
        {
            await DeactivateOverlayAsync();
            _overlayLifecycleActive = false;
        }
    }

    public void Dispose()
    {
        DockLayoutState.Changed -= OnDockLayoutChanged;
    }

    public async ValueTask DisposeAsync()
    {
        DockLayoutState.Changed -= OnDockLayoutChanged;
        await DeactivateOverlayAsync();
    }

    private string GetSlotClass(DockPanelEntry entry)
    {
        var sideName = entry.Descriptor.Side.ToString().ToLowerInvariant();
        var modeName = entry.State.Mode.ToString().ToLowerInvariant();
        var closingClass = _closingPanelIds.Contains(entry.Descriptor.Id)
            ? " dock-overlay-host__slot--closing"
            : string.Empty;

        return $"dock-overlay-host__slot dock-overlay-host__slot--{sideName} dock-overlay-host__slot--mode-{modeName}{closingClass}";
    }

    private bool IsOverlayEntry(DockPanelEntry entry)
    {
        if (!entry.State.IsOpen)
        {
            return false;
        }

        if (entry.State.Mode is DockMode.Overlay or DockMode.Temporary or DockMode.Inspector)
        {
            return true;
        }

        if (DockLayoutState.ShouldRenderDockedPanelAsOverlay(entry))
        {
            return entry.State.IsActive;
        }

        return false;
    }

    private DockPanelEntry GetEffectiveOverlayEntry(DockPanelEntry entry)
    {
        return DockLayoutState.ShouldRenderDockedPanelAsOverlay(entry)
            ? entry with { State = entry.State with { Mode = DockMode.Temporary } }
            : entry;
    }

    private void OnDockLayoutChanged()
    {
        SyncRenderedEntries(scheduleClosingAnimation: true);
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncRenderedEntries(bool scheduleClosingAnimation)
    {
        var activeEntries = ActiveOverlayEntries;
        var activeIds = activeEntries.Select(entry => entry.Descriptor.Id).ToHashSet();

        foreach (var activeId in activeIds)
        {
            _closingPanelIds.Remove(activeId);
            _scheduledClosePanelIds.Remove(activeId);
        }

        var closingEntries = _renderedEntries
            .Where(entry => !activeIds.Contains(entry.Descriptor.Id))
            .ToArray();

        foreach (var closingEntry in closingEntries)
        {
            _closingPanelIds.Add(closingEntry.Descriptor.Id);

            if (scheduleClosingAnimation && _scheduledClosePanelIds.Add(closingEntry.Descriptor.Id))
            {
                _ = RemoveClosedPanelAfterAnimationAsync(closingEntry.Descriptor.Id);
            }
        }

        _renderedEntries = activeEntries
            .Concat(closingEntries)
            .OrderBy(entry => entry.State.Order)
            .ThenBy(entry => entry.Descriptor.Title, StringComparer.Ordinal)
            .ToArray();
        _backdropClosing = activeEntries.Count == 0 && closingEntries.Length > 0;
    }

    private async Task RemoveClosedPanelAfterAnimationAsync(DockPanelId panelId)
    {
        await Task.Delay(CloseAnimationDelayMilliseconds);

        if (ActiveOverlayEntries.Any(entry => entry.Descriptor.Id == panelId))
        {
            _closingPanelIds.Remove(panelId);
            _scheduledClosePanelIds.Remove(panelId);
            return;
        }

        _renderedEntries = _renderedEntries
            .Where(entry => entry.Descriptor.Id != panelId)
            .ToArray();
        _closingPanelIds.Remove(panelId);
        _scheduledClosePanelIds.Remove(panelId);
        _backdropClosing = ActiveOverlayEntries.Count == 0 && _renderedEntries.Count > 0;

        if (_renderedEntries.Count == 0)
        {
            _backdropClosing = false;

            if (_overlayLifecycleActive)
            {
                await DeactivateOverlayAsync();
                _overlayLifecycleActive = false;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ActivateOverlayAsync()
    {
        if (!_focusSaved)
        {
            await AccessibilityFocusService.SaveFocusAsync();
            _focusSaved = true;
        }

        await AccessibilityFocusService.FocusAsync($"[data-testid='{DataTestId}'][data-dock-scope='{ScopeName}'] [data-testid='dock-panel-host']", preventScroll: true);
    }

    private async Task DeactivateOverlayAsync()
    {
        if (_scrollLocked)
        {
            await ScrollManager.UnlockScrollAsync(BodyElementId, ScrollLockClass);
            _scrollLocked = false;
        }

        if (_focusSaved)
        {
            await AccessibilityFocusService.RestoreFocusAsync("#main-content");
            _focusSaved = false;
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            await CloseActiveOverlayAsync();
        }
    }

    private async Task CloseActiveOverlayAsync()
    {
        var activeEntries = ActiveOverlayEntries;
        var entry = activeEntries.LastOrDefault(entry => entry.State.IsActive && entry.Descriptor.CanClose)
            ?? activeEntries.LastOrDefault(entry => entry.Descriptor.CanClose);

        if (entry is null)
        {
            return;
        }

        DockLayoutState.Close(entry.Descriptor.Id);
        await InvokeAsync(StateHasChanged);
    }
}
