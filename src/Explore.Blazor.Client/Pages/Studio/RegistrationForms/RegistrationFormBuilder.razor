    private async Task ReloadVersionAsync(Guid eventId, CancellationToken cancellationToken) =>
        await SelectVersionCoreAsync(eventId, _form!.Id, _version!.Id, cancellationToken);

    private async Task MutateAsync(Func<Guid, CancellationToken, Task> mutation, string success)
    {
        Guid eventId = EventId;
        CancellationToken token = CurrentToken;
        if (!IsCurrent(eventId, token)) return;
        _mutating = true;
        _error = null;
        _status = null;
        try
        {
            await mutation(eventId, token);
            token.ThrowIfCancellationRequested();
            if (!IsCurrent(eventId, token)) return;
            _status = success;
            await Announcer.AnnouncePoliteAsync(success);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (!IsCurrent(eventId, token)) return;
            _error = T("mutation_failed", "The form changed or the action is no longer available. Reload and try again.");
            await Announcer.AnnounceAssertiveAsync(_error);
        }
        finally
        {
            if (IsCurrent(eventId, token)) _mutating = false;
        }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string yesText)
    {
        await FocusService.SaveFocusAsync();
        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(title, message, yesText: yesText,
                cancelText: T("common.cancel", "Cancel"), options: DialogOptionsFactory.Confirmation());
            return confirmed == true;
        }
        finally
        {
            await FocusService.RestoreFocusAsync();
        }
    }

    private CancellationToken CurrentToken => _requestCancellation?.Token ?? default;
    private bool IsCurrent(Guid eventId, CancellationToken token) =>
        !_disposed && !token.IsCancellationRequested && eventId == EventId && eventId == _loadedEventId;

    private void ResetState()
    {
        _workflow = null;
        _form = null;
        _version = null;
        _preflight = null;
        _templates = [];
        _formId = Guid.Empty;
        _versionId = Guid.Empty;
        _templateId = Guid.Empty;
        _error = null;
        _status = null;
        _mutating = false;
        ClearDragState();
        CancelEditors();
    }

    private void CancelEditors()
    {
        CancelSectionEdit();
        CancelFieldEdit();
        CancelOptionEdit();
        CancelRuleEdit();
    }

    private void CancelPendingRequests()
    {
        CancellationTokenSource? cancellation = _requestCancellation;
        _requestCancellation = null;
        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    private static string SectionMoveId(Guid id, int delta) => $"section-{id:N}-move-{(delta < 0 ? "up" : "down")}";
    private static string FieldMoveId(Guid id, int delta) => $"field-{id:N}-move-{(delta < 0 ? "up" : "down")}";
    private static string Slug(string value) => string.Join('-', value.Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));
    private async Task<IReadOnlyList<TemplateOption>> LoadTemplatesAsync(CancellationToken cancellationToken)
    {
        try
        {
            return ExtractTemplates(await Authoring.GetTemplatesAsync(cancellationToken));
        }
        catch (Exception) when (!cancellationToken.IsCancellationRequested)
        {
            return [];
        }
    }

    private static IReadOnlyList<TemplateOption> ExtractTemplates(HalCollectionResourceOfRegistrationFormTemplateDto collection) =>
        collection._embedded?.Items?.Select(TemplateOption.From).Where(item => item.InstantiateLink is not null).ToArray() ?? [];
    private string T(string key, string fallback) => Translation.T($"studio.registration_forms.{key}", fallback);
    private string F(string key, string fallback, params object?[] values) =>
        string.Format(CultureInfo.CurrentCulture, T(key, fallback), values);

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        CancelPendingRequests();
        GC.SuppressFinalize(this);
    }

    private sealed class OptionEditorState
    {
        public required RegistrationFormSectionDto Section { get; init; }
        public required RegistrationFormFieldDto Field { get; init; }
        public RegistrationFormFieldOptionDto? Option { get; init; }
        public int Ordinal { get; set; }
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public bool IsValid => Ordinal > 0 && !string.IsNullOrWhiteSpace(Key) && !string.IsNullOrWhiteSpace(Label);

        public static OptionEditorState Create(RegistrationFormSectionDto section, RegistrationFormFieldDto field) => new()
        {
            Section = section, Field = field, Ordinal = field.Options.Count + 1
        };

        public static OptionEditorState From(RegistrationFormSectionDto section, RegistrationFormFieldDto field, RegistrationFormFieldOptionDto option) => new()
        {
            Section = section, Field = field, Option = option, Ordinal = option.Ordinal, Key = option.Key, Label = option.Label
        };
    }

    private sealed class TemplateOption
    {
        private static readonly JsonSerializerOptions Options = new() { PropertyNameCaseInsensitive = true };
        public Guid Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public Dictionary<string, HalLink>? Links { get; init; }
        public HalLink? InstantiateLink => Links?.TryGetValue("instantiate", out HalLink? link) == true ? link : null;

        public static TemplateOption From(object item)
        {
            JsonElement element = item is JsonElement json ? json : JsonSerializer.SerializeToElement(item, Options);
            Dictionary<string, HalLink>? links = element.TryGetProperty("_links", out JsonElement linkElement)
                ? linkElement.Deserialize<Dictionary<string, HalLink>>(Options)
                : null;
            return new TemplateOption
            {
                Id = element.GetProperty("id").GetGuid(),
                Name = element.GetProperty("name").GetString() ?? string.Empty,
                Links = links
            };
        }
    }
}
