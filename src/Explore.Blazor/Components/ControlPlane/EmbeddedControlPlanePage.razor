@page "/admin/instance"
@page "/admin/instance/tenants"
@page "/admin/instance/tenants/{TenantId:guid}/configuration"
@page "/admin/instance/domains"
@page "/admin/instance/operations"
@page "/admin/instance/plans"
@page "/admin/instance/plans/{Key}"
@using Explore.Blazor.Client.Pages.Admin.Instance
@using Explore.Blazor.Client.Pages.Admin.Instance.ControlPlane
@using Explore.Blazor.Client.Routing.ControlPlane
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Navigation

@if (TenantId is { } tenantId)
{
    <InstanceTenantConfiguration TenantId="@tenantId" />
}
else if (!string.IsNullOrWhiteSpace(Key))
{
    <InstancePlanDetail Key="@Key" />
}
else
{
    switch (CurrentPath)
    {
        case ControlPlaneRoutes.Overview:
            <ControlPlaneOverviewPage />
            break;
        case ControlPlaneRoutes.Tenants:
            <InstanceTenants />
            break;
        case ControlPlaneRoutes.Domains:
            <ControlPlaneDomainsPage />
            break;
        case ControlPlaneRoutes.Operations:
            <ControlPlaneOperationsPage />
            break;
        case ControlPlaneRoutes.Plans:
            <InstancePlans />
            break;
    }
}

@code {
    [Parameter]
    public Guid? TenantId { get; set; }

    [Parameter]
    public string? Key { get; set; }

    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
}
