@using MudBlazor
@using MudBlazor.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Pages.Events.Components

@* ── Mobile Filter Drawer (left sidebar, MangaDex-style) ── *@
<MudOverlay Visible="_mobileDrawerOpen"
            DarkBackground="true"
            LockScroll="true"
            OnClick="CloseMobileDrawer"
            Class="filter-bar__drawer-overlay"
            ZIndex="1299" />

<MudDrawer Open="_mobileDrawerOpen"
           OpenChanged="OnMobileDrawerOpenChanged"
           Anchor="Anchor.Start"
           Variant="DrawerVariant.Temporary"
           Overlay="false"
           Elevation="2"
           Width="min(92vw, 26rem)"
           Class="filter-bar__mobile-drawer">

    <MudDrawerHeader Class="filter-bar__drawer-header">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <MudText Typo="Typo.h6" Style="font-weight: 700;">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" Style="vertical-align: middle;" />
                Filters
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="CloseMobileDrawer"
                           aria-label="Close filters" />
        </div>
    </MudDrawerHeader>

    <div class="filter-bar__drawer-body">
        <div class="filter-bar__filters filter-bar__filters--vertical">

            @* ── Core Filters (vertical layout for drawer) ── *@
            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Date Range</div>
                <MudDateRangePicker @bind-DateRange="SelectedDateRange"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    Placeholder="Any Time"
                                    Clearable="true"
                                    AdditionalDateClassesFunc="GetDateClasses"
                                    AutoClose="true"
                                    Dense="true" />
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Format</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedFormatIds" MultiSelectionTextFunc="FormatSelectedFormats" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var format in EventFormats)
                    {
                        <MudSelectItem T="int" Value="@(format.Id.GetValueOrDefault())">@format.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Type</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedEventTypeIds" MultiSelectionTextFunc="FormatSelectedEventTypes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var type in EventTypes)
                    {
                        <MudSelectItem T="int" Value="@(type.Id.GetValueOrDefault())">@type.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Madhab</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedMadhabIds" MultiSelectionTextFunc="FormatSelectedMadhabs" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var madhab in Madhabs)
                    {
                        <MudSelectItem T="int" Value="@(madhab.Id.GetValueOrDefault())">@madhab.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Registration</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedRegistrationModeIds" MultiSelectionTextFunc="FormatSelectedRegistrationModes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var mode in RegistrationModes)
                    {
                        <MudSelectItem T="int" Value="@(mode.Id.GetValueOrDefault())">@mode.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Language</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedLanguageIds" MultiSelectionTextFunc="FormatSelectedLanguages" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var language in Languages)
                    {
                        <MudSelectItem T="int" Value="@(language.Id.GetValueOrDefault())">@language.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Gender</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceGenderIds" MultiSelectionTextFunc="FormatSelectedAudienceGenders" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var gender in AudienceGenders)
                    {
                        <MudSelectItem T="int" Value="@(gender.Id.GetValueOrDefault())">@gender.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Age</div>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceAgeIds" MultiSelectionTextFunc="FormatSelectedAudienceAges" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    @foreach (var age in AudienceAges)
                    {
                        <MudSelectItem T="int" Value="@(age.Id.GetValueOrDefault())">@age.FullName</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Sort By</div>
                <MudSelect T="string" @bind-Value="SelectedSortBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                    <MudSelectItem Value="@("date")">Date</MudSelectItem>
                    <MudSelectItem Value="@("title")">Title</MudSelectItem>
                    <MudSelectItem Value="@("popularity")">Popularity</MudSelectItem>
                    <MudSelectItem Value="@("created")">Recently Added</MudSelectItem>
                </MudSelect>
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Category</div>
                @if (_isMobile)
                {
                    <TriStateCategoryFilterDropdown @ref="_categoryFilterDropdown" CategoryGroups="@CategoryGroups" />
                }
            </div>

            <div class="filter-bar__filter-item filter-bar__filter-item--full">
                <div class="filter-bar__label">Tags</div>
                @if (_isMobile)
                {
                    <TriStateTagFilterDropdown @ref="_tagFilterDropdown" TagGroups="@TagGroups" />
                }
            </div>

            @* ── Islamic Aspect Filters (conditional) ── *@
            @if (IsIslamicModuleEnabled)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.overline" Class="px-1" Style="font-weight: 600;">Islamic Filters</MudText>

                <div class="filter-bar__filter-item filter-bar__filter-item--full">
                    <div class="filter-bar__label">Gender Mode</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedGenderModeIds" MultiSelectionTextFunc="FormatSelectedGenderModes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                        @foreach (GenderSegregationMode item in Enum.GetValues(typeof(GenderSegregationMode)))
                        {
                            <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item filter-bar__filter-item--full">
                    <div class="filter-bar__label">Prayer Time</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedReferencePrayerIds" MultiSelectionTextFunc="FormatSelectedPrayerTimes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                        @foreach (PrayerTime item in Enum.GetValues(typeof(PrayerTime)))
                        {
                            <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            }

            @* ── Tech Aspect Filters (conditional) ── *@
            @if (IsTechModuleEnabled)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.overline" Class="px-1" Style="font-weight: 600;">Tech Filters</MudText>

                <div class="filter-bar__filter-item filter-bar__filter-item--full">
                    <div class="filter-bar__label">Skill Level</div>
                    <MudSelect T="SkillLevel?" @bind-Value="SelectedSkillLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative" Clearable="true">
                        <MudSelectItem T="SkillLevel?" Value="@((SkillLevel?)null)">Any</MudSelectItem>
                        @foreach (SkillLevel item in Enum.GetValues(typeof(SkillLevel)))
                        {
                            <MudSelectItem Value="@((SkillLevel?)item)">@item.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item filter-bar__filter-item--full">
                    <div class="filter-bar__label">Tech Stack</div>
                    <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="TechStackTag" Margin="Margin.Dense" Dense="true" Placeholder="e.g. React, .NET" DebounceInterval="500" />
                </div>
            }
        </div>
    </div>

    @* ── Drawer Footer: Active count + Clear All + Apply ── *@
    <div class="filter-bar__drawer-footer">
        @{ var drawerActiveCount = GetActiveFilterCount(); }
        @if (drawerActiveCount > 0)
        {
            <MudButton Elevation="0" Variant="Variant.Text"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ClearAll"
                       OnClick="ClearAllFilters"
                       FullWidth="true"
                       Class="mb-2">
                Clear All (@drawerActiveCount)
            </MudButton>
        }
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search"
                   OnClick="ApplyMobileFilters"
                   FullWidth="true"
                   Size="Size.Large">
            Apply Filters
        </MudButton>
    </div>
</MudDrawer>

@* ── Inline Filter Bar ── *@
<div class="filter-bar">

    @* ── Primary Action Row: Search + Filters Toggle + Search Button ── *@
    <div class="filter-bar__primary-row">
        <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="SearchTerm"
                      Placeholder="Search events..."
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnKeyDown="HandleSearchKeyDownAsync"
                      Class="filter-bar__search-field" />

        @* ── Desktop: filled button with expand/collapse ── *@
        @if (!_isMobile)
        {
            <MudButton Elevation="0" Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       OnClick="ToggleFilters"
                       Size="Size.Medium"
                       Class="filter-bar__toggle-btn">
                @if (GetActiveFilterCount() > 0)
                {
                    <MudBadge Content="@GetActiveFilterCount()" Color="Color.Primary" Overlap="true" Bordered="true">
                        <span>Filters</span>
                    </MudBadge>
                }
                else
                {
                    <span>Filters</span>
                }
            </MudButton>
        }

        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search"
                   OnClick="SearchAsync"
                   Size="Size.Medium"
                   Class="filter-bar__search-btn">
            Search
        </MudButton>
    </div>

    @* ── Desktop: Collapsible Filter Panel ── *@
    @if (!_isMobile)
    {
        <MudCollapse Expanded="_filtersExpanded">
            <div class="filter-bar__panel">
                <div class="filter-bar__filters">

                    @* ── Core Filters ── *@
                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Date Range</div>
                        <MudDateRangePicker @bind-DateRange="SelectedDateRange"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            Placeholder="Any Time"
                                            Clearable="true"
                                            AdditionalDateClassesFunc="GetDateClasses"
                                            AutoClose="true"
                                            Dense="true" />
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Format</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedFormatIds" MultiSelectionTextFunc="FormatSelectedFormats" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var format in EventFormats)
                            {
                                <MudSelectItem T="int" Value="@(format.Id.GetValueOrDefault())">@format.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Type</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedEventTypeIds" MultiSelectionTextFunc="FormatSelectedEventTypes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var type in EventTypes)
                            {
                                <MudSelectItem T="int" Value="@(type.Id.GetValueOrDefault())">@type.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Madhab</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedMadhabIds" MultiSelectionTextFunc="FormatSelectedMadhabs" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var madhab in Madhabs)
                            {
                                <MudSelectItem T="int" Value="@(madhab.Id.GetValueOrDefault())">@madhab.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Registration</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedRegistrationModeIds" MultiSelectionTextFunc="FormatSelectedRegistrationModes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var mode in RegistrationModes)
                            {
                                <MudSelectItem T="int" Value="@(mode.Id.GetValueOrDefault())">@mode.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Language</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedLanguageIds" MultiSelectionTextFunc="FormatSelectedLanguages" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var language in Languages)
                            {
                                <MudSelectItem T="int" Value="@(language.Id.GetValueOrDefault())">@language.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Gender</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceGenderIds" MultiSelectionTextFunc="FormatSelectedAudienceGenders" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var gender in AudienceGenders)
                            {
                                <MudSelectItem T="int" Value="@(gender.Id.GetValueOrDefault())">@gender.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Age</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceAgeIds" MultiSelectionTextFunc="FormatSelectedAudienceAges" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            @foreach (var age in AudienceAges)
                            {
                                <MudSelectItem T="int" Value="@(age.Id.GetValueOrDefault())">@age.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Sort By</div>
                        <MudSelect T="string" @bind-Value="SelectedSortBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                            <MudSelectItem Value="@("date")">Date</MudSelectItem>
                            <MudSelectItem Value="@("title")">Title</MudSelectItem>
                            <MudSelectItem Value="@("popularity")">Popularity</MudSelectItem>
                            <MudSelectItem Value="@("created")">Recently Added</MudSelectItem>
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Category</div>
                        @if (!_isMobile)
                        {
                            <TriStateCategoryFilterDropdown @ref="_categoryFilterDropdown" CategoryGroups="@CategoryGroups" />
                        }
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Tags</div>
                        @if (!_isMobile)
                        {
                            <TriStateTagFilterDropdown @ref="_tagFilterDropdown" TagGroups="@TagGroups" />
                        }
                    </div>

                    @* ── Islamic Aspect Filters (conditional) ── *@
                    @if (IsIslamicModuleEnabled)
                    {
                        <div class="filter-bar__filter-item">
                            <div class="filter-bar__label">Gender Mode</div>
                            <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedGenderModeIds" MultiSelectionTextFunc="FormatSelectedGenderModes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                                @foreach (GenderSegregationMode item in Enum.GetValues(typeof(GenderSegregationMode)))
                                {
                                    <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        <div class="filter-bar__filter-item">
                            <div class="filter-bar__label">Prayer Time</div>
                            <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedReferencePrayerIds" MultiSelectionTextFunc="FormatSelectedPrayerTimes" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative">
                                @foreach (PrayerTime item in Enum.GetValues(typeof(PrayerTime)))
                                {
                                    <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    }

                    @* ── Tech Aspect Filters (conditional) ── *@
                    @if (IsTechModuleEnabled)
                    {
                        <div class="filter-bar__filter-item">
                            <div class="filter-bar__label">Skill Level</div>
                            <MudSelect T="SkillLevel?" @bind-Value="SelectedSkillLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" DropdownWidth="DropdownWidth.Relative" Clearable="true">
                                <MudSelectItem T="SkillLevel?" Value="@((SkillLevel?)null)">Any</MudSelectItem>
                                @foreach (SkillLevel item in Enum.GetValues(typeof(SkillLevel)))
                                {
                                    <MudSelectItem Value="@((SkillLevel?)item)">@item.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        <div class="filter-bar__filter-item">
                            <div class="filter-bar__label">Tech Stack</div>
                            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="TechStackTag" Margin="Margin.Dense" Dense="true" Placeholder="e.g. React, .NET" DebounceInterval="500" />
                        </div>
                    }
                </div>

            </div>
        </MudCollapse>
    }

    @{ var activeCount = GetActiveFilterCount(); }
    <div class="filter-bar__layout-row">
        @if (!_isMobile && activeCount > 0)
        {
            <div class="filter-bar__active-summary">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">
                    @activeCount active @(activeCount == 1 ? "filter" : "filters")
                </MudChip>
                <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearAllFilters">
                    Clear All
                </MudButton>
                @if (ShowResultCount)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="filter-bar__result-count">
                        @ResultCount @(ResultCount == 1 ? "event" : "events") found
                    </MudText>
                }
            </div>
        }
        else if (ShowResultCount)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="filter-bar__result-count">
                @ResultCount @(ResultCount == 1 ? "event" : "events") found
            </MudText>
        }

        <div class="filter-bar__layout-controls">
            @if (_isMobile)
            {
                <MudBadge Content="@activeCount"
                          Color="Color.Primary"
                          Overlap="true"
                          Bordered="true"
                          Visible="@(activeCount > 0)">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                   Color="@(_mobileDrawerOpen ? Color.Primary : Color.Default)"
                                   OnClick="ToggleFilters"
                                   Size="Size.Medium"
                                   aria-label="Open filters" />
                </MudBadge>
            }
            @if (ShowCustomizationButton)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                               Color="Color.Default"
                               Size="Size.Medium"
                               OnClick="@(() => OnCustomizationRequested.InvokeAsync())"
                               aria-label="Customize view" />
            }
            <MudToggleGroup T="LayoutMode" Value="CurrentLayout" ValueChanged="OnLayoutChanged"
                            Size="Size.Medium" Color="Color.Primary"
                            Class="filter-bar__layout-switcher">
                <MudToggleItem Value="@LayoutMode.SingleRow" Title="Single Row">
                    <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Medium" />
                </MudToggleItem>
                <MudToggleItem Value="@LayoutMode.DetailedList" Title="Detailed List">
                    <MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Medium" />
                </MudToggleItem>
                <MudToggleItem Value="@LayoutMode.CompactGrid" Title="Compact Grid">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Medium" />
                </MudToggleItem>
            </MudToggleGroup>
        </div>
    </div>

</div>
