<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HotReloadAutoRestart>true</HotReloadAutoRestart>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.DevTunnels" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Infisical.Sdk" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Event.MigrationService\Event.MigrationService.csproj" />
    <ProjectReference Include="..\Event.Standalone\Event.Standalone.csproj" />
    <ProjectReference Include="..\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\Explore.Blazor\Explore.Blazor.csproj" />
    <ProjectReference Include="..\Explore.Infrastructure\Explore.Infrastructure.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Explore.Secrets\Explore.Secrets.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
