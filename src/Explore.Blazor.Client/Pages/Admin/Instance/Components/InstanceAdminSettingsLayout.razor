    private void AddLocalAccountsNavItem(List<NavItem> navItems)
    {
        if (!_localAccountsAvailable)
            return;
        int authenticationIndex = navItems.FindIndex(item => item.Key == "auth-providers");
        navItems.Insert(authenticationIndex + 1, new NavItem(
            Key: "local-accounts", Icon: Icons.Material.Filled.ManageAccounts,
            Label: Translations.T("instance.localAccounts.heading", "Local accounts")));
    }

    private void OnLocalAccountsLanguageChanged(string languageCode)
    {
        if (!_localAccountsDisposed)
            _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_localAccountsDisposed)
            return;
        _localAccountsDisposed = true;
        Translations.OnLanguageChanged -= OnLocalAccountsLanguageChanged;
        _localAccountsLifetime.Cancel();
        _localAccountsLifetime.Dispose();
    }

    /// <summary>
    /// The scheduler item exists only when the server actually served its resource. Availability is a server fact
    /// here — a host may run with the scheduler administration API switched off — so it is discovered rather than
    /// inferred from the signed-in administrator's claims.
    /// </summary>
    private void AddSchedulerNavItem(List<NavItem> navItems)
    {
        if (!_schedulerAvailable)
        {
            return;
        }

        var developerIndex = navItems.FindIndex(item => item.Group == "Developer");
        var schedulerItem = new NavItem(
            "scheduler",
            Icons.Material.Filled.Schedule,
            "Background Scheduler",
            Group: "Operations");

        if (developerIndex < 0)
        {
            navItems.Add(schedulerItem);
            return;
        }

        navItems.Insert(developerIndex, schedulerItem);
    }

    private void SelectSection(string section)
    {
        _currentSection = section;
        _showMobileMenu = false;
    }

    private void ApplySectionFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var section = ParseSectionFromQuery(uri.Query);
        if (section is null)
        {
            return;
        }

        var navItems = BuildNavItems(IsSingleTenantMode);
        if (!navItems.Any(item => string.Equals(item.Key, section, StringComparison.Ordinal)))
        {
            return;
        }

        _currentSection = section;
        _showMobileMenu = false;
    }

    private static string? ParseSectionFromQuery(string query)
    {
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }

        var trimmed = query.StartsWith('?') ? query[1..] : query;
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(pair[..eq]);
            if (!string.Equals(key, "section", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = Uri.UnescapeDataString(pair[(eq + 1)..]);
            return string.IsNullOrWhiteSpace(value) ? null : value;
        }

        return null;
    }
    
    private void BackToMenu()
    {
        _showMobileMenu = true;
    }

    private void ReloadSettings()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task<bool> EnsureFreshAuthSessionAsync()
    {
        if (await InstanceOnboardingService.RefreshAuthSessionAsync())
        {
            return true;
        }

        _errorMessage = "Your admin session needs to be refreshed before saving. Please reload the page and try again.";
        return false;
    }

    private bool ShouldOpenAiAssistantAfterSave() =>
        _currentSection == "ai"
        && _aiAssistant.Enabled == true;

    private async Task RefreshShellExperienceAsync(bool openAiAssistantIfAvailable = false)
    {
        PublicExperienceService.ResetCache();

        var settings = await PublicExperienceService.GetSettingsAsync();
        if (settings is not null)
        {
            AiAssistantState.SetPolicy(
                settings.IsAiAssistantEnabled == true,
                settings.IsAiAssistantAvailable == true,
                settings.AiAssistantAllowAnonymousAccess == true,
                isAuthenticated: true);

            if (openAiAssistantIfAvailable && settings.IsAiAssistantAvailable == true)
            {
                AiAssistantState.Open();
            }
        }
    }

    private string GetNavItemClass(string section)
    {
        return _currentSection == section ? "settings-nav-active" : "";
    }
