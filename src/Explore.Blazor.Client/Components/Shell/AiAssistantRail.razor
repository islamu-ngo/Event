    private async Task LoadBootstrapAsync()
    {
        var bootstrap = await ClientService.GetBootstrapAsync();
        _actorOptions = BuildActorOptions(bootstrap);

        if (_actorOptions.Count == 0)
        {
            _selectedActorId = null;
        }
        else if (_selectedActorId is not Guid selectedActorId
                 || !_actorOptions.Any(actor => actor.ActorId == selectedActorId))
        {
            _selectedActorId = _actorOptions[0].ActorId;
        }

        var models = bootstrap?.Models?
            .Where(model => !string.IsNullOrWhiteSpace(model.Id))
            .GroupBy(model => model.Id!, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .Select(model => new AiRailModelOption(model.Id!.Trim(), FormatModelDisplayName(model)))
            .ToArray() ?? [];

        _modelOptions = models;

        if (_modelOptions.Count == 0)
        {
            _selectedModelId = string.Empty;
            return;
        }

        var defaultModelId = bootstrap?.DefaultModelId?.Trim();
        if (!string.IsNullOrWhiteSpace(defaultModelId)
            && _modelOptions.Any(model => string.Equals(model.Id, defaultModelId, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedModelId = defaultModelId;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedModelId)
            || !_modelOptions.Any(model => string.Equals(model.Id, _selectedModelId, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedModelId = _modelOptions[0].Id;
        }
    }

    private static IReadOnlyList<AiConversationComposer.ActorOption> BuildActorOptions(HalResourceOfAiAssistantBootstrapDto? bootstrap)
    {
        return bootstrap?.ActorContexts?
            .Where(actor => actor.ActorId is Guid actorId && actorId != Guid.Empty)
            .GroupBy(actor => actor.ActorId!.Value)
            .Select(group => group.First())
            .Select(actor => new AiConversationComposer.ActorOption(
                actor.ActorId!.Value,
                actor.ActorType?.Trim() ?? string.Empty,
                actor.ActorDisplayName?.Trim() ?? string.Empty))
            .Where(actor => !string.IsNullOrWhiteSpace(actor.ActorType)
                && !string.IsNullOrWhiteSpace(actor.ActorDisplayName))
            .ToArray() ?? [];
    }

