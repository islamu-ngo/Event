@using Explore.Blazor.Client.Contracts.Services.Shell
@using Explore.Blazor.Client.Services.Learning
@using Explore.Blazor.Client.Contracts.Services.Learning
@implements IWorkspaceNavigationProvider
@implements IDisposable
@inject NavigationManager Navigation
@inject ILearningTargetRegistry TourTargets

@if (_eventId is Guid eventId)
{
    <StudioEventNavigation EventId="eventId" />
}
else
{
    <nav class="studio-workspace-navigation" aria-label="@AriaLabel" data-testid="studio-workspace-navigation">
        <div id="learning-studio-actor" @ref="_tourActor">
            <StudioActorSwitcher />
        </div>
        <MudNavMenu Dense="false" Class="studio-workspace-navigation__menu px-2">
            <div class="studio-workspace-navigation__header">
                <MudText Typo="Typo.h6" Class="studio-workspace-navigation__title">Studio</MudText>
            </div>
            <MudNavLink Href="/studio"
                        Icon="@Icons.Material.Filled.Dashboard"
                        Match="NavLinkMatch.All">
                Overview
            </MudNavLink>
            <MudNavLink Href="/studio/events"
                        Icon="@Icons.Material.Filled.Event"
                        Match="NavLinkMatch.Prefix">
                Events
            </MudNavLink>
            <StudioAttendeesNavigationLink />
            <StudioOrdersNavigationLink />
        </MudNavMenu>
    </nav>
}

@code {
    private Guid? _eventId;
    private ElementReference _tourActor;

    [CascadingParameter(Name = "LearningPresentationContext")]
    public LearningPresentationContext? TourPresentation { get; set; }

    public string AriaLabel => "Studio navigation";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateEventContext();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        TourTargets.Remove(this);
        UpdateEventContext();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateEventContext()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        _eventId = segments.Length >= 3
            && segments[0].Equals("studio", StringComparison.OrdinalIgnoreCase)
            && segments[1].Equals("events", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[2], out var eventId)
                ? eventId
                : null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_eventId is null && TourPresentation is { Family: LearningTourFamily.Studio } presentation
            && !string.IsNullOrWhiteSpace(_tourActor.Id))
            TourTargets.Publish(this, presentation, false,
                new LearningTarget("studio.actor-context", "learning-studio-actor", _tourActor));
        else
            TourTargets.Remove(this);
    }

    public void Dispose()
    {
        TourTargets.Remove(this);
        Navigation.LocationChanged -= OnLocationChanged;
        GC.SuppressFinalize(this);
    }
}
