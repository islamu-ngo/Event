@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Contracts.Services.Lookup
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Components.Forms

@inject IEventAgendaItemService AgendaItemService
@inject IScheduleItemKindService KindService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.ViewAgenda" />
            <MudText Typo="Typo.h6">@(IsNew ? "Add Agenda Item" : "Edit Agenda Item")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingDetail)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm Model="@this" OnValidSubmit="Save">
                <FormSubmissionGuard State="@_submitState">
                <AppValidationSummary />
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_title"
                                  Label="Title"
                                  Placeholder="e.g. Opening Keynote, Workshop: AI Basics"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Title is required"
                                  FullWidth="true" />

                    <MudTextField T="string"
                                  @bind-Value="_description"
                                  Label="Description"
                                  Placeholder="Optional description"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  FullWidth="true" />

                    @* Day selector (if multi-day event) *@
                    @if (Days.Count > 0)
                    {
                        <MudSelect T="Guid?"
                                   @bind-Value="_selectedDayId"
                                   Label="Day"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   FullWidth="true">
                            @foreach (var day in Days.OrderBy(d => d.SortOrder))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)day.Id)">
                                    @(!string.IsNullOrEmpty(day.Label) ? day.Label : day.LocalDate?.ToString("MMM d"))
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @* Time fields *@
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudTimePicker @bind-Time="_startTime"
                                           Label="Start Time"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker @bind-Time="_endTime"
                                           Label="End Time"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    @* Room selector *@
                    @if (Rooms.Count > 0)
                    {
                        <MudSelect T="Guid?"
                                   @bind-Value="_selectedRoomId"
                                   Label="Room"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   FullWidth="true">
                            @foreach (var room in Rooms.OrderBy(r => r.SortOrder))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)room.Id)">
                                    @room.Name
                                    @if (room.Capacity > 0)
                                    {
                                        <span class="ml-1 mud-text-secondary">(@room.Capacity)</span>
                                    }
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @* Kind selector *@
                    @if (_kinds.Count > 0)
                    {
                        <MudSelect T="int?"
                                   @bind-Value="_selectedKindId"
                                   Label="Kind"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   FullWidth="true">
                            @foreach (var kind in _kinds)
                            {
                                <MudSelectItem T="int?" Value="@((int?)kind.Id)">@kind.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudNumericField T="int"
                                     @bind-Value="_sortOrder"
                                     Label="Sort Order"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1" />
                </MudStack>
                </FormSubmissionGuard>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel" Disabled="_submitState.IsSubmitting">Cancel</MudButton>
        <MudButton Elevation="0" Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save"
                   Disabled="_submitState.IsSubmitting">
            @if (_submitState.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsNew ? "Add" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid? ItemId { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public int InitialSortOrder { get; set; } = 1;
    [Parameter] public List<EventDayListDto> Days { get; set; } = new();
    [Parameter] public List<LocationRoomListDto> Rooms { get; set; } = new();
    [Parameter] public Guid? PreselectedDayId { get; set; }

    private bool _isLoadingDetail;
    
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    // Form fields
    private string _title = string.Empty;
    private string _description = string.Empty;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private Guid? _selectedDayId;
    private Guid? _selectedRoomId;
    private int? _selectedKindId;
    private int _sortOrder = 1;
    private Guid _concurrencyStamp;

    // Lookup data
    private List<ScheduleItemKindListDto> _kinds = new();

    protected override async Task OnInitializedAsync()
    {
        _sortOrder = InitialSortOrder;
        _selectedDayId = PreselectedDayId;

        // Load kinds lookup
        try
        {
            var kinds = await KindService.GetScheduleItemKindsAsync();
            _kinds = kinds?.ToList() ?? new List<ScheduleItemKindListDto>();
        }
        catch
        {
            // Non-critical: kinds are optional
        }

        if (!IsNew && ItemId.HasValue)
        {
            _isLoadingDetail = true;
            var item = await AgendaItemService.GetManagedAgendaItemByIdAsync(EventId, ItemId.Value);
            if (item != null)
            {
                _title = item.Title;
                _description = item.Description ?? string.Empty;
                _startTime = TimeSpan.FromMinutes(item.LocalStartMinuteOfDay ?? 0);
                _endTime = TimeSpan.FromMinutes(item.LocalEndMinuteOfDay ?? 0);
                _selectedDayId = item.EventDayId;
                _selectedRoomId = item.RoomId;
                _selectedKindId = item.KindId > 0 ? item.KindId : null;
                _sortOrder = item.SortOrder ?? 0;
                _concurrencyStamp = item.ConcurrencyStamp ?? Guid.Empty;
            }
            _isLoadingDetail = false;
        }
    }

    private async Task Save()
    {
        if (_submitState.IsSubmitting) return;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _submitState.Fail("Title is required.");
            return;
        }

        if (!_startTime.HasValue || !_endTime.HasValue)
        {
            _submitState.Fail("Start and end time are required.");
            return;
        }

        _submitState.Start();

        try
        {
            DateTimeOffset? dayDate = null;
            if (_selectedDayId.HasValue)
            {
                var selectedDay = Days.FirstOrDefault(d => d.Id == _selectedDayId.Value);
                dayDate = selectedDay?.LocalDate;
            }

            DateTimeOffset? startTime = null;
            DateTimeOffset? endTime = null;

            if (_startTime.HasValue)
            {
                var baseDate = dayDate?.DateTime ?? DateTime.Today;
                startTime = new DateTimeOffset(baseDate.Add(_startTime.Value), DateTimeOffset.Now.Offset);
            }
            if (_endTime.HasValue)
            {
                var baseDate = dayDate?.DateTime ?? DateTime.Today;
                endTime = new DateTimeOffset(baseDate.Add(_endTime.Value), DateTimeOffset.Now.Offset);
            }

            if (IsNew)
            {
                var dto = new CreateEventAgendaItemDto
                {
                    EventId = EventId,
                    Title = _title.Trim(),
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                    StartTime = startTime,
                    EndTime = endTime,
                    RoomId = _selectedRoomId,
                    KindId = _selectedKindId,
                    SortOrder = _sortOrder
                };

                var result = await AgendaItemService.CreateAgendaItemAsync(dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to create agenda item.");
                }
            }
            else if (ItemId.HasValue)
            {
                if (_concurrencyStamp == Guid.Empty)
                {
                    _submitState.Fail("Agenda item must be reloaded before saving.");
                    return;
                }

                var dto = new UpdateEventAgendaItemDto
                {
                    Event = new UpdateEventAgendaItemEventDto { EventId = EventId },
                    Title = new UpdateEventAgendaItemTitleDto { Value = _title.Trim() },
                    Description = new UpdateEventAgendaItemDescriptionDto
                    {
                        Value = new OptionalUpdateOfstring
                        {
                            HasValue = true,
                            Value = string.IsNullOrWhiteSpace(_description) ? null : _description
                        }
                    },
                    Schedule = new UpdateEventAgendaItemScheduleDto
                    {
                        StartTime = startTime.GetValueOrDefault(),
                        EndTime = endTime.GetValueOrDefault()
                    },
                    Room = new UpdateEventAgendaItemRoomDto
                    {
                        Value = new OptionalUpdateOfGuid
                        {
                            HasValue = true,
                            Value = _selectedRoomId
                        }
                    },
                    Kind = new UpdateEventAgendaItemKindDto
                    {
                        Value = new OptionalUpdateOfint
                        {
                            HasValue = true,
                            Value = _selectedKindId
                        }
                    },
                    SortOrder = new UpdateEventAgendaItemSortOrderDto { Value = _sortOrder }
                };

                var result = await AgendaItemService.UpdateAgendaItemAsync(ItemId.Value, _concurrencyStamp, dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to update agenda item.");
                }
            }
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Failed to save item: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            _submitState.Fail($"Error: {ex.Message}");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
